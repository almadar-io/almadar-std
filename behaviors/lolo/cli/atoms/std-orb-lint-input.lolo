app std-orb-lint-input [
  version: "1.0.0",
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-input — the one place a lint run reads its file. For a LINT_REQUEST { file } it reads the file, scans the installed language packs (std-orb-language's engine, std-semver for the range check), decides from the raw text whether the program is in the English vocabulary (a .orb document by its top-level keys, a .lolo source by its first token), reads the installed @almadar/core component mapping (the root the language scan reports) and answers LINT_COMPONENTS { names }, reads the pattern registry the manifest declares at orbLanguage.patterns and answers LINT_EVENT_PROPS { names, maps, listens } (the event-bearing prop names), reads the installed @almadar/std operator table and answers LINT_OPERATORS { names } (the names with no namespace) and LINT_OPERATOR_SEMANTICS { semantics, functions } (each operator's declared returnSemantics, and the function-returning operators), resolves it with program/read { resolve } (the inlined program `orb resolve` prints, its `uses lazy` behaviors split off) and answers LINT_LAZY { orbitals } (the lazy children by orbital) LINT_INDEX { scope, heads, roots } (the structural index of the pass: per inline trait and per transition effect list, the operator heads and the binding roots it uses, built by one tree/fold pass per unit) and LINT_INPUT { file, raw, latin, program } to every rule trait that listens, the index first; a LINT_CHILD_REQUEST { index } answers LINT_INPUT again with that lazy child's program and its orbital as `scope` (empty for the program itself), which each rule echoes in LINT_FOUND; an unreadable or unlowerable file, or a failed pack scan, answers LINT_INPUT_UNREAD { file }. A rule trait only analyzes this input; the rule cli traits and the lint-all umbrella each issue one request."
]
uses Spec from "almadar-std/lint-input"
uses Language from "std/behaviors/std-orb-language"
type DocObject = Map string DocValue?
type DocValue = string | number | boolean | [DocValue?] | Map string DocValue?
type LintValue = string | number | boolean | [LintValue?] | Map string LintValue?
type LintProjection = { type : string!, field : string }
type LintRelation = { entity : string!, entityId : string, cardinality : string, onDelete : string }
type LintField = { name : string, type : string!, nullable : boolean, required : boolean, primaryKey : boolean, unique : boolean, default : LintValue?, values : [string], relation : LintRelation, items : LintField, properties : Map string LintField, additionalProperties : LintField, record : string, intrinsic : boolean, derived : LintValue, description : string, synonyms : string, mock : string, mergedFrom : string, projectedFrom : LintProjection }
type LintEntityIndex = { fields : [string]!, orderBy : string }
type LintEntity = { name : string!, id : string, collection : string, persistence : string, store : string, fields : [LintField]!, instances : [Map string LintValue?], localeInstances : Map string [Map string LintValue?], shared : boolean, identity : boolean, browser : boolean, read_policy : LintValue, create_policy : LintValue, update_policy : LintValue, delete_policy : LintValue, invariants : [LintValue?], indexes : [LintEntityIndex], timestamps : boolean, softDelete : boolean, description : string }
type LintPayloadField = { name : string!, type : string!, nullable : boolean, required : boolean, values : [string], description : string, properties : [LintPayloadField], items : LintPayloadField, additionalProperties : LintPayloadField, entity : string, projectedFrom : LintProjection }
type LintConfigField = { type : string!, default : LintValue?, nullable : boolean, required : boolean, label : string, description : string, synonyms : string, tier : string, values : [string], items : LintField, properties : Map string LintField, record : string, refId : string, projectedFrom : LintProjection, forwardedFrom : string, nestedForwardedFrom : [string], payloadFor : string }
type LintEmit = { event : string!, eventId : string, description : string, synonyms : string, tier : string, scope : string, payloadSchema : [LintPayloadField], definerKnob : string, scopeOverridden : boolean, payloadEntity : string }
type LintListenSource = { kind : string!, trait : string, traitId : string, orbital : string, orbitalId : string }
type LintListen = { event : string!, eventId : string, triggers : string, triggersId : string, scope : string, description : string, synonyms : string, tier : string, payloadMapping : Map string LintValue?, guard : LintValue, source : LintListenSource }
type LintInbound = { name : string!, answers : string! }
type LintEvent = { key : string!, id : string, name : string, description : string, synonyms : string, tier : string, payloadSchema : [LintPayloadField], payloadEntity : string, input : boolean, listened : boolean, inbound : LintInbound }
type LintState = { name : string!, isInitial : boolean, isTerminal : boolean, description : string }
type LintTransition = { from : string | [string], to : string!, event : string!, eventId : string, guard : LintValue, effects : [LintValue?], ensures : [LintValue?] }
type LintMachine = { states : [LintState]!, events : [LintEvent], transitions : [LintTransition]! }
type LintTick = { name : string!, interval : string | number, guard : LintValue, effects : [LintValue?]!, appliesTo : [string], description : string, runsInBackground : boolean, whileVisible : boolean }
type LintEffectRow = { kind : string, resource : string }
type LintSourceBehavior = { behavior : string, alias : string, originalName : string }
type LintTrait = { name : string!, id : string, entityRebindable : boolean, entityContract : LintValue, effectRow : [LintEffectRow], description : string, linkedEntity : string, linkedEntityId : string, entityRefIds : Map string string, traitEmbedIds : Map string string, emits : [LintEmit], listens : [LintListen], stateMachine : LintMachine, ticks : [LintTick], config : Map string LintConfigField, dataEntities : [LintEntity], dispatch : string, sourceBehavior : LintSourceBehavior }
type LintTraitRef = { ref : string, refId : string }
type LintPage = { name : string!, id : string, path : string, protocol : string, address : LintValue, viewType : string, primaryEntity : string, isInitial : boolean, traits : [LintTraitRef], icon : string, label : string, roles : [string], access : LintValue, indexing : LintValue, title : LintValue, description : LintValue, sourcePage : string, translationOf : string }
type LintUse = { from : string!, as : string!, lazy : boolean }
type LintOrbital = { name : string!, id : string, uses : [LintUse], expects : [Map string LintValue?], entity : LintEntity!, auxiliaryEntities : [LintEntity], traits : [LintTrait]!, pages : [LintPage], emits : [string], listens : [LintListen], exposes : [string], config : Map string LintConfigField, types : Map string [LintPayloadField] }
type LintProgram = { name : string, version : string, description : string, schemaVersion : number, orbitals : [LintOrbital]!, themeDefinitions : [LintValue?] }
type LazyChild = { orbital : string!, program : LintProgram! }
type ResolvedProgram = { program : LintProgram!, lazy : [LazyChild]! }
type PackText = { name : string!, text : string! }
type PackMeta = { code : string! }
type CoreLanguageBlock = { componentMapping : string, patterns : string, programTypes : string, bindingRules : string, vocabulary : string, uiVocabulary : string, services : string }
type CoreManifest = { orbLanguage : CoreLanguageBlock? }
type ComponentMappingEntry = { component : string! }
type StdLanguageBlock = { operators : string }
type StdManifest = { orbLanguage : StdLanguageBlock? }
type OperatorReturnType = string | { kind : string }
type OpFieldType = string | OpShape
type OpShape = { kind : string, fields : Map string OpFieldType? }
type OpParamType = string | OpShape
type OpParam = { type : OpParamType }
type OperatorEntry = { category : string, returnSemantics : string, returnType : OperatorReturnType, busExcluded : [string], targetOptions : [string], params : [OpParam] }
type PatternEventProp = { pattern : string!, prop : string!, field : string! }
type OperatorTypeRef = string | OperatorTypeNode
type OperatorTypeNode = { kind : string!, of : OperatorTypeRef | [OperatorTypeRef], value : OperatorTypeRef | number | boolean?, items : [OperatorTypeRef]?, key : OperatorTypeRef?, fields : Map string OperatorTypeRef?, open : boolean?, optional : [string]?, collection : string?, scope : string?, shape : OperatorTypeRef?, name : string?, bound : OperatorTypeRef?, each : boolean?, params : [OperatorTypeRef]?, returns : OperatorTypeRef?, result : string? }
type OperatorShapeParam = { name : string, optional : boolean, type : OperatorTypeRef }
type OperatorShapeEntry = { category : string, minArity : number, maxArity : number?, runsOn : string, host : string, hasSideEffects : boolean, params : [OperatorShapeParam] }
type OperatorShapeFile = { operators : Map string OperatorShapeEntry! }
type OperatorShapeOut = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [OperatorShapeParam]! }
type OperatorTable = { operators : Map string OperatorEntry! }
type PatternProp = { kind : string, eventField : string }
type PatternEntry = { propsSchema : Map string PatternProp }
type PatternRegistry = { patterns : Map string PatternEntry! }
type PatternRegProp = { types : [string], enumValues : [string], required : boolean | [string], kind : string, itemKind : string, payloadFor : string, requiredFields : [string], items : PatternRegProp?, properties : Map string PatternRegProp? }
type PatternRegEntry = { requiresAction : boolean, drawHost : boolean, drawable : boolean, fieldsContract : string, accessibleName : [string], propsSchema : Map string PatternRegProp }
type PatternRegFile = { patterns : Map string PatternRegEntry! }
type PatternPropShape = { types : [string]!, requiredOnParent : boolean!, requiredNames : [string]!, enumValues : [string]?, kind : string?, itemKind : string?, payloadFor : string?, requiredFields : [string]?, items : PatternPropShape?, properties : Map string PatternPropShape? }
type PatternShape = { requiresAction : boolean!, drawHost : boolean!, drawable : boolean!, fieldsContract : string!, accessibleName : [string]?, props : Map string PatternPropShape? }
type ProgTypeNode = { type : string!, required : boolean, nullable : boolean, items : ProgTypeNode, properties : Map string ProgTypeNode, values : [string] }
type ProgTypeFile = Map string ProgTypeNode
type BindingRule = { allowed : [string]! }
type BindingRulesFile = { guard : BindingRule!, effect : BindingRule!, tick : BindingRule! }
type VocabularyFile = { types : [string]! }
type UiVocabularyFile = { slots : [string]!, itemActionBaseProps : [string]!, lucideIcons : [string]!, themeKeys : [string]!, deliveryRoots : [string]!, eventSourceKeys : [string]! }
type ComponentMappingFile = { mappings : Map string ComponentMappingEntry! }
type HostVal = string | number | boolean | [HostVal?] | Map string HostVal?
type HostIntRange = { arg : number!, min : number!, max : number! }
type HostClosed = { request : boolean?, intRange : HostIntRange? }
type HostOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HostOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HostOauthOp]! }
type HostAuthScheme = { name : string!, keys : [string]!, required : [string]?, onUnauthorized : [string]? }
type HostHttpWire = { requestKeys : [string]!, bodyKeys : [string]!, queryEncodings : [string]!, authSchemes : [HostAuthScheme]!, defaultPorts : Map string number! }
type HostOpFacts = { closedCall : HostClosed?, oauth : HostOauth?, grant : [Map string HostVal]?, defaultPorts : Map string number?, httpWire : HostHttpWire?, family : string?, emitKeys : [string]? }
type HostOpFactMap = Map string HostOpFacts
type HostOpProbe = Map string HostVal?
type HostDoc = { operators : Map string HostOpProbe! }
type SrRawParam = { name : string!, type : string?, required : boolean? }
type SrRawAction = { name : string!, params : [SrRawParam]?, responseShape : Map string HostVal? }
type SrRawService = { actions : [SrRawAction]? }
type SrRawRegistry = { services : Map string SrRawService! }
type SrParam = { name : string!, type : string!, required : boolean!, kind : string! }
type SrAction = { params : [SrParam]!, hasKey : boolean! }
type SrService = { actions : Map string SrAction! }
type SrServices = Map string SrService
type PackVocab = { meta : PackMeta!, keywords : Map string string, orb : Map string string }

orbital OrbLintInputOrbital {
  uses Semver from "std/behaviors/std-semver"

  entity OrbLintInputRun [runtime] {
    id : string!
    file : string = ""
    cwd : string = ""
    raw : string = ""
    packs : [PackText] = []
    latin : boolean = true
    lazy : [LazyChild] = []
    coreRoot : string = ""
    stdRoot : string = ""
    patternsFile : string = ""
    typesFile : string = ""
    rulesFile : string = ""
    vocabFile : string = ""
    uiVocabFile : string = ""
    servicesFile : string = ""
    progTypes : ProgTypeFile = {}
    guardSigils : [string] = []
    effectSigils : [string] = []
    tickSigils : [string] = []
    factsDone : boolean = true
    factsWaiting : boolean = false
    pendingProgram : LintProgram?
  }

  trait Versions = Semver.traits.Semver {
    listens {
      Packs.LANG_SEMVER -> SEMVER_SATISFIES
    }
  }

  trait Packs = Language.traits.OrbLanguageEngine {
    listens {
      OrbLintInput.LINT_PACKS_RUN -> LANG_SCAN
      LANG_SAT { requestId : string!  value : boolean! }
        @description "std-semver's SEMVER_SATISFIED: the range check answered."
      LANG_SAT_REFUSED { requestId : string!  operation : string!  reason : string! }
        @description "std-semver's SEMVER_REFUSED: the range check refused."
      Versions.SEMVER_SATISFIED -> LANG_SAT
      Versions.SEMVER_REFUSED -> LANG_SAT_REFUSED
    }
  }

  trait OrbLintInput -> OrbLintInputRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_REQUEST -> reading
        (set @entity.file @payload.file)
        (set @entity.factsDone false)
        (set @entity.factsWaiting false)
        (set @entity.packs [])
        (os/realpath { anchor: "cwd" path: "." } { key: "lint-input-cwd" emit: { success: LINT_CWD, failure: LINT_FILE_UNREAD } })
      LINT_CHILD_REQUEST -> ready
        (emit LINT_INPUT_OFFER { file: @entity.file, raw: @entity.raw, latin: @entity.latin, program: (object/get (array/nth @entity.lazy @payload.index) "program"), scope: (object/get (array/nth @entity.lazy @payload.index) "orbital") })
      LINT_INPUT_OFFER -> ready
        (let ((nov : [string] []))
          (let ((rows (let ((orbs (object/get @payload.program "orbitals" [])))
            (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
              (let ((trs (object/get (array/nth @orbs @oi) "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (array/nth @trs @ti)))
                    (if (object/has @t "stateMachine")
                      (let ((tms (object/get @t "stateMachine.transitions" [])))
                        (let ((rest : LintValue (object/merge @t { stateMachine: (object/merge (object/get @t "stateMachine") { transitions: (array/map @tms (fn x (object/merge @x { effects: [] }))) }) })))
                          (let ((ix (array/map (array/range 0 (+ 1 (array/len @tms))) (fn u (array/unique (default (tree/fold (if (= @u 0) @rest (object/get (array/nth @tms (- @u 1)) "effects" [])) (fn (n k)
                          (if (validate/string @n)
                            (if (str/startsWith @n (quote "@")) [(str/concat "r:" (array/first (str/split @n ".")))] [])
                            (if (validate/array @n)
                              (array/concat
                                (let ((o0 (array/nth @n 0))) (if (validate/string @o0) [(str/concat "h:" @o0)] []))
                                (array/flatten (array/filter @k (fn r (!= @r null)))))
                              (if (validate/object @n) (array/flatten (array/filter (object/values @k) (fn r (!= @r null)))) [])))) "LintValue") @nov))))))
                            (let ((all (array/unique (array/flatten @ix))))
                              (array/map (array/range 0 (+ 1 (array/len @tms))) (fn u
                                (let ((tk (if (= @u 0) @all (array/nth @ix @u))))
                                  { k: (if (= @u 0) (str/concat @oi "-" @ti) (str/concat @oi "-" @ti "-" (- @u 1))), h: (array/sort (array/map (array/filter @tk (fn s (str/startsWith @s "h:"))) (fn s (str/slice @s 2 (str/len @s))))), r: (array/sort (array/map (array/filter @tk (fn s (str/startsWith @s "r:"))) (fn s (str/slice @s 2 (str/len @s))))) })))))))
                      []))))))))))))
            (emit LINT_INDEX { scope: @payload.scope, heads: (default (object/fromEntries (array/map @rows (fn w [(object/get @w "k"), (object/get @w "h")]))) {}), roots: (default (object/fromEntries (array/map @rows (fn w [(object/get @w "k"), (object/get @w "r")]))) {}) })))
        (emit LINT_INPUT { file: @payload.file, raw: @payload.raw, latin: @payload.latin, program: @payload.program, scope: @payload.scope })
    }

    state reading {
      INIT -> reading
      LINT_CWD -> reading
        (set @entity.cwd @payload.path)
        (os/read-file (str/concat "/" (os/path-relative "/" (if (os/path-is-absolute @entity.file) @entity.file (os/path-join @payload.path @entity.file)))) { key: "lint-input-file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FILE_READ -> ready when (= (bytes/to-string @payload.data) null)
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the file is not valid text" })
      LINT_FILE_READ -> reading when (!= (bytes/to-string @payload.data) null)
        (set @entity.raw (bytes/to-string @payload.data))
        (emit LINT_PACKS_RUN { cwd: @entity.cwd })
      LANGUAGE_PACK_VOCAB_HEARD -> reading
        (set @entity.packs (array/append @entity.packs { name: @payload.name, text: @payload.text }))
      LANG_SCAN_ANSWERED -> ready when (!= @payload.status 200)
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (str/concat "the language pack scan failed: " @payload.stderr) })
      LANGUAGE_PACKS_DONE_HEARD -> ready when (!= @payload.problem "")
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: @payload.problem })
      LANGUAGE_PACKS_DONE_HEARD -> ready when (and (= @payload.problem "") (str/startsWith (str/trim @entity.raw) "{") (= (json/parse @entity.raw DocObject) null))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the file is not a valid JSON document" })
      LANGUAGE_PACKS_DONE_HEARD -> reading when (= @payload.problem "")
        (set @entity.latin (let ((words ["app", "uses", "expects", "type", "theme", "orbital"]) (vocabs (array/map @entity.packs (fn k (json/parse (object/get @k "text") PackVocab)))))
          (if (str/startsWith (str/trim @entity.raw) "{")
            (let ((keys (object/keys (default (json/parse @entity.raw DocObject) {}))))
              (or (array/includes @keys "orbitals") (not (array/some @vocabs (fn v (array/includes @keys (object/get (object/get @v "orb" {}) "orbitals" "")))))))
            (let ((tok (array/first (str/split (array/first (str/split (array/first (str/split (str/trim (array/find (str/split @entity.raw "\n") (fn l (let ((t (str/trim @l))) (and (!= @t "") (not (str/startsWith @t ";;"))))))) " ")) "[")) "("))))
              (or (array/includes @words @tok) (not (array/some @vocabs (fn v (array/some @words (fn w (= (object/get (object/get @v "keywords" {}) @w "") @tok)))))))))))
        (emit LINT_LANGUAGE { latin: @entity.latin })
        (set @entity.coreRoot @payload.coreRoot)
        (set @entity.stdRoot @payload.stdRoot)
        (emit LINT_CORE_READ { })
      LINT_CORE_READ -> ready when (= @entity.coreRoot "")
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the language scan found no compatible @almadar/core" })
      LINT_CORE_READ -> reading when (!= @entity.coreRoot "")
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot "package.json"))) { key: "lint-input-core" emit: { success: LINT_CORE_MANIFEST, failure: LINT_FILE_UNREAD } })
      LINT_CORE_MANIFEST -> ready when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage" {}) "componentMapping" "") "")))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (if (= (bytes/to-string @payload.data) null) "the installed @almadar/core package.json is not valid text" "the installed @almadar/core declares no orbLanguage.componentMapping") })
      LINT_CORE_MANIFEST -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage" {}) "componentMapping" "") "")))
        (set @entity.patternsFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "patterns" ""))
        (set @entity.typesFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "programTypes" ""))
        (set @entity.rulesFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "bindingRules" ""))
        (set @entity.vocabFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "vocabulary" ""))
        (set @entity.uiVocabFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "uiVocabulary" ""))
        (set @entity.servicesFile (object/get (object/get (json/parse (bytes/to-string @payload.data) CoreManifest) "orbLanguage" {}) "services" ""))
        (emit LINT_FACTS_READ { })
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core package.json is not valid text" })
            (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot (object/get (object/get (json/parse @text CoreManifest) "orbLanguage" {}) "componentMapping" "")))) { key: "lint-input-components" emit: { success: LINT_MAPPING_READ, failure: LINT_FILE_UNREAD } })))
      LINT_MAPPING_READ -> ready when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text ComponentMappingFile) null)))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (if (= (bytes/to-string @payload.data) null) "the installed @almadar/core component mapping is not valid text" "the installed @almadar/core component mapping is not a component mapping") })
      LINT_MAPPING_READ -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text ComponentMappingFile) null)))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core component mapping is not valid text" })
            (emit LINT_COMPONENTS { names: (array/sort (array/unique (array/map (object/values (object/get (json/parse @text ComponentMappingFile) "mappings")) (fn m (object/get @m "component"))))) })))
        (emit LINT_PATTERNS_READ { })
      LINT_PATTERNS_READ -> ready when (= @entity.patternsFile "")
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core declares no orbLanguage.patterns" })
      LINT_PATTERNS_READ -> reading when (!= @entity.patternsFile "")
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.patternsFile))) { key: "lint-input-patterns" emit: { success: LINT_PATTERNS_FILE, failure: LINT_FILE_UNREAD } })
      LINT_PATTERNS_FILE -> ready when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text PatternRegistry) null) (= (json/parse @text PatternRegFile) null)))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (if (= (bytes/to-string @payload.data) null) "the installed @almadar/core pattern registry is not valid text" "the installed @almadar/core pattern registry is not a pattern registry") })
      LINT_PATTERNS_FILE -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text PatternRegistry) null) (!= (json/parse @text PatternRegFile) null)))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core pattern registry is not valid text" })
            (let ((pats (object/get (json/parse @text PatternRegistry) "patterns")))
              (let ((rows (array/flatten (array/map (array/sort (object/keys @pats)) (fn pn
                      (let ((ps (object/get (object/get @pats @pn) "propsSchema" {})))
                        (array/map (object/keys @ps) (fn k { pattern: @pn, prop: @k, kind: (object/get (object/get @ps @k) "kind" ""), field: (object/get (object/get @ps @k) "eventField" "") }))))))))
                (let ((listenMap (object/fromEntries (array/map (array/unique (array/map (array/filter @rows (fn r (= (object/get @r "kind") "event-listen"))) (fn r (object/get @r "pattern")))) (fn pn [@pn, (array/map (array/filter @rows (fn r (and (= (object/get @r "pattern") @pn) (= (object/get @r "kind") "event-listen")))) (fn r (object/get @r "prop")))])))))
                  (if (= @listenMap null)
                    (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core pattern registry has event-listen props that cannot be grouped by pattern" })
                (emit LINT_EVENT_PROPS {
                  names: (array/sort (array/unique (array/flatten (array/map @rows (fn r
                    (if (array/includes ["event", "event-ref", "event-listen", "callback"] (object/get @r "kind")) [(object/get @r "prop")]
                      (if (and (= (object/get @r "kind") "event-list") (!= (object/get @r "field") "")) [(object/get @r "field")] []))))))),
                  maps: (array/sort (array/unique (array/map (array/filter @rows (fn r (= (object/get @r "kind") "event-map"))) (fn r (object/get @r "prop"))))),
                  byPattern: (array/flatten (array/map @rows (fn r (if (array/includes ["event", "event-ref", "callback"] (object/get @r "kind")) [{ pattern: (object/get @r "pattern"), prop: (object/get @r "prop"), field: "" }] (if (= (object/get @r "kind") "event-list") [{ pattern: (object/get @r "pattern"), prop: (object/get @r "prop"), field: (if (= (object/get @r "field") "") "event" (object/get @r "field")) }] []))))),
                  listens: @listenMap })))))))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core pattern registry is not valid text" })
            (let ((registry (json/parse @text PatternRegFile)))
             (if (= @registry null)
              (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/core pattern registry is not a pattern registry" })
              (emit LINT_PATTERNS { patterns: (object/mapValues (object/get @registry "patterns") (fn e
              (object/merge
                { requiresAction: (= (object/get @e "requiresAction" false) true), drawHost: (= (object/get @e "drawHost" false) true), drawable: (= (object/get @e "drawable" false) true), fieldsContract: (object/get @e "fieldsContract" ""),
                  props: (object/mapValues (object/get @e "propsSchema" {}) (fn p
                    (tree/fold @p (fn node kids
                      (object/merge
                        { types: (array/filter (object/get @node "types" []) (fn t (!= @t "unknown"))), requiredOnParent: (let ((rq (object/get @node "required" false))) (and (validate/boolean @rq) (= @rq true))), requiredNames: (let ((rq (object/get @node "required" false))) (if (validate/array @rq) @rq [])) }
                        (if (!= (object/get @node "kind" "") "") { kind: (object/get @node "kind") } {})
                        (if (!= (object/get @node "itemKind" "") "") { itemKind: (object/get @node "itemKind") } {})
                        (if (!= (object/get @node "payloadFor" "") "") { payloadFor: (object/get @node "payloadFor") } {})
                        (if (object/has @node "requiredFields") { requiredFields: (object/get @node "requiredFields") } {})
                        (if (object/has @node "enumValues") { enumValues: (object/get @node "enumValues") } {})
                        (if (object/has @kids "items") { items: (object/get @kids "items") } {})
                        (if (object/has @kids "properties") { properties: (object/get @kids "properties") } {})))
                      "PatternRegProp"))) }
                (if (object/has @e "accessibleName") { accessibleName: (object/get @e "accessibleName") } {})))) })))))
        (emit LINT_STD_READ { })
      LINT_STD_READ -> ready when (= @entity.stdRoot "")
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the language scan found no compatible @almadar/std" })
      LINT_STD_READ -> reading when (!= @entity.stdRoot "")
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.stdRoot "package.json"))) { key: "lint-input-std" emit: { success: LINT_STD_MANIFEST, failure: LINT_FILE_UNREAD } })
      LINT_STD_MANIFEST -> ready when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (object/get (object/get (json/parse @text StdManifest) "orbLanguage" {}) "operators" "") "")))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (if (= (bytes/to-string @payload.data) null) "the installed @almadar/std package.json is not valid text" "the installed @almadar/std declares no orbLanguage.operators") })
      LINT_STD_MANIFEST -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (object/get (object/get (json/parse @text StdManifest) "orbLanguage" {}) "operators" "") "")))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std package.json is not valid text" })
            (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.stdRoot (object/get (object/get (json/parse @text StdManifest) "orbLanguage" {}) "operators" "")))) { key: "lint-input-operators" emit: { success: LINT_TABLE_READ, failure: LINT_FILE_UNREAD } })))
      LINT_TABLE_READ -> ready when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text OperatorTable) null) (= (object/get (object/get (object/get (json/parse @text OperatorTable) "operators") "emit" {}) "busExcluded" null) null) (= (object/get (object/get (object/get (json/parse @text OperatorTable) "operators") "program/dispatch" {}) "targetOptions" null) null)))
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (if (= (bytes/to-string @payload.data) null) "the installed @almadar/std operator table is not valid text" (if (= (json/parse (bytes/to-string @payload.data) OperatorTable) null) "the installed @almadar/std operator table is not an operator table" "the installed @almadar/std operator table declares no emit.busExcluded or program/dispatch.targetOptions")) })
      LINT_TABLE_READ -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text OperatorTable) null) (!= (object/get (object/get (object/get (json/parse @text OperatorTable) "operators") "emit" {}) "busExcluded" null) null) (!= (object/get (object/get (object/get (json/parse @text OperatorTable) "operators") "program/dispatch" {}) "targetOptions" null) null)))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table is not valid text" })
            (emit LINT_OPERATORS { names: (array/sort (array/filter (object/keys (object/get (json/parse @text OperatorTable) "operators")) (fn n (not (str/includes @n "/"))))) })))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table is not valid text" })
            (emit LINT_OPERATOR_NAMES { names: (array/sort (object/keys (object/get (json/parse @text OperatorTable) "operators"))) })))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table is not valid text" })
            (let ((shapes (json/parse @text OperatorShapeFile)))
             (if (= @shapes null)
              (emit LINT_OPERATOR_SHAPES_UNREAD { error: "the installed @almadar/std operator table has an operator whose arity, params or types are not declared in the table's shape" })
              (emit LINT_OPERATOR_SHAPES { operators: (object/mapValues (object/get @shapes "operators") (fn o
              (object/merge
                { hasSideEffects: (= (object/get @o "hasSideEffects" false) true),
                  params: (array/map (object/get @o "params" []) (fn pr (object/merge { name: (object/get @pr "name" ""), optional: (= (object/get @pr "optional" false) true) } (if (object/has @pr "type") { type: (object/get @pr "type") } {})))) }
                (if (object/has @o "category") { category: (object/get @o "category") } {})
                (if (object/has @o "minArity") { minArity: (object/get @o "minArity") } {})
                (if (object/has @o "maxArity") { maxArity: (object/get @o "maxArity") } {})
                (if (object/has @o "runsOn") { runsOn: (object/get @o "runsOn") } {})
                (if (object/has @o "host") { host: (object/get @o "host") } {})))) })))))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table is not valid text" })
            (let ((ops (object/get (json/parse @text OperatorTable) "operators")))
              (let ((semMap (object/fromEntries (array/map (array/filter (object/keys @ops) (fn n (!= (object/get (object/get @ops @n) "returnSemantics" "") ""))) (fn n [@n, (object/get (object/get @ops @n) "returnSemantics")])))))
                (if (= @semMap null)
                  (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table has operators whose declared returnSemantics cannot be keyed by name" })
              (emit LINT_OPERATOR_SEMANTICS {
                busExcluded: (object/get (object/get @ops "emit") "busExcluded"),
                targetOptions: (object/get (object/get @ops "program/dispatch") "targetOptions"),
                semantics: @semMap,
                functions: (array/sort (array/filter (object/keys @ops) (fn n (let ((rt (object/get (object/get @ops @n) "returnType" ""))) (and (validate/object @rt) (= (object/get @rt "kind" "") "fn")))))),
                emitSlots: (array/sort (array/unique (array/flatten (array/map (object/keys @ops) (fn n (array/flatten (array/map (object/get (object/get @ops @n) "params" []) (fn p (let ((ty (object/get @p "type" null))) (if (validate/object @ty) (let ((em (object/get (object/get (json/parse (json/stringify @ty) OpShape) "fields" {}) "emit" null))) (if (validate/object @em) (object/keys (object/get (json/parse (json/stringify @em) OpShape) "fields" {})) [])) [])))))))))) }))))))
        (let ((text (bytes/to-string @payload.data)))
          (if (= @text null)
            (emit LINT_INPUT_UNREAD { file: @entity.file, error: "the installed @almadar/std operator table is not valid text" })
            (let ((doc (json/parse @text HostDoc)) (fields ["closedCall", "oauth", "grant", "defaultPorts", "httpWire", "family", "emitKeys"]))
              (if (= @doc null)
                (emit LINT_HOST_FACTS_UNREAD { error: "the installed @almadar/std operator table is not an operator table" })
                (let ((names (array/sort (array/filter (object/keys (object/get @doc "operators")) (fn n (array/some @fields (fn f (!= (object/get @doc (str/concat "operators." @n "." @f) null) null))))))))
                  (let ((ops (json/parse (json/stringify (default (object/fromEntries (array/map @names (fn n [@n, (default (object/fromEntries (array/filter (array/map @fields (fn f [@f, (object/get @doc (str/concat "operators." @n "." @f) null)])) (fn pr (!= (array/nth @pr 1) null)))) {})]))) {})) HostOpFactMap)))
                    (if (= @ops null)
                      (emit LINT_HOST_FACTS_UNREAD { error: "the installed @almadar/std operator table has an operator whose closedCall, oauth, grant, defaultPorts, httpWire, family or emitKeys is not declared in the table's shape" })
                      (emit LINT_HOST_FACTS { operators: @ops }))))))))
        (emit LINT_SERVICES_READ { })
      LINT_SERVICES_READ -> reading when (= @entity.servicesFile "")
        (emit LINT_SERVICES_UNREAD { error: "the installed @almadar/core declares no orbLanguage.services" })
        (emit LINT_PROGRAM_START { })
      LINT_SERVICES_READ -> reading when (!= @entity.servicesFile "")
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.servicesFile))) { key: "lint-input-services" emit: { success: LINT_SERVICES_FILE, failure: LINT_SERVICES_FAILED } })
      LINT_SERVICES_FILE -> reading when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text SrRawRegistry) null)))
        (emit LINT_SERVICES_UNREAD { error: "the installed @almadar/core services registry is not a services registry" })
        (emit LINT_PROGRAM_START { })
      LINT_SERVICES_FILE -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text SrRawRegistry) null)))
        (emit LINT_SERVICES { services: (let ((reg (object/get (json/parse (default (bytes/to-string @payload.data) "") SrRawRegistry) "services")))
          (default (json/parse (json/stringify (object/mapValues @reg (fn s
            { actions: (default (object/fromEntries (array/map (object/get @s "actions" []) (fn a
                [(object/get @a "name"), { hasKey: (object/has (object/get @a "responseShape" {}) "key"),
                  params: (array/map (object/get @a "params" []) (fn p { name: (object/get @p "name"), type: (object/get @p "type" ""), required: (object/get @p "required" false), kind: (let ((tt (str/trim (object/get @p "type" "")))) (if (= @tt "string") "string" (if (= @tt "number") "number" (if (= @tt "boolean") "boolean" (if (or (= @tt "object") (= @tt "map")) "object" (if (or (= @tt "array") (str/endsWith @tt "[]")) "array" (if (str/startsWith @tt "'") "string" ""))))))) })) }]))) {}) }))) SrServices) {})) })
        (emit LINT_PROGRAM_START { })
      LINT_SERVICES_FAILED -> reading
        (emit LINT_SERVICES_UNREAD { error: (default @payload.error "") })
        (emit LINT_PROGRAM_START { })
      LINT_PROGRAM_START -> reading
        (program/read "" { resolve: true text: false path: (if (os/path-is-absolute @entity.file) @entity.file (os/path-join @entity.cwd @entity.file)) } { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> reading when (not @entity.factsDone)
        (set @entity.lazy (object/get @payload.result "lazy" []))
        (set @entity.pendingProgram (object/get @payload.result "program"))
        (set @entity.factsWaiting true)
      LINT_PROGRAM_READ -> ready when @entity.factsDone
        (set @entity.lazy (object/get @payload.result "lazy" []))
        (emit LINT_LAZY { orbitals: (array/map (object/get @payload.result "lazy" []) (fn c (object/get @c "orbital"))) })
        (emit LINT_INPUT_OFFER { file: @entity.file, raw: @entity.raw, latin: @entity.latin, program: (object/get @payload.result "program"), scope: "" })
      LINT_FACTS_READ -> reading when (or (= @entity.typesFile "") (= @entity.rulesFile "") (= @entity.vocabFile ""))
        (emit LINT_FACTS_FAILED { error: "the installed @almadar/core declares no orbLanguage.programTypes, bindingRules or vocabulary" })
      LINT_FACTS_READ -> reading when (and (!= @entity.typesFile "") (!= @entity.rulesFile "") (!= @entity.vocabFile ""))
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.typesFile))) { key: "lint-input-program-types" emit: { success: LINT_FACTS_TYPES, failure: LINT_FACTS_FAILED } })
      LINT_FACTS_TYPES -> reading when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text ProgTypeFile) null)))
        (emit LINT_FACTS_FAILED { error: "the installed @almadar/core program types are not a program type table" })
      LINT_FACTS_TYPES -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text ProgTypeFile) null)))
        (set @entity.progTypes (default (json/parse (default (bytes/to-string @payload.data) "") ProgTypeFile) {}))
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.rulesFile))) { key: "lint-input-binding-rules" emit: { success: LINT_FACTS_RULES, failure: LINT_FACTS_FAILED } })
      LINT_FACTS_RULES -> reading when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text BindingRulesFile) null)))
        (emit LINT_FACTS_FAILED { error: "the installed @almadar/core binding rules are not a binding rule table" })
      LINT_FACTS_RULES -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text BindingRulesFile) null)))
        (set @entity.guardSigils (object/get (object/get (json/parse (default (bytes/to-string @payload.data) "") BindingRulesFile) "guard" { allowed: [] }) "allowed" []))
        (set @entity.effectSigils (object/get (object/get (json/parse (default (bytes/to-string @payload.data) "") BindingRulesFile) "effect" { allowed: [] }) "allowed" []))
        (set @entity.tickSigils (object/get (object/get (json/parse (default (bytes/to-string @payload.data) "") BindingRulesFile) "tick" { allowed: [] }) "allowed" []))
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.vocabFile))) { key: "lint-input-vocabulary" emit: { success: LINT_FACTS_VOCAB, failure: LINT_FACTS_FAILED } })
      LINT_FACTS_VOCAB -> reading when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text VocabularyFile) null)))
        (emit LINT_FACTS_FAILED { error: "the installed @almadar/core vocabulary is not a vocabulary" })
      LINT_FACTS_VOCAB -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text VocabularyFile) null)))
        (emit LINT_LANGUAGE_FACTS { programTypes: @entity.progTypes, guardSigils: @entity.guardSigils, effectSigils: @entity.effectSigils, tickSigils: @entity.tickSigils, fieldTypes: (object/get (json/parse (default (bytes/to-string @payload.data) "") VocabularyFile) "types" []) })
        (emit LINT_UI_VOCAB_READ { })
      LINT_UI_VOCAB_READ -> reading when (= @entity.uiVocabFile "")
        (emit LINT_UI_VOCAB_UNREAD { error: "the installed @almadar/core declares no orbLanguage.uiVocabulary" })
        (emit LINT_FACTS_DONE { })
      LINT_UI_VOCAB_READ -> reading when (!= @entity.uiVocabFile "")
        (os/read-file (str/concat "/" (os/path-relative "/" (os/path-join @entity.coreRoot @entity.uiVocabFile))) { key: "lint-input-ui-vocabulary" emit: { success: LINT_UI_VOCAB_FILE, failure: LINT_UI_VOCAB_FAILED } })
      LINT_UI_VOCAB_FILE -> reading when (let ((text (bytes/to-string @payload.data))) (or (= @text null) (= (json/parse @text UiVocabularyFile) null)))
        (emit LINT_UI_VOCAB_UNREAD { error: "the installed @almadar/core UI vocabulary is not a UI vocabulary" })
        (emit LINT_FACTS_DONE { })
      LINT_UI_VOCAB_FILE -> reading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text UiVocabularyFile) null)))
        (emit LINT_UI_VOCAB { slots: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "slots" []), itemActionBaseProps: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "itemActionBaseProps" []), lucideIcons: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "lucideIcons" []), themeKeys: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "themeKeys" []), deliveryRoots: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "deliveryRoots" []), eventSourceKeys: (object/get (json/parse (default (bytes/to-string @payload.data) "") UiVocabularyFile) "eventSourceKeys" []) })
        (emit LINT_FACTS_DONE { })
      LINT_UI_VOCAB_FAILED -> reading
        (emit LINT_UI_VOCAB_UNREAD { error: (default @payload.error "") })
        (emit LINT_FACTS_DONE { })
      LINT_FACTS_FAILED -> reading
        (emit LINT_LANGUAGE_FACTS_UNREAD { error: (default @payload.error "") })
        (emit LINT_FACTS_DONE { })
      LINT_FACTS_DONE -> ready when @entity.factsWaiting
        (set @entity.factsDone true)
        (set @entity.factsWaiting false)
        (emit LINT_LAZY { orbitals: (array/map @entity.lazy (fn c (object/get @c "orbital"))) })
        (emit LINT_INPUT_OFFER { file: @entity.file, raw: @entity.raw, latin: @entity.latin, program: @entity.pendingProgram, scope: "" })
      LINT_FACTS_DONE -> reading when (not @entity.factsWaiting)
        (set @entity.factsDone true)
      LINT_FILE_UNREAD -> ready
        (emit LINT_INPUT_UNREAD { file: @entity.file, error: (default @payload.error "") })
    }

    emits {
      LINT_INPUT -> external { file : string!  raw : string!  latin : boolean!  program : LintProgram!  scope : string! }
        @description "The file read, its language decided and the program lowered, offered to every rule trait."
        @tier "internal"
      LINT_INPUT_OFFER { file : string!  raw : string!  latin : boolean!  program : LintProgram!  scope : string! }
        @description "Internal: the lowered program of one pass, on its way to LINT_INPUT; the offer sends LINT_INDEX first so every rule has the structural index before it hears the program."
        @tier "internal"
      LINT_INDEX -> external { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "The structural index of one pass, sent immediately before its LINT_INPUT. For every inline trait of the program and for every transition effect list, keyed `<orbital index>-<trait index>` for the trait (its guards, effects, ticks and config together) and `<orbital index>-<trait index>-<transition index>` for a transition's effects: `heads` holds the operator heads used (the first element of every array node whose first element is a string) and `roots` the binding roots used (every string starting with @, cut at the first `.`), both sorted. A rule gates on membership in these sets instead of searching the program's text."
        @tier "internal"
      LINT_COMPONENTS -> external { names : [string]! }
        @description "The UI component names of the installed @almadar/core component mapping (an entity named like one collides in compiled output); sent before LINT_INPUT."
        @tier "internal"
      LINT_OPERATOR_SEMANTICS -> external { semantics : Map string string!  functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "The installed operators' declared returnSemantics (operator name to its provenance kind) and the operators whose result is a function (a lambda form); sent before LINT_INPUT."
        @tier "internal"
      LINT_OPERATORS -> external { names : [string]! }
        @description "The installed operator names with no namespace (`if`, `+`, `and`, …): a default array headed by one is an operator call, not data; sent before LINT_INPUT."
        @tier "internal"
      LINT_EVENT_PROPS -> external { names : [string]!  maps : [string]!  listens : Map string [string]!  byPattern : [PatternEventProp]! }
        @description "The event-bearing prop names of the installed @almadar/core pattern registry: `names` are the props of kind event, event-ref, event-listen or callback plus the eventField of each event-list prop, `maps` the event-map props, `listens` the event-listen props by pattern; sent before LINT_INPUT."
        @tier "internal"
      LINT_PATTERNS -> external { patterns : Map string PatternShape! }
        @description "The installed @almadar/core pattern registry projected for the render-ui checks: per pattern its requiresAction (a render of it needs an action, event, onClick or href), drawHost and drawable flags, fieldsContract, accessibleName props (absent when the pattern declares none) and props; per prop its concrete types (never `unknown`), whether it is required on its parent (the bool form), the sub-keys it requires (the list form), kind, itemKind, payloadFor (the sibling event prop it pairs with, absent when none), requiredFields (the entity fields an EntityWith prop requires, absent when none), enumValues (absent when unbounded) and the same shape for its items and properties; sent before LINT_INPUT."
        @tier "internal"
      LINT_OPERATOR_NAMES -> external { names : [string]! }
        @description "Every installed operator name, namespaced ones included (`array/concat`): a children list headed by one is an expression, not a list of patterns; sent before LINT_INPUT."
        @tier "internal"
      LINT_OPERATOR_SHAPES -> external { operators : Map string OperatorShapeOut! }
        @description "Every operator of the installed @almadar/std operator table with its shape: minArity, maxArity (absent when unbounded), runsOn and host (absent when the table declares none), hasSideEffects, and its params in position order, each with its name, whether it is optional and its type as the table's recursive type reference; sent before LINT_INPUT."
        @tier "internal"
      LINT_OPERATOR_SHAPES_UNREAD -> external { error : string! }
        @description "The installed @almadar/std operator table does not match the operator shape type, so LINT_OPERATOR_SHAPES is not sent; LINT_INPUT and every other event are unaffected. A rule that needs the shapes answers its own unread finding."
        @tier "internal"
      LINT_LANGUAGE_FACTS -> external { programTypes : Map string ProgTypeNode!  guardSigils : [string]!  effectSigils : [string]!  tickSigils : [string]!  fieldTypes : [string]! }
        @description "The installed @almadar/core language facts: the program types (BehaviorRef, OrbitalValue, TraitValue, Viewer, MachineRow, PlayedStep) with their members, the sigils allowed in a guard, an effect and a tick (orbLanguage.bindingRules), and the field-type word list (orbLanguage.vocabulary types); sent before LINT_INPUT."
        @tier "internal"
      LINT_LANGUAGE_FACTS_UNREAD -> external { error : string! }
        @description "The installed @almadar/core language facts could not be read, so LINT_LANGUAGE_FACTS is not sent; LINT_INPUT and every other event are unaffected. A rule that needs the facts answers its own unread finding."
        @tier "internal"
      LINT_UI_VOCAB -> external { slots : [string]!  itemActionBaseProps : [string]!  lucideIcons : [string]!  themeKeys : [string]!  deliveryRoots : [string]!  eventSourceKeys : [string]! }
        @description "The installed @almadar/core UI vocabulary (orbLanguage.uiVocabulary): the valid slots, the base item-action prop names, the Lucide icon names, the built-in theme keys, the delivery-only binding roots and the @event.source keys; sent before LINT_INPUT."
        @tier "internal"
      LINT_UI_VOCAB_UNREAD -> external { error : string! }
        @description "The installed @almadar/core UI vocabulary could not be read, so LINT_UI_VOCAB is not sent; LINT_INPUT and every other event are unaffected. A rule that needs the vocabulary answers its own unread finding."
        @tier "internal"
      LINT_HOST_FACTS -> external { operators : Map string HostOpFacts! }
        @description "The host-effect facts the installed @almadar/std operator table states beside the shapes, for the operators that state any: closedCall, oauth, grant, defaultPorts, httpWire (request keys, body keys, query encodings, per-scheme auth keys with their required keys and onUnauthorized words, the default port of each http scheme), family (on-device or tab) and emitKeys (the emit keys in the order the operator documents them); sent before LINT_INPUT. The operator's arity, params and types come in LINT_OPERATOR_SHAPES."
        @tier "internal"
      LINT_HOST_FACTS_UNREAD -> external { error : string! }
        @description "The host-effect facts of the operator table do not match their declared shape, so LINT_HOST_FACTS is not sent; LINT_INPUT and every other event are unaffected. A rule that needs them answers its own unread finding."
        @tier "internal"
      LINT_SERVICES -> external { services : Map string SrService! }
        @description "The services registry of the installed @almadar/core (orbLanguage.services), projected for the service lints: per service its actions, and per action the declared params (name, declared type text, whether required, and the kind a literal must have: string, number, boolean, object or array, empty for a type that is not checked) and whether the action's response shape names a `key` field. A service with no action is declared-only; sent before LINT_INPUT."
        @tier "internal"
      LINT_SERVICES_UNREAD -> external { error : string! }
        @description "The installed @almadar/core services registry could not be read, so LINT_SERVICES is not sent; LINT_INPUT and every other event are unaffected. A rule that needs it answers its own unread finding."
        @tier "internal"
      LINT_SERVICES_READ { }
        @description "Internal: read the installed @almadar/core services registry."
        @tier "internal"
      LINT_SERVICES_FILE { data : bytes! }
        @description "The installed @almadar/core services registry read."
        @tier "internal"
      LINT_SERVICES_FAILED { error : string }
        @description "Internal: the services registry file could not be read."
        @tier "internal"
      LINT_PROGRAM_START { }
        @description "Internal: every installed file of the pass is read, resolve the program."
        @tier "internal"
      LINT_UI_VOCAB_READ { }
        @description "Internal: read the installed @almadar/core UI vocabulary."
        @tier "internal"
      LINT_UI_VOCAB_FILE { data : bytes! }
        @description "The installed @almadar/core UI vocabulary read."
        @tier "internal"
      LINT_UI_VOCAB_FAILED { error : string }
        @description "Internal: the UI vocabulary file could not be read."
        @tier "internal"
      LINT_FACTS_READ { }
        @description "Internal: read the installed @almadar/core program types, binding rules and vocabulary."
        @tier "internal"
      LINT_FACTS_TYPES { data : bytes! }
        @description "The installed @almadar/core program types read."
        @tier "internal"
      LINT_FACTS_RULES { data : bytes! }
        @description "The installed @almadar/core binding rules read."
        @tier "internal"
      LINT_FACTS_VOCAB { data : bytes! }
        @description "The installed @almadar/core vocabulary read."
        @tier "internal"
      LINT_FACTS_FAILED { error : string }
        @description "Internal: the language facts could not be read."
        @tier "internal"
      LINT_FACTS_DONE { }
        @description "Internal: the language facts were sent or answered unread."
        @tier "internal"
      LINT_PATTERNS_READ { }
        @description "Internal: read the installed @almadar/core pattern registry."
        @tier "internal"
      LINT_PATTERNS_FILE { data : bytes! }
        @description "The installed @almadar/core pattern registry read."
        @tier "internal"
      LINT_STD_READ { }
        @description "Internal: read the installed @almadar/std operator table."
        @tier "internal"
      LINT_STD_MANIFEST { data : bytes! }
        @description "The installed @almadar/std package.json read."
        @tier "internal"
      LINT_TABLE_READ { data : bytes! }
        @description "The installed @almadar/std operator table read."
        @tier "internal"
      LINT_CORE_READ { }
        @description "Internal: read the installed @almadar/core component mapping."
        @tier "internal"
      LINT_CORE_MANIFEST { data : bytes! }
        @description "The installed @almadar/core package.json read."
        @tier "internal"
      LINT_MAPPING_READ { data : bytes! }
        @description "The installed @almadar/core component mapping read."
        @tier "internal"
      LINT_LAZY -> external { orbitals : [string]! }
        @description "The resolved program's lazy children, by orbital, in the order LINT_CHILD_REQUEST indexes them."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string!  error : string! }
        @description "The file could not be read or lowered, or the language scan failed."
        @tier "internal"
      LINT_LANGUAGE -> external { latin : boolean! }
        @description "The program's language was decided: true for an English program."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : ResolvedProgram! }
        @description "The file resolved by program/read."
        @tier "internal"
      LINT_PACKS_RUN { cwd : string! }
        @description "Ask the language engine to scan the installed language packs."
        @tier "internal"
      LINT_CWD { path : string! }
        @description "The working directory read."
        @tier "internal"
    }

    listens {
      LINT_REQUEST { file : string! }
        @description "The lint request this trait answers: the cli trait of a rule or the umbrella routes its LINT_REQUEST here."
      LINT_CHILD_REQUEST { index : number! }
        @description "Offer the rules the lazy child at this index of LINT_LAZY's orbitals; the lint engine asks once per child."
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string!  coreRoot : string!  stdRoot : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished, with the installed @almadar/core root when it is compatible."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintInputOrbitalStart -> OrbLintInput, Packs, Versions
}
