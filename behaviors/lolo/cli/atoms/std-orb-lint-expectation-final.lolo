app std-orb-lint-expectation-final [
  version: "1.0.0",
  inbound: ["cli-lint-expectation-final"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-expectation-final — the `orb lint expectation-final <file>` command, the port of validate_final_expectations (composition/expectations.rs), the `orb validate --final` rule: where a generation concludes the program is the whole app, so every `expects` entry of every orbital (spec orbitals included, strict or not) that nothing in the program provides is ORB_S_EXPECTATION_UNSATISFIED. Providers are the inline entities of non-spec orbitals (entity, named identity, bare [identity]); a trait (event, state, transition), a page (by route path or protocol word) and a config knob are looked up in every orbital. The program is the resolved program the lint input reads. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint expectation-final: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-expectation-final"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type LObj = Map string LNode?
type ExKnob = { type : string, values : [string], default : LNode?, items : LNode?, properties : LNode? }
type ExWaivers = { read : string, create : string, update : string, delete : string }
type ExField = { name : string, type : string, required : boolean, primaryKey : boolean, unique : boolean, values : [string], default : LNode?, relation : LNode?, items : LNode?, properties : LNode? }
type ExEntity = { name : string, identity : boolean, shared : boolean, browser : boolean, persistence : string, collection : string, fields : [ExField], read_policy : LNode?, create_policy : LNode?, update_policy : LNode?, delete_policy : LNode?, access_waivers : ExWaivers? }
type ExExpect = { kind : string, name : string, strict : boolean, traitName : string, state : string, from : string, to : string, event : string, protocol : string, path : string, traits : [string], shape : [ExField], payload : [ExField], persistence : string, shared : boolean, browser : boolean, read_policy : LNode?, create_policy : LNode?, update_policy : LNode?, delete_policy : LNode?, access_waivers : ExWaivers?, knob : ExKnob }
type ExEmit = { event : string, payloadSchema : [ExField] }
type ExState = { name : string }
type ExTransition = { from : LNode, to : string, event : string, guard : LNode?, effects : [LNode?] }
type ExMachine = { states : [ExState], transitions : [ExTransition] }
type ExTrait = { name : string, emits : [ExEmit], stateMachine : ExMachine, ticks : [ExTransition], config : Map string ExKnob? }
type ExPageTrait = { ref : string, name : string }
type ExPage = { name : string, path : string, protocol : string, traits : [ExPageTrait] }
type ExOrbital = { name : string, spec : boolean, expects : [ExExpect], entity : ExEntity, auxiliaryEntities : [ExEntity], traits : [ExTrait], pages : [ExPage] }
type ExProgram = { orbitals : [ExOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintExpectationFinalCodes = { sExpectationUnsatisfied : LintCodeDecl, lintRuleFailed : LintCodeDecl }

orbital OrbLintExpectationFinalOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintExpectationFinalRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintExpectationFinal -> OrbLintExpectationFinalRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbs (object/get @payload.program "orbitals" [])))
 (let ((provs (array/filter (array/flatten (array/map (array/filter @orbs (fn o (not (object/get @o "spec" false)))) (fn o (array/map (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn e (!= (object/get @e "name" "") ""))) (fn e { n: (object/get @e "name" ""), id: (object/get @e "identity" false), on: (object/get @o "name" ""), e: @e }))))) (fn p (!= (object/get @p "n") ""))))
       (alltr (array/flatten (array/map @orbs (fn o (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t { t: @t, on: (object/get @o "name" "") }))))))
       (allpg (array/flatten (array/map @orbs (fn o (object/get @o "pages" []))))))
(array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
  (let ((o (array/nth @orbs @oi)))
   (if (not (validate/required @o)) [{ code: @config.codes.lintRuleFailed.code, path: "", message: "rule expectation-final: an indexed orbital or expects entry is absent", suggestion: "Report this as a lint engine defect", severity: "error" }]
   (if (not (object/has @o "expects")) []
    (let ((on (object/get @o "name" "")) (xs (object/get @o "expects" [])))
     (array/flatten (array/map (array/range 0 (array/len @xs)) (fn j
      (let ((x (array/nth @xs @j)))
       (if (not (validate/required @x)) [{ code: @config.codes.lintRuleFailed.code, path: "", message: "rule expectation-final: an indexed orbital or expects entry is absent", suggestion: "Report this as a lint engine defect", severity: "error" }]
       (let ((base (str/concat "orbitals[" @oi " (" @on ")].expects[" @j "]")) (kind (object/get @x "kind" "")) (strict (object/get @x "strict" false)))
        (let ((unprov (if (= @kind "entity") (if (array/some @provs (fn p (= (object/get @p "n") (object/get @x "name" "")))) "" (str/concat "entity `" (object/get @x "name" "") "`"))
  (if (= @kind "identity") (if (!= (object/get @x "name" "") "") (if (array/some @provs (fn p (= (object/get @p "n") (object/get @x "name" "")))) "" (str/concat "identity `" (object/get @x "name" "") "`")) (if (array/some @provs (fn p (object/get @p "id"))) "" "an [identity] entity"))
  (if (= @kind "event") (if (array/some @alltr (fn p (= (object/get (object/get @p "t") "name" "") (object/get @x "traitName" "")))) "" (str/concat "trait `" (object/get @x "traitName" "") "` (to emit `" (object/get @x "event" "") "`)"))
  (if (or (= @kind "state") (= @kind "transition")) (if (array/some @alltr (fn p (= (object/get (object/get @p "t") "name" "") (object/get @x "traitName" "")))) "" (str/concat "trait `" (object/get @x "traitName" "") "`"))
  (if (= @kind "page")
    (let ((pr (object/get @x "protocol" "")))
      (if (array/some @allpg (fn pg (if (!= @pr "") (= (object/get @pg "protocol" "") @pr) (and (= (object/get @pg "protocol" "") "") (= (object/get @pg "path" "") (object/get @x "path" ""))))))
        "" (if (!= @pr "") (str/concat "a `" @pr "` page") (str/concat "page `" (object/get @x "path" "") "`"))))
  (if (= @kind "config") (if (array/some @alltr (fn p (object/has (object/get (object/get @p "t") "config" {}) (object/get @x "name" "")))) "" (str/concat "config knob `" (object/get @x "name" "") "` on a trait"))
    ""))))))))
  (if (!= @unprov "") [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects " @unprov ", but nothing in this program provides it — its reads, writes and navigation would reach nothing."), suggestion: "Provide it in an orbital of this program (give the providing import that name, or declare it here).", severity: "error" }] []))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "expectation-final", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ExProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintExpectationFinalCodes = { sExpectationUnsatisfied: { code: "ORB_S_EXPECTATION_UNSATISFIED", category: "schema", description: "An orbital expects an entity, trait, event, or config default that nothing in the program provides" }, lintRuleFailed: { code: "ORB_LINT_RULE_FAILED", category: "lint", description: "A lint rule met an input its own preconditions exclude and could not check it" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintExpectationFinalCli -> OrbLintExpectationFinalRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint expectation-final <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-final") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint expectation-final: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-final") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint expectation-final: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-expectation-final" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint expectation-final` with its arguments and working directory."
        @synonyms "orb lint expectation-final"
      OrbLintExpectationFinal.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintExpectationFinalCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintExpectationFinalOrbitalStart -> OrbLintExpectationFinal, OrbLintExpectationFinalCli, OrbLintInput, Packs, Versions
}
