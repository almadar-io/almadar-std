                                          (if (or (= @nm "") (array/includes @on @nm) (array/includes @claimed @nm) (not (object/has @inl @nm))) @nof
                                            (if (and (not (object/has @wr @nm)) (not (and @shell (array/some (array/filter @trs0 (fn x (= (object/get @x "name" "") @nm))) (fn tt (array/some (array/map (array/filter (object/get (default (as (tree/index (array/concat (array/flatten (array/map (object/get @tt "stateMachine.transitions" @notr) (fn x (array/filter (object/get @x "effects" []) (fn r (validate/array @r)))))) (array/flatten (array/map (object/get @tt "ticks" @notk) (fn x (array/filter (object/get @x "effects" []) (fn r (validate/array @r))))))) ["render-ui"]) PoIdx) {}) "render-ui" []) (fn c (and (not (str/includes (object/get @c "path" "") ".")) (let ((n (object/get @c "node" null))) (let ((hh (array/nth @n 1))) (and (>= (array/len @n) 3) (validate/string @hh) (object/has @mainSet @hh))))))) (fn c (array/nth (object/get @c "node" null) 2))) (fn b (array/some (let ((nn (as (json/nodes @b) LNodes))) (if (= @nn null) @lnone @nn)) (fn nd (if (validate/object @nd) (if (validate/string (object/get @nd "type" null)) (array/some (object/get @ctlMap (str/replaceAll (str/replaceAll (object/get @nd "type" null) "~" "~t") "." "~d") @nos) (fn pn (let ((v (object/get @nd @pn null))) (if (validate/string @v) (!= @v "") false)))) false) false)))))))))) @nof
                                            (if (array/some @on (fn ow (= (array/len (let ((cs [@ow, @nm])) (let ((rcs (default (object/fromEntries (array/map @cs (fn a [@a, (let ((seed (array/unique (array/flatten (array/map [@a] (fn s (object/get @chanFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @chanFwd @x @nos)))))))))]))) {})) (res (default (object/fromEntries (array/map @cs (fn a [@a, (let ((seed (array/unique (array/flatten (array/map [@a] (fn s (object/get @embFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @embFwd @x @nos)))))))))]))) {}))) (let ((dropped (array/flatten (array/map @cs (fn a (array/flatten (array/map (array/filter @cs (fn b (!= @a @b))) (fn b (if (array/includes (object/get @rcs @a @nos) @b) [@a] (if (array/includes (object/get @res @a @nos) @b) [@b] @nos)))))))))) (array/filter @cs (fn c (not (array/includes @dropped @c)))))))) 1))) @nof
                                              [(if (object/has @wr @nm) { code: @config.codes.pageSecondContentBody.code, path: (str/concat "orbitals[" @oi "].pages[" @pj "]"), message: (str/concat "page \"" @path "\": " @nm " renders a content body into slot 'main' while " (str/join @on " / ") " already owns this page's content — a second, stacked UI if this is not a deliberate dedicated-feature page"), suggestion: (str/concat "embed <trait." @nm "> in the composer's render or a config slot (contentTrait/idleContent), or remove " @nm " from the page decl if it only hosts dialogs/logic"), severity: "error" } { code: @config.codes.pageControlOutsideShell.code, path: (str/concat "orbitals[" @oi "].pages[" @pj "]"), message: (str/concat "page \"" @path "\": " @nm " paints into slot 'main', but the page's shell shows " (str/join @on " / ") " as its content and nothing there embeds " @nm " — it stacks below the shell's layout instead of inside it"), suggestion: (str/concat "embed <trait." @nm "> in the content the shell shows (a stack set as its contentTrait), or remove " @nm " from the page"), severity: "error" })]))))))
                                        @nof))}]))))))))))))))))))))))
        (set @entity.findings (array/flatten (array/map @entity.rows (fn r (object/get @r "findings")))))
        (set @entity.owners (array/map @entity.rows (fn r { orbital: (object/get @r "oi"), page: (object/get @r "pj"), kind: (object/get @r "kind"), names: (object/get @r "names") })))
