                (mainSet (default (object/fromEntries (array/map @config.mainSlots (fn x [@x, true]))) {}))
                (contentSet (default (object/fromEntries (array/map (array/filter (object/keys @entity.patterns) (fn pn (array/some (object/values (object/get (object/get @entity.patterns @pn {}) "props" {})) (fn pr (= (object/get (default @pr {}) "kind" "") "entity"))))) (fn pn [(str/replaceAll (str/replaceAll @pn "~" "~t") "." "~d"), true]))) {}))
                (tmplSet (default (object/fromEntries (array/map (array/filter (object/keys @entity.patterns) (fn pn (= (object/get (object/get @entity.patterns @pn {}) "category" "") "template"))) (fn pn [(str/replaceAll (str/replaceAll @pn "~" "~t") "." "~d"), true]))) {}))
                (ctlMap (default (object/fromEntries (array/map (object/keys @entity.patterns) (fn pn [(str/replaceAll (str/replaceAll @pn "~" "~t") "." "~d"), (array/filter (object/keys (object/get (object/get @entity.patterns @pn {}) "props" {})) (fn pr (array/includes ["event" "event-ref"] (object/get (default (object/get (object/get (object/get @entity.patterns @pn {}) "props" {}) @pr) {}) "kind" ""))))]))) {})))
  (array/flatten (array/map (object/get @entity.program "orbitals" []) (fn (o oi)
    (let ((trs0 : [PoTrait] (object/get @o "traits" @notd)) (pgs (object/get @o "pages" @nopg)))
      (if (= (array/len @pgs) 0) @norows
        (let ((recs : [PoRec] (array/flatten (array/map @trs0 (fn (t ti)
