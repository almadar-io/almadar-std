                  (embFwd : PoAdj (default (object/fromEntries (array/map @recs (fn r [(object/get @r "n"), (array/unique (array/filter (array/concat (object/get @r "cf") (object/get @r "ct")) (fn c (and (!= @c "") (!= @c (object/get @r "n"))))))]))) {}))
                  (chanFwd : PoAdj (default (object/fromEntries (array/map @recs (fn r [(object/get @r "n"), (array/unique (array/filter (object/get @r "cf") (fn c (and (!= @c "") (!= @c (object/get @r "n")) (not (array/includes (object/get @r "ov") @c))))))]))) {})))
