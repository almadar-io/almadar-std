      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-content-owner", scope: @entity.scope, findings: @entity.findings })
        (emit PAGE_OWNERS { scope: @entity.scope, owners: @entity.owners })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      PAGE_OWNERS -> external { scope : string!  owners : [PageOwner]! }
        @description "The content owner of each page of the program, per orbital index and page index: kind channel (a content-grade main writer designated through the channel), sole (the one page-declared writer), ambiguous or none, with the owner names. Offered to the rules that read the owner (viewer-stranded)."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PoProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the binding roots each inline trait uses; a trait is searched for @trait references only when its roots hold @trait."
      PATTERNS_HEARD { patterns : Map string PoPattern! }
        @description "std-orb-lint-input's LINT_PATTERNS: the installed pattern registry's props, each with its kind."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      OrbLintInput.LINT_PATTERNS -> PATTERNS_HEARD
    }

    config {
      codes : LintPageContentOwnerCodes = { pageAmbiguousContentOwner: { code: "ORB_PAGE_AMBIGUOUS_CONTENT_OWNER", category: "page", description: "Several traits each render a content body into the main slot and none composes the others, so the page has no single content owner" }, pageSecondContentBody: { code: "ORB_PAGE_SECOND_CONTENT_BODY", category: "page", description: "More than one trait on a page renders a content body into the main slot" }, pageControlOutsideShell: { code: "ORB_PAGE_CONTROL_OUTSIDE_SHELL", category: "page", description: "A trait paints a control into the main slot of a page whose shell shows another trait as its content, and nothing there embeds it" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
      mainSlots : [string] = ["main", "content", "screen"]
        @label "Main slots"
        @description "The inline content slots a state paints."
    }

  }

  trait OrbLintPageContentOwnerCli -> OrbLintPageContentOwnerRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-content-owner <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-content-owner <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-content-owner <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-content-owner") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-content-owner: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-content-owner") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint page-content-owner: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-content-owner" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint page-content-owner` with its arguments and working directory."
        @synonyms "orb lint page-content-owner"
      OrbLintPageContentOwner.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }


  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPageContentOwnerCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPageContentOwnerOrbitalStart -> OrbLintPageContentOwner, OrbLintPageContentOwnerCli, OrbLintInput, Packs, Versions
}
