                    (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                      (let ((p (array/nth @pgs @pj)))
                        (if (not (validate/object @p)) @norows
                          (let ((declared (array/map (object/get @p "traits" @nor) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" "")))))
                                (path (object/get @p "path" "")))
                            (let ((chanCand (array/filter (let ((seed (array/unique (array/flatten (array/map @declared (fn s (object/get @chanFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @chanFwd @x @nos))))))))) (fn c (and (object/has @inl @c) (object/has @wr @c))))))
                              (let ((terminal (let ((cs @chanCand)) (let ((rcs (default (object/fromEntries (array/map @cs (fn a [@a, (let ((seed (array/unique (array/flatten (array/map [@a] (fn s (object/get @chanFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @chanFwd @x @nos)))))))))]))) {})) (res (default (object/fromEntries (array/map @cs (fn a [@a, (let ((seed (array/unique (array/flatten (array/map [@a] (fn s (object/get @embFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @embFwd @x @nos)))))))))]))) {}))) (let ((dropped (array/flatten (array/map @cs (fn a (array/flatten (array/map (array/filter @cs (fn b (!= @a @b))) (fn b (if (array/includes (object/get @rcs @a @nos) @b) [@a] (if (array/includes (object/get @res @a @nos) @b) [@b] @nos)))))))))) (array/filter @cs (fn c (not (array/includes @dropped @c)))))))))
