                                                   (if (= (array/len @distinct) 0) { kind: "none", names: @nos }
                                                     (if (= (array/len @distinct) 1) { kind: "sole", names: @distinct }
                                                       { kind: "ambiguous", names: (array/sort @distinct) })))))))
                                  (let ((ok (object/get @owner "kind")) (on (object/get @owner "names")) (shell (and (= @ok "channel") (array/some @declared (fn cand (and (object/has @inl @cand) (array/some (let ((seed (array/unique (array/flatten (array/map [@cand] (fn s (object/get @chanFwd @s @nos))))))) (array/reduce (array/range 0 @n1) @seed (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map @acc (fn x (object/get @chanFwd @x @nos))))))))) (fn rr (array/includes @on @rr))) (array/some (array/filter @trs0 (fn x (= (object/get @x "name" "") @cand))) (fn tt (array/some (array/map (array/filter (object/get (default (as (tree/index (array/flatten (array/map (object/get @tt "stateMachine.transitions" @notr) (fn x (array/filter (object/get @x "effects" []) (fn r (validate/array @r)))))) ["render-ui"]) PoIdx) {}) "render-ui" []) (fn c (and (not (str/includes (object/get @c "path" "") ".")) (let ((n (object/get @c "node" null))) (let ((hh (array/nth @n 1))) (and (>= (array/len @n) 3) (validate/string @hh) (object/has @mainSet @hh))))))) (fn c (array/nth (object/get @c "node" null) 2))) (fn b (array/some (let ((nn (as (json/nodes @b) LNodes))) (if (= @nn null) @lnone @nn)) (fn nd (if (validate/object @nd) (let ((ty (object/get @nd "type" null))) (if (validate/string @ty) (let ((pt (if (str/startsWith @ty (quote "@config.")) (let ((dv (object/get (object/get (object/get @tt "config" {}) (str/slice @ty 8) {}) "default" null))) (if (validate/string @dv) @dv "")) @ty))) (if (!= @pt "") (object/has @tmplSet (str/replaceAll (str/replaceAll @pt "~" "~t") "." "~d")) false)) false)) false)))))))))))))
                                    [{ oi: @oi, pj: @pj, kind: @ok, names: @on, findings: (array/concat
                                      (if (= @ok "ambiguous")
                                        (let ((rivals (array/filter @on (fn x (not (array/includes @claimed @x))))))
                                          (if (> (array/len @rivals) 1)
                                            [{ code: @config.codes.pageAmbiguousContentOwner.code, path: (str/concat "orbitals[" @oi "].pages[" @pj "]"), message: (str/concat "page \"" @path "\": " (str/join @rivals ", ") " each render a content body into slot 'main' and none composes the others — the page has no single content owner, so a shell that designates one turns the rest into second bodies"), suggestion: (str/concat "make one trait the page's composer — it embeds the others (<trait.X/> or @trait.X in its render) — and mount only it on the page; candidates: " (str/join @rivals ", ")), severity: "error" }]
                                            @nof))
