  (if (validate/array @n)
    (let ((kr (array/map @k (fn q (if (= @q null) @nr @q)))) (h0 (if (> (array/len @n) 0) (array/nth @n 0) null)) (h1 (if (> (array/len @n) 1) (array/nth @n 1) null)))
      (if (and (>= (array/len @n) 3) (validate/string @h0) (= @h0 "if") (let ((c1 (array/nth @n 1))) (if (validate/boolean @c1) (= @c1 false) false)))
        { w: (let ((k3 (array/nth @kr 3))) (if (= @k3 null) false (object/get @k3 "w"))), p: @nos }
        (if (and (>= (array/len @n) 3) (validate/string @h0) (= @h0 "render-ui") (validate/string @h1) (object/has @mainSet @h1))
