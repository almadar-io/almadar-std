                false))), p: @nos }
          { w: (array/some @kr (fn q (object/get @q "w"))), p: @nos })))
    @nr)) "PoNode"))) (if (= @q null) @nr @q)) "w") }])))))))))
            (let ((n1 (+ (array/len @recs) 1))
