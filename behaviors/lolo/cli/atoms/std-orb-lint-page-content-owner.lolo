                      (let ((effs (array/concat (array/flatten (array/map (object/get @t "stateMachine.transitions" @notr) (fn x (array/filter (object/get @x "effects" []) (fn r (validate/array @r)))))) (array/flatten (array/map (object/get @t "ticks" @notk) (fn x (array/filter (object/get @x "effects" []) (fn r (validate/array @r)))))))))
                        (let ((pairs : [PoPair] (if @gt (array/flatten (array/map (array/filter (object/get (default (as (tree/index @effs ["render-ui"]) PoIdx) {}) "render-ui" []) (fn c (not (str/includes (object/get @c "path" "") ".")))) (fn c (let ((n (object/get @c "node" null))) (let ((h1 (as (array/nth @n 1) LStr))) (if (and (>= (array/len @n) 3) (!= @h1 null)) (let ((pl (array/nth @n 2)))
            (array/map (array/filter (array/concat (let ((nn1 (as (json/nodes @pl) LNodes))) (array/map (if (= @nn1 null) @lnone @nn1) (fn nd1 (let ((st1 (default (as @nd1 LStr) ""))) (if (str/startsWith @st1 (quote "@trait.")) (let ((hd (array/first (str/split (str/slice @st1 7 (str/len @st1)) ".")))) (if (= @hd null) "" (let ((nm (array/first (str/split @hd "[")))) (if (= @nm null) "" @nm)))) ""))))) (if (validate/string @pl) (if (str/startsWith @pl (quote "@config.")) (let ((dv (object/get (object/get @cfg (str/slice @pl 8) {}) "default" null))) (if (= @dv null) @nos (let ((nn2 (as (json/nodes @dv) LNodes))) (array/map (if (= @nn2 null) @lnone @nn2) (fn nd2 (let ((st2 (default (as @nd2 LStr) ""))) (if (str/startsWith @st2 (quote "@trait.")) (let ((hd (array/first (str/split (str/slice @st2 7 (str/len @st2)) ".")))) (if (= @hd null) "" (let ((nm (array/first (str/split @hd "[")))) (if (= @nm null) "" @nm)))) ""))))))) @nos) @nos)) (fn c (!= @c ""))) (fn c { c: @c, h: @h1 }))) @nopairs)))))) @nopairs)))
                          [{ n: @tn,
                            cf: (if @gt (let ((nnc (as (json/nodes (array/map (object/values @cfg) (fn f (object/get (default @f {}) "default" null)))) LNodes))) (array/map (if (= @nnc null) @lnone @nnc) (fn ndc (let ((stc (default (as @ndc LStr) ""))) (if (str/startsWith @stc (quote "@trait.")) (let ((hd (array/first (str/split (str/slice @stc 7 (str/len @stc)) ".")))) (if (= @hd null) "" (let ((nm (array/first (str/split @hd "[")))) (if (= @nm null) "" @nm)))) ""))))) @nos),
                            ct: (if @gt (array/concat (let ((nns (as (json/nodes (array/map (object/get @t "stateMachine.transitions" @notr) (fn x [(object/get @x "guard" null), (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r))))]))) LNodes))) (array/map (if (= @nns null) @lnone @nns) (fn nds (let ((sts (default (as @nds LStr) ""))) (if (str/startsWith @sts (quote "@trait.")) (let ((hd (array/first (str/split (str/slice @sts 7 (str/len @sts)) ".")))) (if (= @hd null) "" (let ((nm (array/first (str/split @hd "[")))) (if (= @nm null) "" @nm)))) ""))))) (let ((nnk (as (json/nodes (array/map (object/get @t "ticks" @notk) (fn x [(object/get @x "guard" null), (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r))))]))) LNodes))) (array/map (if (= @nnk null) @lnone @nnk) (fn ndk (let ((stk (default (as @ndk LStr) ""))) (if (str/startsWith @stk (quote "@trait.")) (let ((hd (array/first (str/split (str/slice @stk 7 (str/len @stk)) ".")))) (if (= @hd null) "" (let ((nm (array/first (str/split @hd "[")))) (if (= @nm null) "" @nm)))) "")))))) @nos),
                            ov: (array/filter (array/unique (array/map @pairs (fn pr (object/get @pr "c")))) (fn nm (not (array/some @pairs (fn pr (and (= (object/get @pr "c") @nm) (object/has @mainSet (object/get @pr "h")))))))),
