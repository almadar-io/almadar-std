app std-orb-lint-page-content-owner [
  version: "1.0.0",
  inbound: ["cli-lint-page-content-owner"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-page-content-owner - the `orb lint page-content-owner <file>` command, the port of ORB_PAGE_AMBIGUOUS_CONTENT_OWNER and ORB_PAGE_SECOND_CONTENT_BODY (circuit/closed_circuit.rs validate_page_content_ownership, phases/program/page_content_owner.rs). Per orbital with pages it builds the trait embed graphs from `@trait.<Name>` tokens (the full graph: config defaults, guards, effects, ticks; the content channel: config defaults only, minus a trait the declaring trait paints only into non-main slots), resolves each page's content owner (a content-grade main writer designated through the channel, else the sole page-declared writer, reduced by designation and containment), and reports a page whose writers none composes the others (ORB_PAGE_AMBIGUOUS_CONTENT_OWNER, rivals not embedded by a client-bound trait) and a page-declared content writer that is neither the owner, nor embedded by a client-bound trait, nor kin to the owner (ORB_PAGE_SECOND_CONTENT_BODY). A content-grade body is a string payload, an object with children, or a pattern with an entity-kind prop (LINT_PATTERNS). The main slots are the rule's knob. A page-declared trait that is no content writer but paints a control into main (a pattern node whose event or event-ref prop holds a non-empty string) while the owner is a channel and a page trait that channels the owner paints a template-category pattern into main, and that is neither the owner, embedded by a client-bound trait, nor kin to the owner, is ORB_PAGE_CONTROL_OUTSIDE_SHELL. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint page-content-owner: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-page-content-owner"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type PoNode = string | number | boolean | [PoNode?] | Map string PoNode?
type PoTransition = { event : string, guard : PoNode?, effects : [PoNode?] }
type PoMachine = { transitions : [PoTransition] }
type PoField = { default : PoNode? }
type PoTick = { guard : PoNode?, effects : [PoNode?] }
type PoRef = { ref : string, name : string }
type PoPage = { path : string, protocol : string, traits : [PoRef] }
type PoTrait = { name : string, stateMachine : PoMachine, config : Map string PoField?, ticks : [PoTick] }
type PoOrbital = { name : string, traits : [PoTrait], pages : [PoPage] }
type PoProgram = { orbitals : [PoOrbital] }
type PoPatProp = { kind : string? }
type PoPattern = { category : string, props : Map string PoPatProp? }
type PoR = { w : boolean!, p : [string]! }
type PoPair = { c : string!, h : string! }
type PoRec = { n : string!, cf : [string]!, ct : [string]!, ov : [string]!, w : boolean! }
type PoAdj = Map string [string]
type PoCall = { path : string!, node : [PoNode?]! }
type PoIdx = Map string [PoCall]
type PoRow = { oi : number!, pj : number!, kind : string!, names : [string]!, findings : [OrbFinding]! }
type PageOwner = { orbital : number!, page : number!, kind : string!, names : [string]! }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintPageContentOwnerCodes = { pageAmbiguousContentOwner : LintCodeDecl , pageSecondContentBody : LintCodeDecl , pageControlOutsideShell : LintCodeDecl }

orbital OrbLintPageContentOwnerOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"


  entity OrbLintPageContentOwnerRun [runtime] {
    id : string!
    scope : string = ""
    program : PoProgram = {}
    roots : Map string [string] = {}
    patterns : Map string PoPattern = {}
    rows : [PoRow] = []
    owners : [PageOwner] = []
    findings : [OrbFinding] = []
  }

  trait OrbLintPageContentOwner -> OrbLintPageContentOwnerRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
      PATTERNS_HEARD -> ready
        (set @entity.patterns @payload.patterns)
      LINT_INPUT -> ready
        (set @entity.program @payload.program)
        (set @entity.scope @payload.scope)
        (set @entity.rows (let ((norows : [PoRow] []) (nos : [string] [])
                (nof : [OrbFinding] [])
