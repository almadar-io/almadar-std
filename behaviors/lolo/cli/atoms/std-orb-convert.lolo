app std-orb-convert [
  version: "1.0.0",
  inbound: ["cli-convert"],
  exec: ["npx"],
  env: ["PATH", "HOME", "TMPDIR", "SHELL", "USER", "LANG", "NODE_OPTIONS", "ANTHROPIC_API_KEY"],
  description: "std-orb-convert — the `orb convert` command. It runs `npx almadar-converter` through std-cli with the call's words (the output defaults to converted.orb, the depth to 3, -v becomes --verbose, and --json is always added) and renders the converter's JSON progress lines: `[gate] message...` on start, ` message` on complete, `[gate] message` on progress, ` ERROR: message` on error and `Output: <file>` on the final success line; with -v the `Running:` line leads and lines that are not JSON are echoed. The converter's own stderr leads the answer. A final line with success false answers `Error: Conversion failed: <error>`, a non-zero exit `Error: almadar-converter exited with code <n>` and an npx that cannot start `Error: Failed to spawn npx: <error>. Is Node.js installed?` (status 500, exit 1); a clean run answers status 200. The converter runs in the host's working directory and sees the host variables listed in the passEnv knob of the ConvertCli trait. Unlike the Rust command, flags are not checked here: the converter itself refuses what it does not know, and the answer arrives after the converter ends, not line by line."
]
uses Spec from "almadar-std/orb-convert"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type ConvertEvent = { gate : string, status : string, message : string, success : boolean, output : string, error : string, raw : string }

orbital OrbConvertOrbital {
  uses Cli from "std/behaviors/std-cli"
  uses Args from "std/behaviors/std-args"

  entity OrbConvertRun [runtime] {
    id : string!
    verbose : boolean @description "The call in flight asked for -v/--verbose." = false
    words : [string] @description "The words handed to almadar-converter for the call in flight." = []
    stderr : string @description "What the converter wrote on stderr." = ""
    events : [ConvertEvent] @description "The converter's stdout lines, each parsed, or carried as raw text when it is not JSON." = []
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbConvert.CONVERT_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait ConvertCli = Cli.traits.CliRunner {
    listens {
      OrbConvert.CONVERT_EXEC -> CLI_RUN
    }
    config {
      commands: ["npx"]
      passEnv: ["PATH", "HOME", "TMPDIR", "SHELL", "USER", "LANG", "NODE_OPTIONS", "ANTHROPIC_API_KEY"]
    }
  }

  trait OrbConvert -> OrbConvertRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      CONVERT_CALLED -> parsing
        (emit CONVERT_ARGS_PARSE { stage: "convert" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "output" aliases: ["-o"] takesValue: true repeatable: false }, { name: "crawl" aliases: [] takesValue: true repeatable: false }, { name: "crawl-facts" aliases: [] takesValue: true repeatable: false }, { name: "depth" aliases: [] takesValue: true repeatable: false }, { name: "ai" aliases: [] takesValue: false repeatable: false }, { name: "verify" aliases: [] takesValue: false repeatable: false }, { name: "facts-only" aliases: [] takesValue: false repeatable: false }, { name: "headed" aliases: [] takesValue: false repeatable: false }, { name: "verbose" aliases: ["-v"] takesValue: false repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      CONVERT_ARGS_DONE -> ready when (> (array/len @payload.errors) 0)
        (emit CONVERT_ANSWERED { status: 400, body: (str/concat "Error: " (str/join @payload.errors "; ")) })
      CONVERT_ARGS_DONE -> working when (= (array/len @payload.errors) 0)
        (set @entity.verbose (!= (object/get @payload.flags "verbose") null))
        (set @entity.words (array/concat
          (array/filter @payload.words (fn w (and (!= @w "-v") (!= @w "--verbose"))))
          (if (!= (object/get @payload.flags "output") null) [] ["-o", "converted.orb"])
          (if (!= (object/get @payload.flags "depth") null) [] ["--depth", "3"])
          ["--json"]
          (if @entity.verbose ["--verbose"] [])))
        (emit CONVERT_EXEC { stage: "convert" argv: (array/prepend @entity.words "almadar-converter") })
    }

    state working {
      INIT -> working
      CONVERT_RAN -> working when (= @payload.exitCode 0)
        (set @entity.stderr @payload.stderr)
        (set @entity.events (array/map (str/split @payload.stdout "\n") (fn l (if (json/valid @l) (json/parse @l ConvertEvent) { raw: @l }))))
        (emit CONVERT_FINISH { })
      CONVERT_RAN -> ready when (!= @payload.exitCode 0)
        (emit CONVERT_ANSWERED { status: 500, body: (str/concat @payload.stderr "Error: almadar-converter exited with code " @payload.exitCode) })
      CONVERT_FINISH -> ready when (array/some @entity.events (fn ev (and (== (object/get @ev "success") false) (!= (object/get @ev "error") null))))
        (emit CONVERT_ANSWERED { status: 500, body: (str/concat @entity.stderr "Error: Conversion failed: " (object/get (array/find @entity.events (fn ev (and (== (object/get @ev "success") false) (!= (object/get @ev "error") null)))) "error")) })
      CONVERT_FINISH -> ready when (not (array/some @entity.events (fn ev (and (== (object/get @ev "success") false) (!= (object/get @ev "error") null)))))
        (emit CONVERT_ANSWERED { status: 200, body: (str/concat @entity.stderr (if @entity.verbose (str/concat "Running: npx almadar-converter " (str/join @entity.words " ") "\n") "") (str/join (array/map @entity.events (fn ev (if (!= (object/get @ev "raw") null) (if @entity.verbose (str/concat (object/get @ev "raw") "\n") "") (if (!= (object/get @ev "gate") null) (str/concat (if (= (object/get @ev "status") "progress") "\n" "") (if (= (object/get @ev "status") "start") (str/concat "[" (object/get @ev "gate") "] ") "") (if (= (object/get @ev "status") "progress") (str/concat "[" (object/get @ev "gate") "] ") "") (if (= (object/get @ev "status") "complete") " " "") (if (= (object/get @ev "status") "error") " ERROR: " "") (str/default (object/get @ev "message") "") (if (= (object/get @ev "status") "start") "..." "") (if (= (object/get @ev "status") "start") "" "\n")) (if (and (== (object/get @ev "success") true) (!= (object/get @ev "output") null)) (str/concat "\nOutput: " (object/get @ev "output") "\n") ""))))) "")) })
      CONVERT_CLI_FAILED -> ready when (= @payload.code "cli_spawn_failed")
        (emit CONVERT_ANSWERED { status: 500, body: (str/concat "Error: Failed to spawn npx: " @payload.error ". Is Node.js installed?") })
      CONVERT_CLI_FAILED -> ready when (!= @payload.code "cli_spawn_failed")
        (emit CONVERT_ANSWERED { status: 500, body: (str/concat @payload.code ": " @payload.error) })
    }

    emits {
      CONVERT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      CONVERT_FINISH { }
        @description "Internal: render the converter's lines into the answer."
        @tier "internal"
      CONVERT_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the convert flags."
        @tier "internal"
      CONVERT_EXEC {
        stage : string!
        argv : [string]!
      }
        @description "Internal: run npx on almadar-converter with the call's words."
        @tier "internal"
    }

    listens {
      CONVERT_CALLED -> inbound "cli-convert" answers CONVERT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb convert` with its path, output and mode flags."
        @synonyms "orb convert, convert a project to an orb program"
      CONVERT_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stderr : string!
      }
        @description "std-cli's CLI_DONE: the converter exited, with its code and both streams."
      CONVERT_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "std-cli's CLI_FAILED: npx could not be run."
      CONVERT_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> CONVERT_ARGS_DONE
      ConvertCli.CLI_DONE -> CONVERT_RAN
      ConvertCli.CLI_FAILED -> CONVERT_CLI_FAILED
    }
  }

  page "/orb-convert" as OrbConvertPage -> OrbConvert, ArgsCli, ConvertCli
}
