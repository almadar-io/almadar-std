app std-orb-lint-worker-a [
  version: "1.0.0",
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-worker-a — one lint worker: the lint engine's collecting trait and producers over a subset of its rule traits, composed from std-orb-lint-engine. A host opens it as a guest session, hands it the file and the language packs it scanned (LintWorker.WORKER_GO) and hears WORKER_DONE { ok, error, found, final }. The rule traits listed here are this worker's share of the partition: every rule trait of the engine is in exactly one worker, with the rules it listens to."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type RuleFound = { rule : string!, findings : [OrbFinding]! }
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type LeafTrait = { name : string }
type LeafOrbital = { name : string, traits : [LeafTrait] }
type LeafNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type PatternEventProp = { pattern : string!, prop : string!, field : string! }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcByLiteral = { key : string!, required : Map string [string]! }
type HcClosed = { request : boolean?, intRange : HcIntRange?, requestKeysByLiteral : HcByLiteral? }
type HcGrantNeed = Map string HcVal
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcOrbital = { name : string, traits : [HcVal] }
type SrService = { actions : Map string SrAction! }
type SrAction = { params : [SrParam]!, hasKey : boolean! }
type SrParam = { name : string!, type : string!, required : boolean!, kind : string! }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, family : string?, emitKeys : [string]? }
type CiNode = string | number | boolean | [CiNode?] | Map string CiNode?
type WalkSlot = { kind : string!, args : [number] }
type WalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type ExprAskItem = { e : FiredNode?, eff : boolean! }
type WorkerPack = { name : string!, text : string! }

orbital OrbLintWorkerAOrbital {
  uses Engine from "std/behaviors/std-orb-lint-engine"
  uses Worker0 from "std/behaviors/std-orb-lint-worker"

  entity OrbLintWorkerARun [runtime] {
    id : string!
  }

  trait OrbLintEngine = Engine.traits.OrbLintEngine {
    config {
      rules: ["collection-policy", "emit-config-ref", "entity-duplicate-field", "generic-types", "listen-trigger", "orbital-duplicate-name", "page-modifiers", "entity-name-shadows-trait-union", "async-result-deaf-target", "duplicate-transition", "state-shape", "empty-event-name", "state-unreachable", "asset-inline-url", "theme-pin-contradicts-app", "llm-wire-unrouted", "computed-key-dot-path", "mem-handles", "parallel-pure", "emit", "circular-dependencies", "unsigned-guard", "theme-undeclared", "item-action-event", "config-role-lists", "browser-effects", "circuit-graph", "config-dangling-ref", "embed-config-forward", "event-wiring", "fetch-deliver", "not-found", "groupby-enum-column-gap", "set-column", "sexpr-binding", "theme-values", "trait-embeds"]
      finalRules: ["not-found"]
      programOnlyRules: []
    }
    listens {
      LINT_RUN { file : string! }
        @description "Run every lint rule over this file; the cli hook and std-orb-validate emit it."
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      LINT_FOUND { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "One rule atom's findings for the file or the lazy child being linted."
      LINT_LAZY_HEARD { orbitals : [string]! }
        @description "std-orb-lint-input's LINT_LAZY: the lazy children to lint after the program."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
      CallSiteInput.LINT_CALL_SITES_UNREAD -> LINT_INPUT_UNREAD
      OrbLintInput.LINT_LAZY -> LINT_LAZY_HEARD
      OrbLintCollectionPolicy.LINT_FOUND -> LINT_FOUND
      OrbLintEmitConfigRef.LINT_FOUND -> LINT_FOUND
      OrbLintEntityDuplicateField.LINT_FOUND -> LINT_FOUND
      OrbLintGenericTypes.LINT_FOUND -> LINT_FOUND
      OrbLintListenTrigger.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalDuplicateName.LINT_FOUND -> LINT_FOUND
      OrbLintPageModifiers.LINT_FOUND -> LINT_FOUND
      OrbLintEntityNameShadowsTraitUnion.LINT_FOUND -> LINT_FOUND
      OrbLintAsyncResultDeafTarget.LINT_FOUND -> LINT_FOUND
      OrbLintDuplicateTransition.LINT_FOUND -> LINT_FOUND
      OrbLintStateShape.LINT_FOUND -> LINT_FOUND
      OrbLintEmptyEventName.LINT_FOUND -> LINT_FOUND
      OrbLintStateUnreachable.LINT_FOUND -> LINT_FOUND
      OrbLintAssetInlineUrl.LINT_FOUND -> LINT_FOUND
      OrbLintThemePinContradictsApp.LINT_FOUND -> LINT_FOUND
      OrbLintLlmWireUnrouted.LINT_FOUND -> LINT_FOUND
      OrbLintComputedKeyDotPath.LINT_FOUND -> LINT_FOUND
      OrbLintMemHandles.LINT_FOUND -> LINT_FOUND
      OrbLintParallelPure.LINT_FOUND -> LINT_FOUND
      OrbLintEmit.LINT_FOUND -> LINT_FOUND
      OrbLintCircularDependencies.LINT_FOUND -> LINT_FOUND
      OrbLintUnsignedGuard.LINT_FOUND -> LINT_FOUND
      OrbLintThemeUndeclared.LINT_FOUND -> LINT_FOUND
      OrbLintItemActionEvent.LINT_FOUND -> LINT_FOUND
      OrbLintConfigRoleLists.LINT_FOUND -> LINT_FOUND
      OrbLintBrowserEffects.LINT_FOUND -> LINT_FOUND
      OrbLintCircuitGraph.LINT_FOUND -> LINT_FOUND
      OrbLintConfigDanglingRef.LINT_FOUND -> LINT_FOUND
      OrbLintEmbedConfigForward.LINT_FOUND -> LINT_FOUND
      OrbLintEventWiring.LINT_FOUND -> LINT_FOUND
      OrbLintFetchDeliver.LINT_FOUND -> LINT_FOUND
      OrbLintNotFound.LINT_FOUND -> LINT_FOUND
      OrbLintGroupbyEnumColumnGap.LINT_FOUND -> LINT_FOUND
      OrbLintSetColumn.LINT_FOUND -> LINT_FOUND
      OrbLintSexprBinding.LINT_FOUND -> LINT_FOUND
      OrbLintThemeValues.LINT_FOUND -> LINT_FOUND
      OrbLintTraitEmbeds.LINT_FOUND -> LINT_FOUND
      Worker.LINT_RUN -> LINT_RUN
    }
  }
  trait Packs = Worker0.traits.PacksGiven {
    listens {
      PACKS_GIVEN { packs : [WorkerPack]!  coreRoot : string!  stdRoot : string! }
      LANG_SCAN { cwd : string! }
      OrbLintInput.LINT_PACKS_RUN -> LANG_SCAN
      Worker.PACKS_GIVEN -> PACKS_GIVEN
    }
  }
  trait Worker = Worker0.traits.LintWorker {
    listens {
      WORKER_GO -> input { file : string!  packs : [WorkerPack]!  coreRoot : string!  stdRoot : string! }
      WORKER_UNREAD { file : string!  error : string! }
      WORKER_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]!  final : [OrbFinding]! }
      OrbLintEngine.LINT_COLLECTED -> WORKER_COLLECTED
      OrbLintInput.LINT_INPUT_UNREAD -> WORKER_UNREAD
    }
  }
  trait OrbLintNotFound = Engine.traits.OrbLintNotFound {
  }
  trait OrbLintInput = Engine.traits.OrbLintInput {
  }
  trait OrbLintCollectionPolicy = Engine.traits.OrbLintCollectionPolicy {
  }
  trait OrbLintEmitConfigRef = Engine.traits.OrbLintEmitConfigRef {
  }
  trait OrbLintEntityDuplicateField = Engine.traits.OrbLintEntityDuplicateField {
  }
  trait OrbLintGenericTypes = Engine.traits.OrbLintGenericTypes {
  }
  trait OrbLintListenTrigger = Engine.traits.OrbLintListenTrigger {
  }
  trait OrbLintOrbitalDuplicateName = Engine.traits.OrbLintOrbitalDuplicateName {
  }
  trait OrbLintPageModifiers = Engine.traits.OrbLintPageModifiers {
  }
  trait OrbLintEntityNameShadowsTraitUnion = Engine.traits.OrbLintEntityNameShadowsTraitUnion {
  }
  trait OrbLintAsyncResultDeafTarget = Engine.traits.OrbLintAsyncResultDeafTarget {
  }
  trait OrbFiredEvents = Engine.traits.OrbFiredEvents {
  }
  trait OrbLintDuplicateTransition = Engine.traits.OrbLintDuplicateTransition {
  }
  trait OrbLintStateShape = Engine.traits.OrbLintStateShape {
  }
  trait OrbLintEmptyEventName = Engine.traits.OrbLintEmptyEventName {
  }
  trait OrbLintStateUnreachable = Engine.traits.OrbLintStateUnreachable {
  }
  trait OrbLintAssetInlineUrl = Engine.traits.OrbLintAssetInlineUrl {
  }
  trait OrbLintThemePinContradictsApp = Engine.traits.OrbLintThemePinContradictsApp {
  }
  trait OrbLintLlmWireUnrouted = Engine.traits.OrbLintLlmWireUnrouted {
  }
  trait OrbLintComputedKeyDotPath = Engine.traits.OrbLintComputedKeyDotPath {
  }
  trait OrbLintMemHandles = Engine.traits.OrbLintMemHandles {
  }
  trait OrbLintParallelPure = Engine.traits.OrbLintParallelPure {
  }
  trait OrbLintEmit = Engine.traits.OrbLintEmit {
  }
  trait OrbLintCircularDependencies = Engine.traits.OrbLintCircularDependencies {
  }
  trait OrbLintUnsignedGuard = Engine.traits.OrbLintUnsignedGuard {
  }
  trait OrbLintThemeUndeclared = Engine.traits.OrbLintThemeUndeclared {
  }
  trait OrbLintItemActionEvent = Engine.traits.OrbLintItemActionEvent {
  }
  trait OrbLintConfigRoleLists = Engine.traits.OrbLintConfigRoleLists {
  }
  trait OrbEmbedChain = Engine.traits.OrbEmbedChain {
  }
  trait OrbEffectLeaves = Engine.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [LeafOrbital]!  heads : [string]! }
        @description "The effect-sequencing rules' asks: flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[LeafNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintEmit.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintLlmWireUnrouted.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbProducedProgram = Engine.traits.OrbProducedProgram {
  }
  trait OrbLintBrowserEffects = Engine.traits.OrbLintBrowserEffects {
  }
  trait OrbLintCircuitGraph = Engine.traits.OrbLintCircuitGraph {
  }
  trait OrbLintConfigDanglingRef = Engine.traits.OrbLintConfigDanglingRef {
  }
  trait OrbLintEmbedConfigForward = Engine.traits.OrbLintEmbedConfigForward {
  }
  trait OrbLintEventWiring = Engine.traits.OrbLintEventWiring {
  }
  trait OrbLintFetchDeliver = Engine.traits.OrbLintFetchDeliver {
  }
  trait OrbLintExprNodes = Engine.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string WalkSlot!  projections : Map string WalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [ExprAskItem]! }
        @description "A rule offers the expressions whose nodes it needs."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbLintFetchDeliver.LINT_EXPR_ASK -> LINT_EXPR_ASK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait OrbLintGroupbyEnumColumnGap = Engine.traits.OrbLintGroupbyEnumColumnGap {
  }
  trait OrbLintSetColumn = Engine.traits.OrbLintSetColumn {
  }
  trait OrbLintSexprBinding = Engine.traits.OrbLintSexprBinding {
  }
  trait OrbLintThemeValues = Engine.traits.OrbLintThemeValues {
  }
  trait OrbLintTraitEmbeds = Engine.traits.OrbLintTraitEmbeds {
  }
  trait OrbEmitConfigBrowserEffects = Engine.traits.OrbEmitConfigBrowserEffects {
  }
  trait HostCalls = Engine.traits.HostCalls {
    listens {
      HOST_CALLS_COLLECT { requestId : string!  orbitals : [HcOrbital]!  heads : [string]!  operators : [string]!  fields : [string]! }
      OrbLintBrowserEffects.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LINT_OPERATOR_SHAPES_HEARD { operators : Map string HcShape! }
      LINT_OPERATOR_SHAPES_UNREAD_HEARD { error : string! }
      LINT_HOST_FACTS_HEARD { operators : Map string HcExtras! }
      LINT_HOST_FACTS_UNREAD_HEARD { error : string! }
      OrbLintInput.LINT_OPERATOR_SHAPES -> LINT_OPERATOR_SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> LINT_OPERATOR_SHAPES_UNREAD_HEARD
      OrbLintInput.LINT_HOST_FACTS -> LINT_HOST_FACTS_HEARD
      OrbLintInput.LINT_HOST_FACTS_UNREAD -> LINT_HOST_FACTS_UNREAD_HEARD
    }
  }
  trait ServiceRegistry = Engine.traits.ServiceRegistry {
    listens {
      LINT_SERVICES_HEARD { services : Map string SrService! }
      LINT_SERVICES_UNREAD_HEARD { error : string! }
      OrbLintInput.LINT_SERVICES -> LINT_SERVICES_HEARD
      OrbLintInput.LINT_SERVICES_UNREAD -> LINT_SERVICES_UNREAD_HEARD
    }
  }
  trait OrbValueLeaves = Engine.traits.OrbValueLeaves {
    listens {
      VALUE_SEMANTICS_HEARD { functions : [string]! }
      VALUE_LEAVES_ASK { requestId : string!  values : [CiNode?]! }
      VALUE_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> VALUE_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> VALUE_WALK_HEARD
    }
  }
  trait CallSiteInput = Engine.traits.CallSiteInput {
  }
  trait OrbProducedEvents = Engine.traits.OrbProducedEvents {
    listens {
      PRODUCED_SEMANTICS_HEARD { functions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      PRODUCED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      PRODUCED_PATTERNS_HEARD { byPattern : [PatternEventProp]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: each pattern's event props and event-list fields."
      PRODUCED_SLOTS_HEARD { emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the emit option slots the operator table declares."
      PRODUCED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "A program whose produced events are asked: trait-ref-config offers one upstream trait at a time."
      OrbLintInput.LINT_EVENT_PROPS -> PRODUCED_PATTERNS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> PRODUCED_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> PRODUCED_WALK_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> PRODUCED_SLOTS_HEARD
    }
  }

  page boot as OrbLintWorkerAOrbitalStart -> OrbLintEngine, Packs, Worker, OrbLintNotFound, OrbLintInput, OrbLintCollectionPolicy, OrbLintEmitConfigRef, OrbLintEntityDuplicateField, OrbLintGenericTypes, OrbLintListenTrigger, OrbLintOrbitalDuplicateName, OrbLintPageModifiers, OrbLintEntityNameShadowsTraitUnion, OrbLintAsyncResultDeafTarget, OrbFiredEvents, OrbLintDuplicateTransition, OrbLintStateShape, OrbLintEmptyEventName, OrbLintStateUnreachable, OrbLintAssetInlineUrl, OrbLintThemePinContradictsApp, OrbLintLlmWireUnrouted, OrbLintComputedKeyDotPath, OrbLintMemHandles, OrbLintParallelPure, OrbLintEmit, OrbLintCircularDependencies, OrbLintUnsignedGuard, OrbLintThemeUndeclared, OrbLintItemActionEvent, OrbLintConfigRoleLists, OrbEmbedChain, OrbEffectLeaves, OrbProducedProgram, OrbLintBrowserEffects, OrbLintCircuitGraph, OrbLintConfigDanglingRef, OrbLintEmbedConfigForward, OrbLintEventWiring, OrbLintFetchDeliver, OrbLintExprNodes, OrbLintGroupbyEnumColumnGap, OrbLintSetColumn, OrbLintSexprBinding, OrbLintThemeValues, OrbLintTraitEmbeds, OrbEmitConfigBrowserEffects, HostCalls, ServiceRegistry, OrbValueLeaves, CallSiteInput, OrbProducedEvents
}
