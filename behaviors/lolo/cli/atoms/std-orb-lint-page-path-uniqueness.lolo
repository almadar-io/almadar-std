app std-orb-lint-page-path-uniqueness [
  version: "1.0.0",
  inbound: ["cli-lint-page-path-uniqueness"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-page-path-uniqueness — the `orb lint page-path-uniqueness <file>` command, the port of validate_page_path_uniqueness. It lowers the file with program/read, collapses each page path to its param shape (every :name segment becomes a bare :) and reports ORB_P_DUPLICATE_PATH once per shape shared by two or more pages across all orbitals, at the first page, with the paths and locations (status 500, exit 1). Clean answers `lint page-path-uniqueness: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-page-path-uniqueness"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintPagePathUniquenessOrbital {
  entity OrbLintPagePathUniquenessRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintPagePathUniqueness -> OrbLintPagePathUniquenessRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-path-uniqueness", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (let ((locs (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
                    (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                      (if (object/has (array/nth @pgs @pj) "path") [(str/concat "orbitals[" @oi "].pages[" @pj "]")] [])))))))))
                (rts (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
                    (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                      (if (object/has (array/nth @pgs @pj) "path") [(object/get (array/nth @pgs @pj) "path")] [])))))))))
                )
            (let ((keys (array/map @rts (fn rt (str/join (array/map (str/split @rt "/") (fn seg (if (str/startsWith @seg ":") ":" @seg))) "/")))))
              (array/flatten (array/map (array/range 0 (array/len @keys)) (fn ki
                (let ((key (array/nth @keys @ki)))
                  (let ((at (array/filter (array/range 0 (array/len @keys)) (fn j (= (array/nth @keys @j) @key)))))
                    (if (or (< (array/len @at) 2) (!= (array/first @at) @ki))
                      []
                      [(str/concat "[ORB_P_DUPLICATE_PATH] " (array/nth @locs @ki) ": Duplicate page path (normalized to '" @key "'): [" (str/join (array/map @at (fn j (json/stringify (array/nth @rts @j)))) ", ") "] found at: [" (str/join (array/map @at (fn j (json/stringify (array/nth @locs @j)))) ", ") "]\n  suggestion: Each page must have a unique path — two routes that only differ by a param NAME still collide at dispatch")]))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "page-path-uniqueness" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintPagePathUniquenessCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintPagePathUniquenessCli -> OrbLintPagePathUniquenessRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-path-uniqueness <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-path-uniqueness") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-path-uniqueness: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-path-uniqueness") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "page-path-uniqueness")
        (emit LINT_ANSWERED { status: 500, body: "lint page-path-uniqueness: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-path-uniqueness" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint page-path-uniqueness` with its arguments and working directory."
        @synonyms "orb lint page-path-uniqueness"
      OrbLintPagePathUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintPagePathUniqueness.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-page-path-uniqueness" as OrbLintPagePathUniquenessPage -> OrbLintPagePathUniqueness, OrbLintPagePathUniquenessCli
}
