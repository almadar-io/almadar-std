app std-orb-lint-page-path-uniqueness [
  version: "1.0.0",
  inbound: ["cli-lint-page-path-uniqueness"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-page-path-uniqueness — the `orb lint page-path-uniqueness <file>` command, the port of validate_page_path_uniqueness. It lowers the file with program/read, collapses each page path to its param shape (every :name segment becomes a bare :) and reports ORB_P_DUPLICATE_PATH once per shape shared by two or more pages across all orbitals, at the first page, with the paths and locations (status 500, exit 1). Clean answers `lint page-path-uniqueness: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-page-path-uniqueness"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type PagePathPage = { path : string }
type PagePathOrbital = { pages : [PagePathPage] }
type PagePathProgram = { orbitals : [PagePathOrbital] }

orbital OrbLintPagePathUniquenessOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintPagePathUniquenessRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintPagePathUniqueness -> OrbLintPagePathUniquenessRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((locs (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
                    (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                      (if (object/has (array/nth @pgs @pj) "path") [(str/concat "orbitals[" @oi "].pages[" @pj "]")] [])))))))))
                (rts (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
                    (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                      (if (object/has (array/nth @pgs @pj) "path") [(object/get (array/nth @pgs @pj) "path")] [])))))))))
                )
            (let ((keys (array/map @rts (fn rt (str/join (array/map (str/split @rt "/") (fn seg (if (str/startsWith @seg ":") ":" @seg))) "/")))))
              (array/flatten (array/map (array/range 0 (array/len @keys)) (fn ki
                (let ((key (array/nth @keys @ki)))
                  (let ((at (array/filter (array/range 0 (array/len @keys)) (fn j (= (array/nth @keys @j) @key)))))
                    (if (or (< (array/len @at) 2) (!= (array/first @at) @ki))
                      []
                      [{ code: "ORB_P_DUPLICATE_PATH", path: (array/nth @locs @ki), message: (str/concat "Duplicate page path (normalized to '" @key "'): [" (str/join (array/map @at (fn j (json/stringify (array/nth @rts @j)))) ", ") "] found at: [" (str/join (array/map @at (fn j (json/stringify (array/nth @locs @j)))) ", ") "]"), suggestion: "Each page must have a unique path — two routes that only differ by a param NAME still collide at dispatch", severity: "error" }]))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-path-uniqueness", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PagePathProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintPagePathUniquenessCli -> OrbLintPagePathUniquenessRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-path-uniqueness <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-path-uniqueness") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-path-uniqueness: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-path-uniqueness") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint page-path-uniqueness: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-path-uniqueness" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint page-path-uniqueness` with its arguments and working directory."
        @synonyms "orb lint page-path-uniqueness"
      OrbLintPagePathUniqueness.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPagePathUniquenessCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPagePathUniquenessOrbitalStart -> OrbLintPagePathUniqueness, OrbLintPagePathUniquenessCli, OrbLintInput, Packs, Versions
}
