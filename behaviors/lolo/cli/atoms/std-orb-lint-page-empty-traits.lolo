app std-orb-lint-page-empty-traits [
  version: "1.0.0",
  inbound: ["cli-lint-page-empty-traits"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-page-empty-traits — the `orb lint page-empty-traits <file>` command, the port. It lowers the file with program/read and, for every page of a non-spec orbital, reports ORB_P_EMPTY_TRAITS (a traits list with no entries), ORB_P_MISSING_TRAITS (no traits list and no primaryEntity) and ORB_P_INVALID_VIEW_TYPE (a viewType outside list, detail, create, edit, dashboard, custom), each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint page-empty-traits: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-page-empty-traits"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type PageTraitsMachine = { initial : string }
type PageTraitsInline = { id : string, name : string, ref : string, refId : string, stateMachine : PageTraitsMachine }
type PageTraitsPage = { traits : [PageTraitsInline], primaryEntity : string, viewType : string }
type PageTraitsOrbital = { spec : boolean, pages : [PageTraitsPage], traits : [PageTraitsInline] }
type PageTraitsProgram = { orbitals : [PageTraitsOrbital]! }

orbital OrbLintPageEmptyTraitsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintPageEmptyTraitsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintPageEmptyTraits -> OrbLintPageEmptyTraitsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
         (let ((inl (array/filter (array/flatten (array/map @orbitals (fn o (object/get @o "traits" [])))) (fn t (object/has @t "stateMachine")))))
         (let ((tnames (array/map @inl (fn t (object/get @t "name" "")))) (tids (array/filter (array/map @inl (fn t (object/get @t "id" ""))) (fn i (!= @i "")))))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((pgList (if (object/get (array/nth @orbitals @oi) "spec" false) [] (object/get (array/nth @orbitals @oi) "pages" []))))
              (array/flatten (array/map (array/range 0 (array/len @pgList)) (fn pj
                (let ((pg (array/nth @pgList @pj)))
                  (array/flatten [
                    (if (and (object/has @pg "traits") (= (array/len (object/get @pg "traits" [])) 0))
                      [{ code: "ORB_P_EMPTY_TRAITS", path: (str/concat "orbitals[" @oi "].pages[" @pj "].traits"), message: "Page traits array cannot be empty", suggestion: "Add at least one trait to render UI on the page", severity: "error" }]
                      [])
                    (if (and (not (object/has @pg "traits")) (not (object/has @pg "primaryEntity")))
                      [{ code: "ORB_P_MISSING_TRAITS", path: (str/concat "orbitals[" @oi "].pages[" @pj "].traits"), message: "Page should have traits array for trait-driven UI", suggestion: "Add traits: ['TraitName'] to define page behavior", severity: "error" }]
                      [])
                    (if (and (object/has @pg "viewType") (not (array/some ["list" "detail" "create" "edit" "dashboard" "custom"] (fn vt (= @vt (object/get @pg "viewType"))))))
                      [{ code: "ORB_P_INVALID_VIEW_TYPE", path: (str/concat "orbitals[" @oi "].pages[" @pj "].viewType"), message: (str/concat "Invalid view type: '" (object/get @pg "viewType") "'"), suggestion: "", severity: "error" }]
                      [])
                    (array/flatten (array/map (array/range 0 (array/len (object/get @pg "traits" []))) (fn ti
                      (let ((tr (array/nth (object/get @pg "traits" []) @ti)))
                        (let ((tp (str/concat "orbitals[" @oi "].pages[" @pj "].traits[" @ti " (" (if (object/has @tr "stateMachine") (object/get @tr "name" "") (if (object/has @tr "ref") (object/get @tr "ref") (if (object/has @tr "name") (object/get @tr "name") "<anonymous>"))) ")]")))
                          (if (object/has @tr "stateMachine")
                            (if (= (object/get @tr "name" "") "")
                              [{ code: "ORB_P_INVALID_TRAIT_REF", path: @tp, message: "Inline trait must have a name", suggestion: "Add a name property to the inline trait", severity: "error" }]
                              [])
                            (if (and (object/has @tr "refId") (array/includes @tids (object/get @tr "refId")))
                              []
                              (if (or (object/has @tr "ref") (object/has @tr "name"))
                                (let ((nm (if (object/has @tr "ref") (object/get @tr "ref") (object/get @tr "name"))))
                                  (if (or (array/includes @tnames @nm) (str/startsWith @nm "std/"))
                                    []
                                    [{ code: "ORB_P_INVALID_TRAIT_REF", path: @tp, message: (str/concat "Trait '" @nm "' referenced on page does not exist"), suggestion: "Define traits inline within orbitals or use a std trait", severity: "error" }]))
                                [{ code: "ORB_P_INVALID_TRAIT_REF", path: @tp, message: "Page trait reference must have 'ref' or 'name' property", suggestion: "Add ref: 'TraitName' to reference a trait", severity: "error" }]))))))))])))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-empty-traits", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PageTraitsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintPageEmptyTraitsCli -> OrbLintPageEmptyTraitsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-empty-traits <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-empty-traits") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-empty-traits: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-empty-traits") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint page-empty-traits: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-empty-traits" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint page-empty-traits` with its arguments and working directory."
        @synonyms "orb lint page-empty-traits, duplicate field names"
      OrbLintPageEmptyTraits.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPageEmptyTraitsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPageEmptyTraitsOrbitalStart -> OrbLintPageEmptyTraits, OrbLintPageEmptyTraitsCli, OrbLintInput, Packs, Versions
}
