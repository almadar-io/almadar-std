array/concat (array/flatten (array/map (object/keys @cfg) (fn fname (let ((cf (object/get @cfg @fname {  }))) (if (and (= (object/get @cf "type" "") "trait") (object/has @cf "default")) (let ((dv (object/get @cf "default" null))) (if (= @dv null) [] (if (validate/object @dv) (if (let ((bh (object/get @dv "behavior" null)) (tn (object/get @dv "trait" null))) (and (validate/string @bh) (validate/string @tn) (or (validate/pattern @bh "^\\./([A-Za-z0-9_-]+/)+[A-Za-z0-9][A-Za-z0-9_-]*$") (validate/pattern @bh "^[a-z0-9][a-z0-9-]*(/behaviors)?/[a-z0-9][a-z0-9-]*$")) (validate/pattern @tn "^[A-Z][A-Za-z0-9]*$"))) [] [{ code: "ORB_BINDING_TRAIT_INVALID_FORMAT", path: (str/concat @tp ".config." @fname ".default"), message: (str/concat "trait-typed config field '" @fname "' default must be a string `@trait.<TraitName>` reference, a trait value, or `none`"), suggestion: "", severity: "error" }]) (if (validate/string @dv) (if (validate/pattern @dv "^@trait\\.[A-Z][A-Za-z0-9]*$") [] [{ code: "ORB_BINDING_TRAIT_INVALID_FORMAT", path: (str/concat @tp ".config." @fname ".default"), message: (str/concat "trait-typed config field '" @fname "' has invalid default '" @dv "' — must be `@trait.<TraitName>` or `none`"), suggestion: "Set the default to a `@trait.PascalCaseName` reference, to `none` (unbound), or remove the default and require the consumer to override.", severity: "error" }]) [{ code: "ORB_BINDING_TRAIT_INVALID_FORMAT", path: (str/concat @tp ".config." @fname ".default"), message: (str/concat "trait-typed config field '" @fname "' default must be a string `@trait.<TraitName>` reference, a trait value, or `none`"), suggestion: "", severity: "error" }])))) []))))) (array/flatten (array/map (array/concat (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i (let ((efl (object/get (array/nth @trans @i) "effects" []))) (array/map (array/range 0 (array/len @efl)) (fn j { p: (str/concat @tp ".stateMachine.transitions[" @i "].effects[" @j "]"), e: (array/nth @efl @j) })))))) (array/flatten (array/map (array/range 0 (array/len @tks)) (fn i (let ((efl (object/get (array/nth @tks @i) "effects" []))) (array/map (array/range 0 (array/len @efl)) (fn j { p: (str/concat @tp ".ticks[" @i "].effects[" @j "]"), e: (array/nth @efl @j) }))))))) (fn ef (let ((ep (object/get @ef "p" "")) (ee (object/get @ef "e" null))) (array/concat (if (= (array/len @Ucfg) 0) [] (let ((pre (quote "@config.")) (U @Ucfg)) (array/map (array/filter (or (json/parse (json/stringify (or (tree/fold @ee (fn (n k) (if (validate/string @n) (if (and (str/startsWith @n @pre) (array/includes @U (str/slice @n (str/len @pre) (str/len @n)))) [(str/concat "c:" (str/slice @n (str/len @pre) (str/len @n)))] []) (if (validate/array @n) (array/concat (if (and (>= (array/len @n) 3) (or (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "if") false)) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "when") false)))) (let ((wk (let ((pv (let ((cv (array/nth @n 1))) (if (validate/string @cv) @cv (if (and (validate/array @cv) (= (array/len @cv) 2) (let ((sq (array/nth @cv 0))) (if (validate/string @sq) (= @sq "validate/required") false))) (let ((c1 (array/nth @cv 1))) (if (validate/string @c1) @c1 "")) ""))))) (if (and (str/startsWith @pv @pre) (array/includes @U (str/slice @pv (str/len @pre) (str/len @pv)))) (str/slice @pv (str/len @pre) (str/len @pv)) "")))) (if (!= @wk "") (array/concat (array/filter (array/filter (array/flatten (array/filter [(array/nth @k 2)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))) (fn z (!= @z (str/concat "w:" @wk)))) (if (> (array/len @n) 3) (array/filter (array/flatten (array/filter [(array/nth @k 3)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))) [])) (if (and (> (array/len @n) 0) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "render-ui") false))) (array/map (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (str/concat "w:" (str/slice @z 2 (str/len @z))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:")))))) (if (and (> (array/len @n) 0) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "render-ui") false))) (array/map (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (str/concat "w:" (str/slice @z 2 (str/len @z))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))))) (if (and (>= (array/len @n) 3) (or (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "if") false)) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "when") false)))) (let ((gd (let ((cv (array/nth @n 1))) (if (and (validate/string @cv) (str/startsWith @cv @pre) (array/includes @U (str/slice @cv (str/len @pre) (str/len @cv)))) (str/concat "c:" (str/slice @cv (str/len @pre) (str/len @cv))) "")))) (array/concat (array/filter (array/filter (array/flatten (array/filter [(array/nth @k 2)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (!= @z @gd))) (array/filter (array/flatten (array/filter (array/slice @k 3 (array/len @k)) (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))))) (if (validate/object @n) (array/filter (array/flatten (array/filter (object/values @k) (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) [])))) "TeVal") [])) TeStrs) []) (fn z (str/startsWith @z "w:"))) (fn z (let ((kb (str/slice @z 2 (str/len @z)))) { code: "ORB_RENDER_UNBOUND_TRAIT_KNOB_EMBEDDED", path: @ep, message: (str/concat "render-ui embeds '" @pre @kb "', a trait- or behavior-typed value that may be `none` (unbound) — an unguarded embed renders nothing"), suggestion: (str/concat "Wrap this render-ui in `(if " @pre @kb " (render-ui ...))` so the unbound case renders nothing instead of a dangling embed"), severity: "error" }))))) (if (= (array/len @F1) 0) [] (let ((pre (quote "@entity.")) (U @F1)) (array/map (array/filter (or (json/parse (json/stringify (or (tree/fold @ee (fn (n k) (if (validate/string @n) (if (and (str/startsWith @n @pre) (array/includes @U (str/slice @n (str/len @pre) (str/len @n)))) [(str/concat "c:" (str/slice @n (str/len @pre) (str/len @n)))] []) (if (validate/array @n) (array/concat (if (and (>= (array/len @n) 3) (or (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "if") false)) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "when") false)))) (let ((wk (let ((pv (let ((cv (array/nth @n 1))) (if (validate/string @cv) @cv (if (and (validate/array @cv) (= (array/len @cv) 2) (let ((sq (array/nth @cv 0))) (if (validate/string @sq) (= @sq "validate/required") false))) (let ((c1 (array/nth @cv 1))) (if (validate/string @c1) @c1 "")) ""))))) (if (and (str/startsWith @pv @pre) (array/includes @U (str/slice @pv (str/len @pre) (str/len @pv)))) (str/slice @pv (str/len @pre) (str/len @pv)) "")))) (if (!= @wk "") (array/concat (array/filter (array/filter (array/flatten (array/filter [(array/nth @k 2)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))) (fn z (!= @z (str/concat "w:" @wk)))) (if (> (array/len @n) 3) (array/filter (array/flatten (array/filter [(array/nth @k 3)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))) [])) (if (and (> (array/len @n) 0) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "render-ui") false))) (array/map (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (str/concat "w:" (str/slice @z 2 (str/len @z))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:")))))) (if (and (> (array/len @n) 0) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "render-ui") false))) (array/map (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (str/concat "w:" (str/slice @z 2 (str/len @z))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "w:"))))) (if (and (>= (array/len @n) 3) (or (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "if") false)) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "when") false)))) (let ((gd (let ((cv (array/nth @n 1))) (if (and (validate/string @cv) (str/startsWith @cv @pre) (array/includes @U (str/slice @cv (str/len @pre) (str/len @cv)))) (str/concat "c:" (str/slice @cv (str/len @pre) (str/len @cv))) "")))) (array/concat (array/filter (array/filter (array/flatten (array/filter [(array/nth @k 2)] (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) (fn z (!= @z @gd))) (array/filter (array/flatten (array/filter (array/slice @k 3 (array/len @k)) (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))))) (if (validate/object @n) (array/filter (array/flatten (array/filter (object/values @k) (fn zz (!= @zz null)))) (fn z (str/startsWith @z "c:"))) [])))) "TeVal") [])) TeStrs) []) (fn z (str/startsWith @z "w:"))) (fn z (let ((kb (str/slice @z 2 (str/len @z)))) { code: "ORB_RENDER_UNBOUND_TRAIT_KNOB_EMBEDDED", path: @ep, message: (str/concat "render-ui embeds '" @pre @kb "', a trait- or behavior-typed value that may be `none` (unbound) — an unguarded embed renders nothing"), suggestion: (str/concat "Wrap this render-ui in `(if " @pre @kb " (render-ui ...))` so the unbound case renders nothing instead of a dangling embed"), severity: "error" }))))) (if (= (array/len @F2) 0) [] (let ((F @F2)) (array/map (array/filter (or (json/parse (json/stringify (or (tree/fold @ee (fn (n k) (if (validate/string @n) (if (and (str/startsWith @n (quote "@entity.")) (array/includes @F (str/slice @n (str/len (quote "@entity.")) (str/len @n)))) [(str/concat "s:" (str/slice @n (str/len (quote "@entity.")) (str/len @n)))] []) (if (validate/array @n) (array/concat (if (and (> (array/len @n) 0) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "render-ui") false))) (array/map (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "s:"))) (fn z (str/concat "o:" (str/slice @z 2 (str/len @z))))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "o:")))) (array/filter (array/flatten (array/filter @k (fn zz (!= @zz null)))) (fn z (str/startsWith @z "s:")))) (if (validate/object @n) (array/filter (array/flatten (array/filter (object/values @k) (fn zz (!= @zz null)))) (fn z (str/startsWith @z "s:"))) [])))) "TeVal") [])) TeStrs) []) (fn z (str/startsWith @z "o:"))) (fn z (let ((kb (str/slice @z 2 (str/len @z)))) { code: "ORB_RENDER_ORBITAL_VALUE_EMBEDDED", path: @ep, message: (str/concat "render-ui embeds '@entity." @kb "', an orbital value — only trait values render"), suggestion: "Bind a trait value to render, or evaluate the orbital value into a program with `program/eval`", severity: "error" }))))))))))))) []))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "trait-embeds", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : TeProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintTraitEmbedsCli -> OrbLintTraitEmbedsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint trait-embeds <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "trait-embeds") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint trait-embeds: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "trait-embeds") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint trait-embeds: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-trait-embeds" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint trait-embeds` with its arguments and working directory."
        @synonyms "orb lint trait-embeds"
      OrbLintTraitEmbeds.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintTraitEmbedsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintTraitEmbedsOrbitalStart -> OrbLintTraitEmbeds, OrbLintTraitEmbedsCli, OrbLintInput, Packs, Versions
}
