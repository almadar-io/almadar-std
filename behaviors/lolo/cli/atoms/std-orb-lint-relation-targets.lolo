app std-orb-lint-relation-targets [
  version: "1.0.0",
  inbound: ["cli-lint-relation-targets"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-relation-targets - the `orb lint relation-targets <file>` command, the port of ORB_X_UNRESOLVED_RELATION_TARGET. It lowers the file with program/read and reports every field of type relation, at any depth, of each orbital's primary entity (both codes) and auxiliary entities (the cross-orbital code only, as in Rust), whose target entity is not a declared entity of the program (any orbital's primary or auxiliary entity, or an expects entity or identity), with its path and suggestion (status 500, exit 1). A relation nested in array items or object properties with no `relation` config is reported as ORB_E_INVALID_RELATION at its `.relation` path (the top-level one is entity-field-type's). Relations nested in array items or object properties are walked at any depth with tree/fold, in the Rust order (the field, its items, its properties by name). Clean answers `lint relation-targets: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-relation-targets"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape] | Map string FieldShape
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintRelationTargetsOrbital {
  entity OrbLintRelationTargetsRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintRelationTargets -> OrbLintRelationTargetsRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "relation-targets", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (let ((declared (array/flatten (array/map @orbitals (fn o
                  (array/concat
                    (array/concat [(if (validate/object (object/get @o "entity" {})) (object/get (object/get @o "entity" {}) "name" "") "")]
                      (array/map (object/get @o "auxiliaryEntities" []) (fn x (if (validate/object @x) (object/get @x "name" "") ""))))
                    (array/map (array/filter (object/get @o "expects" []) (fn x (or (= (object/get @x "kind" "") "entity") (= (object/get @x "kind" "") "identity")))) (fn x (object/get @x "name" "")))))))))
            (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
              (let ((prim (object/get (array/nth @orbitals @oi) "entity" {}))
                    (auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
                (array/flatten (array/map
                  (array/concat
                    (if (validate/object @prim) [{ ent: @prim, base: (str/concat "orbitals[" @oi "].entity"), e: true }] [])
                    (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]"), e: false })))
                  (fn eb
                    (let ((fields (object/get (object/get @eb "ent") "fields" [])) (ename (object/get (object/get @eb "ent") "name" "")))
                      (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                        (let ((f (array/nth @fields @fi)))
                          (array/flatten (array/map (tree/fold @f  (fn (n k)
                        (if (validate/array @n)
                          (array/flatten (array/filter @k (fn r (validate/array @r))))
                          (if (validate/object @n)
                            (if (not (validate/string (object/get @n "type" 0)))
                              @k
                            (array/concat
                              (if (and (= (object/get @n "type" "") "relation") (object/has @n "relation") (not (array/includes @declared (object/get (object/get @n "relation" {}) "entity" ""))))
                                [{ rel: "", nm: (object/get @n "name" "<anonymous>"), tg: (object/get (object/get @n "relation" {}) "entity" ""), miss: false }]
                                [])
                              (if (and (= (object/get @n "type" "") "relation") (not (object/has @n "relation")))
                                [{ rel: "", nm: (object/get @n "name" "<anonymous>"), tg: "", miss: true }]
                                [])
                              (array/map (object/get @k "items" []) (fn h { rel: (str/concat ".items" (object/get @h "rel")), nm: (object/get @h "nm"), tg: (object/get @h "tg"), miss: (object/get @h "miss") }))
                              (array/flatten (array/map (array/sort (object/keys (object/get @k "properties" {})) "" "asc") (fn key (array/map (object/get (object/get @k "properties" {}) @key) (fn h { rel: (str/concat ".properties." @key (object/get @h "rel")), nm: (object/get @h "nm"), tg: (object/get @h "tg"), miss: (object/get @h "miss") })))))))
                            []))) FieldShape) (fn h
                            (if (object/get @h "miss")
                              (if (and (object/get @eb "e") (!= (object/get @h "rel") "")) [{ code: "ORB_E_INVALID_RELATION", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation"), message: "Relation field requires a 'relation' configuration", suggestion: "Add relation: { entity: 'EntityName', cardinality: 'one' }", severity: "error" }] [])
                              (array/concat
                              (if (object/get @eb "e") [{ code: "ORB_E_INVALID_RELATION", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation.entity"), message: (str/concat "Relation target entity '" (object/get @h "tg") "' does not exist"), suggestion: "Ensure the related entity is defined in the schema", severity: "error" }] [])
                              [{ code: "ORB_X_UNRESOLVED_RELATION_TARGET", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation.entity"), message: (str/concat "Relation field '" (object/get @h "nm") "' on '" @ename "' points at '" (object/get @h "tg") "', which is not declared in this schema"), suggestion: "Declare the target entity in one of the schema's orbitals, or correct the relation.entity name.", severity: "error" }]))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "relation-targets" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintRelationTargetsCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintRelationTargetsCli -> OrbLintRelationTargetsRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint relation-targets <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "relation-targets") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint relation-targets: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "relation-targets") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "relation-targets")
        (emit LINT_ANSWERED { status: 500, body: "lint relation-targets: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-relation-targets" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint relation-targets` with its arguments and working directory."
        @synonyms "orb lint relation-targets, duplicate field names"
      OrbLintRelationTargets.LINT_FOUND -> LINT_FOUND
      OrbLintRelationTargets.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-relation-targets" as OrbLintRelationTargetsPage -> OrbLintRelationTargets, OrbLintRelationTargetsCli
}
