app std-orb-lint-relation-targets [
  version: "1.0.0",
  inbound: ["cli-lint-relation-targets"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-relation-targets - the `orb lint relation-targets <file>` command, the port of ORB_X_UNRESOLVED_RELATION_TARGET. It lowers the file with program/read and reports every field of type relation, at any depth, of each orbital's primary entity (both codes) and auxiliary entities (both codes, as validate_all_entities gives every auxiliary entity the same per-entity validation), whose target entity is not a declared entity of the program (any orbital's primary or auxiliary entity, or an expects entity or identity), with its path and suggestion (status 500, exit 1). A relation nested in array items or object properties with no `relation` config is reported as ORB_E_INVALID_RELATION at its `.relation` path (the top-level one is entity-field-type's). Relations nested in array items or object properties are walked at any depth with tree/fold, in the Rust order (the field, its items, its properties by name). Clean answers `lint relation-targets: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-relation-targets"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape?] | Map string FieldShape?
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }

type RelTargetsExpect = { kind : string, name : string }
type RelTargetsEntity = { name : string, fields : [FieldShape] }
type RelTargetsOrbital = { entity : RelTargetsEntity, auxiliaryEntities : [RelTargetsEntity], expects : [RelTargetsExpect], spec : boolean }
type RelTargetsProgram = { orbitals : [RelTargetsOrbital]! }

orbital OrbLintRelationTargetsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintRelationTargetsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintRelationTargets -> OrbLintRelationTargetsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((declared (array/flatten (array/map @orbitals (fn o
                  (array/concat
                    (array/concat [(if (validate/object (object/get @o "entity" {})) (object/get (object/get @o "entity" {}) "name" "") "")]
                      (array/map (object/get @o "auxiliaryEntities" []) (fn x (if (validate/object @x) (object/get @x "name" "") ""))))
                    (array/map (array/filter (object/get @o "expects" []) (fn x (or (= (object/get @x "kind" "") "entity") (= (object/get @x "kind" "") "identity")))) (fn x (object/get @x "name" "")))))))))
            (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
              (let ((prim (object/get (array/nth @orbitals @oi) "entity" {}))
                    (auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
                (array/flatten (array/map
                  (array/concat
                    (if (validate/object @prim) [{ ent: @prim, base: (str/concat "orbitals[" @oi "].entity"), e: (not (object/get (array/nth @orbitals @oi) "spec" false)) }] [])
                    (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]"), e: (not (object/get (array/nth @orbitals @oi) "spec" false)) })))
                  (fn eb
                    (let ((fields (object/get (object/get @eb "ent") "fields" [])) (ename (object/get (object/get @eb "ent") "name" "")))
                      (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                        (let ((f (array/nth @fields @fi)))
                          (let ((fres (tree/fold @f  (fn (n k)
                        (if (validate/array @n)
                          (array/flatten (array/filter @k (fn r (validate/array @r))))
                          (if (validate/object @n)
                            (if (not (validate/string (object/get @n "type" 0)))
                              (array/flatten (array/map (array/sort (object/keys @k)) (fn key (array/map (or (object/get @k @key) []) (fn h { rel: (str/concat ".properties." @key (object/get @h "rel")), nm: (object/get @h "nm"), tg: (object/get @h "tg"), miss: (object/get @h "miss") })))))
                            (let ((ty0 (object/get @n "type" "")) (nm0 (object/get @n "name" "<anonymous>")) (rl0 (object/get @n "relation" {})))
                             (let ((ty (if (validate/string @ty0) @ty0 "")) (nm (if (validate/string @nm0) @nm0 "<anonymous>")) (tg (if (validate/object @rl0) (let ((t0 (object/get @rl0 "entity" ""))) (if (validate/string @t0) @t0 "")) "")))
                            (array/concat
                              (if (and (= @ty "relation") (object/has @n "relation") (not (array/includes @declared @tg)))
                                [{ rel: "", nm: @nm, tg: @tg, miss: false }]
                                [])
                              (if (and (= @ty "relation") (not (object/has @n "relation")))
                                [{ rel: "", nm: @nm, tg: "", miss: true }]
                                [])
                              (array/map (object/get @k "items" []) (fn h { rel: (str/concat ".items" (object/get @h "rel")), nm: (object/get @h "nm"), tg: (object/get @h "tg"), miss: (object/get @h "miss") }))
                              (object/get @k "properties" [])))))
                            []))) FieldShape))) (if (= @fres null) (let ((up (str/concat (object/get @eb "base") ".fields[" @fi "]"))) [{ code: "LINT_NODE_UNCHECKED", path: @up, message: (str/concat @payload.file ": schema node at " @up " is not a FieldShape; this rule could not check it"), suggestion: "", severity: "error" }]) (array/flatten (array/map @fres (fn h
                            (if (object/get @h "miss")
                              (if (and (object/get @eb "e") (!= (object/get @h "rel") "")) [{ code: "ORB_E_INVALID_RELATION", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation"), message: "Relation field requires a 'relation' configuration", suggestion: "Add relation: { entity: 'EntityName', cardinality: 'one' }", severity: "error" }] [])
                              (array/concat
                              (if (object/get @eb "e") [{ code: "ORB_E_INVALID_RELATION", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation.entity"), message: (str/concat "Relation target entity '" (object/get @h "tg") "' does not exist"), suggestion: "Ensure the related entity is defined in the schema", validValues: (array/sort (array/unique (array/filter @declared (fn n (!= @n ""))))), severity: "error" }] [])
                              [{ code: "ORB_X_UNRESOLVED_RELATION_TARGET", path: (str/concat (object/get @eb "base") ".fields[" @fi "]" (object/get @h "rel") ".relation.entity"), message: (str/concat "Relation field '" (object/get @h "nm") "' on '" @ename "' points at '" (object/get @h "tg") "', which is not declared in this schema"), suggestion: "Declare the target entity in one of the schema's orbitals, or correct the relation.entity name.", validValues: (array/sort (array/unique (array/filter @declared (fn n (!= @n ""))))), severity: "error" }]))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "relation-targets", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : RelTargetsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintRelationTargetsCli -> OrbLintRelationTargetsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint relation-targets <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "relation-targets") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint relation-targets: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "relation-targets") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint relation-targets: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-relation-targets" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint relation-targets` with its arguments and working directory."
        @synonyms "orb lint relation-targets, duplicate field names"
      OrbLintRelationTargets.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintRelationTargetsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintRelationTargetsOrbitalStart -> OrbLintRelationTargets, OrbLintRelationTargetsCli, OrbLintInput, Packs, Versions
}
