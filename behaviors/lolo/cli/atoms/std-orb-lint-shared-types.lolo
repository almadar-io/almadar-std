app std-orb-lint-shared-types [
  version: "1.0.0",
  inbound: ["cli-lint-shared-types"],
  fs: { "./packages/almadar-std/behaviors/lolo/**": [read], "./packages/almadar-behaviors/behaviors/lolo/**": [read] },
  description: "std-orb-lint-shared-types — the `orb lint shared-types` command, the guard behind the 'shared types are copies' ruling. It walks every .lolo under the std and io behavior trees (the roots knob, relative to the directory `orb` runs in), lowers each file that declares a type with program/read, collects every type alias by name with its lowered definition, and reports every name whose definitions differ across files: the files of each variant and the fields that differ from the most common one (status 500, exit 1). When every copy agrees the answer is `shared-types: consistent` (status 200, exit 0). A file that could not be read or lowered is listed as UNREAD and fails the run. Any argument is the usage (status 400, exit 2)."
]
uses Spec from "almadar-std/orb-lint-shared-types"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type LintTypeCopy = { name : string!, file : string!, definition : string!, fields : [string]! }
type LintTypeDrift = { name : string!, variants : number!, files : [string]! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LintEntry = { name : string!, kind : string! }
type LintFile = { root : number!, rel : string! }
type SharedTypesMember = { name : string }
type SharedTypesOrbital = { types : Map string [SharedTypesMember]! }
type SharedTypesProgram = { orbitals : [SharedTypesOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintSharedTypesCodes = { sharedTypeDrift : LintCodeDecl , unread : LintCodeDecl }

orbital OrbLintSharedTypesOrbital {
  entity OrbLintSharedTypesRun [runtime] {
    id : string!
    paths : [LintFile] = []
    queue : [LintFile] = []
    cursor : number = 0
    copies : [LintTypeCopy] = []
    unread : [string] = []
    drift : [string] = []
  }

  trait OrbLintSharedTypes -> OrbLintSharedTypesRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint shared-types" })
      LINT_CALLED -> walking when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0))
        (set @entity.paths [])
        (set @entity.queue [{ root: 0, rel: "" }, { root: 1, rel: "" }])
        (set @entity.copies [])
        (set @entity.unread [])
        (set @entity.cursor 0)
        (emit LINT_WALK { })
      LINT_FINISH -> ready when (and (= (array/len @entity.drift) 0) (= (array/len @entity.unread) 0))
        (emit LINT_ANSWERED { status: 200, body: "shared-types: consistent" })
      LINT_FINISH -> ready when (or (> (array/len @entity.drift) 0) (> (array/len @entity.unread) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map (let ((msgs (array/map @entity.drift (fn n (let ((copies (array/filter @entity.copies (fn c (= (object/get @c "name") @n)))))
            (let ((variants (array/sort (array/map (array/unique (array/map @copies (fn c (object/get @c "definition")))) (fn d { definition: @d, files: (array/map (array/filter @copies (fn c (= (object/get @c "definition") @d))) (fn c (object/get @c "file"))), fields: (array/flatten (array/map (array/take (array/filter @copies (fn c (= (object/get @c "definition") @d))) 1) (fn c (object/get @c "fields")))), count: (array/len (array/filter @copies (fn c (= (object/get @c "definition") @d)))) })) "count" "desc")))
              { code: @config.codes.sharedTypeDrift.code, path: @n, message: (str/join (array/concat
                [(str/concat (array/len @variants) " definitions differ")]
                (array/map (array/range 0 (array/len @variants)) (fn i (str/concat "  variant " (+ @i 1) " (" (object/get (array/nth @variants @i) "count") " file(s)): " (str/join (object/get (array/nth @variants @i) "files") ", "))))
                (let ((vf0 (array/flatten (array/map (array/take @variants 1) (fn v0 (object/get @v0 "fields")))))) (array/flatten (array/map (array/range 1 (array/len @variants)) (fn i (array/concat
                  (array/map (array/filter @vf0 (fn f (not (array/includes (object/get (array/nth @variants @i) "fields") @f)))) (fn f (str/concat "  variant " (+ @i 1) " lacks " @f)))
                  (array/map (array/filter (object/get (array/nth @variants @i) "fields") (fn f (not (array/includes @vf0 @f)))) (fn f (str/concat "  variant " (+ @i 1) " adds  " @f)))))))))
              "\n"), suggestion: "keep the declared copies identical in every file", severity: "error" }))))))
          (array/concat
            @msgs
            (array/map @entity.unread (fn u { code: @config.codes.unread.code, path: @u, message: "the file could not be read or listed", suggestion: "", severity: "error" })))) (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
    }

    state walking {
      INIT -> walking
      LINT_WALK -> reading when (= (array/len @entity.queue) 0)
        (set @entity.cursor 0)
        (emit LINT_READ { })
      LINT_WALK -> walking when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "root") 0))
        (let ((q (array/first @entity.queue))) (if (= @q null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the walk queue is empty" }) (os/list-dir (str/concat "./packages/almadar-std/behaviors/lolo/" (object/get @q "rel")) { key: "dir" emit: { success: LINT_LISTED, failure: LINT_LIST_FAILED } })))
      LINT_WALK -> walking when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "root") 1))
        (let ((q (array/first @entity.queue))) (if (= @q null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the walk queue is empty" }) (os/list-dir (str/concat "./packages/almadar-behaviors/behaviors/lolo/" (object/get @q "rel")) { key: "dir" emit: { success: LINT_LISTED, failure: LINT_LIST_FAILED } })))
      LINT_LISTED -> walking
        (let ((q (array/first @entity.queue))) (if (= @q null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the walk queue is empty" }) (set @entity.paths (array/concat @entity.paths (array/map (array/filter @payload.entries (fn e (and (!= (object/get @e "kind") "dir") (str/endsWith (object/get @e "name") ".lolo")))) (fn e { root: (object/get @q "root"), rel: (str/concat (object/get @q "rel") (object/get @e "name")) }))))))
        (let ((q (array/first @entity.queue))) (if (= @q null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the walk queue is empty" }) (set @entity.queue (array/concat (array/drop @entity.queue 1) (array/map (array/filter @payload.entries (fn e (= (object/get @e "kind") "dir"))) (fn e { root: (object/get @q "root"), rel: (str/concat (object/get @q "rel") (object/get @e "name") "/") }))))))
        (emit LINT_WALK { })
      LINT_LIST_FAILED -> walking
        (let ((q (array/first @entity.queue))) (if (= @q null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the walk queue is empty" }) (set @entity.unread (array/append @entity.unread (str/concat (object/get @q "rel") " (not listed: " @payload.error ")")))))
        (set @entity.queue (array/drop @entity.queue 1))
        (emit LINT_WALK { })
    }

    state reading {
      INIT -> reading
      LINT_READ -> reading when (let ((pf (array/nth @entity.paths @entity.cursor))) (and (!= @pf null) (= (object/get @pf "root") 0)))
        (let ((pf (array/nth @entity.paths @entity.cursor))) (if (= @pf null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the file index is out of range" }) (os/open (str/concat "./packages/almadar-std/behaviors/lolo/" (object/get @pf "rel")) "r" { key: "open" emit: { success: LINT_OPENED, failure: LINT_FILE_UNREAD } })))
      LINT_READ -> reading when (let ((pf (array/nth @entity.paths @entity.cursor))) (and (!= @pf null) (= (object/get @pf "root") 1)))
        (let ((pf (array/nth @entity.paths @entity.cursor))) (if (= @pf null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the file index is out of range" }) (os/open (str/concat "./packages/almadar-behaviors/behaviors/lolo/" (object/get @pf "rel")) "r" { key: "open" emit: { success: LINT_OPENED, failure: LINT_FILE_UNREAD } })))
      LINT_READ -> ready when (>= @entity.cursor (array/len @entity.paths))
        (set @entity.drift (array/filter (array/unique (array/map @entity.copies (fn c (object/get @c "name")))) (fn n (> (array/len (array/unique (array/map (array/filter @entity.copies (fn c (= (object/get @c "name") @n))) (fn c (object/get @c "definition"))))) 1))))
        (emit LINT_FINISH { })
      LINT_OPENED -> reading
        (os/read @payload.fd 4194304 { key: "chunk" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FILE_READ -> reading when (= (bytes/to-string @payload.data) null)
        (emit LINT_FILE_UNREAD { error: "the file is not valid text" })
      LINT_FILE_READ -> reading when (and (!= (bytes/to-string @payload.data) null) (str/includes (str/concat "\n" (default (bytes/to-string @payload.data) "")) "\ntype "))
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_FILE_READ -> reading when (and (!= (bytes/to-string @payload.data) null) (not (str/includes (str/concat "\n" (default (bytes/to-string @payload.data) "")) "\ntype ")))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
      LINT_PROGRAM_READ -> reading
        (let ((pf (array/nth @entity.paths @entity.cursor))) (if (= @pf null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the file index is out of range" }) (set @entity.copies (array/concat @entity.copies (array/flatten (array/map (object/get @payload.result "orbitals" []) (fn o (let ((ty (object/get @o "types"))) (array/map (object/keys @ty) (fn n { name: @n, file: (object/get @pf "rel"), definition: (json/stringify (object/get @ty @n)), fields: (array/map (object/get @ty @n) (fn f (json/stringify @f))) }))))))))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
      LINT_FILE_UNREAD -> reading
        (let ((pf (array/nth @entity.paths @entity.cursor))) (if (= @pf null) (emit LINT_ANSWERED { status: 500, body: "shared-types: the file index is out of range" }) (set @entity.unread (array/append @entity.unread (object/get @pf "rel")))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_LISTED { entries : [LintEntry]! }
        @description "A directory listed."
        @tier "internal"
      LINT_LIST_FAILED { error : string! }
        @description "A directory that could not be listed."
        @tier "internal"
      LINT_OPENED { fd : number! }
        @description "A file opened."
        @tier "internal"
      LINT_FILE_READ { data : bytes!, eof : boolean }
        @description "A file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string! }
        @description "A file that could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : SharedTypesProgram! }
        @description "A file lowered by program/read."
        @tier "internal"
      LINT_WALK { }
        @description "Internal: list the next directory."
        @tier "internal"
      LINT_READ { }
        @description "Internal: read the next file."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-shared-types" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint shared-types` with its arguments and working directory."
        @synonyms "orb lint shared-types, shared type copies guard"
    }
    config {
      codes : LintSharedTypesCodes = { sharedTypeDrift: { code: "shared-type-drift", category: "lint", description: "A type shared between behaviors has drifted from its canonical declaration" }, unread: { code: "unread", category: "lint", description: "The file the rule reads could not be read or listed" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  page boot as OrbLintSharedTypesOrbitalStart -> OrbLintSharedTypes
}
