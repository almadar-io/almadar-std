app std-orb-lint-postgres [
  version: "1.0.0",
  inbound: ["cli-lint-postgres"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-postgres — the `orb lint postgres <file>` command, the port of effect/postgres.rs (validate_postgres_effects): every `(postgres <origin> <sql> <params> <options>? <options>?)` call in a transition or tick of an inline trait, found anywhere inside an effect or guard. The arity and the closed option keys come from the installed operator table (LINT_OPERATOR_SHAPES), never from this atom. Reports ORB_HOST_EFFECT_ARITY, ORB_HTTP_ORIGIN_NOT_STATIC (no egress declared and the origin is not a literal or a url-typed config knob with a literal default), ORB_POSTGRES_CALL_INVALID (origin that is not a postgres:// or postgresql:// origin without a path; a literal statement that std-sql-select-guard refuses; params that are not a list; an option given twice; tls, timeoutMs, user, database values; a missing user), ORB_HOST_EFFECT_OPTION_UNKNOWN, ORB_CALL_SERVICE_KEY_TYPE and ORB_CALL_SERVICE_CANCELLED_WITHOUT_KEY, and, through std-orb-emit-config, the emit-block findings. ORB_HTTP_EGRESS_UNDECLARED is reported only when no egress entry can match the origin: the default port of a scheme is not stated as data anywhere a rule can read, so a call and an entry that differ only by an implicit versus an explicit port are not compared. Findings carry the Rust path (the effect or guard), message and suggestion (status 500, exit 1). Clean answers `lint postgres: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-postgres"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type PgVal = string | number | boolean | [PgVal?] | Map string PgVal?
type PgCalls = [[PgVal?]]
type PgField = { type : string?, default : PgVal? }
type PgEmit = { event : string }
type PgTransition = { guard : PgVal?, effects : [PgVal?]? }
type PgTick = { guard : PgVal?, effects : [PgVal?]? }
type PgMachine = { transitions : [PgTransition]? }
type PgTrait = { name : string, stateMachine : PgMachine?, ticks : [PgTick]?, config : Map string PgField?, emits : [PgEmit]? }
type PgOrbital = { name : string, traits : [PgVal] }
type PgProgram = { orbitals : [PgOrbital], egress : [string]? }
type PgSite = { path : string!, call : [PgVal?]!, config : Map string PgField!, declared : [string]! }
type PgEmitObj = Map string PgVal?
type PgSites = [PgSite]
type PgSeg = { k : string!, id : string!, sql : string!, at : string!, em : PgEmitObj!, dc : [string]!, fs : [OrbFinding]! }
type PgShapeParam = { name : string, type : PgShapeType }
type PgShapeType = string | PgShapeNode
type PgShapeNode = { kind : string, fields : Map string PgShapeType? }
type PgShape = { minArity : number?, maxArity : number?, params : [PgShapeParam] }
type PgEmitConfigItem = { id : string!, path : string!, emit : PgEmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitConfigResult = { id : string!, findings : [OrbFinding]! }
type SqlGuardVerdict = { ok : boolean!, reason : string! }

orbital OrbLintPostgresOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses EmitConfigUse from "std/behaviors/std-orb-emit-config"
  uses GuardUse from "std/behaviors/std-sql-select-guard"

  entity OrbLintPostgresRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    sites : [PgSite] = []
    egress : [string] = []
    segs : [PgSeg] = []
    minArity : number = 0
    maxArity : number = 0
    bounded : boolean = false
    optionKeys : [string] = []
    emitKeys : [string] = []
    shapesUnread : boolean = false
    waiting : number = 0
    emitItems : [PgEmitConfigItem] = []
    emitRes : [EmitConfigResult] = []
    guardStmts : [string] = []
    guardRes : [SqlGuardVerdict] = []
  }

  trait OrbLintPostgres -> OrbLintPostgresRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SHAPES_HEARD -> ready
        (set @entity.shapesUnread (not (object/has @payload.operators "postgres")))
        (set @entity.minArity (object/get (object/get @payload.operators "postgres" {}) "minArity" 0))
        (set @entity.bounded (object/has (object/get @payload.operators "postgres" {}) "maxArity"))
        (set @entity.maxArity (object/get (object/get @payload.operators "postgres" {}) "maxArity" 0))
        (set @entity.optionKeys (let ((pr (array/find (object/get (object/get @payload.operators "postgres" {}) "params" []) (fn x (= (object/get @x "name") "options"))))) (if (= @pr null) [] (let ((ty (object/get @pr "type"))) (if (validate/object @ty) (object/keys (object/get @ty "fields" {})) [])))))
        (set @entity.emitKeys (let ((pr (array/find (object/get (object/get @payload.operators "postgres" {}) "params" []) (fn x (= (object/get @x "name") "options"))))) (if (= @pr null) [] (let ((ty (object/get @pr "type"))) (if (validate/object @ty) (let ((em (object/get (object/get @ty "fields" {}) "emit" null))) (if (validate/object @em) (object/keys (object/get @em "fields" {})) [])) [])))))
      SHAPES_UNREAD -> ready
        (set @entity.shapesUnread true)
      LINT_INPUT -> ready when @entity.shapesUnread
        (set @entity.scope @payload.scope)
        (set @entity.findings [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table does not declare `postgres`, so its arity and option keys are unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }])
        (emit LINT_FINISH { })
      LINT_INPUT -> ready when (not @entity.shapesUnread)
        (set @entity.scope @payload.scope)
        (set @entity.egress (or (object/get @payload.program "egress" null) []))
        (set @entity.sites (or (json/parse (json/stringify (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (json/parse (json/stringify (array/nth @trs @ti)) PgTrait)))
                    (if (or (= @t null) (= (object/get @t "stateMachine" null) null))
                      []
                      (let ((base (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]")) (cfg (or (object/get @t "config" null) {})) (decl (array/map (or (object/get @t "emits" null) []) (fn e (object/get @e "event")))))
                        (let ((trans (or (object/get (object/get @t "stateMachine") "transitions" null) [])) (ticks (or (object/get @t "ticks" null) [])))
                          (let ((places (array/concat
                                  (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i
                                    (let ((tr (array/nth @trans @i)))
                                      (array/concat
                                        (if (!= (object/get @tr "guard" null) null) [{ path: (str/concat @base ".stateMachine.transitions[" @i "].guard"), node: (object/get @tr "guard") }] [])
                                        (let ((effs (or (object/get @tr "effects" null) [])))
                                          (array/map (array/range 0 (array/len @effs)) (fn j { path: (str/concat @base ".stateMachine.transitions[" @i "].effects[" @j "]"), node: (array/nth @effs @j) }))))))))
                                  (array/flatten (array/map (array/range 0 (array/len @ticks)) (fn i
                                    (let ((tk (array/nth @ticks @i)))
                                      (array/concat
                                        (if (!= (object/get @tk "guard" null) null) [{ path: (str/concat @base ".ticks[" @i "].guard"), node: (object/get @tk "guard") }] [])
                                        (let ((effs (or (object/get @tk "effects" null) [])))
                                          (array/map (array/range 0 (array/len @effs)) (fn j { path: (str/concat @base ".ticks[" @i "].effects[" @j "]"), node: (array/nth @effs @j) })))))))))))
                            (array/flatten (array/map @places (fn pl
                              (array/map (or (json/parse (json/stringify (or (tree/fold (object/get @pl "node") (fn (nd kids)
                                  (array/concat
                                    (if (and (validate/array @nd) (> (array/len @nd) 0) (validate/string (array/first @nd)) (= (array/first @nd) "postgres")) [@nd] [])
                                    (if (validate/array @nd) (array/flatten (array/filter @kids (fn c (!= @c null)))) (if (validate/object @nd) (array/flatten (array/map (object/keys @kids) (fn key (or (object/get @kids @key []) [])))) [])))) PgVal) [])) PgCalls) [])
                                (fn call { path: (object/get @pl "path"), call: @call, config: @cfg, declared: @decl })))))))))))))))))))) PgSites) []))
        (emit LINT_PLAN { })
      LINT_PLAN -> ready
        (set @entity.segs (array/flatten (array/map (array/range 0 (array/len @entity.sites)) (fn si
            (let ((st (array/nth @entity.sites @si)))
              (let ((p (object/get @st "path")) (a (object/get @st "call")) (cfg (object/get @st "config")) (decl (object/get @st "declared")))
      (let ((n (- (array/len @a) 1)))
        (if (or (< @n @entity.minArity) (and @entity.bounded (> @n @entity.maxArity)))
          [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_HOST_EFFECT_ARITY", path: @p, message: (str/concat "`postgres` takes an origin, a statement, its params and up to two option objects, got " @n), suggestion: "Write (postgres \"postgres://host:5432\" \"SELECT * FROM t WHERE id = $1\" [@payload.id] { auth: @config.password, user: \"app\" } { emit: { success: <EVENT> } })", severity: "error" }] }]
          (let ((fromData (> (array/len @entity.egress) 0)) (cands (array/map (array/filter @entity.egress (fn e (validate/pattern @e "^([Pp][Oo][Ss][Tt][Gg][Rr][Ee][Ss]([Qq][Ll])?)://(\\[[^\\]/?#\\\\@ ]+\\]|[^:/?#\\\\@ \\[][^:/?#\\\\@ ]*)(:\\+?0*([0-5]?[0-9]{1,4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"))) (fn e (let ((pr (str/split @e "://")))
              (let ((au (array/nth @pr 1)))
                (if (str/startsWith @au "[")
                  (let ((q (str/split @au "]")))
                    { s: (str/lower (array/first @pr)), h: (str/lower (str/concat (array/first @q) "]")), p: (let ((tl (array/nth @q 1))) (if (= @tl "") -1 (str/to-int (str/slice @tl 1)))) })
                  (let ((q (str/split @au ":")))
                    { s: (str/lower (array/first @pr)), h: (str/lower (array/first @q)), p: (if (> (array/len @q) 1) (str/to-int (array/nth @q 1)) -1) }))))))))
            (array/concat (let ((o (array/nth @a 1)))
      (let ((kn (if (and (validate/string @o) (str/startsWith @o (str/concat (quote "@") "config.")) (> (str/len @o) 8) (not (str/includes (str/slice @o 8) "."))) (str/slice @o 8) null)))
        (let ((fl (if (= @kn null) null (object/get @cfg @kn null))))
          (let ((urlf (and (!= @fl null) (= (object/get @fl "type" "") "url"))))
            (let ((df (if @urlf (object/get @fl "default" null) null)))
              (let ((ns (or (not (validate/string @o)) (and (!= @kn null) (not @urlf)) (and (= @kn null) (or (str/startsWith @o (quote "@")) (str/startsWith @o "?") (str/startsWith @o "$"))))))
                (let ((lit (if (not (validate/string @o)) null (if (!= @kn null) (if (and (validate/string @df) (not (or (str/startsWith @df (quote "@")) (str/startsWith @df "?") (str/startsWith @df "$")))) @df null) (if (or (str/startsWith @o (quote "@")) (str/startsWith @o "?") (str/startsWith @o "$")) null @o)))))
                  (array/concat
                    (if (and @ns (not @fromData)) [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_HTTP_ORIGIN_NOT_STATIC", path: @p, message: "`postgres` origin must be a string literal or a `url`-typed @config knob (egress cannot be checked otherwise)", suggestion: "Declare `origin: url = \"postgres://host:5432\"` in config and pass @config.origin", severity: "error" }] }] [])
                    (if (= @lit null) []
                      (if (not (validate/pattern @lit "^([Pp][Oo][Ss][Tt][Gg][Rr][Ee][Ss]([Qq][Ll])?)://(\\[[^\\]/?#\\\\@ ]+\\]|[^:/?#\\\\@ \\[][^:/?#\\\\@ ]*)(:\\+?0*([0-5]?[0-9]{1,4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"))
                        [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: (str/concat "`postgres` origin '" @lit "' must be a postgres:// or postgresql:// origin without a path"), suggestion: "Write postgres://host[:port]", severity: "error" }] }]
                        (let ((cur (let ((pr (str/split @lit "://")))
              (let ((au (array/nth @pr 1)))
                (if (str/startsWith @au "[")
                  (let ((q (str/split @au "]")))
                    { s: (str/lower (array/first @pr)), h: (str/lower (str/concat (array/first @q) "]")), p: (let ((tl (array/nth @q 1))) (if (= @tl "") -1 (str/to-int (str/slice @tl 1)))) })
                  (let ((q (str/split @au ":")))
                    { s: (str/lower (array/first @pr)), h: (str/lower (array/first @q)), p: (if (> (array/len @q) 1) (str/to-int (array/nth @q 1)) -1) }))))))
                          (if (array/some @cands (fn en (and (= (object/get @en "s") (object/get @cur "s")) (= (object/get @en "h") (object/get @cur "h")) (or (= (object/get @en "p") -1) (= (object/get @cur "p") -1) (= (object/get @en "p") (object/get @cur "p"))))))
                            []
                            [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_HTTP_EGRESS_UNDECLARED", path: @p, message: (str/concat "`postgres` origin '" @lit "' is not declared in the program's `egress`"), suggestion: "Add the exact postgres://host[:port] origin to the app's `egress: [...]`", severity: "error" }] }])))))))))))) (let ((sq (array/nth @a 2)) (pa (array/nth @a 3)))
      (array/concat
        (if (and (validate/string @sq) (not (or (str/startsWith @sq (quote "@")) (str/startsWith @sq "?")))) [{ k: "g", id: "", sql: @sq, at: @p, em: {}, dc: [], fs: [] }] [])
        [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: (if (and (or (validate/string @pa) (validate/number @pa) (validate/boolean @pa) (validate/object @pa)) (not (and (validate/string @pa) (or (str/startsWith @pa (quote "@")) (str/startsWith @pa "?"))))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` params must be a list of bind values", suggestion: "Write [] when the statement has no $1 placeholders", severity: "error" }] []) }])) (if (> @n (+ @entity.minArity 0)) (let ((o (array/nth @a (+ @entity.minArity 1)))) (if (not (validate/object @o))
        [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", path: @p, message: "`postgres` options must be objects", suggestion: "Write { auth: @config.password, db: 0 } and { key: <string>, emit: { success: <EVENT>, failure: <EVENT> } }", severity: "error" }] }]
        (array/concat
          [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: (array/concat (array/flatten (array/map (object/keys @o) (fn kk (if (not (array/includes @entity.optionKeys @kk)) [{ code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", path: @p, message: (str/concat "`postgres` options accept only " (str/join @entity.optionKeys ", ") ", got `" @kk "`"), suggestion: "", severity: "error" }] (if (array/includes [] @kk) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: (str/concat "`postgres` option `" @kk "` is given twice"), suggestion: "", severity: "error" }] []))))) (array/concat (if (let ((v (object/get @o "tls" null))) (or (validate/number @v) (validate/object @v) (and (validate/string @v) (not (or (str/startsWith @v (quote "@")) (str/startsWith @v "?")))))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `tls` must be true or false", suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "timeoutMs" null))) (and (validate/number @v) (or (!= @v (math/floor @v)) (<= @v 0)))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: (str/concat "`postgres` option `timeoutMs` must be a whole number of milliseconds above zero, got " (json/stringify (object/get @o "timeoutMs"))), suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "user" null))) (or (and (validate/string @v) (= @v "")) (validate/number @v) (validate/boolean @v) (validate/object @v))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `user` must be a non-empty string", suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "database" null))) (or (and (validate/string @v) (= @v "")) (validate/number @v) (validate/boolean @v) (validate/object @v))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `database` must be a non-empty string", suggestion: "", severity: "error" }] [])) (if (or (object/has @o "key") (object/has @o "emit"))
          (let ((kv (object/get @o "key" null)) (em (object/get @o "emit" null)))
            (array/concat
              (if (and (object/has @o "key") (or (= @kv null) (and (validate/string @kv) (= @kv "")))) [{ code: "ORB_CALL_SERVICE_KEY_TYPE", path: @p, message: "postgres `key` must be a non-empty string", suggestion: "", severity: "error" }] [])
              (let ((kd (if (validate/number @kv) "number" (if (validate/boolean @kv) "boolean" (if (validate/object @kv) "object" (if (validate/array @kv) (if (and (> (array/len @kv) 0) (validate/string (array/first @kv))) "" "array") "")))))) (if (or (= @kd "") (= @kd "string")) [] [{ code: "ORB_CALL_SERVICE_KEY_TYPE", path: @p, message: (str/concat "postgres `key` must be a string, got a " @kd " literal"), suggestion: "Use a string literal or a string-typed expression such as @entity.batchId", severity: "error" }]))
              (if (and (validate/object @em) (!= (object/get @em "cancelled" null) null) (or (not (object/has @o "key")) (= @kv null))) [{ code: "ORB_CALL_SERVICE_CANCELLED_WITHOUT_KEY", path: @p, message: "emit.cancelled is declared but the call has no `key` — nothing can cancel an unkeyed call", suggestion: "Add `key: <string expression>` to the postgres options, and cancel it with (cancel-call <key>)", severity: "error" }] [])))
          [])) }]
          (if (validate/object (object/get @o "emit" null))
            [{ k: "e", id: (str/concat "e" @si "." "0"), sql: "", at: @p, em: (object/get @o "emit"), dc: @decl, fs: [] }]
            [])))) []) (if (> @n (+ @entity.minArity 1)) (let ((o (array/nth @a (+ @entity.minArity 2)))) (if (not (validate/object @o))
        [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: [{ code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", path: @p, message: "`postgres` options must be objects", suggestion: "Write { auth: @config.password, db: 0 } and { key: <string>, emit: { success: <EVENT>, failure: <EVENT> } }", severity: "error" }] }]
        (array/concat
          [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: (array/concat (array/flatten (array/map (object/keys @o) (fn kk (if (not (array/includes @entity.optionKeys @kk)) [{ code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", path: @p, message: (str/concat "`postgres` options accept only " (str/join @entity.optionKeys ", ") ", got `" @kk "`"), suggestion: "", severity: "error" }] (if (array/includes (let ((oo (array/nth @a (+ @entity.minArity 1)))) (if (validate/object @oo) (array/filter (object/keys @oo) (fn kk (array/includes @entity.optionKeys @kk))) [])) @kk) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: (str/concat "`postgres` option `" @kk "` is given twice"), suggestion: "", severity: "error" }] []))))) (array/concat (if (let ((v (object/get @o "tls" null))) (or (validate/number @v) (validate/object @v) (and (validate/string @v) (not (or (str/startsWith @v (quote "@")) (str/startsWith @v "?")))))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `tls` must be true or false", suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "timeoutMs" null))) (and (validate/number @v) (or (!= @v (math/floor @v)) (<= @v 0)))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: (str/concat "`postgres` option `timeoutMs` must be a whole number of milliseconds above zero, got " (json/stringify (object/get @o "timeoutMs"))), suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "user" null))) (or (and (validate/string @v) (= @v "")) (validate/number @v) (validate/boolean @v) (validate/object @v))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `user` must be a non-empty string", suggestion: "", severity: "error" }] []) (if (let ((v (object/get @o "database" null))) (or (and (validate/string @v) (= @v "")) (validate/number @v) (validate/boolean @v) (validate/object @v))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` option `database` must be a non-empty string", suggestion: "", severity: "error" }] [])) (if (or (object/has @o "key") (object/has @o "emit"))
          (let ((kv (object/get @o "key" null)) (em (object/get @o "emit" null)))
            (array/concat
              (if (and (object/has @o "key") (or (= @kv null) (and (validate/string @kv) (= @kv "")))) [{ code: "ORB_CALL_SERVICE_KEY_TYPE", path: @p, message: "postgres `key` must be a non-empty string", suggestion: "", severity: "error" }] [])
              (let ((kd (if (validate/number @kv) "number" (if (validate/boolean @kv) "boolean" (if (validate/object @kv) "object" (if (validate/array @kv) (if (and (> (array/len @kv) 0) (validate/string (array/first @kv))) "" "array") "")))))) (if (or (= @kd "") (= @kd "string")) [] [{ code: "ORB_CALL_SERVICE_KEY_TYPE", path: @p, message: (str/concat "postgres `key` must be a string, got a " @kd " literal"), suggestion: "Use a string literal or a string-typed expression such as @entity.batchId", severity: "error" }]))
              (if (and (validate/object @em) (!= (object/get @em "cancelled" null) null) (or (not (object/has @o "key")) (= @kv null))) [{ code: "ORB_CALL_SERVICE_CANCELLED_WITHOUT_KEY", path: @p, message: "emit.cancelled is declared but the call has no `key` — nothing can cancel an unkeyed call", suggestion: "Add `key: <string expression>` to the postgres options, and cancel it with (cancel-call <key>)", severity: "error" }] [])))
          [])) }]
          (if (validate/object (object/get @o "emit" null))
            [{ k: "e", id: (str/concat "e" @si "." "1"), sql: "", at: @p, em: (object/get @o "emit"), dc: @decl, fs: [] }]
            [])))) []) [{ k: "s", id: "", sql: "", at: "", em: {}, dc: [], fs: (if (not (or (and (> @n (+ @entity.minArity 0)) (let ((oo (array/nth @a (+ @entity.minArity 1)))) (and (validate/object @oo) (!= (object/get @oo "user" null) null)))) (and (> @n (+ @entity.minArity 1)) (let ((oo (array/nth @a (+ @entity.minArity 2)))) (and (validate/object @oo) (!= (object/get @oo "user" null) null)))))) [{ code: "ORB_POSTGRES_CALL_INVALID", path: @p, message: "`postgres` needs the `user` option: the role to log in as", suggestion: "", severity: "error" }] []) }]))))))))))
        (emit LINT_PLANNED { })
      LINT_PLANNED -> ready
        (set @entity.waiting 2)
        (set @entity.emitItems (array/map (array/filter @entity.segs (fn s (= (object/get @s "k") "e"))) (fn s { id: (object/get @s "id"), path: (object/get @s "at"), emit: (object/get @s "em"), allowedKeys: @entity.emitKeys, checkDeclared: true, declared: (object/get @s "dc") })))
        (set @entity.guardStmts (array/unique (array/map (array/filter @entity.segs (fn s (= (object/get @s "k") "g"))) (fn s (object/get @s "sql")))))
        (emit SQL_GUARD_CHECK { requestId: (str/concat "sql" @entity.scope), statements: (array/unique (array/map (array/filter @entity.segs (fn s (= (object/get @s "k") "g"))) (fn s (object/get @s "sql")))) })
        (emit EMIT_CONFIG_CHECK { requestId: (str/concat "emit" @entity.scope), items: (array/map (array/filter @entity.segs (fn s (= (object/get @s "k") "e"))) (fn s { id: (object/get @s "id"), path: (object/get @s "at"), emit: (object/get @s "em"), allowedKeys: @entity.emitKeys, checkDeclared: true, declared: (object/get @s "dc") })) })
      GUARD_HEARD -> ready when (= @entity.waiting 2)
        (set @entity.guardRes @payload.results)
        (set @entity.waiting 1)
      GUARD_HEARD -> ready when (= @entity.waiting 1)
        (set @entity.guardRes @payload.results)
        (set @entity.waiting 0)
        (emit LINT_ASSEMBLE { })
      EMIT_HEARD -> ready when (= @entity.waiting 2)
        (set @entity.emitRes @payload.results)
        (set @entity.waiting 1)
      EMIT_HEARD -> ready when (= @entity.waiting 1)
        (set @entity.emitRes @payload.results)
        (set @entity.waiting 0)
        (emit LINT_ASSEMBLE { })
      LINT_ASSEMBLE -> ready
        (set @entity.findings (array/flatten (array/map @entity.segs (fn s
            (let ((k (object/get @s "k")))
              (if (= @k "s")
                (object/get @s "fs")
                (if (= @k "g")
                  (let ((v (array/nth @entity.guardRes (array/indexOf @entity.guardStmts (object/get @s "sql")))))
                    (if (object/get @v "ok") [] [{ code: "ORB_POSTGRES_CALL_INVALID", path: (object/get @s "at"), message: (str/concat "`postgres` statement is not read-only: " (object/get @v "reason")), suggestion: "The postgres effect runs one SELECT (or WITH ... SELECT) and nothing that writes", severity: "error" }]))
                  (object/get (or (array/find @entity.emitRes (fn r (= (object/get @r "id") (object/get @s "id")))) { id: "", findings: [] }) "findings"))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "postgres", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
      LINT_PLAN { }
        @description "Internal: plan the checks of every call found."
        @tier "internal"
      LINT_PLANNED { }
        @description "Internal: ask the composed checkers."
        @tier "internal"
      LINT_ASSEMBLE { }
        @description "Internal: merge the checkers' answers into the findings."
        @tier "internal"
      EMIT_CONFIG_CHECK -> external { requestId : string!  items : [PgEmitConfigItem]! }
        @description "Ask std-orb-emit-config to check each call's emit object."
        @tier "internal"
      SQL_GUARD_CHECK -> external { requestId : string!  statements : [string]! }
        @description "Ask std-sql-select-guard whether each literal statement is a single read-only SELECT."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PgProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      SHAPES_HEARD { operators : Map string PgShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every installed operator's arity and typed params, including the option and emit keys."
      SHAPES_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator table does not match the shape type."
      EMIT_HEARD { requestId : string!  results : [EmitConfigResult]! }
        @description "std-orb-emit-config's answer: the findings of each call's emit object."
      GUARD_HEARD { requestId : string!  results : [SqlGuardVerdict]! }
        @description "std-sql-select-guard's answer: whether each literal statement is a single read-only SELECT."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_OPERATOR_SHAPES -> SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> SHAPES_UNREAD
      OrbEmitConfig.EMIT_CONFIG_CHECKED -> EMIT_HEARD
      SqlSelectGuard.SQL_GUARD_CHECKED -> GUARD_HEARD
    }
  }

  trait OrbLintPostgresCli -> OrbLintPostgresRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint postgres <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "postgres") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint postgres: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "postgres") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint postgres: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-postgres" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint postgres` with its arguments and working directory."
        @synonyms "orb lint postgres"
      OrbLintPostgres.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEmitConfig = EmitConfigUse.traits.OrbEmitConfig {
    listens {
      EMIT_CONFIG_CHECK { requestId : string!  items : [PgEmitConfigItem]! }
        @description "Check each item's emit object against its allowed keys and, when asked, the events its trait declares."
      OrbLintPostgres.EMIT_CONFIG_CHECK -> EMIT_CONFIG_CHECK
    }
  }
  trait SqlSelectGuard = GuardUse.traits.SqlSelectGuard {
    listens {
      SQL_GUARD_CHECK { requestId : string!  statements : [string]! }
        @description "Ask whether each statement is a single read-only SELECT."
      OrbLintPostgres.SQL_GUARD_CHECK -> SQL_GUARD_CHECK
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPostgresCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPostgresOrbitalStart -> OrbLintPostgres, OrbLintPostgresCli, OrbLintInput, OrbEmitConfig, SqlSelectGuard, Packs, Versions
}
