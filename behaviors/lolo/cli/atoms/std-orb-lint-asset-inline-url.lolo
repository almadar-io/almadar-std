app std-orb-lint-asset-inline-url [
  version: "1.0.0",
  inbound: ["cli-lint-asset-inline-url"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-asset-inline-url — the `orb lint asset-inline-url <file>` command, the prevention rung of G-BEHAVIORS-101. It lowers the file with program/read and, for every orbital that composes std-asset-pack (a trait whose ref names an alias that the orbital's uses binds to std/behaviors/std-asset-pack, or any trait declaring the pack's assetPack config knob), reports each literal http:// or https:// string in the config defaults of its other traits and in its entity seed rows (instances), walked at any depth with tree/fold. The trait composed from the atom is skipped, the origin knob of a trait that declares assetPack is exempt, and the app egress entries are never read. One finding per url with its path (status 500, exit 1). Clean answers `lint asset-inline-url: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-asset-inline-url"
type AssetDocValue = string | number | boolean | [AssetDocValue] | Map string AssetDocValue
type AssetKnob = { default : AssetDocValue }
type AssetUrl = string
type AssetUse = { from : string, as : string }
type AssetEntity = { instances : AssetDocValue }
type AssetListenSource = { trait : string }
type AssetListen = { event : string, source : AssetListenSource }
type AssetTrait = { name : string, ref : string, config : Map string AssetKnob, listens : [AssetListen] }
type AssetOrbital = { name : string, traits : [AssetTrait], uses : [AssetUse], entity : AssetEntity }
type AssetProgram = { orbitals : [AssetOrbital] }
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type AssetInlineUrlCodes = { assetInlineUrl : LintCodeDecl }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintAssetInlineUrlOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintAssetInlineUrlRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintAssetInlineUrl -> OrbLintAssetInlineUrlRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (default (array/nth @orbitals @oi) {})))
              (let ((trs (object/get @orb "traits" [])) (oname (object/get @orb "name" "")))
                (let ((packAliases (array/map (array/filter (object/get @orb "uses" []) (fn u (= (object/get @u "from" "") "std/behaviors/std-asset-pack"))) (fn u (object/get @u "as" "")))) (isPack (array/map @trs (fn td (and (validate/object @td) (let ((parts (str/split (object/get @td "ref" "") "."))) (and (= (array/len @parts) 3) (array/includes @packAliases (array/nth @parts 0))))))))
                      (hasKnob (array/map @trs (fn td (and (validate/object @td) (object/has (object/get @td "config" {}) "assetPack")))))
                      (packNames (array/map (array/filter (array/range 0 (array/len @trs)) (fn i (default (array/nth @hasKnob @i) false))) (fn i (object/get (default (array/nth @trs @i) {}) "name" "")))))
                  (if (not (or (array/some @isPack (fn b @b)) (array/some @hasKnob (fn b @b))))
                    []
                    (let ((where (str/concat "orbitals[" @oi " (" @oname ")]"))
                          (units (array/concat
                            (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                              (let ((td (default (array/nth @trs @ti) {})))
                                (if (default (array/nth @isPack @ti) false)
                                  []
                                  (array/map (array/filter (object/keys (object/get @td "config" {})) (fn k (not (and (= @k "origin") (or (default (array/nth @hasKnob @ti) false) (array/some (object/get @td "listens" []) (fn l (array/includes @packNames (object/get (object/get @l "source" {}) "trait" ""))))))))) (fn k
                                    { path: (str/concat @where ".traits[" @ti " (" (object/get @td "name" "") ")].config." @k ".default"), ti: @ti, kn: @k })))))))
                            (if (validate/object (object/get @orb "entity" null))
                              [{ path: (str/concat @where ".entity.instances"), ti: -1, kn: "" }]
                              []))))
                      (array/flatten (array/map @units (fn u
                        (let ((v (if (= (object/get @u "ti") -1) (object/get (object/get @orb "entity" {}) "instances" null) (let ((cf (object/get (default (array/nth @trs (object/get @u "ti")) {}) "config" {}))) (object/get (object/get @cf (object/get @u "kn") {}) "default" null)))) (p (object/get @u "path")))
(let ((dq "\"")) (array/map (array/filter (if (= @v null) [] (json/nodes [@v])) (fn y (let ((t (json/stringify @y))) (or (str/startsWith @t (str/concat @dq "https://")) (str/startsWith @t (str/concat @dq "http://")))))) (fn y { code: @config.codes.assetInlineUrl.code, path: @p, message: (str/concat "Orbital '" @oname "' composes std-asset-pack but carries the literal asset url '" (default (as @y AssetUrl) "") "'"), suggestion: "Add the art to the pack's assets rows and look it up by key; the pack atom's origin is the only place a host belongs", severity: "error" })))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "asset-inline-url", scope: @entity.scope, findings: @entity.findings })
    }

    config {
      codes : AssetInlineUrlCodes = { assetInlineUrl: { code: "ORB_ASSET_INLINE_URL", category: "asset", description: "A literal http(s) url sits in the config defaults or seed rows of an orbital that composes std-asset-pack." } }
        @label "Emitted codes"
        @description "The finding codes this rule emits."
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : AssetProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintAssetInlineUrlCli -> OrbLintAssetInlineUrlRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint asset-inline-url: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint asset-inline-url <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint asset-inline-url <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "asset-inline-url") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint asset-inline-url: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "asset-inline-url") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint asset-inline-url: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-asset-inline-url" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint asset-inline-url` with its arguments and working directory."
        @synonyms "orb lint asset-inline-url"
      OrbLintAssetInlineUrl.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintAssetInlineUrlCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintAssetInlineUrlOrbitalStart -> OrbLintAssetInlineUrl, OrbLintAssetInlineUrlCli, OrbLintInput, Packs, Versions
}
