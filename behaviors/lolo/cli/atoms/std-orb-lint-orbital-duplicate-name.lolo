app std-orb-lint-orbital-duplicate-name [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-duplicate-name"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-orbital-duplicate-name — the `orb lint orbital-duplicate-name <file>` command, the port of ORB_O_DUPLICATE_NAME (validate_orbital_name_uniqueness). It lowers the file with program/read and reports each orbital name declared more than once, once, at the second declaration, with every index (status 500, exit 1). Clean answers `lint orbital-duplicate-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-orbital-duplicate-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintOrbitalDuplicateNameOrbital {
  entity OrbLintOrbitalDuplicateNameRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintOrbitalDuplicateName -> OrbLintOrbitalDuplicateNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "orbital-duplicate-name", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (let ((names (array/map @orbitals (fn o (object/get @o "name" "")))))
            (array/flatten (array/map (array/range 0 (array/len @names)) (fn oi
              (let ((nm (array/nth @names @oi)))
                (let ((at (array/filter (array/range 0 (array/len @names)) (fn j (= (array/nth @names @j) @nm)))))
                  (if (or (< (array/len @at) 2) (!= (array/first @at) @oi))
                    []
                    [(str/concat "[ORB_O_DUPLICATE_NAME] orbitals[" (array/nth @at 1) "]: Orbital '" @nm "' is declared " (array/len @at) " times (orbitals [" (str/join (array/map @at (fn j (str/concat @j))) ", ") "])\n  suggestion: Give each orbital its own name")])))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "orbital-duplicate-name" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintOrbitalDuplicateNameCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintOrbitalDuplicateNameCli -> OrbLintOrbitalDuplicateNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-duplicate-name <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-duplicate-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint orbital-duplicate-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-duplicate-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "orbital-duplicate-name")
        (emit LINT_ANSWERED { status: 500, body: "lint orbital-duplicate-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-orbital-duplicate-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint orbital-duplicate-name` with its arguments and working directory."
        @synonyms "orb lint orbital-duplicate-name, orb lint orbital-duplicate-name, duplicate orbital name, orbital name uniqueness"
      OrbLintOrbitalDuplicateName.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalDuplicateName.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-orbital-duplicate-name" as OrbLintOrbitalDuplicateNamePage -> OrbLintOrbitalDuplicateName, OrbLintOrbitalDuplicateNameCli
}
