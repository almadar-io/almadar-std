app std-orb-lint-orbital-duplicate-name [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-duplicate-name"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-orbital-duplicate-name — the `orb lint orbital-duplicate-name <file>` command, the port of ORB_O_DUPLICATE_NAME (validate_orbital_name_uniqueness). It lowers the file with program/read and reports each orbital name declared more than once, once, at the second declaration, with every index (status 500, exit 1). Clean answers `lint orbital-duplicate-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-orbital-duplicate-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type DuplicateNameOrbital = { name : string }
type DuplicateNameProgram = { orbitals : [DuplicateNameOrbital]! }

orbital OrbLintOrbitalDuplicateNameOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintOrbitalDuplicateNameRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintOrbitalDuplicateName -> OrbLintOrbitalDuplicateNameRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((names (array/map @orbitals (fn o (object/get @o "name" "")))))
            (array/flatten (array/map (array/range 0 (array/len @names)) (fn oi
              (let ((nm (array/nth @names @oi)))
                (let ((at (array/filter (array/range 0 (array/len @names)) (fn j (= (array/nth @names @j) @nm)))))
                  (if (or (< (array/len @at) 2) (!= (array/first @at) @oi))
                    []
                    [{ code: "ORB_O_DUPLICATE_NAME", path: (str/concat "orbitals[" (array/nth @at 1) "]"), message: (str/concat "Orbital '" @nm "' is declared " (array/len @at) " times (orbitals [" (str/join (array/map @at (fn j (str/concat @j))) ", ") "])"), suggestion: "Give each orbital its own name", severity: "error" }])))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "orbital-duplicate-name", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : DuplicateNameProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintOrbitalDuplicateNameCli -> OrbLintOrbitalDuplicateNameRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-duplicate-name <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-duplicate-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint orbital-duplicate-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-duplicate-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint orbital-duplicate-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-orbital-duplicate-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint orbital-duplicate-name` with its arguments and working directory."
        @synonyms "orb lint orbital-duplicate-name, orb lint orbital-duplicate-name, duplicate orbital name, orbital name uniqueness"
      OrbLintOrbitalDuplicateName.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintOrbitalDuplicateNameCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintOrbitalDuplicateNameOrbitalStart -> OrbLintOrbitalDuplicateName, OrbLintOrbitalDuplicateNameCli, OrbLintInput, Packs, Versions
}
