app std-orb-emit [
  version: "1.0.0",
  inbound: ["cli-emit"],
  description: "std-orb-emit — the `orb emit <TARGET> <FILE> [flags]` command (spec/cli/orb-emit.lolo; port of orbital-cli emit/mod.rs run). TARGET is orb, lolo, ts, py or manifest. The file is joined to the directory the command runs in when it is relative, then rendered by program/print { target, path, section?, format?, only?, map?, output?, inspectSource?, documentVersion?, unit?, out?, signKey?, keyId? } on the host, the same emit pipeline the Rust command ran, which answers { text, stderr }: the stdout and stderr text the command printed and writes the files it wrote. The command prints text (one trailing newline dropped, the hook adds it) and stderr. A refusal (unreadable file, lowering error, bad section, bad target value, manifest key failure) answers status 500 on stderr `Error: <reason>` (exit 1), the reason carrying the host's `program/print:` prefix. A wrong word count, an unknown flag, a valueless flag, a non-numeric --document-version, --document-version without --inspect-source, or one of --sign-key / --key-id without the other answers the usage (status 400, exit 2). Known difference: the input is always a file; reading the program from stdin is not supported."
]
uses Spec from "almadar-std/orb-emit"
uses Args from "std/behaviors/std-args"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type EmitAnswer = { text : string!, stderr : string! }

orbital OrbEmitOrbital {
  entity EmitRun [runtime] {
    id : string!
    cwd : string = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbEmit.EMIT_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbEmit -> EmitRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      EMIT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit EMIT_ANSWERED { status: 500, body: "", stderr: "Error: orb emit: the command arguments could not be read" })
      EMIT_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit EMIT_ARGS_PARSE { stage: "emit" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "section" aliases: [] takesValue: true repeatable: false }, { name: "output" aliases: ["-o"] takesValue: true repeatable: false }, { name: "format" aliases: [] takesValue: true repeatable: false }, { name: "only" aliases: [] takesValue: true repeatable: false }, { name: "map" aliases: [] takesValue: false repeatable: false }, { name: "inspect-source" aliases: [] takesValue: true repeatable: false }, { name: "document-version" aliases: [] takesValue: true repeatable: false }, { name: "unit" aliases: [] takesValue: true repeatable: false }, { name: "out" aliases: [] takesValue: true repeatable: false }, { name: "sign-key" aliases: [] takesValue: true repeatable: false }, { name: "key-id" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      EMIT_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 2) (and (object/has @payload.flags "document-version") (= (str/to-int (default (array/first (object/get @payload.flags "document-version")) "")) null)) (and (object/has @payload.flags "document-version") (not (object/has @payload.flags "inspect-source"))) (!= (object/has @payload.flags "sign-key") (object/has @payload.flags "key-id")))
        (emit EMIT_ANSWERED { status: 400, body: "", stderr: "usage: orb emit <TARGET> <FILE> [--section SELECTOR] [-o|--output PATH] [--format FORMAT] [--only KINDS] [--map] [--inspect-source PATH] [--document-version N] [--unit NAME] [--out DIR] [--sign-key PATH --key-id ID]" })
      EMIT_ARGS_DONE -> working when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 2) (not (and (object/has @payload.flags "document-version") (= (str/to-int (default (array/first (object/get @payload.flags "document-version")) "")) null))) (not (and (object/has @payload.flags "document-version") (not (object/has @payload.flags "inspect-source")))) (= (object/has @payload.flags "sign-key") (object/has @payload.flags "key-id")))
        (emit EMIT_START { cwd: @entity.cwd, positionals: @payload.positionals, flags: @payload.flags })
    }

    state working {
      INIT -> working
      EMIT_DONE -> ready
        (emit EMIT_ANSWERED { status: @payload.status, body: @payload.body, stderr: @payload.stderr })
    }

    emits {
      EMIT_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      EMIT_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      EMIT_START {
        cwd : string!
        positionals : [string]!
        flags : Map string [string]!
      }
        @description "Internal: render the program the words name."
        @tier "internal"
    }

    listens {
      EMIT_CALLED -> inbound "cli-emit" answers EMIT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb emit`."
        @synonyms "orb emit, print the generated code, emit orb lolo ts py manifest, lower a lolo file to orb json"
      EMIT_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED."
      ArgsCli.ARGS_PARSED -> EMIT_ARGS_DONE
      EmitEngine.EMIT_ANSWERED -> EMIT_DONE
      EMIT_DONE { status : number!  body : string!  stderr : string }
        @description "Internal: the engine's answer, relayed to the hook by its handler."
        @tier "internal"
    }
  }

  trait EmitEngine -> EmitRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      EMIT_START -> emitting
        (set @entity.cwd @payload.cwd)
        (program/print null (object/merge { target: (array/first @payload.positionals), path: (if (os/path-is-absolute (default (array/first (array/slice @payload.positionals 1)) "")) (default (array/first (array/slice @payload.positionals 1)) "") (os/path-join @entity.cwd (default (array/first (array/slice @payload.positionals 1)) ""))) } (if (object/has @payload.flags "section") { section: (default (array/first (object/get @payload.flags "section")) "") } {}) (if (object/has @payload.flags "output") { output: (if (os/path-is-absolute (default (array/first (object/get @payload.flags "output")) "")) (default (array/first (object/get @payload.flags "output")) "") (os/path-join @entity.cwd (default (array/first (object/get @payload.flags "output")) ""))) } {}) (if (object/has @payload.flags "format") { format: (default (array/first (object/get @payload.flags "format")) "") } {}) (if (object/has @payload.flags "only") { only: (default (array/first (object/get @payload.flags "only")) "") } {}) (if (object/has @payload.flags "map") { map: true } {}) (if (object/has @payload.flags "inspect-source") { inspectSource: (if (os/path-is-absolute (default (array/first (object/get @payload.flags "inspect-source")) "")) (default (array/first (object/get @payload.flags "inspect-source")) "") (os/path-join @entity.cwd (default (array/first (object/get @payload.flags "inspect-source")) ""))) } {}) (if (object/has @payload.flags "document-version") { documentVersion: (str/to-int (default (array/first (object/get @payload.flags "document-version")) "")) } {}) (if (object/has @payload.flags "unit") { unit: (default (array/first (object/get @payload.flags "unit")) "") } {}) (if (object/has @payload.flags "out") { out: (if (os/path-is-absolute (default (array/first (object/get @payload.flags "out")) "")) (default (array/first (object/get @payload.flags "out")) "") (os/path-join @entity.cwd (default (array/first (object/get @payload.flags "out")) ""))) } {}) (if (object/has @payload.flags "sign-key") { signKey: (if (os/path-is-absolute (default (array/first (object/get @payload.flags "sign-key")) "")) (default (array/first (object/get @payload.flags "sign-key")) "") (os/path-join @entity.cwd (default (array/first (object/get @payload.flags "sign-key")) ""))) } {}) (if (object/has @payload.flags "key-id") { keyId: (default (array/first (object/get @payload.flags "key-id")) "") } {})) { key: "emit" emit: { success: EMIT_RENDERED, failure: EMIT_REFUSED } })
    }

    state emitting {
      INIT -> emitting
      EMIT_RENDERED -> idle
        (emit EMIT_ANSWERED { status: 200, body: (if (str/endsWith (object/get @payload.result "text") "\n") (str/slice (object/get @payload.result "text") 0 (- (str/len (object/get @payload.result "text")) 1)) (object/get @payload.result "text")), stderr: (if (str/endsWith (object/get @payload.result "stderr") "\n") (str/slice (object/get @payload.result "stderr") 0 (- (str/len (object/get @payload.result "stderr")) 1)) (object/get @payload.result "stderr")) })
      EMIT_REFUSED -> idle
        (emit EMIT_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " (default @payload.error "")) })
    }

    emits {
      EMIT_ANSWERED -> external {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      EMIT_REFUSED {
        error : string
      }
        @description "The program could not be read or rendered."
        @tier "internal"
      EMIT_RENDERED {
        result : EmitAnswer!
      }
        @description "program/print: the stdout and stderr text of the emit."
        @tier "internal"
    }

    listens {
      EMIT_START {
        cwd : string!
        positionals : [string]!
        flags : Map string [string]!
      }
        @description "Render the program the words name."
      OrbEmit.EMIT_START -> EMIT_START
    }
  }

  page boot as OrbEmitPage -> OrbEmit, ArgsCli, EmitEngine
}
