app std-orb-lint-entity-field-type [
  version: "1.0.0",
  inbound: ["cli-lint-entity-field-type"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-field-type — the `orb lint entity-field-type <file>` command, the port. It lowers the file with program/read and reports each top-level field with an empty name (ORB_E_INVALID_FIELD_NAME), a type outside the valid field types (ORB_E_INVALID_FIELD_TYPE) or a relation type with no relation configuration (ORB_E_INVALID_RELATION), the validate_field checks, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint entity-field-type: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-field-type"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEntityFieldTypeOrbital {
  entity OrbLintEntityFieldTypeRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityFieldType -> OrbLintEntityFieldTypeRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-field-type", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (validate/object @ent) (let ((fields (object/get @ent "fields" [])))
                (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                  (let ((f (array/nth @fields @fi)))
                    (array/concat
                      (if (and (object/has @f "name") (= (object/get @f "name" "x") ""))
                        [{ code: "ORB_E_INVALID_FIELD_NAME", path: (str/concat "orbitals[" @oi "].entity.fields[" @fi "].name"), message: "Field name cannot be empty", suggestion: "Provide a valid camelCase field name", severity: "error" }]
                        [])
                      (if (array/includes ["string" "number" "boolean" "date" "datetime" "timestamp" "email" "url" "phone" "uuid" "image" "money" "file" "bytes" "CallKey" "array" "tuple" "object" "enum" "relation" "trait" "orbital" "behavior" "slot" "pattern" "node" "event" "union"] (object/get @f "type" "string"))
                        []
                        [{ code: "ORB_E_INVALID_FIELD_TYPE", path: (str/concat "orbitals[" @oi "].entity.fields[" @fi "].type"), message: (str/concat "Invalid field type: '" (object/get @f "type" "") "'"), suggestion: "Use a valid field type", severity: "error" }])
                      (if (and (= (object/get @f "type" "") "relation") (not (object/has @f "relation")))
                        [{ code: "ORB_E_INVALID_RELATION", path: (str/concat "orbitals[" @oi "].entity.fields[" @fi "].relation"), message: "Relation field requires a 'relation' configuration", suggestion: "Add relation: { entity: 'EntityName', cardinality: 'one' }", severity: "error" }]
                        []))))))) [])))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "entity-field-type" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEntityFieldTypeCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEntityFieldTypeCli -> OrbLintEntityFieldTypeRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-field-type <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-field-type") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-field-type: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-field-type") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "entity-field-type")
        (emit LINT_ANSWERED { status: 500, body: "lint entity-field-type: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-field-type" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-field-type` with its arguments and working directory."
        @synonyms "orb lint entity-field-type, entity field type"
      OrbLintEntityFieldType.LINT_FOUND -> LINT_FOUND
      OrbLintEntityFieldType.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-entity-field-type" as OrbLintEntityFieldTypePage -> OrbLintEntityFieldType, OrbLintEntityFieldTypeCli
}
