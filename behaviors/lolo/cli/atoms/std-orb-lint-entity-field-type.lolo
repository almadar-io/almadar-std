app std-orb-lint-entity-field-type [
  version: "1.0.0",
  inbound: ["cli-lint-entity-field-type"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-field-type — the `orb lint entity-field-type <file>` command, the port. It lowers the file with program/read and reports, for every primary and auxiliary entity, each top-level field with an empty name or, in an English program, a name that is not camelCase (ORB_E_INVALID_FIELD_NAME), a type outside the valid field types (ORB_E_INVALID_FIELD_TYPE) or a relation type with no relation configuration (ORB_E_INVALID_RELATION), the validate_field checks, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-field-type: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-field-type"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type FieldTypeRelation = { entity : string }
type FieldTypeField = { name : string, type : string, relation : FieldTypeRelation }
type FieldTypeEntity = { fields : [FieldTypeField] }
type FieldTypeOrbital = { entity : FieldTypeEntity, auxiliaryEntities : [FieldTypeEntity], spec : boolean }
type FieldTypeProgram = { orbitals : [FieldTypeOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEntityFieldTypeCodes = { eInvalidFieldName : LintCodeDecl , eInvalidFieldType : LintCodeDecl , eInvalidRelation : LintCodeDecl }

orbital OrbLintEntityFieldTypeOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityFieldTypeRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityFieldType -> OrbLintEntityFieldTypeRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((auxs (object/get (default (array/nth @orbitals @oi) {}) "auxiliaryEntities" [])))
              (array/flatten (array/map
                (array/concat [{ ent: (object/get (default (array/nth @orbitals @oi) {}) "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                  (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                (fn eb
                  (let ((ent (object/get @eb "ent")) (base (object/get @eb "base")))
                    (if (and (validate/object @ent) (not (object/get (default (array/nth @orbitals @oi) {}) "spec" false)))
                      (let ((fields (object/get @ent "fields" [])))
                        (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                          (let ((f (default (array/nth @fields @fi) {})))
                            (array/concat
                              (if (and (object/has @f "name") (= (object/get @f "name" "x") ""))
                                [{ code: @config.codes.eInvalidFieldName.code, path: (str/concat @base ".fields[" @fi "].name"), message: "Field name cannot be empty", suggestion: "Provide a valid camelCase field name", severity: "error" }]
                                (if (and @payload.latin (validate/string (object/get @f "name" null)) (not (validate/pattern (object/get @f "name") "^[a-z][a-zA-Z0-9]*$")))
                                  [{ code: @config.codes.eInvalidFieldName.code, path: (str/concat @base ".fields[" @fi "].name"), message: (str/concat "Field name '" (object/get @f "name") "' should be camelCase"), suggestion: "Use camelCase for field names (e.g., 'firstName', 'createdAt')", severity: "error" }]
                                  []))
                              (if (array/includes @config.fieldTypes (object/get @f "type" "string"))
                                []
                                [{ code: @config.codes.eInvalidFieldType.code, path: (str/concat @base ".fields[" @fi "].type"), message: (str/concat "Invalid field type: '" (object/get @f "type" "") "'"), suggestion: "Use a valid field type", severity: "error", validValues: @config.fieldTypes }])
                              (if (and (= (object/get @f "type" "") "relation") (not (object/has @f "relation")))
                                [{ code: @config.codes.eInvalidRelation.code, path: (str/concat @base ".fields[" @fi "].relation"), message: "Relation field requires a 'relation' configuration", suggestion: "Add relation: { entity: 'EntityName', cardinality: 'one' }", severity: "error" }]
                                [])))))))
                      [])))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-field-type", scope: @entity.scope, findings: @entity.findings })
    }

    config {
      codes : LintEntityFieldTypeCodes = { eInvalidFieldName: { code: "ORB_E_INVALID_FIELD_NAME", category: "entity", description: "An entity field or entity name is empty or not in the required naming form" }, eInvalidFieldType: { code: "ORB_E_INVALID_FIELD_TYPE", category: "entity", description: "An entity field declares a type that is not a valid field type" }, eInvalidRelation: { code: "ORB_E_INVALID_RELATION", category: "entity", description: "A relation field is missing its relation configuration or points at an entity that does not exist" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
      fieldTypes : [string] = ["string", "number", "int", "boolean", "date", "datetime", "timestamp", "instant", "email", "url", "phone", "uuid", "image", "money", "file", "bytes", "CallKey", "array", "tuple", "object", "enum", "relation", "trait", "orbital", "behavior", "slot", "pattern", "node", "event", "union"]
        @label "Field types"
        @description "The field types an entity field may declare, as the compiler's field validation accepts them (G-STD-145)."
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : FieldTypeProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntityFieldTypeCli -> OrbLintEntityFieldTypeRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (!= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-field-type <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-field-type") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-field-type: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-field-type") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-field-type: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-field-type" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-field-type` with its arguments and working directory."
        @synonyms "orb lint entity-field-type, entity field type"
      OrbLintEntityFieldType.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityFieldTypeCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityFieldTypeOrbitalStart -> OrbLintEntityFieldType, OrbLintEntityFieldTypeCli, OrbLintInput, Packs, Versions
}
