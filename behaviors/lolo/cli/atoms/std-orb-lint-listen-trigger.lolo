app std-orb-lint-listen-trigger [
  version: "1.0.0",
  inbound: ["cli-lint-listen-trigger"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-listen-trigger — the `orb lint listen-trigger <file>` command, the port of ORB_X_LISTEN_TRIGGER_UNMATCHED. It lowers the file with program/read and, for every inline trait with listens, requires each listen's trigger (its `-> TRIGGER`, else the listened event) to be the event of a transition in the same trait. Each unmatched listen is reported with its path and suggestion (status 500, exit 1). Clean answers `lint listen-trigger: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-listen-trigger"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ListenTransition = { event : string }
type ListenMachine = { transitions : [ListenTransition] }
type ListenEntry = { event : string, triggers : string }
type ListenTrait = { name : string, stateMachine : ListenMachine, listens : [ListenEntry] }
type ListenOrbital = { name : string, traits : [ListenTrait] }
type ListenProgram = { orbitals : [ListenOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintListenTriggerOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintListenTriggerRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintListenTrigger -> OrbLintListenTriggerRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/filter @trs (fn t (and (object/has @t "stateMachine") (object/has @t "listens")))) (fn t
                  (let ((handled (array/map (object/get (object/get @t "stateMachine") "transitions" []) (fn x (object/get @x "event"))))
                        (lsn (object/get @t "listens" [])))
                    (array/map (array/filter @lsn (fn l (not (array/includes @handled (object/get @l "triggers" (object/get @l "event"))))))
                      (fn l { code: "ORB_X_LISTEN_TRIGGER_UNMATCHED", path: (str/concat "orbitals." (object/get @o "name") ".traits." (object/get @t "name") ".listens"), message: (str/concat "Listen entry in '" (object/get @o "name") "." (object/get @t "name") "' triggers '" (object/get @l "triggers" (object/get @l "event")) "' but no transition in the same trait reacts to it."), suggestion: "Add a transition whose event matches the listen trigger, or fix the `-> TRIGGER` to name an event the trait's state machine handles.", severity: "error" })))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "listen-trigger", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ListenProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintListenTriggerCli -> OrbLintListenTriggerRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint listen-trigger <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "listen-trigger") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint listen-trigger: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "listen-trigger") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint listen-trigger: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-listen-trigger" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint listen-trigger` with its arguments and working directory."
        @synonyms "orb lint listen-trigger, orb lint listen-trigger, values union default"
      OrbLintListenTrigger.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintListenTriggerCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintListenTriggerOrbitalStart -> OrbLintListenTrigger, OrbLintListenTriggerCli, OrbLintInput, Packs, Versions
}
