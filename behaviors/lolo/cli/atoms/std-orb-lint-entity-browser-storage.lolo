app std-orb-lint-entity-browser-storage [
  version: "1.0.0",
  inbound: ["cli-lint-entity-browser-storage"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-browser-storage — the `orb lint entity-browser-storage <file>` command, the port of ORB_E_LOCAL_REQUIRES_PERSISTENT, ORB_E_MOCK_SEED_NOT_LOCAL and ORB_E_IDENTITY_LOCAL (entity.rs validate_browser_storage; the mock-plus-instances conflict is not ported). It lowers the file with program/read and reports, per orbital entity, each storage-flag contradiction with its path and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-browser-storage: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-browser-storage"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type BrowserEntity = { name : string, local : boolean, seedMock : boolean, identity : boolean, persistence : string }
type BrowserOrbital = { spec : boolean, entity : BrowserEntity, auxiliaryEntities : [BrowserEntity] }
type BrowserProgram = { orbitals : [BrowserOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEntityBrowserStorageOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityBrowserStorageRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityBrowserStorage -> OrbLintEntityBrowserStorageRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
             (array/flatten (array/map
              (array/concat [{ ent: (object/get (array/nth @orbitals @oi) "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
              (fn eb
            (let ((ent (object/get @eb "ent")))
              (if (and (validate/object @ent) (not (object/get (array/nth @orbitals @oi) "spec" false))) (let ((nm (object/get @ent "name" "")) (lc (object/get @ent "local" false)) (sd (object/get @ent "seedMock" false)) (idn (object/get @ent "identity" false)) (rt (= (object/get @ent "persistence" "") "runtime")))
                (array/concat
                  (if (and @lc @rt) [{ code: "ORB_E_LOCAL_REQUIRES_PERSISTENT", path: (str/concat (object/get @eb "base") ".local"), message: (str/concat "Entity '" @nm "' is [runtime, local] — a runtime entity's frame already lives in the client; `local` declares where PERSISTED rows live"), suggestion: "Use `[persistent: <collection>, local]` for rows stored in the browser, or drop `local`.", severity: "error" }] [])
                  (array/concat
                    (if (and @sd (not @lc)) [{ code: "ORB_E_MOCK_SEED_NOT_LOCAL", path: (str/concat (object/get @eb "base") ".seedMock"), message: (str/concat "Entity '" @nm "' declares `mock` seeding but its rows are not browser-stored — a server's mock data is its own deployment mode"), suggestion: "Add `local` (`[persistent: <collection>, local, mock]`) or drop `mock`.", severity: "error" }] [])
                    (if (and @idn @lc) [{ code: "ORB_E_IDENTITY_LOCAL", path: (str/concat (object/get @eb "base") ".local"), message: (str/concat "Entity '" @nm "' is [identity] and `local` — the viewer directory is never browser-resident"), suggestion: "Drop `local` from the identity entity.", severity: "error" }] [])))) [])))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-browser-storage", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : BrowserProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntityBrowserStorageCli -> OrbLintEntityBrowserStorageRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-browser-storage <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-browser-storage") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-browser-storage: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-browser-storage") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-browser-storage: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-browser-storage" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-browser-storage` with its arguments and working directory."
        @synonyms "orb lint entity-browser-storage, duplicate field names"
      OrbLintEntityBrowserStorage.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityBrowserStorageCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityBrowserStorageOrbitalStart -> OrbLintEntityBrowserStorage, OrbLintEntityBrowserStorageCli, OrbLintInput, Packs, Versions
}
