app std-orb-lint-entity-browser-storage [
  version: "1.0.0",
  inbound: ["cli-lint-entity-browser-storage"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-browser-storage — the `orb lint entity-browser-storage <file>` command, the port of ORB_E_LOCAL_REQUIRES_PERSISTENT, ORB_E_MOCK_SEED_NOT_LOCAL and ORB_E_IDENTITY_LOCAL (entity.rs validate_browser_storage; the mock-plus-instances conflict is not ported). It lowers the file with program/read and reports, per orbital entity, each storage-flag contradiction with its path and suggestion (status 500, exit 1). Clean answers `lint entity-browser-storage: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-browser-storage"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEntityBrowserStorageOrbital {
  entity OrbLintEntityBrowserStorageRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityBrowserStorage -> OrbLintEntityBrowserStorageRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-browser-storage", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (validate/object @ent) (let ((nm (object/get @ent "name" "")) (lc (object/get @ent "local" false)) (sd (object/get @ent "seedMock" false)) (idn (object/get @ent "identity" false)) (rt (= (object/get @ent "persistence" "") "runtime")))
                (array/concat
                  (if (and @lc @rt) [{ code: "ORB_E_LOCAL_REQUIRES_PERSISTENT", path: (str/concat "orbitals[" @oi "].entity.local"), message: (str/concat "Entity '" @nm "' is [runtime, local] — a runtime entity's frame already lives in the client; `local` declares where PERSISTED rows live"), suggestion: "Use `[persistent: <collection>, local]` for rows stored in the browser, or drop `local`.", severity: "error" }] [])
                  (array/concat
                    (if (and @sd (not @lc)) [{ code: "ORB_E_MOCK_SEED_NOT_LOCAL", path: (str/concat "orbitals[" @oi "].entity.seedMock"), message: (str/concat "Entity '" @nm "' declares `mock` seeding but its rows are not browser-stored — a server's mock data is its own deployment mode"), suggestion: "Add `local` (`[persistent: <collection>, local, mock]`) or drop `mock`.", severity: "error" }] [])
                    (if (and @idn @lc) [{ code: "ORB_E_IDENTITY_LOCAL", path: (str/concat "orbitals[" @oi "].entity.local"), message: (str/concat "Entity '" @nm "' is [identity] and `local` — the viewer directory is never browser-resident"), suggestion: "Drop `local` from the identity entity.", severity: "error" }] [])))) [])))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "entity-browser-storage" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEntityBrowserStorageCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEntityBrowserStorageCli -> OrbLintEntityBrowserStorageRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-browser-storage <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-browser-storage") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-browser-storage: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-browser-storage") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "entity-browser-storage")
        (emit LINT_ANSWERED { status: 500, body: "lint entity-browser-storage: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-browser-storage" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-browser-storage` with its arguments and working directory."
        @synonyms "orb lint entity-browser-storage, duplicate field names"
      OrbLintEntityBrowserStorage.LINT_FOUND -> LINT_FOUND
      OrbLintEntityBrowserStorage.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-entity-browser-storage" as OrbLintEntityBrowserStoragePage -> OrbLintEntityBrowserStorage, OrbLintEntityBrowserStorageCli
}
