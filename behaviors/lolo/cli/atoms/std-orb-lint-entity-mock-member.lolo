app std-orb-lint-entity-mock-member [
  version: "1.0.0",
  inbound: ["cli-lint-entity-mock-member"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-mock-member — the `orb lint entity-mock-member <file>` command, the port of ORB_E_MOCK_NOT_IN_ENUM (entity.rs validate_field). It lowers the file with program/read and, for every non-union field with declared values and a @mock, reports the comma-separated trimmed candidates that are not among the values, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-mock-member: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-mock-member"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type MockMemberField = { type : string, values : [string], mock : string }
type MockMemberEntity = { fields : [MockMemberField] }
type MockMemberOrbital = { entity : MockMemberEntity, spec : boolean }
type MockMemberProgram = { orbitals : [MockMemberOrbital] }

orbital OrbLintEntityMockMemberOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityMockMemberRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityMockMember -> OrbLintEntityMockMemberRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (and (validate/object @ent) (not (object/get (array/nth @orbitals @oi) "spec" false))) (let ((fields (object/get @ent "fields" [])))
                (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                  (let ((f (array/nth @fields @fi)))
                    (let ((values (object/get @f "values" [])) (cands (array/filter (array/map (str/split (object/get @f "mock" "") ",") (fn c (str/trim @c))) (fn c (!= @c "")))))
                      (if (and (> (array/len @values) 0) (!= (object/get @f "type" "") "union"))
                        (let ((outside (array/filter @cands (fn c (not (array/includes @values @c))))))
                          (if (> (array/len @outside) 0)
                            [{ code: "ORB_E_MOCK_NOT_IN_ENUM", path: (str/concat "orbitals[" @oi "].entity.fields[" @fi "].mock"), message: (str/concat (str/decode-uri-component "%40") "mock candidate(s) " (str/join @outside ", ") " are not values of this field"), suggestion: "Use only the field's declared values as @mock candidates", severity: "error" }]
                            []))
                        []))))))) [])))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-mock-member", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : MockMemberProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntityMockMemberCli -> OrbLintEntityMockMemberRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-mock-member <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-mock-member") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-mock-member: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-mock-member") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-mock-member: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-mock-member" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-mock-member` with its arguments and working directory."
        @synonyms "orb lint entity-mock-member, seed source"
      OrbLintEntityMockMember.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityMockMemberCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityMockMemberOrbitalStart -> OrbLintEntityMockMember, OrbLintEntityMockMemberCli, OrbLintInput, Packs, Versions
}
