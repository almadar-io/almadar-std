app std-orb-lint-entity-locale-instances [
  version: "1.0.0",
  inbound: ["cli-lint-entity-locale-instances"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-locale-instances — the `orb lint entity-locale-instances <file>` command, the port of ORB_E_LOCALE_INSTANCES_NOT_LOCAL, ORB_E_LOCALE_INSTANCES_UNKNOWN_LOCALE and ORB_E_LOCALE_INSTANCES_INCOMPLETE (entity.rs validate_all_locale_instances), plus ORB_E_INSTANCE_INVALID (entity.rs check_instance_rows) for the default `instances` rows and every locale block: a row key that is no field, a missing required field with no default, and, on a browser-stored entity, a row without an `id`. It lowers the file with program/read and, for every inline primary and auxiliary entity that writes per-locale rows, reports a non-browser-stored entity, a block for an undeclared or default locale, a missing default `instances` block and a missing block for a declared non-default locale, each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint entity-locale-instances: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-locale-instances"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LocaleValue = string | number | boolean | [LocaleValue?] | Map string LocaleValue?
type LocaleField = { name : string, required : boolean, default : LocaleValue }
type LocaleRow = Map string LocaleValue?
type LocaleEntity = { name : string, browser : boolean, fields : [LocaleField], instances : [LocaleRow], localeInstances : Map string [LocaleRow] }
type LocaleEntityRef = LocaleEntity | string
type LocaleOrbital = { entity : LocaleEntityRef, auxiliaryEntities : [LocaleEntityRef], spec : boolean }
type LocaleProgram = { orbitals : [LocaleOrbital]!, locales : [string] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEntityLocaleInstancesCodes = { eLocaleInstancesNotLocal : LintCodeDecl , eLocaleInstancesUnknownLocale : LintCodeDecl , eLocaleInstancesIncomplete : LintCodeDecl , eInstanceInvalid : LintCodeDecl }

orbital OrbLintEntityLocaleInstancesOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityLocaleInstancesRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityLocaleInstances -> OrbLintEntityLocaleInstancesRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])) (decl (object/get @payload.program "locales" [])))
          (let ((ents (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((aux (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
                    (array/concat
                      (let ((e0 (object/get (array/nth @orbitals @oi) "entity" {}))) (if (validate/object @e0) [{ pth: (str/concat "orbitals[" @oi "].entity"), ee: @e0, sp: (object/get (array/nth @orbitals @oi) "spec" false) }] []))
                      (array/flatten (array/map (array/range 0 (array/len @aux)) (fn ai (let ((ea (array/nth @aux @ai))) (if (validate/object @ea) [{ pth: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]"), ee: @ea, sp: (object/get (array/nth @orbitals @oi) "spec" false) }] []))))))))))))
            (let ((jobs (array/flatten (array/map @ents (fn it
                    (array/concat (if (object/get @it "sp") [] [{ ee: (object/get @it "ee"), rows: (object/get (object/get @it "ee") "instances" []), rp: (str/concat (object/get @it "pth") ".instances") }])
                      (array/map (object/keys (object/get (object/get @it "ee") "localeInstances" {})) (fn k { ee: (object/get @it "ee"), rows: (object/get (object/get (object/get @it "ee") "localeInstances") @k), rp: (str/concat (object/get @it "pth") ".localeInstances." @k) }))))))))
              (array/concat
                (array/flatten (array/map @ents (fn it
                  (let ((ee (object/get @it "ee")))
                    (let ((pth (object/get @it "pth")) (nm (object/get @ee "name" "")) (blocks (object/get @ee "localeInstances" {})) (dflt (if (> (array/len @decl) 0) (array/first @decl) "")))
                      (let ((keys (object/keys @blocks)) (bp (str/concat @pth ".localeInstances")))
                        (if (= (array/len @keys) 0)
                          []
                          (array/flatten [
                                (if (object/get @ee "browser" false) [] [{ code: @config.codes.eLocaleInstancesNotLocal.code, path: @bp, message: (str/concat "Entity '" @nm "' writes rows per locale but its rows are not browser-stored; a server's rows are shared by every viewer"), suggestion: "Add `browser` (`[persistent: <collection>, browser]`) or keep one `instances` block.", severity: "error" }])
                                (array/flatten (array/map (array/filter @keys (fn k (or (not (array/includes @decl @k)) (and (> (array/len @decl) 0) (= @k @dflt))))) (fn k
                                  [{ code: @config.codes.eLocaleInstancesUnknownLocale.code, path: (str/concat @bp "." @k), message: (if (and (> (array/len @decl) 0) (= @k @dflt))
                                      (str/concat "Entity '" @nm "' writes `instances " @k "`, but '" @k "' is the default locale: its rows are the plain `instances` block")
                                      (str/concat "Entity '" @nm "' writes `instances " @k "`, but the app declares locales [" (str/join (array/map @decl (fn d (json/stringify @d))) ", ") "]")), suggestion: "Write one block per declared locale other than the first; declare the locale in the app's `locales [ … ]`.", severity: "error" }])))
                                (if (> (array/len (object/get @ee "instances" [])) 0) [] [{ code: @config.codes.eLocaleInstancesIncomplete.code, path: (str/concat @pth ".instances"), message: (str/concat "Entity '" @nm "' writes rows per locale but no default `instances` block for its default locale"), suggestion: "Add `instances [ … ]` with the default locale's rows.", severity: "error" }])
                                (array/map (array/filter (array/drop @decl 1) (fn l (not (array/includes @keys @l)))) (fn l
                                  { code: @config.codes.eLocaleInstancesIncomplete.code, path: @bp, message: (str/concat "Entity '" @nm "' writes rows per locale but has no `instances " @l "` block"), suggestion: "Write a block for every declared locale once any is written.", severity: "error" }))]))))))))
                (array/flatten (array/map @jobs (fn jb
                  (let ((ee (object/get @jb "ee")) (rows (object/get @jb "rows")) (rp (object/get @jb "rp")))
                (array/flatten (array/map (array/range 0 (array/len @rows)) (fn i
                  (let ((row (array/nth @rows @i)) (rpi (str/concat @rp "[" @i "]")) (nm (object/get @ee "name" "")) (fields (object/get @ee "fields" [])))
                    (array/concat
                      (array/map (array/filter (object/keys @row) (fn key (not (array/some @fields (fn fd (= (object/get @fd "name" null) @key)))))) (fn key
                        { code: @config.codes.eInstanceInvalid.code, path: (str/concat @rpi "." @key), message: (str/concat "Row " @i " of '" @nm "' sets '" @key "', which is not a field of the entity"), suggestion: "", severity: "error" }))
                      (array/map (array/filter @fields (fn fd (and (object/get @fd "required" false) (not (object/has @fd "default")) (validate/string (object/get @fd "name" null)) (not (object/has @row (object/get @fd "name")))))) (fn fd
                        { code: @config.codes.eInstanceInvalid.code, path: @rpi, message: (str/concat "Row " @i " of '" @nm "' is missing required field '" (object/get @fd "name") "'"), suggestion: "", severity: "error" }))
                      (if (and (object/get @ee "browser" false) (not (object/has @row "id")))
                        [{ code: @config.codes.eInstanceInvalid.code, path: @rpi, message: (str/concat "Row " @i " of browser-stored '" @nm "' has no `id` — seeded rows need stable ids across reloads"), suggestion: "Give every written-out row an `id`.", severity: "error" }]
                        [])))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-locale-instances", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LocaleProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEntityLocaleInstancesCodes = { eLocaleInstancesNotLocal: { code: "ORB_E_LOCALE_INSTANCES_NOT_LOCAL", category: "entity", description: "An entity writes rows per locale but its rows are not browser-stored, so every viewer shares them" }, eLocaleInstancesUnknownLocale: { code: "ORB_E_LOCALE_INSTANCES_UNKNOWN_LOCALE", category: "entity", description: "An entity writes locale instances for a locale that is not among the declared locales" }, eLocaleInstancesIncomplete: { code: "ORB_E_LOCALE_INSTANCES_INCOMPLETE", category: "entity", description: "An entity writes rows per locale but has no default instances block for its default locale" }, eInstanceInvalid: { code: "ORB_E_INSTANCE_INVALID", category: "entity", description: "An entity instance row sets a key that is not a field of the entity" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEntityLocaleInstancesCli -> OrbLintEntityLocaleInstancesRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint entity-locale-instances: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-locale-instances <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-locale-instances") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-locale-instances: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-locale-instances") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-locale-instances: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-locale-instances" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-locale-instances` with its arguments and working directory."
        @synonyms "orb lint entity-locale-instances, per-locale instances"
      OrbLintEntityLocaleInstances.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityLocaleInstancesCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityLocaleInstancesOrbitalStart -> OrbLintEntityLocaleInstances, OrbLintEntityLocaleInstancesCli, OrbLintInput, Packs, Versions
}
