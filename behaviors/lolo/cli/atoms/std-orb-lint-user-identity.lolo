app std-orb-lint-user-identity [
  version: "1.0.0",
  inbound: ["cli-lint-user-identity"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-user-identity — the `orb lint user-identity <file>` command, the port of user_identity.rs (validate_user_identity). It lowers the file with program/read and reports a literal compared against a closed-vocabulary `@user.<field>` of the [identity] entity (or of the orbital's own `expects entity [identity] { shape }`) that is not a declared member, through =, ==, !=, !==, eq, neq and array/includes with a list, bare or field haystack, in every inline trait (ORB_S_ROLE_LITERAL_NOT_MEMBER, at the Rust trait path), a page nav role no role field of the [identity] entity declares (same code, at orbitals[i].pages[k].roles) (status 500, exit 1). Not ported: the `@user.<field>` existence checks (ORB_S_UNKNOWN_IDENTITY_FIELD, ORB_S_EXPECTATION_FIELD_UNDECLARED), which need the installed language's Viewer members, and the role literals of config-held role lists (check_config_role_lists), which need the compiler's role_list_sites dataflow. Clean answers `lint user-identity: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-user-identity"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type UidShape = string | number | boolean | [UidShape?] | Map string UidShape?
type UidItems = { values : [string] }
type UidField = { name : string, type : string, required : boolean, values : [string], items : UidItems }
type UidEntRow = { name : string!, identity : boolean, auxiliary : boolean!, fields : [UidField] }
type UidEntity = { name : string, identity : boolean, fields : [UidField] }
type UidEntityRef = UidEntity | string
type UidExpect = { kind : string, name : string, shape : [UidField] }
type UidPage = { path : string, roles : [string] }
type UidPageRef = UidPage | string
type UidEmit = { event : string, payloadSchema : [UidField] }
type UidTransition = { guard : UidShape, effects : [UidShape] }
type UidMachine = { transitions : [UidTransition] }
type UidTrait = { name : string, emits : [UidEmit], stateMachine : UidMachine, sourceBehavior : UidShape }
type UidOrbital = { name : string, expects : [UidExpect], entity : UidEntityRef, auxiliaryEntities : [UidEntity], traits : [UidTrait], pages : [UidPageRef] }
type UidProgram = { orbitals : [UidOrbital] }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintUserIdentityCodes = { lintIndexMissing : LintCodeDecl , sRoleLiteralNotMember : LintCodeDecl , sUserIdEmptyComparison : LintCodeDecl }

orbital OrbLintUserIdentityOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintUserIdentityRun [runtime] {
    indexHeard : boolean = false
    indexScope : string = ""
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    roots : Map string [string] = {}
    declList : [UidEntRow] = []
    entsHeard : boolean = false
    entsScope : string = ""
  }

  trait OrbLintUserIdentity -> OrbLintUserIdentityRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
        (set @entity.indexHeard true)
        (set @entity.indexScope @payload.scope)
      ENTITIES_HEARD -> ready
        (set @entity.declList (let ((p (array/filter @payload.list (fn r (and (not (object/get @r "auxiliary")) (object/get @r "identity" false)))))) (if (> (array/len @p) 0) (array/take @p 1) (array/take (array/filter @payload.list (fn r (and (object/get @r "auxiliary") (object/get @r "identity" false)))) 1))))
        (set @entity.entsHeard true)
        (set @entity.entsScope @payload.scope)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.indexHeard (= @entity.indexScope @payload.scope) @entity.entsHeard (= @entity.entsScope @payload.scope))
(let ((nov : [string] []) (nof : [OrbFinding] []) (orbs (object/get @payload.program "orbitals" [])))
 
  
   (let ((declList @entity.declList))
    (array/concat (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
 (let ((orb (array/nth @orbs @oi)))
  (let ((exps (array/filter (object/get @orb "expects" []) (fn e (= (let ((s24 (object/get @e "kind" ""))) (if (validate/string @s24) @s24 "")) "identity"))))
        (trlist (object/get @orb "traits" [])))
   (let ((hasExp (> (array/len @exps) 0)))
    (let ((exp0 (array/take @exps 1)))
     (let ((envs (array/concat
                    (array/flatten (array/map @declList (fn declared [{ f: (object/get @declared "fields" []), nm: (object/get @declared "name" ""), skip: false }])))
                    (array/flatten (array/map (array/filter @exp0 (fn e (object/has @e "shape"))) (fn exp [{ f: (object/get @exp "shape" []), nm: (let ((nmx (object/get @exp "name" null))) (if (validate/string @nmx) @nmx (quote "@user"))), skip: true }]))))))
        (array/flatten (array/map @envs (fn env
         (let ((idF (object/get @env "f")) (idNm (object/get @env "nm")) (skip (object/get @env "skip")))
          (array/flatten (array/map (array/range 0 (array/len @trlist)) (fn ti
           (let ((td (array/nth @trlist @ti)))
            (if (and (validate/object @td) (validate/object (object/get @td "stateMachine" null)) (not (and @skip (object/has @td "sourceBehavior"))))
             (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (let ((s25 (object/get @td "name" ""))) (if (validate/string @s25) @s25 "")) ")]"))
                   (hs (tree/fold (if (array/includes (object/get @entity.roots (str/concat @oi "-" @ti) []) (quote "@user")) @td {}) (fn (n k) (if (or (validate/array @n) (validate/object @n)) 
 (if (validate/array @n)
  (let ((len (array/len @n)) (op (let ((o0 (if (> (array/len @n) 0) (array/nth @n 0) ""))) (if (validate/string @o0) @o0 ""))))
   (array/concat
    (array/concat (if (and (= @len 3) (not (object/has @td "sourceBehavior")) (or (= @op "=") (= @op "==") (= @op "!=")))
 (let ((ua (array/nth @n 1)) (ub (array/nth @n 2)))
  (if (or (and (= @ua (quote "@user.id")) (= @ub "")) (and (= @ua "") (= @ub (quote "@user.id"))))
   [{ rel: "", kind: "uid-empty", a: @op, b: "", vv: @nov }]
   []))
 [])
    (if (and (>= @len 3) (or (= @op "=") (= @op "==") (= @op "!=") (= @op "!==") (= @op "eq") (= @op "neq") (= @op "array/includes")))
 (let ((args (array/slice @n 1)) (incl (= @op "array/includes")))
  (let ((a0 (array/nth @args 0)) (a1 (array/nth @args 1)))
   (let ((first0 (not (= (if (and (validate/string @a0) (str/startsWith @a0 (quote "@user.")) (> (str/len @a0) 6) (not (str/includes (str/slice @a0 6) ".")) (not (str/includes (str/slice @a0 6) "["))) (str/slice @a0 6) "") ""))))
    (let ((sigilSide (if @incl (if @first0 [@a0] [@a1]) @args))
          (litSide (if @incl (if @first0 [@a1] [@a0]) @args)))
     (let ((sns (array/flatten (array/map @sigilSide (fn a (let ((nm (if (and (validate/string @a) (str/startsWith @a (quote "@user.")) (> (str/len @a) 6) (not (str/includes (str/slice @a 6) ".")) (not (str/includes (str/slice @a 6) "["))) (str/slice @a 6) ""))) (if (and (not (= @nm "")) (> (array/len (array/filter @idF (fn fd (= (object/get @fd "name" "") @nm)))) 0)) [@nm] [])))))))
      (if (= (array/len @sns) 0) []
       (let ((sn (array/first @sns)))
        (let ((vocab (let ((vf (array/filter @idF (fn fd (= (object/get @fd "name" "") @sn)))))
 (array/flatten (array/map (array/take @vf 1) (fn fd0 (if (> (array/len (object/get @fd0 "values" @nov)) 0) (object/get @fd0 "values" @nov) (let ((it (object/get @fd0 "items" null))) (if (= @it null) @nov (object/get @it "values" @nov))))))))))
         (if (= (array/len @vocab) 0) []
          (let ((lits (if @incl
                       (let ((lit0 (array/first @litSide)))
                        (if (validate/array @lit0)
                         (let ((mem (if (= (if (validate/string (array/nth @lit0 0)) (array/nth @lit0 0) "") "list") (array/slice @lit0 1) @lit0)))
                          (if (array/every @mem (fn m (validate/string @m))) @mem []))
                         [@lit0]))
                       @args)))
           (array/map (array/filter @lits (fn a (and (validate/string @a) (not (str/startsWith @a (quote "@"))) (not (array/includes @vocab @a)) (not (and (= @sn "role") (= @a @config.anonymousRole)))))) (fn a { rel: "", kind: "role", a: (if (validate/string @a) @a ""), b: @sn, vv: @vocab }))))))))))))
 []))
    (array/flatten (array/map (array/range 0 (array/len @n)) (fn i (let ((r (array/nth @k @i))) (if (validate/array @r) (array/map @r (fn h { rel: (str/concat "[" @i "]" (let ((s15 (object/get @h "rel" ""))) (if (validate/string @s15) @s15 ""))), kind: (let ((s16 (object/get @h "kind" ""))) (if (validate/string @s16) @s16 "")), a: (let ((s17 (object/get @h "a" ""))) (if (validate/string @s17) @s17 "")), b: (let ((s18 (object/get @h "b" ""))) (if (validate/string @s18) @s18 "")), vv: (let ((v0 (object/get @h "vv" @nov))) (if (validate/array @v0) (array/map @v0 (fn x (if (validate/string @x) @x ""))) @nov)) })) [])))))))
  (if (validate/object @n)
   (array/flatten (array/map (array/filter (object/keys @k) (fn key (not (= @key "sourceEntityDefinition")))) (fn key (let ((r (object/get @k @key))) (if (validate/array @r) (array/map @r (fn h { rel: (str/concat "." @key (let ((s19 (object/get @h "rel" ""))) (if (validate/string @s19) @s19 ""))), kind: (let ((s20 (object/get @h "kind" ""))) (if (validate/string @s20) @s20 "")), a: (let ((s21 (object/get @h "a" ""))) (if (validate/string @s21) @s21 "")), b: (let ((s22 (object/get @h "b" ""))) (if (validate/string @s22) @s22 "")), vv: (let ((v0 (object/get @h "vv" @nov))) (if (validate/array @v0) (array/map @v0 (fn x (if (validate/string @x) @x ""))) @nov)) })) [])))))
   [])) [])) UidShape)))
              (if (validate/array @hs)
               (array/flatten (array/map @hs (fn h (let ((kind (let ((s27 (object/get @h "kind" ""))) (if (validate/string @s27) @s27 ""))) (a (let ((s28 (object/get @h "a" ""))) (if (validate/string @s28) @s28 ""))) (b (let ((s29 (object/get @h "b" ""))) (if (validate/string @s29) @s29 ""))) (vv (let ((v0 (object/get @h "vv" @nov))) (if (validate/array @v0) (array/map @v0 (fn x (if (validate/string @x) @x ""))) @nov))))
 (if (= @kind "uid-empty")
  [{ code: @config.codes.sUserIdEmptyComparison.code, path: (str/concat @tp (let ((s26 (object/get @h "rel" ""))) (if (validate/string @s26) @s26 ""))), message: (str/concat "'@user.id' is never empty: the anonymous viewer's id is \"anonymous\" (EXEC-IDENTITY-1), so this comparison is always " (if (= @a "!=") "true" "false")), suggestion: "Test the role instead: (!= @user.role \"anonymous\") for a signed-in viewer", severity: "error" }]
 (if (= @kind "role")
  [{ code: @config.codes.sRoleLiteralNotMember.code, path: (str/concat @tp (let ((s26 (object/get @h "rel" ""))) (if (validate/string @s26) @s26 ""))), message: (str/concat "\"" @a "\" is not a declared value of `@user." @b "` on the [identity] entity `" @idNm "`. This comparison can never be true — the branch is dead."), suggestion: (if (= @a "") "An empty string is not a role: to test that someone is signed in, compare the role instead, `(!= @user.role \"anonymous\")`." (str/concat "Use one of: " (str/join @vv ", ") ", or add \"" @a "\" to `" @idNm "." @b "`.")), severity: "error", validValues: @vv }]
  []))))))
               @nof))
             @nof)))))))))))))))))  (array/flatten (array/map @declList (fn declared
 (let ((idF (object/get @declared "fields" [])) (idnm (object/get @declared "name" "")))
  (let ((rf (array/flatten (array/map @idF (fn fd (if (object/has @fd "name") (let ((nmv (object/get @fd "name" ""))) (let ((vc (let ((vf (array/filter @idF (fn fd (= (object/get @fd "name" "") @nmv)))))
 (array/flatten (array/map (array/take @vf 1) (fn fd0 (if (> (array/len (object/get @fd0 "values" @nov)) 0) (object/get @fd0 "values" @nov) (let ((it (object/get @fd0 "items" null))) (if (= @it null) @nov (object/get @it "values" @nov)))))))))) (if (> (array/len @vc) 0) [{ name: @nmv, vocab: @vc }] []))) []))))))
   (if (= (array/len @rf) 0) @nof
    (array/flatten (array/map (array/take @rf 1) (fn first0
     (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
      (let ((pgs (object/get (array/nth @orbs @oi) "pages" [])))
       (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn k
        (let ((pg (array/nth @pgs @k)))
         (if (validate/object @pg)
          (array/flatten (array/map (array/filter (object/get @pg "roles" []) (fn role (not (array/some @rf (fn r (array/includes (object/get @r "vocab") @role)))))) (fn role
           [{ code: @config.codes.sRoleLiteralNotMember.code, path: (str/concat "orbitals[" @oi "].pages[" @k "].roles"), message: (str/concat "Page \"" (object/get @pg "path" "") "\" lists role \"" @role "\" for its nav entry, but no role field of the [identity] entity `" @idnm "` declares it, so no viewer ever sees the entry."), suggestion: (str/concat "Use one of: " (str/join (object/get @first0 "vocab") ", ") ", or add \"" @role "\" to `" @idnm "." (object/get @first0 "name" "") "`."), severity: "error", validValues: (object/get @first0 "vocab") }])))
          @nof)))))))))))))))))) )))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without LINT_INDEX or LINT_ENTITIES, so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_INDEX and LINT_ENTITIES before LINT_INPUT; this rule did not hear both", severity: "error" }]))
        (set @entity.indexHeard false)
        (set @entity.entsHeard false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "user-identity", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : UidProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait and transition effect list uses; a trait gates on its roots holding @user."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      ENTITIES_HEARD { scope : string!  list : [UidEntRow]!  primaryDuplicates : [string]! }
        @description "std-orb-lint-input's LINT_ENTITIES: every entity in program order, with its identity flag and fields."
      OrbLintInput.LINT_ENTITIES -> ENTITIES_HEARD
    }
    config {
      anonymousRole : string = "anonymous"
        @label "Anonymous role"
        @description "The role the kernel gives a session with no identity (EXEC-IDENTITY-1). It is a value of @user.role in every program, whatever roles the identity entity declares."
      codes : LintUserIdentityCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, sRoleLiteralNotMember: { code: "ORB_S_ROLE_LITERAL_NOT_MEMBER", category: "schema", description: "A literal compared against an @user field with a closed vocabulary is not a member of that vocabulary, so the branch can never be taken" }, sUserIdEmptyComparison: { code: "ORB_S_USER_ID_EMPTY_COMPARISON", category: "schema", description: "A comparison of @user.id with the empty string, which is never true of a viewer: the anonymous viewer's id is \"anonymous\", so the comparison is constant" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintUserIdentityCli -> OrbLintUserIdentityRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint user-identity <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint user-identity <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint user-identity <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "user-identity") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint user-identity: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "user-identity") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint user-identity: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-user-identity" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint user-identity` with its arguments and working directory."
        @synonyms "orb lint user-identity, orb lint user-identity, user identity"
      OrbLintUserIdentity.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintUserIdentityCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintUserIdentityOrbitalStart -> OrbLintUserIdentity, OrbLintUserIdentityCli, OrbLintInput, Packs, Versions
}
