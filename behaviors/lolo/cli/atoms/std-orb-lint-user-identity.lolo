        (trlist (object/get @orb "traits" [])))
   (let ((hasExp (> (array/len @exps) 0)))
    (let ((exp (array/first @exps)))
     (let ((hasShape (and @hasExp (object/has @exp "shape"))))
      (let ((expNm (if (object/has @exp "name") (object/get @exp "name" "") (quote "@user"))))
