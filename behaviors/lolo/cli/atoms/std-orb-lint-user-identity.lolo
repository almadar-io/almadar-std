 (if (validate/array @m)
  (let ((ln (array/len @m)) (o (let ((o0 (if (> (array/len @m) 0) (array/nth @m 0) ""))) (if (validate/string @o0) @o0 ""))))
   (if (and (= @o "!=") (= @ln 3)) (or (and (and (validate/string (array/nth @m 1)) (= (array/nth @m 1) (quote "@user"))) (= (array/nth @m 2) null)) (and (and (validate/string (array/nth @m 2)) (= (array/nth @m 2) (quote "@user"))) (= (array/nth @m 1) null)))
    (if (and (= @o "not") (>= @ln 2))
     (let ((inner (array/nth @m 1))) (and (validate/array @inner) (= (array/len @inner) 3) (= (if (validate/string (array/nth @inner 0)) (array/nth @inner 0) "") "=") (or (and (and (validate/string (array/nth @inner 1)) (= (array/nth @inner 1) (quote "@user"))) (= (array/nth @inner 2) null)) (and (and (validate/string (array/nth @inner 2)) (= (array/nth @inner 2) (quote "@user"))) (= (array/nth @inner 1) null)))))
     (if (= @o "and") (array/some @j (fn r (if (validate/boolean @r) @r false))) false))))
  false)) UidShape))) (if (validate/boolean @p) @p false)) @nos (array/nth @kids 2)) (array/flatten (array/slice @kids 3)))
     (array/concat
      (array/concat
