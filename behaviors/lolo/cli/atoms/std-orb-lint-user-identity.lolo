app std-orb-lint-user-identity [
  version: "1.0.0",
  inbound: ["cli-lint-user-identity"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-user-identity — the `orb lint user-identity <file>` command, the port of user_identity.rs (validate_user_identity and validate_user_into_required_slot). It lowers the file with program/read and reports a literal compared against a closed-vocabulary `@user.<field>` of the [identity] entity (or of the orbital's own `expects entity [identity] { shape }`) that is not a declared member, through =, ==, !=, !==, eq, neq and array/includes with a list, bare or field haystack, in every inline trait (ORB_S_ROLE_LITERAL_NOT_MEMBER, at the Rust trait path), a page nav role no role field of the [identity] entity declares (same code, at orbitals[i].pages[k].roles), and the whole `@user` filling a required emit payload field or required entity field with no presence guard (ORB_USER_INTO_REQUIRED_SLOT), with the Rust path, message and suggestion (status 500, exit 1). Not ported: the `@user.<field>` existence checks (ORB_S_UNKNOWN_IDENTITY_FIELD, ORB_S_EXPECTATION_FIELD_UNDECLARED), which need the installed language's Viewer members, and the role literals of config-held role lists (check_config_role_lists), which need the compiler's role_list_sites dataflow. Clean answers `lint user-identity: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-user-identity"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type UidShape = string | number | boolean | [UidShape?] | Map string UidShape?
type UidSlot = { a : string }
type UidItems = { values : [string] }
type UidField = { name : string, type : string, required : boolean, values : [string], items : UidItems }
type UidEntity = { name : string, identity : boolean, fields : [UidField] }
type UidEntityRef = UidEntity | string
type UidExpect = { kind : string, name : string, shape : [UidField] }
type UidPage = { path : string, roles : [string] }
type UidPageRef = UidPage | string
type UidEmit = { event : string, payloadSchema : [UidField] }
type UidTransition = { guard : UidShape, effects : [UidShape] }
type UidMachine = { transitions : [UidTransition] }
type UidTrait = { name : string, emits : [UidEmit], stateMachine : UidMachine, sourceBehavior : UidShape }
type UidOrbital = { name : string, expects : [UidExpect], entity : UidEntityRef, auxiliaryEntities : [UidEntity], traits : [UidTrait], pages : [UidPageRef] }
type UidProgram = { orbitals : [UidOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintUserIdentityOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintUserIdentityRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    roots : Map string [string] = {}
  }

