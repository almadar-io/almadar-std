 (let ((ents (array/flatten (array/map @orbs (fn o (array/flatten (array/map (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn xe (if (validate/object @xe) [@xe] []))))))))
       (primIds (array/flatten (array/map @orbs (fn o (let ((e0 (object/get @o "entity" {}))) (if (and (validate/object @e0) (object/get @e0 "identity" false)) [@e0] []))))))
       (auxIds (array/flatten (array/map @orbs (fn o (array/filter (array/flatten (array/map (object/get @o "auxiliaryEntities" []) (fn xe (if (validate/object @xe) [@xe] [])))) (fn e (object/get @e "identity" false))))))))
  (let ((hasDecl (or (> (array/len @primIds) 0) (> (array/len @auxIds) 0))))
