app std-orb-lint-filter-field-never-written [
  version: "1.0.0",
  inbound: ["cli-lint-filter-field-never-written"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-filter-field-never-written — the `orb lint filter-field-never-written <file>` command, the port of ORB_X_FILTER_FIELD_NEVER_WRITTEN (circuit/cross_orbital/filter_field_written.rs). A fetch in a client-bound trait (a trait a route page mounts, plus its @trait embed closure) whose filter reads a literal (object/get @entity <field>) that no persist create/update/upsert (a single op or a statically readable persist batch) of the fetched entity or a persistent-collection mate ever supplies. An [identity] entity, an unresolved entity, an @intrinsic field, a declared field of an entity nothing in the program creates, and a declared field with a default stay silent; a default only exempts when an equality comparand is undecidable or folds to the default, a comparand folding as a literal or an @config.<knob> default and anything else as undecidable. The program is the resolved program the lint input reads. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint filter-field-never-written: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-filter-field-never-written"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type LObj = Map string LNode?
type FfField = { name : string, default : LNode?, intrinsic : boolean }
type FfEntity = { name : string, collection : string, identity : boolean, fields : [FfField] }
type FfTransition = { guard : LNode?, effects : [LNode?] }
type FfMachine = { transitions : [FfTransition] }
type FfKnob = { default : LNode? }
type FfTrait = { name : string, stateMachine : FfMachine, ticks : [FfTransition], config : Map string FfKnob? }
type FfPageTrait = { ref : string, name : string }
type FfPage = { protocol : string, traits : [FfPageTrait] }
type FfOrbital = { name : string, entity : FfEntity, auxiliaryEntities : [FfEntity], traits : [FfTrait], pages : [FfPage] }
type FfProgram = { orbitals : [FfOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintFilterFieldNeverWrittenCodes = { xFilterFieldNeverWritten : LintCodeDecl }

orbital OrbLintFilterFieldNeverWrittenOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintFilterFieldNeverWrittenRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    heads : Map string [string] = {}
    roots : Map string [string] = {}
  }

  trait OrbLintFilterFieldNeverWritten -> OrbLintFilterFieldNeverWrittenRun [optimistic] {
    initial: ready

    state ready {
