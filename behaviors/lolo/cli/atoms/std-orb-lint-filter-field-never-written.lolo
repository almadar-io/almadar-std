      INDEX_HEARD -> ready
        (set @entity.heads @payload.heads)
        (set @entity.roots @payload.roots)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbs (object/get @payload.program "orbitals" [])))
 (let ((ents (array/filter (array/flatten (array/map @orbs (fn o (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])))))  (fn e (!= (object/get @e "name" "") "")))))
  (let ((defs (object/fromEntries (array/map @ents (fn e [(object/get @e "name"), @e]))))
