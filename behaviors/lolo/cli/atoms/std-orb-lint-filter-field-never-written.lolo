   (let ((colOf (object/fromEntries (array/map (array/filter @ents (fn e (!= (object/get @e "collection" "") ""))) (fn e [(object/get @e "name"), (object/get @e "collection")]))))
         (mates (object/fromEntries (array/map (array/unique (array/map (array/filter @ents (fn e (!= (object/get @e "collection" "") ""))) (fn e (object/get @e "collection")))) (fn c [@c, (array/map (array/filter @ents (fn e (= (object/get @e "collection" "") @c))) (fn e (object/get @e "name")))])))))
    (let ((ws (array/map (array/flatten (array/map (array/unique (array/flatten (array/map @orbs (fn o (array/flatten (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t (array/flatten (array/map (object/get (object/get @t "stateMachine") "transitions" []) (fn x (array/filter (object/get @x "effects" []) (fn e (validate/array @e))))))))))))) (fn eff (array/flatten (array/map (let ((src @eff)) (if (tree/fold @src (fn (hn hk) (if (validate/string @hn) (= @hn "persist") (if (validate/array @hk) (array/includes @hk true) (array/some (object/keys @hk) (fn hq (= (object/get @hk @hq) true)))))) LNode) (let ((nn (as (json/nodes @eff) LNodes))) (if (= @nn null) [] @nn)) [])) (fn n (let ((l (default (as @n LNodes) [])))
      (let ((h (default (as (if (> (array/len @l) 0) (array/nth @l 0) null) LStr) "")) (a1 (default (as (if (> (array/len @l) 1) (array/nth @l 1) null) LStr) "")))
        (if (or (!= @h "persist") (= @a1 "")) []
          (if (= @a1 "batch")
            (let ((ops (default (as (if (> (array/len @l) 2) (array/nth @l 2) null) LNodes) [])))(array/flatten (array/map (array/filter (array/map (if (= (array/len @ops) 0) []
        (if (!= (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) null)
          (if (= (default (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) "") "list") (array/drop @ops 1)
            (if (and (= (default (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) "") "array/map") (= (array/len @ops) 3))
              (let ((fl (default (as (array/nth @ops 2) LNodes) []))) (if (and (> (array/len @fl) 2) (array/includes ["fn"] (default (as (if (> (array/len @fl) 0) (array/nth @fl 0) null) LStr) ""))) [(array/last @fl)] []))
              []))
          @ops)) (fn el (default (as @el LNodes) []))) (fn tp (and (> (array/len @tp) 0) (array/includes ["create", "update", "delete"] (default (as (if (> (array/len @tp) 0) (array/nth @tp 0) null) LStr) "")))))
        (fn tp (let ((a (default (as (if (> (array/len @tp) 0) (array/nth @tp 0) null) LStr) "")) (en (default (as (if (> (array/len @tp) 1) (array/nth @tp 1) null) LStr) "")))
          (if (or (= @a "delete") (= @en "") (str/startsWith @en (str/concat (quote "@") ""))) []
            (let ((dp (if (= @a "create") 2 3)))
              [{ a: @a, e: @en, has: (> (array/len @tp) @dp), d: (as (if (> (array/len @tp) @dp) (array/nth @tp @dp) null) LObj) }])))))))
            (let ((e2 (default (as (if (> (array/len @l) 2) (array/nth @l 2) null) LStr) "")))
              (if (and (!= @e2 "") (array/includes ["create", "upsert", "update"] @a1))
                [{ a: @a1, e: @e2, has: (> (array/len @l) 3), d: (as (if (> (array/len @l) 3) (array/nth @l 3) null) LObj) }]
                []))))))))))))
   (fn w (let ((def (object/get @defs (object/get @w "e") null)) (dobj (object/get @w "d" null)))
     { e: (object/get @w "e"), c: (array/includes ["create", "upsert"] (object/get @w "a")),
       any: (and (object/get @w "has") (= @dobj null) (= @def null)),
       k: (if (not (object/get @w "has")) [] (if (!= @dobj null) (object/keys @dobj) (if (= @def null) [] (array/filter (array/map (object/get @def "fields" []) (fn f (object/get @f "name" ""))) (fn s (!= @s ""))))))})))))
     (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
      (let ((o (array/nth @orbs @oi)))
       (let ((trs0 (object/get @o "traits" [])))
       (let ((inlK (array/filter (array/range 0 (array/len @trs0)) (fn i (object/has (array/nth @trs0 @i) "stateMachine")))))
       (let ((inl (array/map @inlK (fn i (array/nth @trs0 @i)))))
       (let ((kids (array/map (array/range 0 (array/len @inl)) (fn kx (let ((t (array/nth @inl @kx)) (tix (str/concat @oi "-" (array/nth @inlK @kx)))) { n: (object/get @t "name" ""), ch: (array/unique (array/filter (array/map (array/concat (if (array/includes (object/get @entity.roots @tix []) (quote "@trait")) (let ((nn (as (json/nodes (array/map (object/values (object/get @t "config" {})) (fn f (object/get (default @f {}) "default" null)))) LNodes))) (if (= @nn null) [] @nn)) []) (array/concat (if (array/includes (object/get @entity.roots @tix []) (quote "@trait")) (let ((nn (as (json/nodes (array/map (object/get (object/get @t "stateMachine") "transitions" []) (fn x [(object/get @x "guard" null), (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r))))]))) LNodes))) (if (= @nn null) [] @nn)) []) (if (array/includes (object/get @entity.roots @tix []) (quote "@trait")) (let ((nn (as (json/nodes (array/map (object/get @t "ticks" []) (fn x [(object/get @x "guard" null), (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r))))]))) LNodes))) (if (= @nn null) [] @nn)) []))) (fn n (let ((s (default (as @n LStr) ""))) (if (str/startsWith @s (str/concat (quote "@") "trait.")) (array/first (str/split (array/first (str/split (str/slice @s 7 (str/len @s)) ".")) "[")) "")))) (fn c (and (!= @c "") (!= @c (object/get @t "name" "")))))) })))))
        (let ((seeds (array/flatten (array/map (array/filter (object/get @o "pages" []) (fn p (= (object/get @p "protocol" "") ""))) (fn p (array/map (object/get @p "traits" []) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" ""))))))))) 
         (let ((bound (array/reduce (array/range 0 (+ (array/len @inl) 1)) (array/unique @seeds) (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map (array/filter @kids (fn k (array/includes @acc (object/get @k "n")))) (fn k (object/get @k "ch")))))))))) 
          (array/flatten (array/map (array/filter (array/range 0 (array/len @inl)) (fn kx (array/includes @bound (object/get (array/nth @inl @kx) "name" ""))))
           (fn kx (let ((t (array/nth @inl @kx)) (tix (str/concat @oi "-" (array/nth @inlK @kx)))) (let ((tn (object/get @t "name" "")) (trs (object/get (object/get @t "stateMachine") "transitions" [])))
            (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
             (let ((effs (array/filter (object/get (array/nth @trs @ti) "effects" []) (fn e (validate/array @e)))))
              (array/flatten (array/map (array/flatten (array/map (if (array/includes (object/get @entity.heads (str/concat @tix "-" @ti) []) "fetch") (let ((nn (as (json/nodes @effs) LNodes))) (if (= @nn null) [] @nn)) [])
  (fn n (let ((l (default (as @n LNodes) [])))
    (let ((fe (default (as (if (> (array/len @l) 1) (array/nth @l 1) null) LStr) "")) (opts (as (if (> (array/len @l) 2) (array/nth @l 2) null) LObj)))
      (if (and (= (default (as (if (> (array/len @l) 0) (array/nth @l 0) null) LStr) "") "fetch") (!= @fe "") (!= @opts null) (object/has @opts "filter")) [{ ent: @fe, nodes: (let ((nn (as (json/nodes (object/get @opts "filter")) LNodes))) (if (= @nn null) [] @nn)) }] []))))))
               (fn fe (let ((fent (object/get @fe "ent")) (fnodes (object/get @fe "nodes")))
                (let ((edef (object/get @defs @fent null)))
                 (if (or (array/includes @ids @fent) (= @edef null)) []
                  (let ((fam (array/concat [@fent] (let ((cn (object/get @colOf @fent ""))) (if (= @cn "") [] (array/filter (object/get @mates @cn []) (fn m (!= @m @fent))))))))
                   (let ((hasCreator (array/some @ws (fn w (and (object/get @w "c") (array/includes @fam (object/get @w "e")))))))
                    (array/flatten (array/map (array/unique (array/flatten (array/map @fnodes
  (fn n (let ((q (default (as @n LNodes) [])))
    (let ((f (default (as (if (> (array/len @q) 2) (array/nth @q 2) null) LStr) "")))
      (if (and (= (array/len @q) 3) (= (default (as (if (> (array/len @q) 0) (array/nth @q 0) null) LStr) "") "object/get") (= (default (as (if (> (array/len @q) 1) (array/nth @q 1) null) LStr) "") (str/concat (quote "@") "entity")) (!= @f "") (not (str/startsWith @f (str/concat (quote "@") ""))) (not (str/startsWith @f "?"))) [@f] [])))))))
                     (fn field
                      (let ((supplied (array/some @ws (fn w (and (array/includes @fam (object/get @w "e")) (or (object/get @w "any") (array/includes (object/get @w "k") @field))))))
                            (declared (array/find (object/get @edef "fields" []) (fn f (= (object/get @f "name" "") @field)))))
                       (if (or @supplied (and (!= @declared null) (object/get @declared "intrinsic" false)) (and (!= @declared null) (not @hasCreator))) []
                        (let ((dflt (if (= @declared null) null (object/get @declared "default" null))) (cmps (array/flatten (array/map @fnodes
  (fn n (let ((q (default (as @n LNodes) [])))
    (if (and (= (array/len @q) 3) (= (default (as (if (> (array/len @q) 0) (array/nth @q 0) null) LStr) "") "="))
      (if (let ((q (default (as (array/nth @q 1) LNodes) []))) (and (= (array/len @q) 3) (= (default (as (if (> (array/len @q) 0) (array/nth @q 0) null) LStr) "") "object/get") (= (default (as (if (> (array/len @q) 1) (array/nth @q 1) null) LStr) "") (str/concat (quote "@") "entity")) (= (default (as (if (> (array/len @q) 2) (array/nth @q 2) null) LStr) "") @field))) [(array/nth @q 2)] (if (let ((q (default (as (array/nth @q 2) LNodes) []))) (and (= (array/len @q) 3) (= (default (as (if (> (array/len @q) 0) (array/nth @q 0) null) LStr) "") "object/get") (= (default (as (if (> (array/len @q) 1) (array/nth @q 1) null) LStr) "") (str/concat (quote "@") "entity")) (= (default (as (if (> (array/len @q) 2) (array/nth @q 2) null) LStr) "") @field))) [(array/nth @q 1)] []))
      [])))))))
                         (let ((folds (array/map @cmps (fn c
  (if (array/some (let ((nn (as (json/nodes @c) LNodes))) (if (= @nn null) [] @nn)) (fn s (let ((ss (default (as @s LStr) ""))) (or (str/startsWith @ss (str/concat (quote "@") "entity")) (str/startsWith @ss (str/concat (quote "@") "payload")) (str/startsWith @ss (str/concat (quote "@") "user")) (str/startsWith @ss (str/concat (quote "@") "state")) (str/startsWith @ss "?")))))
    []
    (let ((cs (default (as @c LStr) "")))
      (if (!= (as @c LStr) null)
        (if (str/startsWith @cs (str/concat (quote "@") "config."))
          (let ((knob (str/slice @cs 8 (str/len @cs))))
            (if (or (str/includes @knob ".") (str/includes @knob "[") (= (object/get (object/get (object/get @t "config" {}) @knob {}) "default" null) null))
              []
              [(object/get (object/get (object/get @t "config" {}) @knob {}) "default" null)]))
          (if (str/startsWith @cs (str/concat (quote "@") "")) [] [@c]))
        (if (or (!= (as @c LNodes) null) (!= (as @c LObj) null)) [] [@c]))))))))
                          (if (and (!= @declared null) (!= @dflt null)
                                   (or (= (array/len @cmps) 0) (array/some @folds (fn f (= (array/len @f) 0))) (array/some @folds (fn f (and (= (array/len @f) 1) (= (array/first @f) @dflt))))))
                            []
                            [{ code: @config.codes.xFilterFieldNeverWritten.code, path: (str/concat "orbitals." (object/get @o "name" "") ".traits." @tn ".stateMachine.transitions[" @ti "].effects"), message: (str/concat @tn " fetches " @fent " filtered on `" @field "`, but no `persist create`/`update` of " @fent " anywhere in the schema supplies `" @field "`" (if (= @declared null) " (not even a declared field)" "") " — the filter can never match a real row, so the fetch always returns empty"), suggestion: (str/concat "Supply `" @field "` in the `persist create`/`update " @fent "` data that produces the rows this filter targets, or drop `" @field "` from the filter if it is dead."), severity: "error" }])))))))))))))))))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "filter-field-never-written", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : FfProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait and transition effect list uses; the embed closure gates on a trait's roots holding @trait and the fetch scan on a transition's heads holding fetch."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
    }
    config {
      codes : LintFilterFieldNeverWrittenCodes = { xFilterFieldNeverWritten: { code: "ORB_X_FILTER_FIELD_NEVER_WRITTEN", category: "cross", description: "A fetch filters on a field that no persist create or update of that entity supplies, so it always returns empty" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintFilterFieldNeverWrittenCli -> OrbLintFilterFieldNeverWrittenRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint filter-field-never-written <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "filter-field-never-written") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint filter-field-never-written: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "filter-field-never-written") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint filter-field-never-written: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-filter-field-never-written" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint filter-field-never-written` with its arguments and working directory."
        @synonyms "orb lint filter-field-never-written"
      OrbLintFilterFieldNeverWritten.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintFilterFieldNeverWrittenCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintFilterFieldNeverWrittenOrbitalStart -> OrbLintFilterFieldNeverWritten, OrbLintFilterFieldNeverWrittenCli, OrbLintInput, Packs, Versions
}
