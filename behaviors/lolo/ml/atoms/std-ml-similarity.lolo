app std-ml-similarity [
  version: "1.0.0",
  description: "Retrieval rung (R3) — embed a candidate against references through std-llm (LLM_EMBED) and gate on cosine floor + margin; abstains when not confident. The gate is SimilarityGate, which SimilarityRun asks once the embeddings arrive: COMPARE_VECTORS { query, references } gates vectors a caller already holds (resolved through std-vector-resolve, so query and references share one model) without an embed call; each reference is a { key, vector }, a key may carry several vectors and scores its best, and keys rank against each other, so its SIMILARITY_MATCHED carries the winning key and its index among the distinct keys in first-seen order. floor and margin are SimilarityGate knobs.",
  net: { "openrouter.ai:443": [tcp] },
]

uses Spec from "almadar-std/similarity"
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Delay from "std/behaviors/std-delay"

orbital MlSimilarityOrbital {

  ;; The caller-supplied request bag, echoed untouched through COMPARE/SIMILARITY_ABSTAINED
  ;; so a composing ladder (e.g. std-escalating-decision) can project its own inputs out of it.
  type DecisionRequest = {
    candidate  : string!
    key        : string!
    accepted   : [string]!
    categories : [string]!
  }

  entity SimilarityComparison [runtime] {
    query            : string    = ""
    candidates       : [string]  = []
    embeddings       : [[float]] = []
    queryVector      : [float]   = []
    candidateVectors : [[float]] = []
    matchIndex       : int       = 0
    matchScore       : float     = 0
    matchMargin      : float     = 0
    reason           : string    = ""
    request          : DecisionRequest = { candidate: "", key: "", accepted: [], categories: [] }
    status           : "idle" | "embedding" | "resolved" = idle
  }

  trait SimilarityLlm = Llm.traits.LlmClient {
    listens {
      SimilarityRun.LLM_EMBED -> LLM_EMBED
      SimEmbedWait.SIM_EMBED_WAITED -> LLM_EMBED_WAITED
      SimEmbedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      SimEmbedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      SimEmbedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }

  trait SimEmbedWait = Delay.traits.Delay {
    events {
      ELAPSED: SIM_EMBED_WAITED
    }
    listens {
      SimilarityLlm.LLM_EMBED_WAIT -> START
    }
  }

  trait SimEmbedRequest = Req.traits.HttpRequest {
    listens {
      SimEmbedRequestDelay.ELAPSED -> RETRY_ELAPSED
      SimEmbedRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      SimilarityLlm.LLM_EMBED_WIRE -> HTTP_REQUEST
      SimilarityLlm.LLM_EMBED_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      SimEmbedHttp.HTTP_REPLIED -> HTTP_REPLIED
      SimEmbedHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait SimEmbedRequestDelay = Req.traits.RequestDelay {
    listens {
      SimEmbedRequest.RETRY_WAIT -> START
      SimEmbedRequest.RETRY_STOP -> CANCEL
    }
  }

  trait SimEmbedRequestDeadline = Req.traits.RequestDeadline {
    listens {
      SimEmbedRequest.TIMEOUT_START -> START
      SimEmbedRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait SimEmbedHttpFrame = Frame.traits.HttpFrame {
    listens {
      SimEmbedHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait SimEmbedHttp = Http.traits.HttpClient {
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "EMBEDDING_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      SimEmbedRequest.HTTP_SEND -> HTTP_SEND
      SimEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL
      SimEmbedHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      SimEmbedHttpFrame.FRAME_DRAINED -> HC_DRAINED
      SimEmbedHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait SimilarityRun -> SimilarityComparison [client] {
    initial: idle


    state idle {
      INIT -> idle
        (set @entity.query "")
        (set @entity.candidates [])
        (set @entity.embeddings [])
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "")
        (set @entity.request { candidate: "", key: "", accepted: [], categories: [] })
        (set @entity.status idle)

      COMPARE -> embedding when (> (array/len ?candidates) 0)
        (set @entity.query ?query)
        (set @entity.candidates ?candidates)
        (set @entity.request ?request)
        (set @entity.status embedding)
        (emit LLM_EMBED { texts: (array/prepend ?candidates ?query) })

      COMPARE -> resolved when (== (array/len ?candidates) 0)
        (set @entity.query ?query)
        (set @entity.candidates [])
        (set @entity.embeddings [])
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "empty candidate list")
        (set @entity.request ?request)
        (set @entity.status resolved)
        (emit SIMILARITY_ABSTAINED { reason: "empty candidate list", request: @entity.request })
    }

    state embedding {
      INIT -> idle
        (set @entity.query "")
        (set @entity.candidates [])
        (set @entity.embeddings [])
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "")
        (set @entity.request { candidate: "", key: "", accepted: [], categories: [] })
        (set @entity.status idle)

      EMBEDDED -> resolved when (< (array/len ?embeddings) 2)
        (set @entity.embeddings ?embeddings)
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "embedding result incomplete")
        (set @entity.status resolved)
        (emit SIMILARITY_ABSTAINED { reason: "embedding result incomplete", request: @entity.request })

      EMBEDDED -> gating when (>= (array/len ?embeddings) 2)
        (set @entity.embeddings ?embeddings)
        (set @entity.queryVector (default (array/first ?embeddings) []))
        (set @entity.candidateVectors (array/drop ?embeddings 1))
        (emit SIM_GATE { query: @entity.queryVector, references: (array/map (array/range (array/len @entity.candidateVectors)) (fn i { key: (str/concat "" @i), vector: (default (array/nth @entity.candidateVectors @i) []) })) })

      EMBED_FAILED -> resolved
        (set @entity.embeddings [])
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "embedding unavailable")
        (set @entity.status resolved)
        (emit SIMILARITY_ABSTAINED { reason: "embedding unavailable", request: @entity.request })
    }

    state gating {
      INIT -> idle
        (set @entity.status idle)
      GATE_MATCHED -> resolved
        (set @entity.matchIndex ?index)
        (set @entity.matchScore ?score)
        (set @entity.matchMargin ?margin)
        (set @entity.reason "")
        (set @entity.status resolved)
        (emit SIMILARITY_MATCHED { index: ?index, score: ?score })
      GATE_ABSTAINED -> resolved
        (set @entity.matchIndex 0)
        (set @entity.matchScore ?score)
        (set @entity.matchMargin ?margin)
        (set @entity.reason ?reason)
        (set @entity.status resolved)
        (emit SIMILARITY_ABSTAINED { reason: ?reason, request: @entity.request })
    }

    state resolved {
      INIT -> resolved
        (set @entity.status resolved)
      RESET -> idle
        (set @entity.query "")
        (set @entity.candidates [])
        (set @entity.embeddings [])
        (set @entity.queryVector [])
        (set @entity.candidateVectors [])
        (set @entity.matchIndex 0)
        (set @entity.matchScore 0)
        (set @entity.matchMargin 0)
        (set @entity.reason "")
        (set @entity.request { candidate: "", key: "", accepted: [], categories: [] })
        (set @entity.status idle)
    }

    emits {
      LLM_EMBED -> external {
        texts : [string]!
      }
        @description "Ask std-llm to embed the query (index 0) followed by the candidates"
        @tier "secondary"

      SIM_GATE {
        query : [number]!
        references : [{ key : string!, vector : [number]! }]!
      }
        @description "Internal: ask SimilarityGate to gate the query vector against the candidates' vectors, keyed by candidate index."
        @tier "internal"

      SIMILARITY_MATCHED -> external {
        index : int!
        score : float!
      }
        @description "Candidate matched with high confidence — score at or above floor, with a clear margin over the runner-up"
        @tier "primary"

      SIMILARITY_ABSTAINED -> external {
        reason : string!
        request : DecisionRequest
      }
        @description "No confident match — reason is one of: empty candidate list, below floor, thin margin, embedding unavailable. request echoes the originating request untouched so the next rung can project its own inputs out of it"
        @tier "primary"
    }

    listens {
      SimilarityLlm.LLM_EMBED_RESULT -> EMBEDDED
      SimilarityLlm.LLM_FAILED -> EMBED_FAILED
      EMBEDDED {
        embeddings : [[number]]!
      }
      EMBED_FAILED {
        code : string
        message : string!
      }
      COMPARE {
        query : string!
        candidates : [string]!
        request : DecisionRequest
      }
      SimilarityGate.SIMILARITY_MATCHED -> GATE_MATCHED
      SimilarityGate.SIMILARITY_ABSTAINED -> GATE_ABSTAINED
      GATE_MATCHED {
        index : int!
        score : number!
        margin : number!
      }
      GATE_ABSTAINED {
        reason : string!
        score : number!
        margin : number!
      }
    }
  }

  entity SimilarityGateRun [runtime] {
    id         : string!
    matchKey   : string = ""
    matchIndex : int    = 0
    matchScore : number = 0
    matchMargin : number = 0
    reason     : string = ""
  }

  trait SimilarityGate -> SimilarityGateRun [client] {
    initial: ready

    config {
      floor : float = 0.82
        @label "Match floor"
        @description "Minimum cosine score for a confident match"
        @tier "policy"
      margin : float = 0.05
        @label "Match margin"
        @description "Minimum gap between the best and second-best score required to trust the match"
        @tier "policy"
    }

    state ready {
      INIT -> ready

      COMPARE_VECTORS -> ready when (> (array/len ?references) 0)
        (let ((keys (array/unique (array/map ?references (fn r @r.key)))))
          (let ((ranked (array/sort (array/flatten (array/map @keys (fn k (let ((best (array/max (array/flatten (array/map (array/filter ?references (fn r (= @r.key @k))) (fn r (let ((c (array/cosine @r.vector ?query))) (if (== @c null) [] [@c])))))))) (if (== @best null) [] [{ key: @k, score: @best }]))))) score desc)))
            (if (= (array/len @ranked) 0)
              (do
                (set @entity.matchKey "")
                (set @entity.reason "vectors not comparable")
                (emit SIMILARITY_ABSTAINED { reason: "vectors not comparable", score: 0, margin: 0 }))
              (let ((top (array/first @ranked)))
                (do
                  (set @entity.matchKey @top.key)
                  (set @entity.matchIndex (array/indexOf @keys @top.key))
                  (set @entity.matchScore @top.score)
                  (set @entity.matchMargin (- @top.score (default (object/get (default (array/nth @ranked 1) {}) score) 0)))
                  (if (and (>= @entity.matchScore @config.floor) (>= @entity.matchMargin @config.margin))
                    (do
                      (set @entity.reason "")
                      (emit SIMILARITY_MATCHED { index: @entity.matchIndex, score: @entity.matchScore, margin: @entity.matchMargin, key: @entity.matchKey }))
                    (do
                      (set @entity.reason (if (< @entity.matchScore @config.floor) "below floor" "thin margin"))
                      (emit SIMILARITY_ABSTAINED { reason: @entity.reason, score: @entity.matchScore, margin: @entity.matchMargin }))))))))

      COMPARE_VECTORS -> ready when (= (array/len ?references) 0)
        (set @entity.matchKey "")
        (set @entity.reason "empty candidate list")
        (emit SIMILARITY_ABSTAINED { reason: "empty candidate list", score: 0, margin: 0 })
    }

    emits {
      SIMILARITY_MATCHED -> external {
        index : int!
        score : number!
        margin : number!
        key : string!
      }
        @description "The best key reached floor and leads the next key by margin; index is its position among the distinct keys in first-seen order."
        @tier "primary"
      SIMILARITY_ABSTAINED -> external {
        reason : string!
        score : number!
        margin : number!
      }
        @description "No confident key: empty candidate list, vectors not comparable, below floor or thin margin."
        @tier "primary"
    }

    listens {
      COMPARE_VECTORS -> input {
        query : [number]!
        references : [{ key : string!, vector : [number]! }]!
      }
        @description "Gate vectors the caller already holds: the query vector against keyed reference vectors, best vector per key."
        @synonyms "rank by cosine, nearest key, semantic gate"
      SimilarityRun.SIM_GATE -> COMPARE_VECTORS
    }
  }

  page boot as MlSimilarityPage -> SimilarityRun, SimilarityGate, SimilarityLlm, SimEmbedWait, SimEmbedRequest, SimEmbedRequestDelay, SimEmbedRequestDeadline, SimEmbedHttp, SimEmbedHttpFrame
}
