app std-ml-classify [
  version: "1.0.0",
  description: "Generative rung (R5) — structured LLM verdict from a closed category set, through std-llm (LLM_CLASSIFY). Bottom of the fall-through: always answers or fails, never abstains.",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]

uses Llm from "std/behaviors/std-llm"

orbital MlClassifyOrbital {

  ;; The caller-supplied request bag, echoed untouched through CLASSIFY/CLASSIFIED
  ;; so a composing ladder (e.g. std-escalating-decision) can project its own inputs out of it.
  type DecisionRequest = {
    candidate  : string!
    key        : string!
    accepted   : [string]!
    categories : [string]!
  }

  entity ClassifierVerdict [runtime] {
    text         : string   = ""
    category     : string   = ""
    confidence   : float    = 0
    reasoning    : string   = ""
    errorMessage : string   = ""
    request      : DecisionRequest = {}
    status       : "idle" | "classifying" | "done" = idle
  }

  trait ClassifyLlm = Llm.traits.LlmClient {
    listens {
      ClassifyRun.LLM_CLASSIFY -> LLM_CLASSIFY
    }
  }

  trait ClassifyRun -> ClassifierVerdict [lifecycle, instance] {
    initial: idle

    config {
      categories : [string] = []
        @label "Categories"
        @description "Closed set of category labels the LLM must choose from"
        @tier "domain"
      model : string = ""
        @label "Model"
        @description "Model override forwarded to the classify call"
        @tier "infra"
    }

    state idle {
      INIT -> idle
        (set @entity.text "")
        (set @entity.category "")
        (set @entity.confidence 0)
        (set @entity.reasoning "")
        (set @entity.errorMessage "")
        (set @entity.request {})
        (set @entity.status idle)

      CLASSIFY -> classifying
        (set @entity.text ?text)
        (set @entity.request ?request)
        (set @entity.status classifying)
        (emit LLM_CLASSIFY { text: ?text, categories: @config.categories, model: @config.model })
    }

    state classifying {
      INIT -> idle
        (set @entity.text "")
        (set @entity.category "")
        (set @entity.confidence 0)
        (set @entity.reasoning "")
        (set @entity.errorMessage "")
        (set @entity.request {})
        (set @entity.status idle)
      CLASSIFIED_RAW -> done
        (set @entity.category ?category)
        (set @entity.confidence ?confidence)
        (set @entity.reasoning ?reasoning)
        (set @entity.status done)
        (emit CLASSIFIED { category: @entity.category, confidence: @entity.confidence, reasoning: @entity.reasoning })

      CLASSIFY_CALL_FAILED -> done
        (set @entity.category "")
        (set @entity.confidence 0)
        (set @entity.reasoning "")
        (set @entity.errorMessage ?message)
        (set @entity.status done)
        (emit CLASSIFY_FAILED { error: @entity.errorMessage })
        (notify error (str/concat "Couldn't classify — " ?message))
    }

    state done {
      INIT -> done
        (set @entity.status done)
      RESET -> idle
        (set @entity.text "")
        (set @entity.category "")
        (set @entity.confidence 0)
        (set @entity.reasoning "")
        (set @entity.errorMessage "")
        (set @entity.request {})
        (set @entity.status idle)
    }

    emits {
      LLM_CLASSIFY -> external {
        text : string!
        categories : [string]!
        model : string
      }
        @description "Ask std-llm to classify the text into the closed category set"
        @tier "secondary"

      CLASSIFIED -> external {
        category   : string!
        confidence : float!
        reasoning  : string!
      }
        @description "Structured LLM verdict — closed-set category with confidence and reasoning"
        @tier "primary"

      CLASSIFY_FAILED -> external {
        error : string!
      }
        @description "The classify service call failed; this rung never abstains, only answers or fails"
        @tier "primary"
    }

    listens {
      ClassifyLlm.LLM_CLASSIFY_RESULT -> CLASSIFIED_RAW
      ClassifyLlm.LLM_FAILED -> CLASSIFY_CALL_FAILED
      CLASSIFIED_RAW {
        category   : string!
        confidence : number!
        reasoning  : string!
      }
      CLASSIFY_CALL_FAILED {
        code : string
        message : string!
      }
      CLASSIFY {
        text : string!
        request : DecisionRequest
      }
    }
  }

  page "/ml-classify" as MlClassifyPage -> ClassifyRun, ClassifyLlm
}
