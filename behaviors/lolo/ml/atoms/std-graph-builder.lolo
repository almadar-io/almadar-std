app std-graph-builder [
  version: "1.0.0",
  description: "Graph construction atom — builds node/edge structures from an entity collection for downstream GNN pipelines; pure array/object transform, no ML compute."
]

orbital GraphBuilderOrbital {
    type GraphBuilderEdge = { source : string!, target : string! }
    type FeatureValue = string | number | boolean
    type GraphNode = Map string FeatureValue

  entity GraphSource [runtime] {
    id : string!
    neighbors : [string] = []
  }

  entity GraphStructure [runtime] {
    nodes     : [GraphNode] = []
    edges     : [GraphBuilderEdge] = []
    nodeCount : int = 0
    edgeCount : int = 0
    status    : "idle" | "built" = idle
  }

  trait GraphBuilderRun -> GraphStructure [lifecycle, instance] {
    initial: idle

    config {
      rowEntity : entity = GraphSource
        @label "Entity of the rows"
        @description "The entity whose rows BUILD_GRAPH delivers; edgeField and nodeFeatures name fields of it"
        @synonyms "source entity, rows of, node entity"
        @tier "internal"
      edgeField : string = neighbors
        @label "Edge field"
        @description "Field on each source entity holding its adjacency — an array of target ids"
        @tier "domain"
      nodeFeatures : [string] = [id]
        @label "Node features"
        @description "Entity fields carried onto each node alongside id"
        @tier "domain"
      directed : boolean = false
        @label "Directed"
        @description "Carried through for downstream consumers; edges are emitted once per adjacency entry, so an undirected reader should treat each edge as bidirectional"
        @tier "policy"
    }

    state idle {
      INIT -> idle
        (set @entity.nodes [])
        (set @entity.edges [])
        (set @entity.nodeCount 0)
        (set @entity.edgeCount 0)
        (set @entity.status idle)

      BUILD_GRAPH -> built
        (let ((nodes (array/map ?entities (fn e (object/merge { id: (object/get @e "id") } (object/pick @e @config.nodeFeatures)))))
              (edges (array/flatten (array/map ?entities (fn e
                        (array/map (object/get @e @config.edgeField [])
                          (fn target { source: (object/get @e "id"), target: @target })))))))
          (do
            (set @entity.nodes @nodes)
            (set @entity.edges @edges)
            (set @entity.nodeCount (array/len @nodes))
            (set @entity.edgeCount (array/len @edges))
            (set @entity.status built)
            (emit GRAPH_READY {
              nodes: @nodes,
              edges: @edges,
              nodeCount: (array/len @nodes),
              edgeCount: (array/len @edges),
              directed: @config.directed
            })))
    }

    state built {
      INIT -> built
        (set @entity.status built)
      RESET -> idle
        (set @entity.nodes [])
        (set @entity.edges [])
        (set @entity.nodeCount 0)
        (set @entity.edgeCount 0)
        (set @entity.status idle)
    }

    emits {
      GRAPH_READY -> external {
        nodes : [GraphNode]!
        edges : [GraphBuilderEdge]!
        nodeCount : int!
        edgeCount : int!
        directed : boolean!
      }
        @description "Fired when node/edge structures have been built from the source entity collection"
        @tier "primary"
    }

    listens {
      BUILD_GRAPH {
        entities : [@entity @config.rowEntity]!
      }
    }
  }

  page "/graph-builder" as GraphBuilderPage -> GraphBuilderRun
}
