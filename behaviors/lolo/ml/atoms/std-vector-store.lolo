app std-vector-store [
  version: "1.0.0",
  description: "std-vector-store — read ORBVEC embedding stores (the orb vector store, one sorted int8-quantized file per scope) over bytes/*, hash/sha256, array/* and math/*. VECTOR_LOOKUP_MANY { stores, model, texts } takes the layered store files as bytes in lookup order (package snapshots first, the user store last; an empty bytes value is a missing file and is skipped), validates each store once (magic, version, header, length, strict key order), requires one model and dims across them, and looks every text's key sha256(model, NUL, text) up by binary search, first store winning. It answers VECTOR_RESOLVED { model, entries } with one { found, dims, scale, vector } per text in order, the vector decoded as int8 * scale / 127 where scale is what Rust reads a stored binary32 scale back as (its decimal text parsed as a double), exact over the whole range through std-sig6; VECTOR_REFUSED { code, detail } carries the ORB_VECTOR_* code of the first refusal. VECTOR_LOOKUP { stores, model, text } is the same for one text and answers VECTOR_FOUND { model, dims, scale, vector } or VECTOR_MISSED { model }. A text no store holds is a miss for the caller to embed through std-llm. Read side only: writing, locking and quantizing are std-vector-write and std-vector-quantize."
]
uses Spec from "almadar-std/vector-store"
uses Sig6 from "std/behaviors/std-sig6"
uses BigCmp from "std/behaviors/std-bigcmp"
uses F32 from "std/behaviors/std-f32"

type VectorHit = { found : boolean!, scale : number!, vec : bytes!, record : bytes!, bad : boolean! }
type StoreInfo = { si : number!, off : number!, rec : number!, count : number!, bstart : number! }
type VectorParse = { err : string!, detail : string!, model : string!, dims : number!, pos : number!, infos : [StoreInfo]!, blocks : [bytes]! }

orbital VectorStoreOrbital {
  entity VectorRun [runtime] {
    id : string!
    stores : [bytes] = []
    model : string = ""
    origins : [string] = []
    texts : [string] = []
    single : number = 0
    accs : [VectorHit] = []
    dscales : [number] = []
    doubles : [number] = []
    parsed : VectorParse = { err: "", detail: "", model: "", dims: 0, pos: 0, infos: [], blocks: [] }
  }

  trait StoreF32 = F32.traits.F32Encode {
    listens {
      StoreSig6.F32_ENCODE -> F32_ENCODE
    }
  }

  trait StoreSig6 = Sig6.traits.Sig6 {
    listens {
      VectorLookup.SIG6 -> SIG6
      StoreBigCmp.BIGCMP_ANSWERED -> BIGCMP_ANSWERED
      StoreF32.F32_ENCODED -> F32_ENCODED
      StoreF32.F32_REFUSED -> F32_REFUSED
    }
  }

  trait StoreBigCmp = BigCmp.traits.BigCmp {
    listens {
      StoreSig6.BIGCMP_BATCH -> BIGCMP_BATCH
    }
  }

  trait VectorLookup -> VectorRun [client] {
    initial: idle

    state idle {
      VECTOR_LOOKUP -> idle
        (set @entity.stores @payload.stores)
        (set @entity.origins (default @payload.origins []))
        (set @entity.model @payload.model)
        (set @entity.texts [@payload.text])
        (set @entity.single 1)
        (set @entity.parsed (let ((parseStore (fn acc s (let ((org (if (< @acc.pos (array/len @entity.origins)) (default (array/nth @entity.origins @acc.pos) (str/concat "store " @acc.pos)) (str/concat "store " @acc.pos)))) (if (or (!= @acc.err "") (== (bytes/length @s) 0)) { err: @acc.err, detail: @acc.detail, model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (or (< (bytes/length @s) 6) (not (bytes/equals (bytes/slice @s 0 6) (bytes/from-string "ORBVEC")))) { err: "ORB_VECTOR_BAD_MAGIC", detail: (str/concat @org " is not an ORBVEC file"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((ver (bytes/read-uint @s 6 2 "le")) (mlen (bytes/read-uint @s 8 2 "le")))  (if (or (== @ver null) (== @mlen null)) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": truncated header"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (!= @ver 1) { err: "ORB_VECTOR_BAD_VERSION", detail: (str/concat @org " has format version " @ver ", this build reads 1"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((dpos (+ 10 @mlen)))  (let ((dims (bytes/read-uint @s @dpos 2 "le")) (count (bytes/read-uint @s (+ @dpos 2) 4 "le")) (mname (bytes/to-string (bytes/slice @s 10 @dpos))))  (if (or (== @dims null) (== @count null) (> @dpos (bytes/length @s))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": truncated header"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (or (== @mname null) (== @mname "") (== @dims 0)) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": unreadable or empty model name, or zero dims"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((off (+ @dpos 6)) (rec (+ 36 @dims)))  (if (!= (bytes/length @s) (+ @off (* @count @rec))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": expected " (+ @off (* @count @rec)) " bytes for " @count " records, found " (bytes/length @s)), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((blks (array/map (array/range 0 (math/floor (/ (+ @count 15) 16))) (fn bi (bytes/slice @s (+ @off (* @bi 16 @rec)) (math/min (+ @off (* (+ @bi 1) 16 @rec)) (+ @off (* @count @rec))))))))  (if (not (array/reduce (array/range 1 @count) true (fn so si (and @so (< (array/reduce (array/range 0 8) 0 (fn cd cw (if (!= @cd 0) @cd (let ((cx (bytes/read-uint (default (array/nth @blks (math/floor (/ (- @si 1) 16))) (bytes/from-string "")) (+ (* (- (- @si 1) (* 16 (math/floor (/ (- @si 1) 16)))) @rec) (* 4 @cw)) 4 "be")) (cy (bytes/read-uint (default (array/nth @blks (math/floor (/ @si 16))) (bytes/from-string "")) (+ (* (- @si (* 16 (math/floor (/ @si 16)))) @rec) (* 4 @cw)) 4 "be"))) (if (and (validate/required @cx) (validate/required @cy)) (if (< @cx @cy) -1 (if (> @cx @cy) 1 0)) 2))))) 0))))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": records are not strictly sorted by key"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (and (!= @acc.model "") (!= @acc.model @mname)) { err: "ORB_VECTOR_MODEL_MISMATCH", detail: (str/concat @acc.model " vs " @mname " — vectors from different embedding models are not comparable"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (and (!= @acc.model "") (!= @acc.dims @dims)) { err: "ORB_VECTOR_DIMS_MISMATCH", detail: (str/concat "model " @acc.model " has " @acc.dims " dims in one store and " @dims " in the other"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  { err: "", detail: "", model: @mname, dims: @dims, pos: (+ @acc.pos 1), infos: (array/append @acc.infos { si: @acc.pos, off: @off, rec: @rec, count: @count, bstart: (array/len @acc.blocks) }), blocks: (array/concat @acc.blocks @blks) })))))))))))))))))))
          (let ((first (array/first (array/filter (array/map (array/zip (array/range (array/len @entity.stores)) @entity.stores) (fn z (array/reduce [(array/nth @z 1)] { err: "", detail: "", model: "", dims: 0, pos: (array/nth @z 0), infos: [], blocks: [] } @parseStore))) (fn r (!= @r.err ""))))))
            (if (== @first null) (array/reduce @entity.stores { err: "", detail: "", model: "", dims: 0, pos: 0, infos: [], blocks: [] } @parseStore) @first))))
        (emit VECTOR_MANY_PARSED { })

      VECTOR_LOOKUP_MANY -> idle
        (set @entity.stores @payload.stores)
        (set @entity.origins (default @payload.origins []))
        (set @entity.model @payload.model)
        (set @entity.texts @payload.texts)
        (set @entity.single 0)
        (set @entity.parsed (let ((parseStore (fn acc s (let ((org (if (< @acc.pos (array/len @entity.origins)) (default (array/nth @entity.origins @acc.pos) (str/concat "store " @acc.pos)) (str/concat "store " @acc.pos)))) (if (or (!= @acc.err "") (== (bytes/length @s) 0)) { err: @acc.err, detail: @acc.detail, model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (or (< (bytes/length @s) 6) (not (bytes/equals (bytes/slice @s 0 6) (bytes/from-string "ORBVEC")))) { err: "ORB_VECTOR_BAD_MAGIC", detail: (str/concat @org " is not an ORBVEC file"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((ver (bytes/read-uint @s 6 2 "le")) (mlen (bytes/read-uint @s 8 2 "le")))  (if (or (== @ver null) (== @mlen null)) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": truncated header"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (!= @ver 1) { err: "ORB_VECTOR_BAD_VERSION", detail: (str/concat @org " has format version " @ver ", this build reads 1"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((dpos (+ 10 @mlen)))  (let ((dims (bytes/read-uint @s @dpos 2 "le")) (count (bytes/read-uint @s (+ @dpos 2) 4 "le")) (mname (bytes/to-string (bytes/slice @s 10 @dpos))))  (if (or (== @dims null) (== @count null) (> @dpos (bytes/length @s))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": truncated header"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (or (== @mname null) (== @mname "") (== @dims 0)) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": unreadable or empty model name, or zero dims"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((off (+ @dpos 6)) (rec (+ 36 @dims)))  (if (!= (bytes/length @s) (+ @off (* @count @rec))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": expected " (+ @off (* @count @rec)) " bytes for " @count " records, found " (bytes/length @s)), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (let ((blks (array/map (array/range 0 (math/floor (/ (+ @count 15) 16))) (fn bi (bytes/slice @s (+ @off (* @bi 16 @rec)) (math/min (+ @off (* (+ @bi 1) 16 @rec)) (+ @off (* @count @rec))))))))  (if (not (array/reduce (array/range 1 @count) true (fn so si (and @so (< (array/reduce (array/range 0 8) 0 (fn cd cw (if (!= @cd 0) @cd (let ((cx (bytes/read-uint (default (array/nth @blks (math/floor (/ (- @si 1) 16))) (bytes/from-string "")) (+ (* (- (- @si 1) (* 16 (math/floor (/ (- @si 1) 16)))) @rec) (* 4 @cw)) 4 "be")) (cy (bytes/read-uint (default (array/nth @blks (math/floor (/ @si 16))) (bytes/from-string "")) (+ (* (- @si (* 16 (math/floor (/ @si 16)))) @rec) (* 4 @cw)) 4 "be"))) (if (and (validate/required @cx) (validate/required @cy)) (if (< @cx @cy) -1 (if (> @cx @cy) 1 0)) 2))))) 0))))) { err: "ORB_VECTOR_CORRUPT", detail: (str/concat @org ": records are not strictly sorted by key"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (and (!= @acc.model "") (!= @acc.model @mname)) { err: "ORB_VECTOR_MODEL_MISMATCH", detail: (str/concat @acc.model " vs " @mname " — vectors from different embedding models are not comparable"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  (if (and (!= @acc.model "") (!= @acc.dims @dims)) { err: "ORB_VECTOR_DIMS_MISMATCH", detail: (str/concat "model " @acc.model " has " @acc.dims " dims in one store and " @dims " in the other"), model: @acc.model, dims: @acc.dims, pos: (+ @acc.pos 1), infos: @acc.infos, blocks: @acc.blocks }  { err: "", detail: "", model: @mname, dims: @dims, pos: (+ @acc.pos 1), infos: (array/append @acc.infos { si: @acc.pos, off: @off, rec: @rec, count: @count, bstart: (array/len @acc.blocks) }), blocks: (array/concat @acc.blocks @blks) })))))))))))))))))))
          (let ((first (array/first (array/filter (array/map (array/zip (array/range (array/len @entity.stores)) @entity.stores) (fn z (array/reduce [(array/nth @z 1)] { err: "", detail: "", model: "", dims: 0, pos: (array/nth @z 0), infos: [], blocks: [] } @parseStore))) (fn r (!= @r.err ""))))))
            (if (== @first null) (array/reduce @entity.stores { err: "", detail: "", model: "", dims: 0, pos: 0, infos: [], blocks: [] } @parseStore) @first))))
        (emit VECTOR_MANY_PARSED { })

      VECTOR_MANY_PARSED -> idle when (!= @entity.parsed.err "")
        (emit VECTOR_REFUSED { code: @entity.parsed.err, detail: @entity.parsed.detail })
      VECTOR_MANY_PARSED -> idle when (== @entity.parsed.err "")
        (set @entity.accs (array/map @entity.texts (fn tx (let ((kk (let ((kt (hash/sha256 (str/concat @entity.model "\u{0}" @tx) "base64"))) (if (= @kt null) null (bytes/from-base64 @kt)))))  (if (= @kk null) { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: false } (array/reduce @entity.parsed.infos { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: false } (fn hacc info (if @hacc.found @hacc  (let ((rec @info.rec) (count @info.count) (bstart @info.bstart))  (let ((hit (array/reduce (array/range 0 34) { lo: 0, hi: @count, idx: -1 } (fn sa sj (if (or (!= @sa.idx -1) (>= @sa.lo @sa.hi)) @sa (let ((mid (math/floor (/ (+ @sa.lo @sa.hi) 2)))) (let ((c (array/reduce (array/range 0 8) 0 (fn cd cw (if (!= @cd 0) @cd (let ((cx (bytes/read-uint (default (array/nth @entity.parsed.blocks (+ @bstart (math/floor (/ @mid 16)))) (bytes/from-string "")) (+ (* (- @mid (* 16 (math/floor (/ @mid 16)))) @rec) (* 4 @cw)) 4 "be")) (cy (bytes/read-uint @kk (* 4 @cw) 4 "be"))) (if (and (validate/required @cx) (validate/required @cy)) (if (< @cx @cy) -1 (if (> @cx @cy) 1 0)) 2))))))) (if (== @c 2) { lo: @sa.lo, hi: @sa.hi, idx: -2 } (if (== @c 0) { lo: @sa.lo, hi: @sa.hi, idx: @mid } (if (< @c 0) { lo: (+ @mid 1), hi: @sa.hi, idx: -1 } { lo: @sa.lo, hi: @mid, idx: -1 }))))))))))  (if (== @hit.idx -2) { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: true } (if (< @hit.idx 0) @hacc  (let ((bits (bytes/read-uint (default (array/nth @entity.parsed.blocks (+ @bstart (math/floor (/ @hit.idx 16)))) (bytes/from-string "")) (+ (* (- @hit.idx (* 16 (math/floor (/ @hit.idx 16)))) @rec) 32) 4 "le")))  (if (== @bits null) { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: true } (let ((sg (math/floor (/ @bits 2147483648))) (ex (math/mod (math/floor (/ @bits 8388608)) 256)) (mn (math/mod @bits 8388608)))  (let ((pw (if (== @ex 0) (math/pow 2 -149) (math/pow 2 (- @ex 127))))) (if (== @pw null) { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: true } (let ((raw (* (- 1 (* 2 @sg)) (if (== @ex 0) (* @mn @pw) (* (+ 1 (/ @mn 8388608)) @pw)))))  { found: true, bad: false, scale: @raw, record: (bytes/slice (default (array/nth @entity.parsed.blocks (+ @bstart (math/floor (/ @hit.idx 16)))) (bytes/from-string "")) (+ (* (- @hit.idx (* 16 (math/floor (/ @hit.idx 16)))) @rec) 32) (+ (* (- @hit.idx (* 16 (math/floor (/ @hit.idx 16)))) @rec) @rec)), vec: (bytes/slice (default (array/nth @entity.parsed.blocks (+ @bstart (math/floor (/ @hit.idx 16)))) (bytes/from-string "")) (+ (* (- @hit.idx (* 16 (math/floor (/ @hit.idx 16)))) @rec) 36) (+ (* (- @hit.idx (* 16 (math/floor (/ @hit.idx 16)))) @rec) @rec)) }))))))))))))))))))
        (emit VECTOR_MANY_SEARCHED { })

      VECTOR_MANY_SEARCHED -> idle when (array/some @entity.accs (fn ea @ea.bad))
        (emit VECTOR_REFUSED { code: "ORB_VECTOR_CORRUPT", detail: "unreadable record while searching a store" })
      VECTOR_MANY_SEARCHED -> scaling when (and (not (array/some @entity.accs (fn ea @ea.bad))) (array/some @entity.accs (fn ea (and @ea.found (> @ea.scale 0)))))
        (emit SIG6 { scales: (array/map (array/filter @entity.accs (fn ea (and @ea.found (> @ea.scale 0)))) (fn ea @ea.scale)) })
      VECTOR_MANY_SEARCHED -> idle when (and (not (array/some @entity.accs (fn ea @ea.bad))) (not (array/some @entity.accs (fn ea (and @ea.found (> @ea.scale 0))))))
        (set @entity.doubles [])
        (emit VECTOR_MANY_LOOKED { })

      VECTOR_MANY_LOOKED -> idle when (< @entity.single 1)
        (set @entity.dscales (array/map (array/range 0 (array/len @entity.accs)) (fn ei (let ((ea (array/nth @entity.accs @ei))) (if (and @ea.found (> @ea.scale 0)) (default (array/nth @entity.doubles (array/len (array/filter (array/range 0 @ei) (fn ej (let ((eb (array/nth @entity.accs @ej))) (and @eb.found (> @eb.scale 0))))))) 0) 0)))))
        (emit VECTOR_RESOLVED { model: @entity.model, entries: (array/map (array/range 0 (array/len @entity.accs)) (fn ei (let ((ea (array/nth @entity.accs @ei))) { found: @ea.found, dims: @entity.parsed.dims, scale: (default (array/nth @entity.dscales @ei) 0), record: @ea.record, vector: (if @ea.found (array/map (array/range 0 @entity.parsed.dims) (fn vi (let ((vb (default (bytes/at @ea.vec @vi) 0))) (/ (* (if (>= @vb 128) (- @vb 256) @vb) (default (array/nth @entity.dscales @ei) 0)) 127)))) []) }))) })
      VECTOR_MANY_LOOKED -> idle when (and (>= @entity.single 1) (array/some @entity.accs (fn ea @ea.found)))
        (set @entity.dscales (array/map (array/range 0 (array/len @entity.accs)) (fn ei (let ((ea (array/nth @entity.accs @ei))) (if (> @ea.scale 0) (default (array/first @entity.doubles) 0) 0)))))
        (emit VECTOR_FOUND { model: @entity.parsed.model, dims: @entity.parsed.dims, scale: (default (array/first @entity.dscales) 0), vector: (array/map (array/range 0 @entity.parsed.dims) (fn vi (let ((vb (default (bytes/at (object/get (default (array/first @entity.accs) { found: false, scale: 0, vec: (bytes/from-string ""), record: (bytes/from-string ""), bad: false }) "vec") @vi) 0))) (/ (* (if (>= @vb 128) (- @vb 256) @vb) (default (array/first @entity.dscales) 0)) 127)))) })
      VECTOR_MANY_LOOKED -> idle when (and (>= @entity.single 1) (not (array/some @entity.accs (fn ea @ea.found))))
        (emit VECTOR_MISSED { model: @entity.model })
    }

    state scaling {
      SIG6_DONE -> idle
        (set @entity.doubles @payload.doubles)
        (emit VECTOR_MANY_LOOKED { })
      SIG6_REFUSED -> idle
        (emit VECTOR_REFUSED { code: "ORB_VECTOR_CORRUPT", detail: @payload.reason })
    }

    emits {
      VECTOR_MANY_PARSED -> internal { }
      VECTOR_MANY_SEARCHED -> internal { }
      VECTOR_MANY_LOOKED -> internal { }
      SIG6 -> external {
        scales : [number]!
      }
        @tier "secondary"
      VECTOR_FOUND -> external {
        model : string!
        dims : number!
        scale : number!
        vector : [number]!
      }
        @description "The stored vector for the text, decoded to numbers (int8 * scale / 127), from the first store that holds the key."
        @tier "primary"
      VECTOR_MISSED -> external {
        model : string!
      }
        @description "No store holds the key; the caller embeds the text through the configured provider and writes the user store."
        @tier "primary"
      VECTOR_RESOLVED -> external {
        model : string!
        entries : [{ found : boolean!, dims : number!, scale : number!, record : bytes!, vector : [number]! }]!
      }
        @description "One entry per requested text, in order: found with its decoded vector (first store holding the key wins), or not found with an empty vector. A text no store holds is a miss for the caller to embed."
        @tier "primary"
      VECTOR_REFUSED -> external {
        code : string!
        detail : string!
      }
        @description "A store failed validation (ORB_VECTOR_BAD_MAGIC, BAD_VERSION, CORRUPT, MODEL_MISMATCH, DIMS_MISMATCH)."
        @tier "primary"
    }

    listens {
      StoreSig6.SIG6_DONE -> SIG6_DONE
      StoreSig6.SIG6_REFUSED -> SIG6_REFUSED
      SIG6_DONE {
        bits : [number]!
        rounded : [number]!
        doubles : [number]!
      }
      SIG6_REFUSED {
        reason : string!
      }
      VECTOR_LOOKUP_MANY -> input {
        stores : [bytes]!
        origins : [string]
        model : string!
        texts : [string]!
      }
        @description "Look many texts up in these layered ORBVEC store files; answers one VECTOR_RESOLVED entry per text."
      VECTOR_LOOKUP -> input {
        stores : [bytes]!
        origins : [string]
        model : string!
        text : string!
      }
        @description "Look the text up in these layered ORBVEC store files (base64 bytes, first store wins; empty bytes = missing file)."
        @synonyms "embedding cache lookup, vector snapshot read, orbvec"
    }
  }

  page boot as VectorStoreOrbitalStart -> VectorLookup, StoreSig6, StoreBigCmp, StoreF32
}
