app std-catalog-vectors [
  version: "1.0.0",
  env: ["ALMADAR_VECTORS_DIR", "HOME", "EMBEDDING_PROVIDER", "EMBEDDING_API_KEY", "OPENAI_API_KEY", "OPEN_ROUTER_API_KEY", "EMBEDDING_MODEL", "LMSTUDIO_EMBEDDING_MODEL"],
  fs: { cwd: "node_modules/**": [read], "~/.almadar/sidecars/**": [read], "~/.almadar/vectors/**": [read], env ALMADAR_VECTORS_DIR: "**": [read] },
  description: "std-catalog-vectors — the ONE std flow that owns catalog rows with vectors, whole in one orbital: the controller, the texts, the sources, the resolver with its stores and writers and its five embedding provider clients, so a composer aliases the orbital and wires one ask and two answers. Its page is a route, not boot, so each viewer's ask is answered in that viewer's own session (a boot-only trait is program-wide and would answer in the program session, where the asking viewer's traits do not hear it); CatalogVectorsStatus is the small page trait that says what was read. CATALOG_VECTORS_ASK { paths, exposure, traits } lists the installed behaviors under the registry folders with the facts their embedding texts read (`behavior/catalog` with texts: true), builds each row's organism and capability texts (std-behavior-texts), reads where the vectors live and which embedding provider is configured (std-vector-sources), and resolves every text package snapshot first, then the user store, then the configured provider for what no store holds (std-vector-resolve, which writes what it embeds back to the user store), then answers CATALOG_VECTORS_ROWS { rows, model }: each row with its `vectors` keyed `description` and, when the behavior declares capabilities, `capabilities`. A host never attaches vectors to a catalog row, so a consumer that ranks by meaning (a search, a retrieval ladder, a scope listing) asks this atom and never reads `vectors` off a plain `behavior/catalog` answer. Nothing is answered empty: a row whose description has no vector, a package that cannot be read, no vector in any store with no provider configured, or a provider failure answers CATALOG_VECTORS_REFUSED { code, detail }, and the consumer shows it. The provider call is std-llm over std-http-request and std-http-client; a keyed provider's key rides the HttpClient credential knobs, which the host fills into the os/send at the boundary. The composer declares the same fs, env, exec and net grants as this app."
]
uses Texts from "std/behaviors/std-behavior-texts"
uses Sources from "std/behaviors/std-vector-sources"
uses ResolveAtom from "std/behaviors/std-vector-resolve"
uses Store from "std/behaviors/std-vector-store"
uses Write from "std/behaviors/std-vector-write"
uses Quantize from "std/behaviors/std-vector-quantize"
uses F32 from "std/behaviors/std-f32"
uses Sig6 from "std/behaviors/std-sig6"
uses BigCmp from "std/behaviors/std-bigcmp"
uses Delay from "std/behaviors/std-delay"

type WantedText = { key : string!, text : string! }
type KeyedVector = { key : string!, vector : [number]! }
type StoreEntry = { found : boolean!, dims : number!, scale : number!, record : bytes!, vector : [number]! }
type CatalogFactsRow = {
  behavior : string!
  package : string!
  topic : string!
  level : string!
  exposure : string
  description : string!
  capabilities : [string]
  traits : [trait]
  value : behavior!
  vectors : Map string [number]
  model : string
  name : string
  rank : number
  textOrder : number
  defaultEntityName : string
  connectableEvents : [string]
  capabilitiesText : string
  pattern : string
}
type CatalogVectorRow = {
  behavior : string!
  package : string!
  topic : string!
  level : string!
  exposure : string
  pattern : string
  description : string!
  capabilities : [string]
  traits : [trait]
  value : behavior!
  vectors : Map string [number]!
}
type CatalogPackage = { root : string!, prefix : string!, vectors : string, vectorsRel : string, vectorsIn : string }

orbital CatalogVectorsOrbital {
  entity CatalogVectorsRun [runtime] {
    id : string!
    paths : [string] = []
    exposure : [string] = []
    traits : boolean = true
    rows : [CatalogFactsRow] = []
    wanted : [WantedText] = []
  }

  trait CvTexts = Texts.traits.BehaviorTexts {
    listens {
      CatalogVectors.CV_ENTRY_TEXTS -> BUILD_ENTRY_TEXTS
    }
  }

  trait CvSources = Sources.traits.VectorSources {
    listens {
      CatalogVectors.CV_SOURCES -> SOURCES
      CvResolve.USER_STORE_NEEDED -> USER_STORE_NEEDED
    }
  }

  trait CvResolve = ResolveAtom.traits.VectorResolve {
    listens {
      CatalogVectors.CV_RESOLVE -> RESOLVE
      CvSources.USER_STORE_READ -> USER_STORE_READ
      CvStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      CvStore.VECTOR_REFUSED -> VECTOR_REFUSED
      ResolveLlmOrShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOrOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmLm.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmLm.LLM_FAILED -> LLM_FAILED
      CvWrite.VECTOR_WRITTEN -> VECTOR_WRITTEN
      CvWrite.VECTOR_WRITE_REFUSED -> VECTOR_WRITE_REFUSED
      RESOLVE {
        wanted : [WantedText]!
        snapshots : [bytes]!
        snapshotPaths : [string]
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string
        embedModel : string
      }
      USER_STORE_READ {
        data : bytes!
      }
      VECTOR_RESOLVED {
        model : string!
        entries : [StoreEntry]!
      }
      VECTOR_REFUSED {
        code : string!
        detail : string!
      }
      LLM_EMBED_RESULT {
        embeddings : [[number]]!
      }
      LLM_FAILED {
        code : string
        message : string!
      }
      VECTOR_WRITTEN {
        path : string!
        count : number!
      }
      VECTOR_WRITE_REFUSED {
        code : string!
        detail : string!
      }
    }
  }
  trait CvStore = Store.traits.VectorLookup {
    listens {
      CvResolve.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      CvWrite.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      CvSig6.SIG6_DONE -> SIG6_DONE
      CvSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }
  trait CvWrite = Write.traits.VectorWrite {
    listens {
      CvResolve.VECTOR_WRITE -> VECTOR_WRITE
      CvQuantize.QUANTIZED -> QUANTIZED
      CvQuantize.QUANTIZE_REFUSED -> QUANTIZE_REFUSED
      CvStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      CvStore.VECTOR_REFUSED -> VECTOR_REFUSED
      CvDelay.ELAPSED -> ELAPSED
    }
  }
  trait CvQuantize = Quantize.traits.VectorQuantize {
    listens {
      CvWrite.QUANTIZE -> QUANTIZE
      CvF32.F32_ENCODED -> F32_ENCODED
      CvF32.F32_REFUSED -> F32_REFUSED
      CvSig6.SIG6_DONE -> SIG6_DONE
      CvSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }
  trait CvF32 = F32.traits.F32Encode {
    listens {
      CvQuantize.F32_ENCODE -> F32_ENCODE
      CvSig6.F32_ENCODE -> F32_ENCODE
    }
  }
  trait CvSig6 = Sig6.traits.Sig6 {
    listens {
      CvQuantize.SIG6 -> SIG6
      CvStore.SIG6 -> SIG6
      CvBigCmp.BIGCMP_ANSWERED -> BIGCMP_ANSWERED
      CvF32.F32_ENCODED -> F32_ENCODED
      CvF32.F32_REFUSED -> F32_REFUSED
    }
  }
  trait CvBigCmp = BigCmp.traits.BigCmp {
    listens {
      CvSig6.BIGCMP_BATCH -> BIGCMP_BATCH
    }
  }
  trait CvDelay = Delay.traits.Delay {
    listens {
      CvWrite.LOCK_WAIT -> START
    }
  }
  trait ResolveLlmOrShared = ResolveAtom.traits.ResolveLlmOrShared {
    listens {
      CvResolve.LLM_EMBED_ORS -> LLM_EMBED_ORS
      ResolveOrSharedWait.WAITED_ORS -> LLM_EMBED_WAITED
      ResolveOrSharedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOrSharedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOrSharedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOrOwn = ResolveAtom.traits.ResolveLlmOrOwn {
    listens {
      CvResolve.LLM_EMBED_ORO -> LLM_EMBED_ORO
      ResolveOrOwnWait.WAITED_ORO -> LLM_EMBED_WAITED
      ResolveOrOwnRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOrOwnRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOrOwnRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOaShared = ResolveAtom.traits.ResolveLlmOaShared {
    listens {
      CvResolve.LLM_EMBED_OAS -> LLM_EMBED_OAS
      ResolveOaSharedWait.WAITED_OAS -> LLM_EMBED_WAITED
      ResolveOaSharedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOaSharedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOaSharedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOaOwn = ResolveAtom.traits.ResolveLlmOaOwn {
    listens {
      CvResolve.LLM_EMBED_OAO -> LLM_EMBED_OAO
      ResolveOaOwnWait.WAITED_OAO -> LLM_EMBED_WAITED
      ResolveOaOwnRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOaOwnRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOaOwnRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmLm = ResolveAtom.traits.ResolveLlmLm {
    listens {
      CvResolve.LLM_EMBED_LM -> LLM_EMBED_LM
      ResolveLmWait.WAITED_LM -> LLM_EMBED_WAITED
      ResolveLmRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveLmRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveLmRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveOrSharedWait = ResolveAtom.traits.ResolveOrSharedWait {}
  trait ResolveOrSharedRequest = ResolveAtom.traits.ResolveOrSharedRequest {}
  trait ResolveOrSharedHttp = ResolveAtom.traits.ResolveOrSharedHttp {}
  trait ResolveOrOwnWait = ResolveAtom.traits.ResolveOrOwnWait {}
  trait ResolveOrOwnRequest = ResolveAtom.traits.ResolveOrOwnRequest {}
  trait ResolveOrOwnHttp = ResolveAtom.traits.ResolveOrOwnHttp {}
  trait ResolveOaSharedWait = ResolveAtom.traits.ResolveOaSharedWait {}
  trait ResolveOaSharedRequest = ResolveAtom.traits.ResolveOaSharedRequest {}
  trait ResolveOaSharedHttp = ResolveAtom.traits.ResolveOaSharedHttp {}
  trait ResolveOaOwnWait = ResolveAtom.traits.ResolveOaOwnWait {}
  trait ResolveOaOwnRequest = ResolveAtom.traits.ResolveOaOwnRequest {}
  trait ResolveOaOwnHttp = ResolveAtom.traits.ResolveOaOwnHttp {}
  trait ResolveLmWait = ResolveAtom.traits.ResolveLmWait {}
  trait ResolveLmRequest = ResolveAtom.traits.ResolveLmRequest {}
  trait ResolveLmHttp = ResolveAtom.traits.ResolveLmHttp {}

  trait CatalogVectors -> CatalogVectorsRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      CATALOG_VECTORS_AGAIN -> listing when (> (array/len @entity.paths) 0)
        (behavior/catalog { paths: @entity.paths, exposure: @entity.exposure } {
          traits: @entity.traits
          texts: true
          emit: { success: CV_LISTED, failure: CV_FAILED }
        })
      CATALOG_VECTORS_AGAIN -> idle when (= (array/len @entity.paths) 0)
      CATALOG_VECTORS_ASK -> listing
        (set @entity.paths @payload.paths)
        (set @entity.exposure @payload.exposure)
        (set @entity.traits @payload.traits)
        (behavior/catalog { paths: @payload.paths, exposure: @payload.exposure } {
          traits: @payload.traits
          texts: true
          emit: { success: CV_LISTED, failure: CV_FAILED }
        })
    }

    state listing {
      INIT -> listing
      CV_LISTED -> texting
        (set @entity.rows @payload.result)
        (emit CV_ENTRY_TEXTS { rows: @payload.result })
      CV_FAILED -> idle
        (emit CATALOG_VECTORS_REFUSED { code: "ORB_CATALOG_UNREAD", detail: @payload.error })
    }

    state texting {
      INIT -> texting
      ENTRY_TEXTS_BUILT -> packaging
        (set @entity.wanted @payload.wanted)
        (behavior/packages { emit: { success: CV_PACKAGES, failure: CV_FAILED } })
      CV_FAILED -> idle
        (emit CATALOG_VECTORS_REFUSED { code: "ORB_CATALOG_UNREAD", detail: @payload.error })
    }

    state packaging {
      INIT -> packaging
      CV_PACKAGES -> sourcing
        (emit CV_SOURCES { paths: (array/map (array/filter @payload.result (fn p (and (array/some @entity.rows (fn r (= (array/first (str/split @r.behavior "/")) @p.prefix))) (!= (default @p.vectors "") "")))) (fn p { path: (default @p.vectors ""), in: (default @p.vectorsIn ""), rel: (default @p.vectorsRel "") })) })
      CV_FAILED -> idle
        (emit CATALOG_VECTORS_REFUSED { code: "ORB_CATALOG_UNREAD", detail: @payload.error })
    }

    state sourcing {
      INIT -> sourcing
      SOURCES_READY -> resolving
        (emit CV_RESOLVE { wanted: @entity.wanted, snapshots: @payload.snapshots, snapshotPaths: @payload.snapshotPaths, userDir: @payload.userDir, userAnchor: @payload.userAnchor, providerModel: @payload.providerModel, providerKind: @payload.providerKind, embedModel: @payload.embedModel })
      SOURCES_REFUSED -> idle
        (emit CATALOG_VECTORS_REFUSED { code: @payload.code, detail: @payload.detail })
    }

    state resolving {
      INIT -> resolving
      VECTORS_REFUSED -> idle
        (emit CATALOG_VECTORS_REFUSED { code: @payload.code, detail: @payload.detail })
      VECTORS_ANSWERED -> idle when (array/some @entity.rows (fn r (= (array/find @payload.vectors (fn v (= @v.key @r.behavior))) null)))
        (emit CATALOG_VECTORS_REFUSED { code: "ORB_VECTOR_ROW_UNEMBEDDED", detail: (str/concat "no vector for the description of " (object/get (default (array/find @entity.rows (fn r (= (array/find @payload.vectors (fn v (= @v.key @r.behavior))) null))) {}) "behavior" "")) })
      VECTORS_ANSWERED -> idle when (not (array/some @entity.rows (fn r (= (array/find @payload.vectors (fn v (= @v.key @r.behavior))) null))))
        (emit CATALOG_VECTORS_ROWS {
          model: @payload.model
          rows: (array/map @entity.rows (fn r (object/merge (object/pick @r ["behavior", "package", "topic", "level", "exposure", "pattern", "description", "capabilities", "traits", "value"]) { vectors: (default (object/fromEntries (array/concat [["description", (object/get (default (array/find @payload.vectors (fn v (= @v.key @r.behavior))) {}) "vector" [])]] (let ((hit (array/find @payload.vectors (fn v (= @v.key (str/concat @r.behavior "#capabilities")))))) (if (= @hit null) [] [["capabilities", @hit.vector]])))) {}) })))
        })
    }

    emits {
      CV_ENTRY_TEXTS {
        rows : [CatalogFactsRow]!
      }
        @description "Internal: ask std-behavior-texts for the embedding texts of these catalog rows."
        @tier "internal"
      CV_SOURCES {
        paths : [{ path : string!, in : string!, rel : string! }]!
      }
        @description "Internal: ask std-vector-sources for the package snapshots and the configured provider."
        @tier "internal"
      CV_RESOLVE -> external {
        wanted : [WantedText]!
        snapshots : [bytes]!
        snapshotPaths : [string]
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string
        embedModel : string
      }
        @description "Internal: ask std-vector-resolve for the vectors of the wanted texts."
        @tier "internal"
      CATALOG_VECTORS_ROWS -> external {
        rows : [CatalogVectorRow]!
        model : string!
      }
        @description "The catalog rows asked for, each with its description vector and, when the behavior declares capabilities, its capabilities vector, and the model that made them."
        @synonyms "catalog with vectors, rows with embeddings"
        @tier "primary"
      CATALOG_VECTORS_REFUSED -> external {
        code : string!
        detail : string!
      }
        @description "The rows cannot be answered with vectors: the catalog or a package cannot be read, a row's description has no vector, no store holds a vector and no provider is configured, or the provider failed. The code names which."
        @tier "primary"
    }

    listens {
      CatalogVectorsStatus.STATUS_READ_AGAIN -> CATALOG_VECTORS_AGAIN
      CATALOG_VECTORS_AGAIN { }
        @description "Read the folders of the last ask again; nothing was asked yet does nothing."
      CATALOG_VECTORS_ASK -> input {
        paths : [string]!
        exposure : [string]!
        traits : boolean!
      }
        @description "List the behaviors under these registry folders (narrowed by exposure) with their vectors."
        @synonyms "catalog with vectors, search index rows"
      CV_LISTED {
        result : [CatalogFactsRow]!
      }
      CV_PACKAGES {
        result : [CatalogPackage]!
      }
      CV_FAILED {
        error : string!
      }
      CvTexts.ENTRY_TEXTS_BUILT -> ENTRY_TEXTS_BUILT
      ENTRY_TEXTS_BUILT {
        organism : [{ key : string!, text : string!, hash : string! }]!
        capability : [{ key : string!, text : string!, hash : string! }]!
        wanted : [WantedText]!
      }
      CvSources.SOURCES_READY -> SOURCES_READY
      SOURCES_READY {
        snapshots : [bytes]!
        snapshotPaths : [string]!
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string!
        embedModel : string!
      }
      CvSources.SOURCES_REFUSED -> SOURCES_REFUSED
      SOURCES_REFUSED {
        code : string!
        detail : string!
      }
      CvResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      CvResolve.VECTORS_REFUSED -> VECTORS_REFUSED
      VECTORS_ANSWERED {
        model : string!
        vectors : [KeyedVector]!
      }
      VECTORS_REFUSED {
        code : string!
        detail : string!
      }
    }
  }

  entity CatalogVectorsStatusRun [runtime] {
    id : string!
    count : number = 0
    model : string = ""
    refusal : string = ""
  }

  trait CatalogVectorsStatus -> CatalogVectorsStatusRun {
    initial: showing

    state showing {
      INIT -> showing
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: sm, children: [{ type: typography, variant: h2, content: "Installed behaviors" }, { type: typography, variant: body, color: muted, content: "They are read with their vectors when something asks for them." }] }] })
      StatusRows -> showing
        (set @entity.count (array/len ?rows))
        (set @entity.model ?model)
        (set @entity.refusal "")
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: sm, children: [{ type: typography, variant: h2, content: "Installed behaviors" }, { type: typography, variant: body, content: (str/concat (array/len ?rows) " behaviors were read with their vectors, made with " ?model ".") }, { type: button, label: "Read again", variant: secondary, size: sm, action: STATUS_AGAIN }] }] })
      STATUS_AGAIN -> showing
        (emit STATUS_READ_AGAIN {})
      StatusRefused -> showing
        (set @entity.refusal ?detail)
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: sm, children: [{ type: typography, variant: h2, content: "Installed behaviors" }, { type: alert, variant: error, message: (str/concat "They could not be read with their vectors (" ?code "): " ?detail) }, { type: button, label: "Read again", variant: secondary, size: sm, action: STATUS_AGAIN }] }] })
    }

    emits {
      STATUS_READ_AGAIN -> external { }
        @description "Read the same registry folders again."
    }

    listens {
      STATUS_AGAIN { }
      CatalogVectors.CATALOG_VECTORS_ROWS -> StatusRows
      CatalogVectors.CATALOG_VECTORS_REFUSED -> StatusRefused
      StatusRows {
        rows : [CatalogVectorRow]!
        model : string!
      }
      StatusRefused {
        code : string!
        detail : string!
      }
    }
  }

  page "/catalog-vectors" as CatalogVectorsPage -> CatalogVectors, CvTexts, CvSources, CvResolve, CvStore, CvWrite, CvQuantize, CvF32, CvSig6, CvBigCmp, CvDelay, ResolveLlmOrShared, ResolveLlmOrOwn, ResolveLlmOaShared, ResolveLlmOaOwn, ResolveLlmLm, ResolveOrSharedWait, ResolveOrSharedRequest, ResolveOrSharedHttp, ResolveOrOwnWait, ResolveOrOwnRequest, ResolveOrOwnHttp, ResolveOaSharedWait, ResolveOaSharedRequest, ResolveOaSharedHttp, ResolveOaOwnWait, ResolveOaOwnRequest, ResolveOaOwnHttp, ResolveLmWait, ResolveLmRequest, ResolveLmHttp, CatalogVectorsStatus
}
