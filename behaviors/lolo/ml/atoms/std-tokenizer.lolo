app std-tokenizer [
  version: "1.0.0",
  description: "std-tokenizer — a text-preprocessing atom for tokenization. Splits raw text into a token sequence using a configurable method (whitespace, character, or arbitrary delimiter), normalizes and truncates the sequence, then maps each token to a vocabulary id (falling back to unkId when the token is absent from config.vocab). Feeds downstream embedding or sequence-model atoms. Pure circuit logic: str/* and array/* operators only, no ML compute, no model call."
]

orbital MlTokenizerOrbital {

  ;; The caller-supplied request, kept so a composing ladder (e.g. std-escalating-decision)
  ;; can project its own inputs out of it.
  type DecisionRequest = {
    candidate  : string!
    key        : string!
    accepted   : [string]!
    categories : [string]!
  }

  entity TokenSequence [runtime] {
    text       : string  = ""
    tokens     : [string] = []
    tokenIds   : [int]    = []
    tokenCount : number   = 0
    request    : DecisionRequest = {}
    status     : "idle" | "checked" = idle
  }

  trait TokenizerRun -> @rebindable TokenSequence [client] {
    initial: idle

    config {
      method : "whitespace" | "character" | "delimiter" | "bpe" = whitespace
        @label "Method"
        @description "Whitespace splits on single spaces, character splits into individual characters, delimiter splits on config.delimiter, bpe splits each space-separated word into characters and applies config.merges in order"
        @tier "policy"
      merges : [[string]] = []
        @label "BPE merges"
        @description "Ordered byte-pair merge rules for method bpe; each rule is a pair [left, right] and every adjacent left,right pair in a word becomes one symbol, rule by rule, left to right"
        @tier "domain"
      endOfWord : string = ""
        @label "End-of-word marker"
        @description "Symbol appended to every word before bpe merges are applied; empty adds none"
        @tier "domain"
      delimiter : string = ","
        @label "Delimiter"
        @description "Split delimiter used when method is delimiter; ignored otherwise"
        @tier "domain"
      lowercase : boolean = true
        @label "Lowercase"
        @description "Lowercase every token before vocabulary lookup"
        @tier "policy"
      trimWhitespace : boolean = true
        @label "Trim whitespace"
        @description "Trim each token and drop tokens that are empty afterward"
        @tier "policy"
      maxLength : int = 512
        @label "Max length"
        @description "Truncate the token sequence to at most this many tokens"
        @tier "policy"
      vocab : Map string number = {}
        @label "Vocabulary"
        @description "Token-to-id map; a token absent from this map resolves to unkId"
        @tier "domain"
      unkId : number = 0
        @label "Unknown token id"
        @description "Id assigned to a token that is not present in config.vocab"
        @tier "policy"
    }

    state idle {
      INIT -> idle
        (set @entity.text "")
        (set @entity.tokens [])
        (set @entity.tokenIds [])
        (set @entity.tokenCount 0)
        (set @entity.request {})
        (set @entity.status idle)

      TOKENIZE -> checked
        (let ((split (if (== @config.method "character")
                        (str/split ?text "")
                        (if (== @config.method "bpe")
                          (array/flatten (array/map (array/filter (str/split ?text " ") (fn w (> (str/len @w) 0)))
                            (fn w (array/reduce @config.merges
                              (array/concat (str/split (if @config.lowercase (str/lower @w) @w) "") (if (== @config.endOfWord "") [] (list @config.endOfWord)))
                              (fn syms m (array/reduce @syms []
                                (fn acc s (if (and (> (array/len @acc) 0) (== (array/last @acc) (default (array/nth @m 0) "")) (== @s (default (array/nth @m 1) "")))
                                  (array/append (array/dropLast @acc 1) (str/concat (default (array/nth @m 0) "") (default (array/nth @m 1) "")))
                                  (array/append @acc @s)))))))))
                          (str/split ?text (if (== @config.method "delimiter") @config.delimiter " ")))))
              (trimmed (if @config.trimWhitespace (array/map @split (fn t (str/trim @t))) @split))
              (normalized (if @config.lowercase (array/map @trimmed (fn t (str/lower @t))) @trimmed))
              (nonEmpty (array/filter @normalized (fn t (> (str/len @t) 0))))
              (truncated (array/slice @nonEmpty 0 @config.maxLength))
              (ids (array/map @truncated (fn t (object/get @config.vocab @t @config.unkId)))))
          (do
            (set @entity.text ?text)
            (set @entity.tokens @truncated)
            (set @entity.tokenIds @ids)
            (set @entity.tokenCount (array/len @truncated))
            (set @entity.request ?request)
            (set @entity.status checked)
            (emit TOKENIZED { tokens: @entity.tokens, tokenIds: @entity.tokenIds, tokenCount: @entity.tokenCount })))
    }

    state checked {
      INIT -> checked
        (set @entity.status checked)
      RESET -> idle
        (set @entity.text "")
        (set @entity.tokens [])
        (set @entity.tokenIds [])
        (set @entity.tokenCount 0)
        (set @entity.request {})
        (set @entity.status idle)
    }

    emits {
      TOKENIZED -> external {
        tokens : [string]!
        tokenIds : [int]!
        tokenCount : number!
      }
        @description "Text tokenized into a normalized, truncated token sequence with vocabulary ids"
        @tier "primary"
    }

    listens {
      TOKENIZE {
        text : string!
        request : DecisionRequest
      }
    }
  }

  page boot as MlTokenizerOrbitalStart -> TokenizerRun
}
