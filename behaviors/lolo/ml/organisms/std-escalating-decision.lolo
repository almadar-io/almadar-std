app std-escalating-decision [
  version: "1.0.0",
  description: "std-escalating-decision — the intelligence ladder itself, as one reusable composition. One request enters at DECIDE and falls through the rungs in order — R0 exact check, R1 table lookup, R3 retrieval, R4 learned inference, R5 generative classification — each rung handing off to the next by abstaining, until one proves the answer. Exits DECIDED, tagged with which rung answered (rung, confidence, matched, reasoning), or DECISION_FAILED if even the generative floor could not serve it. The escalation is a chain, not a hub: each rung listens directly to the rung above it and projects its own inputs out of the carried request, so the trait graph is a DAG and no event ever returns to a rung that already ran. Domain-agnostic: it knows about candidates and categories, not students or quizzes — grading, routing, matching, moderation, and duplicate detection are all this same molecule with different knobs. R2 (the Beta posterior) is deliberately not in this chain: it is the 'decide what to do next' half of a turn and already lives in std-knowledge-tracing."
  egress: ["http://localhost:3000"],
  net: { "openrouter.ai:443": [tcp], "api.openai.com:443": [tcp] },
]

;; @exposure both
orbital EscalatingDecisionOrbital {
  uses Ladder from "std/behaviors/std-ml-ladder"
  uses Rung0 from "std/behaviors/std-ml-exact-check"
  uses Rung1 from "std/behaviors/std-ml-lookup"
  uses Rung3 from "std/behaviors/std-ml-similarity"
  uses Rung4 from "std/behaviors/std-ml-infer"
  uses Rung5 from "std/behaviors/std-ml-classify"
  uses Delay from "std/behaviors/std-delay"
  uses Req from "std/behaviors/std-http-request"
  uses Http from "std/behaviors/std-http-client"

  ;; The whole DECIDE payload, echoed untouched down the chain so each rung
  ;; can project its own inputs out of it (object/get "accepted"/"categories"/"candidate").
  type DecisionRequest = {
    candidate  : string!
    key        : string!
    candidateNumber : number
    keyNumber  : number
    accepted   : [string]!
    categories : [string]!
  }

  ;; Mirrors @almadar/core's ContractViolation (ml-contract.ts) — the shape
  ;; contract/violations actually returns for R4's outputContract guard.
  type ContractShapeMismatch = { type : "shape_mismatch", expected : [int]!, actual : [int]! }
  type ContractRangeViolation = { type : "range_violation", dim : int!, min : float!, max : float!, actualMin : float!, actualMax : float! }
  type ContractNotATensor = { type : "not_a_tensor", actualType : string! }
  type ContractViolation = ContractShapeMismatch | ContractRangeViolation | ContractNotATensor

  ;; The entry holds no request data: the whole DECIDE payload travels down
  ;; the chain as `request`, so there is nothing for this trait to remember.
  entity LadderRequest [runtime] {
    status : "idle" | "dispatched" = idle
  }

  ;; `matched` is deliberately absent: it is an exact key, a table entry, a
  ;; match index, a tensor, or a category label depending on which rung served
  ;; the request. `any` is honest in payload position but lowers to `string` in
  ;; entity position (C-LOLO-ANY-LOWERS-TO-STRING), so the value is carried on
  ;; the DECIDED payload only, never mirrored onto this entity as a lie.
  entity LadderVerdict [runtime] {
    rung       : string = ""
    confidence : number = 0
    reasoning  : string = ""
    failReason : string = ""
    status     : "idle" | "decided" | "failed" = idle
  }

  entity ExactCheck [runtime] {
    matched : boolean = false
    status  : "idle" | "checked" = idle
  }

  entity KeyLookup [runtime] {
    matched : boolean = false
    status  : "idle" | "checked" = idle
  }

  entity SimilarityComparison [runtime] {
    query            : string    = ""
    candidates       : [string]  = []
    embeddings       : [[float]] = []
    queryVector      : [float]   = []
    candidateVectors : [[float]] = []
    matchIndex       : int       = 0
    matchScore       : float     = 0
    matchMargin      : float     = 0
    reason           : string    = ""
    request          : DecisionRequest = {}
    status           : "idle" | "embedding" | "resolved" = idle
  }

  entity Inference [runtime] {
    input      : Map string string    = {}
    output     : [float]              = []
    confidence : float                = 0
    violations : [ContractViolation]  = []
    reason     : string               = ""
    request    : DecisionRequest      = {}
    status     : "idle" | "inferring" | "resolved" = idle
  }

  entity ClassifierVerdict [runtime] {
    text         : string   = ""
    category     : string   = ""
    confidence   : float    = 0
    reasoning    : string   = ""
    errorMessage : string   = ""
    request      : DecisionRequest = {}
    status       : "idle" | "classifying" | "done" = idle
  }

  trait LadderEntry :: r DecisionRequest = Ladder.traits.LadderEntry -> LadderRequest {
    listens {
      RESET {}
      DECIDE -> input {
        candidate  : string!
        key        : string!
        candidateNumber : number
        keyNumber  : number
        accepted   : [string]!
        categories : [string]!
      }
        @description "Public entry point — decide the candidate, falling through the ladder until a rung can prove the answer. accepted is R1's table; categories is R3's comparison set (R5's closed label set is the ClassifyRung categories knob, a design-time decision rather than a per-request one)."
        @tier "primary"
    }
  }

  trait ExactRung :: r DecisionRequest = Rung0.traits.ExactCheckRun -> ExactCheck {
    listens {
      LadderEntry.RUNGS_RESET -> RESET
      LadderEntry.RUN_EXACT -> CHECK
    }
  }

  trait LookupRung :: e string r DecisionRequest = Rung1.traits.LookupRun -> KeyLookup {
    listens {
      LadderEntry.RUNGS_RESET -> RESET
      ExactRung.EXACT_UNMATCHED -> LOOKUP
        with { candidate: ?candidate, accepted: (object/get ?request "accepted"), request: ?request }
    }
  }

  trait SimilarityRung = Rung3.traits.SimilarityRun -> SimilarityComparison {
    listens {
      LadderEntry.RUNGS_RESET -> RESET
      ClassifyLlm.LLM_EMBED_RESULT -> EMBEDDED
      ClassifyLlm.LLM_FAILED -> EMBED_FAILED
      EMBEDDED {
        embeddings : [[number]]!
      }
      EMBED_FAILED {
        code : string
        message : string!
      }
      LookupRung.KEY_MISS -> COMPARE
        with { query: (str/concat ?candidate), candidates: (object/get ?request "categories"), request: ?request }
    }
  }

  trait InferRung = Rung4.traits.InferenceRun -> Inference {
    listens {
      LadderEntry.RUNGS_RESET -> RESET
      InferMl.ML_INFERRED -> INFERRED_RAW
      InferMl.ML_INFER_FAILED -> INFER_CALL_FAILED
      INFERRED_RAW {
        output     : [float]!
        confidence : number!
      }
      INFER_CALL_FAILED {
        code : string
        message : string!
      }
      SimilarityRung.SIMILARITY_ABSTAINED -> INFER
        with { input: { candidate: (object/get ?request "candidate"), key: (object/get ?request "key") }, request: ?request }
    }
  }

  trait ClassifyRung = Rung5.traits.ClassifyRun -> ClassifierVerdict {
    listens {
      LadderEntry.RUNGS_RESET -> RESET
      ClassifyLlm.LLM_CLASSIFY_RESULT -> CLASSIFIED_RAW
      ClassifyLlm.LLM_FAILED -> CLASSIFY_CALL_FAILED
      CLASSIFIED_RAW {
        category   : string!
        confidence : number!
        reasoning  : string!
      }
      CLASSIFY_CALL_FAILED {
        code : string
        message : string!
      }
      InferRung.INFER_ABSTAINED -> CLASSIFY
        with { text: (str/concat (object/get ?request "candidate")), request: ?request }
    }
  }

  trait InferMl = Rung4.traits.InferMl {
    listens {
      InferRung.ML_INFER -> ML_INFER
    }
  }

  trait ClassifyLlm = Rung5.traits.ClassifyLlm {
    listens {
      ClassifyRung.LLM_CLASSIFY -> LLM_CLASSIFY
      SimilarityRung.LLM_EMBED -> LLM_EMBED
      EscEmbedWait.ESC_EMBED_WAITED -> LLM_EMBED_WAITED
      EscEmbedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      EscEmbedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      EscEmbedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
      ClassifyChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      ClassifyChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      ClassifyChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
    }
  }

  trait EscEmbedWait = Delay.traits.Delay {
    events {
      ELAPSED: ESC_EMBED_WAITED
    }
    listens {
      ClassifyLlm.LLM_EMBED_WAIT -> START
    }
  }

  trait EscEmbedRequest = Req.traits.HttpRequest {
    listens {
      ClassifyLlm.LLM_EMBED_WIRE -> HTTP_REQUEST
      ClassifyLlm.LLM_EMBED_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      EscEmbedHttp.HTTP_REPLIED -> HTTP_REPLIED
      EscEmbedHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait EscEmbedHttp = Http.traits.HttpClient {
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "EMBEDDING_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      EscEmbedRequest.HTTP_SEND -> HTTP_SEND
      EscEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }
  trait ClassifyChatRequest = Rung5.traits.ClassifyChatRequest {}
  trait ClassifyChatHttp = Rung5.traits.ClassifyChatHttp {}

  ;; The sink. Listens to every rung's success plus the generative floor's
  ;; failure, and emits the one public verdict. Nothing listens to it, so it
  ;; closes the DAG.
  trait LadderVerdictSink = Ladder.traits.LadderVerdictSink -> LadderVerdict {
    listens {
      RESET {}
      FROM_EXACT { key : string! }
      FROM_LOOKUP { entry : string! }
      FROM_SIMILARITY { index : int!  score : number! }
      FROM_INFER { output : [float]!  confidence : number! }
      FROM_CLASSIFY { category : string!  confidence : number!  reasoning : string! }
      FROM_CLASSIFY_FAILURE { error : string! }
      ExactRung.EXACT_MATCHED -> FROM_EXACT
        with { key: ?key }
      LookupRung.KEY_HIT -> FROM_LOOKUP
        with { entry: ?entry }
      SimilarityRung.SIMILARITY_MATCHED -> FROM_SIMILARITY
        with { index: ?index, score: ?score }
      InferRung.INFERRED -> FROM_INFER
        with { output: ?output, confidence: ?confidence }
      ClassifyRung.CLASSIFIED -> FROM_CLASSIFY
        with { category: ?category, confidence: ?confidence, reasoning: ?reasoning }
      ClassifyRung.CLASSIFY_FAILED -> FROM_CLASSIFY_FAILURE
        with { error: ?error }
    }
  }

  page "/ladder/decide" as LadderDecidePage -> LadderEntry, ExactRung, LookupRung, SimilarityRung, InferRung, InferMl, ClassifyRung, ClassifyLlm, EscEmbedWait, EscEmbedRequest, EscEmbedHttp, ClassifyChatRequest, ClassifyChatHttp, LadderVerdictSink
}
