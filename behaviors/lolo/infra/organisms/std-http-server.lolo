app std-http-server [
  version: "1.0.0",
  env: ["CORS_ORIGIN"],
  net: { "127.0.0.1:3000": [listen] },
  description: "std-http-server — the HTTP server program that replaces orbital-server, first slice, composed from atoms and owning no topology of its own. std-http-policy reads CORS_ORIGIN at boot (a comma list, trimmed, blanks dropped) and answers CORS_CONFIGURED, which tells std-http1 to bind the host and port knobs. std-http1 reads each connection and delivers one typed request; std-http-router asks std-http-policy to decide it (a preflight and a 413 are answered at once), counts an /api request in std-rate-limiter (ADMITTED or THROTTLED, a throttled one is 429 with ratelimit-* headers), routes it by method and path (GET /api/health answers 200 { status, version }, every other path 404 { error, code }) and hands the answer back to std-http1 as RESPOND. Requests are correlated by requestId, so any number are in flight at once. Bound to spec/infra/server.lolo. The other routes, the bearer guard, hooks, SSE and static files are not in this slice."
]
uses Spec from "almadar-std/server"
uses H1 from "std/behaviors/std-http1"
uses Policy from "std/behaviors/std-http-policy"
uses Rate from "std/behaviors/std-rate-limiter"
uses Router from "std/behaviors/std-http-router"
orbital HttpServerOrbital {
  entity HttpServerProgram [runtime] {
    id : string!
  }

  trait Http1 = H1.traits.Http1 {
    listens {
      ServerPolicy.CORS_CONFIGURED -> LISTEN
      ServerRouter.RESPOND -> RESPOND
      Http1HeadSearch.INDEX_OF_ANSWERED -> HEAD_SEARCHED
    }
  }

  trait Http1HeadSearch = H1.traits.Http1HeadSearch {
    listens {
      Http1.HEAD_SEARCH -> INDEX_OF
    }
  }

  trait ServerPolicy = Policy.traits.HttpPolicy {
    listens {
      ServerRouter.HTTP_DECIDE -> HTTP_DECIDE
    }
  }

  trait ServerRateLimiter = Rate.traits.RateBucketRateLimiter {
    config {
      enabled: true
      requestsPerMinute: 300
      windowSeconds: 900
    }
    listens {
      ServerRouter.RATE_REQUEST -> REQUEST
    }
  }

  trait ServerRouter = Router.traits.HttpRouter {
    listens {
      Http1.REQUEST_RECEIVED -> REQUEST_RECEIVED
      ServerPolicy.HTTP_DECIDED -> HTTP_DECIDED
      ServerRateLimiter.ADMITTED -> ADMITTED
      ServerRateLimiter.THROTTLED -> THROTTLED
    }
  }

  page "/server" as HttpServerPage -> Http1, Http1HeadSearch, ServerPolicy, ServerRateLimiter, ServerRouter
}
