app std-cross-reference "1.0.0"
"std-cross-reference — join-table primitive for N:M relationships. Listens for LinkRequested/UnlinkRequested/FETCH_LINKS_FOR and manages the junction collection (default CrossRefLink [persistent: cross_ref_links]). Rebind via linkedEntity={YourJunction} to your consumer junction; if your junction's id fields differ from leftId/rightId, override them with fields{} renames at the call site. A rebind target must supply leftId, rightId, createdAt, filteredLinks. Emits LinkCreated, LinkRemoved, LinksLoaded as external broadcasts for downstream consumers."
type LinkSpec = { label : string!, href : string!, icon : string }
type ObjectSpec = { id : string, label : string, value : string }
orbital CrossReferenceOrbital {
    type LinkRequested = Event { leftId : string, rightId : string } "Request to create a link between leftId and rightId."

    type UnlinkRequested = Event { leftId : string, rightId : string } "Request to delete the link between leftId and rightId."

    type FETCH_LINKS_FOR = Event { leftId : string } "Request the link set for a given leftId."

    type LinkCreated = Event { row : @entity } "Fired after a junction row is persisted."

    type LinkRemoved = Event { leftId : string, rightId : string } "Fired after a junction row is deleted."

    type LinksLoaded = Event { leftId : string, data : [ObjectSpec] } "Fired after junction rows for leftId are fetched."

    type LinkOpFailed = Event { error : string, code : string } "Fired when a junction persist or fetch fails."

    type LinksFetched = Event { data : [ObjectSpec] } "Internal: raw fetch result before filtering by leftId."

  entity CrossRefLink [persistent: cross_ref_links] {
    id : string!
    leftId : string @description "Identifier for the related entity on the left side." @synonyms "sourceId, originId, parentId" = ""
    rightId : string @description "Identifier for the related entity on the right side." @synonyms "targetId, relatedId, counterpartId" = ""
    createdAt : string = ""
    filteredLinks : [LinkSpec] @description "A list of filtered link specifications." @synonyms "links, references, connections" = []
  }

  trait CrossReferenceGate -> @rebindable CrossRefLink [lifecycle, instance] {
    initial: idle

    state idle {
      LinkRequested -> idle
        (persist create CrossRefLink { leftId: ?leftId, rightId: ?rightId } {
          emit: { failure: LinkOpFailed, success: LinkCreated }
        })
      UnlinkRequested -> idle
        (persist delete CrossRefLink ? {
          emit: { failure: LinkOpFailed, success: LinkRemoved }
        })
      FETCH_LINKS_FOR -> idle
        (set @entity.leftId ?leftId)
        (fetch CrossRefLink {
          emit: { failure: LinkOpFailed, success: LinksFetched }
        })
      LinksFetched -> idle
        (set @entity.filteredLinks (array/filter ?data (fn row ["=", (object/get @row leftId), @entity.leftId])))
        (emit LinksLoaded { data: @entity.filteredLinks, leftId: @entity.leftId })
    }

    emits {
      LinkCreated -> external { row : @entity }
      LinkRemoved -> external {
        leftId : string
        rightId : string
      }
      LinksLoaded -> external {
        leftId : string
        data : [ObjectSpec]
      }
      LinksFetched -> external {
        data : [ObjectSpec]
      }
      LinkOpFailed -> external {
        error : string
        code : string
      }
    }

    listens {
      LinkRequested {
        leftId : string
        rightId : string
      }
      UnlinkRequested {
        leftId : string
        rightId : string
      }
      FETCH_LINKS_FOR {
        leftId : string
      }
      LinksFetched {
        data : [ObjectSpec]
      }
    }

    config {}
  }

  page "/cross-reference" as CrossReferencePage -> CrossReferenceGate
}