            (let ((n (array/len @data)))
              (array/map (array/sort (array/map @data (fn x (+ (* (object/get @x index 0) @n) @index)))) (fn k (object/get (array/nth @data (math/mod @k @n)) embedding []))))),
          usage: { promptTokens: (object/get (object/get (json/parse @payload.body EmbedReply) usage {}) prompt_tokens 0), totalTokens: (object/get (object/get (json/parse @payload.body EmbedReply) usage {}) total_tokens 0) },
          key: (object/get (json/parse @payload.key EmbedJob) callKey ""),
          model: (object/get (json/parse @payload.key EmbedJob) model "")
        })
        (emit LLM_USAGE_REPORTED {
          provider: @config.embedProvider,
          model: (object/get (json/parse @payload.key EmbedJob) model ""),
          action: "embed",
          inputTokens: (object/get (object/get (json/parse @payload.body EmbedReply) usage {}) prompt_tokens null)
        })
      LLM_EMBED_ERROR -> idle when (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))
        (emit LLM_FAILED { code: null, message: @payload.message, key: (object/get (json/parse @payload.job EmbedJob) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (= @payload.status 429) (>= (object/get (json/parse @payload.job EmbedJob) limited 0) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_FAILED { code: null, message: @payload.message, key: (object/get (json/parse @payload.job EmbedJob) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (= @payload.status 429) (< (object/get (json/parse @payload.job EmbedJob) limited 0) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_EMBED_SEND {
          job: (let ((j (json/parse @payload.job EmbedJob))) (json/stringify { generic: @j.generic, limited: (+ @j.limited 1), model: @j.model, texts: @j.texts, callKey: (object/get @j callKey ""), delayMs: (if (!= (object/get @payload retryAfterMs null) null) (object/get @payload retryAfterMs null) (array/nth [2000, 5000, 15000] @j.limited)) }))
        })
      LLM_EMBED_ERROR -> idle when (and (!= @payload.status 429) (>= (+ (object/get (json/parse @payload.job EmbedJob) generic 0) 1) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_FAILED { code: null, message: @payload.message, key: (object/get (json/parse @payload.job EmbedJob) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (!= @payload.status 429) (< (+ (object/get (json/parse @payload.job EmbedJob) generic 0) 1) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_EMBED_SEND {
          job: (let ((j (json/parse @payload.job EmbedJob))) (json/stringify { generic: (+ @j.generic 1), limited: @j.limited, model: @j.model, texts: @j.texts, callKey: (object/get @j callKey ""), delayMs: (array/nth [500, 2000] @j.generic) }))
        })
    }

    emits {
      LLM_GENERATE_RESULT -> external {
        content : string!
        usage : { promptTokens : number!, completionTokens : number!, totalTokens : number! }!
      }
        @description "The generated text and its token usage; the usage is zero when the provider reports none."
        @synonyms "completion, model reply, generated text"
        @tier "primary"
      LLM_USAGE_REPORTED -> external {
        provider : string!
        model : string!
        action : string!
        inputTokens : number
        outputTokens : number
      }
        @description "The token counts one provider reply reported, with the provider and the requested model; a count the provider did not report is absent, never zero. The kernel trace records it with the dispatch."
        @synonyms "token usage, usage report, tokens spent"
        @tier "secondary"
      LLM_GENERATE_DELTA -> external {
        key : string
        delta : string!
        text : string!
      }
        @description "A chunk of a streamed generate: the text that just arrived and the reply so far, under the call's key. Fires only for an LLM_GENERATE sent with stream true; the final LLM_GENERATE_RESULT follows."
        @synonyms "streamed text, reply chunk, token stream"
        @tier "secondary"
      LLM_CLASSIFY_RESULT -> external {
        category : string!
        confidence : number!
        reasoning : string!
      }
        @description "The declared category the model chose for the text, its confidence from 0 to 1 and its reasoning."
        @synonyms "classification, label, category verdict"
        @tier "primary"
      LLM_CLASSIFY_MANY_RESULT -> external {
        verdicts : [{ id : string!, category : string!, confidence : number! }]!
      }
        @description "One verdict per item, under the caller's id, with a declared category and a confidence from 0 to 1."
        @synonyms "batch classification, many labels, verdicts"
        @tier "primary"
      LLM_SUMMARIZE_RESULT -> external {
        summary : string!
        keyPoints : [string]!
      }
        @description "A summary of the text and its key points."
        @synonyms "summary, digest, key points"
        @tier "primary"
      LLM_EMBED_RESULT -> external {
        embeddings : [[number]]!
        usage : { promptTokens : number!, totalTokens : number! }
        key : string
        model : string
      }
        @description "One embedding vector per input text, in input order, the provider's token usage (zero when it reports none), the key the request carried (empty when it carried none) and the model that made the vectors."
        @synonyms "vectors, text embeddings"
        @tier "primary"
      LLM_CHOOSE_RESULT -> external {
        choice : string!
        confidence : number!
      }
        @description "The option value Jev chose and its confidence."
        @synonyms "decision, pick, chosen option"
        @tier "primary"
      LLM_EXTRACT_RESULT -> external {
        json : string!
      }
        @description "The JSON text the model extracted, for the caller to read with json/parse under its own shape."
        @synonyms "extracted data, structured data, parsed fields"
        @tier "primary"
      LLM_CALL_TOOLS_RESULT -> external {
        reply : string!
        steps : [LlmStep]!
        usage : ToolsUsage!
      }
        @description "The model's final reply, every step of the run (each model call, each tool call and its answer) and the tokens used."
        @synonyms "agent reply, tool loop answer"
        @tier "primary"
      LLM_TOOLS_REQUESTED -> external {
        session : string!
        calls : [{ id : string!, name : string!, arguments : string! }]!
      }
        @description "The model asked for these tool calls, in order. Run each and answer them all in one LLM_TOOLS_ANSWERED that carries `session` back unchanged."
        @synonyms "tool calls, function calls, tool request"
        @tier "primary"
      LLM_TOOLS_STEP -> external {
        activity : LlmStep!
      }
        @description "One step of a call-tools run, as it is recorded: a model call, a tool call or a tool answer."
        @synonyms "progress, trace step"
        @tier "primary"
      LLM_CANCELLED -> external {
        key : string!
      }
        @description "A keyed generate, classify, classifyMany, summarize, extract, embed or call-tools run was cancelled by LLM_CANCEL before it answered: the key it carried. It ends in no result and no LLM_FAILED, and a reply that arrives later is dropped."
        @synonyms "llm cancelled, request aborted"
        @tier "primary"
      LLM_FAILED -> external {
        code : string
        message : string!
        key : string
      }
        @description "A request that ended without an answer: the provider's error message, with a code when the atom or the model's reply is at fault (VALIDATION_ERROR, SERVICE_ERROR)."
        @synonyms "llm error, request failed"
        @tier "primary"
      LLM_CHAT_SEND {
        job : string!
      }
        @description "Internal: one chat attempt, carried as its JSON job."
        @tier "secondary"
      LLM_CHAT_DISPATCH {
        job : string!
        body : string!
      }
        @description "Internal: the provider-shaped request body."
        @tier "secondary"
      LLM_CHAT_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the chat call's HTTP reply."
        @tier "secondary"
      LLM_CHAT_HTTP_OK {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the chat call's HTTP reply, before the call leaves the in-flight list."
        @tier "secondary"
      LLM_CHAT_HTTP_FAILED {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the chat call never produced a reply."
        @tier "secondary"
      LLM_CHAT_HTTP_CANCELLED {
        key : string!
      }
        @description "Internal: the chat call was cancelled by LLM_CANCEL."
        @tier "secondary"
      LLM_CHAT_STREAM_MSG {
        data : string!
        event : string
        id : string
        key : string!
      }
        @description "Internal: one server-sent message of a streamed chat reply."
        @tier "secondary"
      LLM_CHAT_HTTP_ERROR {
        job : string!
        status : number!
        message : string!
        tool : boolean!
      }
        @description "Internal: a non-2xx chat reply read as the SDK message."
        @tier "secondary"
      LLM_CHAT_ERROR {
        job : string!
        message : string!
      }
        @description "Internal: a chat attempt that failed, before the retry decision."
        @tier "secondary"
      LLM_CHAT_CONTENT {
        job : string!
        content : string!
        inputTokens : number
        outputTokens : number
      }
        @description "Internal: the model's text and the token counts the provider reported (absent when it reported none)."
        @tier "secondary"
      LLM_CHAT_STRIPPED {
        job : string!
        text : string!
      }
        @description "Internal: the reply without thinking blocks."
        @tier "secondary"
      LLM_CHAT_JSON {
        job : string!
        json : string!
      }
        @description "Internal: the JSON text found in the reply, empty when none."
        @tier "secondary"
      LLM_CHAT_CHECKED {
        job : string!
        json : string!
        issues : string!
      }
        @description "Internal: the reply's schema issues, empty when it fits."
        @tier "secondary"
      LLM_CHAT_VERDICTS {
        job : string!
        json : string!
        problem : string!
      }
        @description "Internal: the classifyMany reply's item-label problem, empty when every item has one verdict."
        @tier "secondary"
      LLM_JEV_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the Jev decision call's HTTP reply."
        @tier "secondary"
      LLM_JEV_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the Jev decision call never produced a reply."
        @tier "secondary"
      LLM_JEV_CHECKED {
        key : string!
        body : string!
        problem : string!
      }
        @description "Internal: the Jev reply's problem, empty when it names a declared choice."
        @tier "secondary"
      LLM_TOOLS_SEND {
        session : string!
      }
        @description "Internal: the next model call of a tool run, carried as its JSON session."
        @tier "secondary"
      LLM_TOOLS_DISPATCH {
        session : string!
        body : string!
      }
        @description "Internal: the provider-shaped tool-calling request body."
        @tier "secondary"
      LLM_TOOLS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the tool-calling request's HTTP reply."
        @tier "secondary"
      LLM_TOOLS_CANCELLED {
        key : string!
      }
        @description "Internal: the tool-calling request was cancelled by LLM_CANCEL."
        @tier "secondary"
      LLM_TOOLS_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the tool-calling request never produced a reply."
        @tier "secondary"
      LLM_TOOLS_TURN {
        session : string!
      }
        @description "Internal: a model turn recorded in the session, before it is read as a reply or as tool calls."
        @tier "secondary"
      LLM_TOOLS_REPORT {
        session : string!
        index : number!
      }
        @description "Internal: steps still to report from this index, then the next model call."
        @tier "secondary"
      LLM_EMBED_SEND {
        job : string!
      }
        @description "Internal: one embeddings attempt, carried as its JSON job."
        @tier "secondary"
      LLM_EMBED_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the embeddings call's HTTP reply."
        @tier "secondary"
      LLM_EMBED_HTTP_OK {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the embeddings call's HTTP reply, before the call leaves the in-flight list."
        @tier "secondary"
      LLM_EMBED_HTTP_FAILED {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the embeddings call never produced a reply."
        @tier "secondary"
      LLM_EMBED_HTTP_CANCELLED {
        key : string!
      }
        @description "Internal: the embeddings call was cancelled by LLM_CANCEL."
        @tier "secondary"
      LLM_EMBED_KEY_PROBED {
        connected : boolean!
      }
        @description "Internal: whether the embeddings API key is configured, so a keyless provider such as LM Studio sends it when it is."
        @tier "secondary"
      LLM_EMBED_ERROR {
        job : string!
        message : string!
        status : number!
        retryAfterMs : number
      }
        @description "Internal: an embeddings attempt that failed, before the retry decision."
        @tier "secondary"
    }

    listens {
      LLM_EMBED_KEY_PROBED {
        connected : boolean!
      }
      LLM_GENERATE -> external {
        systemPrompt : string
        userPrompt : string!
        model : string
        temperature : number
        maxTokens : number
        key : string
        images : [{ mediaType : string!, data : string! }]
        stream : boolean
      }
        @description "Generate text from a prompt. An optional key names the call for LLM_CANCEL. With stream true the reply is read as it arrives and each chunk is announced as LLM_GENERATE_DELTA before the final LLM_GENERATE_RESULT; without it nothing changes."
        @synonyms "complete, chat, ask the model"
      LLM_CLASSIFY -> external {
        text : string!
        categories : [string]!
        model : string
        key : string
      }
        @description "Classify a text into one of the given categories. An optional key names the call for LLM_CANCEL."
        @synonyms "label text, categorize"
      LLM_CLASSIFY_MANY -> external {
        items : [{ id : string!, text : string! }]!
        categories : [string]!
        model : string
        key : string
      }
        @description "Classify many texts in one model call; every item's id comes back once with a declared category. An optional key names the call for LLM_CANCEL."
        @synonyms "batch classify, label many"
      LLM_SUMMARIZE -> external {
        text : string!
        maxLength : number
        style : string
        model : string
        key : string
      }
        @description "Summarize a text; style is bullet, detailed or concise (default), maxLength is a word limit."
        @synonyms "summarise, digest, condense"
      LLM_EMBED -> external {
        texts : [string]!
        model : string
        key : string
      }
        @description "Embed texts into vectors. An optional key names the call for LLM_CANCEL and is echoed on LLM_EMBED_RESULT and on the LLM_FAILED that ends it."
        @synonyms "vectorize, text embedding"
      LLM_CANCEL -> external {
        key : string!
      }
        @description "Abort the generate, classify, classifyMany, summarize, extract, embed or call-tools run that carries this key and is still waiting for its provider; it ends in LLM_CANCELLED. A key with nothing in flight is a no-op."
        @synonyms "abort, stop request, cancel call"
      LLM_CHOOSE -> external {
        state : string!
        instructions : string!
        options : [{ value : string!, description : string! }]!
      }
        @description "Choose one of at least two options with distinct values, by Jev's reading of the state."
        @synonyms "decide, pick an option, choose"
      LLM_EXTRACT -> external {
        text : string!
        schema : string!
        systemPrompt : string
        temperature : number
        maxTokens : number
        model : string
        key : string
        images : [{ mediaType : string!, data : string! }]
      }
        @description "Extract structured data from a text. An optional key names the call for LLM_CANCEL. `schema` is the JSON Schema text the reply must follow, sent to the model as written inside the built-in extractor prompt; an optional systemPrompt replaces that whole prompt (the schema is then not sent) and an optional temperature replaces the default 0.2. The answer is the JSON text, read by the caller with json/parse under its own shape."
        @synonyms "parse, structure, pull fields"
      LLM_CALL_TOOLS -> external {
        messages : [{ role : "user" | "assistant", content : string! }]!
        tools : [LlmToolDef]!
        instructions : string
        maxSteps : number
        model : string
        key : string
      }
        @description "Answer a conversation with tools (an optional key names the run for LLM_CANCEL, which aborts the model call at its provider): the model may ask for tool calls, which come back in LLM_TOOLS_REQUESTED for the caller to run and answer with LLM_TOOLS_ANSWERED, until the model replies or maxSteps (default 8) model calls are used."
        @synonyms "agent, tool use, function calling"
      LLM_TOOLS_ANSWERED -> external {
        session : string!
        results : [LlmToolOutcome]!
      }
        @description "The answers to one LLM_TOOLS_REQUESTED: one result per requested call, by id, with the `session` it carried."
        @synonyms "tool results, function results"
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports an unreachable LLM call; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      provider : "openai" | "anthropic" | "deepseek" | "kimi" | "openrouter" | "orbgen" | "masar" | "lmstudio" = openai
        @label "Chat provider"
        @description "The chat provider; it picks the wire format (Anthropic Messages or OpenAI chat completions), the keyless providers (lmstudio, orbgen) and the provider-specific body fields (kimi, openrouter)."
        @synonyms "llm provider, model vendor"
        @tier "infra"
      origin : url = "https://api.openai.com"
        @label "Chat origin"
        @description "The chat API origin (scheme://host, no path); it must be declared in the app egress list."
        @synonyms "api host, endpoint origin"
        @tier "infra"
      basePath : string = "/v1"
        @label "Chat base path"
        @description "The path before /chat/completions (or /messages for Anthropic), for example /v1 or /api/v1."
        @synonyms "api prefix, version path"
        @tier "infra"
      model : string = "gpt-4o"
        @label "Default chat model"
        @description "The model used when a request names none."
        @synonyms "default model, model id"
        @tier "infra"
      apiKey : secret = "OPENAI_API_KEY"
        @label "Chat API key"
        @description "The name of the host environment variable holding the chat API key."
        @synonyms "api key, credential"
        @tier "infra"
      timeoutMs : number = 300000
        @label "Request timeout (ms)"
        @description "Milliseconds each chat or embeddings request may take."
        @synonyms "timeout, request deadline"
        @tier "infra"
      embedProvider : "openrouter" | "openai" | "lmstudio" = openrouter
        @label "Embedding provider"
        @description "The embeddings provider; lmstudio is keyless."
        @synonyms "embedding vendor"
        @tier "infra"
      embedOrigin : url = "https://openrouter.ai"
        @label "Embeddings origin"
        @description "The embeddings API origin (scheme://host, no path); it must be declared in the app egress list."
        @synonyms "embedding host"
        @tier "infra"
      embedBasePath : string = "/api/v1"
        @label "Embeddings base path"
        @description "The path before /embeddings."
        @synonyms "embedding prefix"
        @tier "infra"
      embedModel : string = "baai/bge-base-en-v1.5"
        @label "Embedding model"
        @description "The embedding model used when a request names none."
        @synonyms "embedding model id"
        @tier "infra"
      jevOrigin : url = "https://openrouter.ai"
        @label "Jev origin"
        @description "The origin of the Jev decisions endpoint (scheme://host, no path); it must be declared in the app egress list."
        @synonyms "decision host"
        @tier "infra"
      jevApiKey : secret = "OPEN_ROUTER_API_KEY"
        @label "Jev API key"
        @description "The name of the host environment variable holding the key for the Jev decisions endpoint."
        @synonyms "decision credential"
        @tier "infra"
      embedApiKey : secret = "EMBEDDING_API_KEY"
        @label "Embeddings API key"
        @description "The name of the host environment variable holding the embeddings API key."
        @synonyms "embedding credential"
        @tier "infra"
    }
  }

  page "/llm" as LlmPage -> LlmClient
}
