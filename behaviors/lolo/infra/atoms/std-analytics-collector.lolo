app std-analytics-collector [
  version: "1.0.0",
  inbound: ["analytics"],
  description: "std-analytics-collector — the collector std-analytics reports to. A beacon (`{ n, d, u, r?, w?, p? }` JSON: event name, site, path, referrer, screen width, properties) arrives at the inbound hook analytics (/api/hooks/analytics) and is stored as an AnalyticsEvent whose visitorId is the SHA-256 of the day's salt, the client IP (the first x-forwarded-for address), the user agent and the site: stable within one UTC day, never reversible, and the IP itself is never stored. One random salt per UTC day lives in an AnalyticsSalt row created on the day's first beacon. The hook answers 202 for a stored beacon, 400 for one that is not a JSON object with a non-empty name, site and path (or whose site the domains knob does not list) and 500 when the store fails. ANALYTICS_STATS answers the pageviews, unique visitors and the top pages, countries and referrer hosts of a site and time window."
]
type AnalyticsProps = Map string (string | number | boolean)
type AnalyticsBeacon = { n : string, d : string, u : string, r : string, w : number, p : AnalyticsProps }
type AnalyticsDraft = { ts : number!, name : string!, domain : string!, path : string!, referrer : string, screenWidth : number, props : AnalyticsProps, ip : string!, ua : string! }
type AnalyticsCount = { key : string!, count : number! }
orbital AnalyticsCollectorOrbital {
  entity AnalyticsEvent [persistent: analyticsEvents] {
    id : string!
    ts : number! @description "When the beacon arrived, in epoch milliseconds."
    name : string! @description "The event name; pageview for a page visit."
    domain : string! @description "The site the beacon was reported under."
    path : string! @description "The page path."
    referrer : string @description "The page's referrer as the browser reported it."
    screenWidth : number @description "The screen width in CSS pixels."
    visitorId : string! @description "SHA-256 of the day's salt, the client IP, the user agent and the site."
    props : AnalyticsProps @description "The event's properties."
  }

  entity AnalyticsSalt [persistent: analyticsSalt] {
    id : string! @description "The UTC day, YYYY-MM-DD."
    salt : string! @description "The day's random salt."
    createdAt : number @description "When the salt was drawn, in epoch milliseconds."
  }

  entity AnalyticsCollector [runtime] {
    id : string!
    saltDay : string @description "The UTC day of the salt held in memory." = ""
    salt : string @description "That day's salt." = ""
    pending : AnalyticsDraft @description "The beacon waiting for the day's salt; its IP is held in memory only."
    statsLimit : number @description "The row limit of the stats query in flight." = 100
  }

  trait AnalyticsIntake -> AnalyticsCollector [integration, instance] {
    initial: ready

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the intake shows why a beacon could not be stored."
        @synonyms "status area, slot"
        @tier "presentation"
      domains : [string] = []
        @label "Accepted sites"
        @description "The sites beacons may be reported under; an empty list accepts every site."
        @synonyms "allowed domains, sites, hostnames"
        @tier "domain"
    }

    state ready {
      INIT -> ready

      BEACON_RECEIVED -> ready when (not (and (str/startsWith (json/stringify (json/parse @payload.rawBody AnalyticsBeacon)) "{") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u")) "\"") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u") "")))
        (emit BEACON_ANSWERED { status: 400, body: "{\"error\":\"invalid beacon\"}" })
      BEACON_RECEIVED -> ready when (and (str/startsWith (json/stringify (json/parse @payload.rawBody AnalyticsBeacon)) "{") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u")) "\"") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u") "") (> (array/len @config.domains) 0) (not (array/includes @config.domains (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d"))))
        (emit BEACON_ANSWERED { status: 400, body: "{\"error\":\"site not accepted\"}" })
      BEACON_RECEIVED -> ready when (and (str/startsWith (json/stringify (json/parse @payload.rawBody AnalyticsBeacon)) "{") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d")) "\"") (str/startsWith (json/stringify (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u")) "\"") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "n") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d") "") (!= (object/get (json/parse @payload.rawBody AnalyticsBeacon) "u") "") (or (= (array/len @config.domains) 0) (array/includes @config.domains (object/get (json/parse @payload.rawBody AnalyticsBeacon) "d"))))
        (let ((b (json/parse @payload.rawBody AnalyticsBeacon)))
          (emit BEACON_ACCEPTED { draft: {
            ts: @now,
            name: @b.n,
            domain: @b.d,
            path: @b.u,
            referrer: (if (str/startsWith (json/stringify @b.r) "\"") @b.r null),
            screenWidth: (if (validate/pattern (json/stringify @b.w) "^-?[0-9]") @b.w null),
            props: (if (str/startsWith (json/stringify @b.p) "{") @b.p null),
            ip: (str/trim (array/first (str/split (object/get @payload.headers "x-forwarded-for" "") ","))),
            ua: (object/get @payload.headers "user-agent" "")
          } }))

      BEACON_ACCEPTED -> ready when (= @entity.saltDay (time/format @payload.draft.ts "YYYY-MM-DD"))
        (persist create AnalyticsEvent { ts: @payload.draft.ts, name: @payload.draft.name, domain: @payload.draft.domain, path: @payload.draft.path, referrer: @payload.draft.referrer, screenWidth: @payload.draft.screenWidth, props: @payload.draft.props, visitorId: (hash/sha256 (str/concat @entity.salt ":" @payload.draft.ip ":" @payload.draft.ua ":" @payload.draft.domain) "hex") } { emit: { success: EVENT_RECORDED, failure: EVENT_UNRECORDED } })
      BEACON_ACCEPTED -> ready when (!= @entity.saltDay (time/format @payload.draft.ts "YYYY-MM-DD"))
        (set @entity.pending @payload.draft)
        (fetch AnalyticsSalt { id: (time/format @payload.draft.ts "YYYY-MM-DD"), emit: { success: SALT_LOADED, failure: SALT_ABSENT } })

      SALT_LOADED -> ready
        (set @entity.saltDay @payload.data.id)
        (set @entity.salt @payload.data.salt)
        (emit SALT_READY { })
      SALT_ABSENT -> ready when (= @payload.code "not-found")
        (random-bytes 32 { emit: { success: SALT_DRAWN, failure: SALT_FAILED } })
      SALT_ABSENT -> ready when (!= @payload.code "not-found")
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_DRAWN -> ready
        (persist create AnalyticsSalt { id: (time/format @entity.pending.ts "YYYY-MM-DD"), salt: @payload.value, createdAt: @entity.pending.ts } { emit: { success: SALT_CREATED, failure: SALT_TAKEN } })
      SALT_CREATED -> ready
        (set @entity.saltDay @payload.id)
        (set @entity.salt @payload.salt)
        (emit SALT_READY { })
      SALT_TAKEN -> ready when (= @payload.code "duplicate-id")
        (fetch AnalyticsSalt { id: (time/format @entity.pending.ts "YYYY-MM-DD"), emit: { success: SALT_LOADED, failure: SALT_UNREADABLE } })
      SALT_TAKEN -> ready when (!= @payload.code "duplicate-id")
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_UNREADABLE -> ready
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_FAILED -> ready
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })

      SALT_READY -> ready
        (persist create AnalyticsEvent { ts: @entity.pending.ts, name: @entity.pending.name, domain: @entity.pending.domain, path: @entity.pending.path, referrer: @entity.pending.referrer, screenWidth: @entity.pending.screenWidth, props: @entity.pending.props, visitorId: (hash/sha256 (str/concat @entity.salt ":" @entity.pending.ip ":" @entity.pending.ua ":" @entity.pending.domain) "hex") } { emit: { success: EVENT_RECORDED, failure: EVENT_UNRECORDED } })
        (set @entity.pending null)

      EVENT_RECORDED -> ready
        (emit BEACON_ANSWERED { status: 202, body: "{}" })
      EVENT_UNRECORDED -> ready
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
    }

    emits {
      BEACON_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the HTTP answer to the beacon, which the inbound hook writes back."
        @tier "internal"
      BEACON_ACCEPTED -> internal {
        draft : AnalyticsDraft!
      }
        @description "Internal: a well-formed beacon, as the event it becomes before the visitor hash."
        @tier "internal"
      SALT_READY -> internal { }
        @description "Internal: the day's salt is held; the pending beacon can be stored."
        @tier "internal"
      SALT_LOADED {
        data : AnalyticsSalt!
      }
        @description "Internal: the day's salt row was read."
      SALT_ABSENT {
        error : string
        code : string
      }
        @description "Internal: the day's salt row could not be read; not-found means it does not exist yet."
      SALT_DRAWN {
        value : string!
      }
        @description "Internal: fresh random bytes for the day's salt."
      SALT_FAILED {
        error : string!
      }
        @description "Internal: the host could not draw random bytes."
      SALT_CREATED {
        id : string!
        salt : string!
      }
        @description "Internal: the day's salt row was created."
      SALT_TAKEN {
        error : string
        code : string
      }
        @description "Internal: the salt row could not be created; duplicate-id means another instance created it first."
      SALT_UNREADABLE {
        error : string
        code : string
      }
        @description "Internal: the salt row another instance created could not be read."
      EVENT_RECORDED {
        id : string!
      }
        @description "Internal: the beacon's event row was stored."
      EVENT_UNRECORDED {
        error : string
        code : string
      }
        @description "Internal: the beacon's event row could not be stored."
    }

    listens {
      BEACON_RECEIVED -> inbound "analytics" answers BEACON_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "A beacon delivered at /api/hooks/analytics: the JSON text std-analytics sends (text/plain)."
        @synonyms "analytics beacon, pageview, tracking event"
    }
  }

  trait AnalyticsStats -> AnalyticsCollector [integration, instance] {
    initial: ready

    state ready {
      INIT -> ready
        (render-ui main { type: typography, variant: caption, role: status, content: "No stats asked for yet." })
      ANALYTICS_STATS -> ready
        (set @entity.statsLimit (if (== @payload.limit null) 100 @payload.limit))
        (fetch AnalyticsEvent { filter: ["and", (or (== @payload.domain null) (= @payload.domain "") ["=", (object/get @entity domain), @payload.domain]), (or (== @payload.from null) [">=", (object/get @entity ts), @payload.from]), (or (== @payload.to null) ["<=", (object/get @entity ts), @payload.to])], emit: { success: STATS_LOADED, failure: STATS_UNREADABLE } })
      STATS_LOADED -> ready
        (let ((views (array/filter @payload.data (fn e (= @e.name "pageview"))))
              (pageKeys (array/map (array/filter @payload.data (fn e (= @e.name "pageview"))) (fn e (str/concat @e.path " (" @e.domain ")"))))
              (refKeys (array/map (array/filter (array/filter @payload.data (fn e (= @e.name "pageview"))) (fn e (and (!= @e.referrer null) (!= @e.referrer "")))) (fn e (let ((rest (str/replace-pattern @e.referrer "^[A-Za-z][A-Za-z0-9+.\\-]*://([^/?#@]*@)?" "")))
                (if (validate/pattern @e.referrer "^[A-Za-z][A-Za-z0-9+.\\-]*://")
                  (let ((h (str/lower (if (str/startsWith @rest "[") (str/concat (str/replace-pattern @rest "\\].*$" "") "]") (str/replace-pattern @rest "[:/?#].*$" "")))))
                    (if (= @h "") @e.referrer @h))
                  @e.referrer))))))
          (let ((pageUniq (array/unique @pageKeys))
                (refUniq (array/unique @refKeys)))
            (do
              (emit ANALYTICS_STATS_RESULT {
                pageviews: (array/len @views),
                visitors: (array/len (array/unique (array/map @payload.data (fn e @e.visitorId)))),
                pages: (array/take (array/sort (array/map @pageUniq (fn k { key: @k, count: (array/count @pageKeys (fn x (= @x @k))) })) "count" "desc") @entity.statsLimit),
                countries: (array/take [{ key: "", count: 0 }] 0),
                referrers: (array/take (array/sort (array/map @refUniq (fn k { key: @k, count: (array/count @refKeys (fn x (= @x @k))) })) "count" "desc") @entity.statsLimit)
              })
              (render-ui main { type: stack, direction: horizontal, gap: md, children: [
                { type: stat-display, label: "Pageviews", value: (array/len @views) },
                { type: stat-display, label: "Unique visitors", value: (array/len (array/unique (array/map @payload.data (fn e @e.visitorId)))) }
              ] }))))
      STATS_UNREADABLE -> ready
        (emit ANALYTICS_STATS_FAILED { error: @payload.error })
        (render-ui main { type: typography, variant: caption, role: status, content: (str/concat "Stats unavailable: " @payload.error) })
    }

    emits {
      ANALYTICS_STATS_RESULT -> external {
        pageviews : number!
        visitors : number!
        pages : [AnalyticsCount]!
        countries : [AnalyticsCount]!
        referrers : [AnalyticsCount]!
      }
        @description "The stats of the asked window: pageviews, unique visitors over every event, and the top pages (path and site), countries and referrer hosts by count. Countries is always empty: the collector keeps no geography."
        @synonyms "analytics stats, traffic, visitors, pageviews"
        @tier "primary"
      ANALYTICS_STATS_FAILED -> external {
        error : string!
      }
        @description "The stored events could not be read."
        @tier "primary"
      STATS_LOADED {
        data : [AnalyticsEvent]!
      }
        @description "Internal: the stored events of the window."
      STATS_UNREADABLE {
        error : string
        code : string
      }
        @description "Internal: the stored events could not be read."
    }

    listens {
      ANALYTICS_STATS -> external {
        domain : string
        from : number
        to : number
        limit : number
      }
        @description "Ask for the stats of a site (empty or absent: every site) between from and to (epoch milliseconds, inclusive; absent: unbounded), with at most limit rows per breakdown (default 100)."
        @synonyms "analytics stats, traffic report, visitor count"
    }
  }

  page "/analytics-collector" -> AnalyticsIntake, AnalyticsStats
}
