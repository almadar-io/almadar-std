app std-audit-capture "1.3.0"
"std-audit-capture — event-interceptor audit log / audit trail. Use when a user voices that a record's changes must be tracked, logged, or auditable (audit trail, track changes, change history, who edited what, mutation log, record changes, log every edit, edit history, modification log, who did what when, accountability log). Listens for the generic `EntityMutated` sentinel (rename via traitOverrides.events to the real mutation event, e.g. ContactSaved) and persists an AuditEntry row capturing actor, action, entity type/id, before/after snapshots, and timestamp. `captureEventTypes` filters on @payload.data.kind, or on the delivered event's own name when the payload carries no kind (empty = capture all). Every entry also records where the change came from — the delivering event, the behavior and module that emitted it, and the scheduled job when a tick caused it — with no change to the upstream emitter. Compose with `std-lifecycle` to apply retention. Composable via `extraTraits` to interpose audit logging behind any mutating trait."
orbital AuditCaptureOrbital {
    type EntityMutated = Event { data : @entity @config.captureEntity } "Rename via traitOverrides.events to the upstream mutation event (e.g. ContactSaved, ContactDeleted)."

    type AuditRecorded = Event { actor : string, action : string, entityType : string, entityId : string, recordedAt : number, sourceEvent : string, sourceTrait : string, sourceOrbital : string, sourceTick : string } "Re-emitted after the audit row persists; rename to wire downstream listeners (e.g. AuditDashboardAppended)."

  entity AuditEntry [persistent: audit_entries] {
    id : string!
    actor : string @description "The user or system performing the action." @synonyms "user, source, originator" = ""
    action : string @description "The specific operation performed on the entity." @synonyms "operation, event, activity, change" = ""
    entityType : string @description "The type of entity that was modified." @synonyms "type, kind, class" = ""
    entityId : string @description "Unique identifier for the entity being audited." @synonyms "entity identifier, record id, item id" = ""
    before : Map string scalar @description "The state of the entity prior to the modification." @synonyms "previous, original, old value" = {}
    after : Map string scalar @description "The state of the entity after a modification." @synonyms "new, updated, post, subsequent" = {}
    recordedAt : number @description "Timestamp indicating when the audit event was recorded." @synonyms "timestamp, date, time" = 0
    sourceEvent : string @description "The event that delivered the change to the audit trail, e.g. ContactSaved." @synonyms "triggering event, cause, origin event" = ""
    sourceTrait : string @description "The behavior that emitted the change." @synonyms "emitter, origin, raised by" = ""
    sourceOrbital : string @description "The module the change came from." @synonyms "origin module, source module" = ""
    sourceTick : string @description "The scheduled job that caused the change; blank when a person or an event did." @synonyms "scheduled job, background job, timer" = ""
  }

  trait AuditCaptureListener -> @rebindable AuditEntry [lifecycle, instance, audit, compliance] {
    initial: idle

    state idle {
      EntityMutated -> idle when @config.enabled
        (when (or ["=", (array/len @config.captureEventTypes), 0] (array/includes @config.captureEventTypes (object/get ?data kind @event.event))) (do (set @entity.actor @user.id) (set @entity.action (object/get ?data kind @event.event)) (set @entity.entityType @config.captureEntity) (set @entity.entityId (object/get ?data id "")) (set @entity.before (if @config.captureBeforeAfter (object/omit (object/get ?data before {}) @config.excludeFields) {})) (set @entity.after (if @config.captureBeforeAfter (object/omit (object/get ?data after {}) @config.excludeFields) {})) (set @entity.recordedAt 0) (persist create AuditEntry {
          action: @entity.action
          actor: @user.id
          after: @entity.after
          before: @entity.before
          entityId: @entity.entityId
          entityType: @config.captureEntity
          recordedAt: 0
          sourceEvent: @event.event
          sourceTrait: (str/default @event.source.trait "")
          sourceOrbital: (str/default @event.source.orbital "")
          sourceTick: (str/default @event.source.tick "")
        }) (emit AuditRecorded {
          action: @entity.action
          actor: @user.id
          entityId: @entity.entityId
          entityType: @config.captureEntity
          recordedAt: 0
          sourceEvent: @event.event
          sourceTrait: (str/default @event.source.trait "")
          sourceOrbital: (str/default @event.source.orbital "")
          sourceTick: (str/default @event.source.tick "")
        })))
    }

    emits {
      AuditRecorded -> external {
        actor : string
        action : string
        entityType : string
        entityId : string
        recordedAt : number
        sourceEvent : string
        sourceTrait : string
        sourceOrbital : string
        sourceTick : string
      }
    }

    listens {
      EntityMutated {
        data : @entity @config.captureEntity
      }
    }

    config {
      enabled : boolean = false
        @label "Track every change"
        @description "Keep an audit trail of every change to records — who changed what, and when. Off by default."
        @synonyms "enable, turn on, enforce, require, activate, apply, switch on, audit, audit trail, log changes, track changes, who edited what, mutation log, change history, edit history, modification log, accountability log, record changes, log every edit, compliance log"
        @tier "policy"
      captureEntity : entity = ""
        @label "Entity to audit"
        @description "Type name of the entity whose mutations get logged"
        @tier "internal"
      captureEventTypes : [string] = []
        @label "Event-kind filter"
        @description "When set, only these kinds are audited: the payload's `kind` field, or the delivering event's name when there is no kind. Empty list = capture every event."
        @tier "internal"
      excludeFields : [string] = []
        @label "Skip fields"
        @description "Entity fields to omit from the before/after snapshots — e.g. passwords or other sensitive fields you do not want copied into the audit trail."
        @tier "internal"
      captureBeforeAfter : boolean = false
        @label "Store before-and-after snapshots?"
        @description "Store a full before-and-after snapshot of each change. More detail, but a larger audit log."
        @synonyms "before after, snapshot, diff, change snapshot, field diff"
        @tier "policy"
      retentionDays : number = 2555
        @label "How long should the audit log be kept (days)?"
        @description "Number of days to retain audit entries. Default 2555 ≈ 7 years, typical for compliance."
        @synonyms "log retention, keep for, audit expiry, retention period, log lifetime"
        @tier "policy"
    }
  }

  page "/audit-capture" as AuditCapturePage -> AuditCaptureListener
}