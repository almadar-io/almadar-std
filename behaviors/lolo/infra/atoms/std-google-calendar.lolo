      CALENDAR_WATCH -> idle
        (do (set @entity.callKey (json/stringify { op: "watch", attempt: 0, calendarId: (or @payload.calendarId @config.calendarId), eventId: "", channelId: @payload.channelId, timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http POST @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (or @payload.calendarId @config.calendarId)) "/events/watch") { headers: { Accept: "*/*", Content-Type: "application/json" }, text: (str/concat "{" (str/join (array/filter [(str/concat "\"id\":" (json/stringify @payload.channelId)) (str/concat "\"type\":" "\"web_hook\"") (str/concat "\"address\":" (json/stringify @payload.address)) (if (!= (or @payload.ttlSeconds 0) 0) (str/concat "\"params\":{\"ttl\":" (json/stringify (str/concat @payload.ttlSeconds)) "}") "")] (fn p (!= @p ""))) ",") "}"), auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
      CALENDAR_STOP_WATCH -> idle
        (do (set @entity.callKey (json/stringify { op: "stopWatch", attempt: 0, calendarId: "", eventId: "", channelId: "", timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http POST @config.origin "/calendar/v3/channels/stop" { headers: { Accept: "*/*" }, json: { id: @payload.channelId, resourceId: @payload.resourceId }, auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
