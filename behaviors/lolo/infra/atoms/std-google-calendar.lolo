        (let ((call (json/parse @payload.key CalendarCall))) (do (set @entity.callKey (json/stringify { op: "list", attempt: (+ (object/get @call attempt 0) 1), calendarId: (object/get @call calendarId ""), eventId: "", channelId: "", timeMin: (object/get @call timeMin ""), timeMax: (object/get @call timeMax ""), syncToken: (object/get @call syncToken ""), maxResults: (object/get @call maxResults 0) })) (http GET @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (object/get @call calendarId "")) "/events") { headers: { Accept: "*/*" }, query: { syncToken: (if (!= (object/get @call syncToken "") "") (object/get @call syncToken "") null), timeMin: (if (and (not (!= (object/get @call syncToken "") "")) (!= (object/get @call timeMin "") "")) (object/get @call timeMin "") null), timeMax: (if (and (not (!= (object/get @call syncToken "") "")) (!= (object/get @call timeMax "") "")) (object/get @call timeMax "") null), singleEvents: (if (!= (object/get @call syncToken "") "") null "true"), orderBy: (if (!= (object/get @call syncToken "") "") null "startTime"), maxResults: (object/get @call maxResults 0) }, auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })))
      CALENDAR_REPLIED -> idle when (and (= (object/get (json/parse @payload.key CalendarCall) op "") "delete") (< (object/get (json/parse @payload.key CalendarCall) attempt 0) 3) (or (= @payload.status 408) (= @payload.status 429) (and (>= @payload.status 500) (< @payload.status 600)) (and (>= @payload.status 100) (< @payload.status 200))))
        (let ((call (json/parse @payload.key CalendarCall))) (do (set @entity.callKey (json/stringify { op: "delete", attempt: (+ (object/get @call attempt 0) 1), calendarId: (object/get @call calendarId ""), eventId: (object/get @call eventId ""), channelId: "", timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http DELETE @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (object/get @call calendarId "")) "/events/" (str/encode-uri-component (object/get @call eventId ""))) { headers: { Accept: "*/*" }, auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })))
