app std-google-calendar [
  version: "1.0.0",
  description: "std-google-calendar — Google Calendar through the REST API (www.googleapis.com/calendar/v3): list, create, update and delete events, free-busy queries and push-channel watch. Each action is one input event with a typed payload and one result event carrying the provider's result record; an API or transport failure answers on that action's failure event with the error message.",
  egress: ["https://www.googleapis.com"]
]
type CalendarRawTime = { dateTime : string, date : string }
type CalendarRawEvent = { id : string, summary : string, description : string, location : string, start : CalendarRawTime, end : CalendarRawTime, status : string, updated : string }
type CalendarEventsReply = { items : [CalendarRawEvent], nextSyncToken : string }
type CalendarEventRecord = { id : string, summary : string, description : string, location : string, start : string, end : string, status : string, updated : string }
type CalendarCreatedReply = { id : string, status : string, htmlLink : string }
type CalendarPatchedReply = { id : string, status : string }
type CalendarBusySlot = { start : string, end : string }
type CalendarFreeBusyCalendar = { busy : [CalendarBusySlot] }
type CalendarFreeBusyReply = { calendars : Map string CalendarFreeBusyCalendar }
type CalendarWatchReply = { id : string, resourceId : string, expiration : string }
type CalendarApiErrorItem = { message : string, domain : string }
type CalendarApiError = { code : number, message : string, errors : [CalendarApiErrorItem] }
type CalendarErrorReply = { error : CalendarApiError }
type CalendarErrorStringReply = { error : string }
type CalendarCall = { op : string, attempt : number, calendarId : string, eventId : string, channelId : string, timeMin : string, timeMax : string, syncToken : string, maxResults : number }
orbital CalendarOrbital {
  entity CalendarRequest [runtime] {
    id : string!
    callKey : string
  }

  trait CalendarClient -> CalendarRequest [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle

      CALENDAR_LIST_EVENTS -> idle
        (do (set @entity.callKey (json/stringify { op: "list", attempt: 0, calendarId: (or @payload.calendarId @config.calendarId), eventId: "", channelId: "", timeMin: (or @payload.timeMin ""), timeMax: (or @payload.timeMax ""), syncToken: (or @payload.syncToken ""), maxResults: (or @payload.maxResults 250) })) (http GET @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (or @payload.calendarId @config.calendarId)) "/events") { headers: { Accept: "*/*" }, query: { syncToken: (if (!= (or @payload.syncToken "") "") (or @payload.syncToken "") null), timeMin: (if (and (not (!= (or @payload.syncToken "") "")) (!= (or @payload.timeMin "") "")) (or @payload.timeMin "") null), timeMax: (if (and (not (!= (or @payload.syncToken "") "")) (!= (or @payload.timeMax "") "")) (or @payload.timeMax "") null), singleEvents: (if (!= (or @payload.syncToken "") "") null "true"), orderBy: (if (!= (or @payload.syncToken "") "") null "startTime"), maxResults: (or @payload.maxResults 250) }, auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
      CALENDAR_CREATE_EVENT -> idle when (!= @payload.end "")
        (do (set @entity.callKey (json/stringify { op: "create", attempt: 0, calendarId: (or @payload.calendarId @config.calendarId), eventId: "", channelId: "", timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http POST @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (or @payload.calendarId @config.calendarId)) "/events") { headers: { Accept: "*/*", Content-Type: "application/json" }, text: (str/concat "{" (str/join (array/filter [(str/concat "\"summary\":" (json/stringify @payload.summary)) (if (!= @payload.description "") (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (!= @payload.location "") (str/concat "\"location\":" (json/stringify @payload.location)) "") (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) (str/concat "\"end\":" (if (= (str/len @payload.end) 10) (str/concat "{\"date\":" (json/stringify @payload.end) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.end) "}")))] (fn p (!= @p ""))) ",") "}"), auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
      CALENDAR_CREATE_EVENT -> idle when (and (= @payload.end "") (= (str/len @payload.start) 10))
        (do (set @entity.callKey (json/stringify { op: "create", attempt: 0, calendarId: (or @payload.calendarId @config.calendarId), eventId: "", channelId: "", timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http POST @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (or @payload.calendarId @config.calendarId)) "/events") { headers: { Accept: "*/*", Content-Type: "application/json" }, text: (str/concat "{" (str/join (array/filter [(str/concat "\"summary\":" (json/stringify @payload.summary)) (if (!= @payload.description "") (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (!= @payload.location "") (str/concat "\"location\":" (json/stringify @payload.location)) "") (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) (str/concat "\"end\":" (if (= (str/len (time/format (time/add (time/parse @payload.start) 1 day) "YYYY-MM-DD")) 10) (str/concat "{\"date\":" (json/stringify (time/format (time/add (time/parse @payload.start) 1 day) "YYYY-MM-DD")) "}") (str/concat "{\"dateTime\":" (json/stringify (time/format (time/add (time/parse @payload.start) 1 day) "YYYY-MM-DD")) "}")))] (fn p (!= @p ""))) ",") "}"), auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
      CALENDAR_CREATE_EVENT -> idle when (and (= @payload.end "") (!= (str/len @payload.start) 10) (> (or @payload.durationMinutes 0) 0))
        (emit CALENDAR_CREATE_EVENT_FAILED { code: null, message: "createEvent derives a timed end from durationMinutes, which needs full ISO time parsing (time/parse drops the time of day); pass an explicit end" })
      CALENDAR_CREATE_EVENT -> idle when (and (= @payload.end "") (!= (str/len @payload.start) 10) (<= (or @payload.durationMinutes 0) 0))
