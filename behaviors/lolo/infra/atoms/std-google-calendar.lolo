      CALENDAR_DELETE_EVENT -> idle
        (do (set @entity.callKey (json/stringify { op: "delete", attempt: 0, calendarId: (or @payload.calendarId @config.calendarId), eventId: @payload.eventId, channelId: "", timeMin: "", timeMax: "", syncToken: "", maxResults: 0 })) (http DELETE @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (or @payload.calendarId @config.calendarId)) "/events/" (str/encode-uri-component @payload.eventId)) { headers: { Accept: "*/*" }, auth: { scheme: bearer, credential: @config.accessToken }, timeoutMs: @config.timeoutMs } { key: @entity.callKey, emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))
      CALENDAR_FREE_BUSY -> idle
