app std-knowledge-topics [
  version: "1.0.0",
  description: "std-knowledge-topics — the learner's current topics from KFlow. KNOWLEDGE_CURRENT_TOPICS reads the learner's jump-back-in paths, learning goals and recent activity from the KFlow API with the learner's own sign-in (a Firebase refresh-token exchange whose rotated refresh token the host keeps), weights each by recency over a window of days, merges repeated labels and answers the strongest topics. Every failure answers KNOWLEDGE_TOPICS_FAILED with the provider's code (AUTH_ERROR, NETWORK_ERROR, SERVICE_ERROR).",
  egress: ["https://kflow.example.com", "https://securetoken.googleapis.com"]
]
type KnowledgePathProgress = { progressPercentage : number }
type KnowledgePathRow = { title : string, lastAccessedAt : number, progress : KnowledgePathProgress }
type KnowledgePathsReply = { items : [KnowledgePathRow] }
type KnowledgeGoalRow = { title : string, target : string, updatedAt : number }
type KnowledgeGoalsReply = { goals : [KnowledgeGoalRow] }
type KnowledgeActivityRow = { type : string, resourceName : string, timestamp : number }
type KnowledgeActivityReply = { activity : [KnowledgeActivityRow] }
type KnowledgeTopicsCtx = { path : string, limit : number, sinceDays : number, pathsBody : string, goalsBody : string }
type KnowledgeKeywords = [string]
type KnowledgeTopic = { label : string, keywords : [string], weight : number }
orbital KnowledgeTopicsOrbital {
  entity KnowledgeTopicsRun [runtime] {
    id : string!
  }

  trait KnowledgeTopicsClient -> KnowledgeTopicsRun [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle

      KNOWLEDGE_CURRENT_TOPICS -> idle
        (http GET @config.kflow "/api/user/jump-back-in" {
          headers: { Accept: "*/*" },
          auth: {
            scheme: token-exchange,
            tokenUrl: @config.refreshUrl,
            grant: refresh_token,
            body: { form: { refresh_token: { credential: @config.refreshToken } } },
            accessField: "id_token",
            expiresField: "expires_in",
            expiresMarginMs: 60000,
            rotate: { field: "refresh_token", credential: @config.refreshToken },
            storeAs: { name: "KNOWLEDGE_ID_TOKEN", scope: app }
          }
        } { key: (json/stringify { path: "/api/user/jump-back-in", limit: (if (= @payload.limit null) 5 @payload.limit), sinceDays: (if (= @payload.sinceDays null) 30 @payload.sinceDays), pathsBody: "", goalsBody: "" }), emit: { success: KNOWLEDGE_PATHS_REPLIED, failure: KNOWLEDGE_TOPICS_HTTP_FAILED } })

      KNOWLEDGE_PATHS_REPLIED -> idle when (or (= @payload.status 401) (= @payload.status 403))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "AUTH_ERROR", message: "KFlow rejected the sign-in" })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow rejected the sign-in" })
      KNOWLEDGE_PATHS_REPLIED -> idle when (and (!= @payload.status 401) (!= @payload.status 403) (or (< @payload.status 200) (>= @payload.status 300)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered " (format/number @payload.status)) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow is unavailable" })
      KNOWLEDGE_PATHS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: null, message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " returned a reply that is not valid JSON") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unreadable reply" })
      KNOWLEDGE_PATHS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (not (and (validate/object (json/parse @payload.body KnowledgePathsReply)) (validate/array (object/get (json/parse @payload.body KnowledgePathsReply) items null)) (array/every (object/get (json/parse @payload.body KnowledgePathsReply) items []) (fn r (and (validate/object @r) (validate/string (object/get @r title null)) (validate/number (object/get @r lastAccessedAt null)) (or (not (object/has @r progress)) (validate/number (object/get @r "progress.progressPercentage" null)))))))))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered an unexpected shape") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unexpected reply" })
      KNOWLEDGE_PATHS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (and (validate/object (json/parse @payload.body KnowledgePathsReply)) (validate/array (object/get (json/parse @payload.body KnowledgePathsReply) items null)) (array/every (object/get (json/parse @payload.body KnowledgePathsReply) items []) (fn r (and (validate/object @r) (validate/string (object/get @r title null)) (validate/number (object/get @r lastAccessedAt null)) (or (not (object/has @r progress)) (validate/number (object/get @r "progress.progressPercentage" null))))))))
        (http GET @config.kflow "/api/learning/goals" {
          headers: { Accept: "*/*" },
          auth: {
            scheme: token-exchange,
            tokenUrl: @config.refreshUrl,
            grant: refresh_token,
            body: { form: { refresh_token: { credential: @config.refreshToken } } },
            accessField: "id_token",
            expiresField: "expires_in",
            expiresMarginMs: 60000,
            rotate: { field: "refresh_token", credential: @config.refreshToken },
            storeAs: { name: "KNOWLEDGE_ID_TOKEN", scope: app }
          }
        } { key: (json/stringify { path: "/api/learning/goals", limit: (object/get (json/parse @payload.key KnowledgeTopicsCtx) limit 0), sinceDays: (object/get (json/parse @payload.key KnowledgeTopicsCtx) sinceDays 30), pathsBody: @payload.body, goalsBody: "" }), emit: { success: KNOWLEDGE_GOALS_REPLIED, failure: KNOWLEDGE_TOPICS_HTTP_FAILED } })

      KNOWLEDGE_GOALS_REPLIED -> idle when (or (= @payload.status 401) (= @payload.status 403))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "AUTH_ERROR", message: "KFlow rejected the sign-in" })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow rejected the sign-in" })
      KNOWLEDGE_GOALS_REPLIED -> idle when (and (!= @payload.status 401) (!= @payload.status 403) (or (< @payload.status 200) (>= @payload.status 300)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered " (format/number @payload.status)) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow is unavailable" })
      KNOWLEDGE_GOALS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: null, message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " returned a reply that is not valid JSON") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unreadable reply" })
      KNOWLEDGE_GOALS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (not (and (validate/object (json/parse @payload.body KnowledgeGoalsReply)) (validate/array (object/get (json/parse @payload.body KnowledgeGoalsReply) goals null)) (array/every (object/get (json/parse @payload.body KnowledgeGoalsReply) goals []) (fn r (and (validate/object @r) (validate/string (object/get @r title null)) (validate/string (object/get @r target null)) (validate/number (object/get @r updatedAt null))))))))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered an unexpected shape") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unexpected reply" })
      KNOWLEDGE_GOALS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (and (validate/object (json/parse @payload.body KnowledgeGoalsReply)) (validate/array (object/get (json/parse @payload.body KnowledgeGoalsReply) goals null)) (array/every (object/get (json/parse @payload.body KnowledgeGoalsReply) goals []) (fn r (and (validate/object @r) (validate/string (object/get @r title null)) (validate/string (object/get @r target null)) (validate/number (object/get @r updatedAt null)))))))
        (http GET @config.kflow "/api/user/statistics/recent-activity" {
          query: { limit: 50 },
          headers: { Accept: "*/*" },
          auth: {
            scheme: token-exchange,
            tokenUrl: @config.refreshUrl,
            grant: refresh_token,
            body: { form: { refresh_token: { credential: @config.refreshToken } } },
            accessField: "id_token",
            expiresField: "expires_in",
            expiresMarginMs: 60000,
            rotate: { field: "refresh_token", credential: @config.refreshToken },
            storeAs: { name: "KNOWLEDGE_ID_TOKEN", scope: app }
          }
        } { key: (json/stringify { path: "/api/user/statistics/recent-activity?limit=50", limit: (object/get (json/parse @payload.key KnowledgeTopicsCtx) limit 0), sinceDays: (object/get (json/parse @payload.key KnowledgeTopicsCtx) sinceDays 30), pathsBody: (object/get (json/parse @payload.key KnowledgeTopicsCtx) pathsBody ""), goalsBody: @payload.body }), emit: { success: KNOWLEDGE_ACTIVITY_REPLIED, failure: KNOWLEDGE_TOPICS_HTTP_FAILED } })

      KNOWLEDGE_ACTIVITY_REPLIED -> idle when (or (= @payload.status 401) (= @payload.status 403))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "AUTH_ERROR", message: "KFlow rejected the sign-in" })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow rejected the sign-in" })
      KNOWLEDGE_ACTIVITY_REPLIED -> idle when (and (!= @payload.status 401) (!= @payload.status 403) (or (< @payload.status 200) (>= @payload.status 300)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered " (format/number @payload.status)) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow is unavailable" })
      KNOWLEDGE_ACTIVITY_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)))
        (emit KNOWLEDGE_TOPICS_FAILED { code: null, message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " returned a reply that is not valid JSON") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unreadable reply" })
      KNOWLEDGE_ACTIVITY_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (not (and (validate/object (json/parse @payload.body KnowledgeActivityReply)) (validate/array (object/get (json/parse @payload.body KnowledgeActivityReply) activity null)) (array/every (object/get (json/parse @payload.body KnowledgeActivityReply) activity []) (fn r (and (validate/object @r) (validate/string (object/get @r type null)) (validate/string (object/get @r resourceName null)) (validate/number (object/get @r timestamp null))))))))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "SERVICE_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " answered an unexpected shape") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sent an unexpected reply" })
      KNOWLEDGE_ACTIVITY_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (and (validate/object (json/parse @payload.body KnowledgeActivityReply)) (validate/array (object/get (json/parse @payload.body KnowledgeActivityReply) activity null)) (array/every (object/get (json/parse @payload.body KnowledgeActivityReply) activity []) (fn r (and (validate/object @r) (validate/string (object/get @r type null)) (validate/string (object/get @r resourceName null)) (validate/number (object/get @r timestamp null)))))))
        (let ((candidates (array/filter (array/concat (array/map (array/filter (object/get (json/parse (object/get (json/parse @payload.key KnowledgeTopicsCtx) pathsBody "") KnowledgePathsReply) items []) (fn p (< (or (object/get @p "progress.progressPercentage" null) 0) 100))) (fn p { label: (object/get @p title ""), keywords: (json/parse "[]" KnowledgeKeywords), weight: (* (math/max 0 (- 1 (/ (/ (- @now (object/get @p lastAccessedAt 0)) 86400000) (object/get (json/parse @payload.key KnowledgeTopicsCtx) sinceDays 30)))) (- 1 (/ (or (object/get @p "progress.progressPercentage" null) 0) 100))) })) (array/map (object/get (json/parse (object/get (json/parse @payload.key KnowledgeTopicsCtx) goalsBody "") KnowledgeGoalsReply) goals []) (fn g { label: (object/get @g title ""), keywords: (if (= (object/get @g target "") "") (json/parse "[]" KnowledgeKeywords) [(object/get @g target "")]), weight: (math/max 0 (- 1 (/ (/ (- @now (object/get @g updatedAt 0)) 86400000) (object/get (json/parse @payload.key KnowledgeTopicsCtx) sinceDays 30)))) })) (array/map (array/filter (object/get (json/parse @payload.body KnowledgeActivityReply) activity []) (fn a (= (object/get @a type "") "concept_studied"))) (fn a { label: (object/get @a resourceName ""), keywords: (json/parse "[]" KnowledgeKeywords), weight: (math/max 0 (- 1 (/ (/ (- @now (object/get @a timestamp 0)) 86400000) (object/get (json/parse @payload.key KnowledgeTopicsCtx) sinceDays 30)))) }))) (fn c (> (object/get @c weight 0) 0)))))
          (let ((merged (array/reduce @candidates [] (fn acc c (if (array/some @acc (fn t (= (object/get @t label "") (object/get @c label "")))) (array/map @acc (fn t (if (= (object/get @t label "") (object/get @c label "")) { label: (object/get @t label ""), keywords: (array/unique (array/concat (object/get @t keywords []) (object/get @c keywords []))), weight: (math/max (object/get @t weight 0) (object/get @c weight 0)) } @t))) (array/append @acc @c))))))
            (emit KNOWLEDGE_TOPICS_RESULT { topics: (array/slice (array/sort (array/sort @merged label asc) weight desc) 0 (object/get (json/parse @payload.key KnowledgeTopicsCtx) limit 0)) })))

      KNOWLEDGE_TOPICS_HTTP_FAILED -> idle when (= @payload.kind "unconfigured")
        (emit KNOWLEDGE_TOPICS_FAILED { code: "AUTH_ERROR", message: "Not connected" })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "No learner is connected" })
      KNOWLEDGE_TOPICS_HTTP_FAILED -> idle when (and (!= @payload.kind "unconfigured") (= @payload.phase "grant") (!= @payload.grantStatus null))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "AUTH_ERROR", message: (str/concat "Sign-in failed (" (format/number @payload.grantStatus) ")") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: "KFlow sign-in failed" })
      KNOWLEDGE_TOPICS_HTTP_FAILED -> idle when (and (!= @payload.kind "unconfigured") (= @payload.phase "grant") (= @payload.grantStatus null))
        (emit KNOWLEDGE_TOPICS_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "KFlow sign-in unavailable: " @payload.error) })
      KNOWLEDGE_TOPICS_HTTP_FAILED -> idle when (and (!= @payload.kind "unconfigured") (!= @payload.phase "grant"))
        (emit KNOWLEDGE_TOPICS_FAILED { code: "NETWORK_ERROR", message: (str/concat "KFlow " (object/get (json/parse @payload.key KnowledgeTopicsCtx) path "") " is unreachable") })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "KFlow unreachable: " @payload.error) })
    }

    emits {
      KNOWLEDGE_TOPICS_RESULT -> external {
        topics : [KnowledgeTopic]!
      }
        @description "The learner's current topics, strongest first: label, keywords and a recency weight; finished paths and expired activity are left out."
        @synonyms "current topics, learner topics, what the learner is studying"
        @tier "primary"
      KNOWLEDGE_TOPICS_FAILED -> external {
        code : string
        message : string!
      }
        @description "The topics could not be read: no learner connected or the sign-in refused (AUTH_ERROR), KFlow unreachable (NETWORK_ERROR), a non-2xx answer or unexpected shape (SERVICE_ERROR), or an unreadable reply (no code)."
        @synonyms "knowledge error, topics failure, kflow failure"
        @tier "primary"
      KNOWLEDGE_PATHS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the jump-back-in read's HTTP reply."
        @tier "secondary"
      KNOWLEDGE_GOALS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the learning-goals read's HTTP reply."
        @tier "secondary"
      KNOWLEDGE_ACTIVITY_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the recent-activity read's HTTP reply."
        @tier "secondary"
      KNOWLEDGE_TOPICS_HTTP_FAILED {
        error : string!
        kind : string!
        key : string!
        credential : string
        phase : string
        grantStatus : number
        grantBody : string
      }
        @description "Internal: a KFlow read or the sign-in refresh never produced a reply."
        @tier "secondary"
    }

    listens {
      KNOWLEDGE_CURRENT_TOPICS -> external {
        limit : number
        sinceDays : number
      }
        @description "Read the learner's current topics; limit defaults to 5 and sinceDays (the recency window) to 30."
        @synonyms "current topics, what am I studying, learner topics"
      KNOWLEDGE_PATHS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      KNOWLEDGE_GOALS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      KNOWLEDGE_ACTIVITY_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      KNOWLEDGE_TOPICS_HTTP_FAILED {
        error : string!
        kind : string!
        key : string!
        credential : string
        phase : string
        grantStatus : number
        grantBody : string
      }
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports a failed read; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      kflow : url = "https://kflow.example.com"
        @label "KFlow API origin"
        @description "The KFlow API origin (scheme://host, no path). Must be declared in the app egress list."
        @synonyms "kflow url, api host, learning service origin"
        @tier "infra"
      refreshUrl : url = "https://securetoken.googleapis.com/v1/token"
        @label "Sign-in refresh URL"
        @description "The Firebase securetoken endpoint that exchanges the refresh token for a fresh ID token; append ?key=<web API key>. Its origin must be declared in the app egress list."
        @synonyms "token url, firebase refresh, securetoken"
        @tier "infra"
      refreshToken : secret = "KNOWLEDGE_REFRESH_TOKEN"
        @label "Learner refresh token"
        @description "Name of the host secret holding the learner's Firebase refresh token; the host replaces it each time the sign-in refreshes. Absent means no learner is connected."
        @synonyms "refresh token, learner session, sign-in secret"
        @tier "infra"
    }
  }

  page "/knowledge-topics" as KnowledgeTopicsPage -> KnowledgeTopicsClient
}
