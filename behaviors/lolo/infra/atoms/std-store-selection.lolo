app std-store-selection [
  version: "1.0.0",
  env: ["NODE_ENV", "USE_MOCK_DATA", "DATA_BACKEND", "DATABASE_URL", "PGPOOL_MAX", "COUCHDB_URL"],
  description: "std-store-selection — chooses the row store the environment names, so a host builds one driver from one decision. STORE_SELECT reads NODE_ENV (unset counts as production), USE_MOCK_DATA (true or false, false when unset; store_mock_flag_invalid otherwise) and DATA_BACKEND (mock, firebase, postgres or couchdb, firebase when unset; store_backend_invalid otherwise). Production refuses USE_MOCK_DATA=true (store_mock_forbidden) and DATA_BACKEND=mock (store_mock_backend_forbidden); use_mock or backend mock selects mock. Postgres needs a non-empty DATABASE_URL (store_url_missing) and takes PGPOOL_MAX (a u32 as Rust parses it: optional leading +, ASCII digits only, at most 4294967295; anything else is absent; a zero is present); couchdb needs a non-empty COUCHDB_URL (store_url_missing). The answer is STORE_SELECTED { backend, url, poolMax } with url empty for mock and firebase, or STORE_SELECTION_FAILED { code, message }. The driver itself, its URL scheme check and the Firebase credentials stay with the host."
]
uses Spec from "almadar-std/store-selection"

orbital StoreSelectionOrbital {
  entity StoreChoice [runtime] {
    id : string!
    nodeEnv : string @description "NODE_ENV, production when unset." = "production"
    useMock : boolean @description "USE_MOCK_DATA is true." = false
    backend : string @description "The chosen backend: mock, firebase, postgres or couchdb." = "firebase"
    url : string @description "DATABASE_URL or COUCHDB_URL of the chosen backend; empty for mock and firebase." = ""
    poolMax : number @description "PGPOOL_MAX as a u32; absent when unset or not one."
  }

  trait StoreSelection -> StoreChoice [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle
      STORE_SELECT -> reading
        (set @entity.nodeEnv "production")
        (set @entity.useMock false)
        (set @entity.backend "firebase")
        (set @entity.url "")
        (set @entity.poolMax null)
        (os/getenv "NODE_ENV" { emit: { success: STORE_NODE_ENV failure: STORE_HOST_FAILED } })
    }

    state reading {
      INIT -> reading
      STORE_SELECT -> reading
        (emit STORE_SELECTION_FAILED { code: "store_busy" message: "a store is already being selected" })
      STORE_NODE_ENV -> reading
        (set @entity.nodeEnv (if (== @payload.value null) "production" @payload.value))
        (os/getenv "USE_MOCK_DATA" { emit: { success: STORE_MOCK_FLAG failure: STORE_HOST_FAILED } })
      STORE_MOCK_FLAG -> idle when (and (!= @payload.value null) (!= @payload.value "true") (!= @payload.value "false"))
        (emit STORE_SELECTION_FAILED { code: "store_mock_flag_invalid" message: (str/concat "USE_MOCK_DATA must be 'true' or 'false', got '" @payload.value "'") })
      STORE_MOCK_FLAG -> reading when (or (== @payload.value null) (= @payload.value "true") (= @payload.value "false"))
        (set @entity.useMock (= @payload.value "true"))
        (os/getenv "DATA_BACKEND" { emit: { success: STORE_BACKEND failure: STORE_HOST_FAILED } })
      STORE_BACKEND -> idle when (and (!= @payload.value null) (not (or (= @payload.value "mock") (= @payload.value "firebase") (= @payload.value "postgres") (= @payload.value "couchdb"))))
        (emit STORE_SELECTION_FAILED { code: "store_backend_invalid" message: (str/concat "DATA_BACKEND must be one of mock, firebase, postgres, couchdb, got '" @payload.value "'") })
      STORE_BACKEND -> idle when (and (or (== @payload.value null) (= @payload.value "mock") (= @payload.value "firebase") (= @payload.value "postgres") (= @payload.value "couchdb")) (= @entity.nodeEnv "production") @entity.useMock)
        (emit STORE_SELECTION_FAILED { code: "store_mock_forbidden" message: "USE_MOCK_DATA=true is not permitted when NODE_ENV=production" })
      STORE_BACKEND -> idle when (and (= @entity.nodeEnv "production") (not @entity.useMock) (= @payload.value "mock"))
        (emit STORE_SELECTION_FAILED { code: "store_mock_backend_forbidden" message: "DATA_BACKEND=mock is not permitted when NODE_ENV=production" })
      STORE_BACKEND -> idle when (and (or (== @payload.value null) (= @payload.value "mock") (= @payload.value "firebase") (= @payload.value "postgres") (= @payload.value "couchdb")) (!= @entity.nodeEnv "production") (or @entity.useMock (= @payload.value "mock")))
        (set @entity.backend "mock")
        (emit STORE_SELECTED { backend: "mock" url: "" poolMax: null })
      STORE_BACKEND -> idle when (and (not @entity.useMock) (or (== @payload.value null) (= @payload.value "firebase")))
        (set @entity.backend "firebase")
        (emit STORE_SELECTED { backend: "firebase" url: "" poolMax: null })
      STORE_BACKEND -> reading when (and (not @entity.useMock) (= @payload.value "postgres"))
        (set @entity.backend "postgres")
        (os/getenv "DATABASE_URL" { emit: { success: STORE_URL failure: STORE_HOST_FAILED } })
      STORE_BACKEND -> reading when (and (not @entity.useMock) (= @payload.value "couchdb"))
        (set @entity.backend "couchdb")
        (os/getenv "COUCHDB_URL" { emit: { success: STORE_URL failure: STORE_HOST_FAILED } })
      STORE_URL -> idle when (or (== @payload.value null) (= @payload.value ""))
        (emit STORE_SELECTION_FAILED { code: "store_url_missing" message: (if (= @entity.backend "postgres") "DATA_BACKEND=postgres requires DATABASE_URL to be set" "DATA_BACKEND=couchdb requires COUCHDB_URL to be set") })
      STORE_URL -> reading when (and (!= @payload.value null) (!= @payload.value "") (= @entity.backend "postgres"))
        (set @entity.url @payload.value)
        (os/getenv "PGPOOL_MAX" { emit: { success: STORE_POOL_MAX failure: STORE_HOST_FAILED } })
      STORE_URL -> idle when (and (!= @payload.value null) (!= @payload.value "") (= @entity.backend "couchdb"))
        (set @entity.url @payload.value)
        (emit STORE_SELECTED { backend: "couchdb" url: @payload.value poolMax: null })
      STORE_POOL_MAX -> idle
        (set @entity.poolMax (if (== @payload.value null) null (let ((d (if (str/startsWith @payload.value "+") (str/slice @payload.value 1 (str/len @payload.value)) @payload.value))) (if (and (> (str/len @d) 0) (= (str/replace-pattern @d "[0-9]" "") "") (<= (str/to-number @d) 4294967295)) (str/to-number @d) null))))
        (emit STORE_SELECTED { backend: "postgres" url: @entity.url poolMax: @entity.poolMax })
      STORE_HOST_FAILED -> idle
        (emit STORE_SELECTION_FAILED { code: "store_host_failed" message: (or @payload.error "") })
    }

    emits {
      STORE_SELECTED -> external {
        backend : string!
        url : string!
        poolMax : number
      }
        @description "The environment's choice: the backend (mock, firebase, postgres or couchdb), the connection URL of postgres or couchdb (empty otherwise) and the postgres pool size (absent when unset or invalid)."
        @synonyms "store chosen, backend selected"
        @tier "domain"
      STORE_SELECTION_FAILED -> external {
        code : string!
        message : string!
      }
        @description "The environment names no usable store: an invalid flag or backend, mock in production, a missing URL, or a host failure."
        @synonyms "store selection failed, bad data backend"
        @tier "domain"
      STORE_NODE_ENV -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for NODE_ENV."
        @tier "internal"
      STORE_MOCK_FLAG -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for USE_MOCK_DATA."
        @tier "internal"
      STORE_BACKEND -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for DATA_BACKEND."
        @tier "internal"
      STORE_URL -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for DATABASE_URL or COUCHDB_URL."
        @tier "internal"
      STORE_POOL_MAX -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for PGPOOL_MAX."
        @tier "internal"
      STORE_HOST_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: an os/getenv failure."
        @tier "internal"
    }

    listens {
      STORE_SELECT -> external {
      }
        @description "Read the environment and choose the row store."
        @synonyms "select store, choose data backend"
    }
  }

  page "/store-selection" as StoreSelectionPage -> StoreSelection
}
