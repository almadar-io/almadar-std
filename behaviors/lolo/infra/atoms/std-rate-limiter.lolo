app std-rate-limiter [
  version: "1.0.0",
  description: "std-rate-limiter as a Function"
]
orbital RateBucketOrbital {
    uses Icon from "std/behaviors/ui-icon"
    uses Typography from "std/behaviors/ui-typography"
    uses StatusDot from "std/behaviors/ui-status-dot"
    uses Alert from "std/behaviors/ui-alert"
    uses StatDisplay from "std/behaviors/ui-stat-display"
    uses Meter from "std/behaviors/ui-meter"
    uses ProgressBar from "std/behaviors/ui-progress-bar"
    uses Button from "std/behaviors/ui-button"
    uses Divider from "std/behaviors/ui-divider"
    uses SimpleGrid from "std/behaviors/ui-simple-grid"

  entity RateBucket [runtime] {
    id : string
    name : string @description "A user-defined identifier for the rate limiting bucket." @synonyms "label, identifier, alias"
    description : string @description "A textual explanation of the rate bucket's purpose." @synonyms "explanation, details, notes"
    status : "active" | "inactive" | "pending" @description "Current operational state of the rate limiting bucket." @synonyms "state, condition, operationalStatus" = active
    createdAt : string
    count : number @description "The current value of a counter." @synonyms "value, amount, total" = 0
    window : number @description "The duration of the rate limiting window, in seconds." @synonyms "duration, time, interval, period" = 0
    limiterStatus : string @description "Current operational state of the rate limiter." @synonyms "state, condition, mode" = open
    limit : number @description "Requests this bucket admits per window before it throttles; set from requestsPerMinute when the limiter mounts." @synonyms "cap, quota, ceiling, maximum requests" = 60
  }

  trait ShieldIcon = Icon.traits.IconRender -> RateBucket {
    config {
      name: shield
    }
  }

  trait RateBucketTitle = Typography.traits.TypographyRender -> RateBucket {
    config {
      content: "RateBucket Rate Limiter"
      variant: h2
    }
  }

  trait OpenStatusDot = StatusDot.traits.StatusDotRender -> RateBucket {
    config {
      label: Open
      pulse: false
      status: online
    }
  }

  trait ThrottledStatusDot = StatusDot.traits.StatusDotRender -> RateBucket {
    config {
      label: Throttled
      pulse: true
      status: critical
    }
  }

  trait RateLimitAlert = Alert.traits.AlertRender -> RateBucket {
    config {
      message: "Rate limit exceeded. Requests are being throttled."
      variant: error
    }
  }

  trait RequestsStat = StatDisplay.traits.StatDisplayRender -> RateBucket {
    config {
      label: Requests
      look: @config.statLook
      value: @entity.count
    }
  }

  trait WindowStat = StatDisplay.traits.StatDisplayRender -> RateBucket {
    config {
      label: Window
      look: @config.statLook
      value: @entity.window
    }
  }

  trait CountMeter = Meter.traits.MeterRender -> RateBucket {
    config {
      max: @entity.limit
      min: 0
      value: @entity.count
    }
  }

  trait CountProgressBar = ProgressBar.traits.ProgressBarRender -> RateBucket {
    config {
      max: @entity.limit
      showPercentage: true
      value: @entity.count
    }
  }

  trait RequestButton = Button.traits.ButtonRender -> RateBucket {
    config {
      action: REQUEST
      icon: send
      label: Request
      variant: primary
    }
  }

  trait ResetButton = Button.traits.ButtonRender -> RateBucket {
    config {
      action: RESET
      icon: rotate-ccw
      label: Reset
      variant: ghost
    }
  }

  trait ResetPrimaryButton = Button.traits.ButtonRender -> RateBucket {
    config {
      action: RESET
      icon: rotate-ccw
      label: Reset
      variant: primary
    }
  }

  trait RateBucketDivider = Divider.traits.DividerRender -> RateBucket {
    config {}
  }

  trait StatsGrid = SimpleGrid.traits.SimpleGridRender -> RateBucket {
    config {
      children: [@trait.RequestsStat, @trait.WindowStat]
      cols: 2
    }
  }

  trait RateBucketRateLimiter -> RateBucket [interaction, collection, rate-limit] {
    initial: open

    state open {
      INIT -> open
        (set @entity.count 0)
        (set @entity.window 60)
        (set @entity.limit @config.requestsPerMinute)
        (set @entity.limiterStatus open)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.StatsGrid, @trait.CountMeter, @trait.CountProgressBar, {
            children: [@trait.RequestButton, @trait.ResetButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      REQUEST -> throttled when (and @config.enabled (>= (+ @entity.count 1) @entity.limit))
        (set @entity.count (+ @entity.count 1))
        (set @entity.limiterStatus throttled)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ThrottledStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.RateLimitAlert, @trait.StatsGrid, @trait.CountMeter, {
            children: [@trait.ResetPrimaryButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      REQUEST -> open when (and @config.enabled (< (+ @entity.count 1) @entity.limit))
        (set @entity.count (+ @entity.count 1))
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.StatsGrid, @trait.CountMeter, @trait.CountProgressBar, {
            children: [@trait.RequestButton, @trait.ResetButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      THROTTLE -> throttled
        (set @entity.limiterStatus throttled)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ThrottledStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.RateLimitAlert, @trait.StatsGrid, @trait.CountMeter, {
            children: [@trait.ResetPrimaryButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      RESET -> open
        (set @entity.count 0)
        (set @entity.limiterStatus open)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.StatsGrid, @trait.CountMeter, @trait.CountProgressBar, {
            children: [@trait.RequestButton, @trait.ResetButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      WINDOW_ELAPSED -> open
        (set @entity.count 0)
      CONFIGURE -> open
        (set @entity.limit ?limit)
    }

    state throttled {
      CONFIGURE -> throttled
        (set @entity.limit ?limit)
      WINDOW_ELAPSED -> open
        (set @entity.limiterStatus open)
        (set @entity.count 0)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.StatsGrid, @trait.CountMeter, @trait.CountProgressBar, {
            children: [@trait.RequestButton, @trait.ResetButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      RESET -> open
        (set @entity.limiterStatus open)
        (set @entity.count 0)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.StatsGrid, @trait.CountMeter, @trait.CountProgressBar, {
            children: [@trait.RequestButton, @trait.ResetButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      INIT -> throttled
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.RateBucketTitle]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ThrottledStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.RateBucketDivider, @trait.RateLimitAlert, @trait.StatsGrid, @trait.CountMeter, {
            children: [@trait.ResetPrimaryButton]
            direction: horizontal
            gap: sm
            justify: center
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
    }

    listens {
      CONFIGURE {
        limit : number
      }
        @description "Sets this bucket's limit (requests per window), e.g. from the host row's own rate limit."
    }

    ticks {
      windowElapsed every 1m
        (emit WINDOW_ELAPSED)
    }

    emits {
      WINDOW_ELAPSED -> internal {
      }
        @description "One rate-limit window (a minute) has elapsed; the request count starts over."
    }

    config {
      enabled : boolean = false
        @label "Enabled"
        @description "Whether rate limiting is active for the host orbital. Off by default; turn on to throttle requests."
        @synonyms "enable, turn on, enforce, require, activate, apply, switch on, rate limit, throttle, requests per minute, slow down, cap usage, request cap, limit traffic, prevent abuse"
        @tier "domain"
      requestsPerMinute : number = 60
        @label "Requests per minute"
        @description "Requests a bucket admits per one-minute window; the next request throttles it, and each elapsed minute (or RESET) reopens it."
        @synonyms "rate limit, request cap, RPS, throttle threshold"
        @tier "domain"
      statLook : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Stat display look"
        @description "Layer 2 visual treatment for stat / KPI cards."
        @tier "presentation"
    }
  }

  page "/ratebuckets/rate-limiter" as RateBucketRateLimiterPage -> RateBucketRateLimiter
}