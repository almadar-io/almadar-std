app std-redis [
  version: "1.0.0",
  env: ["REDIS_PASSWORD"],
  description: "std-redis — a cache, counter, lock and message channel on a real Redis server, speaking RESP in .lolo over os/tcp-connect, os/send, os/recv and os/close (no kernel redis effect). REDIS_GET, REDIS_SET (ttl in seconds), REDIS_DELETE, REDIS_INCREMENT (INCRBY), REDIS_EXPIRE (seconds, PEXPIRE), REDIS_PUBLISH, REDIS_LOCK (SET NX PX, ttl in milliseconds; the lock id is drawn from the host CSPRNG) and REDIS_UNLOCK (EVAL of the compare-and-delete script, so only the holder releases). A command is a RESP array of bulk strings (the length counts UTF-8 bytes). One call is one connection: connect, AUTH [user] password and SELECT db as ONE pipeline when configured, one reply read per pipelined command with every handshake reply checked before the command goes out, the command, its reply, then the socket is closed on success and on every failure. A reply split across reads keeps asking for more until the frame is whole; an unknown type byte, a non-integer length, a length below -1, a bulk not CRLF-terminated or nesting past 32 is a protocol failure. +OK is text, :-42 a number, $-1 and *-1 null, a bulk UTF-8 text (invalid UTF-8 is unsupported), an integer beyond 2^53 unsupported, -WRONGTYPE ... kind redis with code WRONGTYPE. Values are text. Every failure answers REDIS_FAILED with the action, the failure kind (refused, unconfigured, timeout, failed, protocol, unsupported, redis), the server's error word when it answered one, and the message. One call runs at a time: a second request while one is in flight answers REDIS_FAILED refused. The password is read from the environment variable named by passwordEnv (listed in this file's env grant). Subscribing needs a long-lived stream the host does not offer yet (G-ORB-307), so there is no REDIS_SUBSCRIBE; rediss:// needs TLS, which os/tcp-connect does not offer, so it answers REDIS_FAILED unsupported. Apps declare their Redis origin in their own egress list; the entry in this file is a placeholder, and a call to an undeclared origin is refused by the host and answers REDIS_FAILED.",
  egress: ["redis://redis.example.test:6379"]
]
uses Spec from "almadar-std/redis"
type RedisLockRequest = { key : string, ttl : number }
type RespNode = { kind : string!, text : string, num : number, depth : number! }
orbital RedisOrbital {
  entity RedisCall [runtime] {
    id : string!
    action : string @description "The action label a failure reports." = ""
    emitKey : string @description "The key the reply and failure events carry: the action, or the lock id for a lock." = ""
    words : [string] @description "The command as text items." = []
    cmdWire : bytes @description "The command as a RESP array of bulk strings." = ""
    hsWire : bytes @description "The AUTH and SELECT pipeline as RESP." = ""
    password : string @description "The password read from the environment until the handshake is built." = ""
    originKind : string @description "plain, tls or bad: how the origin parsed." = ""
    host : string @description "The origin host, lower case." = ""
    port : number @description "The origin port." = 0
    sock : number @description "The open socket; -1 when none." = -1
    phase : string @description "handshake while the AUTH and SELECT replies are read, command for the command's reply." = ""
    expected : number @description "How many replies this phase reads." = 0
    got : number @description "How many replies this phase has read." = 0
    inbox : bytes @description "Bytes received and not yet consumed." = ""
    pos : number @description "Byte offset of the next frame in the inbox." = 0
    owed : number @description "Nodes still to read in the current reply, nested ones included." = 1
    ends : [number] @description "The owed level at which each open array finishes." = []
    nodes : [RespNode] @description "The current reply's nodes in wire order." = []
    hk : number @description "Type byte of the next frame; -1 when not received." = -1
    he : number @description "Offset of the CRLF ending the header line; -1 when not received." = -1
    hd : number @description "Nesting depth of the next frame." = 0
    hv : boolean @description "The header line is UTF-8." = false
    ht : string @description "The header line as text." = ""
    hi : number @description "The header line as an integer." = 0
    hiok : boolean @description "The header line is an integer within 2^53 - 1." = false
    nk : string @description "Kind of the node being added." = ""
    nt : string @description "Text of the node being added." = ""
    nn : number @description "Number of the node being added." = 0
    nc : number @description "Element count of the array being added; 0 for any other node." = 0
    na : boolean @description "The node being added opens an array." = false
    np : number @description "Byte offset after the node being added." = 0
    replyKind : string @description "text, num or null: the command reply." = ""
    replyText : string @description "The command reply as text." = ""
    replyNum : number @description "The command reply as a number." = 0
    failKind : string @description "The failure kind; empty when the call succeeded." = ""
    failCode : string @description "The server's error word." = ""
    failMsg : string @description "The failure message." = ""
    failCred : string @description "The credential name an unconfigured failure names." = ""
  }

  trait RedisClient -> RedisCall [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.action "")
        (set @entity.emitKey "")
        (set @entity.words [])
        (set @entity.cmdWire "")
        (set @entity.hsWire "")
        (set @entity.password "")
        (set @entity.originKind "")
        (set @entity.host "")
        (set @entity.port 0)
        (set @entity.sock -1)
        (set @entity.phase "")
        (set @entity.expected 0)
        (set @entity.got 0)
        (set @entity.inbox "")
        (set @entity.pos 0)
        (set @entity.owed 1)
        (set @entity.ends [])
        (set @entity.nodes [])
        (set @entity.hk -1)
        (set @entity.he -1)
        (set @entity.hd 0)
        (set @entity.hv false)
        (set @entity.ht "")
        (set @entity.hi 0)
        (set @entity.hiok false)
        (set @entity.nk "")
        (set @entity.nt "")
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np 0)
        (set @entity.replyKind "")
        (set @entity.replyText "")
        (set @entity.replyNum 0)
        (set @entity.failKind "")
        (set @entity.failCode "")
        (set @entity.failMsg "")
        (set @entity.failCred "")

      REDIS_GET -> connecting when (!= @payload.key "")
        (set @entity.action "get")
        (set @entity.emitKey "%s")
        (set @entity.words ["GET", @payload.key])
        (emit REDIS_CALL_START { })
      REDIS_GET -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "key is required" })
      REDIS_GET_REPLIED -> idle
        (emit REDIS_GOT { value: @payload.reply })

      REDIS_SET -> connecting when (and (!= @payload.key "") (> (or @payload.ttl 0) 0))
        (set @entity.action "set")
        (set @entity.emitKey "%s")
        (set @entity.words ["SET", @payload.key, @payload.value, "EX", (str/concat @payload.ttl)])
        (emit REDIS_CALL_START { })
      REDIS_SET -> connecting when (and (!= @payload.key "") (<= (or @payload.ttl 0) 0))
        (set @entity.action "set")
        (set @entity.emitKey "%s")
        (set @entity.words ["SET", @payload.key, @payload.value])
        (emit REDIS_CALL_START { })
      REDIS_SET -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "key is required" })
      REDIS_SET_REPLIED -> idle
        (emit REDIS_SET_DONE { ok: (= @payload.reply "OK") })

      REDIS_DELETE -> connecting when (!= @payload.key "")
        (set @entity.action "delete")
        (set @entity.emitKey "%s")
        (set @entity.words ["DEL", @payload.key])
        (emit REDIS_CALL_START { })
      REDIS_DELETE -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "key is required" })
      REDIS_DELETE_REPLIED -> idle
        (emit REDIS_DELETED { deleted: (> @payload.reply 0) })

      REDIS_INCREMENT -> connecting when (!= @payload.key "")
        (set @entity.action "increment")
        (set @entity.emitKey "%s")
        (set @entity.words ["INCRBY", @payload.key, (str/concat (or @payload.by 1))])
        (emit REDIS_CALL_START { })
      REDIS_INCREMENT -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "key is required" })
      REDIS_INCREMENT_REPLIED -> idle
        (emit REDIS_INCREMENTED { value: @payload.reply })

      REDIS_EXPIRE -> connecting when (!= @payload.key "")
        (set @entity.action "expire")
        (set @entity.emitKey "%s")
        (set @entity.words ["PEXPIRE", @payload.key, (str/concat (* @payload.ttl 1000))])
        (emit REDIS_CALL_START { })
      REDIS_EXPIRE -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "key is required" })
      REDIS_EXPIRE_REPLIED -> idle
        (emit REDIS_EXPIRED { set: (= @payload.reply 1) })

      REDIS_PUBLISH -> connecting when (!= @payload.channel "")
        (set @entity.action "publish")
        (set @entity.emitKey "%s")
        (set @entity.words ["PUBLISH", @payload.channel, @payload.message])
        (emit REDIS_CALL_START { })
      REDIS_PUBLISH -> idle when (= @payload.channel "")
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "channel is required" })
      REDIS_PUBLISH_REPLIED -> idle
        (emit REDIS_PUBLISHED { receivers: @payload.reply })

      REDIS_LOCK -> idle when (!= @payload.key "")
        (random-bytes 16 { key: (json/stringify { key: @payload.key, ttl: (or @payload.ttl 30000) }), emit: { success: REDIS_LOCK_ID_DRAWN, failure: REDIS_LOCK_ID_FAILED } })
      REDIS_LOCK -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "key is required" })
      REDIS_LOCK_ID_DRAWN -> connecting
        (set @entity.action "lock")
        (set @entity.emitKey @payload.value)
        (set @entity.words ["SET", (object/get (json/parse @payload.key RedisLockRequest) key ""), @payload.value, "NX", "PX", (str/concat (object/get (json/parse @payload.key RedisLockRequest) ttl 30000))])
        (emit REDIS_CALL_START { })
      REDIS_LOCK_ID_FAILED -> idle
        (emit REDIS_FAILED { action: "lock", kind: "failed", code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Redis unavailable: " @payload.error) })
      REDIS_LOCK_REPLIED -> idle when (= @payload.reply "OK")
        (emit REDIS_LOCKED { acquired: true, lockId: @payload.key })
      REDIS_LOCK_REPLIED -> idle when (!= @payload.reply "OK")
        (emit REDIS_LOCKED { acquired: false, lockId: "" })
      REDIS_LOCK_CALL_FAILED -> idle
        (emit REDIS_FAILED { action: "lock", kind: @payload.kind, code: @payload.code, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Redis unavailable: " @payload.error) })

      REDIS_UNLOCK -> connecting when (and (!= @payload.key "") (!= @payload.lockId ""))
        (set @entity.action "unlock")
        (set @entity.emitKey "%s")
        (set @entity.words ["EVAL", "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end", "1", @payload.key, @payload.lockId])
        (emit REDIS_CALL_START { })
      REDIS_UNLOCK -> idle when (or (= @payload.key "") (= @payload.lockId ""))
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "key and lockId are required" })
      REDIS_UNLOCK_REPLIED -> idle
        (emit REDIS_UNLOCKED { released: (= @payload.reply 1) })

      REDIS_CALL_FAILED -> idle
        (emit REDIS_FAILED { action: @payload.key, kind: @payload.kind, code: @payload.code, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Redis unavailable: " @payload.error) })
    }

    state connecting {
      INIT -> connecting
      REDIS_GET -> connecting
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_SET -> connecting
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_DELETE -> connecting
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_INCREMENT -> connecting
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_EXPIRE -> connecting
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_PUBLISH -> connecting
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK -> connecting
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_UNLOCK -> connecting
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK_ID_DRAWN -> connecting
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })

      REDIS_CALL_START -> connecting
        (set @entity.sock -1)
        (set @entity.password "")
        (set @entity.phase "")
        (set @entity.expected 0)
        (set @entity.got 0)
        (set @entity.inbox "")
        (set @entity.pos 0)
        (set @entity.owed 1)
        (set @entity.ends [])
        (set @entity.nodes [])
        (set @entity.replyKind "")
        (set @entity.replyText "")
        (set @entity.replyNum 0)
        (set @entity.failKind "")
        (set @entity.failCode "")
        (set @entity.failMsg "")
        (set @entity.failCred "")
        (set @entity.cmdWire (bytes/concat (array/prepend (array/map @entity.words (fn w (bytes/concat [(bytes/from-string (str/concat "$" (bytes/length (bytes/from-string @w)) "\r\n")) (bytes/from-string @w) (bytes/from-string "\r\n")]))) (bytes/from-string (str/concat "*" (array/len @entity.words) "\r\n")))))
        (let ((lo (str/lower @config.origin)))
          (let ((tls (str/startsWith @lo "rediss://")))
            (let ((rest (str/slice @config.origin (if @tls 9 8))))
              (let ((parts (str/split @rest ":")))
                (let ((portText (if (= (array/len @parts) 2) (array/nth @parts 1) "6379")))
                  (let ((port (str/to-int @portText)))
                    (do
                      (set @entity.host (str/lower (array/nth @parts 0)))
                      (set @entity.port (or @port 0))
                      (set @entity.originKind (if (or (and (not (str/startsWith @lo "redis://")) (not @tls)) (> (array/len @parts) 2) (= (array/nth @parts 0) "") (!= (str/replace-pattern @rest "[/?#\\\\@ ]" "") @rest) (= @portText "") (!= (str/replace-pattern @portText "[0-9]" "") "") (= @port null) (> (or @port 0) 65535)) "bad" (if @tls "tls" "plain"))))))))))
        (emit REDIS_ORIGIN_READY { })

      REDIS_ORIGIN_READY -> closing when (= @entity.originKind "bad")
        (set @entity.failKind "refused")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: the origin must be redis://host[:port] with no path and be listed in egress")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_ORIGIN_READY -> closing when (= @entity.originKind "tls")
        (set @entity.failKind "unsupported")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: rediss:// needs TLS and os/tcp-connect has no TLS option")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_ORIGIN_READY -> connecting when (and (= @entity.originKind "plain") @config.authenticated)
        (os/getenv @config.passwordEnv { emit: { success: REDIS_PASSWORD_READ failure: REDIS_STEP_FAILED } })
      REDIS_ORIGIN_READY -> connecting when (and (= @entity.originKind "plain") (not @config.authenticated))
        (emit REDIS_DIAL { })

      REDIS_PASSWORD_READ -> closing when (= (or @payload.value "") "")
        (set @entity.failKind "unconfigured")
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: the credential " @config.passwordEnv " is not set"))
        (set @entity.failCred @config.passwordEnv)
        (emit REDIS_FINISH { })
      REDIS_PASSWORD_READ -> connecting when (!= (or @payload.value "") "")
        (set @entity.password @payload.value)
        (emit REDIS_DIAL { })

      REDIS_DIAL -> connecting
        (set @entity.hsWire (bytes/concat (array/map (array/concat (if @config.authenticated [(array/concat ["AUTH"] (if (!= @config.user "") [@config.user] []) [@entity.password])] []) (if (> @config.db 0) [["SELECT", (str/concat @config.db)]] [])) (fn c (bytes/concat (array/prepend (array/map @c (fn w (bytes/concat [(bytes/from-string (str/concat "$" (bytes/length (bytes/from-string @w)) "\r\n")) (bytes/from-string @w) (bytes/from-string "\r\n")]))) (bytes/from-string (str/concat "*" (array/len @c) "\r\n"))))))))
        (set @entity.password "")
        (os/tcp-connect @entity.host @entity.port { emit: { success: REDIS_CONNECTED failure: REDIS_STEP_FAILED } })

      REDIS_CONNECTED -> handshaking when (> (+ (if @config.authenticated 1 0) (if (> @config.db 0) 1 0)) 0)
        (set @entity.sock @payload.sock)
        (set @entity.phase "handshake")
        (set @entity.expected (+ (if @config.authenticated 1 0) (if (> @config.db 0) 1 0)))
        (set @entity.got 0)
        (os/send @payload.sock @entity.hsWire { emit: { success: REDIS_SENT failure: REDIS_STEP_FAILED } })
        (emit REDIS_WIRE_SENT { bytes: (bytes/length @entity.hsWire) })
      REDIS_CONNECTED -> awaiting when (= (+ (if @config.authenticated 1 0) (if (> @config.db 0) 1 0)) 0)
        (set @entity.sock @payload.sock)
        (set @entity.phase "command")
        (set @entity.expected 1)
        (set @entity.got 0)
        (os/send @payload.sock @entity.cmdWire { emit: { success: REDIS_SENT failure: REDIS_STEP_FAILED } })
        (emit REDIS_WIRE_SENT { bytes: (bytes/length @entity.cmdWire) })

      REDIS_STEP_FAILED -> closing
        (set @entity.failKind (if (= @payload.kind "denied") "refused" (if (= @payload.kind "timeout") "timeout" "failed")))
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: " (or @payload.error "the host failed")))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
    }

    state handshaking {
      INIT -> handshaking
      REDIS_GET -> handshaking
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_SET -> handshaking
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_DELETE -> handshaking
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_INCREMENT -> handshaking
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_EXPIRE -> handshaking
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_PUBLISH -> handshaking
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK -> handshaking
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_UNLOCK -> handshaking
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK_ID_DRAWN -> handshaking
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })

      REDIS_SENT -> handshaking
        (os/recv @entity.sock 16384 { emit: { success: REDIS_DATA failure: REDIS_STEP_FAILED } })
      REDIS_DATA -> decoding when (> (bytes/length @payload.data) 0)
        (set @entity.inbox (bytes/concat [@entity.inbox, @payload.data]))
        (emit REDIS_DECODE { })
      REDIS_DATA -> closing when (= (bytes/length @payload.data) 0)
        (set @entity.failKind "failed")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: the server closed the connection before it replied in full")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_STEP_FAILED -> closing
        (set @entity.failKind (if (= @payload.kind "denied") "refused" (if (= @payload.kind "timeout") "timeout" "failed")))
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: " (or @payload.error "the host failed")))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
    }

    state awaiting {
      INIT -> awaiting
      REDIS_GET -> awaiting
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_SET -> awaiting
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_DELETE -> awaiting
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_INCREMENT -> awaiting
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_EXPIRE -> awaiting
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_PUBLISH -> awaiting
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK -> awaiting
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_UNLOCK -> awaiting
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK_ID_DRAWN -> awaiting
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })

      REDIS_SENT -> awaiting
        (os/recv @entity.sock 16384 { emit: { success: REDIS_DATA failure: REDIS_STEP_FAILED } })
      REDIS_DATA -> decoding when (> (bytes/length @payload.data) 0)
        (set @entity.inbox (bytes/concat [@entity.inbox, @payload.data]))
        (emit REDIS_DECODE { })
      REDIS_DATA -> closing when (= (bytes/length @payload.data) 0)
        (set @entity.failKind "failed")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: the server closed the connection before it replied in full")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_STEP_FAILED -> closing
        (set @entity.failKind (if (= @payload.kind "denied") "refused" (if (= @payload.kind "timeout") "timeout" "failed")))
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: " (or @payload.error "the host failed")))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
    }

    state decoding {
      INIT -> decoding
      REDIS_GET -> decoding
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_SET -> decoding
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_DELETE -> decoding
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_INCREMENT -> decoding
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_EXPIRE -> decoding
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_PUBLISH -> decoding
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK -> decoding
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_UNLOCK -> decoding
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK_ID_DRAWN -> decoding
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })

      REDIS_DECODE -> decoding
        (let ((crlf (bytes/from-string "\r\n")))
          (let ((k (bytes/at @entity.inbox @entity.pos)) (e (bytes/index-of @entity.inbox @crlf (+ @entity.pos 1))))
            (let ((line (if (>= @e 0) (bytes/slice @entity.inbox (+ @entity.pos 1) @e) "")))
              (let ((valid (if (>= @e 0) (base64/valid @line) false)))
                (let ((text (if @valid (bytes/to-string @line) "")))
                  (do
                    (set @entity.hk (if (= @k null) -1 @k))
                    (set @entity.he @e)
                    (set @entity.hd (array/len (array/filter @entity.ends (fn x (< @x @entity.owed)))))
                    (set @entity.hv @valid)
                    (set @entity.ht @text)
                    (set @entity.hi (or (str/to-int @text) 0))
                    (set @entity.hiok (!= (str/to-int @text) null))
                    (emit REDIS_HEAD { })))))))

      REDIS_HEAD -> closing when (> @entity.hd 32)
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: frames are nested deeper than 32")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (<= @entity.hd 32) (or (< @entity.hk 0) (< @entity.he 0)))
        (emit REDIS_NEED_MORE { })
      REDIS_HEAD -> closing when (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) (not @entity.hv))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a reply line is not UTF-8")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 43))
        (set @entity.nk "text")
        (set @entity.nt @entity.ht)
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 45))
        (set @entity.nk "error")
        (set @entity.nt @entity.ht)
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 58) @entity.hiok)
        (set @entity.nk "num")
        (set @entity.nt "")
        (set @entity.nn @entity.hi)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 58) (not @entity.hiok) (and (> (str/len @entity.ht) 0) (= (str/replace-pattern @entity.ht "^[+-]?[0-9]+$" "") "")))
        (set @entity.nk "unsupported")
        (set @entity.nt (str/concat "the integer " @entity.ht " does not fit a number exactly"))
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 58) (not @entity.hiok) (not (and (> (str/len @entity.ht) 0) (= (str/replace-pattern @entity.ht "^[+-]?[0-9]+$" "") ""))))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: an integer reply is not an integer")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) (not @entity.hiok))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a bulk length is not an integer")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (= @entity.hi -1))
        (set @entity.nk "null")
        (set @entity.nt "")
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (< @entity.hi -1))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a bulk length is negative")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (> @entity.hi 536870912))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a bulk exceeds the 536870912 byte limit")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (and (>= @entity.hi 0) (<= @entity.hi 536870912)) (< (bytes/length @entity.inbox) (+ @entity.he 4 @entity.hi)))
        (emit REDIS_NEED_MORE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (and (>= @entity.hi 0) (<= @entity.hi 536870912)) (not (< (bytes/length @entity.inbox) (+ @entity.he 4 @entity.hi))) (not (bytes/equals (bytes/slice @entity.inbox (+ @entity.he 2 @entity.hi) (+ @entity.he 4 @entity.hi)) (bytes/from-string "\r\n"))))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a bulk is not terminated by CRLF")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (and (>= @entity.hi 0) (<= @entity.hi 536870912)) (not (< (bytes/length @entity.inbox) (+ @entity.he 4 @entity.hi))) (not (not (bytes/equals (bytes/slice @entity.inbox (+ @entity.he 2 @entity.hi) (+ @entity.he 4 @entity.hi)) (bytes/from-string "\r\n")))) (base64/valid (bytes/slice @entity.inbox (+ @entity.he 2) (+ @entity.he 2 @entity.hi))))
        (set @entity.nk "text")
        (set @entity.nt (bytes/to-string (bytes/slice @entity.inbox (+ @entity.he 2) (+ @entity.he 2 @entity.hi))))
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 4 @entity.hi))
        (emit REDIS_NODE { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 36) @entity.hiok (and (>= @entity.hi 0) (<= @entity.hi 536870912)) (not (< (bytes/length @entity.inbox) (+ @entity.he 4 @entity.hi))) (not (not (bytes/equals (bytes/slice @entity.inbox (+ @entity.he 2 @entity.hi) (+ @entity.he 4 @entity.hi)) (bytes/from-string "\r\n")))) (not (base64/valid (bytes/slice @entity.inbox (+ @entity.he 2) (+ @entity.he 2 @entity.hi)))))
        (set @entity.nk "unsupported")
        (set @entity.nt "the reply holds bytes that are not UTF-8 text")
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 4 @entity.hi))
        (emit REDIS_NODE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 42) (not @entity.hiok))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: an array length is not an integer")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 42) @entity.hiok (= @entity.hi -1))
        (set @entity.nk "null")
        (set @entity.nt "")
        (set @entity.nn 0)
        (set @entity.nc 0)
        (set @entity.na false)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 42) @entity.hiok (< @entity.hi -1))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: an array length is negative")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 42) @entity.hiok (>= @entity.hi 0) (< @entity.hd 3))
        (set @entity.nk "array")
        (set @entity.nt "")
        (set @entity.nn 0)
        (set @entity.nc @entity.hi)
        (set @entity.na true)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> decoding when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (= @entity.hk 42) @entity.hiok (>= @entity.hi 0) (>= @entity.hd 3))
        (set @entity.nk "unsupported")
        (set @entity.nt "the reply is nested deeper than 3 lists")
        (set @entity.nn 0)
        (set @entity.nc @entity.hi)
        (set @entity.na true)
        (set @entity.np (+ @entity.he 2))
        (emit REDIS_NODE { })
      REDIS_HEAD -> closing when (and (and (<= @entity.hd 32) (>= @entity.hk 0) (>= @entity.he 0) @entity.hv) (not (= @entity.hk 43)) (not (= @entity.hk 45)) (not (= @entity.hk 58)) (not (= @entity.hk 36)) (not (= @entity.hk 42)))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: unknown RESP type byte")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })

      REDIS_NODE -> decoding
        (let ((c @entity.owed))
          (do
            (set @entity.nodes (array/append @entity.nodes { kind: @entity.nk, text: @entity.nt, num: @entity.nn, depth: @entity.hd }))
            (set @entity.ends (if @entity.na (array/append (array/filter @entity.ends (fn x (< @x @c))) (- @c 1)) @entity.ends))
            (set @entity.owed (+ (- @c 1) @entity.nc))
            (set @entity.pos @entity.np)
            (if (= (+ (- @c 1) @entity.nc) 0) (emit REDIS_REPLY_DONE { }) (emit REDIS_DECODE { }))))

      REDIS_NEED_MORE -> handshaking when (= @entity.phase "handshake")
        (os/recv @entity.sock 16384 { emit: { success: REDIS_DATA failure: REDIS_STEP_FAILED } })
      REDIS_NEED_MORE -> awaiting when (= @entity.phase "command")
        (os/recv @entity.sock 16384 { emit: { success: REDIS_DATA failure: REDIS_STEP_FAILED } })

      REDIS_REPLY_DONE -> closing when (and (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0) (= (object/get (array/nth @entity.nodes (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported"))))) kind "") "error"))
        (set @entity.failKind "redis")
        (set @entity.failCode (array/first (str/split (object/get (array/nth @entity.nodes (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported"))))) text "") " ")))
        (set @entity.failMsg (object/get (array/nth @entity.nodes (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported"))))) text ""))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_REPLY_DONE -> closing when (and (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0) (= (object/get (array/nth @entity.nodes (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported"))))) kind "") "unsupported"))
        (set @entity.failKind "unsupported")
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: " (object/get (array/nth @entity.nodes (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported"))))) text "")))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_REPLY_DONE -> decoding when (and (not (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0)) (= @entity.phase "handshake") (< (+ @entity.got 1) @entity.expected))
        (set @entity.got (+ @entity.got 1))
        (set @entity.owed 1)
        (set @entity.ends [])
        (set @entity.nodes [])
        (emit REDIS_DECODE { })
      REDIS_REPLY_DONE -> awaiting when (and (not (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0)) (= @entity.phase "handshake") (>= (+ @entity.got 1) @entity.expected))
        (set @entity.phase "command")
        (set @entity.expected 1)
        (set @entity.got 0)
        (set @entity.inbox "")
        (set @entity.pos 0)
        (set @entity.owed 1)
        (set @entity.ends [])
        (set @entity.nodes [])
        (os/send @entity.sock @entity.cmdWire { emit: { success: REDIS_SENT failure: REDIS_STEP_FAILED } })
        (emit REDIS_WIRE_SENT { bytes: (bytes/length @entity.cmdWire) })
      REDIS_REPLY_DONE -> closing when (and (not (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0)) (= @entity.phase "command") (= (object/get (array/nth @entity.nodes 0) kind "") "array"))
        (set @entity.failKind "unsupported")
        (set @entity.failCode "")
        (set @entity.failMsg "redis: a list reply is not surfaced by any std-redis action")
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_REPLY_DONE -> closing when (and (not (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0)) (= @entity.phase "command") (!= (object/get (array/nth @entity.nodes 0) kind "") "array") (not (if (or (= @entity.action "get") (= @entity.action "set") (= @entity.action "lock")) (or (= (object/get (array/nth @entity.nodes 0) kind "") "text") (= (object/get (array/nth @entity.nodes 0) kind "") "null")) (= (object/get (array/nth @entity.nodes 0) kind "") "num"))))
        (set @entity.failKind "protocol")
        (set @entity.failCode "")
        (set @entity.failMsg (str/concat "redis: the reply to " @entity.action " is not the expected type"))
        (set @entity.failCred "")
        (emit REDIS_FINISH { })
      REDIS_REPLY_DONE -> closing when (and (not (>= (array/findIndex @entity.nodes (fn n (or (= @n.kind "error") (= @n.kind "unsupported")))) 0)) (= @entity.phase "command") (!= (object/get (array/nth @entity.nodes 0) kind "") "array") (if (or (= @entity.action "get") (= @entity.action "set") (= @entity.action "lock")) (or (= (object/get (array/nth @entity.nodes 0) kind "") "text") (= (object/get (array/nth @entity.nodes 0) kind "") "null")) (= (object/get (array/nth @entity.nodes 0) kind "") "num")))
        (set @entity.replyKind (object/get (array/nth @entity.nodes 0) kind ""))
        (set @entity.replyText (object/get (array/nth @entity.nodes 0) text ""))
        (set @entity.replyNum (or (object/get (array/nth @entity.nodes 0) num 0) 0))
        (emit REDIS_FINISH { })
    }

    state closing {
      INIT -> closing
      REDIS_GET -> closing
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_SET -> closing
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_DELETE -> closing
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_INCREMENT -> closing
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_EXPIRE -> closing
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_PUBLISH -> closing
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK -> closing
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_UNLOCK -> closing
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "a Redis call is already in flight" })
      REDIS_LOCK_ID_DRAWN -> closing
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "a Redis call is already in flight" })

      REDIS_FINISH -> closing when (>= @entity.sock 0)
        (os/close @entity.sock { emit: { success: REDIS_CLOSED failure: REDIS_CLOSED } })
      REDIS_FINISH -> closing when (< @entity.sock 0)
        (emit REDIS_CLOSED { })
      REDIS_CLOSED -> idle when (and (!= @entity.failKind "") (!= @entity.action "lock"))
        (set @entity.sock -1)
        (emit REDIS_CALL_FAILED { error: @entity.failMsg, kind: @entity.failKind, code: (if (= @entity.failCode "") null @entity.failCode), credential: (if (= @entity.failCred "") null @entity.failCred), key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (!= @entity.failKind "") (= @entity.action "lock"))
        (set @entity.sock -1)
        (emit REDIS_LOCK_CALL_FAILED { error: @entity.failMsg, kind: @entity.failKind, code: (if (= @entity.failCode "") null @entity.failCode), credential: (if (= @entity.failCred "") null @entity.failCred), key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "get"))
        (set @entity.sock -1)
        (emit REDIS_GET_REPLIED { reply: (if (= @entity.replyKind "text") @entity.replyText null), key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "set"))
        (set @entity.sock -1)
        (emit REDIS_SET_REPLIED { reply: (if (= @entity.replyKind "text") @entity.replyText null), key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "lock"))
        (set @entity.sock -1)
        (emit REDIS_LOCK_REPLIED { reply: (if (= @entity.replyKind "text") @entity.replyText null), key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "delete"))
        (set @entity.sock -1)
        (emit REDIS_DELETE_REPLIED { reply: @entity.replyNum, key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "increment"))
        (set @entity.sock -1)
        (emit REDIS_INCREMENT_REPLIED { reply: @entity.replyNum, key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "expire"))
        (set @entity.sock -1)
        (emit REDIS_EXPIRE_REPLIED { reply: @entity.replyNum, key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "publish"))
        (set @entity.sock -1)
        (emit REDIS_PUBLISH_REPLIED { reply: @entity.replyNum, key: @entity.emitKey })
      REDIS_CLOSED -> idle when (and (= @entity.failKind "") (= @entity.action "unlock"))
        (set @entity.sock -1)
        (emit REDIS_UNLOCK_REPLIED { reply: @entity.replyNum, key: @entity.emitKey })
    }
    emits {
      REDIS_GOT -> external {
        value : string
      }
        @description "The value stored at the key as text; null when the key does not exist."
        @synonyms "cache hit, value read, key value"
        @tier "primary"
      REDIS_SET_DONE -> external {
        ok : boolean!
      }
        @description "The key was set; ok is true when the server answered OK."
        @synonyms "cache stored, value written"
        @tier "primary"
      REDIS_DELETED -> external {
        deleted : boolean!
      }
        @description "Whether the key existed and was removed."
        @synonyms "cache evicted, key removed"
        @tier "primary"
      REDIS_INCREMENTED -> external {
        value : number!
      }
        @description "The counter's value after INCRBY; a missing key starts at 0."
        @synonyms "counter incremented, count after increase"
        @tier "primary"
      REDIS_EXPIRED -> external {
        set : boolean!
      }
        @description "Whether the key existed and now expires after the given seconds."
        @synonyms "expiry set, ttl applied"
        @tier "primary"
      REDIS_PUBLISHED -> external {
        receivers : number!
      }
        @description "How many subscribers received the message."
        @synonyms "message published, subscribers reached"
        @tier "primary"
      REDIS_LOCKED -> external {
        acquired : boolean!
        lockId : string!
      }
        @description "Whether the lock was taken and, when it was, the id that releases it; empty when another holder has it."
        @synonyms "lock acquired, mutex taken"
        @tier "primary"
      REDIS_UNLOCKED -> external {
        released : boolean!
      }
        @description "Whether the lock was held under that id and is now released; false when it expired or another holder has it."
        @synonyms "lock released, mutex freed"
        @tier "primary"
      REDIS_FAILED -> external {
        action : string!
        kind : string!
        code : string
        message : string!
      }
        @description "A call did not complete: the action, the kind (refused, unconfigured, timeout, failed, protocol, unsupported, redis), the Redis error word when the server answered one (WRONGTYPE, NOAUTH, ...) and the message."
        @synonyms "cache failed, redis unreachable, wrong password"
        @tier "primary"
      REDIS_GET_REPLIED {
        reply : string
        key : string!
      }
        @description "Internal: the GET reply."
        @tier "secondary"
      REDIS_SET_REPLIED {
        reply : string
        key : string!
      }
        @description "Internal: the SET reply."
        @tier "secondary"
      REDIS_DELETE_REPLIED {
        reply : number!
        key : string!
      }
        @description "Internal: the DEL reply."
        @tier "secondary"
      REDIS_INCREMENT_REPLIED {
        reply : number!
        key : string!
      }
        @description "Internal: the INCRBY reply."
        @tier "secondary"
      REDIS_EXPIRE_REPLIED {
        reply : number!
        key : string!
      }
        @description "Internal: the PEXPIRE reply."
        @tier "secondary"
      REDIS_PUBLISH_REPLIED {
        reply : number!
        key : string!
      }
        @description "Internal: the PUBLISH reply."
        @tier "secondary"
      REDIS_LOCK_REPLIED {
        reply : string
        key : string!
      }
        @description "Internal: the SET NX PX reply; OK when the lock was taken, null when it was not. The key is the lock id."
        @tier "secondary"
      REDIS_UNLOCK_REPLIED {
        reply : number!
        key : string!
      }
        @description "Internal: the compare-and-delete reply; 1 when the lock was released."
        @tier "secondary"
      REDIS_CALL_FAILED {
        error : string!
        kind : string!
        code : string
        credential : string
        key : string!
      }
        @description "Internal: a call failed; the key is the action."
        @tier "secondary"
      REDIS_LOCK_CALL_FAILED {
        error : string!
        kind : string!
        code : string
        credential : string
        key : string!
      }
        @description "Internal: the lock call failed; the key is the lock id."
        @tier "secondary"
      REDIS_LOCK_ID_DRAWN {
        value : string!
        key : string!
      }
        @description "Internal: the lock id was drawn from the host CSPRNG; the key carries the lock request."
        @tier "secondary"
      REDIS_LOCK_ID_FAILED {
        error : string!
      }
        @description "Internal: the host could not draw a lock id."
        @tier "secondary"
      REDIS_WIRE_SENT -> external {
        bytes : number!
      }
        @description "Bytes of one RESP pipeline written to the socket: the AUTH and SELECT handshake, then the command."
        @synonyms "bytes sent, wire write"
        @tier "primary"
      REDIS_CALL_START -> internal { }
        @description "Internal: a request began; reset the call and parse the origin."
        @tier "internal"
      REDIS_ORIGIN_READY -> internal { }
        @description "Internal: the origin was parsed."
        @tier "internal"
      REDIS_PASSWORD_READ -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for the password."
        @tier "internal"
      REDIS_DIAL -> internal { }
        @description "Internal: build the handshake and open the socket."
        @tier "internal"
      REDIS_CONNECTED -> internal {
        sock : number!
      }
        @description "Internal: the socket opened."
        @tier "internal"
      REDIS_SENT -> internal {
        bytes : number
      }
        @description "Internal: a pipeline was written; read its replies."
        @tier "internal"
      REDIS_DATA -> internal {
        data : bytes!
        eof : boolean
      }
        @description "Internal: one read of the socket; empty data is the server closing."
        @tier "internal"
      REDIS_STEP_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: an os/getenv, os/tcp-connect, os/send or os/recv failure; kind is the host's (denied, timeout, io, closed)."
        @tier "internal"
      REDIS_DECODE -> internal { }
        @description "Internal: read the header of the next frame."
        @tier "internal"
      REDIS_HEAD -> internal { }
        @description "Internal: the next frame's header was read; classify it."
        @tier "internal"
      REDIS_NODE -> internal { }
        @description "Internal: add the classified node to the reply."
        @tier "internal"
      REDIS_NEED_MORE -> internal { }
        @description "Internal: the frame is cut; read more bytes."
        @tier "internal"
      REDIS_REPLY_DONE -> internal { }
        @description "Internal: one whole reply was decoded."
        @tier "internal"
      REDIS_FINISH -> internal { }
        @description "Internal: the call ended; close the socket and answer."
        @tier "internal"
      REDIS_CLOSED -> internal {
        error : string
        kind : string
      }
        @description "Internal: the socket is closed, or was never opened; a close failure changes nothing."
        @tier "internal"
    }

    listens {
      REDIS_GET -> external {
        key : string!
      }
        @description "Read the text value stored at a key."
        @synonyms "cache get, read key, fetch cached value"
      REDIS_SET -> external {
        key : string!
        value : string!
        ttl : number
      }
        @description "Store a text value at a key; ttl is seconds, none keeps it until removed."
        @synonyms "cache set, write key, store value"
      REDIS_DELETE -> external {
        key : string!
      }
        @description "Remove a key."
        @synonyms "cache delete, evict key, remove value"
      REDIS_INCREMENT -> external {
        key : string!
        by : number
      }
        @description "Add to a counter (INCRBY); by defaults to 1 and a missing key starts at 0."
        @synonyms "counter increment, count up, add to counter"
      REDIS_EXPIRE -> external {
        key : string!
        ttl : number!
      }
        @description "Make a key expire after ttl seconds."
        @synonyms "set expiry, time to live, expire key"
      REDIS_PUBLISH -> external {
        channel : string!
        message : string!
      }
        @description "Publish a text message on a channel."
        @synonyms "publish message, broadcast, send to channel"
      REDIS_LOCK -> external {
        key : string!
        ttl : number
      }
        @description "Take a lock on a key for ttl milliseconds (default 30000); the answer carries the id that releases it."
        @synonyms "acquire lock, mutex, take lock"
      REDIS_UNLOCK -> external {
        key : string!
        lockId : string!
      }
        @description "Release a lock held under lockId; only the holder releases it."
        @synonyms "release lock, free mutex, drop lock"
      REDIS_GET_REPLIED {
        reply : string
        key : string!
      }
      REDIS_SET_REPLIED {
        reply : string
        key : string!
      }
      REDIS_DELETE_REPLIED {
        reply : number!
        key : string!
      }
      REDIS_INCREMENT_REPLIED {
        reply : number!
        key : string!
      }
      REDIS_EXPIRE_REPLIED {
        reply : number!
        key : string!
      }
      REDIS_PUBLISH_REPLIED {
        reply : number!
        key : string!
      }
      REDIS_LOCK_REPLIED {
        reply : string
        key : string!
      }
      REDIS_UNLOCK_REPLIED {
        reply : number!
        key : string!
      }
      REDIS_CALL_FAILED {
        error : string!
        kind : string!
        code : string
        credential : string
        key : string!
      }
      REDIS_LOCK_CALL_FAILED {
        error : string!
        kind : string!
        code : string
        credential : string
        key : string!
      }
      REDIS_LOCK_ID_DRAWN {
        value : string!
        key : string!
      }
      REDIS_LOCK_ID_FAILED {
        error : string!
      }
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports a failed Redis call; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      origin : url = "redis://redis.example.test:6379"
        @label "Redis origin"
        @description "The Redis server as redis://host[:port], or rediss://host[:port] for TLS (no path; TLS is unsupported). Must be declared in the app egress list."
        @synonyms "redis url, cache host, redis server"
        @tier "infra"
      authenticated : boolean = true
        @label "Authenticate"
        @description "Send AUTH before every command; when false no AUTH is sent and the password variable is not read."
        @synonyms "use password, require auth, protected server"
        @tier "infra"
      passwordEnv : string = "REDIS_PASSWORD"
        @label "Password variable"
        @description "The environment variable that holds the Redis password; required when authenticated is true, and listed in the app env grant."
        @synonyms "redis password, auth secret, cache credential"
        @tier "infra"
      user : string = ""
        @label "ACL user"
        @description "The Redis ACL user to log in as with the password; empty uses the default user."
        @synonyms "redis user, acl user, username"
        @tier "infra"
      db : number = 0
        @label "Database"
        @description "The logical database to SELECT before each command; 0 sends no SELECT."
        @synonyms "redis database, db index, keyspace"
        @tier "infra"
    }
  }

  page "/redis" as RedisPage -> RedisClient
}
