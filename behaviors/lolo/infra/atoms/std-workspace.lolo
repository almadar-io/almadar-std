app std-workspace [
  version: "1.0.0",
  description: "std-workspace — a viewer's project workspace as a git repository, run entirely by the kernel's os/ effects (no host provider). Requests are queued and run one at a time: tree, read, write and remove a file, snapshot (a commit), history with undo/redo flags, the file changes of one snapshot, and restore, undo and redo (each a new commit carrying its own trailer). A workspace lives at <root>/<owner>/<workspace>, where owner and workspace are reversible one-segment encodings, and is found again by the appId in its .almadar/app-marker.json. Which workspaces a viewer may open is declared: scope own opens any id inside the viewer's own owner directory, scope listed also requires the viewer and workspace in the access knob. Every git call is os/spawn git with -C naming the workspace directory. Store disk keeps the workspaces only under root. Store bucket treats root as a cache: a cold workspace is restored from workspaces/<owner>/<workspace>/files/ and its git history from the base and incremental bundles under .../history/, and every write, remove, snapshot, restore, undo and redo is mirrored back through the WorkspaceStore trait (std-storage over SigV4: Google Cloud Storage's S3 interoperability endpoint with HMAC keys, or any S3-compatible service). A file that is not valid UTF-8 text answers WORKSPACE_READ_FAILED with code not-text. Needs fs read and create on the root, the exec grant for git and, in bucket mode, the storage origin in egress. Residual authority: the exec grant is for the git executable, and the grant checks only git's working directory, so git itself can reach any path through its arguments; the atom's own owner/workspace/path/oid checks, not a grant, confine them to the workspace.",
  fs: { "/var/lib/almadar/workspaces/**": [read, write, create, remove] },
  egress: ["https://storage.googleapis.com"],
  exec: ["git"]
]
type WorkspaceStep = { scope : "root" | "repo", args : [string], stdin : string, feed : boolean, tolerate : boolean, raw : boolean }
type WorkspaceRequest = { action : string, workspace : string, user : string, path : string, content : string, reason : string, oid : string, limit : number }
type WorkspaceNode = { id : string!, path : string!, type : string!, size : number! }
type WorkspaceSnapshot = { id : string!, timestamp : number!, reason : string!, kind : string!, target : string! }
type WorkspaceChange = { id : string!, path : string!, before : string!, after : string!, change : string! }
type WorkspaceEntry = { id : string, timestamp : number, reason : string, kind : string, restores : string, undoes : string, redoes : string }
type WorkspaceKey = { key : string!, size : number!, lastModified : number! }
type BucketStep = { op : string, key : string, content : string, prefix : string }
type WalkItem = { path : string, kind : string }
type WalkEntry = { name : string, kind : string }
type WorkspaceFileData = { path : string }
type WorkspaceAccess = { user : string!, workspaces : [string]! }
orbital WorkspaceOrbital {
  uses Storage from "std/behaviors/std-storage"
  entity WorkspaceJob [runtime] {
    id : string!
    queue : [WorkspaceRequest] = []
    action : string @description "The request being run." = ""
    workspace : string = ""
    user : string = ""
    path : string = ""
    content : string = ""
    reason : string = ""
    oid : string = ""
    limit : number = -1
    owner : string = ""
    slug : string = ""
    dir : string @description "Absolute directory of the workspace being run." = ""
    problemCode : string = ""
    problemMessage : string = ""
    stage : string = ""
    steps : [WorkspaceStep] = []
    cursor : number = 0
    outputs : [string] = []
    codes : [number] = []
    failures : [string] = []
    argv : [string] = []
    stepIn : string = ""
    stepFeed : boolean = false
    pid : number = 0
    inFd : number = 0
    outFd : number = 0
    errFd : number = 0
    buf : bytes = ""
    stdoutText : string = ""
    stderrText : string = ""
    outValid : boolean = true
    entries : [WorkspaceEntry] = []
    paths : [string] = []
    ref : string = ""
    tree : string = ""
    subject : string = ""
    trailer : string = ""
    toRestore : [string] = []
    toRemove : [string] = []
    specs : [string] = []
    files : [string] = []
    wsRel : string @description "The workspace directory relative to root." = ""
    wpaths : [string] = []
    wdata : [bytes] = []
    wcursor : number = 0
    wstage : string = ""
    rpaths : [string] = []
    rdata : [bytes] = []
    rcursor : number = 0
    rstage : string = ""
    wstack : [WalkItem] = []
    wnodes : [WorkspaceNode] = []
    wcur : string = ""
    wfor : string = ""
    wstarted : boolean = false
    bseq : number = 0
    pfx : string = ""
    existed : boolean = false
    needSync : boolean = false
    syncNext : string = ""
    withArchive : boolean = false
    synced : boolean = false
    resCommitted : boolean = false
    resChanged : boolean = false
    resOid : string = ""
    bsteps : [BucketStep] = []
    bcursor : number = 0
    bresults : [bytes] = []
    rawInputs : [bytes] = []
    bkeys : [string] = []
    btoken : string = ""
    bstage : string = ""
    rawOuts : [bytes] = []
    stdoutBytes : bytes = ""
    stepRaw : boolean = false
    stepRawIn : bytes = ""
    since : string = ""
    incs : number = 0
    full : boolean = false
    bundle : bytes = ""
  }

  trait WorkspaceClient -> WorkspaceJob [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle

      WORKSPACE_TREE -> working
        (set @entity.queue (array/append @entity.queue { action: "tree", workspace: @payload.workspace, user: (str/default @user.id ""), path: (str/default @payload.path ""), content: "", reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_READ_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "readFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: "", reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_WRITE_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "writeFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: @payload.content, reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_REMOVE_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "removeFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: "", reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_SNAPSHOT -> working
        (set @entity.queue (array/append @entity.queue { action: "snapshot", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: @payload.reason, oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_HISTORY -> working
        (set @entity.queue (array/append @entity.queue { action: "history", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: (math/default @payload.limit -1) }))
        (emit WS_NEXT { })
      WORKSPACE_CHANGES -> working
        (set @entity.queue (array/append @entity.queue { action: "changes", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: @payload.oid, limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_RESTORE -> working
        (set @entity.queue (array/append @entity.queue { action: "restore", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: @payload.oid, limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_UNDO -> working
        (set @entity.queue (array/append @entity.queue { action: "undo", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
      WORKSPACE_REDO -> working
        (set @entity.queue (array/append @entity.queue { action: "redo", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: -1 }))
        (emit WS_NEXT { })
    }

    state working {
      INIT -> working

      WORKSPACE_TREE -> working
        (set @entity.queue (array/append @entity.queue { action: "tree", workspace: @payload.workspace, user: (str/default @user.id ""), path: (str/default @payload.path ""), content: "", reason: "", oid: "", limit: -1 }))
      WORKSPACE_READ_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "readFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: "", reason: "", oid: "", limit: -1 }))
      WORKSPACE_WRITE_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "writeFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: @payload.content, reason: "", oid: "", limit: -1 }))
      WORKSPACE_REMOVE_FILE -> working
        (set @entity.queue (array/append @entity.queue { action: "removeFile", workspace: @payload.workspace, user: (str/default @user.id ""), path: @payload.path, content: "", reason: "", oid: "", limit: -1 }))
      WORKSPACE_SNAPSHOT -> working
        (set @entity.queue (array/append @entity.queue { action: "snapshot", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: @payload.reason, oid: "", limit: -1 }))
      WORKSPACE_HISTORY -> working
        (set @entity.queue (array/append @entity.queue { action: "history", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: (math/default @payload.limit -1) }))
      WORKSPACE_CHANGES -> working
        (set @entity.queue (array/append @entity.queue { action: "changes", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: @payload.oid, limit: -1 }))
      WORKSPACE_RESTORE -> working
        (set @entity.queue (array/append @entity.queue { action: "restore", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: @payload.oid, limit: -1 }))
      WORKSPACE_UNDO -> working
        (set @entity.queue (array/append @entity.queue { action: "undo", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: -1 }))
      WORKSPACE_REDO -> working
        (set @entity.queue (array/append @entity.queue { action: "redo", workspace: @payload.workspace, user: (str/default @user.id ""), path: "", content: "", reason: "", oid: "", limit: -1 }))

      WS_NEXT -> idle when (== (array/len @entity.queue) 0)
      WS_NEXT -> working when (> (array/len @entity.queue) 0)
        (set @entity.action (object/get (array/first @entity.queue) action))
        (set @entity.workspace (object/get (array/first @entity.queue) workspace))
        (set @entity.user (object/get (array/first @entity.queue) user))
        (set @entity.content (object/get (array/first @entity.queue) content))
        (set @entity.reason (object/get (array/first @entity.queue) reason))
        (set @entity.oid (object/get (array/first @entity.queue) oid))
        (set @entity.limit (object/get (array/first @entity.queue) limit))
        (set @entity.path (if (== (object/get (array/first @entity.queue) path) "") "" (os/path-normalize (object/get (array/first @entity.queue) path))))
        (set @entity.owner (str/join (array/map (str/split (array/reduce [{ from: "_", to: "%5F" }, { from: ".", to: "%2E" }, { from: "!", to: "%21" }, { from: "~", to: "%7E" }, { from: "*", to: "%2A" }, { from: "'", to: "%27" }, { from: "(", to: "%28" }, { from: ")", to: "%29" }] (str/encode-uri-component (object/get (array/first @entity.queue) user)) (fn acc pair (str/replaceAll @acc (object/get @pair from) (object/get @pair to)))) "%") (fn part i (if (== @i 0) @part (str/concat "_" (str/lower (str/slice @part 0 2)) (str/slice @part 2))))) ""))
        (set @entity.slug (str/join (array/map (str/split (array/reduce [{ from: "_", to: "%5F" }, { from: ".", to: "%2E" }, { from: "!", to: "%21" }, { from: "~", to: "%7E" }, { from: "*", to: "%2A" }, { from: "'", to: "%27" }, { from: "(", to: "%28" }, { from: ")", to: "%29" }] (str/encode-uri-component (object/get (array/first @entity.queue) workspace)) (fn acc pair (str/replaceAll @acc (object/get @pair from) (object/get @pair to)))) "%") (fn part i (if (== @i 0) @part (str/concat "_" (str/lower (str/slice @part 0 2)) (str/slice @part 2))))) ""))
        (set @entity.problemCode "")
        (set @entity.problemMessage "")
        (set @entity.problemMessage (if (and (!= @entity.path "") (or (== @entity.path "..") (str/startsWith @entity.path "../"))) (str/concat "sandbox: path escapes workspace (" (object/get (array/first @entity.queue) path) ")") @entity.problemMessage))
        (set @entity.problemMessage (if (str/startsWith (object/get (array/first @entity.queue) path) "/") (str/concat "sandbox: absolute paths are not allowed (" (object/get (array/first @entity.queue) path) ")") @entity.problemMessage))
        (set @entity.problemMessage (if (and (array/includes ["readFile", "writeFile", "removeFile"] @entity.action) (== (object/get (array/first @entity.queue) path) "")) "sandbox: empty relative path" @entity.problemMessage))
        (set @entity.problemCode (if (and (== @config.scope "listed") (not (array/some @config.access (fn g (and (== (object/get @g user) @entity.user) (array/includes (object/get @g workspaces) @entity.workspace)))))) "FORBIDDEN" @entity.problemCode))
        (set @entity.problemCode (if (and (array/includes ["writeFile", "removeFile"] @entity.action) (array/includes (array/map (str/split @entity.path "/") (fn seg (str/lower @seg))) ".git")) "reserved-path" @entity.problemCode))
        (set @entity.problemMessage (if (and (array/includes ["writeFile", "removeFile"] @entity.action) (array/includes (array/map (str/split @entity.path "/") (fn seg (str/lower @seg))) ".git")) (str/concat "reserved path: " @entity.path " is inside .git") @entity.problemMessage))
        (set @entity.problemMessage (if (and (== @config.scope "listed") (not (array/some @config.access (fn g (and (== (object/get @g user) @entity.user) (array/includes (object/get @g workspaces) @entity.workspace)))))) (str/concat "Workspace " @entity.workspace " is not open to this viewer") @entity.problemMessage))
        (set @entity.problemCode (if (== @entity.user "") "AUTH_ERROR" @entity.problemCode))
        (set @entity.problemMessage (if (== @entity.user "") "A workspace needs a signed-in caller" @entity.problemMessage))
        (set @entity.synced false)
        (set @entity.needSync false)
        (set @entity.queue (array/drop @entity.queue 1))
        (emit WS_BEGIN { })

      WS_BEGIN -> working when (!= @entity.problemMessage "")
        (emit WS_FAIL { code: @entity.problemCode, message: @entity.problemMessage })
      WS_BEGIN -> working when (== @entity.problemMessage "")
        (set @entity.dir (str/concat @config.root "/" @entity.owner "/" @entity.slug))
        (set @entity.wsRel (str/concat @entity.owner "/" @entity.slug))
        (set @entity.pfx (str/concat "workspaces/" @entity.owner "/" @entity.slug "/"))
        (os/mkdir @config.root true { emit: { success: WS_ROOT_READY, failure: WS_STEP_ERROR } })

      WS_ROOT_READY -> working
        (set @entity.stage "lookup")
        (set @entity.steps [{ scope: "root", args: ["grep", "--no-index", "-l", "-F", "-e", (str/concat "\"appId\": " (json/stringify @entity.workspace)), "--", (str/concat ":(glob)" @entity.owner "/*/.almadar/app-marker.json")], stdin: "", feed: false, tolerate: true, raw: false }])
        (emit WS_START { })

      WS_START -> working
        (set @entity.cursor 0)
        (set @entity.outputs [])
        (set @entity.codes [])
        (set @entity.failures [])
        (set @entity.rawOuts [])
        (emit WS_RUN { })

      WS_RUN -> working
        (set @entity.argv (array/concat ["-C", (if (== (object/get (array/nth @entity.steps @entity.cursor) scope) "root") @config.root @entity.dir), "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "protocol.allow=never"] (object/get (array/nth @entity.steps @entity.cursor) args)))
        (set @entity.stepIn (object/get (array/nth @entity.steps @entity.cursor) stdin))
        (set @entity.stepFeed (object/get (array/nth @entity.steps @entity.cursor) feed))
        (set @entity.stepRaw (object/get (array/nth @entity.steps @entity.cursor) raw))
        (set @entity.stepRawIn (if (object/get (array/nth @entity.steps @entity.cursor) raw) (array/nth @entity.rawInputs @entity.cursor) (bytes/from-string "")))
        (emit WS_EXEC { })

      WS_EXEC -> working
        (os/spawn "git" @entity.argv { cwd: @config.root, env: { PATH: @config.gitPath, LC_ALL: "C", GIT_CEILING_DIRECTORIES: (os/path-dir @entity.dir) }, stdin: (if @entity.stepFeed "pipe" "null"), stdout: "pipe", stderr: "pipe" } { key: "spawn", emit: { success: WS_SPAWNED, failure: WS_STEP_ERROR } })

      WS_SPAWNED -> working when @entity.stepFeed
        (set @entity.pid @payload.pid)
        (set @entity.inFd @payload.stdin)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (set @entity.buf (bytes/from-string ""))
        (os/write @payload.stdin (if @entity.stepRaw @entity.stepRawIn (bytes/from-string @entity.stepIn)) { key: "stdin", emit: { success: WS_STDIN_DONE, failure: WS_STEP_ERROR } })
      WS_SPAWNED -> working when (not @entity.stepFeed)
        (set @entity.pid @payload.pid)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (set @entity.buf (bytes/from-string ""))
        (os/read @payload.stdout 65536 { key: "out", emit: { success: WS_OUT_CHUNK, failure: WS_STEP_ERROR } })
      WS_STDIN_DONE -> working
        (os/close @entity.inFd { key: "stdin-close", emit: { success: WS_STDIN_CLOSED, failure: WS_STEP_ERROR } })
      WS_STDIN_CLOSED -> working
        (os/read @entity.outFd 65536 { key: "out", emit: { success: WS_OUT_CHUNK, failure: WS_STEP_ERROR } })
      WS_OUT_CHUNK -> working when (not @payload.eof)
        (set @entity.buf (bytes/concat [@entity.buf, @payload.data]))
        (os/read @entity.outFd 65536 { key: "out", emit: { success: WS_OUT_CHUNK, failure: WS_STEP_ERROR } })
      WS_OUT_CHUNK -> working when @payload.eof
        (os/close @entity.outFd { key: "out-close", emit: { success: WS_OUT_CLOSED, failure: WS_STEP_ERROR } })
      WS_OUT_CLOSED -> working
        (set @entity.stdoutBytes @entity.buf)
        (set @entity.outValid (base64/valid @entity.buf))
        (set @entity.stdoutText (if (base64/valid @entity.buf) (bytes/to-string @entity.buf) ""))
        (set @entity.buf (bytes/from-string ""))
        (os/read @entity.errFd 65536 { key: "err", emit: { success: WS_ERR_CHUNK, failure: WS_STEP_ERROR } })
      WS_ERR_CHUNK -> working when (not @payload.eof)
        (set @entity.buf (bytes/concat [@entity.buf, @payload.data]))
        (os/read @entity.errFd 65536 { key: "err", emit: { success: WS_ERR_CHUNK, failure: WS_STEP_ERROR } })
      WS_ERR_CHUNK -> working when @payload.eof
        (os/close @entity.errFd { key: "err-close", emit: { success: WS_ERR_CLOSED, failure: WS_STEP_ERROR } })
      WS_ERR_CLOSED -> working
        (set @entity.stderrText (if (base64/valid @entity.buf) (bytes/to-string @entity.buf) ""))
        (os/wait @entity.pid { key: "wait", emit: { success: WS_WAITED, failure: WS_STEP_ERROR } })

      WS_WAITED -> working when (and (!= (math/default @payload.code -1) 0) (not (object/get (array/nth @entity.steps @entity.cursor) tolerate)))
        (emit WS_FAIL { code: "", message: (str/concat "git " (array/nth (object/get (array/nth @entity.steps @entity.cursor) args) 0) ": " (str/default (str/trim @entity.stderrText) (str/trim @entity.stdoutText))) })
      WS_WAITED -> working when (and (or (== (math/default @payload.code -1) 0) (object/get (array/nth @entity.steps @entity.cursor) tolerate)) (< (+ @entity.cursor 1) (array/len @entity.steps)))
        (set @entity.outputs (array/append @entity.outputs @entity.stdoutText))
        (set @entity.rawOuts (array/append @entity.rawOuts @entity.stdoutBytes))
        (set @entity.codes (array/append @entity.codes (math/default @payload.code -1)))
        (set @entity.failures (array/append @entity.failures @entity.stderrText))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit WS_RUN { })
      WS_WAITED -> working when (and (or (== (math/default @payload.code -1) 0) (object/get (array/nth @entity.steps @entity.cursor) tolerate)) (>= (+ @entity.cursor 1) (array/len @entity.steps)))
        (set @entity.outputs (array/append @entity.outputs @entity.stdoutText))
        (set @entity.rawOuts (array/append @entity.rawOuts @entity.stdoutBytes))
        (set @entity.codes (array/append @entity.codes (math/default @payload.code -1)))
        (set @entity.failures (array/append @entity.failures @entity.stderrText))
        (emit WS_SCRIPT_DONE { })

      WS_STEP_ERROR -> working
        (emit WS_FAIL { code: "SERVICE_ERROR", message: @payload.error })

      WS_FAIL -> working when (== @entity.action "tree")
        (emit WORKSPACE_TREE_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "readFile")
        (emit WORKSPACE_READ_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "writeFile")
        (emit WORKSPACE_WRITE_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "removeFile")
        (emit WORKSPACE_REMOVE_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "snapshot")
        (emit WORKSPACE_SNAPSHOT_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "history")
        (emit WORKSPACE_HISTORY_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (== @entity.action "changes")
        (emit WORKSPACE_CHANGES_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })
      WS_FAIL -> working when (array/includes ["restore", "undo", "redo"] @entity.action)
        (emit WORKSPACE_STEP_FAILED { workspace: @entity.workspace, code: @payload.code, message: @payload.message })
        (emit WS_NEXT { })

      WS_SCRIPT_DONE -> working when (and (== @entity.stage "lookup") (== (array/nth @entity.codes 0) 0) (!= (str/trim (array/nth @entity.outputs 0)) ""))
        (set @entity.wsRel (str/replace (array/first (str/split (str/trim (array/nth @entity.outputs 0)) "\n")) "/.almadar/app-marker.json" ""))
        (set @entity.dir (str/concat @config.root "/" (str/replace (array/first (str/split (str/trim (array/nth @entity.outputs 0)) "\n")) "/.almadar/app-marker.json" "")))
        (emit WS_OPENED { })

      WS_OPENED -> working when (== @entity.action "snapshot")
        (set @entity.stage "snap1")
        (set @entity.steps [{ scope: "repo", args: (str/split "add -A" " "), stdin: "", feed: false, tolerate: false, raw: false }, { scope: "repo", args: ["commit", "-m", (str/concat "snapshot: " @entity.reason), "--allow-empty-message", "-m", "Almadar-Kind: snapshot"], stdin: "", feed: false, tolerate: true, raw: false }])
        (emit WS_START { })
      WS_OPENED -> working when (== @entity.action "history")
        (set @entity.stage "hist1")
        (set @entity.steps [{ scope: "repo", args: (array/concat (str/split "log" " ") ["--format=%H%x1f%at%x1f%s%x1f%(trailers:only,unfold)%x1e", "--"] @config.appPaths), stdin: "", feed: false, tolerate: true, raw: false }])
        (emit WS_START { })
      WS_OPENED -> working when (and (== @entity.action "changes") (or (== @entity.oid "") (str/startsWith @entity.oid "-")))
        (emit WORKSPACE_CHANGES_LOADED { workspace: @entity.workspace, changes: [] })
        (emit WS_NEXT { })
      WS_OPENED -> working when (and (== @entity.action "changes") (!= @entity.oid "") (not (str/startsWith @entity.oid "-")))
        (set @entity.stage "chg1")
