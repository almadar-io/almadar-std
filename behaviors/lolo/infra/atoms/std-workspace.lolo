      WS_B_DONE -> working when (== @entity.bstage "hydGet")
        (set @entity.stage "hydInit")
        (set @entity.steps [{ scope: "root", args: ["init", "-q", "-b", "main", @entity.dir], stdin: "", feed: false, tolerate: false, raw: false }, { scope: "repo", args: ["config", "user.email", "agent@almadar.io"], stdin: "", feed: false, tolerate: false, raw: false }, { scope: "repo", args: ["config", "user.name", "Almadar Agent"], stdin: "", feed: false, tolerate: false, raw: false }])
        (emit WS_START { })
      WS_SCRIPT_DONE -> working when (== @entity.stage "hydInit")
        (set @entity.wpaths (array/map @entity.paths (fn k (str/slice @k (str/len (str/concat @entity.pfx "files/"))))))
        (set @entity.wdata @entity.bresults)
        (set @entity.wcursor 0)
        (set @entity.wstage "hyd")
        (emit WS_W_NEXT { })
      WS_SYNC -> working
        (set @entity.wfor "sync")
        (emit WS_WALK_INIT { })
      WS_B_DONE -> working when (== @entity.bstage "syncPut")
        (set @entity.bstage "syncB")
        (set @entity.bsteps [{ op: "list", key: "", content: "", prefix: (str/concat @entity.pfx "files/") }])
        (emit WS_B_START { })
    }

    emits {
      WORKSPACE_TREE_LOADED -> external {
        workspace : string!
        nodes : [WorkspaceNode]!
      }
        @description "The files and directories under the requested path, with each file's size in bytes."
        @synonyms "file tree, listing, directory listing"
        @tier "primary"
      WORKSPACE_FILE_READ -> external {
        workspace : string!
        path : string!
        exists : boolean!
        content : string!
      }
        @description "One file's text; exists is false (and content empty) when the file is absent."
        @synonyms "file contents, opened file"
        @tier "primary"
      WORKSPACE_FILE_WRITTEN -> external {
        workspace : string!
        path : string!
        written : boolean!
      }
        @description "The file was written."
        @synonyms "file saved"
        @tier "primary"
      WORKSPACE_FILE_REMOVED -> external {
        workspace : string!
        path : string!
        removed : boolean!
      }
        @description "The file was removed; removed is false when it did not exist."
        @synonyms "file deleted"
        @tier "primary"
      WORKSPACE_SNAPSHOT_TAKEN -> external {
        workspace : string!
        committed : boolean!
        oid : string!
      }
        @description "The snapshot's commit id; committed is false (oid empty) when nothing had changed."
        @synonyms "committed, version saved"
        @tier "primary"
      WORKSPACE_HISTORY_LOADED -> external {
        workspace : string!
        snapshots : [WorkspaceSnapshot]!
        canUndo : boolean!
        canRedo : boolean!
      }
        @description "The program-source snapshots newest first, with whether undo and redo apply."
        @synonyms "versions, snapshot list"
        @tier "primary"
      WORKSPACE_CHANGES_LOADED -> external {
        workspace : string!
        changes : [WorkspaceChange]!
      }
        @description "The program files one snapshot changed, each with its text before and after."
        @synonyms "snapshot diff"
        @tier "primary"
      WORKSPACE_HISTORY_STEPPED -> external {
        workspace : string!
        changed : boolean!
        oid : string!
      }
        @description "A restore, undo or redo committed a new snapshot (oid); changed is false when there was nothing to do."
        @synonyms "restored, undone, redone"
        @tier "primary"
      WORKSPACE_TREE_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Listing the workspace failed."
        @synonyms "tree error, listing failed"
        @tier "primary"
      WORKSPACE_READ_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Reading the file failed."
        @synonyms "read error"
        @tier "primary"
      WORKSPACE_WRITE_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Writing the file failed."
        @synonyms "write error, save failed"
        @tier "primary"
      WORKSPACE_REMOVE_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Removing the file failed."
        @synonyms "remove error, delete failed"
        @tier "primary"
      WORKSPACE_SNAPSHOT_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Taking the snapshot failed."
        @synonyms "snapshot error, commit failed"
        @tier "primary"
      WORKSPACE_HISTORY_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Reading the history failed."
        @synonyms "history error"
        @tier "primary"
      WORKSPACE_CHANGES_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Reading the changes of a snapshot failed."
        @synonyms "changes error, diff failed"
        @tier "primary"
      WORKSPACE_STEP_FAILED -> external {
        workspace : string!
        code : string
        message : string!
      }
        @description "Restoring, undoing or redoing failed."
        @synonyms "restore failed, undo failed, redo failed"
        @tier "primary"
      WS_NEXT -> internal { }
        @tier "internal"
      WS_BEGIN -> internal { }
        @tier "internal"
      WS_START -> internal { }
        @tier "internal"
      WS_RUN -> internal { }
        @tier "internal"
      WS_EXEC -> internal { }
        @tier "internal"
      WS_SCRIPT_DONE -> internal { }
        @tier "internal"
      WS_ROOT_READY -> internal {
        key : string
      }
        @tier "internal"
      WS_SPAWNED -> internal {
        pid : number!
        stdin : number
        stdout : number!
        stderr : number!
        key : string
      }
        @tier "internal"
      WS_STDIN_DONE -> internal {
        bytes : number
        key : string
      }
        @tier "internal"
      WS_STDIN_CLOSED -> internal {
        key : string
      }
        @tier "internal"
      WS_OUT_CHUNK -> internal {
        data : bytes!
        eof : boolean!
        key : string
      }
        @tier "internal"
      WS_OUT_CLOSED -> internal {
        key : string
      }
        @tier "internal"
      WS_ERR_CHUNK -> internal {
        data : bytes!
        eof : boolean!
        key : string
      }
        @tier "internal"
      WS_ERR_CLOSED -> internal {
        key : string
      }
        @tier "internal"
      WS_WAITED -> internal {
        code : number
        signal : number
        key : string
      }
        @tier "internal"
      WS_STEP_ERROR -> internal {
        error : string!
        kind : string
      }
        @tier "internal"
      STORAGE_UPLOAD -> external {
        bucket : string
        key : string
        content : string
        contentType : string
        requestId : string
      }
        @description "Bucket mode: store one object in the workspace bucket (route it to the std-storage client)."
        @tier "secondary"
      STORAGE_DOWNLOAD -> external {
        bucket : string
        key : string!
        requestId : string
      }
        @description "Bucket mode: fetch one object from the workspace bucket."
        @tier "secondary"
      STORAGE_DELETE -> external {
        bucket : string
        key : string!
        requestId : string
      }
        @description "Bucket mode: delete one object from the workspace bucket."
        @tier "secondary"
      STORAGE_LIST -> external {
        bucket : string
        prefix : string
        maxKeys : number
        continuationToken : string
        requestId : string
      }
        @description "Bucket mode: list a page of keys under a prefix."
        @tier "secondary"
      WS_INIT -> internal { }
        @tier "internal"
      WS_FINISH -> internal { }
        @tier "internal"
      WS_SYNC -> internal { }
        @tier "internal"
      WS_SYNC_DONE -> internal { }
        @tier "internal"
      WS_ARCH -> internal { }
        @tier "internal"
      WS_B_START -> internal { }
        @tier "internal"
      WS_B_RUN -> internal { }
        @tier "internal"
      WS_B_ADVANCE -> internal { }
        @tier "internal"
      WS_B_DONE -> internal { }
        @tier "internal"
      WS_WALK_INIT -> internal { }
        @tier "internal"
      WS_WALK_START -> internal { }
        @tier "internal"
      WS_WALK_NEXT -> internal { }
        @tier "internal"
      WS_WALK_DONE -> internal { }
        @tier "internal"
      WS_R_NEXT -> internal { }
        @tier "internal"
      WS_R_DONE -> internal { }
        @tier "internal"
      WS_W_NEXT -> internal { }
        @tier "internal"
      WS_W_DONE -> internal { }
        @tier "internal"
      WS_R_GOT -> internal {
        data : bytes!
      }
        @tier "internal"
      WS_R_ERR -> internal {
        error : string!
        kind : string
      }
        @tier "internal"
      WS_W_MKDIR_OK -> internal { }
        @tier "internal"
      WS_W_WROTE -> internal {
        bytes : number
      }
        @tier "internal"
      WS_W_ERR -> internal {
        error : string!
        kind : string
      }
        @tier "internal"
      WS_RM_OK -> internal { }
        @tier "internal"
      WS_RM_ERR -> internal {
        error : string!
        kind : string
      }
        @tier "internal"
      WS_WALK_LISTED -> internal {
        entries : [WalkEntry]!
      }
        @tier "internal"
      WS_WALK_STATED -> internal {
        kind : string
        size : number!
      }
        @tier "internal"
      WS_WALK_ERR -> internal {
        error : string!
        kind : string
      }
        @tier "internal"
      WS_OPENED -> internal { }
        @tier "internal"
      WS_TARGET -> internal { }
        @tier "internal"
      WS_STAGE -> internal { }
        @tier "internal"
      WS_APPLY -> internal { }
        @tier "internal"
      WS_FAIL -> internal {
        code : string
        message : string!
      }
        @tier "internal"
    }

    listens {
      WORKSPACE_TREE {
        workspace : string!
        path : string
      }
        @description "List the files under path (the whole workspace when absent)."
        @synonyms "list files, file tree"
      WORKSPACE_READ_FILE {
        workspace : string!
        path : string!
      }
        @description "Read one file's text."
        @synonyms "open file, read file"
      WORKSPACE_WRITE_FILE {
        workspace : string!
        path : string!
        content : string!
      }
        @description "Write one file's text, creating its directories."
        @synonyms "save file, write file"
      WORKSPACE_REMOVE_FILE {
        workspace : string!
        path : string!
      }
        @description "Remove one file."
        @synonyms "delete file, remove file"
      WORKSPACE_SNAPSHOT {
        workspace : string!
        reason : string!
      }
        @description "Commit every change in the workspace as a snapshot."
        @synonyms "commit, save version, checkpoint"
      WORKSPACE_HISTORY {
        workspace : string!
        limit : number
      }
        @description "List the program-source snapshots newest first, with whether undo and redo apply."
        @synonyms "versions, snapshots, log"
      WORKSPACE_CHANGES {
        workspace : string!
        oid : string!
      }
        @description "The program files one snapshot changed, before and after."
        @synonyms "diff, snapshot changes"
      WORKSPACE_RESTORE {
        workspace : string!
        oid : string!
      }
        @description "Commit the program files as they were at a snapshot."
        @synonyms "revert to, roll back to"
      WORKSPACE_UNDO {
        workspace : string!
      }
        @description "Undo the newest change no live undo has undone."
        @synonyms "step back"
      WORKSPACE_REDO {
        workspace : string!
      }
        @description "Redo the newest live undo."
        @synonyms "step forward"
      WorkspaceStore.STORAGE_UPLOADED -> WS_B_UPLOADED
      WS_B_UPLOADED {
        key : string
        size : number
        etag : string
        url : string
      }
        @description "Bucket mode: the store accepted an object."
      WorkspaceStore.STORAGE_DOWNLOADED -> WS_B_DOWNLOADED
      WS_B_DOWNLOADED {
        content : bytes!
        size : number
      }
        @description "Bucket mode: an object's bytes as base64."
      WorkspaceStore.STORAGE_LISTED -> WS_B_LISTED
      WS_B_LISTED {
        keys : [WorkspaceKey]!
        truncated : boolean!
        nextToken : string
      }
        @description "Bucket mode: one page of keys."
      WorkspaceStore.STORAGE_DELETED -> WS_B_DELETED
      WS_B_DELETED {
        deleted : boolean
      }
        @description "Bucket mode: the object is deleted."
      WorkspaceStore.STORAGE_FAILED -> WS_B_FAILED
      WS_B_FAILED {
        code : string
        message : string!
      }
        @description "Bucket mode: the store refused or could not be reached."
    }

    config {
      root : string = "/var/lib/almadar/workspaces"
        @label "Workspaces root"
        @description "Absolute directory every workspace lives under, as <root>/<owner>/<workspace>. The app must grant fs read and create on it."
        @synonyms "workspaces directory, storage root"
        @tier "infra"
      store : "disk" | "bucket" = disk
        @label "Workspace store"
        @description "disk: workspaces live only under root. bucket: root is a local cache restored from, and mirrored to, the bucket (files under workspaces/<owner>/<workspace>/files/, git history as bundles under .../history/); the app must also route the WorkspaceStore trait."
        @synonyms "storage mode, object store, cloud storage"
        @tier "infra"
      bucket : string = ""
        @label "Bucket"
        @description "The bucket name, in bucket mode."
        @synonyms "bucket name, firebase storage bucket"
        @tier "infra"
      gitPath : string = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
        @label "Executable search path"
        @description "The PATH git is looked up on; the call runs with no other inherited environment."
        @synonyms "path, git location"
        @tier "infra"
      scope : "own" | "listed" = own
        @label "Who may open what"
        @description "own: a viewer opens any workspace id, always inside the viewer's own owner directory. listed: the viewer and workspace must also appear in access."
        @synonyms "access mode, workspace access"
        @tier "infra"
      access : [WorkspaceAccess] = []
        @label "Allowed workspaces"
        @description "Per viewer id, the workspace ids that viewer may open when scope is listed."
        @synonyms "allow list, permitted workspaces"
        @tier "infra"
      gitignore : string = "# Almadar — version only the app; ignore generated/churny state\n# `.almadar/` is an allowlist: its app state is history, anything else there is scratch.\n/.almadar/*\n!/.almadar/app-marker.json\n!/.almadar/ledger.json\n!/.almadar/project.orb\n!/.almadar/user.orb\n!/.almadar/fill-candidates/\n# A session is churn except each orbital's spec.json: its .orb is derived from it.\n!/.almadar/sessions/\n/.almadar/sessions/*\n!/.almadar/sessions/*/\n/.almadar/sessions/*/**\n!/.almadar/sessions/*/spec.json\n/apps/\n/.almadar-archive.bundle\n"
        @label "Ignore rules"
        @description "The .gitignore written into a new workspace: only the app's program sources enter history."
        @synonyms "gitignore, ignored files"
        @tier "infra"
      appPaths : [string] = ["schema.orb", ":(glob)orbitals/*", ":(glob)**/*.lolo", ":(glob).almadar/sessions/*/spec.json", ":(exclude,glob).almadar/**/*.lolo", ":(exclude)apps", ":(exclude)node_modules"]
        @label "History pathspecs"
        @description "The git pathspecs naming the program sources whose changes history, changes, restore, undo and redo cover."
        @synonyms "source paths, tracked sources"
        @tier "infra"
    }
  }

  trait WorkspaceStore = Storage.traits.StorageClient -> WorkspaceJob {
    listens {
      WorkspaceClient.STORAGE_UPLOAD -> STORAGE_UPLOAD
      STORAGE_UPLOAD {
        bucket : string
        key : string
        content : string
        contentType : string
        requestId : string
      }
      WorkspaceClient.STORAGE_DOWNLOAD -> STORAGE_DOWNLOAD
      STORAGE_DOWNLOAD {
        bucket : string
        key : string!
        requestId : string
      }
      WorkspaceClient.STORAGE_DELETE -> STORAGE_DELETE
      STORAGE_DELETE {
        bucket : string
        key : string!
        requestId : string
      }
      WorkspaceClient.STORAGE_LIST -> STORAGE_LIST
      STORAGE_LIST {
        bucket : string
        prefix : string
        maxKeys : number
        continuationToken : string
        requestId : string
      }
    }
  }

  page "/workspace" as WorkspacePage -> WorkspaceClient, WorkspaceStore
}
