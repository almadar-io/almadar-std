app std-email [
  version: "1.0.0",
  description: "std-email — transactional email through SendGrid or Resend over the composed std-http-client. EMAIL_SEND sends one message through the vendor the `vendor` knob names and answers EMAIL_SENT { id?, status } or EMAIL_SEND_FAILED { code?, message }. Credentials are the SENDGRID_API_KEY / RESEND_API_KEY names, resolved by the host.",
]
uses Http from "std/behaviors/std-http-client"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
type ResendReply = { id : string, message : string }
orbital EmailOrbital {
  entity EmailDelivery [runtime] {
    id : string!
  }

  trait EmailSender -> EmailDelivery [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      EMAIL_SEND -> idle when (= @config.vendor sendgrid)
        (let ((from (if (validate/required @payload.from) @payload.from @config.fromEmail)))
          (emit EMAIL_HTTP_SEND {
            key: "sendgrid",
            host: "api.sendgrid.com",
            method: "POST",
            target: "/v3/mail/send",
            headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
            body: (bytes/from-string (json/stringify (object/merge
              {
                from: (if (str/includes @from "<")
                  (object/merge
                    { email: (str/trim (str/replace (default (array/nth (str/split @from "<") 1) "") ">" "")) }
                    (if (!= (str/trim (default (array/nth (str/split @from "<") 0) "")) "") { name: (str/trim (default (array/nth (str/split @from "<") 0) "")) } {}))
                  { email: @from }),
                subject: @payload.subject,
                personalizations: [{ to: [(if (str/includes @payload.to "<")
                  (object/merge
                    { email: (str/trim (str/replace (default (array/nth (str/split @payload.to "<") 1) "") ">" "")) }
                    (if (!= (str/trim (default (array/nth (str/split @payload.to "<") 0) "")) "") { name: (str/trim (default (array/nth (str/split @payload.to "<") 0) "")) } {}))
                  { email: @payload.to })] }],
                content: (if (validate/required @payload.htmlBody)
                  [{ value: @payload.body, type: "text/plain" }, { value: @payload.htmlBody, type: "text/html" }]
                  [{ value: @payload.body, type: "text/html" }])
              }
              (if (validate/required @payload.replyTo)
                { reply_to: (if (str/includes @payload.replyTo "<")
                  (object/merge
                    { email: (str/trim (str/replace (default (array/nth (str/split @payload.replyTo "<") 1) "") ">" "")) }
                    (if (!= (str/trim (default (array/nth (str/split @payload.replyTo "<") 0) "")) "") { name: (str/trim (default (array/nth (str/split @payload.replyTo "<") 0) "")) } {}))
                  { email: @payload.replyTo }) }
                {})
              (if (validate/required @payload.templateId) { template_id: @payload.templateId } {})))),
            stream: "none"
          }))
      EMAIL_SEND -> idle when (and (= @config.vendor resend) (validate/required @payload.templateId))
        (emit EMAIL_SEND_FAILED { message: "templateId is not supported by the resend provider — use sendgrid or drop templateId" })
      EMAIL_SEND -> idle when (and (= @config.vendor resend) (not (validate/required @payload.templateId)))
        (emit EMAIL_HTTP_SEND {
          key: "resend",
          host: "api.resend.com",
          method: "POST",
          target: "/emails",
          headers: [{ name: "accept", value: "*/*" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string (json/stringify (object/merge
            {
              from: (if (validate/required @payload.from) @payload.from @config.fromEmail),
              html: (if (validate/required @payload.htmlBody) @payload.htmlBody @payload.body)
            }
            (if (validate/required @payload.replyTo) { reply_to: @payload.replyTo } {})
            { subject: @payload.subject }
            (if (validate/required @payload.htmlBody) { text: @payload.body } {})
            { to: @payload.to }))),
          stream: "none"
        })

      EMAIL_SENDGRID_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (object/get (default @payload.headers {}) "x-message-id" "") ""))
        (emit EMAIL_SENT { id: (object/get (default @payload.headers {}) "x-message-id" ""), status: "sent" })
      EMAIL_SENDGRID_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= (object/get (default @payload.headers {}) "x-message-id" "") ""))
        (emit EMAIL_SENT { status: "sent" })
      EMAIL_SENDGRID_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit EMAIL_SEND_FAILED { message: (object/get @config.statusText (str/concat @payload.status) "") })
      EMAIL_SENDGRID_FAILED -> idle
        (emit EMAIL_SEND_FAILED { message: @payload.error })

      EMAIL_RESEND_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ResendReply) null) (!= (object/get (json/parse @payload.body ResendReply) id "") ""))
        (emit EMAIL_SENT { id: (object/get (json/parse @payload.body ResendReply) id ""), status: "sent" })
      EMAIL_RESEND_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ResendReply) null) (= (object/get (json/parse @payload.body ResendReply) id "") ""))
        (emit EMAIL_SENT { status: "sent" })
      EMAIL_RESEND_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= (json/parse @payload.body ResendReply) null) (= (str/trim @payload.body) "null"))
        (emit EMAIL_SEND_FAILED { message: "Resend rejected the email: no message id returned" })
      EMAIL_RESEND_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= (json/parse @payload.body ResendReply) null) (!= (str/trim @payload.body) "null"))
        (emit EMAIL_SEND_FAILED { message: "Resend rejected the email: Unable to fetch data. The request could not be resolved." })
      EMAIL_RESEND_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (!= (json/parse @payload.body ResendReply) null))
        (emit EMAIL_SEND_FAILED { message: (str/concat "Resend rejected the email: " (if (validate/required (object/get (json/parse @payload.body ResendReply) message "")) (object/get (json/parse @payload.body ResendReply) message "") "no message id returned")) })
      EMAIL_RESEND_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= (json/parse @payload.body ResendReply) null) (= (str/trim @payload.body) "null"))
        (emit EMAIL_SEND_FAILED { message: "Resend rejected the email: no message id returned" })
      EMAIL_RESEND_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= (json/parse @payload.body ResendReply) null) (!= (str/trim @payload.body) "null"))
        (emit EMAIL_SEND_FAILED { message: "Resend rejected the email: Internal server error. We are unable to process your request right now, please try again later." })
      EMAIL_RESEND_FAILED -> idle
        (emit EMAIL_SEND_FAILED { message: "Resend rejected the email: Unable to fetch data. The request could not be resolved." })
    }

    emits {
      EMAIL_SENT -> external {
        id : string
        status : string!
      }
        @description "The message was accepted by the vendor; id is the vendor message id when it returned one."
        @synonyms "email sent, message accepted, delivery queued"
        @tier "primary"
      EMAIL_SEND_FAILED -> external {
        code : string
        message : string!
      }
        @description "The message was not sent: the vendor rejected it, answered with a non-2xx status, or the call never completed."
        @synonyms "email failed, send error, delivery rejected"
        @tier "primary"
      EMAIL_HTTP_SEND {
        key : string!
        host : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: a vendor request, for the HTTP client of its host."
        @tier "secondary"
    }

    listens {
      EMAIL_SEND -> input {
        to : string!
        subject : string!
        body : string!
        from : string?
        htmlBody : string?
        replyTo : string?
        templateId : string?
      }
        @description "Send one transactional email. to/from/replyTo accept `Name <address>`; htmlBody adds an HTML part beside the plain body; templateId is SendGrid only; from defaults to the fromEmail knob."
        @synonyms "send email, mail, notify by email, transactional email"
      EMAIL_SENDGRID_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      EMAIL_SENDGRID_FAILED {
        error : string!
        kind : string!
      }
      EMAIL_RESEND_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      EMAIL_RESEND_FAILED {
        error : string!
        kind : string!
      }
      EmailSendgridHttp.HTTP_REPLIED -> EMAIL_SENDGRID_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") }
      EmailSendgridHttp.HTTP_FAILED -> EMAIL_SENDGRID_FAILED with { error: ?error, kind: ?kind }
      EmailResendHttp.HTTP_REPLIED -> EMAIL_RESEND_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") }
      EmailResendHttp.HTTP_FAILED -> EMAIL_RESEND_FAILED with { error: ?error, kind: ?kind }
      EmailTimeout.TIMED_OUT -> EMAIL_SENDGRID_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "sendgrid")
      EmailTimeout.TIMED_OUT -> EMAIL_RESEND_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "resend")
    }

    config {
      vendor : "sendgrid" | "resend" = sendgrid
        @label "Email vendor"
        @description "The vendor that delivers the mail."
        @synonyms "email provider, mail service, sendgrid or resend"
        @tier "infra"
      fromEmail : string = "noreply@example.com"
        @label "Default sender"
        @description "The From address used when a message names none."
        @synonyms "from address, sender, noreply"
        @tier "infra"
      statusText : Map string string = { "200": "OK", "201": "Created", "202": "Accepted", "204": "No Content", "301": "Moved Permanently", "302": "Found", "304": "Not Modified", "400": "Bad Request", "401": "Unauthorized", "402": "Payment Required", "403": "Forbidden", "404": "Not Found", "405": "Method Not Allowed", "408": "Request Timeout", "409": "Conflict", "413": "Payload Too Large", "422": "Unprocessable Entity", "429": "Too Many Requests", "500": "Internal Server Error", "501": "Not Implemented", "502": "Bad Gateway", "503": "Service Unavailable", "504": "Gateway Timeout" }
        @label "Status reasons"
        @description "The reason phrase reported for a non-2xx SendGrid status, keyed by status code."
        @synonyms "http reasons, status messages"
        @tier "infra"
    }
  }

  trait EmailSendgridHttp = Http.traits.HttpClient {
    config {
      host: "api.sendgrid.com"
      port: 443
      tls: true
      serverName: "api.sendgrid.com"
      credential: "SENDGRID_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      EmailSender.EMAIL_HTTP_SEND -> HTTP_SEND with { key: ?key, method: ?method, target: ?target, headers: ?headers, body: ?body, stream: ?stream, host: ?host } when (= ?host "api.sendgrid.com")
      EmailTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key } when (= ?key "sendgrid")
    }
  }

  trait EmailResendHttp = Http.traits.HttpClient {
    config {
      host: "api.resend.com"
      port: 443
      tls: true
      serverName: "api.resend.com"
      credential: "RESEND_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      EmailSender.EMAIL_HTTP_SEND -> HTTP_SEND with { key: ?key, method: ?method, target: ?target, headers: ?headers, body: ?body, stream: ?stream, host: ?host } when (= ?host "api.resend.com")
      EmailTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key } when (= ?key "resend")
    }
  }

  trait EmailTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      EmailSender.EMAIL_HTTP_SEND -> START with { key: (as ?key CallKey) }
      EmailSendgridHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      EmailSendgridHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
      EmailResendHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      EmailResendHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  page boot as EmailPage -> EmailSender, EmailSendgridHttp, EmailResendHttp, EmailTimeout
}
