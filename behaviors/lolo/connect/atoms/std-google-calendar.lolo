        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECTED -> idle when (and (= @payload.connected false) (= @entity.id "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: "Google Calendar did not connect the service account" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECTED -> idle when (and (= @payload.connected false) (= @entity.id "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { message: "Google Calendar did not connect the service account" })
        (emit CALENDAR_CLEAR {})
