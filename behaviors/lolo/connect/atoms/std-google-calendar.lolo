        (credential-connect { credential: @config.tokenCache, scope: app, tokenEndpoint: @config.tokenUrl, grant: "jwt-bearer", signingKey: @config.serviceAccount, issuer: @config.serviceAccountEmail, audience: @config.tokenUrl, ttlSeconds: 3600, scopes: (str/split @config.scope " ") } { emit: { success: CALENDAR_CONNECTED, failure: CALENDAR_CONNECT_FAILED } })
      CALENDAR_REQUEST_FAILED -> idle when (and (= @payload.kind "unconfigured") (= @entity.mintTried true) (= @payload.key "list"))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_LIST_EVENTS_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
