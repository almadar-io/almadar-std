app std-google-calendar [
  version: "1.0.0",
  description: "std-google-calendar — Google Calendar through the REST API (www.googleapis.com/calendar/v3): list, create, update and delete events, free-busy queries and push-channel watch. Each action is one input event with a typed payload and one result event carrying the provider's result record; an API or transport failure answers on that action's failure event with the error message; an unconfigured service account answers code NOT_CONFIGURED; a 2xx reply whose JSON body cannot be read answers code MALFORMED_REPLY. Push notifications arrive at the inbound hook google-calendar: the CalendarPushInbound trait checks the watch-channel token, acknowledges the sync handshake and emits CAL_REMOTE_CHANGED.",
  egress: ["https://www.googleapis.com"],
  inbound: ["google-calendar"]
]
type CalendarRawTime = { dateTime : string, date : string }
type CalendarRawEvent = { id : string, summary : string, description : string, location : string, start : CalendarRawTime, end : CalendarRawTime, status : string, updated : string }
type CalendarEventsReply = { items : [CalendarRawEvent], nextSyncToken : string }
type CalendarEventRecord = { id : string, summary : string, description : string, location : string, start : string, end : string, status : string, updated : string }
type CalendarCreatedReply = { id : string, status : string, htmlLink : string }
type CalendarPatchedReply = { id : string, status : string }
type CalendarBusySlot = { start : string, end : string }
type CalendarFreeBusyCalendar = { busy : [CalendarBusySlot] }
type CalendarFreeBusyReply = { calendars : Map string CalendarFreeBusyCalendar }
type CalendarWatchReply = { id : string, resourceId : string, expiration : string }
type CalendarApiErrorItem = { message : string, domain : string }
type CalendarApiError = { code : number, message : string, errors : [CalendarApiErrorItem] }
type CalendarErrorReply = { error : CalendarApiError }
type CalendarErrorStringReply = { error : string }
type CalendarGrantError = { error : string, error_description : string }
orbital CalendarOrbital {
  entity CalendarRequest [runtime] {
    id : string!
  }

  trait CalendarClient -> CalendarRequest [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      CALENDAR_LIST_EVENTS -> idle
        (http GET @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events") {
          headers: { Accept: "*/*" },
          query: { syncToken: (if (!= (default @payload.syncToken "") "") (default @payload.syncToken "") null), timeMin: (if (and (not (!= (default @payload.syncToken "") "")) (!= (default @payload.timeMin "") "")) (default @payload.timeMin "") null), timeMax: (if (and (not (!= (default @payload.syncToken "") "")) (!= (default @payload.timeMax "") "")) (default @payload.timeMax "") null), singleEvents: (if (!= (default @payload.syncToken "") "") null "true"), orderBy: (if (!= (default @payload.syncToken "") "") null "startTime"), maxResults: (default @payload.maxResults 250) },
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] },
          timeoutMs: @config.timeoutMs
        } { key: "list", emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_CREATE_EVENT -> idle when (or (validate/required @payload.end) (= (str/len @payload.start) 10) (> (default @payload.durationMinutes 0) 0))
        (let ((st (if (validate/required @payload.end) null (time/parse @payload.start))))
         (let ((endValue (if (validate/required @payload.end) @payload.end (if (== @st null) null (if (= (str/len @payload.start) 10) (time/format (time/add @st 1 day) "YYYY-MM-DD") (time/add @st (default @payload.durationMinutes 0) "minute"))))))
          (if (== @endValue null)
            (emit CALENDAR_CREATE_EVENT_FAILED { message: "createEvent could not read `start` as a date or date-time to compute `end`" })
          (http POST @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events") {
            headers: { Accept: "*/*", Content-Type: "application/json" },
            text: (str/concat "{" (str/join (array/filter [(str/concat "\"summary\":" (json/stringify @payload.summary)) (if (validate/required @payload.description) (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (validate/required @payload.location) (str/concat "\"location\":" (json/stringify @payload.location)) "") (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) (str/concat "\"end\":" (if (= (str/len @endValue) 10) (str/concat "{\"date\":" (json/stringify @endValue) "}") (str/concat "{\"dateTime\":" (json/stringify @endValue) "}")))] (fn p (!= @p ""))) ",") "}"),
            auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
            timeoutMs: @config.timeoutMs
          } { key: "create", emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } }))))
      CALENDAR_CREATE_EVENT -> idle when (and (not (validate/required @payload.end)) (!= (str/len @payload.start) 10) (<= (default @payload.durationMinutes 0) 0))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: "createEvent requires `end` or a positive `durationMinutes`" })
      CALENDAR_UPDATE_EVENT -> idle
        (http PATCH @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/" (str/encode-uri-component @payload.eventId)) {
          headers: { Accept: "*/*", Content-Type: "application/json" },
          text: (str/concat "{" (str/join (array/filter [(if (object/has @payload summary) (str/concat "\"summary\":" (json/stringify @payload.summary)) "") (if (object/has @payload description) (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (object/has @payload location) (str/concat "\"location\":" (json/stringify @payload.location)) "") (if (validate/required @payload.start) (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) "") (if (validate/required @payload.end) (str/concat "\"end\":" (if (= (str/len @payload.end) 10) (str/concat "{\"date\":" (json/stringify @payload.end) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.end) "}"))) "")] (fn p (!= @p ""))) ",") "}"),
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          timeoutMs: @config.timeoutMs
        } { key: "update", emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_DELETE_EVENT -> idle
        (http DELETE @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/" (str/encode-uri-component @payload.eventId)) {
          headers: { Accept: "*/*" },
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] },
          timeoutMs: @config.timeoutMs
        } { key: (str/concat "delete:" @payload.eventId), emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_FREE_BUSY -> idle
        (http POST @config.origin "/calendar/v3/freeBusy" {
          headers: { Accept: "*/*" },
          json: { timeMin: @payload.timeMin, timeMax: @payload.timeMax, items: [{ id: (default @payload.calendarId @config.calendarId) }] },
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          timeoutMs: @config.timeoutMs
        } { key: (str/concat "freeBusy:" (default @payload.calendarId @config.calendarId)), emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_WATCH -> idle
        (http POST @config.origin (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/watch") {
          headers: { Accept: "*/*", Content-Type: "application/json" },
          text: (str/concat "{" (str/join (array/filter [(str/concat "\"id\":" (json/stringify @payload.channelId)) (str/concat "\"type\":" "\"web_hook\"") (str/concat "\"address\":" (json/stringify @payload.address)) (if (!= (default @payload.ttlSeconds 0) 0) (str/concat "\"params\":{\"ttl\":" (json/stringify (str/concat @payload.ttlSeconds)) "}") "")] (fn p (!= @p ""))) ",") "}"),
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          timeoutMs: @config.timeoutMs
        } { key: (str/concat "watch:" @payload.channelId), emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_STOP_WATCH -> idle
        (http POST @config.origin "/calendar/v3/channels/stop" {
          headers: { Accept: "*/*" },
          json: { id: @payload.channelId, resourceId: @payload.resourceId },
          auth: { scheme: jwt-bearer, key: @config.serviceAccount, alg: RS256, claims: (object/merge { scope: @config.scope, aud: @config.tokenUrl, exp: (+ (time/diff @now @config.epoch "s") 3600), iat: (time/diff @now @config.epoch "s") } (if (!= @config.subject "") { sub: @config.subject } {})), tokenUrl: @config.tokenUrl, expiresMarginMs: 300000, storeAs: { name: @config.tokenCache }, grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "timeout", "failed"], noResponseMax: 2, scheduleMs: [100, 500, 1500] } } },
          timeoutMs: @config.timeoutMs
        } { key: "stopWatch", emit: { success: CALENDAR_REPLIED, failure: CALENDAR_REQUEST_FAILED } })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "list"))
        (let ((r (json/parse @payload.body CalendarEventsReply))) (if (= @r null) (emit CALENDAR_LIST_EVENTS_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a calendar event list" }) (emit CALENDAR_EVENTS_LISTED { events: (array/map (object/get @r items []) (fn i { id: (default (object/get @i id "") ""), summary: (default (object/get @i summary "") ""), description: (default (object/get @i description "") ""), location: (default (object/get @i location "") ""), start: (let ((dt (object/get @i "start.dateTime" ""))) (if (!= @dt "") @dt (object/get @i "start.date" ""))), end: (let ((dt (object/get @i "end.dateTime" ""))) (if (!= @dt "") @dt (object/get @i "end.date" ""))), status: (default (object/get @i status "") ""), updated: (default (object/get @i updated "") "") })), nextSyncToken: (object/get @r nextSyncToken null) })))
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "create"))
        (let ((r (json/parse @payload.body CalendarCreatedReply))) (if (= @r null) (emit CALENDAR_CREATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a created event" }) (emit CALENDAR_EVENT_CREATED { id: (object/get @r id ""), status: (object/get @r status ""), htmlLink: (object/get @r htmlLink "") })))
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "update"))
        (let ((r (json/parse @payload.body CalendarPatchedReply))) (if (= @r null) (emit CALENDAR_UPDATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a patched event" }) (emit CALENDAR_EVENT_UPDATED { id: (object/get @r id ""), status: (object/get @r status "") })))
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (str/startsWith @payload.key "delete:"))
        (emit CALENDAR_EVENT_DELETED { id: (str/slice @payload.key 7), deleted: true })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (str/startsWith @payload.key "freeBusy:"))
        (let ((r (json/parse @payload.body CalendarFreeBusyReply))) (if (= @r null) (emit CALENDAR_FREE_BUSY_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a free-busy result" }) (emit CALENDAR_FREE_BUSY_RESULT { busy: (array/map (object/get (object/get (object/get @r calendars {}) (str/slice @payload.key 9) {}) busy []) (fn s { start: (default (object/get @s start "") ""), end: (default (object/get @s end "") "") })) })))
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (str/startsWith @payload.key "watch:"))
        (let ((r (json/parse @payload.body CalendarWatchReply))) (if (= @r null) (emit CALENDAR_WATCH_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a watch channel" }) (emit CALENDAR_WATCHED { channelId: (let ((rid (object/get @r id ""))) (if (!= @rid "") @rid (str/slice @payload.key 6))), resourceId: (object/get @r resourceId ""), expiration: (object/get @r expiration "") })))
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.key "stopWatch"))
        (emit CALENDAR_WATCH_STOPPED { stopped: true })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "list"))
        (emit CALENDAR_LIST_EVENTS_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (str/startsWith @payload.key "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (str/startsWith @payload.key "watch:"))
        (emit CALENDAR_WATCH_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "list"))
        (emit CALENDAR_LIST_EVENTS_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (str/startsWith @payload.key "delete:"))
        (emit CALENDAR_DELETE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (str/startsWith @payload.key "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (str/startsWith @payload.key "watch:"))
        (emit CALENDAR_WATCH_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "stopWatch"))
