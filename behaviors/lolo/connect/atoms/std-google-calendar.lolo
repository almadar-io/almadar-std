app std-google-calendar [
  version: "1.2.0",
  description: "std-google-calendar — Google Calendar through the REST API (www.googleapis.com/calendar/v3): list, create, update and delete events, free-busy queries and push-channel watch. Each action is one input event with a typed payload and one result event carrying the provider's result record; an API or transport failure answers on that action's failure event with the error message; an unconfigured service account answers code NOT_CONFIGURED; a 2xx reply whose JSON body cannot be read answers code MALFORMED_REPLY. Push notifications arrive at the inbound hook google-calendar: the CalendarPushInbound trait checks the watch-channel token, acknowledges the sync handshake and emits CAL_REMOTE_CHANGED.",
  egress: ["https://www.googleapis.com"],
  net: { "www.googleapis.com:443": [tcp] },
  inbound: ["google-calendar"]
]
uses Keyed from "std/behaviors/std-http-keyed"
uses Timeout from "std/behaviors/std-timeout"
uses Retry from "std/behaviors/std-retry"
type HttpHeader = { name : string!, value : string! }
type CalendarDay = date
type CalendarInstant = instant
type CalendarRawTime = { dateTime : string, date : string }
type CalendarRawEvent = { id : string, summary : string, description : string, location : string, start : CalendarRawTime, end : CalendarRawTime, status : string, updated : string }
type CalendarEventsReply = { items : [CalendarRawEvent], nextSyncToken : string }
type CalendarEventRecord = { id : string, summary : string, description : string, location : string, start : string, end : string, status : string, updated : string }
type CalendarCreatedReply = { id : string, status : string, htmlLink : string }
type CalendarPatchedReply = { id : string, status : string }
type CalendarBusySlot = { start : string, end : string }
type CalendarFreeBusyCalendar = { busy : [CalendarBusySlot] }
type CalendarFreeBusyReply = { calendars : Map string CalendarFreeBusyCalendar }
type CalendarWatchReply = { id : string, resourceId : string, expiration : string }
type CalendarApiErrorItem = { message : string, domain : string }
type CalendarApiError = { code : number, message : string, errors : [CalendarApiErrorItem] }
type CalendarErrorReply = { error : CalendarApiError }
type CalendarErrorStringReply = { error : string }
orbital CalendarOrbital {
  entity CalendarRequest [runtime] {
    id : string!
    method : string = ""
    target : string = ""
    body : string @description "The JSON body of the request in flight; empty for none." = ""
    mintTried : boolean @description "True once this request minted the access token after the store reported none held, so a second not-held answer fails instead of looping." = false
    attempt : number @description "The std-retry attempt in flight for a list or delete; 0 for the calls that are not retried." = 0
  }

  trait CalendarKeyed = Keyed.traits.HttpKeyed {
    listens {
      CalendarCall.CALENDAR_HTTP_SEND -> HTTP_SEND
      CalendarTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
      CalendarKeyed.DELIVERY_REJECTED -> KEY_REFUSED
    }
  }

  trait CalendarHttp = Keyed.traits.KeyedHttp {
    config {
      host: "www.googleapis.com"
      port: 443
      tls: true
      serverName: "www.googleapis.com"
      credential: "GOOGLE_CALENDAR_ACCESS_TOKEN"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      CalendarKeyed.KEYED_SEND -> HTTP_SEND per @payload.key
      CalendarKeyed.KEYED_CANCEL -> HTTP_CANCEL per @payload.key
    }
  }

  trait CalendarTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      CalendarCall.CALENDAR_HTTP_SEND -> START per @payload.key with { key: (as ?key CallKey) }
      CalendarHttp.HTTP_REPLIED -> SUCCEEDED per @payload.key with { key: (as ?key CallKey) }
      CalendarHttp.HTTP_FAILED -> FAILED per @payload.key with { key: (as ?key CallKey), error: ?error }
    }
  }

  ;; list and delete retry on 1xx, 408, 429, 5xx (three retries: 100, 500 then 1500 ms) and on a timeout or transport failure (two retries, the client stops them); 100 x 5^(n-1) capped at 1500 reproduces the schedule
  trait CalendarRetry = Retry.traits.Retry {
    config {
      maxAttempts: 4
      baseDelayMs: 100
      multiplier: 5
      maxDelayMs: 1500
    }
    listens {
      CalendarCall.CALENDAR_RETRY_START -> START per @payload.key
      CalendarCall.CALENDAR_RETRY_FAILED -> FAILED per @payload.key
      CalendarCall.CALENDAR_RETRY_CANCEL -> CANCEL per @payload.key
      CalendarHttp.HTTP_REPLIED -> SUCCEEDED per @payload.key with { key: (as ?key CallKey) } when (and (or (= ?key "list") (str/startsWith ?key "delete:")) (not (or (and (>= ?status 100) (< ?status 200)) (= ?status 408) (= ?status 429) (and (>= ?status 500) (< ?status 600)))))
    }
  }

  trait CalendarClient -> CalendarRequest [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      CALENDAR_LIST_EVENTS -> idle
        (emit CALENDAR_READY { key: "list", method: "GET", target: (let ((sync (default @payload.syncToken ""))) (let ((q (str/join (array/filter [(if (!= @sync "") (str/concat "syncToken=" (str/encode-uri-component @sync)) "") (if (and (= @sync "") (!= (default @payload.timeMin "") "")) (str/concat "timeMin=" (str/encode-uri-component (default @payload.timeMin ""))) "") (if (and (= @sync "") (!= (default @payload.timeMax "") "")) (str/concat "timeMax=" (str/encode-uri-component (default @payload.timeMax ""))) "") (if (= @sync "") "singleEvents=true" "") (if (= @sync "") "orderBy=startTime" "") (str/concat "maxResults=" (default @payload.maxResults 250))] (fn p (!= @p ""))) "&"))) (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events?" @q))), body: "", retry: true })
      CALENDAR_CREATE_EVENT -> idle when (or (validate/required @payload.end) (= (str/len @payload.start) 10) (> (default @payload.durationMinutes 0) 0))
        (let ((allDay (as @payload.start CalendarDay)) (st (as @payload.start CalendarInstant)))
         (let ((endValue (if (validate/required @payload.end) @payload.end (if (= (str/len @payload.start) 10) (if (== @allDay null) null (time/format (time/add @allDay 1 day) "YYYY-MM-DD")) (if (== @st null) null (str/concat (time/format (time/add @st (default @payload.durationMinutes 0) "minute") "YYYY-MM-DDTHH:mm:ss") "Z"))))))
          (if (== @endValue null)
            (emit CALENDAR_CREATE_EVENT_FAILED { message: "createEvent could not read `start` as a date or date-time to compute `end`" })
            (emit CALENDAR_READY { key: "create", method: "POST", target: (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events"), body: (str/concat "{" (str/join (array/filter [(str/concat "\"summary\":" (json/stringify @payload.summary)) (if (validate/required @payload.description) (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (validate/required @payload.location) (str/concat "\"location\":" (json/stringify @payload.location)) "") (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) (str/concat "\"end\":" (if (= (str/len @endValue) 10) (str/concat "{\"date\":" (json/stringify @endValue) "}") (str/concat "{\"dateTime\":" (json/stringify @endValue) "}")))] (fn p (!= @p ""))) ",") "}"), retry: false }))))
      CALENDAR_CREATE_EVENT -> idle when (and (not (validate/required @payload.end)) (!= (str/len @payload.start) 10) (<= (default @payload.durationMinutes 0) 0))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: "createEvent requires `end` or a positive `durationMinutes`" })
      CALENDAR_UPDATE_EVENT -> idle
        (emit CALENDAR_READY { key: "update", method: "PATCH", target: (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/" (str/encode-uri-component @payload.eventId)), body: (str/concat "{" (str/join (array/filter [(if (object/has @payload summary) (str/concat "\"summary\":" (json/stringify @payload.summary)) "") (if (object/has @payload description) (str/concat "\"description\":" (json/stringify @payload.description)) "") (if (object/has @payload location) (str/concat "\"location\":" (json/stringify @payload.location)) "") (if (validate/required @payload.start) (str/concat "\"start\":" (if (= (str/len @payload.start) 10) (str/concat "{\"date\":" (json/stringify @payload.start) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.start) "}"))) "") (if (validate/required @payload.end) (str/concat "\"end\":" (if (= (str/len @payload.end) 10) (str/concat "{\"date\":" (json/stringify @payload.end) "}") (str/concat "{\"dateTime\":" (json/stringify @payload.end) "}"))) "")] (fn p (!= @p ""))) ",") "}"), retry: false })
      CALENDAR_DELETE_EVENT -> idle
        (emit CALENDAR_READY { key: (str/concat "delete:" @payload.eventId), method: "DELETE", target: (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/" (str/encode-uri-component @payload.eventId)), body: "", retry: true })
      CALENDAR_FREE_BUSY -> idle
        (emit CALENDAR_READY { key: (str/concat "freeBusy:" (default @payload.calendarId @config.calendarId)), method: "POST", target: "/calendar/v3/freeBusy", body: (json/stringify { timeMin: @payload.timeMin, timeMax: @payload.timeMax, items: [{ id: (default @payload.calendarId @config.calendarId) }] }), retry: false })
      CALENDAR_WATCH -> idle
        (emit CALENDAR_READY { key: (str/concat "watch:" @payload.channelId), method: "POST", target: (str/concat "/calendar/v3/calendars/" (str/encode-uri-component (default @payload.calendarId @config.calendarId)) "/events/watch"), body: (str/concat "{" (str/join (array/filter [(str/concat "\"id\":" (json/stringify @payload.channelId)) (str/concat "\"type\":" "\"web_hook\"") (str/concat "\"address\":" (json/stringify @payload.address)) (if (!= (default @payload.ttlSeconds 0) 0) (str/concat "\"params\":{\"ttl\":" (json/stringify (str/concat (default @payload.ttlSeconds 0))) "}") "")] (fn p (!= @p ""))) ",") "}"), retry: false })
      CALENDAR_STOP_WATCH -> idle
        (emit CALENDAR_READY { key: "stopWatch", method: "POST", target: "/calendar/v3/channels/stop", body: (json/stringify { id: @payload.channelId, resourceId: @payload.resourceId }), retry: false })
    }

    emits {
      CALENDAR_CREATE_EVENT_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of creating an event: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_READY {
        key : string!
        method : string!
        target : string!
        body : string!
        retry : boolean!
      }
        @description "Internal: a built request, handed to the row of its key in CalendarCall."
        @tier "secondary"
    }

    listens {
      CALENDAR_LIST_EVENTS -> input {
        calendarId : string
        timeMin : string
        timeMax : string
        syncToken : string
        maxResults : number
      }
        @description "List events on a Google Calendar; pass syncToken for incremental sync instead of a time window (the API rejects combining them). calendarId defaults to the calendarId knob; maxResults defaults to 250."
        @synonyms "list events, calendar events, sync events"
      CALENDAR_CREATE_EVENT -> input {
        calendarId : string
        summary : string!
        description : string
        location : string
        start : string!
        end : string
        durationMinutes : number
      }
        @description "Create a calendar event; an all-day event uses a 10-character (YYYY-MM-DD) start with no end, defaulting to the next day. A timed event needs an explicit end."
        @synonyms "create event, add calendar event, schedule meeting"
      CALENDAR_UPDATE_EVENT -> input {
        calendarId : string
        eventId : string!
        summary : string
        description : string
        location : string
        start : string
        end : string
      }
        @description "Patch an existing event's fields; only fields present in the payload are changed."
        @synonyms "update event, edit calendar event, reschedule"
      CALENDAR_DELETE_EVENT -> input {
        calendarId : string
        eventId : string!
      }
        @description "Delete a calendar event."
        @synonyms "delete event, remove calendar event, cancel event"
      CALENDAR_FREE_BUSY -> input {
        calendarId : string
        timeMin : string!
        timeMax : string!
      }
        @description "Query busy time blocks on a calendar within a window."
        @synonyms "free busy, availability, busy slots"
      CALENDAR_WATCH -> input {
        calendarId : string
        channelId : string!
        address : string!
        ttlSeconds : number
      }
        @description "Register a push-notification channel for calendar change events."
        @synonyms "watch calendar, push notifications, subscribe changes"
      CALENDAR_STOP_WATCH -> input {
        channelId : string!
        resourceId : string!
      }
        @description "Stop an active watch channel, ending calendar change notifications."
        @synonyms "stop watch, unsubscribe, end notifications"
    }

    config {
      calendarId : string = "primary"
        @label "Default calendar id"
        @description "Calendar used when an action names none."
        @synonyms "default calendar, calendar id"
        @tier "domain"
    }
  }

  trait CalendarCall -> CalendarRequest [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      CALL_READY -> idle when (= @payload.retry false)
        (set @entity.method @payload.method)
        (set @entity.target @payload.target)
        (set @entity.body @payload.body)
        (set @entity.mintTried false)
        (set @entity.attempt 0)
        (emit CALENDAR_DISPATCH {})
      CALL_READY -> idle when (= @payload.retry true)
        (set @entity.method @payload.method)
        (set @entity.target @payload.target)
        (set @entity.body @payload.body)
        (set @entity.mintTried false)
        (set @entity.attempt 0)
        (emit CALENDAR_RETRY_START { key: (as @payload.key CallKey) })
      CALENDAR_ATTEMPT -> idle
        (set @entity.attempt @payload.attempt)
        (emit CALENDAR_DISPATCH {})
      CALENDAR_DISPATCH -> idle when (= @entity.body "")
        (emit CALENDAR_HTTP_SEND { key: @entity.id, method: @entity.method, target: @entity.target, headers: [{ name: "accept", value: "*/*" }], body: (bytes/from-string ""), stream: "none" })
      CALENDAR_DISPATCH -> idle when (!= @entity.body "")
        (emit CALENDAR_HTTP_SEND { key: @entity.id, method: @entity.method, target: @entity.target, headers: [{ name: "accept", value: "*/*" }, { name: "content-type", value: "application/json" }], body: (bytes/from-string @entity.body), stream: "none" })

      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "list"))
        (let ((r (json/parse @payload.body CalendarEventsReply))) (if (= @r null) (emit CALENDAR_LIST_EVENTS_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a calendar event list" }) (emit CALENDAR_EVENTS_LISTED { events: (array/map (object/get @r items []) (fn i { id: (default (object/get @i id "") ""), summary: (default (object/get @i summary "") ""), description: (default (object/get @i description "") ""), location: (default (object/get @i location "") ""), start: (let ((dt (object/get @i "start.dateTime" ""))) (if (!= @dt "") @dt (object/get @i "start.date" ""))), end: (let ((dt (object/get @i "end.dateTime" ""))) (if (!= @dt "") @dt (object/get @i "end.date" ""))), status: (default (object/get @i status "") ""), updated: (default (object/get @i updated "") "") })), nextSyncToken: (object/get @r nextSyncToken null) })))
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "create"))
        (let ((r (json/parse @payload.body CalendarCreatedReply))) (if (= @r null) (emit CALENDAR_CREATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a created event" }) (emit CALENDAR_EVENT_CREATED { id: (object/get @r id ""), status: (object/get @r status ""), htmlLink: (object/get @r htmlLink "") })))
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (= @payload.key "update"))
        (let ((r (json/parse @payload.body CalendarPatchedReply))) (if (= @r null) (emit CALENDAR_UPDATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a patched event" }) (emit CALENDAR_EVENT_UPDATED { id: (object/get @r id ""), status: (object/get @r status "") })))
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (str/startsWith @payload.key "delete:"))
        (emit CALENDAR_EVENT_DELETED { id: (str/slice @payload.key 7), deleted: true })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (str/startsWith @payload.key "freeBusy:"))
        (let ((r (json/parse @payload.body CalendarFreeBusyReply))) (if (= @r null) (emit CALENDAR_FREE_BUSY_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a free-busy result" }) (emit CALENDAR_FREE_BUSY_RESULT { busy: (array/map (object/get (object/get (object/get @r calendars {}) (str/slice @payload.key 9) {}) busy []) (fn s { start: (default (object/get @s start "") ""), end: (default (object/get @s end "") "") })) })))
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (json/valid @payload.body) (str/startsWith @payload.key "watch:"))
        (let ((r (json/parse @payload.body CalendarWatchReply))) (if (= @r null) (emit CALENDAR_WATCH_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with JSON that is not a watch channel" }) (emit CALENDAR_WATCHED { channelId: (let ((rid (object/get @r id ""))) (if (!= @rid "") @rid (str/slice @payload.key 6))), resourceId: (object/get @r resourceId ""), expiration: (object/get @r expiration "") })))
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.key "stopWatch"))
        (emit CALENDAR_WATCH_STOPPED { stopped: true })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "list"))
        (emit CALENDAR_LIST_EVENTS_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (= @payload.key "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (str/startsWith @payload.key "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (json/valid @payload.body)) (str/startsWith @payload.key "watch:"))
        (emit CALENDAR_WATCH_FAILED { code: "MALFORMED_REPLY", message: "Google Calendar replied with a body that is not valid JSON" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (not (or (and (>= @payload.status 100) (< @payload.status 200)) (= @payload.status 408) (= @payload.status 429) (and (>= @payload.status 500) (< @payload.status 600)))) (= @payload.key "list"))
        (emit CALENDAR_LIST_EVENTS_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @payload.key "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (not (or (and (>= @payload.status 100) (< @payload.status 200)) (= @payload.status 408) (= @payload.status 429) (and (>= @payload.status 500) (< @payload.status 600)))) (str/startsWith @payload.key "delete:"))
        (emit CALENDAR_DELETE_EVENT_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (str/startsWith @payload.key "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { message: (let ((eo (json/parse @payload.body CalendarErrorReply)) (es (json/parse @payload.body CalendarErrorStringReply))) (let ((m (if (!= @eo null) (if (object/has @eo "error.errors") (str/join (array/map (object/get @eo "error.errors" []) (fn e (default (object/get @e message "") ""))) "\n") (default (object/get @eo "error.message" "") "")) (if (!= @es null) (object/get @es error "") "")))) (if (!= @m "") @m (if (>= @payload.status 400) (if (str/startsWith @payload.body "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status))))) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (str/startsWith @payload.key "watch:"))
