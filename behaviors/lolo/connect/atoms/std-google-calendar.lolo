      CALENDAR_CONNECTED -> idle when (and (= @payload.connected false) (= @entity.id "stopWatch"))
        (emit CALENDAR_STOP_WATCH_FAILED { message: "Google Calendar did not connect the service account" })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (= @entity.id "list"))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_LIST_EVENTS_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (= @entity.id "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (= @entity.id "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (str/startsWith @entity.id "delete:"))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_DELETE_EVENT_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (str/startsWith @entity.id "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (str/startsWith @entity.id "watch:"))
        (emit CALENDAR_WATCH_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (= @payload.kind "unavailable") (= @entity.id "stopWatch"))
        (emit CALENDAR_STOP_WATCH_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: calendar. Set GOOGLE_CALENDAR_SA_KEY / GOOGLE_CALENDAR_SUBJECT / GOOGLE_CALENDAR_ID / GOOGLE_CALENDAR_CHANNEL_TOKEN." })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (= @entity.id "list"))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_LIST_EVENTS_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (= @entity.id "create"))
        (emit CALENDAR_CREATE_EVENT_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (= @entity.id "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (str/startsWith @entity.id "delete:"))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_DELETE_EVENT_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (str/startsWith @entity.id "freeBusy:"))
        (emit CALENDAR_FREE_BUSY_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (str/startsWith @entity.id "watch:"))
        (emit CALENDAR_WATCH_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CONNECT_FAILED -> idle when (and (!= @payload.kind "unavailable") (= @entity.id "stopWatch"))
        (emit CALENDAR_STOP_WATCH_FAILED { message: (str/concat "Google token request failed: " @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_GAVE_UP -> idle when (= @payload.key "list")
        (emit CALENDAR_LIST_EVENTS_FAILED { message: (default @payload.error "") })
        (emit CALENDAR_CLEAR {})
      CALENDAR_GAVE_UP -> idle when (str/startsWith @payload.key "delete:")
        (emit CALENDAR_DELETE_EVENT_FAILED { message: (default @payload.error "") })
        (emit CALENDAR_CLEAR {})
      CALENDAR_CLEAR -> idle
        (set @entity.method "")
        (set @entity.target "")
        (set @entity.body "")
        (set @entity.mintTried false)
        (set @entity.attempt 0)
    }

    emits {
      CALENDAR_EVENTS_LISTED -> external {
        events : [CalendarEventRecord]!
        nextSyncToken : string?
      }
        @description "The events of the listed calendar, mapped to flat records (start and end are dateTime or date text), and the next incremental-sync token when the API returned one."
        @synonyms "listed events, calendar events result"
        @tier "primary"
      CALENDAR_EVENT_CREATED -> external {
        id : string!
        status : string!
        htmlLink : string!
      }
        @description "The created event: id, status and link (blank when the API named none)."
        @synonyms "event created, new event"
        @tier "primary"
      CALENDAR_EVENT_UPDATED -> external {
        id : string!
        status : string!
      }
        @description "The patched event: id and status (blank when the API named none)."
        @synonyms "event updated, event patched"
        @tier "primary"
      CALENDAR_EVENT_DELETED -> external {
        id : string!
        deleted : boolean!
      }
        @description "The deleted event id."
        @synonyms "event deleted, event removed"
        @tier "primary"
      CALENDAR_FREE_BUSY_RESULT -> external {
        busy : [CalendarBusySlot]!
      }
        @description "Busy time blocks of the queried calendar within the window."
        @synonyms "busy slots, availability result"
        @tier "primary"
      CALENDAR_WATCHED -> external {
        channelId : string!
        resourceId : string!
        expiration : string!
      }
        @description "The registered notification channel; expiration is epoch milliseconds as text."
        @synonyms "watch registered, channel created"
        @tier "primary"
      CALENDAR_WATCH_STOPPED -> external {
        stopped : boolean!
      }
        @description "The watch channel was stopped."
        @synonyms "watch stopped, channel closed"
        @tier "primary"
      CALENDAR_LIST_EVENTS_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of listing events: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_CREATE_EVENT_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of creating an event: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_UPDATE_EVENT_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of updating an event: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_DELETE_EVENT_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of deleting an event: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_FREE_BUSY_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of the free-busy query: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_WATCH_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of registering a watch channel: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_STOP_WATCH_FAILED -> external {
        code : string
        message : string!
      }
        @description "Failure of stopping a watch channel: the API error message, or the transport error; code is blank, NOT_CONFIGURED or MALFORMED_REPLY."
        @synonyms "calendar failure, calendar error"
        @tier "primary"
      CALENDAR_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: the Google Calendar request, for the HTTP client."
        @tier "secondary"
      CALENDAR_RETRY_START { key : CallKey! }
        @description "Internal: hand a list or delete to std-retry."
        @tier "secondary"
      CALENDAR_RETRY_FAILED { key : CallKey!  error : string }
        @description "Internal: tell std-retry the attempt failed with a retryable outcome."
        @tier "secondary"
      CALENDAR_DISPATCH -> internal { }
        @description "Internal: send the request in flight, again after a retry attempt or a minted token."
        @tier "secondary"
      CALENDAR_CONNECTED -> internal {
        connected : boolean!
        label : string
      }
        @description "Internal: the credential store minted the access token."
        @tier "secondary"
      CALENDAR_CONNECT_FAILED -> internal {
        error : string!
        kind : string!
      }
        @description "Internal: the credential store could not mint the access token."
        @tier "secondary"
      CALENDAR_RETRY_CANCEL { key : CallKey! }
        @description "Internal: end std-retry's run for this key without another attempt."
        @tier "secondary"
      CALENDAR_CLEAR -> internal { }
        @description "Internal: return the row of a finished call to its defaults so the kernel drops it."
        @tier "secondary"
    }

    listens {
      CALL_READY {
        key : string!
        method : string!
        target : string!
        body : string!
        retry : boolean!
      }
      CALENDAR_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      CALENDAR_REQUEST_FAILED {
        error : string!
        kind : string!
        key : string!
      }
      CALENDAR_CONNECTED {
        connected : boolean!
        label : string
      }
      CALENDAR_CONNECT_FAILED {
        error : string!
        kind : string!
      }
      CALENDAR_ATTEMPT {
        key : string!
        attempt : number!
      }
      CALENDAR_GAVE_UP {
        key : string!
        attempts : number!
        error : string
      }
      CALENDAR_DISPATCH
      CALENDAR_CLEAR
      CalendarClient.CALENDAR_READY -> CALL_READY per @payload.key
      CalendarHttp.HTTP_REPLIED -> CALENDAR_REPLIED per @payload.key with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) ""), key: ?key }
      CalendarHttp.HTTP_FAILED -> CALENDAR_REQUEST_FAILED per @payload.key with { error: ?error, kind: ?kind, key: ?key }
      CalendarRetry.ATTEMPT -> CALENDAR_ATTEMPT per @payload.key
      CalendarRetry.GAVE_UP -> CALENDAR_GAVE_UP per @payload.key
    }

    config {
      tokenUrl : url = "https://www.googleapis.com/oauth2/v4/token"
        @label "Token endpoint"
        @description "The Google OAuth token endpoint the credential store exchanges the signed service-account assertion at; also the assertion audience. Must be declared in the app egress list."
        @synonyms "oauth token url, jwt exchange endpoint"
        @tier "infra"
      serviceAccount : secret = "GOOGLE_CALENDAR_SA_KEY"
        @label "Service account signing key"
        @description "Name of the credential holding the service account's PKCS#8 PEM RSA private key; the credential store signs the RS256 assertion with it."
        @synonyms "service account key, google credential, calendar key"
        @tier "infra"
      serviceAccountEmail : string
        @label "Service account email"
        @description "The service account's client_email, the assertion issuer; the stored credential is the PEM key only."
        @synonyms "client email, service account address, assertion issuer"
        @tier "infra"
      tokenCache : secret = "GOOGLE_CALENDAR_ACCESS_TOKEN"
        @label "Access token credential"
        @description "Host credential name the minted access token lives under; the composed CalendarHttp trait carries the same name, restate it there when this knob changes."
        @synonyms "token cache, access token name"
        @tier "infra"
      scope : string = "https://www.googleapis.com/auth/calendar"
        @label "OAuth scope"
        @description "The scope claim of the signed assertion."
        @synonyms "calendar scope, oauth scope"
        @tier "infra"
      subject : string = ""
        @label "Delegated user"
        @description "Workspace user the service account acts as (the sub claim); blank = the service account itself."
        @synonyms "impersonate user, domain-wide delegation, subject"
        @tier "domain"
    }
  }

  trait CalendarPushInbound -> CalendarRequest [client] {
    initial: idle

    state idle {
      INIT -> idle

      CALENDAR_PUSH_RECEIVED -> idle when (or (= (object/get (default @payload.headers {}) "x-goog-channel-id" "") "") (= (object/get (default @payload.headers {}) "x-goog-resource-id" "") "") (= (object/get (default @payload.headers {}) "x-goog-resource-state" "") ""))
        (emit CALENDAR_PUSH_ANSWERED { status: 400, body: "{\"error\":\"missing-headers\"}" })
      CALENDAR_PUSH_RECEIVED -> idle when (= @payload.verified false)
        (emit CALENDAR_PUSH_ANSWERED { status: 400, body: "{\"error\":\"bad-token\"}" })
      CALENDAR_PUSH_RECEIVED -> idle when (= (object/get (default @payload.headers {}) "x-goog-resource-state" "") "sync")
        (emit CALENDAR_PUSH_ANSWERED { status: 200, body: "{\"ok\":true,\"dispatched\":false}" })
      CALENDAR_PUSH_RECEIVED -> idle
        (emit CAL_REMOTE_CHANGED { channelId: (object/get (default @payload.headers {}) "x-goog-channel-id" ""), resourceId: (object/get (default @payload.headers {}) "x-goog-resource-id" ""), resourceState: (object/get (default @payload.headers {}) "x-goog-resource-state" "") })
        (emit CALENDAR_PUSH_ANSWERED { status: 200, body: "{\"ok\":true,\"dispatched\":true,\"event\":\"CAL_REMOTE_CHANGED\"}" })
    }

    emits {
      CAL_REMOTE_CHANGED -> external {
        channelId : string!
        resourceId : string!
        resourceState : string!
      }
        @description "A verified Google Calendar watch-channel push notification: the channel, the watched resource and the change state (`exists` or `not_exists`). The `sync` handshake that announces a channel is acknowledged without this event."
        @synonyms "calendar changed, remote calendar change, watch notification"
        @tier "primary"
      CALENDAR_PUSH_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the HTTP answer to the push request (status and JSON body) — the inbound hook writes it back to Google."
        @tier "secondary"
    }

    listens {
      CALENDAR_PUSH_RECEIVED -> inbound "google-calendar" answers CALENDAR_PUSH_ANSWERED verifies "x-goog-channel-token" "GOOGLE_CALENDAR_CHANNEL_TOKEN" {
        headers : Map string string
        body : Map string string
        rawBody : string
        verified : boolean
      }
        @description "Google Calendar push notification delivered at /api/hooks/google-calendar. Google sends no body: the channel, resource and state ride the X-Goog-* headers (names arrive lower-cased). `verified` is the kernel's check of X-Goog-Channel-Token against the GOOGLE_CALENDAR_CHANNEL_TOKEN credential; an unset credential leaves the channel unchecked."
        @synonyms "calendar push, watch notification, calendar webhook"
    }
  }

  page boot as CalendarPage -> CalendarClient, CalendarCall, CalendarKeyed, CalendarHttp, CalendarTimeout, CalendarRetry, CalendarPushInbound
}
