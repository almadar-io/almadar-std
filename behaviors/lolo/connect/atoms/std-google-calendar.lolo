        (emit CALENDAR_CREATE_EVENT_FAILED { message: (if (= @payload.kind "timeout") "network timeout" @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REQUEST_FAILED -> idle when (and (!= @payload.kind "unconfigured") (= @payload.key "update"))
        (emit CALENDAR_UPDATE_EVENT_FAILED { message: (if (= @payload.kind "timeout") "network timeout" @payload.error) })
        (emit CALENDAR_CLEAR {})
      CALENDAR_REQUEST_FAILED -> idle when (and (!= @payload.kind "unconfigured") (str/startsWith @payload.key "delete:") (< @entity.attempt 3))
        (emit CALENDAR_RETRY_FAILED { key: (as @payload.key CallKey), error: (if (= @payload.kind "timeout") "network timeout" @payload.error) })
      CALENDAR_REQUEST_FAILED -> idle when (and (!= @payload.kind "unconfigured") (str/startsWith @payload.key "delete:") (>= @entity.attempt 3))
        (emit CALENDAR_RETRY_CANCEL { key: (as @entity.id CallKey) })
        (emit CALENDAR_DELETE_EVENT_FAILED { message: (if (= @payload.kind "timeout") "network timeout" @payload.error) })
