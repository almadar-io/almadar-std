app std-ml [
  version: "1.0.0",
  description: "std-ml — model inference through a deployed serving orbital. ML_INFER posts the INFER event to the serving orbital's per-trait /events route and answers ML_INFERRED with the model output, confidence and contract violations, or ML_INFER_FAILED with a code and message when the host is unconfigured, unreachable, answers non-2xx, reports a failure or returns no valid inference result.",
  egress: ["http://localhost:3000"]
]
uses Fetch from "std/behaviors/std-http-fetch"
type HttpHeader = { name : string!, value : string! }
type MlLabelledOutput = { label : string, scores : Map string number }
type MlInput = Map string [number] | [[number]]
type MlOutput = number | [number] | MlLabelledOutput
type MlViolation = { rule : string, field : string, type : string, expected : [number], actual : [number], dim : number, min : number, max : number, actualMin : number, actualMax : number, actualType : string }
type MlInferPayload = { output : MlOutput?!, confidence : number!, violations : [MlViolation]! }
type MlNode = string | number | boolean | [MlNode?] | Map string MlNode?
type MlEmitData = { event : string, payload : MlNode? }
type MlEffectResult = { effect : string, success : boolean, error : string, data : MlEmitData }
type MlReply = { success : boolean, error : string, effectResults : [MlEffectResult] }
orbital MlOrbital {
  entity MlInference [runtime] {
    id : string!
  }

  trait MlFetch = Fetch.traits.HttpFetch {
    config {
      origin: "http://localhost:3000"
      timeoutMs: 60000
    }
    listens {
      MlClient.ML_HTTP_SEND -> HTTP_SEND
    }
  }

  trait MlClient -> MlInference [client] {
    initial: idle

    state idle {
      INIT -> idle

      ML_INFER -> idle when (= @config.traitName "")
        (emit ML_INFER_FAILED { message: "ML integration requires MASAR_URL (serving orbital host) and MASAR_ML_TRAIT (kebab-case trait name of its /events route) to be configured" })
      ML_INFER -> idle when (!= @config.traitName "")
        (emit ML_HTTP_SEND { key: "infer", method: "POST", target: (str/concat "/api/" @config.traitName "/events"), headers: [{ name: "Accept", value: "*/*" }, { name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { event: "INFER", payload: { model: @payload.model, input: @payload.input } })), stream: "none" })

      ML_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit ML_INFER_FAILED { code: "SERVICE_ERROR", message: (str/concat "ML service responded with status " @payload.status) })
      ML_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((reply (json/parse (default (bytes/to-string @payload.body) "") MlReply)))
          (if (= @reply null)
            (emit ML_INFER_FAILED { code: "SERVICE_ERROR", message: "ML service returned a malformed response body" })
            (if (!= (object/get @reply success false) true)
              (emit ML_INFER_FAILED { code: "SERVICE_ERROR", message: (str/concat "ML service reported failure: " (default (object/get @reply error null) "unknown error")) })
              (let ((results (default (object/get @reply effectResults []) []))
                    (failed (array/find (default (object/get @reply effectResults []) []) (fn r (and (= (object/get @r effect "") "emit") (= (object/get (object/get @r data {}) event "") "INFER_FAILED"))))))
                (if (!= @failed null)
                  (emit ML_INFER_FAILED { code: "SERVICE_ERROR", message: (str/concat "ML service could not infer: " (default (object/get (default @failed {}) error null) "model unavailable")) })
                  (let ((hit (array/find @results (fn r (and (= (object/get @r effect "") "emit") (= (object/get @r success false) true) (= (object/get (object/get @r data {}) event "") "INFERRED"))))))
                    (let ((inferred (if (= @hit null) null (json/parse (json/stringify (object/get (object/get @hit data {}) payload null)) MlInferPayload))))
                      (if (= @inferred null)
                        (emit ML_INFER_FAILED { code: "SERVICE_ERROR", message: "ML service response did not include a valid inference result" })
                        (emit ML_INFERRED {
                          output: (object/get @inferred output null),
                          confidence: (object/get @inferred confidence 0),
                          violations: (object/get @inferred violations [])
                        })))))))))
      ML_CALL_FAILED -> idle when (= @payload.kind "timeout")
        (emit ML_INFER_FAILED { code: "TIMEOUT_ERROR", message: "ML service request timed out (model may be cold-starting)" })
      ML_CALL_FAILED -> idle when (!= @payload.kind "timeout")
        (emit ML_INFER_FAILED { code: "NETWORK_ERROR", message: "ML service request failed: fetch failed" })
    }

    emits {
      ML_INFERRED -> external {
        output : MlOutput?
        confidence : number!
        violations : [MlViolation]!
      }
        @description "The serving orbital's INFERRED answer: the model output (null stays an output), its confidence and the contract violations."
        @synonyms "inference result, model output, prediction"
        @tier "primary"
      ML_INFER_FAILED -> external {
        code : string
        message : string!
      }
        @description "The inference did not produce a result: code is null when the host is unconfigured, otherwise SERVICE_ERROR, TIMEOUT_ERROR or NETWORK_ERROR, with the reason in message."
        @synonyms "inference failed, model unavailable, ml error"
        @tier "primary"
      ML_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one request, for the HTTP fetch."
        @tier "internal"
    }

    listens {
      ML_INFER -> input {
        model : string!
        input : MlInput!
      }
        @description "Run inference: model is hf:<id> for off-the-shelf weights or a masar checkpoint id; input is the tensor-shaped payload the model expects."
        @synonyms "infer, predict, run model"
      ML_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
      ML_CALL_FAILED {
        key : string
        error : string!
        kind : string!
      }
      MlFetch.HTTP_REPLIED -> ML_REPLIED
      MlFetch.HTTP_FAILED -> ML_CALL_FAILED
    }

    config {
      traitName : string = ""
        @label "Serving trait"
        @description "Kebab-case trait name the serving orbital exposes its /events route under; empty means the host is unconfigured."
        @synonyms "masar ml trait, events route, serving trait"
        @tier "infra"
    }
  }

  page boot as MlPage -> MlClient, MlFetch
}
