app std-youtube [
  version: "1.0.0",
  description: "std-youtube — YouTube Data API v3 search, video and channel lookups. YOUTUBE_SEARCH lists matching video snippets, YOUTUBE_GET_VIDEO and YOUTUBE_GET_CHANNEL fetch snippet and statistics. The API key is a secret knob sent as the key query parameter; server errors, rate limiting and dead connections are retried as the googleapis SDK does.",
  egress: ["https://youtube.googleapis.com"]
]
type YoutubeJob = { kind : string!, attempt : number!, query : string!, maxResults : number!, type : string!, id : string! }
type YoutubePending = { key : string!, job : YoutubeJob! }
type YoutubeKv = { k : string!, v : string? }
type YoutubeSearchId = { videoId : string }
type YoutubeThumbnail = { url : string }
type YoutubeThumbnails = { default : YoutubeThumbnail }
type YoutubeSnippet = { title : string, description : string, thumbnails : YoutubeThumbnails }
type YoutubeStatistics = { viewCount : string, likeCount : string, subscriberCount : string }
type YoutubeSearchItem = { id : YoutubeSearchId, snippet : YoutubeSnippet }
type YoutubeSearchReply = { items : [YoutubeSearchItem]! }
type YoutubeResource = { snippet : YoutubeSnippet, statistics : YoutubeStatistics }
type YoutubeResourceReply = { items : [YoutubeResource]! }
type YoutubeErrorDetail = { message : string }
type YoutubeErrorObject = { message : string, errors : [YoutubeErrorDetail] }
type YoutubeErrorBody = { error : (string | YoutubeErrorObject) }
orbital YoutubeOrbital {
  entity YoutubeLookup [runtime] {
    id : string!
    pending : [YoutubePending] = []
    seq : number = 0
  }

  trait YoutubeClient -> YoutubeLookup [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      YOUTUBE_SEARCH -> idle
        (emit YOUTUBE_REQUEST { kind: "search", attempt: 0, query: @payload.query, maxResults: (default @payload.maxResults 10), type: (default @payload.type ""), id: "" })
      YOUTUBE_GET_VIDEO -> idle
        (emit YOUTUBE_REQUEST { kind: "video", attempt: 0, query: "", maxResults: 0, type: "", id: @payload.videoId })
      YOUTUBE_GET_CHANNEL -> idle
        (emit YOUTUBE_REQUEST { kind: "channel", attempt: 0, query: "", maxResults: 0, type: "", id: @payload.channelId })

      YOUTUBE_REQUEST -> idle when (and (= @payload.kind "search") (!= @payload.type ""))
        (let ((k (str/concat "youtube-" @entity.seq)))
          (do
            (set @entity.pending (array/append @entity.pending { key: @k, job: { kind: @payload.kind, attempt: @payload.attempt, query: @payload.query, maxResults: @payload.maxResults, type: @payload.type, id: @payload.id } }))
            (set @entity.seq (+ @entity.seq 1))
            (http GET @config.origin "/youtube/v3/search" {
              query: { part: "snippet", q: @payload.query, maxResults: @payload.maxResults, type: @payload.type },
              queryEncoding: rfc3986,
              headers: { Accept: "*/*" },
              auth: { scheme: api-key, credential: @config.apiKey, name: "key", in: query },
              timeoutMs: @config.timeoutMs
            } { key: @k, emit: { success: YOUTUBE_REPLIED, failure: YOUTUBE_UNREACHED } })))
      YOUTUBE_REQUEST -> idle when (and (= @payload.kind "search") (= @payload.type ""))
        (let ((k (str/concat "youtube-" @entity.seq)))
          (do
            (set @entity.pending (array/append @entity.pending { key: @k, job: { kind: @payload.kind, attempt: @payload.attempt, query: @payload.query, maxResults: @payload.maxResults, type: @payload.type, id: @payload.id } }))
            (set @entity.seq (+ @entity.seq 1))
            (http GET @config.origin "/youtube/v3/search" {
              query: { part: "snippet", q: @payload.query, maxResults: @payload.maxResults },
              queryEncoding: rfc3986,
              headers: { Accept: "*/*" },
              auth: { scheme: api-key, credential: @config.apiKey, name: "key", in: query },
              timeoutMs: @config.timeoutMs
            } { key: @k, emit: { success: YOUTUBE_REPLIED, failure: YOUTUBE_UNREACHED } })))
      YOUTUBE_REQUEST -> idle when (= @payload.kind "video")
        (let ((k (str/concat "youtube-" @entity.seq)))
          (do
            (set @entity.pending (array/append @entity.pending { key: @k, job: { kind: @payload.kind, attempt: @payload.attempt, query: @payload.query, maxResults: @payload.maxResults, type: @payload.type, id: @payload.id } }))
            (set @entity.seq (+ @entity.seq 1))
            (http GET @config.origin "/youtube/v3/videos" {
              query: { part: ["snippet", "statistics"], id: @payload.id },
              queryEncoding: rfc3986,
              headers: { Accept: "*/*" },
              auth: { scheme: api-key, credential: @config.apiKey, name: "key", in: query },
              timeoutMs: @config.timeoutMs
            } { key: @k, emit: { success: YOUTUBE_REPLIED, failure: YOUTUBE_UNREACHED } })))
      YOUTUBE_REQUEST -> idle when (= @payload.kind "channel")
        (let ((k (str/concat "youtube-" @entity.seq)))
          (do
            (set @entity.pending (array/append @entity.pending { key: @k, job: { kind: @payload.kind, attempt: @payload.attempt, query: @payload.query, maxResults: @payload.maxResults, type: @payload.type, id: @payload.id } }))
            (set @entity.seq (+ @entity.seq 1))
            (http GET @config.origin "/youtube/v3/channels" {
              query: { part: ["snippet", "statistics"], id: @payload.id },
              queryEncoding: rfc3986,
              headers: { Accept: "*/*" },
              auth: { scheme: api-key, credential: @config.apiKey, name: "key", in: query },
              timeoutMs: @config.timeoutMs
            } { key: @k, emit: { success: YOUTUBE_REPLIED, failure: YOUTUBE_UNREACHED } })))

      YOUTUBE_REPLIED -> idle when (and (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search")))))
        (let ((r (json/parse @payload.body YoutubeSearchReply)))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (not (json/valid @payload.body))
              (emit YOUTUBE_SEARCH_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not valid JSON" })
              (if (= @r null)
                (emit YOUTUBE_SEARCH_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not a search reply" })
                (emit YOUTUBE_SEARCH_RESULT {
                  items: (array/map @r.items
                    (fn it (let ((kvs : [YoutubeKv] [{ k: "videoId", v: (object/get @it "id.videoId" null) }, { k: "title", v: (object/get @it "snippet.title" null) }, { k: "thumbnail", v: (object/get @it "snippet.thumbnails.default.url" null) }, { k: "description", v: (object/get @it "snippet.description" null) }]))
                      (default (object/fromEntries (array/map (array/filter @kvs (fn x (!= @x.v null))) (fn x [@x.k (default @x.v "")]))) {}))))
                })))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (< @payload.status 200) (= @payload.status 408) (= @payload.status 429) (>= @payload.status 500)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search") (< @p.job.attempt 3)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_SEARCH_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (and (>= @payload.status 200) (< @payload.status 500) (!= @payload.status 408) (!= @payload.status 429)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 3))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search")))))
        (let ((b (json/parse @payload.body YoutubeErrorBody)))
          (let ((error (if (= @b null) null (object/get @b error null))))
            (do
              (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
              (emit YOUTUBE_REJECTED {
                kind: "search",
                message: (if (validate/string @error)
                  (if (!= @error "") @error (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status)))
                  (if (!= @error null)
                    (if (!= (object/get @error errors null) null)
                      (str/join (array/map (object/get @error errors []) (fn detail (default (object/get @detail message null) ""))) "\n")
                      (default (object/get @error message null) ""))
                    (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status))))
              })))) 
      YOUTUBE_REPLIED -> idle when (and (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video")))))
        (let ((r (json/parse @payload.body YoutubeResourceReply)) (e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (not (json/valid @payload.body))
              (emit YOUTUBE_VIDEO_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not valid JSON" })
              (if (= @r null)
                (emit YOUTUBE_VIDEO_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not a video reply" })
                (let ((it (array/first @r.items)))
                  (if (= @it null)
                    (if (= @e null)
                      (emit YOUTUBE_VIDEO_FAILED { message: "YouTube replied for a request that is no longer pending" })
                      (emit YOUTUBE_REJECTED { kind: "video", message: (str/concat "Video not found: " @e.job.id) }))
                    (let ((kvs : [YoutubeKv] [{ k: "title", v: (object/get @it "snippet.title" null) }, { k: "description", v: (object/get @it "snippet.description" null) }, { k: "viewCount", v: (object/get @it "statistics.viewCount" null) }, { k: "likeCount", v: (object/get @it "statistics.likeCount" null) }]))
                      (emit YOUTUBE_VIDEO_RESULT (object/fromEntries (array/map (array/filter @kvs (fn x (!= @x.v null))) (fn x [@x.k (default @x.v "")])))))))))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (< @payload.status 200) (= @payload.status 408) (= @payload.status 429) (>= @payload.status 500)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video") (< @p.job.attempt 3)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_VIDEO_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (and (>= @payload.status 200) (< @payload.status 500) (!= @payload.status 408) (!= @payload.status 429)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 3))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video")))))
        (let ((b (json/parse @payload.body YoutubeErrorBody)))
          (let ((error (if (= @b null) null (object/get @b error null))))
            (do
              (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
              (emit YOUTUBE_REJECTED {
                kind: "video",
                message: (if (validate/string @error)
                  (if (!= @error "") @error (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status)))
                  (if (!= @error null)
                    (if (!= (object/get @error errors null) null)
                      (str/join (array/map (object/get @error errors []) (fn detail (default (object/get @detail message null) ""))) "\n")
                      (default (object/get @error message null) ""))
                    (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status))))
              })))) 
      YOUTUBE_REPLIED -> idle when (and (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel")))))
        (let ((r (json/parse @payload.body YoutubeResourceReply)) (e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (not (json/valid @payload.body))
              (emit YOUTUBE_CHANNEL_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not valid JSON" })
              (if (= @r null)
                (emit YOUTUBE_CHANNEL_FAILED { code: "MALFORMED_REPLY", message: "YouTube API replied with a body that is not a channel reply" })
                (let ((it (array/first @r.items)))
                  (if (= @it null)
                    (if (= @e null)
                      (emit YOUTUBE_CHANNEL_FAILED { message: "YouTube replied for a request that is no longer pending" })
                      (emit YOUTUBE_REJECTED { kind: "channel", message: (str/concat "Channel not found: " @e.job.id) }))
                    (let ((kvs : [YoutubeKv] [{ k: "name", v: (object/get @it "snippet.title" null) }, { k: "description", v: (object/get @it "snippet.description" null) }, { k: "subscriberCount", v: (object/get @it "statistics.subscriberCount" null) }]))
                      (emit YOUTUBE_CHANNEL_RESULT (object/fromEntries (array/map (array/filter @kvs (fn x (!= @x.v null))) (fn x [@x.k (default @x.v "")])))))))))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (< @payload.status 200) (= @payload.status 408) (= @payload.status 429) (>= @payload.status 500)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel") (< @p.job.attempt 3)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_CHANNEL_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_REPLIED -> idle when (and (not (or (and (>= @payload.status 200) (< @payload.status 300)) (= @payload.status 304))) (or (and (>= @payload.status 200) (< @payload.status 500) (!= @payload.status 408) (!= @payload.status 429)) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 3))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel")))))
        (let ((b (json/parse @payload.body YoutubeErrorBody)))
          (let ((error (if (= @b null) null (object/get @b error null))))
            (do
              (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
              (emit YOUTUBE_REJECTED {
                kind: "channel",
                message: (if (validate/string @error)
                  (if (!= @error "") @error (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status)))
                  (if (!= @error null)
                    (if (!= (object/get @error errors null) null)
                      (str/join (array/map (object/get @error errors []) (fn detail (default (object/get @detail message null) ""))) "\n")
                      (default (object/get @error message null) ""))
                    (if (>= @payload.status 400) @payload.body (str/concat "Request failed with status code " @payload.status))))
              })))) 

      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "refused") (!= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search") (< @p.job.attempt 2)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_SEARCH_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "unconfigured") (or (= @payload.kind "refused") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 2))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "search", message: @payload.error }))
      YOUTUBE_UNREACHED -> idle when (and (= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "search")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "search", message: (if (validate/string @payload.credential) (str/concat @payload.credential " not configured") @payload.error) }))
      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "refused") (!= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video") (< @p.job.attempt 2)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_VIDEO_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "unconfigured") (or (= @payload.kind "refused") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 2))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "video", message: @payload.error }))
      YOUTUBE_UNREACHED -> idle when (and (= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "video")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "video", message: (if (validate/string @payload.credential) (str/concat @payload.credential " not configured") @payload.error) }))
      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "refused") (!= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel") (< @p.job.attempt 2)))))
        (let ((e (array/find @entity.pending (fn p (= @p.key @payload.key)))))
          (do
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
            (if (= @e null)
              (emit YOUTUBE_CHANNEL_FAILED { message: "YouTube replied for a request that is no longer pending" })
              (emit YOUTUBE_REQUEST { kind: @e.job.kind, attempt: (+ @e.job.attempt 1), query: @e.job.query, maxResults: @e.job.maxResults, type: @e.job.type, id: @e.job.id }))))
      YOUTUBE_UNREACHED -> idle when (and (!= @payload.kind "unconfigured") (or (= @payload.kind "refused") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (>= @p.job.attempt 2))))) (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "channel", message: @payload.error }))
      YOUTUBE_UNREACHED -> idle when (and (= @payload.kind "unconfigured") (array/some @entity.pending (fn p (and (= @p.key @payload.key) (= @p.job.kind "channel")))))
        (do
          (set @entity.pending (array/filter @entity.pending (fn p (!= @p.key @payload.key))))
          (emit YOUTUBE_REJECTED { kind: "channel", message: (if (validate/string @payload.credential) (str/concat @payload.credential " not configured") @payload.error) }))

      YOUTUBE_REJECTED -> idle when (= @payload.kind "search")
        (emit YOUTUBE_SEARCH_FAILED { message: @payload.message })
      YOUTUBE_REJECTED -> idle when (= @payload.kind "video")
        (emit YOUTUBE_VIDEO_FAILED { message: @payload.message })
      YOUTUBE_REJECTED -> idle when (= @payload.kind "channel")
        (emit YOUTUBE_CHANNEL_FAILED { message: @payload.message })

    emits {
      YOUTUBE_SEARCH_RESULT -> external {
        items : [Map string string]!
      }
        @description "Matching search results, each with whichever of videoId, title, thumbnail and description the API returned."
        @synonyms "youtube search results, video search, matching videos"
        @tier "primary"
      YOUTUBE_VIDEO_RESULT -> external {
        title : string
        description : string
        viewCount : string
        likeCount : string
      }
        @description "A video's title, description and view and like counts; a field the API omitted is absent."
        @synonyms "video details, video statistics, youtube video"
        @tier "primary"
      YOUTUBE_CHANNEL_RESULT -> external {
        name : string
        description : string
        subscriberCount : string
      }
        @description "A channel's name, description and subscriber count; a field the API omitted (hidden subscribers) is absent."
        @synonyms "channel details, channel statistics, youtube channel"
        @tier "primary"
      YOUTUBE_SEARCH_FAILED -> external {
        code : string
        message : string!
      }
        @description "The search failed: the API rejected it, the key is not configured, or the API stayed unreachable after retries."
        @synonyms "search error, youtube search failed"
        @tier "primary"
      YOUTUBE_VIDEO_FAILED -> external {
        code : string
        message : string!
      }
        @description "The video lookup failed or the video does not exist."
        @synonyms "video error, video not found"
        @tier "primary"
      YOUTUBE_CHANNEL_FAILED -> external {
        code : string
        message : string!
      }
        @description "The channel lookup failed or the channel does not exist."
        @synonyms "channel error, channel not found"
        @tier "primary"
      YOUTUBE_REQUEST {
        kind : string!
        attempt : number!
        query : string!
        maxResults : number!
        type : string!
        id : string!
      }
        @description "Internal: one attempt at a Data API call."
        @tier "secondary"
      YOUTUBE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: a Data API call's HTTP reply."
        @tier "secondary"
      YOUTUBE_UNREACHED {
        error : string!
        kind : string!
        credential : string
        key : string!
      }
        @description "Internal: a Data API call never produced a reply."
        @tier "secondary"
      YOUTUBE_REJECTED {
        kind : string!
        message : string!
      }
        @description "Internal: a call ended in failure with this message."
        @tier "secondary"
    }

    listens {
      YOUTUBE_SEARCH -> input {
        query : string!
        maxResults : number
        type : string
      }
        @description "Search YouTube for videos matching a query; maxResults defaults to 10, type filters the resource kind (video, channel, playlist)."
        @synonyms "search youtube, find videos, video search"
      YOUTUBE_GET_VIDEO -> input {
        videoId : string!
      }
        @description "Fetch a video's snippet and statistics."
        @synonyms "get video, video details, youtube video info"
      YOUTUBE_GET_CHANNEL -> input {
        channelId : string!
      }
        @description "Fetch a channel's snippet and statistics."
        @synonyms "get channel, channel details, youtube channel info"
      YOUTUBE_REQUEST {
        kind : string!
        attempt : number!
        query : string!
        maxResults : number!
        type : string!
        id : string!
      }
      YOUTUBE_REJECTED {
        kind : string!
        message : string!
      }
      YOUTUBE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      YOUTUBE_UNREACHED {
        error : string!
        kind : string!
        credential : string
        key : string!
      }
    }

    config {
      origin : url = "https://youtube.googleapis.com"
        @label "YouTube API origin"
        @description "The YouTube Data API origin (scheme://host, no path). Must be declared in the app egress list."
        @synonyms "youtube url, api host, data api origin"
        @tier "infra"
      apiKey : secret = "YOUTUBE_API_KEY"
        @label "API key credential"
        @description "Name of the credential holding the YouTube Data API key."
        @synonyms "api key, youtube key, credential"
        @tier "infra"
      timeoutMs : number = 30000
        @label "Request timeout (ms)"
        @description "Milliseconds each YouTube request may take before it counts as unreachable."
        @synonyms "timeout, request deadline, wait limit"
        @tier "infra"
    }
  }

  page boot as YoutubePage -> YoutubeClient
}
