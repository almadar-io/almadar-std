app std-bearer-api [
  version: "1.0.0",
  description: "std-bearer-api — a bearer-token HTTP API as one atom: BEARER_API_REQUEST carries a method (GET, POST, PUT, PATCH or DELETE), an endpoint path starting with / and an optional text body; the atom sends it to the origin knob authenticated with the bearer credential knob and answers BEARER_API_RESPONSE with the status, whether it was 2xx, and the reply body, whatever the status. POST, PUT and PATCH send the body as application/json text; GET and DELETE send none. A method outside the five or an endpoint without a leading / answers BEARER_API_FAILED with code VALIDATION_ERROR; an unreachable API answers BEARER_API_FAILED with the network error message and no code. Set the origin knob to the API and declare that origin in the app egress list.",
  net: { "api.example.com:443": [tcp], "*.example.com:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
orbital BearerApiOrbital {
  entity BearerApiCall [runtime] {
    id : string!
  }

  trait BearerApiHttp = Http.traits.HttpClient {
    config {
      host: "api.example.com"
      port: 443
      tls: true
      serverName: "api.example.com"
      dynamicHost: true
      credential: "CUSTOM_BEARER_TOKEN"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      BearerApiClient.BEARER_API_HTTP_SEND -> HTTP_SEND
      BearerApiTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
    }
  }

  trait BearerApiTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      BearerApiClient.BEARER_API_HTTP_SEND -> START with { key: (as ?key CallKey) }
      BearerApiHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      BearerApiHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait BearerApiClient -> BearerApiCall [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      BEARER_API_REQUEST -> idle when (and (= @payload.method "GET") (str/startsWith @payload.endpoint "/") (str/startsWith @config.origin "https://"))
        (emit BEARER_API_HTTP_SEND {
          key: "request",
          method: "GET",
          target: @payload.endpoint,
          headers: [{ name: "accept", value: "application/json" }],
          body: (bytes/from-string ""),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      BEARER_API_REQUEST -> idle when (and (= @payload.method "DELETE") (str/startsWith @payload.endpoint "/") (str/startsWith @config.origin "https://"))
        (emit BEARER_API_HTTP_SEND {
          key: "request",
          method: "DELETE",
          target: @payload.endpoint,
          headers: [{ name: "accept", value: "application/json" }],
          body: (bytes/from-string ""),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      BEARER_API_REQUEST -> idle when (and (= @payload.method "POST") (str/startsWith @payload.endpoint "/") (str/startsWith @config.origin "https://"))
        (emit BEARER_API_HTTP_SEND {
          key: "request",
          method: "POST",
          target: @payload.endpoint,
          headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string (default @payload.body "")),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      BEARER_API_REQUEST -> idle when (and (= @payload.method "PUT") (str/startsWith @payload.endpoint "/") (str/startsWith @config.origin "https://"))
        (emit BEARER_API_HTTP_SEND {
          key: "request",
          method: "PUT",
          target: @payload.endpoint,
          headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string (default @payload.body "")),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      BEARER_API_REQUEST -> idle when (and (= @payload.method "PATCH") (str/startsWith @payload.endpoint "/") (str/startsWith @config.origin "https://"))
        (emit BEARER_API_HTTP_SEND {
          key: "request",
          method: "PATCH",
          target: @payload.endpoint,
          headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string (default @payload.body "")),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      BEARER_API_REQUEST -> idle when (and (array/includes ["GET", "POST", "PUT", "PATCH", "DELETE"] @payload.method) (str/startsWith @payload.endpoint "/") (not (str/startsWith @config.origin "https://")))
        (emit BEARER_API_FAILED { code: "VALIDATION_ERROR", message: "the origin knob must be an https:// origin" })
      BEARER_API_REQUEST -> idle when (not (array/includes ["GET", "POST", "PUT", "PATCH", "DELETE"] @payload.method))
        (emit BEARER_API_FAILED { code: "VALIDATION_ERROR", message: "method must be one of GET, POST, PUT, PATCH, DELETE" })
      BEARER_API_REQUEST -> idle when (and (array/includes ["GET", "POST", "PUT", "PATCH", "DELETE"] @payload.method) (not (str/startsWith @payload.endpoint "/")))
        (emit BEARER_API_FAILED { code: "VALIDATION_ERROR", message: "endpoint must start with /" })
      BEARER_API_REPLIED -> idle
        (emit BEARER_API_RESPONSE { status: @payload.status, ok: (and (>= @payload.status 200) (< @payload.status 300)), body: @payload.body })
      BEARER_API_UNREACHABLE -> idle
        (emit BEARER_API_FAILED { message: @payload.error })
    }

    emits {
      BEARER_API_RESPONSE -> external {
        status : number!
        ok : boolean!
        body : string!
      }
        @description "The API's reply to the request: its HTTP status, whether that status is 2xx, and the reply body text. A 4xx or 5xx is a response, not a failure."
        @synonyms "api response, bearer response, http reply"
        @tier "primary"
      BEARER_API_FAILED -> external {
        code : string
        message : string!
      }
        @description "The request was not sent or got no reply: VALIDATION_ERROR for a method outside GET, POST, PUT, PATCH, DELETE or an endpoint without a leading /, otherwise the network error message and no code."
        @synonyms "api failed, bearer request failed, request error"
        @tier "primary"
      BEARER_API_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
        host : string
      }
        @description "Internal: the request, for the HTTP client."
        @tier "secondary"
    }

    listens {
      BEARER_API_REQUEST -> input {
        method : string!
        endpoint : string!
        body : string?
      }
        @description "Send an authenticated request: the HTTP method, the endpoint path starting with /, and for POST, PUT and PATCH the JSON body text."
        @synonyms "call api, bearer request, send authenticated request"
      BEARER_API_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      BEARER_API_UNREACHABLE {
        error : string!
        kind : string!
      }
      BearerApiHttp.HTTP_REPLIED -> BEARER_API_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") }
      BearerApiHttp.HTTP_FAILED -> BEARER_API_UNREACHABLE with { error: ?error, kind: ?kind }
      BearerApiTimeout.TIMED_OUT -> BEARER_API_UNREACHABLE with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" }
    }

    config {
      origin : url = "https://api.example.com"
        @label "API origin"
        @description "The API origin (scheme://host[:port], no path) every endpoint is appended to; the default is a placeholder, and the real origin must be an https:// origin whose host the app grants in net (the bearer token is the BearerApiHttp credential)."
        @synonyms "api url, base url, api host"
        @tier "infra"
    }
  }

  page boot as BearerApiPage -> BearerApiClient, BearerApiHttp, BearerApiTimeout
}
