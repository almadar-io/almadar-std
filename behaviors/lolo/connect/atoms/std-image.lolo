app std-image [
  version: "1.0.0",
  description: "std-image — image generation over the OpenAI-compatible /images API, OpenRouter's /images and the local flux server: text-to-image and image-to-image with reference images, seed, steps, size and a transparent background. The provider, its origin, base path and default model are config knobs, never inferred; the credential is a secret knob naming the host env var (the local server has none). A request that cannot be answered, or a reply image with neither base64 data nor a url, ends in IMAGE_FAILED. A request marked `checked` on OpenRouter first reads the model's supported parameters and strips the ones it lacks (background, seed, steps, strength, references), naming them in `dropped`; on the local server the checked set is fixed. A fetch failure or a 5xx is retried twice on every provider but the local one.",
  net: { "openrouter.ai:443": [tcp], "api.openai.com:443": [tcp], "127.0.0.1:8180": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Timeout from "std/behaviors/std-timeout"
uses Delay from "std/behaviors/std-delay"
type HttpHeader = { name : string!, value : string! }
type ImageRef = { url : string! }
type ImageRequest = { prompt : string!, model : string, n : number, size : string, resolution : string, aspectRatio : string, quality : string, background : string, seed : number, steps : number, strength : number, references : [ImageRef], checked : boolean }
type ImageJob = { request : ImageRequest!, attempt : number!, delayMs : number!, dropped : [string]!, supported : [string]! }
type ImageDatum = { b64_json : string, url : string, media_type : string }
type ImageUsage = { cost : number, total_tokens : number }
type ImageErrorObject = { message : string }
type ImageReply = { data : [ImageDatum], usage : ImageUsage, error : ImageErrorObject }
type ImageEndpoint = { supported_parameters : [string] }
type ImageEndpoints = { data : [ImageEndpoint], endpoints : [ImageEndpoint] }
orbital ImageOrbital {

  entity ImageCall [runtime] {
    id : string!
  }

  trait ImageOrHttpFrame = Frame.traits.HttpFrame {
    listens {
      ImageOrHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait ImageOrHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: IMG_OR_HTTP_REPLIED
      HTTP_FAILED: IMG_OR_HTTP_FAILED
      HTTP_CANCEL: IMG_OR_HTTP_CANCEL
    }
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "OPEN_ROUTER_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      ImageClient.IMAGE_OR_SEND -> HTTP_SEND
      ImageTimeout.TIMED_OUT -> IMG_OR_HTTP_CANCEL with { key: ?key }
      ImageOrHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      ImageOrHttpFrame.FRAME_DRAINED -> HC_DRAINED
      ImageOrHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait ImageOaHttpFrame = Frame.traits.HttpFrame {
    listens {
      ImageOaHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait ImageOaHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: IMG_OA_HTTP_REPLIED
      HTTP_FAILED: IMG_OA_HTTP_FAILED
      HTTP_CANCEL: IMG_OA_HTTP_CANCEL
    }
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      ImageClient.IMAGE_OA_SEND -> HTTP_SEND
      ImageTimeout.TIMED_OUT -> IMG_OA_HTTP_CANCEL with { key: ?key }
      ImageOaHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      ImageOaHttpFrame.FRAME_DRAINED -> HC_DRAINED
      ImageOaHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait ImageLocalHttpFrame = Frame.traits.HttpFrame {
    listens {
      ImageLocalHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait ImageLocalHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: IMG_LOCAL_HTTP_REPLIED
      HTTP_FAILED: IMG_LOCAL_HTTP_FAILED
      HTTP_CANCEL: IMG_LOCAL_HTTP_CANCEL
    }
    config {
      host: "127.0.0.1"
      port: 8180
      tls: false
      serverName: "127.0.0.1"
    }
    listens {
      ImageClient.IMAGE_LOCAL_SEND -> HTTP_SEND
      ImageTimeout.TIMED_OUT -> IMG_LOCAL_HTTP_CANCEL with { key: ?key }
      ImageLocalHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      ImageLocalHttpFrame.FRAME_DRAINED -> HC_DRAINED
      ImageLocalHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait ImageTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 1800000
      cancelOnDeadline: false
    }
    listens {
      ImageClient.IMAGE_OR_SEND -> START with { key: (as ?key CallKey) }
      ImageOrHttp.IMG_OR_HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      ImageOrHttp.IMG_OR_HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
      ImageClient.IMAGE_OA_SEND -> START with { key: (as ?key CallKey) }
      ImageOaHttp.IMG_OA_HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      ImageOaHttp.IMG_OA_HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
      ImageClient.IMAGE_LOCAL_SEND -> START with { key: (as ?key CallKey) }
      ImageLocalHttp.IMG_LOCAL_HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      ImageLocalHttp.IMG_LOCAL_HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait ImageDelay = Delay.traits.Delay {
    listens {
      ImageClient.IMAGE_DELAY_START -> START with { key: ?key, delayMs: ?delayMs }
    }
  }

  trait ImageClient -> @rebindable ImageCall   [optimistic]{
    initial: idle

    state idle {
      INIT -> idle

      IMAGE_GENERATE -> idle
        (emit IMAGE_PREPARE {
          job: (json/stringify {
            request: {
              prompt: @payload.prompt,
              model: (if (!= (default @payload.model "") "") (default @payload.model "") @config.model),
              n: @payload.n, size: @payload.size, resolution: @payload.resolution, aspectRatio: @payload.aspectRatio,
              quality: @payload.quality, background: @payload.background, seed: @payload.seed, steps: @payload.steps,
              strength: @payload.strength,
              references: (if (> (array/len (object/get @payload references [])) 0) @payload.references null),
              checked: (= @payload.checked true)
            },
            attempt: 0, delayMs: 0, dropped: [], supported: []
          })
        })

      IMAGE_PREPARE -> idle when (and (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) size null) null)
          (or (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) resolution null) null) (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) aspectRatio null) null)))
        (emit IMAGE_FAILED { code: "VALIDATION_ERROR", message: "ImageClient.generate: `size` cannot be combined with `resolution`/`aspectRatio` — pass one or the other" })
      IMAGE_PREPARE -> idle when (and (= @config.provider "openrouter") (= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) checked false) true)
          (not (and (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) size null) null)
            (or (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) resolution null) null) (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) aspectRatio null) null)))))
        (emit IMAGE_OR_SEND {
            key: (str/concat "caps:" @payload.job),
            method: "GET",
            target: (str/concat @config.basePath "/images/models/" (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) model "") "/endpoints"),
            headers: [{ name: "accept", value: "application/json" }],
            body: (bytes/from-string ""),
            stream: "none"
          })
      IMAGE_PREPARE -> idle when (and (not (and (= @config.provider "openrouter") (= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) checked false) true)))
          (not (and (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) size null) null)
            (or (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) resolution null) null) (!= (object/get (object/get (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) aspectRatio null) null)))))
        (emit IMAGE_SEND {
          job: (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
            (json/stringify {
              request: @j.request, attempt: 0, delayMs: 0, dropped: [],
              supported: (if (= @config.provider "local") ["seed", "steps", "image_strength", "input_references"] ["background", "seed", "steps", "image_strength", "input_references"])
            }))
        })

      IMAGE_CAPS_HTTP_FAILED -> idle
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " capabilities request failed: " @payload.error) })
      IMAGE_CAPS_HTTP_OK -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " returned " @payload.status ": " @payload.body) })
      IMAGE_CAPS_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((ep (json/parse @payload.body ImageEndpoints)))
          (if (= @ep null)
            (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " returned a capabilities body that is not an endpoint list") })
            (emit IMAGE_SEND {
              job: (let ((j (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
                (json/stringify {
                  request: @j.request, attempt: 0, delayMs: 0, dropped: [],
                  supported: (array/flatten (array/map (array/concat (object/get @ep data []) (object/get @ep endpoints [])) (fn (e) (object/get @e supported_parameters []))))
                }))
            })))

      IMAGE_SEND -> idle
        (emit IMAGE_STRIPPED {
          job: (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
            (let ((r @j.request) (names { background: "background", seed: "seed", steps: "steps", strength: "image_strength", references: "input_references" }))
              (let ((gone (if (object/get @r checked false)
                    (array/filter ["background", "seed", "steps", "strength", "references"] (fn (k) (and (!= (object/get @r @k null) null) (not (array/includes @j.supported (object/get @names @k ""))))))
                    [])))
                (json/stringify {
                  request: (object/filter @r (fn (k v) (not (array/includes @gone @k)))),
                  attempt: @j.attempt, delayMs: @j.delayMs, supported: @j.supported,
                  dropped: (array/map @gone (fn (k) (object/get @names @k "")))
                }))))
        })

      IMAGE_STRIPPED -> idle
        (emit IMAGE_DISPATCH {
          job: (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
            (let ((r @j.request))
              (let ((gone (match @config.provider
                    ("local" (array/filter ["resolution", "aspectRatio", "quality", "background"] (fn (k) (!= (object/get @r @k null) null))))
                    ("openai" (array/filter ["resolution", "aspectRatio", "seed", "steps", "strength", "references"] (fn (k) (!= (object/get @r @k null) null))))
                    (_ []))))
                (json/stringify {
                  request: (object/filter @r (fn (k v) (not (array/includes @gone @k)))),
                  attempt: @j.attempt, delayMs: @j.delayMs, supported: @j.supported,
                  dropped: (array/concat @j.dropped @gone)
                }))))
        })

      IMAGE_DISPATCH -> idle when (= @config.provider "openrouter")
        (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
          (emit IMAGE_OR_SEND {
            key: (str/concat "gen:" @payload.job),
            method: "POST",
            target: (str/concat @config.basePath "/images"),
            headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
            body: (bytes/from-string (json/stringify (let ((r @j.request))
              (object/omit {
                model: @r.model, prompt: @r.prompt, output_format: "png",
                n: (object/get @r n null),
                size: (object/get @r size null),
                resolution: (object/get @r resolution null),
                aspect_ratio: (object/get @r aspectRatio null),
                quality: (object/get @r quality null),
                background: (object/get @r background null),
                seed: (object/get @r seed null),
                steps: (object/get @r steps null),
                input_references: (if (!= (object/get @r references null) null) (array/map (object/get @r references []) (fn (ref) { type: "image_url", image_url: { url: @ref.url } })) null)
              } (array/concat (if (= (object/get @r n null) null) ["n"] []) (if (= (object/get @r size null) null) ["size"] []) (if (= (object/get @r resolution null) null) ["resolution"] []) (if (= (object/get @r aspectRatio null) null) ["aspect_ratio"] []) (if (= (object/get @r quality null) null) ["quality"] []) (if (= (object/get @r background null) null) ["background"] []) (if (= (object/get @r seed null) null) ["seed"] []) (if (= (object/get @r steps null) null) ["steps"] []) (if (= (object/get @r references null) null) ["input_references"] [])))))),
            stream: "none"
          }))
      IMAGE_DISPATCH -> idle when (= @config.provider "openai")
        (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
          (emit IMAGE_OA_SEND {
            key: (str/concat "gen:" @payload.job),
            method: "POST",
            target: (str/concat @config.basePath "/images/generations"),
            headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
            body: (bytes/from-string (json/stringify (let ((r @j.request))
              (object/omit {
                model: @r.model, prompt: @r.prompt, output_format: "png",
                n: (object/get @r n null),
                size: (object/get @r size null),
                quality: (object/get @r quality null),
                background: (object/get @r background null)
              } (array/concat (if (= (object/get @r n null) null) ["n"] []) (if (= (object/get @r size null) null) ["size"] []) (if (= (object/get @r quality null) null) ["quality"] []) (if (= (object/get @r background null) null) ["background"] [])))))),
            stream: "none"
          }))
      IMAGE_DISPATCH -> idle when (= @config.provider "local")
        (let ((j (default (json/parse @payload.job ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
          (emit IMAGE_LOCAL_SEND {
            key: (str/concat "gen:" @payload.job),
            method: "POST",
            target: (str/concat @config.basePath "/images/generations"),
            headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
            body: (bytes/from-string (json/stringify (let ((r @j.request))
              (object/omit {
                model: @r.model, prompt: @r.prompt,
                n: (object/get @r n null),
                size: (object/get @r size null),
                seed: (object/get @r seed null),
                steps: (object/get @r steps null),
                image_strength: (object/get @r strength null),
                input_references: (if (!= (object/get @r references null) null) (array/map (object/get @r references []) (fn (ref) { type: "image_url", image_url: { url: @ref.url } })) null)
              } (array/concat (if (= (object/get @r n null) null) ["n"] []) (if (= (object/get @r size null) null) ["size"] []) (if (= (object/get @r seed null) null) ["seed"] []) (if (= (object/get @r steps null) null) ["steps"] []) (if (= (object/get @r strength null) null) ["image_strength"] []) (if (= (object/get @r references null) null) ["input_references"] [])))))),
            stream: "none"
          }))

      IMAGE_DELAY_ELAPSED -> idle
        (emit IMAGE_DISPATCH { job: @payload.key })

      IMAGE_HTTP_FAILED -> idle when (and (!= @config.provider "local") (< (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0) 2))
        (emit IMAGE_DELAY_START {
          key: (let ((j (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
            (json/stringify { request: @j.request, attempt: (+ @j.attempt 1), delayMs: (if (>= @j.attempt 0) (array/nth [500, 2000] @j.attempt) null), supported: @j.supported, dropped: @j.dropped })),
          delayMs: (default (let ((nxi (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0))) (if (>= @nxi 0) (array/nth [500, 2000] @nxi) null)) 2000)
        })
      IMAGE_HTTP_FAILED -> idle when (or (= @config.provider "local") (>= (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0) 2))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " request failed: " @payload.error) })

      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 500) (!= @config.provider "local") (< (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0) 2))
        (emit IMAGE_DELAY_START {
          key: (let ((j (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] })))
            (json/stringify { request: @j.request, attempt: (+ @j.attempt 1), delayMs: (if (>= @j.attempt 0) (array/nth [500, 2000] @j.attempt) null), supported: @j.supported, dropped: @j.dropped })),
          delayMs: (default (let ((nxi (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0))) (if (>= @nxi 0) (array/nth [500, 2000] @nxi) null)) 2000)
        })
      IMAGE_HTTP_OK -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (not (and (>= @payload.status 500) (!= @config.provider "local") (< (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) attempt 0) 2))))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " returned " @payload.status ": " @payload.body) })
      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= (json/parse @payload.body ImageReply) null))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " returned unparseable body: " @payload.body) })
      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ImageReply) null)
          (!= (object/get (object/get (json/parse @payload.body ImageReply) error {}) message "") ""))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " returned an error: " (object/get (object/get (json/parse @payload.body ImageReply) error {}) message "")) })
      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ImageReply) null)
          (= (object/get (object/get (json/parse @payload.body ImageReply) error {}) message "") "")
          (= (object/get (json/parse @payload.body ImageReply) data null) null))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " response has no `data` array: " @payload.body) })
      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ImageReply) null)
          (= (object/get (object/get (json/parse @payload.body ImageReply) error {}) message "") "")
          (!= (object/get (json/parse @payload.body ImageReply) data null) null)
          (> (array/count (object/get (json/parse @payload.body ImageReply) data []) (fn (d) (and (not (validate/required @d.b64_json)) (not (validate/required @d.url))))) 0))
        (emit IMAGE_FAILED { code: "SERVICE_ERROR", message: (str/concat "ImageClient: " @config.provider " response data has neither `b64_json` nor `url`: " @payload.body) })
      IMAGE_HTTP_OK -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body ImageReply) null)
          (= (object/get (object/get (json/parse @payload.body ImageReply) error {}) message "") "")
          (!= (object/get (json/parse @payload.body ImageReply) data null) null)
          (= (array/count (object/get (json/parse @payload.body ImageReply) data []) (fn (d) (and (not (validate/required @d.b64_json)) (not (validate/required @d.url))))) 0))
        (emit IMAGE_GENERATED {
          images: (array/map (object/get (json/parse @payload.body ImageReply) data []) (fn (d) { data: (if (validate/required @d.b64_json) @d.b64_json null), url: (if (validate/required @d.b64_json) null @d.url), mimeType: (default (object/get @d media_type "") "image/png") })),
          model: (object/get (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) request) model ""),
          cost: (object/get (object/get (json/parse @payload.body ImageReply) usage {}) cost 0),
          totalTokens: (object/get (object/get (json/parse @payload.body ImageReply) usage {}) total_tokens 0),
          dropped: (object/get (default (json/parse @payload.key ImageJob) { request: { prompt: "" }, attempt: 0, delayMs: 0, dropped: [], supported: [] }) dropped [])
        })
    }

    emits {
      IMAGE_GENERATED -> external {
        images : [{ data : string?, url : string?, mimeType : string! }]!
        model : string!
        cost : number!
        totalTokens : number!
        dropped : [string]!
      }
        @description "The generated images, each carrying either base64 `data` or a `url` (whichever the provider returned) with its mime type, the model that made them, the reported cost and tokens (zero when the provider reports none), and the request fields stripped before sending."
        @synonyms "generated pictures, rendered images, image result"
        @tier "primary"
      IMAGE_FAILED -> external {
        code : string
        message : string!
      }
        @description "The request could not be answered: invalid parameters, a transport failure, a provider error status or an unreadable reply."
        @synonyms "image error, generation failed"
        @tier "primary"
      IMAGE_OR_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: the OpenRouter request, for its HTTP client."
        @tier "secondary"
      IMAGE_OA_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: the OpenAI request, for its HTTP client."
        @tier "secondary"
      IMAGE_LOCAL_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: the local server request, for its HTTP client."
        @tier "secondary"
      IMAGE_DELAY_START {
        key : string!
        delayMs : number!
      }
        @description "Internal: wait before the next attempt; the key is the job."
        @tier "secondary"
      IMAGE_PREPARE {
        job : string!
      }
        @description "Internal: a normalised request before its capabilities are known."
        @tier "secondary"
      IMAGE_SEND {
        job : string!
      }
        @description "Internal: a request with the parameters its model supports."
        @tier "secondary"
      IMAGE_STRIPPED {
        job : string!
      }
        @description "Internal: a request with the unsupported checked parameters removed."
        @tier "secondary"
      IMAGE_DISPATCH {
        job : string!
      }
        @description "Internal: one attempt to send the request."
        @tier "secondary"
    }

    listens {
      IMAGE_GENERATE -> input {
        prompt : string!
        model : string?
        n : number?
        size : string?
        resolution : string?
        aspectRatio : string?
        quality : string?
        background : string?
        seed : number?
        steps : number?
        strength : number?
        references : [{ url : string! }]?
        checked : boolean?
      }
        @description "Generate images from a prompt, optionally conditioned on reference images (https or data URLs). `size` is WIDTHxHEIGHT and cannot be combined with `resolution` or `aspectRatio`; `background` is auto, transparent or opaque; `strength` is the img2img denoise strength 0 to 1 on the local server. `checked` reads the model's supported parameters first (OpenRouter) and strips what it lacks."
        @synonyms "text to image, draw, render image, image to image"
      IMAGE_CAPS_HTTP_OK { status : number!  headers : Map string string  body : string!  key : string! }
      IMAGE_CAPS_HTTP_FAILED { error : string!  kind : string!  key : string! }
      IMAGE_HTTP_OK { status : number!  headers : Map string string  body : string!  key : string! }
      IMAGE_HTTP_FAILED { error : string!  kind : string!  key : string! }
      IMAGE_DELAY_ELAPSED { key : string!  waitedMs : number! }
      ImageOrHttp.IMG_OR_HTTP_REPLIED -> IMAGE_HTTP_OK with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) ""), key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageOrHttp.IMG_OR_HTTP_FAILED -> IMAGE_HTTP_FAILED with { error: ?error, kind: ?kind, key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageOaHttp.IMG_OA_HTTP_REPLIED -> IMAGE_HTTP_OK with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) ""), key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageOaHttp.IMG_OA_HTTP_FAILED -> IMAGE_HTTP_FAILED with { error: ?error, kind: ?kind, key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageLocalHttp.IMG_LOCAL_HTTP_REPLIED -> IMAGE_HTTP_OK with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) ""), key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageLocalHttp.IMG_LOCAL_HTTP_FAILED -> IMAGE_HTTP_FAILED with { error: ?error, kind: ?kind, key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageOrHttp.IMG_OR_HTTP_REPLIED -> IMAGE_CAPS_HTTP_OK with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) ""), key: (str/slice ?key 5 (str/len ?key)) } when (str/startsWith ?key "caps:")
      ImageOrHttp.IMG_OR_HTTP_FAILED -> IMAGE_CAPS_HTTP_FAILED with { error: ?error, kind: ?kind, key: (str/slice ?key 5 (str/len ?key)) } when (str/startsWith ?key "caps:")
      ImageTimeout.TIMED_OUT -> IMAGE_HTTP_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout", key: (str/slice ?key 4 (str/len ?key)) } when (str/startsWith ?key "gen:")
      ImageTimeout.TIMED_OUT -> IMAGE_CAPS_HTTP_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout", key: (str/slice ?key 5 (str/len ?key)) } when (str/startsWith ?key "caps:")
      ImageDelay.ELAPSED -> IMAGE_DELAY_ELAPSED with { key: ?key, waitedMs: ?waitedMs }
    }

    config {
      provider : "openrouter" | "openai" | "local" = openrouter
        @label "Image provider"
        @description "The image API: openrouter (POST /images), openai (POST /images/generations) or local (the unauthenticated flux server, POST /images/generations). The provider picks which of the ImageOrHttp, ImageOaHttp and ImageLocalHttp clients the request goes through; their hosts, ports and credentials are those traits' config."
        @synonyms "image vendor"
        @tier "infra"
      basePath : string = "/api/v1"
        @label "Image base path"
        @description "The path before /images, for example /api/v1 (OpenRouter) or /v1 (OpenAI and the local server)."
        @synonyms "api prefix, version path"
        @tier "infra"
      model : string = "bytedance-seed/seedream-5-0-lite"
        @label "Default image model"
        @description "The model used when a request names none."
        @synonyms "default model, model id"
        @tier "infra"
    }
  }

  page boot as ImagePage -> ImageClient, ImageOrHttp, ImageOrHttpFrame, ImageOaHttp, ImageOaHttpFrame, ImageLocalHttp, ImageLocalHttpFrame, ImageTimeout, ImageDelay
}
