app std-calendar-sync [
  version: "1.0.0",
  description: "std-calendar-sync — two-way Google Calendar synchronization engine. PUSH: a 15-minute cron scan (and the user-addressable SYNC_NOW) walks `targetEntity` rows whose `externalEventId` marker is blank and creates a remote event per row through calendar.createEvent, reading the summary/start/end via the configured field mapping (`titleField`/`startField`/`endField`/`durationMinutes` fallback/`locationField`/`descriptionField`) — so ANY event-shaped host entity pushes, provided it declares the two marker columns `externalEventId : string` and `syncedAt : instant?` (the remindedAt precedent). PULL: `CAL_REMOTE_CHANGED` (emitted by the google-calendar inbound hook, /api/hooks/google-calendar, for a calendar.watch channel) or the same cycle after a clean push lists remote events (incremental via the in-memory sync token; a restart falls back to a full window list) and upserts each into the atom's own canonical `CalendarEvent` store, matched by `externalEventId` — pulls land in the canonical store, NOT the arbitrary target, because persist keys are static in the language; bind calendar UI to `CalendarEvent` to surface remote events. Conflict detection (local-newer-than-remote) needs a local-modified marker convention and is a recorded gap, not a decorative state. Composes with std-notify-on-event via CAL_SYNCED / CAL_SYNC_FAILED.",
  egress: ["https://www.googleapis.com"],
  inbound: ["google-calendar"]
]
type RemoteEvent = { id : string, summary : string, description : string, location : string, start : string, end : string, status : string, updated : string }
type TargetRow = { id : string, externalEventId : string }
orbital CalendarSyncOrbital {
  uses CalendarApi from "std/behaviors/std-google-calendar"

    type CAL_REMOTE_CHANGED = Event { channelId : string, resourceId : string, resourceState : string } "Google watch-channel push notification, delivered by the google-calendar inbound hook (/api/hooks/google-calendar)."

  entity CalendarSyncRun [persistent: calendarSyncState] {
    id : string!
    syncToken : string @intrinsic @description "Scratch: Google incremental-sync token from the last listEvents; in-memory per instance — a restart falls back to a full list." @synonyms "sync cursor, next token" = ""
    lastSyncedAt : instant? @intrinsic @description "When the last full push+pull cycle completed; null = never." @synonyms "last sync time"
    headId : string @intrinsic @description "Scratch: id of the target row the push loop is currently exporting." @synonyms "cursor, current row" = ""
    pending : [RemoteEvent] @intrinsic @description "Scratch: remote events remaining in the current pull-upsert loop." @synonyms "pull queue, remaining events" = []
    lastError : string @intrinsic @description "Last sync failure detail; blank = none." @synonyms "sync error, failure" = ""
  }

  entity CalendarEvent [persistent: calendarEvents] {
    id : string!
    title : string @description "Event title/summary." @synonyms "summary, name, subject" = ""
    startsAt : string @description "ISO start (dateTime, or YYYY-MM-DD for all-day)." @synonyms "start, begins, from" = ""
    endsAt : string @description "ISO end (dateTime, or YYYY-MM-DD for all-day)." @synonyms "end, finishes, until" = ""
    location : string @description "Event location." @synonyms "place, where, venue" = ""
    description : string @description "Event description/notes." @synonyms "notes, details, body" = ""
    status : string @description "Remote status (confirmed/tentative/cancelled)." @synonyms "state, confirmation" = ""
    externalEventId : string @description "Google Calendar event id this row mirrors; the pull-upsert match key." @synonyms "remote id, google id, calendar event id" = ""
    syncedAt : instant? @description "When this row last synced with the remote calendar; null = never." @synonyms "last sync, synced"
  }

  trait CalendarSyncApi = CalendarApi.traits.CalendarClient {
    listens {
      CalendarSync.CALENDAR_LIST_EVENTS -> CALENDAR_LIST_EVENTS
      CalendarSync.CALENDAR_CREATE_EVENT -> CALENDAR_CREATE_EVENT
      CALENDAR_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      CALENDAR_REQUEST_FAILED {
        error : string!
        kind : string!
        key : string!
        phase : string
        grantStatus : number
        grantBody : string
      }
    }
  }

  trait CalendarSyncInbound = CalendarApi.traits.CalendarPushInbound {
  }

  trait CalendarSync -> CalendarSyncRun {
    initial: idle

    state idle {
      INIT -> idle
      SYNC_NOW -> idle when @config.enabled
        (fetch @config.targetEntity {
          emit: { failure: CAL_SYNC_FAILED, success: PUSH_ROWS_LOADED }
          filter: (= (object/get @entity externalEventId) "")
          limit: 1
        })
      CAL_REMOTE_CHANGED -> idle when @config.enabled
        (emit CALENDAR_LIST_EVENTS {
          calendarId: @config.calendarId
          syncToken: @entity.syncToken
        })
      PUSH_ROWS_LOADED -> pushing when (and @config.enabled (> (array/len ?data) 0))
        (let ((row (array/first ?data)))
          (if (= @row null)
            (emit CAL_SYNC_FAILED { error: "the push loop found no row to export" })
            (if (or (= (object/get @row @config.titleField "") "") (= (object/get @row @config.startField) null))
              (emit CAL_SYNC_FAILED { error: (str/concat "Row " (object/get @row id "") " has no value in its title or start field, so it cannot be exported as a calendar event") })
              (do
                (set @entity.headId (object/get @row id ""))
                (emit CALENDAR_CREATE_EVENT {
                  calendarId: @config.calendarId
                  summary: (object/get @row @config.titleField "")
                  description: (if (= @config.descriptionField "") "" (object/get @row @config.descriptionField ""))
                  location: (if (= @config.locationField "") "" (object/get @row @config.locationField ""))
                  start: (str/concat (object/get @row @config.startField))
                  end: (if (= @config.endField "") "" (let ((e (object/get @row @config.endField))) (if (= @e null) "" (str/concat @e))))
                  durationMinutes: (if (= @config.durationField "") @config.durationMinutes (object/get @row @config.durationField @config.durationMinutes))
                })))))
      PUSH_ROWS_LOADED -> idle when (= (array/len ?data) 0)
        (emit CALENDAR_LIST_EVENTS {
          calendarId: @config.calendarId
          syncToken: @entity.syncToken
        })
      CAL_REMOTE_LISTED -> pulling when (> (array/len ?events) 0)
        (set @entity.pending ?events)
        (set @entity.syncToken (default ?nextSyncToken ""))
        (fetch CalendarEvent {
          emit: { failure: CAL_SYNC_FAILED, success: PULL_TARGET_LOADED }
          filter: (= (object/get @entity externalEventId) (object/get (array/first ?events) id))
          limit: @config.maxRows
        })
      CAL_REMOTE_LISTED -> idle when (= (array/len ?events) 0)
        (set @entity.syncToken (default ?nextSyncToken ""))
        (set @entity.lastSyncedAt @now)
        (emit CAL_SYNCED { syncedAt: @now })
      CAL_SYNC_FAILED -> idle
        (set @entity.lastError ?error)
        (notify error (str/concat "Couldn't sync the calendar — " ?error))
      CAL_CALENDAR_FAILED -> idle
        (set @entity.lastError ?message)
        (notify error (str/concat "Couldn't sync the calendar — " ?message))
    }

    state pushing {
      INIT -> pushing
      CAL_EVENT_CREATED -> pushing
        (persist update @config.targetEntity { id: @entity.headId, externalEventId: ?id, syncedAt: @now } {
          emit: { failure: CAL_SYNC_FAILED, success: PUSH_STEPPED }
        })
      PUSH_STEPPED -> pushing
        (fetch @config.targetEntity {
          emit: { failure: CAL_SYNC_FAILED, success: PUSH_ROWS_LOADED }
          filter: (= (object/get @entity externalEventId) "")
          limit: 1
        })
      PUSH_ROWS_LOADED -> pushing when (> (array/len ?data) 0)
        (let ((row (array/first ?data)))
          (if (= @row null)
            (emit CAL_SYNC_FAILED { error: "the push loop found no row to export" })
            (if (or (= (object/get @row @config.titleField "") "") (= (object/get @row @config.startField) null))
              (emit CAL_SYNC_FAILED { error: (str/concat "Row " (object/get @row id "") " has no value in its title or start field, so it cannot be exported as a calendar event") })
              (do
                (set @entity.headId (object/get @row id ""))
                (emit CALENDAR_CREATE_EVENT {
                  calendarId: @config.calendarId
                  summary: (object/get @row @config.titleField "")
                  description: (if (= @config.descriptionField "") "" (object/get @row @config.descriptionField ""))
                  location: (if (= @config.locationField "") "" (object/get @row @config.locationField ""))
                  start: (str/concat (object/get @row @config.startField))
                  end: (if (= @config.endField "") "" (let ((e (object/get @row @config.endField))) (if (= @e null) "" (str/concat @e))))
                  durationMinutes: (if (= @config.durationField "") @config.durationMinutes (object/get @row @config.durationField @config.durationMinutes))
                })))))
      PUSH_ROWS_LOADED -> idle when (= (array/len ?data) 0)
        (emit CALENDAR_LIST_EVENTS {
          calendarId: @config.calendarId
          syncToken: @entity.syncToken
        })
      CAL_SYNC_FAILED -> idle
        (set @entity.lastError ?error)
        (notify error (str/concat "Couldn't sync the calendar — " ?error))
      CAL_CALENDAR_FAILED -> idle
        (set @entity.lastError ?message)
        (notify error (str/concat "Couldn't sync the calendar — " ?message))
    }

    state pulling {
      INIT -> idle
      PULL_TARGET_LOADED -> pulling when (> ?totalCount (array/len ?data))
        (emit CAL_SYNC_FAILED { error: (str/concat "CalendarEvent has " ?totalCount " rows for one remote event id, over the maxRows cap of " @config.maxRows) })
      PULL_TARGET_LOADED -> pulling
        (let ((head (array/first @entity.pending)))
          (if (= @head null)
            (emit CAL_SYNC_FAILED { error: "the pull loop has no remote event left to upsert" })
            (let ((hid (object/get @head id "")))
              (do
                (set @entity.headId @hid)
                (let ((existing (array/first (array/filter ?data (fn r (= (object/get @r externalEventId) @hid))))))
                  (if (= @existing null)
                    (persist create CalendarEvent {
                    title: (object/get @head summary "")
                    startsAt: (object/get @head start "")
                    endsAt: (object/get @head end "")
                    location: (object/get @head location "")
                    description: (object/get @head description "")
                    status: (object/get @head status "")
                    externalEventId: @hid
                    syncedAt: @now
                  } { emit: { failure: CAL_SYNC_FAILED, success: PULL_STEPPED } })
                    (persist update CalendarEvent {
                    id: (object/get @existing id "")
                    title: (object/get @head summary "")
                    startsAt: (object/get @head start "")
                    endsAt: (object/get @head end "")
                    location: (object/get @head location "")
                    description: (object/get @head description "")
                    status: (object/get @head status "")
                    syncedAt: @now
                  } { emit: { failure: CAL_SYNC_FAILED, success: PULL_STEPPED } })))))))
      PULL_STEPPED -> pulling
        (set @entity.pending (array/drop @entity.pending 1))
        (emit PULL_NEXT {
          remaining: (array/len @entity.pending)
        })
      PULL_NEXT -> pulling when (> ?remaining 0)
        (let ((head (array/first @entity.pending)))
          (if (= @head null)
            (emit CAL_SYNC_FAILED { error: "the pull loop has no remote event left to look up" })
            (fetch CalendarEvent {
              emit: { failure: CAL_SYNC_FAILED, success: PULL_TARGET_LOADED }
              filter: (= (object/get @entity externalEventId) (object/get @head id ""))
              limit: @config.maxRows
            })))
      PULL_NEXT -> idle when (= ?remaining 0)
        (set @entity.lastSyncedAt @now)
        (emit CAL_SYNCED { syncedAt: @now })
      CAL_SYNC_FAILED -> idle
        (set @entity.lastError ?error)
        (notify error (str/concat "Couldn't sync the calendar — " ?error))
      CAL_CALENDAR_FAILED -> idle
        (set @entity.lastError ?message)
        (notify error (str/concat "Couldn't sync the calendar — " ?message))
    }

    emits {
      CALENDAR_LIST_EVENTS -> external {
        calendarId : string
        syncToken : string
      }
        @description "Ask the Google Calendar client to list remote events (incrementally when syncToken is set)."
        @tier "internal"
      CALENDAR_CREATE_EVENT -> external {
        calendarId : string
        summary : string!
        description : string
        location : string
        start : string!
        end : string
        durationMinutes : number
      }
        @description "Ask the Google Calendar client to create a remote event for the row being pushed."
        @tier "internal"
      CAL_SYNCED -> external {
        syncedAt : instant!
      }
        @description "A full push+pull cycle completed; wire to std-notify-on-event or a status surface."
      CAL_SYNC_FAILED {
        error : string!
      }
        @description "A calendar service call / fetch / persist failed — lastError carries the detail and the cycle stops until the next trigger."
        @tier "secondary"
      PUSH_ROWS_LOADED {
        data : [@entity @config.targetEntity]!
      }
        @description "The next target row with a blank externalEventId marker, read one at a time; the push loop stamps it and reads the next, so the export queue drains without ever loading it whole."
        @tier "secondary"
      PUSH_STEPPED {
        id : string!
      }
        @description "Target row stamped with its new externalEventId; drives the next push pass."
        @tier "secondary"
      PULL_TARGET_LOADED {
        data : [TargetRow]!
        totalCount : number!
      }
        @description "CalendarEvent rows loaded for externalEventId matching in the pull-upsert."
        @tier "secondary"
      PULL_STEPPED {
        id : string!
      }
        @description "One remote event upserted into the CalendarEvent store; drives the next pull pass."
        @tier "secondary"
      PULL_NEXT {
        remaining : number!
      }
        @description "Pull loop control: how many remote events remain in the queue."
        @tier "secondary"
    }

    listens {
      CalendarSyncApi.CALENDAR_EVENTS_LISTED -> CAL_REMOTE_LISTED
      CalendarSyncApi.CALENDAR_EVENT_CREATED -> CAL_EVENT_CREATED
      CalendarSyncApi.CALENDAR_LIST_EVENTS_FAILED -> CAL_CALENDAR_FAILED
      CalendarSyncApi.CALENDAR_CREATE_EVENT_FAILED -> CAL_CALENDAR_FAILED
      CalendarSyncInbound.CAL_REMOTE_CHANGED -> CAL_REMOTE_CHANGED
      CAL_CALENDAR_FAILED {
        code : string
        message : string!
      }
      SYNC_NOW {
      }
      CAL_REMOTE_CHANGED {
        channelId : string
        resourceId : string
        resourceState : string
      }
      PUSH_ROWS_LOADED {
        data : [@entity @config.targetEntity]!
      }
      CAL_EVENT_CREATED {
        id : string!
        status : string!
        htmlLink : string!
      }
      PUSH_STEPPED {
        id : string!
      }
      CAL_REMOTE_LISTED {
        events : [RemoteEvent]!
        nextSyncToken : string?
      }
      PULL_TARGET_LOADED {
        data : [TargetRow]!
        totalCount : number!
      }
      PULL_STEPPED {
        id : string!
      }
      PULL_NEXT {
        remaining : number!
      }
    }

    ticks {
      syncCycle every "*/15 * * * *" [background]
        (fetch @config.targetEntity {
          emit: { failure: CAL_SYNC_FAILED, success: PUSH_ROWS_LOADED }
          filter: (= (object/get @entity externalEventId) "")
          limit: 1
        })

    }

    config {
      maxRows : number = 50
        @label "Rows matched per remote event"
        @description "Most CalendarEvent rows one pull-upsert lookup may read for a single remote event id. A remote id matches at most one mirrored row, so 50 is generous; a lookup matching more is refused through CAL_SYNC_FAILED rather than upserting against a partial set."
        @synonyms "match limit, lookup cap"
        @tier "infra"
      enabled : boolean = false
        @label "Sync with Google Calendar"
        @description "Push local records to Google Calendar and pull remote events into the CalendarEvent store. Off by default; needs the calendar service credentials (GOOGLE_CALENDAR_SA_KEY)."
        @synonyms "enable, calendar sync, google calendar, two-way sync, sync events, connect calendar"
        @tier "infra"
      targetEntity : entity = CalendarEvent
        @label "Entity to push"
        @description "Event-shaped entity whose rows export to Google Calendar. MUST declare the marker columns `externalEventId : string = \"\"` and `syncedAt : instant?` (stamped by the push loop). Defaults to the atom's own CalendarEvent store so the standalone validates; rebind per composition."
        @synonyms "entity to sync, source entity, record type, appointments entity, sessions entity"
        @tier "internal"
      calendarId : string = ""
        @label "Calendar id"
        @description "Google calendar to sync with; blank = the service's default (GOOGLE_CALENDAR_ID env, else primary)."
        @synonyms "google calendar id, target calendar"
        @tier "infra"
      titleField : string = title
        @label "Title field"
        @description "Target-entity field holding the event title."
        @synonyms "summary field, name field"
        @tier "internal"
      startField : string = startsAt
        @label "Start field"
        @description "Target-entity field holding the ISO start (dateTime, or YYYY-MM-DD for all-day)."
        @synonyms "start date field, begins field, scheduledAt field"
        @tier "internal"
      endField : string = endsAt
        @label "End field"
        @description "Target-entity field holding the ISO end. Blank = derive the end from `durationMinutes` instead (the corpus carries all four event shapes)."
        @synonyms "end date field, finishes field"
        @tier "internal"
      durationMinutes : number = 60
        @label "Duration (minutes)"
        @description "Fixed event length used when both `endField` and `durationField` are blank; the calendar service computes the timezone-correct end."
        @synonyms "length, event duration, minutes"
        @tier "internal"
      durationField : string = ""
        @label "Duration field"
        @description "Target-entity field holding the per-row duration in minutes (e.g. ClassSession.durationMinutes). Takes precedence over the fixed `durationMinutes` when set; ignored when `endField` is set. Field precedence: endField > durationField > durationMinutes — the corpus carries all these event shapes."
        @synonyms "minutes field, length field, per-row duration"
        @tier "internal"
      locationField : string = ""
        @label "Location field"
        @description "Target-entity field holding the location; blank = none."
        @synonyms "place field, venue field"
        @tier "internal"
      descriptionField : string = ""
        @label "Description field"
        @description "Target-entity field holding the description/notes; blank = none."
        @synonyms "notes field, details field"
        @tier "internal"
    }
  }

  page "/calendar-sync" as CalendarSyncPage -> CalendarSync, CalendarSyncApi, CalendarSyncInbound
}
