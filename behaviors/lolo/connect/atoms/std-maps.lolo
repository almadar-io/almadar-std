app std-maps [
  version: "1.0.0",
  description: "std-maps — geocoding, reverse geocoding and great-circle distance through the keyless OpenStreetMap Nominatim API (nominatim.openstreetmap.org). GEOCODE answers GEOCODED with lat, lng and formattedAddress; REVERSE_GEOCODE answers REVERSE_GEOCODED with address and formattedAddress; DISTANCE answers DISTANCE_COMPUTED with the haversine distanceKm and makes no network call. A blank query, an empty result, a non-2xx reply or a transport failure answers MAPS_FAILURE with error and code. Nominatim's usage policy allows one request per second and requires an identifying User-Agent.",
  egress: ["https://nominatim.openstreetmap.org"]
]
uses Fetch from "std/behaviors/std-http-fetch"
type HttpHeader = { name : string!, value : string! }
type NominatimPlace = { lat : string, lon : string, display_name : string }
type NominatimPlaces = [NominatimPlace]
type NominatimReverse = { lat : string, lon : string, display_name : string, error : string }
orbital MapsOrbital {
  entity MapsLookup [runtime] {
    id : string!
  }

  trait MapsFetch = Fetch.traits.HttpFetch {
    config {
      origin: "https://nominatim.openstreetmap.org"
      timeoutMs: 6000
    }
    listens {
      MapsClient.MAPS_HTTP_SEND -> HTTP_SEND
    }
  }

  trait MapsClient -> MapsLookup [client] {
    initial: idle

    state idle {
      INIT -> idle

      GEOCODE -> idle when (!= (str/trim @payload.address) "")
        (emit MAPS_HTTP_SEND { key: "geocode", method: "GET", target: (str/concat "/search?format=json&limit=1&q=" (str/encode-uri-component (str/trim @payload.address))), headers: [{ name: "Accept", value: "application/json" }, { name: "User-Agent", value: @config.userAgent }], body: (bytes/from-string ""), stream: "none" })
      GEOCODE -> idle when (= (str/trim @payload.address) "")
        (emit MAPS_FAILURE { error: "address is blank", code: "invalid_input" })
      MAPS_REPLIED -> idle when (and (= @payload.key "geocode") (or (< @payload.status 200) (>= @payload.status 300)))
        (emit MAPS_FAILURE { error: (str/concat "Nominatim answered HTTP " @payload.status), code: "http_error" })
      MAPS_REPLIED -> idle when (and (= @payload.key "geocode") (>= @payload.status 200) (< @payload.status 300))
        (let ((places (json/parse (default (bytes/to-string @payload.body) "") NominatimPlaces)))
          (if (= @places null)
            (emit MAPS_FAILURE { error: "Nominatim answered a body that is not a list of places", code: "http_error" })
            (let ((place (array/first @places)))
              (if (= @place null)
                (emit MAPS_FAILURE { error: "no place matches the address", code: "not_found" })
                (let ((lat (str/to-number (object/get @place lat "0"))) (lng (str/to-number (object/get @place lon "0")))) (if (or (= @lat null) (= @lng null)) (emit MAPS_FAILURE { error: "Nominatim answered a place whose coordinates are not numbers", code: "http_error" }) (emit GEOCODED { lat: @lat, lng: @lng, formattedAddress: (object/get @place display_name "") })))))))

      REVERSE_GEOCODE -> idle
        (emit MAPS_HTTP_SEND { key: "reverse", method: "GET", target: (str/concat "/reverse?format=json&lat=" @payload.lat "&lon=" @payload.lng), headers: [{ name: "Accept", value: "application/json" }, { name: "User-Agent", value: @config.userAgent }], body: (bytes/from-string ""), stream: "none" })
      MAPS_REPLIED -> idle when (and (= @payload.key "reverse") (or (< @payload.status 200) (>= @payload.status 300)))
        (emit MAPS_FAILURE { error: (str/concat "Nominatim answered HTTP " @payload.status), code: "http_error" })
      MAPS_REPLIED -> idle when (and (= @payload.key "reverse") (>= @payload.status 200) (< @payload.status 300))
        (let ((place (json/parse (default (bytes/to-string @payload.body) "") NominatimReverse)))
          (if (validate/required (object/get @place display_name null))
            (emit REVERSE_GEOCODED { address: (object/get @place display_name ""), formattedAddress: (object/get @place display_name "") })
            (emit MAPS_FAILURE { error: "no address at the coordinates", code: "not_found" })))

      DISTANCE -> idle
        (let ((phi1 (math/deg-rad @payload.fromLat)))
          (let ((phi2 (math/deg-rad @payload.toLat)))
            (let ((sinLat (math/sin (/ (- @phi2 @phi1) 2))) (sinLng (math/sin (/ (math/deg-rad (- @payload.toLng @payload.fromLng)) 2))))
              (let ((a (math/clamp (+ (* @sinLat @sinLat) (* (* (math/cos @phi1) (math/cos @phi2)) (* @sinLng @sinLng))) 0 1)))
                (emit DISTANCE_COMPUTED { distanceKm: (math/round (* 12742.0176 (math/atan2 (default (math/sqrt @a) 0) (default (math/sqrt (- 1 @a)) 0))) 3) })))))

      MAPS_REQUEST_FAILED -> idle
        (emit MAPS_FAILURE { error: @payload.error, code: @payload.kind })
    }

    emits {
      GEOCODED -> external {
        lat : number!
        lng : number!
        formattedAddress : string!
      }
        @description "The first Nominatim match for the address: its latitude and longitude in degrees and the formatted display name."
        @synonyms "geocode result, address coordinates, location found"
        @tier "primary"
      REVERSE_GEOCODED -> external {
        address : string!
        formattedAddress : string!
      }
        @description "The address Nominatim resolves for the coordinates."
        @synonyms "reverse geocode result, address at coordinates"
        @tier "primary"
      DISTANCE_COMPUTED -> external {
        distanceKm : number!
      }
        @description "The great-circle (haversine) distance between two points in kilometres, rounded to metres; computed locally with no network call."
        @synonyms "distance between points, km apart"
        @tier "primary"
      MAPS_FAILURE -> external {
        error : string!
        code : string!
      }
        @description "A geocode or reverse-geocode that produced no result: error text and code (invalid_input, not_found, http_error, or the transport kind timeout, failed, refused)."
        @synonyms "maps error, geocode failed, lookup failed"
        @tier "primary"
      MAPS_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one request, for the HTTP fetch."
        @tier "internal"
    }

    listens {
      GEOCODE -> input {
        address : string!
      }
        @description "Resolve a free-text address to coordinates."
        @synonyms "geocode address, find coordinates, locate address"
      REVERSE_GEOCODE -> input {
        lat : number!
        lng : number!
      }
        @description "Resolve coordinates to an address."
        @synonyms "reverse geocode, address from coordinates"
      DISTANCE -> input {
        fromLat : number!
        fromLng : number!
        toLat : number!
        toLng : number!
      }
        @description "Great-circle distance between two coordinate pairs, in kilometres."
        @synonyms "distance between, how far, haversine"
      MAPS_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
      MAPS_REQUEST_FAILED {
        key : string
        error : string!
        kind : string!
      }
      MapsFetch.HTTP_REPLIED -> MAPS_REPLIED
      MapsFetch.HTTP_FAILED -> MAPS_REQUEST_FAILED
    }

    config {
      userAgent : string = "Almadar/1.0 (https://almadar.dev)"
        @label "User-Agent"
        @description "Identifying User-Agent header Nominatim's usage policy requires on every request."
        @synonyms "user agent, client id, request identity"
        @tier "infra"
    }
  }

  page boot as MapsPage -> MapsClient, MapsFetch
}
