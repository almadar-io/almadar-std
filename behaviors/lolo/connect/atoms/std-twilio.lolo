app std-twilio [
  version: "1.0.0",
  description: "std-twilio — outbound SMS and WhatsApp through the Twilio Messages REST resource (api.twilio.com). TWILIO_SEND_SMS sends a text (sender defaults to the configured phone number), TWILIO_SEND_WHATSAPP sends a whatsapp: message from the configured number. Each answers a result event with the message sid and status, or a failure event carrying the provider error message.",
  net: { "api.twilio.com:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
type TwilioMessage = { sid : string, status : string }
type TwilioError = { type : string, title : string, status : number, code : number, message : string }
orbital TwilioOrbital {
  entity TwilioMessageRequest [runtime] {
    id : string!
  }

  trait TwilioHttp = Http.traits.HttpClient {
    config {
      host: "api.twilio.com"
      port: 443
      tls: true
      serverName: "api.twilio.com"
      credential: "TWILIO_BASIC_AUTH"
      credentialHeader: "authorization"
      credentialPrefix: "Basic "
      credentialEncode: "base64"
    }
    listens {
      TwilioClient.TWILIO_HTTP_SEND -> HTTP_SEND
      TwilioTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
    }
  }

  trait TwilioTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      TwilioClient.TWILIO_HTTP_SEND -> START with { key: (as ?key CallKey) }
      TwilioHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      TwilioHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait TwilioClient -> TwilioMessageRequest [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      TWILIO_SEND_SMS -> idle when (= @config.accountSid "")
        (emit TWILIO_SMS_FAILED { message: "TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN not configured" })
      TWILIO_SEND_SMS -> idle when (and (!= @config.accountSid "") (not (str/startsWith @config.accountSid "AC")) (str/startsWith @config.accountSid "SK"))
        (emit TWILIO_SMS_FAILED { message: "accountSid must start with AC. The given SID indicates an API Key which requires the accountSid to be passed as an additional option" })
      TWILIO_SEND_SMS -> idle when (and (!= @config.accountSid "") (not (str/startsWith @config.accountSid "AC")) (not (str/startsWith @config.accountSid "SK")))
        (emit TWILIO_SMS_FAILED { message: "accountSid must start with AC" })
      TWILIO_SEND_SMS -> idle when (str/startsWith @config.accountSid "AC")
        (emit TWILIO_HTTP_SEND {
          key: "sms",
          method: "POST",
          target: (str/concat "/2010-04-01/Accounts/" @config.accountSid "/Messages.json"),
          headers: [{ name: "content-type", value: "application/x-www-form-urlencoded" }, { name: "accept", value: "application/json" }],
          body: (bytes/from-string (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/concat "To=" (str/encode-uri-component @payload.to) "&From=" (str/encode-uri-component (if (or (= @payload.from null) (= @payload.from "")) @config.phoneNumber @payload.from)) "&Body=" (str/encode-uri-component @payload.body)) "!" "%21") "'" "%27") "(" "%28") ")" "%29") "*" "%2A")),
          stream: "none"
        })
      TWILIO_SMS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) false (!= (object/get @m status null) null))))
        (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) (emit TWILIO_SMS_FAILED { message: "Twilio answered a body that is not a message" }) (emit TWILIO_SMS_RESULT { sid: (object/get @m sid ""), status: (object/get @m status "") })))
      TWILIO_SMS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) false (= (object/get @m status null) null))))
        (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) (emit TWILIO_SMS_FAILED { message: "Twilio answered a body that is not a message" }) (emit TWILIO_SMS_RESULT { sid: (object/get @m sid "") })))
      TWILIO_SMS_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (json/parse @payload.body TwilioMessage) null))
        (emit TWILIO_SMS_FAILED { message: "Twilio answered a body that is not a message" })
      TWILIO_SMS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((e (json/parse @payload.body TwilioError))) (emit TWILIO_SMS_FAILED { message: (if (= @e null) (str/concat "[HTTP " @payload.status "] Failed to execute request")
          (if (and (!= (object/get @e type null) null) (!= (object/get @e title null) null) (!= (object/get @e status null) null) (!= (object/get @e code null) null))
          (str/concat "[HTTP " (if (!= (object/get @e status 0) 0) (object/get @e status 0) @payload.status) "] " (if (!= (object/get @e title "") "") (object/get @e title "") "Failed to execute request"))
          (object/get @e message ""))) }))
      TWILIO_SMS_HTTP_FAILED -> idle
        (emit TWILIO_SMS_FAILED { message: @payload.error })

      TWILIO_SEND_WHATSAPP -> idle when (= @config.accountSid "")
        (emit TWILIO_WHATSAPP_FAILED { message: "TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN not configured" })
      TWILIO_SEND_WHATSAPP -> idle when (and (!= @config.accountSid "") (not (str/startsWith @config.accountSid "AC")) (str/startsWith @config.accountSid "SK"))
        (emit TWILIO_WHATSAPP_FAILED { message: "accountSid must start with AC. The given SID indicates an API Key which requires the accountSid to be passed as an additional option" })
      TWILIO_SEND_WHATSAPP -> idle when (and (!= @config.accountSid "") (not (str/startsWith @config.accountSid "AC")) (not (str/startsWith @config.accountSid "SK")))
        (emit TWILIO_WHATSAPP_FAILED { message: "accountSid must start with AC" })
      TWILIO_SEND_WHATSAPP -> idle when (str/startsWith @config.accountSid "AC")
        (emit TWILIO_HTTP_SEND {
          key: "whatsapp",
          method: "POST",
          target: (str/concat "/2010-04-01/Accounts/" @config.accountSid "/Messages.json"),
          headers: [{ name: "content-type", value: "application/x-www-form-urlencoded" }, { name: "accept", value: "application/json" }],
          body: (bytes/from-string (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/concat "To=" (str/encode-uri-component (str/concat "whatsapp:" @payload.to)) "&From=" (str/encode-uri-component (str/concat "whatsapp:" @config.phoneNumber)) "&Body=" (str/encode-uri-component @payload.body)) "!" "%21") "'" "%27") "(" "%28") ")" "%29") "*" "%2A")),
          stream: "none"
        })
      TWILIO_WHATSAPP_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) false (!= (object/get @m status null) null))))
        (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) (emit TWILIO_WHATSAPP_FAILED { message: "Twilio answered a body that is not a message" }) (emit TWILIO_WHATSAPP_RESULT { sid: (object/get @m sid ""), status: (object/get @m status "") })))
      TWILIO_WHATSAPP_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) false (= (object/get @m status null) null))))
        (let ((m (json/parse @payload.body TwilioMessage))) (if (= @m null) (emit TWILIO_WHATSAPP_FAILED { message: "Twilio answered a body that is not a message" }) (emit TWILIO_WHATSAPP_RESULT { sid: (object/get @m sid "") })))
      TWILIO_WHATSAPP_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (json/parse @payload.body TwilioMessage) null))
        (emit TWILIO_WHATSAPP_FAILED { message: "Twilio answered a body that is not a message" })
      TWILIO_WHATSAPP_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((e (json/parse @payload.body TwilioError))) (emit TWILIO_WHATSAPP_FAILED { message: (if (= @e null) (str/concat "[HTTP " @payload.status "] Failed to execute request")
          (if (and (!= (object/get @e type null) null) (!= (object/get @e title null) null) (!= (object/get @e status null) null) (!= (object/get @e code null) null))
          (str/concat "[HTTP " (if (!= (object/get @e status 0) 0) (object/get @e status 0) @payload.status) "] " (if (!= (object/get @e title "") "") (object/get @e title "") "Failed to execute request"))
          (object/get @e message ""))) }))
      TWILIO_WHATSAPP_HTTP_FAILED -> idle
        (emit TWILIO_WHATSAPP_FAILED { message: @payload.error })
    }

    emits {
      TWILIO_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: the Twilio Messages request, for the HTTP client."
        @tier "secondary"
      TWILIO_SMS_RESULT -> external {
        sid : string!
        status : string
      }
        @description "The Twilio message that was sent: its sid and, when the reply carries one, its delivery status."
        @tier "primary"
      TWILIO_SMS_FAILED -> external {
        code : string
        message : string!
      }
        @description "Twilio refused or never answered the was request; message carries the provider error text."
        @tier "primary"
      TWILIO_WHATSAPP_RESULT -> external {
        sid : string!
        status : string
      }
        @description "The Twilio message that was sent: its sid and, when the reply carries one, its delivery status."
        @tier "primary"
      TWILIO_WHATSAPP_FAILED -> external {
        code : string
        message : string!
      }
        @description "Twilio refused or never answered the was request; message carries the provider error text."
        @tier "primary"
    }

    listens {
      TWILIO_SEND_SMS -> input {
        to : string!
        body : string!
        from : string
      }
        @description "Send an SMS; from defaults to the configured phone number when empty or absent."
        @synonyms "send text message, text, sms"
      TWILIO_SEND_WHATSAPP -> input {
        to : string!
        body : string!
      }
        @description "Send a WhatsApp message to a phone number (E.164) from the configured number."
        @synonyms "whatsapp message, send whatsapp"
      TWILIO_SMS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      TWILIO_SMS_HTTP_FAILED {
        error : string!
        kind : string!
      }
      TWILIO_WHATSAPP_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      TWILIO_WHATSAPP_HTTP_FAILED {
        error : string!
        kind : string!
      }
      TwilioHttp.HTTP_REPLIED -> TWILIO_SMS_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "sms")
      TwilioHttp.HTTP_FAILED -> TWILIO_SMS_HTTP_FAILED with { error: ?error, kind: ?kind } when (= ?key "sms")
      TwilioHttp.HTTP_REPLIED -> TWILIO_WHATSAPP_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "whatsapp")
      TwilioHttp.HTTP_FAILED -> TWILIO_WHATSAPP_HTTP_FAILED with { error: ?error, kind: ?kind } when (= ?key "whatsapp")
      TwilioTimeout.TIMED_OUT -> TWILIO_SMS_HTTP_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "sms")
      TwilioTimeout.TIMED_OUT -> TWILIO_WHATSAPP_HTTP_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "whatsapp")
    }

    config {
      accountSid : string = ""
        @label "Account SID"
        @description "The Twilio account SID (starts with AC). The Messages URL carries it, so it is a plain setting here; the basic-auth user is the same SID, held in the TwilioHttp credential."
        @synonyms "account sid, twilio account"
        @tier "infra"
      phoneNumber : string = ""
        @label "Sender phone number"
        @description "The default sender number (E.164); the sender of every WhatsApp message."
        @synonyms "from number, twilio number, sender"
        @tier "infra"
    }
  }

  page boot as TwilioPage -> TwilioClient, TwilioHttp, TwilioTimeout
}
