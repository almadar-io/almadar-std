app std-chrome [
  version: "1.0.0",
  description: "std-chrome — drives one headless Chrome tab through a composed std-daemon (launch) and std-cdp (transport). CHROME_START creates the profile and download directories (anchored knobs), launches Chrome detached with --headless=new, --remote-debugging-port, --user-data-dir and the extraArgs knob (no --no-sandbox by default: the container organism sets it), connects, creates a target (Target.createTarget about:blank), attaches it with a flat session (Target.attachToTarget), enables Page, Runtime and Accessibility on the session, sets Browser.setDownloadBehavior allow into the download directory with events, and answers CHROME_READY { browser, targetId } (the page target's id, so another CDP client such as std-cdp-profile can attach to the same tab on its own connection). Every page request carries a caller key, runs one at a time (a second one answers PAGE_FAILED busy) and answers on that key. NAVIGATE: Page.navigate, then the session's Page.loadEventFired or the navigation timeout, then location and title; an errorText answers navigation-failed. With the waitFor knob networkIdle it first enables Page.setLifecycleEventsEnabled and answers only after the navigated frame's networkIdle lifecycle event (after load), the evaluation of document.fonts.ready and the settleMs wait, all inside the navigation timeout. ELEMENT_SHOT is DOM.getDocument, DOM.querySelector, DOM.scrollIntoViewIfNeeded, the elementSettleMs wait, DOM.getBoxModel, Page.getLayoutMetrics and a clipped Page.captureScreenshot (the margin knob elementMargin clamped inside the content), answering the image with its clip and the element box relative to the clip; no match answers element-missing, no box or size element-hidden. PRELOAD is Page.addScriptToEvaluateOnNewDocument. TEXT, LINKS, FOCUSED and MEASURE are Runtime.evaluate of measuring-only expressions held in knobs; LINKS and CLICK share one element list. CLICK clicks and, after clickSettleMs, reports navigated (location changed or main-frame Page.frameNavigated). KEY sends Input.dispatchKeyEvent keyDown and keyUp from the keys table. VIEWPORT is Emulation.setDeviceMetricsOverride with page zoom for textZoom. SCREENSHOT is Page.captureScreenshot (base64 to bytes); AX_TREE is Accessibility.getFullAXTree. DOWNLOAD clicks as CLICK does and waits for Browser.downloadWillBegin and downloadProgress completed; the path is the filePath of the completed event. PRINT_PDF with html navigates about:blank, sets the document content from Page.getFrameTree and prints with Page.printToPDF; with an absolute path it navigates to file:// plus the path, waits for load and prints; exactly one of html and path. INJECT reads the script file (a path relative to the scriptDir knob; an absolute path or one that climbs out with .. answers PAGE_FAILED bad-script) and evaluates it. CHROME_STOP closes the target, disconnects and stops the browser it started (a browser that was already listening is left running). The composer grants exec for the Chrome binary, net 127.0.0.1 on the port, fs create, read and write on the profile directory, fs create and read on the download directory and fs read on the scriptDir directory, and sets ChromeDaemon commands (default the ORB_CHROME environment variable), readyPort and the CdpHttp and CdpWs port when it changes port."
]
;; @capabilities "drive a headless Chrome tab: navigate, read text and links, click, press keys, read focus, resize, screenshot, accessibility tree, download, print PDF, inject and measure"
uses Spec from "almadar-std/chrome"
uses Daemon from "std/behaviors/std-daemon"
uses CdpAtom from "std/behaviors/std-cdp"
uses Delay from "std/behaviors/std-delay"

type PageLink = { index : number!, text : string!, href : string!, download : boolean!, kind : "link" | "button"! }
type PageRect = { x : number!, y : number!, width : number!, height : number! }
type PageFocus = { tag : string!, role : string!, name : string!, selector : string!, rect : PageRect! }
type PageAxNode = { id : string!, parent : string?, role : string!, name : string!, ignored : boolean! }
type ChromePath = { anchor : "cwd" | "exe-dir" | { env : string! }!, path : string! }
type ChromeKey = { key : string!, code : string!, vk : number!, text : string, nav : boolean }
type EvalCause = { description : string?, value : string? }
type EvalException = { text : string!, exception : EvalCause? }
type EvalValue = { value : string? }
type EvalReply = { result : { result : EvalValue!, exceptionDetails : EvalException? }! }
type MeasureHead = { result : { result : { type : string! }!, exceptionDetails : EvalException? }! }
type InjectReply = { result : { exceptionDetails : EvalException? }! }
type NavigateReply = { result : { frameId : string!, errorText : string? }! }
type CreateTargetReply = { result : { targetId : string! }! }
type AttachReply = { result : { sessionId : string! }! }
type DataReply = { result : { data : string! }! }
type FrameTreeReply = { result : { frameTree : { frame : { id : string! }! }! }! }
type AxValue = { value : string? }
type AxNodeWire = { nodeId : string!, ignored : boolean?, role : AxValue?, name : AxValue?, parentId : string? }
type AxReply = { result : { nodes : [AxNodeWire]! }! }
type LifecycleEvent = { params : { frameId : string!, name : string! }! }
type DocReply = { result : { root : { nodeId : number! }! }! }
type QueryReply = { result : { nodeId : number! }! }
type BoxReply = { result : { model : { border : [number]! }! }! }
type MetricsReply = { result : { contentSize : { width : number!, height : number! }!, cssVisualViewport : { pageX : number!, pageY : number! }! }! }
type PreloadReply = { result : { identifier : string! }! }
type NavInfo = { url : string!, title : string! }
type TextRead = { url : string!, title : string!, lang : string!, text : string! }
type LinkList = [PageLink]
type ClickRead = { found : boolean!, url : string! }
type FocusRead = { focused : PageFocus? }
type FrameNavigated = { id : string!, parentId : string? }
type FrameNavigatedEvent = { params : { frame : FrameNavigated! }! }
type DownloadBegin = { guid : string!, url : string!, suggestedFilename : string! }
type DownloadBeginEvent = { params : DownloadBegin! }
type DownloadProgress = { guid : string!, receivedBytes : number!, state : string!, filePath : string? }
type DownloadProgressEvent = { params : DownloadProgress! }

orbital ChromeOrbital {
  entity ChromeTab [runtime] {
    id : string!
    sessionId : string @description "The flat session id of the attached page target; every page command carries it."
    url : string @description "The location after the last navigation or click."
    targetId : string @description "The page target Target.createTarget made." = ""
    browser : string @description "The Browser version string CDP_CONNECTED reported." = ""
    op : string @description "The page operation in flight." = ""
    callerKey : string @description "The key of the request in flight; every answer carries it." = ""
    stage : string @description "The step of the operation in flight; it is also the key of the CDP command awaited." = ""
    loadSeen : boolean @description "Page.loadEventFired arrived before the Page.navigate reply." = false
    navSeen : boolean @description "A main-frame Page.frameNavigated arrived during a click." = false
    startUrl : string @description "The location at the moment of the click." = ""
    profilePath : string @description "The resolved profile directory." = ""
    downloadPath : string @description "The resolved download directory." = ""
    keyName : string @description "The key of the PAGE_KEY in flight." = ""
    shift : boolean @description "Shift is held for the PAGE_KEY in flight." = false
    html : string @description "The HTML of the PAGE_PRINT_PDF in flight." = ""
    keyNav : boolean @description "The key of the PAGE_KEY in flight activates controls, so the press waits for a navigation." = false
    dlGuid : string @description "Guid of the download in flight." = ""
    dlName : string @description "Suggested file name of the download in flight." = ""
    dlUrl : string @description "Source url of the download in flight." = ""
    navUrl : string @description "The url of the PAGE_NAVIGATE in flight." = ""
    frameId : string @description "The frame Page.navigate reported for the navigation in flight; lifecycle events of other frames are ignored." = ""
    nodeId : number @description "The DOM node id DOM.querySelector found for the PAGE_ELEMENT_SHOT in flight." = 0
    selector : string @description "The CSS selector of the PAGE_ELEMENT_SHOT in flight." = ""
    shotMargin : number @description "The margin around the element of the PAGE_ELEMENT_SHOT in flight." = 0
    shotFormat : string @description "The image format of the PAGE_ELEMENT_SHOT in flight." = "png"
    shotQuality : number? @description "The jpeg quality of the PAGE_ELEMENT_SHOT in flight; absent when none was asked."
    elRect : PageRect @description "The element border rectangle, relative to the viewport, from DOM.getBoxModel." = { x: 0, y: 0, width: 0, height: 0 }
    shotClip : PageRect @description "The clip of the PAGE_ELEMENT_SHOT in flight, in page coordinates." = { x: 0, y: 0, width: 0, height: 0 }
    shotBox : PageRect @description "The element rectangle relative to the clip origin." = { x: 0, y: 0, width: 0, height: 0 }
  }

  trait ChromeDaemon = Daemon.traits.Daemon {
    listens {
      Chrome.DAEMON_START -> DAEMON_START
      Chrome.DAEMON_STOP -> DAEMON_STOP
    }
    config {
      commands: [{ anchor: { env: "ORB_CHROME" } }]
      readyPort: 9222
    }
  }

  trait Cdp = CdpAtom.traits.Cdp {
    listens {
      Chrome.CDP_CONNECT -> CDP_CONNECT
      Chrome.CDP_COMMAND -> CDP_COMMAND
      Chrome.CDP_DISCONNECT -> CDP_DISCONNECT
      CDP_VERSION {
        status : number!
        body : string!
      }
      CDP_WS_OPENED { }
      CDP_WS_MESSAGE {
        text : string
        binary : boolean!
      }
      CDP_WS_CLOSED {
        code : number!
        reason : string!
      }
      CDP_WS_FAILED {
        error : string!
        kind : string!
      }
      CDP_TIMEOUT {
        key : string!
      }
      CdpHttp.HTTP_REPLIED -> CDP_VERSION with { status: ?status, body: (default (bytes/to-string ?body) "") } when (= ?key "cdp-version")
      CdpHttp.HTTP_FAILED -> CDP_CONNECT_FAILED with { error: ?error, kind: ?kind } when (= ?key "cdp-version")
      CdpWs.WS_OPENED -> CDP_WS_OPENED
      CdpWs.WS_MESSAGE -> CDP_WS_MESSAGE with { text: ?text, binary: ?binary }
      CdpWs.WS_CLOSED -> CDP_WS_CLOSED with { code: ?code, reason: ?reason }
      CdpWs.WS_FAILED -> CDP_WS_FAILED with { error: ?error, kind: ?kind }
      CdpDelay.ELAPSED -> CDP_TIMEOUT with { key: ?key }
    }
  }

  trait CdpHttp = CdpAtom.traits.CdpHttp { }

  trait CdpWs = CdpAtom.traits.CdpWs {
    config {
    }
  }

  trait CdpDelay = CdpAtom.traits.CdpDelay { }

  trait ChromeDelay = Delay.traits.Delay {
    listens {
      Chrome.CHROME_TIMER_ARM -> START
      Chrome.CHROME_TIMER_CANCEL -> CANCEL
    }
  }

  trait Chrome -> ChromeTab [optimistic] {
    initial: stopped

    state stopped {
      INIT -> stopped
        (set @entity.stage "")
      CHROME_START -> starting
        (set @entity.stage "mk-profile")
        (set @entity.sessionId "")
        (os/mkdir @config.preferencesDir true { emit: { success: CHROME_DIR_MADE, failure: CHROME_HOST_FAILED } })
      CHROME_STOP -> stopped
        (emit CHROME_STOPPED { })
      PAGE_NAVIGATE -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_TEXT -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_LINKS -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_CLICK -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_KEY -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_FOCUSED -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_VIEWPORT -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_SCREENSHOT -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_AX_TREE -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_DOWNLOAD -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_PRINT_PDF -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_INJECT -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_MEASURE -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_ELEMENT_SHOT -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
      PAGE_PRELOAD -> stopped
        (emit PAGE_FAILED { key: @payload.key error: "the browser is not started; send CHROME_START first" code: "not-started" })
    }

    state starting {
      INIT -> starting

      CHROME_START -> starting
        (emit CHROME_FAILED { code: "busy" message: "the browser is already starting" })
      CHROME_STOP -> starting
        (emit CHROME_FAILED { code: "busy" message: "the browser is still starting" })
      PAGE_NAVIGATE -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_TEXT -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_LINKS -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_CLICK -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_KEY -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_FOCUSED -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_VIEWPORT -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_SCREENSHOT -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_AX_TREE -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_DOWNLOAD -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_PRINT_PDF -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_INJECT -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_MEASURE -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_ELEMENT_SHOT -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      PAGE_PRELOAD -> starting
        (emit PAGE_FAILED { key: @payload.key error: "the browser is still starting" code: "not-ready" })
      CHROME_DIR_MADE -> starting when (= @entity.stage "mk-profile")
        (set @entity.stage "rp-profile")
        (os/realpath @config.profileDir { emit: { success: CHROME_PATH_RESOLVED, failure: CHROME_HOST_FAILED } })
      CHROME_PATH_RESOLVED -> starting when (and (= @entity.stage "rp-profile") (!= @config.preferences ""))
        (set @entity.profilePath @payload.path)
        (set @entity.stage "write-prefs")
        (os/write-file @config.preferencesFile (bytes/from-string @config.preferences) { emit: { success: CHROME_FILE_WROTE, failure: CHROME_HOST_FAILED } })
      CHROME_FILE_WROTE -> starting when (= @entity.stage "write-prefs")
        (set @entity.stage "mk-download")
        (os/mkdir @config.downloadDir true { emit: { success: CHROME_DIR_MADE, failure: CHROME_HOST_FAILED } })
      CHROME_PATH_RESOLVED -> starting when (and (= @entity.stage "rp-profile") (= @config.preferences ""))
        (set @entity.profilePath @payload.path)
        (set @entity.stage "mk-download")
        (os/mkdir @config.downloadDir true { emit: { success: CHROME_DIR_MADE, failure: CHROME_HOST_FAILED } })
      CHROME_DIR_MADE -> starting when (= @entity.stage "mk-download")
        (set @entity.stage "rp-download")
        (os/realpath @config.downloadDir { emit: { success: CHROME_PATH_RESOLVED, failure: CHROME_HOST_FAILED } })
      CHROME_PATH_RESOLVED -> starting when (= @entity.stage "rp-download")
        (set @entity.downloadPath @payload.path)
        (set @entity.stage "launch")
        (emit DAEMON_START { argv: (array/concat ["--headless=new" (str/concat "--remote-debugging-port=" @config.port) "--no-first-run" "--no-default-browser-check" "--disable-gpu" (str/concat "--window-size=" @config.windowWidth "," @config.windowHeight) (str/concat "--user-data-dir=" @entity.profilePath) "about:blank"] @config.extraArgs) })
      CHROME_DAEMON_READY -> starting when (= @entity.stage "launch")
        (set @entity.stage "connect")
        (emit CDP_CONNECT { })
      CHROME_CONNECTED -> starting when (= @entity.stage "connect")
        (set @entity.browser @payload.browser)
        (set @entity.stage "create")
        (emit CDP_COMMAND { key: "create" method: "Target.createTarget" paramsJson: (json/stringify { url: "about:blank" }) })
      CHROME_REPLY -> starting when (= @payload.key "create")
        (let ((r (json/parse @payload.frame CreateTargetReply)))
          (if (= @r null)
            (emit CHROME_START_FAILED { code: "bad-reply" message: "Target.createTarget answered an unexpected shape" })
            (do
              (set @entity.targetId @r.result.targetId)
              (set @entity.stage "attach")
              (emit CDP_COMMAND { key: "attach" method: "Target.attachToTarget" paramsJson: (json/stringify { targetId: @r.result.targetId flatten: true }) }))))
      CHROME_REPLY -> starting when (= @payload.key "attach")
        (let ((r (json/parse @payload.frame AttachReply)))
          (if (= @r null)
            (emit CHROME_START_FAILED { code: "bad-reply" message: "Target.attachToTarget answered an unexpected shape" })
            (do
              (set @entity.sessionId @r.result.sessionId)
              (set @entity.stage "enable-page")
              (emit CDP_COMMAND { key: "enable-page" method: "Page.enable" sessionId: @r.result.sessionId paramsJson: (json/stringify { }) }))))
      CHROME_REPLY -> starting when (= @payload.key "enable-page")
        (set @entity.stage "enable-runtime")
        (emit CDP_COMMAND { key: "enable-runtime" method: "Runtime.enable" sessionId: @entity.sessionId paramsJson: (json/stringify { }) })
      CHROME_REPLY -> starting when (= @payload.key "enable-runtime")
        (set @entity.stage "enable-ax")
        (emit CDP_COMMAND { key: "enable-ax" method: "Accessibility.enable" sessionId: @entity.sessionId paramsJson: (json/stringify { }) })
      CHROME_REPLY -> starting when (= @payload.key "enable-ax")
        (set @entity.stage "download")
        (emit CDP_COMMAND { key: "download" method: "Browser.setDownloadBehavior" paramsJson: (json/stringify { behavior: "allow" downloadPath: @entity.downloadPath eventsEnabled: true }) })
      CHROME_REPLY -> ready when (= @payload.key "download")
        (set @entity.stage "")
        (emit CHROME_READY { browser: @entity.browser, targetId: (default @entity.targetId "") })
      CHROME_ERROR -> starting when (= @payload.key @entity.stage)
        (emit CHROME_START_FAILED { code: @payload.code message: @payload.message })
      CHROME_START_FAILED -> stopped
        (emit CHROME_FAILED { code: @payload.code message: @payload.message })
        (emit CDP_DISCONNECT { })
        (emit DAEMON_STOP { })
      CHROME_DAEMON_FAILED -> stopped
        (emit CHROME_FAILED { code: @payload.code message: @payload.message })
      CHROME_CDP_FAILED -> stopped
        (emit CHROME_FAILED { code: @payload.kind message: @payload.error })
        (emit DAEMON_STOP { })
      CHROME_HOST_FAILED -> stopped
        (emit CHROME_FAILED { code: "host-failed" message: (default @payload.error "") })
    }

    state ready {
      INIT -> ready

      CHROME_START -> ready
        (emit CHROME_FAILED { code: "already-started" message: "the browser is already running" })
      CHROME_STOP -> stopping
        (set @entity.stage "close-target")
        (emit CDP_COMMAND { key: "close-target" method: "Target.closeTarget" paramsJson: (json/stringify { targetId: @entity.targetId }) })
      CHROME_DISCONNECTED -> stopped
        (emit CHROME_FAILED { code: "disconnected" message: @payload.reason })
      PAGE_NAVIGATE -> busy when (= @config.waitFor "load")
        (set @entity.op "navigate") (set @entity.callerKey @payload.key) (set @entity.stage "nav") (set @entity.loadSeen false) (set @entity.navSeen false)
        (emit CDP_COMMAND { key: "nav" method: "Page.navigate" sessionId: @entity.sessionId paramsJson: (json/stringify { url: @payload.url }) })
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.navigationTimeoutMs })
      PAGE_NAVIGATE -> busy when (= @config.waitFor "networkIdle")
        (set @entity.op "navigate") (set @entity.callerKey @payload.key) (set @entity.stage "nav-lc") (set @entity.loadSeen false) (set @entity.navSeen false) (set @entity.navUrl @payload.url)
        (emit CDP_COMMAND { key: "nav-lc" method: "Page.setLifecycleEventsEnabled" sessionId: @entity.sessionId paramsJson: (json/stringify { enabled: true }) })
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.navigationTimeoutMs })
      PAGE_TEXT -> busy
        (set @entity.op "text") (set @entity.callerKey @payload.key) (set @entity.stage "text")
        (emit CDP_COMMAND { key: "text" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.textScript returnByValue: true }) })
      PAGE_LINKS -> busy
        (set @entity.op "links") (set @entity.callerKey @payload.key) (set @entity.stage "links")
        (emit CDP_COMMAND { key: "links" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: (str/concat @config.linksScript "(" (json/stringify { sel: @config.elementSelector exts: @config.downloadExtensions }) ")") returnByValue: true }) })
      PAGE_CLICK -> ready when (= (== @payload.index null) (== @payload.selector null))
        (emit PAGE_FAILED { key: @payload.key error: "exactly one of index and selector is required" code: "bad-request" })
      PAGE_CLICK -> busy when (not (= (== @payload.index null) (== @payload.selector null)))
        (set @entity.op "click") (set @entity.callerKey @payload.key) (set @entity.stage "click") (set @entity.navSeen false)
        (emit CDP_COMMAND { key: "click" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: (str/concat @config.clickScript "(" (json/stringify { sel: @config.elementSelector index: (default @payload.index null) selector: (default @payload.selector null) }) ")") returnByValue: true }) })
      PAGE_KEY -> ready when (= (object/get @config.keys @payload.keyName) null)
        (emit PAGE_FAILED { key: @payload.key error: "the key name is not in the keys table" code: "unknown-key" })
      PAGE_KEY -> busy when (!= (object/get @config.keys @payload.keyName) null)
        (set @entity.op "key") (set @entity.callerKey @payload.key) (set @entity.stage "key-down") (set @entity.keyName @payload.keyName) (set @entity.shift (default @payload.shift false)) (set @entity.loadSeen false) (set @entity.navSeen false)
        (let ((d (object/get @config.keys @payload.keyName)))
          (do (set @entity.keyNav (default @d.nav false))
          (emit CDP_COMMAND { key: "key-down" method: "Input.dispatchKeyEvent" sessionId: @entity.sessionId paramsJson: (json/stringify { type: (if (!= (default @d.text "") "") "keyDown" "rawKeyDown") key: @d.key code: @d.code windowsVirtualKeyCode: @d.vk modifiers: (if (default @payload.shift false) 8 0) text: (default @d.text "") }) })))
      PAGE_FOCUSED -> busy
        (set @entity.op "focused") (set @entity.callerKey @payload.key) (set @entity.stage "focused")
        (emit CDP_COMMAND { key: "focused" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: (str/concat @config.focusScript "(" (json/stringify @config.implicitRoles) ")") returnByValue: true }) })
      PAGE_VIEWPORT -> ready when (<= @payload.textZoom 0)
        (emit PAGE_FAILED { key: @payload.key error: "textZoom must be above zero" code: "bad-request" })
      PAGE_VIEWPORT -> busy when (> @payload.textZoom 0)
        (set @entity.op "viewport") (set @entity.callerKey @payload.key) (set @entity.stage "viewport")
        (emit CDP_COMMAND { key: "viewport" method: "Emulation.setDeviceMetricsOverride" sessionId: @entity.sessionId paramsJson: (json/stringify { width: (math/round (/ @payload.width @payload.textZoom)) height: (math/round (/ @payload.height @payload.textZoom)) deviceScaleFactor: (* @payload.deviceScaleFactor @payload.textZoom) mobile: @payload.mobile }) })
      PAGE_SCREENSHOT -> busy
        (set @entity.op "screenshot") (set @entity.callerKey @payload.key) (set @entity.stage "screenshot")
        (emit CDP_COMMAND { key: "screenshot" method: "Page.captureScreenshot" sessionId: @entity.sessionId paramsJson: (json/stringify { format: "png" captureBeyondViewport: @payload.fullPage }) })
      PAGE_AX_TREE -> busy
        (set @entity.op "ax") (set @entity.callerKey @payload.key) (set @entity.stage "ax")
        (emit CDP_COMMAND { key: "ax" method: "Accessibility.getFullAXTree" sessionId: @entity.sessionId paramsJson: (json/stringify { }) })
      PAGE_DOWNLOAD -> ready when (= (== @payload.index null) (== @payload.selector null))
        (emit PAGE_FAILED { key: @payload.key error: "exactly one of index and selector is required" code: "bad-request" })
      PAGE_DOWNLOAD -> busy when (not (= (== @payload.index null) (== @payload.selector null)))
        (set @entity.op "download") (set @entity.callerKey @payload.key) (set @entity.stage "dl-click") (set @entity.dlGuid "") (set @entity.dlName "") (set @entity.dlUrl "")
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.downloadTimeoutMs })
        (emit CDP_COMMAND { key: "dl-click" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: (str/concat @config.clickScript "(" (json/stringify { sel: @config.elementSelector index: (default @payload.index null) selector: (default @payload.selector null) }) ")") returnByValue: true }) })
      PAGE_PRINT_PDF -> ready when (= (== @payload.html null) (== @payload.path null))
        (emit PAGE_FAILED { key: @payload.key error: "exactly one of html and path is required" code: "bad-request" })
      PAGE_PRINT_PDF -> busy when (and (not (= (== @payload.html null) (== @payload.path null))) (== @payload.path null))
        (set @entity.op "pdf") (set @entity.callerKey @payload.key) (set @entity.stage "pdf-blank") (set @entity.html @payload.html)
        (emit CDP_COMMAND { key: "pdf-blank" method: "Page.navigate" sessionId: @entity.sessionId paramsJson: (json/stringify { url: "about:blank" }) })
      PAGE_PRINT_PDF -> busy when (and (not (= (== @payload.html null) (== @payload.path null))) (not (== @payload.path null)))
        (set @entity.op "pdf") (set @entity.callerKey @payload.key) (set @entity.stage "pdf-nav") (set @entity.loadSeen false)
        (emit CDP_COMMAND { key: "pdf-nav" method: "Page.navigate" sessionId: @entity.sessionId paramsJson: (json/stringify { url: (str/concat "file://" @payload.path) }) })
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.navigationTimeoutMs })
      PAGE_ELEMENT_SHOT -> busy
        (set @entity.op "elshot") (set @entity.callerKey @payload.key) (set @entity.stage "el-doc") (set @entity.selector @payload.selector) (set @entity.shotMargin (default @payload.margin @config.elementMargin)) (set @entity.shotFormat (default @payload.format "png")) (set @entity.shotQuality (default @payload.quality null))
        (emit CDP_COMMAND { key: "el-doc" method: "DOM.getDocument" sessionId: @entity.sessionId paramsJson: (json/stringify { depth: 0 }) })
      PAGE_PRELOAD -> ready when (or (os/path-is-absolute @payload.script) (== (os/path-normalize @payload.script) "..") (str/startsWith (os/path-normalize @payload.script) "../"))
        (emit PAGE_FAILED { key: @payload.key error: "the script path must be relative and stay under scriptDir" code: "bad-script" })
      PAGE_PRELOAD -> busy when (not (or (os/path-is-absolute @payload.script) (== (os/path-normalize @payload.script) "..") (str/startsWith (os/path-normalize @payload.script) "../")))
        (set @entity.op "preload") (set @entity.callerKey @payload.key) (set @entity.stage "preload-read")
        (os/read-file { anchor: "cwd", path: (str/concat @config.scriptDir @payload.script) } { emit: { success: CHROME_FILE_READ, failure: CHROME_HOST_FAILED } })
      PAGE_INJECT -> ready when (or (os/path-is-absolute @payload.script) (== (os/path-normalize @payload.script) "..") (str/startsWith (os/path-normalize @payload.script) "../"))
        (emit PAGE_FAILED { key: @payload.key error: "the script path must be relative and stay under scriptDir" code: "bad-script" })
      PAGE_INJECT -> busy when (not (or (os/path-is-absolute @payload.script) (== (os/path-normalize @payload.script) "..") (str/startsWith (os/path-normalize @payload.script) "../")))
        (set @entity.op "inject") (set @entity.callerKey @payload.key) (set @entity.stage "inject-read")
        (os/read-file { anchor: "cwd", path: (str/concat @config.scriptDir @payload.script) } { emit: { success: CHROME_FILE_READ, failure: CHROME_HOST_FAILED } })
      PAGE_MEASURE -> busy
        (set @entity.op "measure") (set @entity.callerKey @payload.key) (set @entity.stage "measure")
        (emit CDP_COMMAND { key: "measure" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @payload.expression returnByValue: true awaitPromise: true }) })
    }

