      CHROME_DISCONNECTED -> stopped
        (emit PAGE_FAILED { key: @entity.callerKey error: @payload.reason code: "disconnected" })
        (emit CHROME_FAILED { code: "disconnected" message: @payload.reason })
      CHROME_FAIL -> ready
        (emit PAGE_FAILED { key: @entity.callerKey error: @payload.error code: @payload.code })
