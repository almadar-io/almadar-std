      CHROME_DL_PROGRESS -> ready when (and (= @entity.op "download") (= @payload.guid @entity.dlGuid) (= @payload.state "completed"))
        (emit CHROME_TIMER_CANCEL { key: "op" })
        (emit PAGE_DOWNLOADED { key: @entity.callerKey path: (if (!= @payload.filePath "") @payload.filePath (os/path-join @entity.downloadPath @entity.dlName)) url: @entity.dlUrl size: @payload.received })
      CHROME_DL_PROGRESS -> ready when (and (= @entity.op "download") (= @payload.guid @entity.dlGuid) (= @payload.state "canceled"))
