      PAGE_NAVIGATE -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_TEXT -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_LINKS -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_CLICK -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_KEY -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_FOCUSED -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_VIEWPORT -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_SCREENSHOT -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_AX_TREE -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_DOWNLOAD -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_PRINT_PDF -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_INJECT -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_MEASURE -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_ELEMENT_SHOT -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      PAGE_PRELOAD -> busy
        (emit PAGE_FAILED { key: @payload.key error: "another page operation is running on this tab" code: "busy" })
      CHROME_STOP -> stopping
