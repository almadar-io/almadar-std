                (if @entity.loadSeen
                  (if (= @config.waitFor "networkIdle")
                    (set @entity.stage "nav-idle")
                    (do (emit CHROME_TIMER_CANCEL { key: "op" }) (set @entity.stage "nav-info") (emit CDP_COMMAND { key: "nav-info" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.infoScript returnByValue: true }) })))
                  (set @entity.stage "nav-wait"))))))
      CHROME_REPLY -> busy when (= @payload.key "nav-lc")
        (set @entity.stage "nav")
        (emit CDP_COMMAND { key: "nav" method: "Page.navigate" sessionId: @entity.sessionId paramsJson: (json/stringify { url: @entity.navUrl }) })
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "nav"))
        (set @entity.loadSeen true)
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "nav-wait") (= @config.waitFor "networkIdle"))
        (set @entity.stage "nav-idle")
      CHROME_EVENT -> busy when (and (= @payload.method "Page.lifecycleEvent") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "nav-idle"))
        (let ((e (json/parse @payload.frame LifecycleEvent)))
          (when (and (!= @e null) (= @e.params.name "networkIdle") (= @e.params.frameId @entity.frameId))
            (do (set @entity.stage "nav-fonts") (emit CDP_COMMAND { key: "nav-fonts" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.fontsScript awaitPromise: true returnByValue: true }) }))))
      CHROME_REPLY -> busy when (= @payload.key "nav-fonts")
        (let ((r (json/parse @payload.frame InjectReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "Runtime.evaluate answered an unexpected shape" })
            (if (!= @r.result.exceptionDetails null) (emit CHROME_FAIL { code: "script-error" error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) })
              (if (> @config.settleMs 0)
                (do (set @entity.stage "nav-settle") (emit CHROME_TIMER_ARM { key: "settle" delayMs: @config.settleMs }))
                (do (emit CHROME_TIMER_CANCEL { key: "op" }) (set @entity.stage "nav-info") (emit CDP_COMMAND { key: "nav-info" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.infoScript returnByValue: true }) }))))))
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "settle") (= @entity.stage "nav-settle"))
        (emit CHROME_TIMER_CANCEL { key: "op" })
        (set @entity.stage "nav-info")
        (emit CDP_COMMAND { key: "nav-info" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.infoScript returnByValue: true }) })
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "nav-wait") (= @config.waitFor "load"))
        (emit CHROME_TIMER_CANCEL { key: "op" })
        (set @entity.stage "nav-info")
        (emit CDP_COMMAND { key: "nav-info" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.infoScript returnByValue: true }) })
