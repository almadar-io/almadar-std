      CHROME_DL_PROGRESS -> busy when (!= @payload.state "completed")

      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (or (= @entity.stage "nav") (= @entity.stage "nav-lc") (= @entity.stage "nav-wait") (= @entity.stage "nav-idle") (= @entity.stage "nav-fonts") (= @entity.stage "nav-settle") (= @entity.stage "pdf-nav") (= @entity.stage "pdf-load")))
        (emit CHROME_FAIL { code: "navigation-timeout" error: "the page did not fire its load event in time" })
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (= @entity.op "download"))
        (emit CHROME_FAIL { code: "download-timeout" error: "no completed download in time" })
      CHROME_REPLY -> ready when (= @payload.key "nav-info")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (let ((v (json/parse @r.result.result.value NavInfo))) (if (= @v null) (emit PAGE_FAILED { key: @entity.callerKey error: "the page answered text of an unexpected shape" code: "bad-reply" }) (do (set @entity.url @v.url) (emit PAGE_LOADED { key: @entity.callerKey url: @v.url title: @v.title }))))))))
      CHROME_REPLY -> ready when (= @payload.key "text")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (let ((v (json/parse @r.result.result.value TextRead))) (if (= @v null) (emit PAGE_FAILED { key: @entity.callerKey error: "the page answered text of an unexpected shape" code: "bad-reply" }) (emit PAGE_TEXT_READ { key: @entity.callerKey url: @v.url title: @v.title lang: @v.lang text: @v.text })))))))
      CHROME_REPLY -> ready when (= @payload.key "links")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (let ((v (json/parse @r.result.result.value LinkList))) (if (= @v null) (emit PAGE_FAILED { key: @entity.callerKey error: "the page answered text of an unexpected shape" code: "bad-reply" }) (emit PAGE_LINKS_READ { key: @entity.callerKey links: @v })))))))
      CHROME_REPLY -> busy when (= @payload.key "click")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "the evaluate reply is not the declared shape" }) (if (!= @r.result.exceptionDetails null) (emit CHROME_FAIL { code: "script-error" error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) }) (if (= @r.result.result.value null) (emit CHROME_FAIL { code: "not-json" error: "the expression did not evaluate to a string" }) (let ((v (json/parse @r.result.result.value ClickRead))) (if (= @v null) (emit CHROME_FAIL { code: "bad-reply" error: "the page answered text of an unexpected shape" }) (if (not @v.found) (emit CHROME_FAIL { code: "not-found" error: "no element matched" }) (do (set @entity.startUrl @v.url) (set @entity.stage "click-settle") (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.clickSettleMs })))))))))
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (= @entity.stage "click-settle"))
        (set @entity.stage "click-after")
        (emit CDP_COMMAND { key: "click-after" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: @config.infoScript returnByValue: true }) })
      CHROME_REPLY -> ready when (= @payload.key "click-after")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (let ((v (json/parse @r.result.result.value NavInfo))) (if (= @v null) (emit PAGE_FAILED { key: @entity.callerKey error: "the page answered text of an unexpected shape" code: "bad-reply" }) (do (set @entity.url @v.url) (emit PAGE_CLICKED { key: @entity.callerKey url: @v.url navigated: (or @entity.navSeen (!= @v.url @entity.startUrl)) }))))))))
      CHROME_REPLY -> busy when (= @payload.key "dl-click")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "the evaluate reply is not the declared shape" }) (if (!= @r.result.exceptionDetails null) (emit CHROME_FAIL { code: "script-error" error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) }) (if (= @r.result.result.value null) (emit CHROME_FAIL { code: "not-json" error: "the expression did not evaluate to a string" }) (let ((v (json/parse @r.result.result.value ClickRead))) (if (= @v null) (emit CHROME_FAIL { code: "bad-reply" error: "the page answered text of an unexpected shape" }) (if (not @v.found) (emit CHROME_FAIL { code: "not-found" error: "no element matched" }) (set @entity.stage "dl-wait"))))))))
      CHROME_REPLY -> busy when (= @payload.key "key-down")
        (let ((d (object/get @config.keys @entity.keyName)))
          (do (set @entity.stage "key-up") (emit CDP_COMMAND { key: "key-up" method: "Input.dispatchKeyEvent" sessionId: @entity.sessionId paramsJson: (json/stringify { type: "keyUp" key: @d.key code: @d.code windowsVirtualKeyCode: @d.vk modifiers: (if @entity.shift 8 0) }) })))
      CHROME_REPLY -> ready when (and (= @payload.key "key-up") (not @entity.keyNav))
        (emit PAGE_KEY_SENT { key: @entity.callerKey })
      CHROME_REPLY -> busy when (and (= @payload.key "key-up") @entity.keyNav)
        (set @entity.stage "key-settle")
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.keyNavigationWaitMs })
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (= @entity.stage "key-settle") @entity.navSeen (not @entity.loadSeen))
        (set @entity.stage "key-load")
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.navigationTimeoutMs })
      CHROME_TIMER_DUE -> ready when (and (= @payload.key "op") (= @entity.stage "key-settle") (or (not @entity.navSeen) @entity.loadSeen))
        (emit PAGE_KEY_SENT { key: @entity.callerKey })
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (= @entity.stage "key-load"))
        (emit CHROME_FAIL { code: "navigation-timeout" error: "the page did not fire its load event in time" })
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (or (= @entity.stage "key-down") (= @entity.stage "key-up") (= @entity.stage "key-settle")))
        (set @entity.loadSeen true)
      CHROME_EVENT -> ready when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "key-load"))
        (emit CHROME_TIMER_CANCEL { key: "op" })
        (emit PAGE_KEY_SENT { key: @entity.callerKey })
      CHROME_REPLY -> ready when (= @payload.key "focused")
        (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (let ((v (json/parse @r.result.result.value FocusRead))) (if (= @v null) (emit PAGE_FAILED { key: @entity.callerKey error: "the page answered text of an unexpected shape" code: "bad-reply" }) (emit PAGE_FOCUS_READ { key: @entity.callerKey focused: @v.focused })))))))
      CHROME_REPLY -> ready when (= @payload.key "viewport")
        (emit PAGE_VIEWPORT_SET { key: @entity.callerKey })
      CHROME_REPLY -> ready when (= @payload.key "screenshot")
        (let ((r (json/parse @payload.frame DataReply)))
          (let ((b (bytes/from-base64 (default @r.result.data ""))))
            (if (or (= @r null) (= @b null)) (emit PAGE_FAILED { key: @entity.callerKey error: "Page.captureScreenshot answered an unexpected shape" code: "bad-reply" }) (emit PAGE_SCREENSHOT_TAKEN { key: @entity.callerKey png: @b }))))
      CHROME_REPLY -> ready when (= @payload.key "ax")
        (let ((r (json/parse @payload.frame AxReply)))
          (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "Accessibility.getFullAXTree answered an unexpected shape" code: "bad-reply" }) (emit PAGE_AX_TREE_READ { key: @entity.callerKey nodes: (array/map @r.result.nodes (fn n (object/merge { id: @n.nodeId role: (default @n.role.value "") name: (default @n.name.value "") ignored: (default @n.ignored false) } (if (= @n.parentId null) {} { parent: @n.parentId })))) })))
      CHROME_REPLY -> busy when (= @payload.key "pdf-nav")
        (let ((r (json/parse @payload.frame NavigateReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "Page.navigate answered an unexpected shape" })
            (if (!= @r.result.errorText null) (emit CHROME_FAIL { code: "navigation-failed" error: @r.result.errorText })
              (if @entity.loadSeen
                (do (emit CHROME_TIMER_CANCEL { key: "op" }) (set @entity.stage "pdf-print") (emit CDP_COMMAND { key: "pdf-print" method: "Page.printToPDF" sessionId: @entity.sessionId paramsJson: (json/stringify { printBackground: true preferCSSPageSize: true }) }))
                (set @entity.stage "pdf-load")))))
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "pdf-nav"))
        (set @entity.loadSeen true)
      CHROME_EVENT -> busy when (and (= @payload.method "Page.loadEventFired") (= (default @payload.sessionId "") (default @entity.sessionId "")) (= @entity.stage "pdf-load"))
        (emit CHROME_TIMER_CANCEL { key: "op" })
        (set @entity.stage "pdf-print")
        (emit CDP_COMMAND { key: "pdf-print" method: "Page.printToPDF" sessionId: @entity.sessionId paramsJson: (json/stringify { printBackground: true preferCSSPageSize: true }) })
      CHROME_REPLY -> busy when (= @payload.key "el-doc")
        (let ((r (json/parse @payload.frame DocReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "DOM.getDocument answered an unexpected shape" })
            (do (set @entity.stage "el-query") (emit CDP_COMMAND { key: "el-query" method: "DOM.querySelector" sessionId: @entity.sessionId paramsJson: (json/stringify { nodeId: @r.result.root.nodeId selector: @entity.selector }) }))))
      CHROME_REPLY -> busy when (= @payload.key "el-query")
        (let ((r (json/parse @payload.frame QueryReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "DOM.querySelector answered an unexpected shape" })
            (if (= @r.result.nodeId 0) (emit CHROME_FAIL { code: "element-missing" error: "no element matched the selector" })
              (do (set @entity.nodeId @r.result.nodeId) (set @entity.stage "el-scroll") (emit CDP_COMMAND { key: "el-scroll" method: "DOM.scrollIntoViewIfNeeded" sessionId: @entity.sessionId paramsJson: (json/stringify { nodeId: @r.result.nodeId }) })))))
      CHROME_REPLY -> busy when (= @payload.key "el-scroll")
        (set @entity.stage "el-settle")
        (emit CHROME_TIMER_ARM { key: "op" delayMs: @config.elementSettleMs })
      CHROME_TIMER_DUE -> busy when (and (= @payload.key "op") (= @entity.stage "el-settle"))
        (set @entity.stage "el-box")
        (emit CDP_COMMAND { key: "el-box" method: "DOM.getBoxModel" sessionId: @entity.sessionId paramsJson: (json/stringify { nodeId: @entity.nodeId }) })
      CHROME_REPLY -> busy when (= @payload.key "el-box")
        (let ((r (json/parse @payload.frame BoxReply)))
          (if (or (= @r null) (< (array/len @r.result.model.border) 8)) (emit CHROME_FAIL { code: "bad-reply" error: "DOM.getBoxModel answered an unexpected shape" })
            (let ((x (default (array/nth @r.result.model.border 0) 0)) (y (default (array/nth @r.result.model.border 1) 0)) (w (- (default (array/nth @r.result.model.border 2) 0) (default (array/nth @r.result.model.border 0) 0))) (h (- (default (array/nth @r.result.model.border 5) 0) (default (array/nth @r.result.model.border 1) 0))))
              (if (or (<= @w 0) (<= @h 0)) (emit CHROME_FAIL { code: "element-hidden" error: "the element has no width or height" })
                (do (set @entity.elRect { x: @x y: @y width: @w height: @h }) (set @entity.stage "el-metrics") (emit CDP_COMMAND { key: "el-metrics" method: "Page.getLayoutMetrics" sessionId: @entity.sessionId paramsJson: (json/stringify { }) }))))))
      CHROME_REPLY -> busy when (= @payload.key "el-metrics")
        (let ((r (json/parse @payload.frame MetricsReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "Page.getLayoutMetrics answered an unexpected shape" })
            (let ((px (+ @entity.elRect.x @r.result.cssVisualViewport.pageX)) (py (+ @entity.elRect.y @r.result.cssVisualViewport.pageY)))
              (let ((x0 (math/max 0 (- @px @entity.shotMargin))) (y0 (math/max 0 (- @py @entity.shotMargin))) (x1 (math/min @r.result.contentSize.width (+ @px @entity.elRect.width @entity.shotMargin))) (y1 (math/min @r.result.contentSize.height (+ @py @entity.elRect.height @entity.shotMargin))))
                (do
                  (set @entity.shotClip { x: @x0 y: @y0 width: (- @x1 @x0) height: (- @y1 @y0) })
                  (set @entity.shotBox { x: (- @px @x0) y: (- @py @y0) width: @entity.elRect.width height: @entity.elRect.height })
                  (set @entity.stage "el-shot")
                  (emit CDP_COMMAND { key: "el-shot" method: "Page.captureScreenshot" sessionId: @entity.sessionId paramsJson: (json/stringify (object/merge { format: @entity.shotFormat captureBeyondViewport: true clip: { x: @x0 y: @y0 width: (- @x1 @x0) height: (- @y1 @y0) scale: 1 } } (if (and (= @entity.shotFormat "jpeg") (!= @entity.shotQuality null)) { quality: @entity.shotQuality } {}))) }))))))
      CHROME_REPLY -> ready when (= @payload.key "el-shot")
        (let ((r (json/parse @payload.frame DataReply)))
          (let ((b (bytes/from-base64 (default @r.result.data ""))))
            (if (or (= @r null) (= @b null)) (emit PAGE_FAILED { key: @entity.callerKey error: "Page.captureScreenshot answered an unexpected shape" code: "bad-reply" }) (emit PAGE_ELEMENT_SHOT_TAKEN { key: @entity.callerKey image: @b format: @entity.shotFormat clip: @entity.shotClip box: @entity.shotBox }))))
      CHROME_REPLY -> ready when (= @payload.key "preload")
        (let ((r (json/parse @payload.frame PreloadReply)))
          (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "Page.addScriptToEvaluateOnNewDocument answered an unexpected shape" code: "bad-reply" }) (emit PAGE_PRELOADED { key: @entity.callerKey identifier: @r.result.identifier })))
      CHROME_REPLY -> busy when (= @payload.key "pdf-blank")
        (set @entity.stage "pdf-tree")
        (emit CDP_COMMAND { key: "pdf-tree" method: "Page.getFrameTree" sessionId: @entity.sessionId paramsJson: (json/stringify { }) })
      CHROME_REPLY -> busy when (= @payload.key "pdf-tree")
        (let ((r (json/parse @payload.frame FrameTreeReply)))
          (if (= @r null) (emit CHROME_FAIL { code: "bad-reply" error: "Page.getFrameTree answered an unexpected shape" })
            (do (set @entity.stage "pdf-set") (emit CDP_COMMAND { key: "pdf-set" method: "Page.setDocumentContent" sessionId: @entity.sessionId paramsJson: (json/stringify { frameId: @r.result.frameTree.frame.id html: @entity.html }) }))))
      CHROME_REPLY -> busy when (= @payload.key "pdf-set")
        (set @entity.stage "pdf-print")
        (emit CDP_COMMAND { key: "pdf-print" method: "Page.printToPDF" sessionId: @entity.sessionId paramsJson: (json/stringify { printBackground: true preferCSSPageSize: true }) })
      CHROME_REPLY -> ready when (= @payload.key "pdf-print")
        (let ((r (json/parse @payload.frame DataReply)))
          (let ((b (bytes/from-base64 (default @r.result.data ""))))
            (if (or (= @r null) (= @b null)) (emit PAGE_FAILED { key: @entity.callerKey error: "Printing answered an unexpected shape" code: "bad-reply" }) (emit PAGE_PDF_PRINTED { key: @entity.callerKey pdf: @b }))))
      CHROME_FILE_READ -> busy when (= @entity.stage "inject-read")
        (set @entity.stage "inject")
        (emit CDP_COMMAND { key: "inject" method: "Runtime.evaluate" sessionId: @entity.sessionId paramsJson: (json/stringify { expression: (bytes/to-string @payload.data) }) })
      CHROME_FILE_READ -> busy when (= @entity.stage "preload-read")
        (set @entity.stage "preload")
        (emit CDP_COMMAND { key: "preload" method: "Page.addScriptToEvaluateOnNewDocument" sessionId: @entity.sessionId paramsJson: (json/stringify { source: (bytes/to-string @payload.data) }) })
      CHROME_REPLY -> ready when (= @payload.key "inject")
        (let ((r (json/parse @payload.frame InjectReply)))
          (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "Runtime.evaluate answered an unexpected shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (emit PAGE_INJECTED { key: @entity.callerKey }))))
      CHROME_REPLY -> ready when (= @payload.key "measure")
        (let ((h (json/parse @payload.frame MeasureHead)))
          (if (= @h null) (emit PAGE_FAILED { key: @entity.callerKey error: "Runtime.evaluate answered an unexpected shape" code: "bad-reply" })
            (if (!= @h.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @h.result.exceptionDetails.exception.description @h.result.exceptionDetails.exception.value) @h.result.exceptionDetails.text) code: "script-error" })
              (if (!= @h.result.result.type "string") (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" })
                (let ((r (json/parse @payload.frame EvalReply))) (if (= @r null) (emit PAGE_FAILED { key: @entity.callerKey error: "the evaluate reply is not the declared shape" code: "bad-reply" }) (if (!= @r.result.exceptionDetails null) (emit PAGE_FAILED { key: @entity.callerKey error: (default (default @r.result.exceptionDetails.exception.description @r.result.exceptionDetails.exception.value) @r.result.exceptionDetails.text) code: "script-error" }) (if (= @r.result.result.value null) (emit PAGE_FAILED { key: @entity.callerKey error: "the expression did not evaluate to a string" code: "not-json" }) (emit PAGE_MEASURED { key: @entity.callerKey json: @r.result.result.value })))))))))
    }

    state stopping {
      INIT -> stopping

      CHROME_START -> stopping
        (emit CHROME_FAILED { code: "busy" message: "the browser is stopping" })
      CHROME_STOP -> stopping

      PAGE_NAVIGATE -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_TEXT -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_LINKS -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_CLICK -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_KEY -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_FOCUSED -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_VIEWPORT -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_SCREENSHOT -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_AX_TREE -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_DOWNLOAD -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_PRINT_PDF -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_INJECT -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_MEASURE -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_ELEMENT_SHOT -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      PAGE_PRELOAD -> stopping
        (emit PAGE_FAILED { key: @payload.key error: "the browser is stopping" code: "not-ready" })
      CHROME_REPLY -> stopping when (= @payload.key "close-target")
        (set @entity.stage "disconnect")
        (emit CDP_DISCONNECT { })
      CHROME_ERROR -> stopping when (= @payload.key "close-target")
        (set @entity.stage "disconnect")
        (emit CDP_DISCONNECT { })
      CHROME_DISCONNECTED -> stopping
        (set @entity.stage "daemon-stop")
        (emit DAEMON_STOP { })
      CHROME_DAEMON_STOPPED -> stopped
        (set @entity.sessionId "")
        (emit CHROME_STOPPED { })
      CHROME_DAEMON_FAILED -> stopped
        (set @entity.sessionId "")
        (emit CHROME_STOPPED { })
    }

    emits {
      CHROME_READY -> external {
        browser : string!
        targetId : string!
      }
        @description "Chrome is running with one attached page; browser is its version string and targetId the page target's id."
        @tier "primary"
      CHROME_FAILED -> external {
        code : string!
        message : string!
      }
        @description "Chrome could not be started or was lost: the daemon or connection code, host-failed, bad-reply, disconnected, busy or already-started."
        @tier "primary"
      PAGE_LOADED -> external {
        key : string!
        url : string!
        title : string!
      }
        @description "The page fired its load event; url and title are read after it."
        @tier "primary"
      PAGE_TEXT_READ -> external {
        key : string!
        url : string!
        title : string!
        lang : string!
        text : string!
      }
        @description "The visible text of the page with its url, title and language."
        @tier "primary"
      PAGE_LINKS_READ -> external {
        key : string!
        links : [PageLink]!
      }
        @description "Every link and button of the page in document order."
        @tier "primary"
      PAGE_CLICKED -> external {
        key : string!
        url : string!
        navigated : boolean!
      }
        @description "The element was clicked; navigated tells whether the location changed."
        @tier "primary"
      PAGE_KEY_SENT -> external {
        key : string!
      }
        @description "The key press was delivered."
        @tier "primary"
      PAGE_FOCUS_READ -> external {
        key : string!
        focused : PageFocus?
      }
        @description "The focused element; absent when nothing but the body has focus."
        @tier "primary"
      PAGE_VIEWPORT_SET -> external {
        key : string!
      }
        @description "The viewport metrics are set."
        @tier "primary"
      PAGE_SCREENSHOT_TAKEN -> external {
        key : string!
        png : bytes!
      }
        @description "A PNG of the viewport or of the whole page."
        @tier "primary"
      PAGE_AX_TREE_READ -> external {
        key : string!
        nodes : [PageAxNode]!
      }
        @description "The accessibility tree nodes with role, name, parent and ignored flag."
        @tier "primary"
      PAGE_DOWNLOADED -> external {
        key : string!
        path : string!
        url : string!
        size : number!
      }
        @description "The download finished: path is the file Chrome reports it saved (the download directory joined with the suggested file name when it reports none)."
        @tier "primary"
      PAGE_PDF_PRINTED -> external {
        key : string!
        pdf : bytes!
      }
        @description "The given HTML, or the file at the given path, printed to a PDF."
        @tier "primary"
      PAGE_ELEMENT_SHOT_TAKEN -> external {
        key : string!
        image : bytes!
        format : string!
        clip : PageRect!
        box : PageRect!
      }
        @description "The image of one element with its margin: clip is the captured rectangle in page coordinates, box the element rectangle relative to the clip origin; both in CSS pixels."
        @tier "primary"
      PAGE_PRELOADED -> external {
        key : string!
        identifier : string!
      }
        @description "The script is registered to run in every document the tab loads from now on; identifier is Chrome's script id."
        @tier "primary"
      PAGE_INJECTED -> external {
        key : string!
      }
        @description "The script ran in the page."
        @tier "primary"
      PAGE_MEASURED -> external {
        key : string!
        json : string!
      }
        @description "The JSON text the measurement expression returned, for the caller to parse."
        @tier "primary"
      PAGE_FAILED -> external {
        key : string!
        error : string!
        code : string!
      }
        @description "A page operation failed: busy, not-ready, not-started, bad-request, bad-script, unknown-key, not-found, element-missing, element-hidden, navigation-failed, navigation-timeout, download-timeout, download-canceled, script-error, not-json, bad-reply, read-failed, disconnected, stopped, or the protocol code text."
        @tier "primary"
      CHROME_STOPPED -> external { }
        @description "The tab is closed and the browser this atom started is stopped."
        @tier "primary"
      CHROME_START_FAILED -> internal {
        code : string!
        message : string!
      }
        @description "Internal: a start step failed."
        @tier "internal"
      CHROME_FAIL -> internal {
        code : string!
        error : string!
      }
        @description "Internal: the operation in flight failed."
        @tier "internal"
      CHROME_DL_PROGRESS -> internal {
        guid : string!
        state : string!
        received : number!
        filePath : string
      }
        @description "Internal: a parsed Browser.downloadProgress event."
        @tier "internal"
      CHROME_DIR_MADE -> internal { }
        @description "Internal: os/mkdir answered."
        @tier "internal"
      CHROME_PATH_RESOLVED -> internal {
        path : string!
      }
        @description "Internal: os/realpath answered."
        @tier "internal"
      CHROME_FILE_WROTE -> internal { }
        @description "Internal: os/write-file answered."
        @tier "internal"
      CHROME_FILE_READ -> internal {
        data : bytes!
      }
        @description "Internal: os/read-file answered."
        @tier "internal"
      CHROME_HOST_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: an os/ effect failed."
        @tier "internal"
      CHROME_TIMER_ARM {
        key : string!
        delayMs : number!
      }
        @description "Internal: arm a keyed deadline."
        @tier "internal"
      CHROME_TIMER_CANCEL {
        key : string!
      }
        @description "Internal: disarm a keyed deadline."
        @tier "internal"
      DAEMON_START {
        argv : [string]!
      }
        @description "Internal: launch Chrome through the daemon."
        @tier "internal"
      DAEMON_STOP { }
        @description "Internal: stop the Chrome this atom started."
        @tier "internal"
      CDP_CONNECT { }
        @description "Internal: open the debugging connection."
        @tier "internal"
      CDP_DISCONNECT { }
        @description "Internal: close the debugging connection."
        @tier "internal"
      CDP_COMMAND {
        key : string!
        method : string!
        sessionId : string?
        paramsJson : string!
      }
        @description "Internal: one protocol command."
        @tier "internal"
    }

    config {
      port : number = 9222
        @label "Debugging port"
        @description "The remote debugging port Chrome is launched with. The composed daemon probe and the CDP connection read their own port: a composer that changes this knob also sets readyPort of ChromeDaemon and port of CdpHttp and CdpWs to the same number, and grants net 127.0.0.1 on it."
        @tier "infra"
      profileDir : ChromePath
        @label "Profile directory"
        @description "The anchored directory Chrome keeps its user profile in, created when missing; Required, no default. The composer grants fs create and read on it."
        @tier "domain"
      downloadDir : ChromePath
        @label "Download directory"
        @description "The anchored directory downloads are saved in, created when missing; Required, no default. A name already taken is saved by Chrome under a numbered name, and the path reported is the one Chrome names."
        @tier "domain"
      preferences : string = "{\"plugins\":{\"always_open_pdf_externally\":true}}"
        @label "Chrome preferences"
        @description "The JSON written to Default/Preferences of the profile before launch, replacing any file there, so use a fresh profile. The default makes Chrome save a PDF link instead of opening it in its viewer, which PAGE_DOWNLOAD needs; an empty text writes nothing and leaves PDFs to the viewer."
        @tier "policy"
      preferencesDir : ChromePath
        @label "Preferences directory"
        @description "The anchored directory of the profile that holds Preferences (profileDir/Default); Required, no default. It is its own knob, with preferencesFile, because an os/ target must be static for the grant check; a composer that sets profileDir sets all three consistently."
        @tier "domain"
      preferencesFile : ChromePath
        @label "Preferences file"
        @description "The anchored path of the Preferences file written before launch (profileDir/Default/Preferences); Required, no default."
        @tier "domain"
      keyNavigationWaitMs : number = 1500
        @label "Key navigation wait (ms)"
        @description "After a key whose row in the keys table has nav true (Enter, Space), how long PAGE_KEY waits for a main-frame navigation to begin before answering PAGE_KEY_SENT; when one began it waits for its load event, up to navigationTimeoutMs."
        @tier "domain"
      scriptDir : string
        @label "Script directory"
        @description "A directory under the working directory, ending with /, that PAGE_INJECT script paths are relative to. The composer sets it and grants fs read on it."
        @tier "domain"
      extraArgs : [string] = []
        @label "Extra Chrome arguments"
        @description "Arguments appended to the launch command. Empty by default: --no-sandbox is NOT default, because it drops the browser sandbox, and only a container that cannot create user namespaces (the organism that runs Chrome as root in a container) sets it."
        @tier "policy"
      navigationTimeoutMs : number = 30000
        @label "Navigation timeout (ms)"
        @description "How long PAGE_NAVIGATE waits for the load event before answering PAGE_FAILED navigation-timeout. Resolution is the 100ms deadline check of std-delay."
        @tier "domain"
      waitFor : "load" | "networkIdle" = "load"
        @label "Navigation settle mode"
        @description "What PAGE_NAVIGATE waits for. load answers PAGE_LOADED at the load event. networkIdle also enables Page.setLifecycleEventsEnabled, waits for a Page.lifecycleEvent named networkIdle of the navigated frame after the load event, evaluates fontsScript, then waits settleMs; the whole wait is inside navigationTimeoutMs."
        @tier "domain"
      settleMs : number = 0
        @label "Settle wait (ms)"
        @description "With waitFor networkIdle, how long PAGE_NAVIGATE waits after network idle and fonts ready before it reads the location and answers PAGE_LOADED; it has no effect with waitFor load."
        @tier "domain"
      fontsScript : string = "document.fonts.ready.then(() => true)"
        @label "Fonts-ready expression"
        @description "Page expression, awaited as a promise, that PAGE_NAVIGATE evaluates after network idle."
        @tier "infra"
      elementSettleMs : number = 150
        @label "Element settle (ms)"
        @description "How long PAGE_ELEMENT_SHOT waits after scrolling the element into view before it measures the element."
        @tier "domain"
      elementMargin : number = 160
        @label "Element margin"
        @description "The default margin, in CSS pixels, PAGE_ELEMENT_SHOT adds around the element when the request has none; the clip is clamped inside the page content."
        @tier "domain"
      windowWidth : number = 1280
        @label "Window width"
        @description "Width of the browser window at launch, in pixels."
        @tier "domain"
      windowHeight : number = 800
        @label "Window height"
        @description "Height of the browser window at launch, in pixels."
        @tier "domain"
      clickSettleMs : number = 500
        @label "Click settle (ms)"
        @description "How long PAGE_CLICK waits after the click for a navigation to begin before it reads the location; navigated is a changed location or a main-frame Page.frameNavigated in that window."
        @tier "domain"
      downloadTimeoutMs : number = 30000
        @label "Download timeout (ms)"
        @description "How long PAGE_DOWNLOAD waits for the download to complete before answering PAGE_FAILED download-timeout."
        @tier "domain"
      elementSelector : string = "a[href], button, [role=button]"
        @label "Clickable elements"
        @description "The CSS selector PAGE_LINKS enumerates, in document order; PAGE_CLICK and PAGE_DOWNLOAD index into the same list."
        @tier "domain"
      downloadExtensions : [string] = ["pdf", "doc", "docx", "xls", "xlsx", "zip", "csv"]
        @label "Download extensions"
        @description "Lower-case file extensions that mark a link as a download when it has no download attribute."
        @tier "domain"
      keys : Map string ChromeKey = { Tab: { key: "Tab", code: "Tab", vk: 9 }, Enter: { key: "Enter", code: "Enter", vk: 13, text: "\r", nav: true }, Space: { key: " ", code: "Space", vk: 32, text: " ", nav: true }, Escape: { key: "Escape", code: "Escape", vk: 27 }, ArrowDown: { key: "ArrowDown", code: "ArrowDown", vk: 40 }, ArrowUp: { key: "ArrowUp", code: "ArrowUp", vk: 38 }, ArrowLeft: { key: "ArrowLeft", code: "ArrowLeft", vk: 37 }, ArrowRight: { key: "ArrowRight", code: "ArrowRight", vk: 39 }, Home: { key: "Home", code: "Home", vk: 36 }, End: { key: "End", code: "End", vk: 35 } }
        @label "Key table"
        @description "Per key name, the DOM key, code, windowsVirtualKeyCode and the text a press types; PAGE_KEY sends keyDown then keyUp from this row, with modifiers 8 for Shift."
        @tier "domain"
      implicitRoles : Map string string = { a: "link", button: "button", select: "combobox", textarea: "textbox", "input:text": "textbox", "input:search": "searchbox", "input:email": "textbox", "input:password": "textbox", "input:checkbox": "checkbox", "input:radio": "radio", "input:submit": "button", "input:button": "button" }
        @label "Implicit roles"
        @description "Role per tag, or per input:<type>, that PAGE_FOCUSED reports when the focused element has no role attribute."
        @tier "domain"
      textScript : string = "JSON.stringify({url:location.href,title:document.title,lang:document.documentElement.lang,text:document.body.innerText})"
        @label "Text expression"
        @description "Page expression behind PAGE_TEXT; it evaluates to a JSON string of url, title, lang and visible text."
        @tier "infra"
      infoScript : string = "JSON.stringify({url:location.href,title:document.title})"
        @label "Location expression"
        @description "Page expression that reads the location and title after a navigation or a click."
        @tier "infra"
      linksScript : string = "((a)=>{const els=[...document.querySelectorAll(a.sel)];return JSON.stringify(els.map((e,i)=>{const isA=e.tagName==='A';const href=isA?e.href:'';const path=isA?new URL(href).pathname:'';const ext=path.includes('.')?path.split('.').pop().toLowerCase():'';return {index:i,text:(e.innerText||'').trim()||e.getAttribute('aria-label')||'',href:href,download:isA&&(e.hasAttribute('download')||a.exts.includes(ext)),kind:isA?'link':'button'};}));})"
        @label "Links function"
        @description "Page function taking { sel, exts } that lists the clickable elements as a JSON string; measuring only."
        @tier "infra"
      clickScript : string = "((a)=>{const e=a.selector!==null?document.querySelector(a.selector):([...document.querySelectorAll(a.sel)][a.index]||null);if(!e){return JSON.stringify({found:false,url:location.href});}const u=location.href;e.click();return JSON.stringify({found:true,url:u});})"
        @label "Click function"
        @description "Page function taking { sel, index, selector } that clicks one element and answers { found, url } as a JSON string."
        @tier "infra"
      focusScript : string = "((r)=>{const e=document.activeElement;if(!e||e===document.body||e===document.documentElement){return JSON.stringify({focused:null});}const tag=e.tagName.toLowerCase();const key=tag==='input'?'input:'+(e.getAttribute('type')||'text'):tag;const role=e.getAttribute('role')||r[key]||r[tag]||'';const lb=e.getAttribute('aria-labelledby');const lt=lb?lb.split(' ').map(i=>{const n=document.getElementById(i);return n?n.innerText:'';}).join(' ').trim():'';const name=e.getAttribute('aria-label')||lt||(e.innerText||'').trim()||e.getAttribute('alt')||e.getAttribute('title')||'';const sel=(n)=>{if(n.id){return '#'+CSS.escape(n.id);}const p=[];let c=n;while(c&&c.nodeType===1&&c!==document.documentElement){const par=c.parentElement;const t=c.tagName.toLowerCase();if(!par){break;}const k=[...par.children].filter(x=>x.tagName===c.tagName);p.unshift(t+':nth-of-type('+(k.indexOf(c)+1)+')');c=par;}return 'html > '+p.join(' > ');};const b=e.getBoundingClientRect();return JSON.stringify({focused:{tag:tag,role:role,name:name,selector:sel(e),rect:{x:b.x,y:b.y,width:b.width,height:b.height}}});})"
        @label "Focus function"
        @description "Page function taking the implicit role table that reads the focused element: tag, role, accessible name (aria-label, aria-labelledby text, inner text, alt, title in that order), a unique CSS selector from the id or an nth-of-type path, and its rectangle."
        @tier "infra"
    }

    listens {
      CHROME_START { }
        @description "Launch headless Chrome, connect to it and attach one page target; answers CHROME_READY or CHROME_FAILED."
        @synonyms "start browser, launch chrome"
      CHROME_STOP { }
        @description "Close the tab, disconnect and stop the browser this atom started; answers CHROME_STOPPED."
        @synonyms "stop browser, quit chrome"
      PAGE_NAVIGATE {
        key : string!
        url : string!
      }
        @description "Load a URL and wait for its load event; answers PAGE_LOADED."
        @synonyms "open page, go to url"
      PAGE_TEXT {
        key : string!
      }
        @description "Read the url, title, language and visible text; answers PAGE_TEXT_READ."
        @synonyms "read page text"
      PAGE_LINKS {
        key : string!
      }
        @description "List every link and button in document order; answers PAGE_LINKS_READ."
        @synonyms "list links, list buttons"
      PAGE_CLICK {
        key : string!
        index : number
        selector : string
      }
        @description "Click the element at a PAGE_LINKS index or matching a CSS selector (exactly one); answers PAGE_CLICKED."
        @synonyms "click link, press button"
      PAGE_KEY {
        key : string!
        keyName : "Tab" | "Enter" | "Space" | "Escape" | "ArrowDown" | "ArrowUp" | "ArrowLeft" | "ArrowRight" | "Home" | "End"!
        shift : boolean
      }
        @description "Press one key, with Shift when asked; answers PAGE_KEY_SENT."
        @synonyms "press key, keyboard"
      PAGE_FOCUSED {
        key : string!
      }
        @description "Describe the focused element; answers PAGE_FOCUS_READ, focused absent when nothing but the body is focused."
        @synonyms "focused element, active element"
      PAGE_VIEWPORT {
        key : string!
        width : number!
        height : number!
        deviceScaleFactor : number!
        mobile : boolean!
        textZoom : number!
      }
        @description "Set the viewport. textZoom z is browser page zoom: the CSS viewport becomes width/z by height/z at device scale factor times z, so 2 at 1280x800 is 640x400 CSS pixels at twice the scale and text sized in px grows too; 1 restores the plain metrics. Answers PAGE_VIEWPORT_SET."
        @synonyms "resize, zoom, device metrics"
      PAGE_SCREENSHOT {
        key : string!
        fullPage : boolean!
      }
        @description "Take a PNG of the viewport, or of the whole page; answers PAGE_SCREENSHOT_TAKEN."
        @synonyms "screenshot, capture page"
      PAGE_AX_TREE {
        key : string!
      }
        @description "Read the full accessibility tree; answers PAGE_AX_TREE_READ."
        @synonyms "accessibility tree"
      PAGE_DOWNLOAD {
        key : string!
        index : number
        selector : string
      }
        @description "Click a link or button into the download directory and wait for the file; answers PAGE_DOWNLOADED."
        @synonyms "download file"
      PAGE_PRINT_PDF {
        key : string!
        html : string
        path : string
      }
        @description "Render the given HTML, or the local file at the absolute path (navigated as file://, waiting for load), to a PDF; exactly one of html and path, else PAGE_FAILED bad-request; answers PAGE_PDF_PRINTED."
        @synonyms "print pdf, html to pdf"
      PAGE_ELEMENT_SHOT {
        key : string!
        selector : string!
        margin : number
        format : "png" | "jpeg"
        quality : number
      }
        @description "Screenshot one element found by a CSS selector: scroll it into view, wait elementSettleMs, measure its border box and capture it with margin (default elementMargin) clamped inside the page content, without changing the page; quality applies to jpeg only. Answers PAGE_ELEMENT_SHOT_TAKEN, PAGE_FAILED element-missing when nothing matches, element-hidden when it has no box or no size."
        @synonyms "element screenshot, capture element"
      PAGE_PRELOAD {
        key : string!
        script : string!
      }
        @description "Register a script file, a path relative to scriptDir, to run in every document this tab loads from now on (Page.addScriptToEvaluateOnNewDocument); answers PAGE_PRELOADED, or PAGE_FAILED bad-script or read-failed."
        @synonyms "preload script, run on new document"
      PAGE_INJECT {
        key : string!
        script : string!
      }
        @description "Evaluate a script file, a path relative to scriptDir, in the page; answers PAGE_INJECTED or PAGE_FAILED bad-script."
        @synonyms "inject script"
      PAGE_MEASURE {
        key : string!
        expression : string!
      }
        @description "Evaluate an expression that returns a JSON string; answers PAGE_MEASURED with that text."
        @synonyms "measure page, evaluate"
      CHROME_DAEMON_READY {
        pid : number!
        reused : boolean!
      }
      CHROME_DAEMON_FAILED {
        code : string!
        message : string!
      }
      CHROME_DAEMON_STOPPED {
        pid : number!
      }
      CHROME_CONNECTED {
        browser : string!
      }
      CHROME_CDP_FAILED {
        error : string!
        kind : string!
      }
      CHROME_DISCONNECTED {
        reason : string!
      }
      CHROME_REPLY {
        key : string!
        method : string!
        frame : string!
      }
      CHROME_ERROR {
        key : string!
        method : string!
        code : string!
        message : string!
      }
      CHROME_EVENT {
        method : string!
        sessionId : string
        frame : string!
      }
      CHROME_TIMER_DUE {
        key : string!
      }
      ChromeDaemon.DAEMON_READY -> CHROME_DAEMON_READY with { pid: ?pid, reused: ?reused }
      ChromeDaemon.DAEMON_FAILED -> CHROME_DAEMON_FAILED with { code: ?code, message: ?message }
      ChromeDaemon.DAEMON_STOPPED -> CHROME_DAEMON_STOPPED with { pid: ?pid }
      Cdp.CDP_CONNECTED -> CHROME_CONNECTED with { browser: ?browser }
      Cdp.CDP_FAILED -> CHROME_CDP_FAILED with { error: ?error, kind: ?kind }
      Cdp.CDP_DISCONNECTED -> CHROME_DISCONNECTED with { reason: ?reason }
      Cdp.CDP_REPLY -> CHROME_REPLY with { key: ?key, method: ?method, frame: ?frame }
      Cdp.CDP_ERROR -> CHROME_ERROR with { key: ?key, method: ?method, code: ?code, message: ?message }
      Cdp.CDP_EVENT -> CHROME_EVENT with { method: ?method, sessionId: ?sessionId, frame: ?frame }
      ChromeDelay.ELAPSED -> CHROME_TIMER_DUE with { key: ?key }
    }
  }

  page boot as ChromePage -> Chrome, ChromeDaemon, Cdp, CdpHttp, CdpWs, CdpDelay, ChromeDelay
}
