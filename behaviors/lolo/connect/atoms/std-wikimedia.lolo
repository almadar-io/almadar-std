app std-wikimedia [
  version: "1.0.0",
  description: "std-wikimedia — redirect-resolved Wikipedia page lookup through the keyless MediaWiki API (en.wikipedia.org). WIKIMEDIA_GET_PAGE answers WIKIMEDIA_PAGE_RESULT with the page title, a one-line description, the Commons thumbnail and the lead-section extract; a blank title, a missing page or a non-2xx reply answers an empty page.",
  egress: ["https://en.wikipedia.org"]
]
uses Fetch from "std/behaviors/std-http-fetch"
type HttpHeader = { name : string!, value : string! }
type WikimediaThumbnail = { source : string, width : number, height : number }
type WikimediaPage = { pageid : number, ns : number, title : string, description : string?, extract : string?, thumbnail : WikimediaThumbnail?, missing : string }
type WikimediaQuery = { pages : Map string WikimediaPage }
type WikimediaReply = { batchcomplete : string, query : WikimediaQuery }
orbital WikimediaOrbital {
  entity WikimediaLookup [runtime] {
    id : string!
  }

  trait WikimediaFetch = Fetch.traits.HttpFetch {
    config {
      origin: "https://en.wikipedia.org"
      timeoutMs: 6000
    }
    listens {
      WikimediaClient.WIKIMEDIA_HTTP_SEND -> HTTP_SEND
    }
  }

  trait WikimediaClient -> WikimediaLookup [client] {
    initial: idle

    state idle {
      INIT -> idle

      WIKIMEDIA_GET_PAGE -> idle when (!= (str/trim @payload.title) "")
        (emit WIKIMEDIA_HTTP_SEND { key: "page", method: "GET", target: (str/concat "/w/api.php?action=query&format=json&redirects=1&prop=pageimages|description|extracts&explaintext=1&exintro=1&piprop=thumbnail&pithumbsize=240&titles=" (str/encode-uri-component (str/trim @payload.title))), headers: [{ name: "Accept", value: "*/*" }, { name: "User-Agent", value: @config.userAgent }], body: (bytes/from-string ""), stream: "none" })
      WIKIMEDIA_GET_PAGE -> idle when (= (str/trim @payload.title) "")
        (emit WIKIMEDIA_PAGE_RESULT {})
      WIKIMEDIA_PAGE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit WIKIMEDIA_PAGE_RESULT {})
      WIKIMEDIA_PAGE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((page (array/first (object/values (object/get (object/get (default (json/parse (default (bytes/to-string @payload.body) "") WikimediaReply) {}) query {}) pages {})))))
          (emit WIKIMEDIA_PAGE_RESULT (if (or (= @page null) (object/has @page missing)) {}
            (object/merge
              (if (validate/required (object/get @page title null)) { title: (object/get @page title "") } {})
              (if (validate/required (object/get @page description null)) { description: (object/get @page description "") }
                (if (validate/required (object/get @page extract null)) { description: (array/first (str/split (object/get @page extract "") ".")) } {}))
              (if (!= (object/get (object/get @page thumbnail {}) source null) null) { portraitUrl: (object/get (object/get @page thumbnail {}) source "") } {})
              (if (validate/required (object/get @page extract null)) { extract: (str/trim (str/slice (object/get @page extract "") 0 2000)) } {})))))
      WIKIMEDIA_PAGE_FAILED -> idle
        (emit WIKIMEDIA_PAGE_FAILURE { error: @payload.error, kind: @payload.kind })
    }

    emits {
      WIKIMEDIA_PAGE_RESULT -> external {
        title : string
        description : string
        portraitUrl : string
        extract : string
      }
        @description "The looked-up Wikipedia page: its title, a one-line description (the page's own, else the first sentence of the extract), the Commons thumbnail URL and the lead-section extract (at most 2000 characters, trimmed); every field is absent when the title is blank, the page is missing or the reply was not 2xx."
        @synonyms "wikipedia page, page summary, article lookup result"
        @tier "primary"
      WIKIMEDIA_PAGE_FAILURE -> external {
        error : string!
        kind : string!
      }
        @description "The Wikipedia call never produced a reply: error text and kind (timeout, failed or refused)."
        @synonyms "wikipedia unreachable, lookup failed"
        @tier "primary"
      WIKIMEDIA_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one request, for the HTTP fetch."
        @tier "internal"
    }

    listens {
      WIKIMEDIA_GET_PAGE -> input {
        title : string!
      }
        @description "Look up a Wikipedia page by title (redirects resolved)."
        @synonyms "lookup wikipedia, get article, find wikipedia page"
      WIKIMEDIA_PAGE_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
      WIKIMEDIA_PAGE_FAILED {
        key : string
        error : string!
        kind : string!
      }
      WikimediaFetch.HTTP_REPLIED -> WIKIMEDIA_PAGE_REPLIED
      WikimediaFetch.HTTP_FAILED -> WIKIMEDIA_PAGE_FAILED
    }

    config {
      userAgent : string = "Almadar/1.0 (https://almadar.dev)"
        @label "User-Agent"
        @description "Descriptive User-Agent header sent with every Wikipedia request."
        @synonyms "user agent, client id, request identity"
        @tier "infra"
    }
  }

  page boot as WikimediaPage -> WikimediaClient, WikimediaFetch
}
