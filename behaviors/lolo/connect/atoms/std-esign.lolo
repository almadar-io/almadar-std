app std-esign [
  version: "1.0.0",
  description: "std-esign — e-signature through the DocuSign eSignature REST API. ESIGN_SEND_ENVELOPE sends a document to one signer, ESIGN_GET_ENVELOPE_STATUS polls an envelope, ESIGN_DOWNLOAD_DOCUMENT fetches the combined signed PDF as base64. Each action answers with its result event, or its failure event ({code, message}) when DocuSign refuses (non-2xx), is unavailable (5xx) or cannot be reached.",
  net: { "demo.docusign.net:443": [tcp], "na1.docusign.net:443": [tcp], "na2.docusign.net:443": [tcp], "na3.docusign.net:443": [tcp], "na4.docusign.net:443": [tcp], "eu.docusign.net:443": [tcp], "au.docusign.net:443": [tcp], "ca.docusign.net:443": [tcp], "*.docusign.net:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
type DocusignEnvelopeReply = { envelopeId : string, status : string, completedDateTime : string }
orbital EsignOrbital {
  entity EsignEnvelope [runtime] {
    id : string!
  }

  trait EsignHttpFrame = Frame.traits.HttpFrame {
    listens {
      EsignHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait EsignHttp = Http.traits.HttpClient {
    config {
      host: "demo.docusign.net"
      port: 443
      tls: true
      serverName: "demo.docusign.net"
      dynamicHost: true
      credential: "DOCUSIGN_ACCESS_TOKEN"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      EsignClient.ESIGN_HTTP_SEND -> HTTP_SEND
      EsignTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
      EsignHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      EsignHttpFrame.FRAME_DRAINED -> HC_DRAINED
      EsignHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait EsignTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      EsignClient.ESIGN_HTTP_SEND -> START with { key: (as ?key CallKey) }
      EsignHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      EsignHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait EsignClient -> EsignEnvelope [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      ESIGN_SEND_ENVELOPE -> idle when (str/startsWith @config.origin "https://")
        (emit ESIGN_HTTP_SEND {
          key: "send",
          method: "POST",
          target: (str/concat (if (str/endsWith @config.basePath "/") (str/slice @config.basePath 0 (- (str/len @config.basePath) 1)) @config.basePath) "/envelopes"),
          headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string (json/stringify {
            emailSubject: (default @payload.emailSubject (str/concat "Please sign: " @payload.documentName)),
            status: "sent",
            documents: [{
              documentBase64: (if (and (str/startsWith @payload.documentContent "data:") (str/includes @payload.documentContent ",")) (str/join (array/drop (str/split @payload.documentContent ",") 1) ",") @payload.documentContent),
              name: @payload.documentName,
              fileExtension: (if (= (array/last (str/split @payload.documentName ".")) "") "pdf" (array/last (str/split @payload.documentName "."))),
              documentId: "1"
            }],
            recipients: { signers: [{ email: @payload.recipientEmail, name: @payload.recipientName, recipientId: "1", routingOrder: "1" }] }
          })),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      ESIGN_SEND_ENVELOPE -> idle when (not (str/startsWith @config.origin "https://"))
        (emit ESIGN_SEND_ENVELOPE_FAILED { message: "the origin knob must be an https:// origin" })
      ESIGN_SEND_ENVELOPE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((reply (json/parse @payload.body DocusignEnvelopeReply)))
          (if (= @reply null)
            (emit ESIGN_SEND_ENVELOPE_FAILED { message: "DocuSign answered a body that is not an envelope" })
            (emit ESIGN_ENVELOPE_SENT { envelopeId: (object/get @reply envelopeId ""), status: (object/get @reply status "sent") })))
      ESIGN_SEND_ENVELOPE_REPLIED -> idle when (>= @payload.status 500)
        (emit ESIGN_SEND_ENVELOPE_FAILED { message: (str/concat "DocuSign returned " @payload.status) })
      ESIGN_SEND_ENVELOPE_REPLIED -> idle when (or (< @payload.status 200) (and (>= @payload.status 300) (< @payload.status 500)))
        (emit ESIGN_SEND_ENVELOPE_FAILED { message: (str/concat "DocuSign error " @payload.status ": " (str/slice @payload.body 0 300)) })
      ESIGN_SEND_ENVELOPE_UNREACHED -> idle
        (emit ESIGN_SEND_ENVELOPE_FAILED { message: @payload.error })

      ESIGN_GET_ENVELOPE_STATUS -> idle when (str/startsWith @config.origin "https://")
        (emit ESIGN_HTTP_SEND {
          key: "status",
          method: "GET",
          target: (str/concat (if (str/endsWith @config.basePath "/") (str/slice @config.basePath 0 (- (str/len @config.basePath) 1)) @config.basePath) "/envelopes/" @payload.envelopeId),
          headers: [{ name: "accept", value: "application/json" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string ""),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      ESIGN_GET_ENVELOPE_STATUS -> idle when (not (str/startsWith @config.origin "https://"))
        (emit ESIGN_GET_ENVELOPE_STATUS_FAILED { message: "the origin knob must be an https:// origin" })
      ESIGN_GET_ENVELOPE_STATUS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((reply (json/parse @payload.body DocusignEnvelopeReply)))
          (if (= @reply null)
            (emit ESIGN_GET_ENVELOPE_STATUS_FAILED { message: "DocuSign answered a body that is not an envelope" })
            (emit ESIGN_ENVELOPE_STATUS { status: (object/get @reply status ""), completedAt: (object/get @reply completedDateTime "") })))
      ESIGN_GET_ENVELOPE_STATUS_REPLIED -> idle when (>= @payload.status 500)
        (emit ESIGN_GET_ENVELOPE_STATUS_FAILED { message: (str/concat "DocuSign returned " @payload.status) })
      ESIGN_GET_ENVELOPE_STATUS_REPLIED -> idle when (or (< @payload.status 200) (and (>= @payload.status 300) (< @payload.status 500)))
        (emit ESIGN_GET_ENVELOPE_STATUS_FAILED { message: (str/concat "DocuSign error " @payload.status ": " (str/slice @payload.body 0 300)) })
      ESIGN_GET_ENVELOPE_STATUS_UNREACHED -> idle
        (emit ESIGN_GET_ENVELOPE_STATUS_FAILED { message: @payload.error })

      ESIGN_DOWNLOAD_DOCUMENT -> idle when (str/startsWith @config.origin "https://")
        (emit ESIGN_HTTP_SEND {
          key: (str/concat "download:" @payload.envelopeId),
          method: "GET",
          target: (str/concat (if (str/endsWith @config.basePath "/") (str/slice @config.basePath 0 (- (str/len @config.basePath) 1)) @config.basePath) "/envelopes/" @payload.envelopeId "/documents/combined"),
          headers: [{ name: "accept", value: "application/pdf" }, { name: "content-type", value: "application/json" }],
          body: (bytes/from-string ""),
          stream: "none",
          host: (str/slice @config.origin 8 (str/len @config.origin))
        })
      ESIGN_DOWNLOAD_DOCUMENT -> idle when (not (str/startsWith @config.origin "https://"))
        (emit ESIGN_DOWNLOAD_DOCUMENT_FAILED { message: "the origin knob must be an https:// origin" })
      ESIGN_DOWNLOAD_DOCUMENT_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit ESIGN_DOCUMENT_DOWNLOADED { content: @payload.body, documentName: (str/concat "envelope-" (default @payload.key "") ".pdf") })
      ESIGN_DOWNLOAD_DOCUMENT_REPLIED -> idle when (>= @payload.status 500)
        (emit ESIGN_DOWNLOAD_DOCUMENT_FAILED { message: (str/concat "DocuSign returned " @payload.status) })
      ESIGN_DOWNLOAD_DOCUMENT_REPLIED -> idle when (or (< @payload.status 200) (and (>= @payload.status 300) (< @payload.status 500)))
        (emit ESIGN_DOWNLOAD_DOCUMENT_FAILED { message: (str/concat "DocuSign error " @payload.status ": " (str/slice (default (base64/decode @payload.body) "") 0 300)) })
      ESIGN_DOWNLOAD_DOCUMENT_UNREACHED -> idle
        (emit ESIGN_DOWNLOAD_DOCUMENT_FAILED { message: @payload.error })
    }

    emits {
      ESIGN_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
        host : string
      }
        @description "Internal: the DocuSign request, for the HTTP client."
        @tier "secondary"
      ESIGN_ENVELOPE_SENT -> external {
        envelopeId : string!
        status : string!
      }
        @description "The envelope DocuSign created for the document: its id (empty when the reply carried none) and its status (sent when absent)."
        @synonyms "envelope sent, signature request created, document sent for signing"
        @tier "primary"
      ESIGN_ENVELOPE_STATUS -> external {
        status : string!
        completedAt : string!
      }
        @description "The envelope's signing status and completion timestamp; both empty when the reply carried none."
        @synonyms "envelope status, signing progress, signature status"
        @tier "primary"
      ESIGN_DOCUMENT_DOWNLOADED -> external {
        content : string!
        documentName : string!
      }
        @description "The combined signed document as base64 PDF content, named envelope-<id>.pdf."
        @synonyms "signed document, download pdf, signed contract"
        @tier "primary"
      ESIGN_SEND_ENVELOPE_FAILED -> external {
        code : string
        message : string!
      }
        @description "Sending the envelope failed: DocuSign answered non-2xx or 5xx, or could not be reached."
        @synonyms "send failed, signature request error"
        @tier "primary"
      ESIGN_GET_ENVELOPE_STATUS_FAILED -> external {
        code : string
        message : string!
      }
        @description "Polling the envelope failed: DocuSign answered non-2xx or 5xx, or could not be reached."
        @synonyms "status failed, envelope lookup error"
        @tier "primary"
      ESIGN_DOWNLOAD_DOCUMENT_FAILED -> external {
        code : string
        message : string!
      }
        @description "Downloading the signed document failed: DocuSign answered non-2xx or 5xx, or could not be reached."
        @synonyms "download failed, signed document error"
        @tier "primary"
    }

    listens {
      ESIGN_SEND_ENVELOPE -> input {
        recipientEmail : string!
        recipientName : string!
        documentName : string!
        documentContent : string!
        emailSubject : string?
      }
        @description "Send a document to one signer; documentContent is a base64 data URL or raw base64, emailSubject defaults to Please sign: plus the document name."
        @synonyms "send for signature, create envelope, request e-signature"
      ESIGN_GET_ENVELOPE_STATUS -> input {
        envelopeId : string!
      }
        @description "Poll the signing status of an envelope returned by a send."
        @synonyms "check envelope, signing status, poll signature"
      ESIGN_DOWNLOAD_DOCUMENT -> input {
        envelopeId : string!
      }
        @description "Download the combined signed document of an envelope as base64 PDF."
        @synonyms "download signed pdf, get signed document, fetch contract"
      ESIGN_SEND_ENVELOPE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      ESIGN_SEND_ENVELOPE_UNREACHED {
        error : string!
        kind : string!
      }
      ESIGN_GET_ENVELOPE_STATUS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      ESIGN_GET_ENVELOPE_STATUS_UNREACHED {
        error : string!
        kind : string!
      }
      ESIGN_DOWNLOAD_DOCUMENT_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string
      }
      ESIGN_DOWNLOAD_DOCUMENT_UNREACHED {
        error : string!
        kind : string!
        key : string
      }
      EsignHttp.HTTP_REPLIED -> ESIGN_SEND_ENVELOPE_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "send")
      EsignHttp.HTTP_FAILED -> ESIGN_SEND_ENVELOPE_UNREACHED with { error: ?error, kind: ?kind } when (= ?key "send")
      EsignTimeout.TIMED_OUT -> ESIGN_SEND_ENVELOPE_UNREACHED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "send")
      EsignHttp.HTTP_REPLIED -> ESIGN_GET_ENVELOPE_STATUS_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "status")
      EsignHttp.HTTP_FAILED -> ESIGN_GET_ENVELOPE_STATUS_UNREACHED with { error: ?error, kind: ?kind } when (= ?key "status")
      EsignTimeout.TIMED_OUT -> ESIGN_GET_ENVELOPE_STATUS_UNREACHED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "status")
      EsignHttp.HTTP_REPLIED -> ESIGN_DOWNLOAD_DOCUMENT_REPLIED with { status: ?status, headers: ?headers, body: (bytes/to-base64 ?body), key: (str/slice ?key 9 (str/len ?key)) } when (str/startsWith ?key "download:")
      EsignHttp.HTTP_FAILED -> ESIGN_DOWNLOAD_DOCUMENT_UNREACHED with { error: ?error, kind: ?kind, key: (str/slice ?key 9 (str/len ?key)) } when (str/startsWith ?key "download:")
      EsignTimeout.TIMED_OUT -> ESIGN_DOWNLOAD_DOCUMENT_UNREACHED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout", key: (str/slice ?key 9 (str/len ?key)) } when (str/startsWith ?key "download:")
    }

    config {
      origin : url = "https://demo.docusign.net"
        @label "DocuSign API origin"
        @description "The DocuSign base URI origin (scheme://host, no path) of the account (https only); its host must be granted in net. The access token is the EsignHttp credential."
        @synonyms "docusign host, base uri origin, esign api host"
        @tier "infra"
      basePath : string = "/restapi/v2.1/accounts"
        @label "Account path"
        @description "The account-scoped REST path after the origin, ending with the account id (for example /restapi/v2.1/accounts/<accountId>); a trailing slash is ignored."
        @synonyms "account path, base path, account id path"
        @tier "infra"
    }
  }

  page boot as EsignPage -> EsignClient, EsignHttp, EsignHttpFrame, EsignTimeout
}
