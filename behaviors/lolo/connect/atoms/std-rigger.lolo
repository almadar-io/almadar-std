app std-rigger [
  version: "1.0.0",
  description: "std-rigger — the local rigger service (FastAPI mesh-rigging, cutout-layer and image-generation server, default http://127.0.0.1:8181) as one atom: health, build a mesh bundle, render a preset, list presets, load and save a rig file, build the pixel-ownership map, cut the layers, sample a pose and generate an image. Every action POSTs (or GETs) JSON to its endpoint and answers a typed result event; a non-2xx reply answers the action's failure event with the message `Rigger <path> returned <status>: <detail>` (detail is the service's `detail` field when present) and no code; an unreachable service answers the network error message. Generation is validated before it is sent: the model must be z-image-turbo or kontext, and kontext needs a sourcePath.",
  egress: ["http://127.0.0.1:8181"]
]
type RiggerIssue = { loc : [string | number], msg : string, type : string }
type RiggerErrorBody = { detail : string | [RiggerIssue] }
type RiggerDetailString = { detail : string }
type RiggerRigPart = { name : string!, box : [number], pivot : [number], z : number, parent : string, role : string, poly : [[number]], cloneOf : string, offset : [number], shade : number, render : boolean, attachment : string, jointDiscPx : number }
type RiggerRig = { parts : [RiggerRigPart]!, jointDiscPx : number, jointOverlapPx : number, extrudePx : number, roundEnds : boolean, restLayer : boolean, restZ : number, skinFalloffPx : number, meshGridStepPx : number }
type RiggerResolvedPart = { name : string!, box : [number]!, pivot : [number]!, z : number!, parent : string, role : string, poly : [[number]], cloneOf : string, offset : [number], shade : number, render : boolean, attachment : string, jointDiscPx : number }
type RiggerResolvedRig = { parts : [RiggerResolvedPart]!, jointDiscPx : number, jointOverlapPx : number, extrudePx : number, roundEnds : boolean, restLayer : boolean, restZ : number }
type RiggerIk = { stride : number!, step_height : number! }
type RiggerPresetBone = { role : string!, rotate_deg : [number], rotate_deg_curve : [number], translate_y : [number], phase : number, freq : number, ik : RiggerIk }
type RiggerPreset = { name : string!, path : string!, fps : number!, frames : number!, bones : [RiggerPresetBone]! }
type RiggerLegendRow = { name : string!, color : string! }
type RiggerLayer = { name : string!, path : string!, x : number!, y : number!, w : number!, h : number!, z : number!, pivot : [number]!, isRest : boolean! }
type RiggerPoseTransform = { angle : number!, bx : number!, by : number! }
type RiggerMeshBuilt = { bundlePath : string!, boneCount : number!, vertexCount : number!, triangleCount : number!, clips : [string]! }
type RiggerRendered = { outdir : string!, frames : number!, framePaths : [string]!, sheet : string!, gif : string!, atlas : string! }
type RiggerPresetList = { presets : [RiggerPreset]! }
type RiggerRigLoaded = { rig : RiggerRig!, resolved : RiggerResolvedRig! }
type RiggerRigSaved = { rigPath : string!, parts : number! }
type RiggerOwnership = { outPath : string!, legend : [RiggerLegendRow]! }
type RiggerLayers = { layers : [RiggerLayer]! }
type RiggerPosed = { fps : number!, frames : [Map string RiggerPoseTransform]! }
type RiggerGenerated = { outPath : string!, model : string!, prompt : string!, seed : number, size : string!, sourcePath : string, elapsedMs : number! }
orbital RiggerOrbital {
  entity RiggerCall [runtime] {
    id : string!
  }

  trait RiggerClient -> RiggerCall [client] {
    initial: idle

    state idle {
      INIT -> idle

      RIGGER_HEALTH -> idle
        (http GET @config.origin "/health" {
          headers: { Accept: "application/json" },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_HEALTH_REPLIED, failure: RIGGER_HEALTH_UNREACHABLE } })
      RIGGER_HEALTH_REPLIED -> idle
        (emit RIGGER_HEALTH_CHECKED { ok: (and (>= @payload.status 200) (< @payload.status 300)) })
      RIGGER_HEALTH_UNREACHABLE -> idle
        (emit RIGGER_HEALTH_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_BUILD_MESH -> idle
        (http POST @config.origin "/mesh/build" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: { imagePath: @payload.imagePath, rig: @payload.rig },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_BUILD_MESH_REPLIED, failure: RIGGER_BUILD_MESH_UNREACHABLE } })
      RIGGER_BUILD_MESH_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerMeshBuilt)))
          (emit RIGGER_MESH_BUILT { bundlePath: @r.bundlePath, boneCount: @r.boneCount, vertexCount: @r.vertexCount, triangleCount: @r.triangleCount, clips: @r.clips }))
      RIGGER_BUILD_MESH_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_BUILD_MESH_FAILED {
              code: null,
              message: (str/concat "Rigger /mesh/build returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_BUILD_MESH_UNREACHABLE -> idle
        (emit RIGGER_BUILD_MESH_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_RENDER -> idle
        (http POST @config.origin "/render" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: (object/merge { imagePath: @payload.imagePath, rig: @payload.rig, preset: @payload.preset, outDir: @payload.outDir } (if (not (validate/required @payload.mode)) {} { mode: @payload.mode }) (if (= @payload.supersample null) {} { supersample: @payload.supersample })),
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_RENDER_REPLIED, failure: RIGGER_RENDER_UNREACHABLE } })
      RIGGER_RENDER_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerRendered)))
          (emit RIGGER_RENDERED { outdir: @r.outdir, frames: @r.frames, framePaths: @r.framePaths, sheet: @r.sheet, gif: @r.gif, atlas: @r.atlas }))
      RIGGER_RENDER_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_RENDER_FAILED {
              code: null,
              message: (str/concat "Rigger /render returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_RENDER_UNREACHABLE -> idle
        (emit RIGGER_RENDER_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_LIST_PRESETS -> idle
        (http GET @config.origin "/presets" {
          headers: { Accept: "application/json" },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_LIST_PRESETS_REPLIED, failure: RIGGER_LIST_PRESETS_UNREACHABLE } })
      RIGGER_LIST_PRESETS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerPresetList)))
          (emit RIGGER_PRESETS { presets: @r.presets }))
      RIGGER_LIST_PRESETS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_LIST_PRESETS_FAILED {
              code: null,
              message: (str/concat "Rigger /presets returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_LIST_PRESETS_UNREACHABLE -> idle
        (emit RIGGER_LIST_PRESETS_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_LOAD_RIG -> idle
        (http POST @config.origin "/rig/load" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: { rigPath: @payload.rigPath },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_LOAD_RIG_REPLIED, failure: RIGGER_LOAD_RIG_UNREACHABLE } })
      RIGGER_LOAD_RIG_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerRigLoaded)))
          (emit RIGGER_RIG_LOADED { rig: @r.rig, resolved: @r.resolved }))
      RIGGER_LOAD_RIG_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_LOAD_RIG_FAILED {
              code: null,
              message: (str/concat "Rigger /rig/load returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_LOAD_RIG_UNREACHABLE -> idle
        (emit RIGGER_LOAD_RIG_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_SAVE_RIG -> idle
        (http POST @config.origin "/rig/save" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: { rigPath: @payload.rigPath, rig: @payload.rig },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_SAVE_RIG_REPLIED, failure: RIGGER_SAVE_RIG_UNREACHABLE } })
      RIGGER_SAVE_RIG_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerRigSaved)))
          (emit RIGGER_RIG_SAVED { rigPath: @r.rigPath, parts: @r.parts }))
      RIGGER_SAVE_RIG_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_SAVE_RIG_FAILED {
              code: null,
              message: (str/concat "Rigger /rig/save returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_SAVE_RIG_UNREACHABLE -> idle
        (emit RIGGER_SAVE_RIG_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_OWNERSHIP -> idle
        (http POST @config.origin "/ownership" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: { imagePath: @payload.imagePath, rig: @payload.rig, outPath: @payload.outPath },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_OWNERSHIP_REPLIED, failure: RIGGER_OWNERSHIP_UNREACHABLE } })
      RIGGER_OWNERSHIP_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerOwnership)))
          (emit RIGGER_OWNERSHIP_BUILT { outPath: @r.outPath, legend: @r.legend }))
      RIGGER_OWNERSHIP_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_OWNERSHIP_FAILED {
              code: null,
              message: (str/concat "Rigger /ownership returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_OWNERSHIP_UNREACHABLE -> idle
        (emit RIGGER_OWNERSHIP_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_BUILD_LAYERS -> idle
        (http POST @config.origin "/layers" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: { imagePath: @payload.imagePath, rig: @payload.rig, outDir: @payload.outDir },
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_BUILD_LAYERS_REPLIED, failure: RIGGER_BUILD_LAYERS_UNREACHABLE } })
      RIGGER_BUILD_LAYERS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerLayers)))
          (emit RIGGER_LAYERS_BUILT { layers: @r.layers }))
      RIGGER_BUILD_LAYERS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_BUILD_LAYERS_FAILED {
              code: null,
              message: (str/concat "Rigger /layers returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_BUILD_LAYERS_UNREACHABLE -> idle
        (emit RIGGER_BUILD_LAYERS_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_POSE -> idle
        (http POST @config.origin "/pose" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: (object/merge { imagePath: @payload.imagePath, rig: @payload.rig, roles: @payload.roles } (if (not (validate/required @payload.preset)) {} { preset: @payload.preset }) (if (= @payload.overrides null) {} { overrides: @payload.overrides })),
          timeoutMs: @config.timeoutMs
        } { emit: { success: RIGGER_POSE_REPLIED, failure: RIGGER_POSE_UNREACHABLE } })
      RIGGER_POSE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerPosed)))
          (emit RIGGER_POSED { fps: @r.fps, frames: @r.frames }))
      RIGGER_POSE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_POSE_FAILED {
              code: null,
              message: (str/concat "Rigger /pose returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_POSE_UNREACHABLE -> idle
        (emit RIGGER_POSE_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })

      RIGGER_GENERATE -> idle when (and (or (= @payload.model "z-image-turbo") (= @payload.model "kontext")) (or (!= @payload.model "kontext") (!= (or @payload.sourcePath "") "")))
        (http POST @config.origin "/generate" {
          headers: { Accept: "application/json", Content-Type: "application/json" },
          json: (object/merge { model: @payload.model, prompt: @payload.prompt, outDir: @payload.outDir } (if (= @payload.seed null) {} { seed: @payload.seed }) (if (= @payload.size null) {} { size: @payload.size }) (if (= @payload.steps null) {} { steps: @payload.steps }) (if (= @payload.sourcePath null) {} { sourcePath: @payload.sourcePath })),
          timeoutMs: @config.generateTimeoutMs
        } { emit: { success: RIGGER_GENERATE_REPLIED, failure: RIGGER_GENERATE_UNREACHABLE } })
      RIGGER_GENERATE -> idle when (and (!= @payload.model "z-image-turbo") (!= @payload.model "kontext"))
        (emit RIGGER_GENERATE_FAILED { code: "VALIDATION_ERROR", message: "Validation failed for rigger.generate: params: model must be one of z-image-turbo, kontext" })
      RIGGER_GENERATE -> idle when (and (= @payload.model "kontext") (= (or @payload.sourcePath "") ""))
        (emit RIGGER_GENERATE_FAILED { code: "VALIDATION_ERROR", message: "Validation failed for rigger.generate: params: sourcePath is required when model is kontext" })
      RIGGER_GENERATE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body RiggerGenerated)))
          (emit RIGGER_GENERATED { outPath: @r.outPath, model: @r.model, prompt: @r.prompt, seed: @r.seed, size: @r.size, sourcePath: @r.sourcePath, elapsedMs: @r.elapsedMs }))
      RIGGER_GENERATE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let (
            (errBody (json/parse @payload.body RiggerErrorBody))
            (detailJson (json/stringify (object/get @errBody detail "")))
            (detailText (if (object/has @errBody detail) (if (str/startsWith @detailJson "\"") (object/get (json/parse @payload.body RiggerDetailString) detail "") @detailJson) "")))
            (emit RIGGER_GENERATE_FAILED {
              code: null,
              message: (str/concat "Rigger /generate returned " @payload.status (if (!= @detailText "") (str/concat ": " @detailText) ""))
            }))
      RIGGER_GENERATE_UNREACHABLE -> idle
        (emit RIGGER_GENERATE_FAILED { code: null, message: @payload.error })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Rigger unavailable: " @payload.error) })
    }

    emits {
      RIGGER_HEALTH_CHECKED -> external {
        ok : boolean!
      }
        @description "Whether the rigger service answered /health with a 2xx status."
        @synonyms "rigger healthy, rigger up"
        @tier "primary"
      RIGGER_HEALTH_FAILED -> external {
        code : string
        message : string!
      }
        @description "The health probe never reached the rigger service: the network error message."
        @synonyms "health failed, rigger error"
        @tier "primary"
      RIGGER_HEALTH_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the health call's HTTP reply."
        @tier "secondary"
      RIGGER_HEALTH_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the health call never produced a reply."
        @tier "secondary"
      RIGGER_MESH_BUILT -> external {
        bundlePath : string!
        boneCount : number!
        vertexCount : number!
        triangleCount : number!
        clips : [string]!
      }
        @description "The mesh bundle the rigger built: its path and bone, vertex and triangle counts and clip names."
        @synonyms "mesh built, mesh bundle"
        @tier "primary"
      RIGGER_BUILD_MESH_FAILED -> external {
        code : string
        message : string!
      }
        @description "Building the mesh failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "build mesh failed, rigger error"
        @tier "primary"
      RIGGER_BUILD_MESH_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the buildMesh call's HTTP reply."
        @tier "secondary"
      RIGGER_BUILD_MESH_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the buildMesh call never produced a reply."
        @tier "secondary"
      RIGGER_RENDERED -> external {
        outdir : string!
        frames : number!
        framePaths : [string]!
        sheet : string!
        gif : string!
        atlas : string!
      }
        @description "The rendered output: directory, frame count and paths, sprite sheet, gif and atlas."
        @synonyms "render done, frames rendered"
        @tier "primary"
      RIGGER_RENDER_FAILED -> external {
        code : string
        message : string!
      }
        @description "Rendering failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "render failed, rigger error"
        @tier "primary"
      RIGGER_RENDER_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the render call's HTTP reply."
        @tier "secondary"
      RIGGER_RENDER_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the render call never produced a reply."
        @tier "secondary"
      RIGGER_PRESETS -> external {
        presets : [RiggerPreset]!
      }
        @description "The available presets with name, path, fps, frame count and bone roles."
        @synonyms "presets listed, preset list"
        @tier "primary"
      RIGGER_LIST_PRESETS_FAILED -> external {
        code : string
        message : string!
      }
        @description "Listing presets failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "list presets failed, rigger error"
        @tier "primary"
      RIGGER_LIST_PRESETS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the listPresets call's HTTP reply."
        @tier "secondary"
      RIGGER_LIST_PRESETS_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the listPresets call never produced a reply."
        @tier "secondary"
      RIGGER_RIG_LOADED -> external {
        rig : RiggerRig!
        resolved : RiggerResolvedRig!
      }
        @description "The rig as stored and the resolved rig with every cloneOf part expanded."
        @synonyms "rig loaded, rig opened"
        @tier "primary"
      RIGGER_LOAD_RIG_FAILED -> external {
        code : string
        message : string!
      }
        @description "Loading the rig failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "load rig failed, rigger error"
        @tier "primary"
      RIGGER_LOAD_RIG_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the loadRig call's HTTP reply."
        @tier "secondary"
      RIGGER_LOAD_RIG_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the loadRig call never produced a reply."
        @tier "secondary"
      RIGGER_RIG_SAVED -> external {
        rigPath : string!
        parts : number!
      }
        @description "The rig was saved: its path and the number of parts written."
        @synonyms "rig saved, rig written"
        @tier "primary"
      RIGGER_SAVE_RIG_FAILED -> external {
        code : string
        message : string!
      }
        @description "Saving the rig failed: the rigger's HTTP status and detail (a malformed part is a 4xx), or the network error message."
        @synonyms "save rig failed, rigger error"
        @tier "primary"
      RIGGER_SAVE_RIG_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the saveRig call's HTTP reply."
        @tier "secondary"
      RIGGER_SAVE_RIG_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the saveRig call never produced a reply."
        @tier "secondary"
      RIGGER_OWNERSHIP_BUILT -> external {
        outPath : string!
        legend : [RiggerLegendRow]!
      }
        @description "The ownership PNG path and the colour legend of each part."
        @synonyms "ownership built, ownership overlay"
        @tier "primary"
      RIGGER_OWNERSHIP_FAILED -> external {
        code : string
        message : string!
      }
        @description "Building the ownership map failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "ownership failed, rigger error"
        @tier "primary"
      RIGGER_OWNERSHIP_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the ownership call's HTTP reply."
        @tier "secondary"
      RIGGER_OWNERSHIP_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the ownership call never produced a reply."
        @tier "secondary"
      RIGGER_LAYERS_BUILT -> external {
        layers : [RiggerLayer]!
      }
        @description "The cutout layers with name, path, box, z order, pivot and rest flag."
        @synonyms "layers built, cutout layers"
        @tier "primary"
      RIGGER_BUILD_LAYERS_FAILED -> external {
        code : string
        message : string!
      }
        @description "Building the layers failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "build layers failed, rigger error"
        @tier "primary"
      RIGGER_BUILD_LAYERS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the buildLayers call's HTTP reply."
        @tier "secondary"
      RIGGER_BUILD_LAYERS_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the buildLayers call never produced a reply."
        @tier "secondary"
      RIGGER_POSED -> external {
        fps : number!
        frames : [Map string RiggerPoseTransform]!
      }
        @description "The frames per second and, per frame, each part's angle and offset."
        @synonyms "pose sampled, pose frames"
        @tier "primary"
      RIGGER_POSE_FAILED -> external {
        code : string
        message : string!
      }
        @description "Posing failed: the rigger's HTTP status and detail, or the network error message."
        @synonyms "pose failed, rigger error"
        @tier "primary"
      RIGGER_POSE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the pose call's HTTP reply."
        @tier "secondary"
      RIGGER_POSE_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the pose call never produced a reply."
        @tier "secondary"
      RIGGER_GENERATED -> external {
        outPath : string!
        model : string!
        prompt : string!
        seed : number
        size : string!
        sourcePath : string
        elapsedMs : number!
      }
        @description "The generated image: output path, model, prompt, seed, size, source path and elapsed milliseconds."
        @synonyms "image generated, generation done"
        @tier "primary"
      RIGGER_GENERATE_FAILED -> external {
        code : string
        message : string!
      }
        @description "Generation failed: a validation message (model not z-image-turbo or kontext, or kontext without sourcePath), the rigger's HTTP status and detail, or the network error message."
        @synonyms "generate failed, rigger error"
        @tier "primary"
      RIGGER_GENERATE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the generate call's HTTP reply."
        @tier "secondary"
      RIGGER_GENERATE_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the generate call never produced a reply."
        @tier "secondary"
    }

    listens {
      RIGGER_HEALTH -> input { }
        @description "Probe the local rigger service's liveness."
        @synonyms "health check, is the rigger up, ping rigger"
      RIGGER_BUILD_MESH -> input {
        imagePath : string!
        rig : RiggerRig!
      }
        @description "Build a rigged mesh bundle from a source image and a rig."
        @synonyms "build mesh, rig mesh, skin mesh"
      RIGGER_RENDER -> input {
        imagePath : string!
        rig : RiggerRig!
        preset : string!
        outDir : string!
        mode : string
        supersample : number
      }
        @description "Render a preset's frames for a rig over a source image; mode is mesh (default) or cutout, supersample applies to cutout."
        @synonyms "render frames, render preset, render animation"
      RIGGER_LIST_PRESETS -> input { }
        @description "List the animation presets the rigger service offers."
        @synonyms "list presets, animation presets, preset clips"
      RIGGER_LOAD_RIG -> input {
        rigPath : string!
      }
        @description "Load a rig file and resolve its cloneOf parts to concrete box and pivot geometry."
        @synonyms "load rig, open rig, read rig file"
      RIGGER_SAVE_RIG -> input {
        rigPath : string!
        rig : RiggerRig!
      }
        @description "Save a rig file; the rigger validates it and rejects a malformed part."
        @synonyms "save rig, write rig file"
      RIGGER_OWNERSHIP -> input {
        imagePath : string!
        rig : RiggerRig!
        outPath : string!
      }
        @description "Render the per-part pixel ownership map of a rig over a source image."
        @synonyms "ownership map, pixel ownership, part coverage"
      RIGGER_BUILD_LAYERS -> input {
        imagePath : string!
        rig : RiggerRig!
        outDir : string!
      }
        @description "Cut the per-part cutout layer images from a source image and a rig."
        @synonyms "build layers, cut layers, cutout layers"
      RIGGER_POSE -> input {
        imagePath : string!
        rig : RiggerRig!
        roles : Map string string!
        preset : string
        overrides : Map string number
      }
        @description "Sample a preset into per-frame, per-part transforms for a rig; roles maps each part to its bone role, overrides adjusts parts over the preset."
        @synonyms "pose rig, sample pose, animation pose"
      RIGGER_GENERATE -> input {
        model : string!
        prompt : string!
        seed : number
        size : string
        steps : number
        sourcePath : string
        outDir : string!
      }
        @description "Generate one image on the local image server: model z-image-turbo is text-to-image, kontext edits the image at sourcePath (required for kontext)."
        @synonyms "generate image, text to image, kontext edit"
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports an unreachable rigger call; a page running it in the background keeps it in `system`."
        @synonyms "status area, slot"
        @tier "presentation"
      origin : url = "http://127.0.0.1:8181"
        @label "Rigger service origin"
        @description "The rigger service origin (scheme://host[:port], no path); must be declared in the app egress list."
        @synonyms "rigger url, rigger base url, rigger host"
        @tier "infra"
      timeoutMs : number = 30000
        @label "Request timeout (ms)"
        @description "Milliseconds each rigger request except generation may take before it fails as unreachable."
        @synonyms "timeout, request deadline, wait limit"
        @tier "infra"
      generateTimeoutMs : number = 600000
        @label "Generation timeout (ms)"
        @description "Milliseconds an image generation may take before it fails as unreachable; a local z-image-turbo run takes about 60-90 seconds and a kontext edit at 1024px several minutes."
        @synonyms "generation timeout, image timeout"
        @tier "infra"
    }
  }

  page "/rigger" as RiggerPage -> RiggerClient
}
