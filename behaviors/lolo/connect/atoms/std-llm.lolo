      LLM_CHAT_HTTP_OK -> idle when (not (and (>= @payload.status 200) (< @payload.status 300) (object/get (default (json/parse @payload.key LlmJob) {}) stream false)))
        (set @entity.inflight (array/filter @entity.inflight (fn c (!= @c.httpKey @payload.key))))
