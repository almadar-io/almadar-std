        (emit LLM_CHAT_CONTENT { job: @payload.key, content: (object/get (default (array/find @entity.streamed (fn c (= @c.key @payload.key))) {}) text ""), inputTokens: (object/get (default (array/find @entity.streamed (fn c (= @c.key @payload.key))) {}) inputTokens null), outputTokens: (object/get (default (array/find @entity.streamed (fn c (= @c.key @payload.key))) {}) outputTokens null) })
        (set @entity.inflight (array/filter @entity.inflight (fn c (!= @c.httpKey @payload.key))))
