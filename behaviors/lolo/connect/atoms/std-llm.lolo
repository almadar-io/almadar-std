      LLM_CHAT_ERROR -> idle when (and (!= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "generate")
          (< (object/get (default (json/parse @payload.job LlmJob) {}) attempt 0) 2)
          (not (str/includes (str/lower @payload.message) "rate limit")) (not (str/includes (str/lower @payload.message) "429")) (not (str/includes (str/lower @payload.message) "quota exceeded")))
        (emit LLM_CHAT_SEND {
          job: (let ((j (default (json/parse @payload.job LlmJob) {})))
            (json/stringify (object/merge {
              action: @j.action, attempt: (+ @j.attempt 1), system: @j.system,
              user: (str/concat @j.base "\n\n[Previous attempt failed with: " @payload.message "]\nPlease output valid JSON that matches the expected schema."),
              base: @j.base, model: @j.model, temperature: @j.temperature, maxTokens: @j.maxTokens,
              categories: @j.categories, itemIds: @j.itemIds, callKey: (object/get @j callKey ""),
              images: (object/get @j images [])
            } (if (!= (object/get @j ck "") "") { ck: @j.ck } {}))))
        })

      LLM_CHAT_CONTENT -> idle when (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "generate")
        (emit LLM_GENERATE_RESULT {
          content: @payload.content,
          usage: {
            promptTokens: (if (= @payload.inputTokens null) 0 @payload.inputTokens),
            completionTokens: (if (= @payload.outputTokens null) 0 @payload.outputTokens),
            totalTokens: (+ (if (= @payload.inputTokens null) 0 @payload.inputTokens) (if (= @payload.outputTokens null) 0 @payload.outputTokens))
          }
        })
        (emit LLM_USAGE_REPORTED {
          provider: @config.provider,
          model: (object/get (default (json/parse @payload.job LlmJob) {}) model ""),
          action: "generate",
          inputTokens: (default @payload.inputTokens 0),
          outputTokens: (default @payload.outputTokens 0)
        })
        (when (!= (object/get (default (json/parse @payload.job LlmJob) {}) ck "") "")
          (emit LLM_CACHE_STORE { key: (object/get (default (json/parse @payload.job LlmJob) {}) ck ""), result: @payload.content }))
      LLM_CHAT_CONTENT -> idle when (!= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "generate")
        (emit LLM_CHAT_STRIPPED {
          job: @payload.job,
          text: (let ((parts (str/split @payload.content "</think>")))
            (str/trim (str/join (array/map @parts (fn p
              (let ((i @index))
                (let ((seg (if (> @i 0) (str/trimStart @p) @p)))
                  (if (< @i (- (array/len @parts) 1)) (default (array/first (str/split @seg "<think>")) "") @seg))))) "")))
        })
        (emit LLM_USAGE_REPORTED {
          provider: @config.provider,
          model: (object/get (default (json/parse @payload.job LlmJob) {}) model ""),
          action: (object/get (default (json/parse @payload.job LlmJob) {}) action ""),
          inputTokens: (default @payload.inputTokens 0),
          outputTokens: (default @payload.outputTokens 0)
        })

      LLM_CHAT_STRIPPED -> idle
        (emit LLM_CHAT_JSON {
          job: @payload.job,
          json: (let ((t @payload.text))
            (let ((fp (str/split @t "```")))
              (let ((oi (str/len (default (array/first (str/split @t "{")) ""))) (hasObj (> (array/len (str/split @t "{")) 1)))
                (let ((ai (str/len (default (array/first (str/split @t "[")) ""))) (hasArr (> (array/len (str/split @t "[")) 1)))
                  (let ((arrFirst (and @hasArr (or (not @hasObj) (< @ai @oi)))))
                    (let ((objFirst (and @hasObj (or (not @hasArr) (< @oi @ai)))))
                      (let ((start (if @arrFirst @ai @oi)) (open (if @arrFirst "[" "{")) (close (if @arrFirst "]" "}")))
                        (let ((scan (array/reduce (array/map (array/range (str/len (str/slice @t @start))) (fn n (str/slice @t (+ @start @n) (+ @start @n 1)))) { depth: 0, inStr: false, esc: false, end: -1, pos: 0 }
                            (fn acc ch
                              (if (>= @acc.end 0) @acc
                                (let ((delta (if (or @acc.esc @acc.inStr) 0 (if (= @ch @open) 1 (if (= @ch @close) -1 0)))))
                                  { depth: (+ @acc.depth @delta),
                                    inStr: (if @acc.esc @acc.inStr (if (= @ch "\"") (not @acc.inStr) @acc.inStr)),
                                    esc: (and (not @acc.esc) @acc.inStr (= @ch "\\")),
                                    end: (if (and (not @acc.esc) (not @acc.inStr) (= @ch @close) (= (+ @acc.depth @delta) 0)) (+ @acc.pos 1) -1),
                                    pos: (+ @acc.pos 1) }))))))
                          (let ((lastPos (- (- (str/len @t) (str/len (default (array/last (str/split @t @close)) ""))) 1)))
                            (if (>= (array/len @fp) 3)
                              (str/trim (if (str/startsWith (default (array/nth @fp 1) "") "json") (str/slice (default (array/nth @fp 1) "") 4) (default (array/nth @fp 1) "")))
                              (if (not (or @arrFirst @objFirst)) ""
                                (if (>= @scan.end 0) (str/slice @t @start (+ @start @scan.end))
                                  (if (and (> (array/len (str/split @t @close)) 1) (> @lastPos @start)) (str/slice @t @start (+ @lastPos 1)) "")))))))))))))
        })

      LLM_CHAT_JSON -> idle when (= @payload.json "")
        (emit LLM_CHAT_ERROR { job: @payload.job, message: "No valid JSON found in response. Expected a JSON value (object, array, string, number, boolean, or null), possibly wrapped in markdown code blocks." })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classify") (= (json/parse @payload.json ClassificationReply) null))
        (emit LLM_CHAT_ERROR { job: @payload.job, message: (str/concat "Failed to parse JSON. Raw text: " @payload.json) })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classify") (!= (json/parse @payload.json ClassificationReply) null))
        (let ((c (json/parse @payload.json ClassificationReply)) (cats (object/get (default (json/parse @payload.job LlmJob) {}) categories [])))
          (emit LLM_CHAT_CHECKED {
            job: @payload.job, json: @payload.json,
            issues: (str/join (array/concat
              (if (= (object/get @c category null) null) ["category: Required"]
                (if (array/includes @cats (object/get @c category "")) []
                  [(str/concat "category: Invalid enum value. Expected " (str/join (array/map @cats (fn x (str/concat "'" @x "'"))) " | ") ", received '" (object/get @c category "") "'")]))
              (if (= (object/get @c confidence null) null) ["confidence: Required"]
                (if (< (object/get @c confidence 0) 0) ["confidence: Number must be greater than or equal to 0"]
                  (if (> (object/get @c confidence 0) 1) ["confidence: Number must be less than or equal to 1"] [])))
              (if (= (object/get @c reasoning null) null) ["reasoning: Required"] [])) "; ")
          }))
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "summarize") (= (json/parse @payload.json SummaryReply) null))
        (emit LLM_CHAT_ERROR { job: @payload.job, message: (str/concat "Failed to parse JSON. Raw text: " @payload.json) })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "summarize") (!= (json/parse @payload.json SummaryReply) null))
        (emit LLM_CHAT_CHECKED {
          job: @payload.job, json: @payload.json,
          issues: (str/join (array/concat
            (if (= (object/get (default (json/parse @payload.json SummaryReply) {}) summary null) null) ["summary: Required"] [])
            (if (= (object/get (default (json/parse @payload.json SummaryReply) {}) keyPoints null) null) ["keyPoints: Required"] [])) "; ")
        })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classifyMany") (= (json/parse @payload.json VerdictsReply) null))
        (emit LLM_CHAT_ERROR { job: @payload.job, message: (str/concat "Failed to parse JSON. Raw text: " @payload.json) })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classifyMany") (!= (json/parse @payload.json VerdictsReply) null))
        (let ((vs (object/get (default (json/parse @payload.json VerdictsReply) {}) verdicts null)) (cats (object/get (default (json/parse @payload.job LlmJob) {}) categories [])))
          (emit LLM_CHAT_CHECKED {
            job: @payload.job, json: @payload.json,
            issues: (if (= @vs null) "verdicts: Required"
              (let ((shape (str/join (array/flatten (array/map @vs (fn v (let ((i @index))
                  (array/concat
                    (if (= (object/get @v id null) null) [(str/concat "verdicts." @i ".id: Required")] [])
                    (if (= (object/get @v category null) null) [(str/concat "verdicts." @i ".category: Required")] [])
                    (if (= (object/get @v confidence null) null) [(str/concat "verdicts." @i ".confidence: Required")]
                      (if (< (object/get @v confidence 0) 0) [(str/concat "verdicts." @i ".confidence: Number must be greater than or equal to 0")]
                        (if (> (object/get @v confidence 0) 1) [(str/concat "verdicts." @i ".confidence: Number must be less than or equal to 1")] [])))
                    (if (= (object/get @v reasoning null) null) [(str/concat "verdicts." @i ".reasoning: Required")] []))))))
                "; ")))
                (if (!= @shape "") @shape
                  (if (array/every @vs (fn v (array/includes @cats (object/get @v category "")))) "" ": every category must be a declared one"))))
          }))

      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "extract") (not (json/valid @payload.json)))
        (emit LLM_CHAT_ERROR { job: @payload.job, message: (str/concat "Failed to parse JSON. Raw text: " @payload.json) })
      LLM_CHAT_JSON -> idle when (and (!= @payload.json "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "extract") (json/valid @payload.json))
        (emit LLM_CHAT_CHECKED { job: @payload.job, json: @payload.json, issues: "" })

      LLM_CHAT_CHECKED -> idle when (!= @payload.issues "")
        (emit LLM_CHAT_ERROR { job: @payload.job, message: (str/concat "Schema validation failed: " @payload.issues) })
      LLM_CHAT_CHECKED -> idle when (and (= @payload.issues "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classify"))
        (emit LLM_CLASSIFY_RESULT {
          category: (object/get (default (json/parse @payload.json ClassificationReply) {}) category ""),
          confidence: (object/get (default (json/parse @payload.json ClassificationReply) {}) confidence 0),
          reasoning: (object/get (default (json/parse @payload.json ClassificationReply) {}) reasoning "")
        })
        (when (!= (object/get (default (json/parse @payload.job LlmJob) {}) ck "") "")
          (emit LLM_CACHE_STORE { key: (object/get (default (json/parse @payload.job LlmJob) {}) ck ""), result: @payload.json }))
      LLM_CHAT_CHECKED -> idle when (and (= @payload.issues "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "extract"))
        (emit LLM_EXTRACT_RESULT { json: @payload.json })
        (when (!= (object/get (default (json/parse @payload.job LlmJob) {}) ck "") "")
          (emit LLM_CACHE_STORE { key: (object/get (default (json/parse @payload.job LlmJob) {}) ck ""), result: @payload.json }))
      LLM_CHAT_CHECKED -> idle when (and (= @payload.issues "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "summarize"))
        (emit LLM_SUMMARIZE_RESULT {
          summary: (object/get (default (json/parse @payload.json SummaryReply) {}) summary ""),
          keyPoints: (object/get (default (json/parse @payload.json SummaryReply) {}) keyPoints [])
        })
      LLM_CHAT_CHECKED -> idle when (and (= @payload.issues "") (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classifyMany"))
        (let ((ids (object/get (default (json/parse @payload.job LlmJob) {}) itemIds [])) (vs (object/get (default (json/parse @payload.json VerdictsReply) {}) verdicts [])))
          (let ((labels (array/map @ids (fn x (str/concat (+ @index 1) "")))) (verdictIds (array/map @vs (fn v (object/get @v id "")))))
            (let ((errs (array/map @vs (fn v (let ((k @index))
                (if (not (array/includes @labels (object/get @v id ""))) (str/concat "The model gave a verdict for item '" (object/get @v id "") "', which was not sent")
                  (if (!= (array/findIndex @vs (fn x (= (object/get @x id "") (object/get @v id "")))) @k) (str/concat "The model gave item '" (object/get @v id "") "' two verdicts") "")))))))
              (let ((missing (array/filter @ids (fn itemId (not (array/includes @verdictIds (str/concat (+ @index 1) "")))))))
                (emit LLM_CHAT_VERDICTS {
                  job: @payload.job, json: @payload.json,
                  problem: (if (> (array/count @errs (fn e (!= @e ""))) 0) (default (array/find @errs (fn e (!= @e ""))) "")
                    (if (> (array/len @missing) 0) (str/concat "The model gave no verdict for " (str/join @missing ", ")) ""))
                })))))
      LLM_CHAT_VERDICTS -> idle when (!= @payload.problem "")
        (emit LLM_FAILED { code: "SERVICE_ERROR", message: @payload.problem })
      LLM_CHAT_VERDICTS -> idle when (= @payload.problem "")
        (let ((ids (object/get (default (json/parse @payload.job LlmJob) {}) itemIds [])) (vs (object/get (default (json/parse @payload.json VerdictsReply) {}) verdicts [])))
          (emit LLM_CLASSIFY_MANY_RESULT {
            verdicts: (array/map @ids (fn itemId (let ((k @index))
              (let ((v (array/find @vs (fn x (= (object/get @x id "") (str/concat (+ @k 1) ""))))))
                { id: @itemId, category: (if (validate/required @v) (object/get @v category "") ""), confidence: (if (validate/required @v) (object/get @v confidence 0) 0), reasoning: (if (validate/required @v) (object/get @v reasoning "") "") }))))
          }))
        (when (!= (object/get (default (json/parse @payload.job LlmJob) {}) ck "") "")
          (emit LLM_CACHE_STORE { key: (object/get (default (json/parse @payload.job LlmJob) {}) ck ""), result: @payload.json }))

      LLM_CHOOSE -> idle when (< (array/len @payload.options) 2)
        (emit LLM_FAILED { code: "", message: "[\n  {\n    \"code\": \"too_small\",\n    \"minimum\": 2,\n    \"type\": \"array\",\n    \"inclusive\": true,\n    \"exact\": false,\n    \"message\": \"choose needs at least two options\",\n    \"path\": [\n      \"options\"\n    ]\n  }\n]" })
      LLM_CHOOSE -> idle when (and (>= (array/len @payload.options) 2) (!= (array/len (array/unique (array/map @payload.options (fn o @o.value)))) (array/len @payload.options)))
        (emit LLM_FAILED { code: "", message: "[\n  {\n    \"code\": \"custom\",\n    \"message\": \"choose options need distinct values\",\n    \"path\": [\n      \"options\"\n    ]\n  }\n]" })
      LLM_CHOOSE -> idle when (and (>= (array/len @payload.options) 2) (= (array/len (array/unique (array/map @payload.options (fn o @o.value)))) (array/len @payload.options)))
        (emit LLM_JEV_WIRE {
          key: (json/stringify { values: (array/map @payload.options (fn o @o.value)) }),
          method: "POST", path: "/api/alpha/decisions", query: {},
          headers: { Accept: "*/*" },
          json: (json/stringify {
            model: "typesafe/jev-1.13",
            state: @payload.state,
            questions: { pick: { type: "choice", instructions: @payload.instructions, criteria: (object/fromEntries (array/map @payload.options (fn o [@o.value @o.description]))) } }
          }),
          form: {}, multipartParts: [], stream: "none",
          retryMax: 0, retryOn: [], retryOnFailure: [], retryDelaysMs: [], paginate: "none", maxPages: 1
        })
      LLM_JEV_UNREACHABLE -> idle
        (emit LLM_FAILED { code: "", message: (if (= @payload.kind "timeout") "Jev decide timed out after 30000ms" (str/concat "Jev decide request failed: " @payload.error)) })
      LLM_JEV_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit LLM_FAILED { code: "", message: (str/concat "Jev decide failed with status " @payload.status) })
      LLM_JEV_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((r (json/parse @payload.body JevReply)))
          (emit LLM_JEV_CHECKED {
            key: @payload.key, body: @payload.body,
            problem: (if (= @r null) "Jev decide: response body is not valid JSON"
              (if (= (object/get @r model null) null) "Jev decide: response is missing string \"model\""
                (if (= (object/get @r id null) null) "Jev decide: response is missing string \"id\""
                  (if (= (object/get @r provider null) null) "Jev decide: response is missing string \"provider\""
                    (if (= (object/get @r answers null) null) "Jev decide: response is missing an \"answers\" object"
                      (if (= (object/get @r usage null) null) "Jev decide: response is missing a \"usage\" object"
                        (if (or (= (object/get (object/get @r usage {}) input_tokens null) null) (= (object/get (object/get @r usage {}) output_tokens null) null) (= (object/get (object/get @r usage {}) cost null) null))
                          "Jev decide: \"usage\" is missing input_tokens/output_tokens/cost"
                          (if (= (object/get (object/get @r answers {}) pick null) null) "Jev decide: missing answer for question \"pick\""
                            (if (!= (object/get (object/get (object/get @r answers {}) pick {}) type "") "choice")
                              (str/concat "Jev decide: answer \"pick\" has type \"" (object/get (object/get (object/get @r answers {}) pick {}) type "") "\", expected \"choice\"")
                              (if (array/includes (object/get (default (json/parse @payload.key JevJob) {}) values []) (object/get (object/get (object/get @r answers {}) pick {}) choice ""))
                                ""
                                (str/concat "Jev decide: answer \"pick\" chose \"" (object/get (object/get (object/get @r answers {}) pick {}) choice "") "\", which is not one of the declared criteria")))))))))))
          }))
      LLM_JEV_CHECKED -> idle when (!= @payload.problem "")
        (emit LLM_FAILED { code: "", message: @payload.problem })
      LLM_JEV_CHECKED -> idle when (= @payload.problem "")
        (emit LLM_CHOOSE_RESULT {
          choice: (object/get (object/get (object/get (default (json/parse @payload.body JevReply) {}) answers {}) pick {}) choice ""),
          confidence: (object/get (object/get (object/get (default (json/parse @payload.body JevReply) {}) answers {}) pick {}) confidence 0)
        })

      LLM_EXTRACT -> idle
        (emit LLM_CHAT_SEND {
          job: (json/stringify {
            action: "extract", attempt: 0,
            system: (if (and (object/has @payload "systemPrompt") (!= @payload.systemPrompt "")) @payload.systemPrompt (str/concat "You are a structured data extractor. Extract data from the given text according to this schema:\n\n" @payload.schema "\n\nReturn ONLY valid JSON matching the schema.")),
            user: @payload.text, base: @payload.text,
            model: (if (and (object/has @payload "model") (!= @payload.model "")) @payload.model @config.model),
            temperature: (if (object/has @payload "temperature") @payload.temperature 0.2), maxTokens: (if (object/has @payload "maxTokens") @payload.maxTokens 0),
            categories: [], itemIds: [],
            callKey: (if (object/has @payload "key") @payload.key ""),
            images: (if (object/has @payload "images") @payload.images []),
            stream: (= @payload.stream true)
          })
        })

      LLM_CALL_TOOLS -> idle when (and (!= @payload.maxSteps null) (or (<= @payload.maxSteps 0) (!= (math/mod @payload.maxSteps 1) 0)))
        (emit LLM_FAILED {
          code: "",
          message: (str/concat "[\n"
            (str/join (array/concat
              (if (!= (math/mod @payload.maxSteps 1) 0) ["  {\n    \"code\": \"invalid_type\",\n    \"expected\": \"integer\",\n    \"received\": \"float\",\n    \"message\": \"Expected integer, received float\",\n    \"path\": [\n      \"maxSteps\"\n    ]\n  }"] [])
              (if (<= @payload.maxSteps 0) ["  {\n    \"code\": \"too_small\",\n    \"minimum\": 0,\n    \"type\": \"number\",\n    \"inclusive\": false,\n    \"exact\": false,\n    \"message\": \"Number must be greater than 0\",\n    \"path\": [\n      \"maxSteps\"\n    ]\n  }"] [])) ",\n")
            "\n]")
        })
      LLM_CALL_TOOLS -> idle when (and (not (and (!= @payload.maxSteps null) (or (<= @payload.maxSteps 0) (!= (math/mod @payload.maxSteps 1) 0)))) (> (array/count @payload.tools (fn t (or (< (str/len @t.name) 1) (> (str/len @t.name) 64) (not (array/every (array/map (array/range (str/len @t.name)) (fn n (str/slice @t.name @n (+ @n 1)))) (fn ch (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @ch))))))) 0))
        (emit LLM_FAILED { code: "", message: (str/concat "call-tools: tool name '" (object/get (default (array/find @payload.tools (fn t (or (< (str/len @t.name) 1) (> (str/len @t.name) 64) (not (array/every (array/map (array/range (str/len @t.name)) (fn n (str/slice @t.name @n (+ @n 1)))) (fn ch (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @ch))))))) {}) name "") "' is not a valid tool name (letters, digits, _ and -, at most 64)") })
      LLM_CALL_TOOLS -> idle when (and (not (and (!= @payload.maxSteps null) (or (<= @payload.maxSteps 0) (!= (math/mod @payload.maxSteps 1) 0)))) (not (> (array/count @payload.tools (fn t (or (< (str/len @t.name) 1) (> (str/len @t.name) 64) (not (array/every (array/map (array/range (str/len @t.name)) (fn n (str/slice @t.name @n (+ @n 1)))) (fn ch (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @ch))))))) 0)))
        (emit LLM_TOOLS_SEND {
          session: (json/stringify {
            key: (if (object/has @payload "key") @payload.key ""),
            model: (if (and (object/has @payload "model") (!= @payload.model "")) @payload.model @config.model),
            system: @payload.instructions,
            userPrompt: (let ((us (array/filter @payload.messages (fn m (= @m.role "user"))))) (if (> (array/len @us) 0) (object/get (array/last @us) content "") "")),
            maxSteps: (if (!= @payload.maxSteps null) @payload.maxSteps 8),
            tools: @payload.tools,
            messages: (array/concat
              (if (validate/required @payload.instructions) [{ role: "system", content: @payload.instructions }] [])
              (array/map @payload.messages (fn m { role: @m.role, content: @m.content }))),
            steps: [],
            usage: { promptTokens: 0, completionTokens: 0, totalTokens: 0, modelCalls: 0 }
          })
        })

      LLM_TOOLS_SEND -> idle when (let ((s (json/parse @payload.session ToolsSession))) (>= @s.usage.modelCalls @s.maxSteps))
        (emit LLM_FAILED { code: "", message: (let ((s (json/parse @payload.session ToolsSession))) (str/concat "call-tools: no reply after " @s.maxSteps " model calls")) })
      LLM_TOOLS_SEND -> idle when (let ((s (json/parse @payload.session ToolsSession))) (< @s.usage.modelCalls @s.maxSteps))
        (emit LLM_TOOLS_DISPATCH {
          session: (json/stringify (object/set (default (json/parse @payload.session ToolsSession) {}) startedAt (time/now))),
          body: (let ((s (default (json/parse @payload.session ToolsSession) {})))
            (if (= @config.provider "anthropic")
              (json/stringify (object/merge
                (object/merge
                  { model: @s.model, max_tokens: 8192,
                    messages: (array/map (array/filter @s.messages (fn m (!= (object/get @m role "") "system")))
                      (fn m (if (= (object/get @m role "") "tool")
                        { role: "user", content: [{ type: "tool_result", tool_use_id: (object/get @m tool_call_id ""), content: (object/get @m content "") }] }
                        (if (> (array/len (object/get @m tool_calls [])) 0)
                          { role: "assistant", content: (array/concat
                            (if (= (object/get @m content "") "") [] [{ type: "text", text: (object/get @m content "") }])
                            (array/map (object/get @m tool_calls []) (fn c { type: "tool_use", id: @c.id, name: @c.function.name, input: (default (json/parse (object/get @c.function arguments "{}") ToolArguments) {}) }))) }
                          { role: (object/get @m role ""), content: (object/get @m content "") })))) }
                  (if (validate/required @s.system) { system: @s.system } {}))
                (if (= (array/len @s.tools) 0) {} { tools: (array/map @s.tools (fn t { name: @t.name, description: @t.description, input_schema: @t.parameters })) })))
              (json/stringify (object/merge
              (object/merge
              (object/merge
              (object/merge
                {
                  model: @s.model,
                  messages: (if (and @config.cacheControl (= @config.provider "openrouter")) (array/map @s.messages (fn m (if (= (object/get @m role "") "system") (object/merge @m { content: [{ type: "text", text: (object/get @m content ""), cache_control: { type: "ephemeral" } }] }) @m))) @s.messages),
                  parallel_tool_calls: @config.parallelToolCalls,
                  temperature: (if (>= @config.toolTemperature 0) @config.toolTemperature (if (= @config.provider "kimi") 0.6 0.7))
                }
                (object/merge (if (= (array/len @s.tools) 0) {} { tools: (array/map @s.tools (fn t { type: "function", function: { name: @t.name, description: @t.description, parameters: @t.parameters } })) }) (if (> @config.toolMaxTokens 0) { max_tokens: @config.toolMaxTokens } {})))
              (if (= @config.provider "openrouter") { reasoning: { enabled: (!= @config.reasoning "off") }, usage: { include: true } } {}))
              (if (!= @config.reasoningEffort "") { reasoning_effort: @config.reasoningEffort } {}))
              (let ((po (object/merge (object/merge (if (!= @config.providerSort "") { sort: @config.providerSort } {}) (if (> (array/len @config.providerOrder) 0) { order: @config.providerOrder } {})) (if (> (array/len @config.providerQuantizations) 0) { quantizations: @config.providerQuantizations } {}))))
                (if (and (= @config.provider "openrouter") (or (!= @config.providerSort "") (> (array/len @config.providerOrder) 0) (> (array/len @config.providerQuantizations) 0))) { provider: @po } {}))))))
        })

      LLM_TOOLS_DISPATCH -> idle when (or (= @config.provider "lmstudio") (= @config.provider "orbgen"))
        (set @entity.inflight (let ((k (object/get (default (json/parse @payload.session ToolsSession) {}) key ""))) (if (= @k "") @entity.inflight (array/append (array/filter @entity.inflight (fn c (!= @c.key @k))) { key: @k, httpKey: @payload.session, wireKey: (json/stringify { kind: "tools", id: @payload.session }) }))))
        (emit LLM_CHAT_WIRE {
          key: (json/stringify { kind: "tools", id: @payload.session }),
          method: "POST", path: (str/concat @config.basePath "/chat/completions"), query: {},
          headers: { Accept: "application/json" },
          json: @payload.body,
          form: {}, multipartParts: [], stream: "none",
          retryMax: 0, retryOn: [], retryOnFailure: [], retryDelaysMs: [], paginate: "none", maxPages: 1
        })
