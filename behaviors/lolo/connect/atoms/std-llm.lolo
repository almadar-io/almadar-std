      LLM_CHAT_STREAM_MSG -> idle when (and (!= @config.provider "anthropic") (= (str/len (object/get (object/get (default (array/first (object/get (default (json/parse @payload.data StreamEvent) {}) choices [])) {}) delta {}) content "")) 0))
        (set @entity.streamed (let ((cur (array/find @entity.streamed (fn c (= @c.key @payload.key)))) (u (object/get (default (json/parse @payload.data StreamEvent) {}) usage {}))) (array/append (array/filter @entity.streamed (fn c (!= @c.key @payload.key))) { key: @payload.key, text: (if (= @cur null) "" @cur.text), inputTokens: (if (> (object/get @u prompt_tokens 0) 0) (object/get @u prompt_tokens 0) (if (= @cur null) null @cur.inputTokens)), outputTokens: (if (> (object/get @u completion_tokens 0) 0) (object/get @u completion_tokens 0) (if (= @cur null) null @cur.outputTokens)) })))
        (when (> (str/len (object/get (object/get (default (array/first (object/get (default (json/parse @payload.data StreamEvent) {}) choices [])) {}) delta {}) reasoning "")) 0)
