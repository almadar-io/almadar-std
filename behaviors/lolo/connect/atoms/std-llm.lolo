        (emit LLM_CHAT_ERROR { job: @payload.key, message: (str/concat (object/get (default (json/parse @payload.key LlmJob) {}) model "") " returned an unreadable body") })
      LLM_CHAT_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= @config.provider "anthropic") (!= (json/parse @payload.body AnthropicReply) null))
        (emit LLM_CHAT_CONTENT {
          job: @payload.key,
          content: (let ((blocks (object/get (default (json/parse @payload.body AnthropicReply) {}) content [])))
            (if (and (= (array/len @blocks) 1) (= (object/get (default (array/first @blocks) {}) type "") "text"))
              (object/get (default (array/first @blocks) {}) text "")
              (json/stringify @blocks))),
          inputTokens: (if (= (object/get (object/get (default (json/parse @payload.body AnthropicReply) {}) usage {}) input_tokens null) null) null
            (+
              (object/get (object/get (default (json/parse @payload.body AnthropicReply) {}) usage {}) input_tokens 0)
              (object/get (object/get (default (json/parse @payload.body AnthropicReply) {}) usage {}) cache_creation_input_tokens 0)
              (object/get (object/get (default (json/parse @payload.body AnthropicReply) {}) usage {}) cache_read_input_tokens 0))),
          outputTokens: (object/get (object/get (default (json/parse @payload.body AnthropicReply) {}) usage {}) output_tokens null)
        })
      LLM_CHAT_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (!= @config.provider "anthropic"))
        (let ((parsed (json/parse @payload.body OpenaiErrorBody)))
          (let ((msg (if (= @parsed null) @payload.body
              (if (= (object/get @parsed error null) null) ""
                (if (!= (object/get (object/get @parsed error {}) message "") "")
                  (object/get (object/get @parsed error {}) message "")
                  (json/stringify (object/get @parsed error {})))))))
            (let ((full (if (= @msg "") (str/concat @payload.status " status code (no body)") (str/concat @payload.status " " @msg))))
              (emit LLM_CHAT_HTTP_ERROR { job: @payload.key, status: @payload.status, message: @full, tool: (str/includes @full "tool_calls") }))))
      LLM_CHAT_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (= @config.provider "anthropic"))
        (let ((parsed (json/parse @payload.body AnthropicErrorBody)))
          (let ((msg (if (= @parsed null) @payload.body
              (if (!= (object/get @parsed message "") "")
                (object/get @parsed message "")
                (str/join (object/get (array/reduce (array/map (array/range (str/len @payload.body)) (fn n (str/slice @payload.body @n (+ @n 1)))) { out: [], inStr: false, esc: false }
                  (fn acc ch
                    (if @acc.inStr
                      { out: (array/append @acc.out @ch), inStr: (if @acc.esc true (!= @ch "\"")), esc: (and (not @acc.esc) (= @ch "\\")) }
                      (if (= @ch "\"")
                        { out: (array/append @acc.out @ch), inStr: true, esc: false }
                        (if (array/includes [" " "\n" "\r" "\t"] @ch) @acc { out: (array/append @acc.out @ch), inStr: false, esc: false }))))) out []) "")))))
            (let ((full (if (= @msg "") (str/concat @payload.status " status code (no body)") (str/concat @payload.status " " @msg))))
              (emit LLM_CHAT_HTTP_ERROR { job: @payload.key, status: @payload.status, message: @full, tool: (str/includes @full "tool") }))))

      LLM_CHAT_HTTP_ERROR -> idle
        (emit LLM_CHAT_ERROR {
          job: @payload.job,
          message: (let ((code (if (and (= @payload.status 400) @payload.tool) "INVALID_TOOL_RESULTS"
              (match @payload.status (401 "MODEL_AUTHENTICATION") (404 "MODEL_NOT_FOUND") (429 "MODEL_RATE_LIMIT") (_ "")))))
            (if (= @code "") @payload.message
              (str/concat @payload.message "\n\nTroubleshooting URL: https://docs.langchain.com/oss/javascript/langchain/errors/" @code "/\n")))
        })

      LLM_CHAT_ERROR -> idle when (and (!= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classifyMany")
          (or (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "generate")
              (>= (object/get (default (json/parse @payload.job LlmJob) {}) attempt 0) 2)
              (str/includes (str/lower @payload.message) "rate limit") (str/includes (str/lower @payload.message) "429") (str/includes (str/lower @payload.message) "quota exceeded")))
        (emit LLM_FAILED { code: "", message: @payload.message })
      LLM_CHAT_ERROR -> idle when (and (= (object/get (default (json/parse @payload.job LlmJob) {}) action "") "classifyMany")
          (or (>= (object/get (default (json/parse @payload.job LlmJob) {}) attempt 0) 2)
              (str/includes (str/lower @payload.message) "rate limit") (str/includes (str/lower @payload.message) "429") (str/includes (str/lower @payload.message) "quota exceeded")))
