          retryAfterMs: (let ((h (object/get (default @payload.headers {}) "retry-after" ""))) (if (and (!= @h "") (= (str/replace-pattern @h "[^0-9]" "") @h)) (* (default (str/to-number @h) 0) 1000) null)),
          message: (str/concat "EmbeddingClient: " @config.embedProvider " returned " @payload.status " "
            (match @payload.status (400 "Bad Request") (401 "Unauthorized") (402 "Payment Required") (403 "Forbidden") (404 "Not Found") (405 "Method Not Allowed") (408 "Request Timeout") (409 "Conflict") (413 "Payload Too Large") (422 "Unprocessable Entity") (429 "Too Many Requests") (500 "Internal Server Error") (501 "Not Implemented") (502 "Bad Gateway") (503 "Service Unavailable") (504 "Gateway Timeout") (_ ""))
            ": " @payload.body)
        })
      LLM_EMBED_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (= (json/parse @payload.body EmbedReply) null))
        (emit LLM_EMBED_ERROR { job: @payload.key, status: 0, message: (str/concat "EmbeddingClient: " @config.embedProvider " returned unparseable body: " @payload.body) })
      LLM_EMBED_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body EmbedReply) null) (= (object/get (default (json/parse @payload.body EmbedReply) {}) data null) null))
        (emit LLM_EMBED_ERROR {
          job: @payload.key, status: 0,
          message: (str/concat "EmbeddingClient: " @config.embedProvider " response has no `data` array: "
            (if (!= (object/get (object/get (default (json/parse @payload.body EmbedReply) {}) error {}) message "") "")
              (object/get (object/get (default (json/parse @payload.body EmbedReply) {}) error {}) message "")
              @payload.body))
        })
      LLM_EMBED_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body EmbedReply) null) (!= (object/get (default (json/parse @payload.body EmbedReply) {}) data null) null)
          (!= (array/len (object/get (default (json/parse @payload.body EmbedReply) {}) data [])) (array/len (object/get (default (json/parse @payload.key EmbedJob) {}) texts []))))
        (emit LLM_EMBED_ERROR {
          job: @payload.key, status: 0,
          message: (str/concat "EmbeddingClient: provider returned " (array/len (object/get (default (json/parse @payload.body EmbedReply) {}) data [])) " embeddings for " (array/len (object/get (default (json/parse @payload.key EmbedJob) {}) texts [])) " inputs")
        })
      LLM_EMBED_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse @payload.body EmbedReply) null) (!= (object/get (default (json/parse @payload.body EmbedReply) {}) data null) null)
          (= (array/len (object/get (default (json/parse @payload.body EmbedReply) {}) data [])) (array/len (object/get (default (json/parse @payload.key EmbedJob) {}) texts []))))
        (emit LLM_EMBED_RESULT {
          embeddings: (let ((data (object/get (default (json/parse @payload.body EmbedReply) {}) data [])))
            (let ((n (array/len @data)))
              (array/map (array/sort (array/map @data (fn x (+ (* (object/get @x index 0) @n) @index)))) (fn k (object/get (default (let ((nxi (default (math/mod @k @n) 0))) (if (>= @nxi 0) (array/nth @data @nxi) null)) {}) embedding []))))),
          usage: { promptTokens: (object/get (object/get (default (json/parse @payload.body EmbedReply) {}) usage {}) prompt_tokens 0), totalTokens: (object/get (object/get (default (json/parse @payload.body EmbedReply) {}) usage {}) total_tokens 0) },
          key: (object/get (default (json/parse @payload.key EmbedJob) {}) callKey ""),
          model: (object/get (default (json/parse @payload.key EmbedJob) {}) model "")
        })
        (emit LLM_USAGE_REPORTED {
          provider: @config.embedProvider,
          model: (object/get (default (json/parse @payload.key EmbedJob) {}) model ""),
          action: "embed",
          inputTokens: (object/get (object/get (default (json/parse @payload.body EmbedReply) {}) usage {}) prompt_tokens 0)
        })
      LLM_EMBED_ERROR -> idle when (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))
        (emit LLM_FAILED { code: "", message: @payload.message, key: (object/get (default (json/parse @payload.job EmbedJob) {}) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (= @payload.status 429) (>= (object/get (default (json/parse @payload.job EmbedJob) {}) limited 0) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_FAILED { code: "", message: @payload.message, key: (object/get (default (json/parse @payload.job EmbedJob) {}) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (= @payload.status 429) (< (object/get (default (json/parse @payload.job EmbedJob) {}) limited 0) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_EMBED_SEND {
          job: (let ((j (default (json/parse @payload.job EmbedJob) {}))) (json/stringify { generic: @j.generic, limited: (+ @j.limited 1), model: @j.model, texts: @j.texts, callKey: (object/get @j callKey ""), delayMs: (if (!= (object/get @payload retryAfterMs null) null) (object/get @payload retryAfterMs null) (if (>= @j.limited 0) (array/nth [2000, 5000, 15000] @j.limited) null)) }))
        })
      LLM_EMBED_ERROR -> idle when (and (!= @payload.status 429) (>= (+ (object/get (default (json/parse @payload.job EmbedJob) {}) generic 0) 1) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_FAILED { code: "", message: @payload.message, key: (object/get (default (json/parse @payload.job EmbedJob) {}) callKey "") })
      LLM_EMBED_ERROR -> idle when (and (!= @payload.status 429) (< (+ (object/get (default (json/parse @payload.job EmbedJob) {}) generic 0) 1) 3)
          (not (or (str/includes (str/lower @payload.message) "context length") (str/includes (str/lower @payload.message) "maximum input length") (str/includes (str/lower @payload.message) "reduce the length of the input") (str/includes (str/lower @payload.message) "input_tokens"))))
        (emit LLM_EMBED_SEND {
          job: (let ((j (default (json/parse @payload.job EmbedJob) {}))) (json/stringify { generic: (+ @j.generic 1), limited: @j.limited, model: @j.model, texts: @j.texts, callKey: (object/get @j callKey ""), delayMs: (if (>= @j.generic 0) (array/nth [500, 2000] @j.generic) null) }))
        })
    }

    emits {
      LLM_GENERATE_RESULT -> external {
        content : string!
        usage : { promptTokens : number!, completionTokens : number!, totalTokens : number! }!
      }
        @description "The generated text and its token usage; the usage is zero when the provider reports none."
        @synonyms "completion, model reply, generated text"
        @tier "primary"
      LLM_USAGE_REPORTED -> external {
        provider : string!
        model : string!
        action : string!
        inputTokens : number
        outputTokens : number
      }
        @description "The token counts one provider reply reported, with the provider and the requested model; a count the provider did not report is absent, never zero. The kernel trace records it with the dispatch."
        @synonyms "token usage, usage report, tokens spent"
        @tier "secondary"
      LLM_GENERATE_DELTA -> external {
        key : string
        delta : string!
        text : string!
      }
        @description "A chunk of a streamed generate: the text that just arrived and the reply so far, under the call's key. Fires only for an LLM_GENERATE sent with stream true; the final LLM_GENERATE_RESULT follows."
        @synonyms "streamed text, reply chunk, token stream"
        @tier "secondary"
      LLM_REASONING_DELTA -> external {
        key : string
        delta : string!
      }
        @description "A chunk of the model's reasoning in a streamed call (OpenRouter `reasoning`, Anthropic `thinking`), under the call's key, for showing the model at work; it is not part of the answer."
        @synonyms "thinking, reasoning stream, model thoughts"
        @tier "secondary"
      LLM_CLASSIFY_RESULT -> external {
        category : string!
        confidence : number!
        reasoning : string!
      }
        @description "The declared category the model chose for the text, its confidence from 0 to 1 and its reasoning."
        @synonyms "classification, label, category verdict"
        @tier "primary"
      LLM_CLASSIFY_MANY_RESULT -> external {
        verdicts : [{ id : string!, category : string!, confidence : number!, reasoning : string! }]!
      }
        @description "One verdict per item, under the caller's id, with a declared category, a confidence from 0 to 1 and the model's reasoning for it."
        @synonyms "batch classification, many labels, verdicts"
        @tier "primary"
      LLM_SUMMARIZE_RESULT -> external {
        summary : string!
        keyPoints : [string]!
      }
        @description "A summary of the text and its key points."
        @synonyms "summary, digest, key points"
        @tier "primary"
      LLM_EMBED_RESULT -> external {
        embeddings : [[number]]!
        usage : { promptTokens : number!, totalTokens : number! }
        key : string
        model : string
      }
        @description "One embedding vector per input text, in input order, the provider's token usage (zero when it reports none), the key the request carried (empty when it carried none) and the model that made the vectors."
        @synonyms "vectors, text embeddings"
        @tier "primary"
      LLM_CHOOSE_RESULT -> external {
        choice : string!
        confidence : number!
      }
        @description "The option value Jev chose and its confidence."
        @synonyms "decision, pick, chosen option"
        @tier "primary"
      LLM_EXTRACT_RESULT -> external {
        json : string!
      }
        @description "The JSON text the model extracted, for the caller to read with json/parse under its own shape."
        @synonyms "extracted data, structured data, parsed fields"
        @tier "primary"
      LLM_CALL_TOOLS_RESULT -> external {
        reply : string!
        steps : [LlmStep]!
        usage : ToolsUsage!
      }
        @description "The model's final reply, every step of the run (each model call, each tool call and its answer) and the tokens used."
        @synonyms "agent reply, tool loop answer"
        @tier "primary"
      LLM_TOOLS_REQUESTED -> external {
        session : string!
        calls : [ToolCall]!
      }
        @description "The model asked for these tool calls, in order. Run each and answer them all in one LLM_TOOLS_ANSWERED that carries `session` back unchanged."
        @synonyms "tool calls, function calls, tool request"
        @tier "primary"
      LLM_TOOLS_STEP -> external {
        activity : LlmStep!
      }
        @description "One step of a call-tools run, as it is recorded: a model call, a tool call or a tool answer."
        @synonyms "progress, trace step"
        @tier "primary"
      LLM_CANCELLED -> external {
        key : string!
      }
        @description "A keyed generate, classify, classifyMany, summarize, extract, embed or call-tools run was cancelled by LLM_CANCEL before it answered: the key it carried. It ends in no result and no LLM_FAILED: the request is aborted on the wire and answers nothing."
        @synonyms "llm cancelled, request aborted"
        @tier "primary"
      LLM_FAILED -> external {
        code : string
        message : string!
        key : string
      }
        @description "A request that ended without an answer: the provider's error message, with a code when the atom or the model's reply is at fault (VALIDATION_ERROR, SERVICE_ERROR), when no first byte came twice within firstByteTimeoutMs (first-byte-timeout), or when the response cache could not be read (cache-read-failed), when a call-tools reply was cut off at the output cap (output-cut), or when the call-tools request timed out (timeout)."
        @synonyms "llm error, request failed"
        @tier "primary"
      LLM_CACHE_WRITE_FAILED -> external {
        message : string!
      }
        @description "A fresh reply could not be written to the response cache. The reply itself was delivered; only the cache entry is missing."
        @synonyms "cache write error"
        @tier "secondary"
      LLM_FIRST_BYTE_START -> external {
        key : string!
        delayMs : number!
      }
        @description "Arm the first-byte deadline of one wire request (std-delay START with this key and delay). Sent only when firstByteTimeoutMs is above 0."
        @tier "secondary"
      LLM_FIRST_BYTE_STOP -> external {
        key : string!
      }
        @description "Disarm the first-byte deadline of this wire key (std-delay CANCEL with this key): the request answered, failed, was cancelled, or its first stream frame arrived."
        @tier "secondary"
      LLM_CACHE_LOOKUP {
        job : string!
      }
        @description "Internal: a cacheable request, its JSON job carrying the cache key, waits for the row lookup."
        @tier "secondary"
      LLM_CACHE_NEXT {
      }
        @description "Internal: look up the oldest queued cacheable request."
        @tier "secondary"
      LLM_CACHE_LOADED {
        data : LlmCacheRow!
      }
        @description "Internal: the cache holds a row for the request at the head of the queue."
        @tier "secondary"
      LLM_CACHE_ABSENT {
        error : string
        code : string
      }
        @description "Internal: no cache row for the request at the head of the queue, or the store failed."
        @tier "secondary"
      LLM_CACHE_STORE {
        key : string!
        result : string!
      }
        @description "Internal: write one validated reply to the response cache under its key."
        @tier "secondary"
      LLM_CACHE_STORED {
        id : string!
      }
        @description "Internal: the cache row is stored."
        @tier "secondary"
      LLM_CACHE_NOT_STORED {
        error : string
        code : string
      }
        @description "Internal: the cache row could not be written."
        @tier "secondary"
      LLM_CHAT_SEND {
        job : string!
      }
        @description "Internal: one chat attempt, carried as its JSON job."
        @tier "secondary"
      LLM_CHAT_DISPATCH {
        job : string!
        body : string!
      }
        @description "Internal: the provider-shaped request body."
        @tier "secondary"
      LLM_CHAT_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the chat call's HTTP reply."
        @tier "secondary"
      LLM_CHAT_HTTP_OK {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the chat call's HTTP reply, before the call leaves the in-flight list."
        @tier "secondary"
      LLM_CHAT_HTTP_FAILED {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the chat call never produced a reply."
        @tier "secondary"
      LLM_CHAT_STREAM_MSG {
        data : string!
        event : string
        id : string
        key : string!
      }
        @description "Internal: one server-sent message of a streamed chat reply."
        @tier "secondary"
      LLM_CHAT_HTTP_ERROR {
        job : string!
        status : number!
        message : string!
        tool : boolean!
      }
        @description "Internal: a non-2xx chat reply read as the SDK message."
        @tier "secondary"
      LLM_CHAT_ERROR {
        job : string!
        message : string!
      }
        @description "Internal: a chat attempt that failed, before the retry decision."
        @tier "secondary"
      LLM_CHAT_CONTENT {
        job : string!
        content : string!
        inputTokens : number?
        outputTokens : number?
      }
        @description "Internal: the model's text and the token counts the provider reported (absent when it reported none)."
        @tier "secondary"
      LLM_CHAT_STRIPPED {
        job : string!
        text : string!
      }
        @description "Internal: the reply without thinking blocks."
        @tier "secondary"
      LLM_CHAT_JSON {
        job : string!
        json : string!
      }
        @description "Internal: the JSON text found in the reply, empty when none."
        @tier "secondary"
      LLM_CHAT_CHECKED {
        job : string!
        json : string!
        issues : string!
      }
        @description "Internal: the reply's schema issues, empty when it fits."
        @tier "secondary"
      LLM_CHAT_VERDICTS {
        job : string!
        json : string!
        problem : string!
      }
        @description "Internal: the classifyMany reply's item-label problem, empty when every item has one verdict."
        @tier "secondary"
      LLM_JEV_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the Jev decision call's HTTP reply."
        @tier "secondary"
      LLM_JEV_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the Jev decision call never produced a reply."
        @tier "secondary"
      LLM_JEV_CHECKED {
        key : string!
        body : string!
        problem : string!
      }
        @description "Internal: the Jev reply's problem, empty when it names a declared choice."
        @tier "secondary"
      LLM_TOOLS_SEND {
        session : string!
      }
        @description "Internal: the next model call of a tool run, carried as its JSON session."
        @tier "secondary"
      LLM_TOOLS_DISPATCH {
        session : string!
        body : string!
      }
        @description "Internal: the provider-shaped tool-calling request body."
        @tier "secondary"
      LLM_TOOLS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the tool-calling request's HTTP reply."
        @tier "secondary"
      LLM_TOOLS_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the tool-calling request never produced a reply."
        @tier "secondary"
      LLM_TOOLS_TURN {
        session : string!
      }
        @description "Internal: a model turn recorded in the session, before it is read as a reply or as tool calls."
        @tier "secondary"
      LLM_TOOLS_REPORT {
        session : string!
        index : number!
      }
        @description "Internal: steps still to report from this index, then the next model call."
        @tier "secondary"
      LLM_EMBED_SEND {
        job : string!
      }
        @description "Internal: one embeddings attempt, carried as its JSON job."
        @tier "secondary"
      LLM_EMBED_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the embeddings call's HTTP reply."
        @tier "secondary"
      LLM_EMBED_WAIT -> external {
        delayMs : number!
      }
        @description "Internal: start the delay before a retried embeddings attempt is written (std-delay START); LLM_EMBED_WAITED answers."
        @tier "secondary"
      LLM_EMBED_DISPATCH {
        job : string!
      }
        @description "Internal: write one embeddings attempt to the HTTP wire."
        @tier "secondary"
      LLM_EMBED_WIRE -> external {
        key : string!
        method : string!
        path : string!
        query : Map string string!
        headers : Map string string!
        json : string?
        form : Map string string!
        multipartParts : [LlmWirePart]!
        stream : string!
        retryMax : number!
        retryOn : [number]!
        retryOnFailure : [string]!
        retryDelaysMs : [number]!
        paginate : string!
        maxPages : number!
      }
        @description "The embeddings call as a std-http-request HTTP_REQUEST, keyed by its JSON job. The composer wires it to std-http-request and std-http-client; the server is the HttpClient host, port and tls knobs, and a keyed provider's credential is the HttpClient credential knobs, filled in by the host at the os/send boundary."
        @tier "secondary"
      LLM_CHAT_WIRE -> external {
        key : string!
        method : string!
        path : string!
        query : Map string string!
        headers : Map string string!
        json : string?
        form : Map string string!
        multipartParts : [LlmWirePart]!
        stream : string!
        retryMax : number!
        retryOn : [number]!
        retryOnFailure : [string]!
        retryDelaysMs : [number]!
        paginate : string!
        maxPages : number!
      }
        @description "The chat and tool-calling requests as a std-http-request HTTP_REQUEST, keyed by a JSON { kind, id }: the composer wires it to std-http-request and std-http-client; the server and the credential are the HttpClient knobs."
        @tier "secondary"
      LLM_EMBED_WIRE_CANCEL -> external {
        key : string!
      }
        @description "Abort the embeddings request keyed by this wire key: the composer routes it to std-http-request HTTP_REQUEST_CANCEL, which aborts the wire call in flight."
        @tier "secondary"
      LLM_CHAT_WIRE_CANCEL -> external {
        key : string!
      }
        @description "Abort the chat or tool-calling request keyed by this wire key: the composer routes it to std-http-request HTTP_REQUEST_CANCEL, which aborts the wire call in flight."
        @tier "secondary"
      LLM_JEV_WIRE -> external {
        key : string!
        method : string!
        path : string!
        query : Map string string!
        headers : Map string string!
        json : string?
        form : Map string string!
        multipartParts : [LlmWirePart]!
        stream : string!
        retryMax : number!
        retryOn : [number]!
        retryOnFailure : [string]!
        retryDelaysMs : [number]!
        paginate : string!
        maxPages : number!
      }
        @description "The Jev decision call as a std-http-request HTTP_REQUEST, keyed by its JSON option list; the composer wires it to its own std-http-request and std-http-client."
        @tier "secondary"
      LLM_EMBED_ERROR {
        job : string!
        message : string!
        status : number!
        retryAfterMs : number?
      }
        @description "Internal: an embeddings attempt that failed, before the retry decision."
        @tier "secondary"
    }

    listens {
      LLM_CHAT_WIRE_RESULT {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
        attempts : number!
        pages : number!
      }
        @description "The wire's answer: std-http-request HTTP_RESULT."
      LLM_CHAT_WIRE_FAILED {
        key : string!
        error : string!
        kind : string!
      }
        @description "The wire produced no response: std-http-request HTTP_REQUEST_FAILED."
      LLM_CHAT_WIRE_REFUSED {
        key : string!
        error : string!
      }
        @description "The wire refused to write the request: std-http-request HTTP_REQUEST_REFUSED."
      LLM_JEV_WIRE_RESULT {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
        attempts : number!
        pages : number!
      }
        @description "The wire's answer: std-http-request HTTP_RESULT."
      LLM_JEV_WIRE_FAILED {
        key : string!
        error : string!
        kind : string!
      }
        @description "The wire produced no response: std-http-request HTTP_REQUEST_FAILED."
      LLM_JEV_WIRE_REFUSED {
        key : string!
        error : string!
      }
        @description "The wire refused to write the request: std-http-request HTTP_REQUEST_REFUSED."
      LLM_CHAT_WIRE_STREAM {
        key : string!
        data : string!
        event : string?
        id : string?
      }
        @description "One complete frame of a streamed reply: std-http-client HTTP_STREAM_EVENT."
      LLM_EMBED_WAITED {
        waitedMs : number!
      }
      LLM_FIRST_BYTE_ELAPSED {
        waitedMs : number!
        key : string
      }
        @description "The first-byte deadline of a wire request passed: std-delay ELAPSED of the keyed deadline LLM_FIRST_BYTE_START armed. A key that is no longer armed (the request already answered) is ignored."
      LLM_EMBED_WIRE_RESULT {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
        attempts : number!
        pages : number!
      }
        @description "The wire's answer to LLM_EMBED_WIRE: std-http-request HTTP_RESULT."
      LLM_EMBED_WIRE_FAILED {
        key : string!
        error : string!
        kind : string!
      }
        @description "The wire produced no response: std-http-request HTTP_REQUEST_FAILED."
      LLM_EMBED_WIRE_REFUSED {
        key : string!
        error : string!
      }
        @description "The wire refused to write the request: std-http-request HTTP_REQUEST_REFUSED."
      LLM_GENERATE -> input {
        systemPrompt : string?
        userPrompt : string!
        model : string?
        temperature : number?
        maxTokens : number?
        key : string?
        images : [{ mediaType : string!, data : string! }]?
        stream : boolean?
      }
        @description "Generate text from a prompt. An optional key names the call for LLM_CANCEL. With stream true the reply is read as it arrives and each chunk is announced as LLM_GENERATE_DELTA before the final LLM_GENERATE_RESULT; without it nothing changes. With the cache knob on and temperature 0 a stored reply answers LLM_GENERATE_RESULT at once, with zero usage and no LLM_GENERATE_DELTA, even for a stream request."
        @synonyms "complete, chat, ask the model"
      LLM_CLASSIFY -> input {
        text : string!
        categories : [string]!
        instructions : string?
        temperature : number?
        model : string?
        key : string?
      }
        @description "Classify a text into one of the given categories. An optional key names the call for LLM_CANCEL. Optional instructions are put before the text, between <instructions> and </instructions>, for the model to weigh; the category must still be one of the given ones. An optional temperature replaces the default 0.1 (and with 0 and the cache knob on the reply is cached)."
        @synonyms "label text, categorize"
      LLM_CLASSIFY_MANY -> input {
        items : [{ id : string!, text : string! }]!
        categories : [string]!
        instructions : string?
        model : string?
        key : string?
      }
        @description "Classify many texts in one model call; every item's id comes back once with a declared category, a confidence and the model's reasoning. An optional key names the call for LLM_CANCEL. Optional instructions are put before the items, between <instructions> and </instructions>."
        @synonyms "batch classify, label many"
      LLM_SUMMARIZE -> input {
        text : string!
        maxLength : number?
        style : string?
        model : string?
        key : string?
      }
        @description "Summarize a text; style is bullet, detailed or concise (default), maxLength is a word limit."
        @synonyms "summarise, digest, condense"
      LLM_EMBED -> input {
        texts : [string]!
        model : string?
        key : string?
      }
        @description "Embed texts into vectors. An optional key names the call for LLM_CANCEL and is echoed on LLM_EMBED_RESULT and on the LLM_FAILED that ends it."
        @synonyms "vectorize, text embedding"
      LLM_CANCEL -> input {
        key : string!
      }
        @description "Abort the generate, classify, classifyMany, summarize, extract, embed or call-tools run that carries this key and is still waiting for its provider; it ends in LLM_CANCELLED. A key with nothing in flight is a no-op."
        @synonyms "abort, stop request, cancel call"
      LLM_CHOOSE -> input {
        state : string!
        instructions : string!
        options : [{ value : string!, description : string! }]!
      }
        @description "Choose one of at least two options with distinct values, by Jev's reading of the state."
        @synonyms "decide, pick an option, choose"
      LLM_EXTRACT -> input {
        text : string!
        schema : string!
        systemPrompt : string?
        temperature : number?
        maxTokens : number?
        model : string?
        key : string?
        images : [{ mediaType : string!, data : string! }]?
        stream : boolean?
      }
        @description "Extract structured data from a text. With the cache knob on and temperature 0 a stored reply answers LLM_EXTRACT_RESULT without a request. An optional key names the call for LLM_CANCEL. With stream true the reply is read as it arrives: each chunk is announced as LLM_GENERATE_DELTA and each reasoning chunk as LLM_REASONING_DELTA before LLM_EXTRACT_RESULT. `schema` is the JSON Schema text the reply must follow, sent to the model as written inside the built-in extractor prompt; an optional systemPrompt replaces that whole prompt (the schema is then not sent) and an optional temperature replaces the default 0.2. The answer is the JSON text, read by the caller with json/parse under its own shape."
        @synonyms "parse, structure, pull fields"
      LLM_CALL_TOOLS -> input {
        messages : [{ role : "user" | "assistant", content : string! }]!
        tools : [LlmToolDef]!
        instructions : string?
        maxSteps : number?
        model : string?
        key : string?
      }
        @description "Answer a conversation with tools (an optional key names the run for LLM_CANCEL, which aborts the model call at its provider): the model may ask for tool calls, which come back in LLM_TOOLS_REQUESTED for the caller to run and answer with LLM_TOOLS_ANSWERED, until the model replies or maxSteps (default 8) model calls are used."
        @synonyms "agent, tool use, function calling"
      LLM_TOOLS_ANSWERED -> input {
        session : string!
        results : [LlmToolOutcome]!
      }
        @description "The answers to one LLM_TOOLS_REQUESTED: one result per requested call, by id, with the `session` it carried."
        @synonyms "tool results, function results"
    }

    config {
      provider : "openai" | "anthropic" | "deepseek" | "kimi" | "openrouter" | "orbgen" | "masar" | "lmstudio" = openai
        @label "Chat provider"
        @description "The chat provider; it picks the wire format (Anthropic Messages or OpenAI chat completions), the keyless providers (lmstudio, orbgen) and the provider-specific body fields (kimi, openrouter)."
        @synonyms "llm provider, model vendor"
        @tier "infra"
      reasoningEffort : string = ""
        @label "Reasoning effort"
        @description "Sent as reasoning_effort on an OpenAI-compatible chat (lmstudio, openai, ...) when not empty: a reasoning model's thinking budget, and \"none\" turns thinking off (LM Studio honors it for qwen3). Empty sends nothing and the model decides. Not sent to the anthropic Messages wire."
        @synonyms "thinking, reasoning, no think, thinking off"
        @tier "domain"
      reasoning : "default" | "on" | "off" = default
        @label "Reasoning switch"
        @description "The openrouter reasoning object on every path, tool calls included: default keeps today's body (no reasoning object on a plain chat, enabled true on a tool call), on sends { enabled: true }, off sends { enabled: false }. Other providers send no reasoning object whatever the value; their thinking budget is reasoningEffort."
        @synonyms "thinking switch, reasoning on off"
        @tier "domain"
      providerSort : "" | "throughput" | "latency" | "price" = ""
        @label "Provider sort"
        @description "OpenRouter provider routing: sent as provider.sort on the openrouter provider when not empty (throughput prefers the fastest tokens per second, latency the fastest first token, price the cheapest). Empty sends nothing."
        @synonyms "openrouter routing, provider preference"
        @tier "domain"
      providerOrder : [string] = []
        @label "Provider order"
        @description "OpenRouter provider routing: provider slugs tried in this order, sent as provider.order on the openrouter provider when not empty."
        @synonyms "provider priority"
        @tier "domain"
      providerQuantizations : [string] = []
        @label "Provider quantizations"
        @description "OpenRouter provider routing: the quantizations a provider may serve (for example fp8, bf16), sent as provider.quantizations on the openrouter provider when not empty."
        @synonyms "allowed quantization"
        @tier "domain"
      toolTemperature : number = -1
        @label "Tool-call temperature"
        @description "The temperature of a call-tools request. -1 keeps today's value (0.7, 0.6 for kimi); 0 or more is sent as written."
        @synonyms "agent temperature"
        @tier "domain"
      parallelToolCalls : boolean = false
        @label "Parallel tool calls"
        @description "Sent as parallel_tool_calls on an OpenAI-compatible call-tools request: true lets the model ask for several tool calls in one turn."
        @synonyms "concurrent tools"
        @tier "domain"
      cacheControl : boolean = false
        @label "Prompt cache control"
        @description "On the openrouter provider, mark the system message as a cache breakpoint ({ type: \"ephemeral\" } cache_control on its text part) the way the anthropic wire already does, for chat and call-tools requests. Off sends the system message as plain text."
        @synonyms "prompt caching, cache breakpoint"
        @tier "domain"
      firstByteTimeoutMs : number = 0
        @label "First-byte timeout (ms)"
        @description "0 is off. Above 0, a chat or call-tools request that shows no first byte within this time is aborted on the wire (LLM_CHAT_WIRE_CANCEL) and sent once more; a second miss ends in LLM_FAILED with code first-byte-timeout. The first byte is the first complete stream frame of a streamed request (a keep-alive comment is not one); the std-http-client reports a non-streamed reply only whole, so for those the deadline is the arrival of the whole reply. Needs the composer to wire LLM_FIRST_BYTE_START, LLM_FIRST_BYTE_STOP and LLM_FIRST_BYTE_ELAPSED to a std-delay (keyed deadlines)."
        @synonyms "stall timeout, time to first token, resend on stall"
        @tier "domain"
      cache : boolean = false
        @label "Response cache"
        @description "When on, an extract, classify, classify-many or generate request at temperature 0 (only those; call-tools is never cached) is looked up in the LlmCacheRow store under a hash/sha 256 of its model, provider, action, temperature, max tokens, system prompt, text, categories and images. A row younger than cacheTtlMs answers the normal result event without a network call (a streamed request answers its final result directly, with no deltas); otherwise the request is sent and its validated reply is written to the store, replacing an expired row. A request at any other temperature is sent as usual."
        @synonyms "memoize replies, reply cache"
        @tier "domain"
      cacheTtlMs : number = 604800000
        @label "Cache lifetime (ms)"
        @description "How long a cached reply stays valid, 7 days by default; an older row is replaced by the next call."
        @synonyms "cache expiry"
        @tier "domain"
      basePath : string = "/v1"
        @label "Chat base path"
        @description "The path before /chat/completions (or /messages for Anthropic), for example /v1 or /api/v1."
        @synonyms "api prefix, version path"
        @tier "infra"
      toolMaxTokens : number = 0
        @label "Tool call output limit"
        @description "The most tokens one model reply of a tool loop may hold, sent as max_tokens to an OpenAI-compatible provider; 0 sends none and leaves the limit to the provider. A reply cut off at the limit ends its turn with whatever the provider returned."
        @synonyms "max tokens, output cap, reply length limit"
        @tier "policy"
      model : string = "gpt-4o"
        @label "Default chat model"
        @description "The model used when a request names none."
        @synonyms "default model, model id"
        @tier "infra"
      embedProvider : "openrouter" | "openai" | "lmstudio" = openrouter
        @label "Embedding provider"
        @description "The embeddings provider, named in its failure messages; the server and the credential are the composed HttpClient knobs."
        @synonyms "embedding vendor"
        @tier "infra"
      embedBasePath : string = "/api/v1"
        @label "Embeddings base path"
        @description "The path before /embeddings."
        @synonyms "embedding prefix"
        @tier "infra"
      embedModel : string = "baai/bge-base-en-v1.5"
        @label "Embedding model"
        @description "The embedding model used when a request names none."
        @synonyms "embedding model id"
        @tier "infra"
    }
  }

  page boot as LlmPage -> LlmClient
}
