      LLM_CHAT_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (!= @config.provider "anthropic") (!= (json/parse @payload.body OpenaiReply) null) (= (array/len (object/get (default (json/parse @payload.body OpenaiReply) {}) choices [])) 0))
