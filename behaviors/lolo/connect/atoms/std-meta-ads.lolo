app std-meta-ads [
  version: "1.0.0",
  description: "std-meta-ads — read-only Meta Graph API Marketing Insights. META_ADS_GET_SPEND answers total spend, impressions and clicks of an ad account over a date range; META_ADS_LIST_CAMPAIGNS lists the account's campaigns with dailyBudget converted from Meta's minor units. The access token is the credential of the composed std-http-client trait MetaAdsHttp, written by the host as the access_token query parameter; a failed call answers META_ADS_FAILED.",
  net: { "graph.facebook.com:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
type MetaInsightRow = { spend : string, impressions : string, clicks : string, account_currency : string }
type MetaInsightsReply = { data : [MetaInsightRow] }
type MetaCampaignRow = { id : string, name : string, status : string, daily_budget : string }
type MetaCampaignsReply = { data : [MetaCampaignRow] }
type MetaCampaign = { id : string, name : string, status : string, dailyBudget : number }
type MetaCount = { v : number }
type MetaErrorDetail = { message : string }
type MetaErrorReply = { error : MetaErrorDetail }
orbital MetaAdsOrbital {
  entity MetaAdsLookup [runtime] {
    id : string!
  }

  trait MetaAdsHttp = Http.traits.HttpClient {
    config {
      host: "graph.facebook.com"
      port: 443
      tls: true
      serverName: "graph.facebook.com"
      credential: "META_ACCESS_TOKEN"
      credentialIn: "query"
      credentialName: "access_token"
    }
    listens {
      MetaAdsClient.META_ADS_HTTP_SEND -> HTTP_SEND
      MetaAdsTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
    }
  }

  trait MetaAdsTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 15000
      cancelOnDeadline: false
    }
    listens {
      MetaAdsClient.META_ADS_HTTP_SEND -> START with { key: (as ?key CallKey) }
      MetaAdsHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      MetaAdsHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait MetaAdsClient -> MetaAdsLookup [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      META_ADS_GET_SPEND -> idle when (= (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "")
        (emit META_ADS_FAILED { message: "No ad account: pass `accountId` or set META_AD_ACCOUNT_ID" })
      META_ADS_GET_SPEND -> idle when (!= (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "")
        (emit META_ADS_HTTP_SEND {
          key: "spend",
          method: "GET",
          target: (str/concat (str/concat "/" @config.apiVersion "/" (if (str/startsWith (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "act_") "" "act_") (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "/insights") "?fields=" (str/encode-uri-component "spend,impressions,clicks,account_currency") "&time_range=" (str/encode-uri-component (str/concat "{\"since\":" (json/stringify @payload.since) ",\"until\":" (json/stringify @payload.until) "}")) "&level=account"),
          headers: [{ name: "accept", value: "*/*" }], body: (bytes/from-string ""), stream: "none"
        })
      META_ADS_SPEND_REPLIED -> idle when (>= @payload.status 500)
        (emit META_ADS_FAILED { message: (str/concat "Meta Graph API returned " (default (format/number @payload.status) "")) })
      META_ADS_SPEND_REPLIED -> idle when (and (< @payload.status 500) (or (< @payload.status 200) (>= @payload.status 300)))
        (emit META_ADS_FAILED { message: (str/concat "Meta Graph API error: " (let ((e (json/parse @payload.body MetaErrorReply))) (default (if (= @e null) null (object/get @e "error.message" null)) (default (format/number @payload.status) "")))) })
      META_ADS_SPEND_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((reply (json/parse @payload.body MetaInsightsReply)))
          (if (= @reply null)
            (emit META_ADS_FAILED { code: "MALFORMED_REPLY", message: "Meta Graph API replied with insights that are not a list" })
            (let ((row (array/first (default (object/get @reply data []) []))))
              (if (= @row null)
                (emit META_ADS_SPEND_RESULT { spend: 0, currency: "", impressions: 0, clicks: 0 })
                (let ((sp (if (= (str/trim (object/get @row spend "")) "") 0 (str/to-number (str/trim (object/get @row spend ""))))) (im (if (= (str/trim (object/get @row impressions "")) "") 0 (str/to-number (str/trim (object/get @row impressions ""))))) (cl (if (= (str/trim (object/get @row clicks "")) "") 0 (str/to-number (str/trim (object/get @row clicks ""))))))
                  (if (or (= @sp null) (= @im null) (= @cl null))
                    (emit META_ADS_FAILED { code: "MALFORMED_REPLY", message: "Meta Graph API replied with an insights row whose counts are not numbers" })
                    (emit META_ADS_SPEND_RESULT { spend: @sp, currency: (object/get @row account_currency ""), impressions: @im, clicks: @cl })))))))
      META_ADS_SPEND_FAILED -> idle when (= @payload.kind "denied")
        (emit META_ADS_FAILED { message: @payload.error })
      META_ADS_SPEND_FAILED -> idle when (= @payload.kind "timeout")
        (emit META_ADS_FAILED { message: "The operation was aborted due to timeout" })
      META_ADS_SPEND_FAILED -> idle when (and (!= @payload.kind "denied") (!= @payload.kind "timeout"))
        (emit META_ADS_FAILED { message: "fetch failed" })

      META_ADS_LIST_CAMPAIGNS -> idle when (= (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "")
        (emit META_ADS_FAILED { message: "No ad account: pass `accountId` or set META_AD_ACCOUNT_ID" })
      META_ADS_LIST_CAMPAIGNS -> idle when (!= (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "")
        (emit META_ADS_HTTP_SEND {
          key: "campaigns",
          method: "GET",
          target: (str/concat (str/concat "/" @config.apiVersion "/" (if (str/startsWith (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "act_") "" "act_") (if (!= (default @payload.accountId "") "") @payload.accountId @config.defaultAccountId) "/campaigns") "?fields=" (str/encode-uri-component "id,name,status,daily_budget") (if (!= (default @payload.status "") "") (str/concat "&effective_status=" (str/encode-uri-component (json/stringify [@payload.status]))) "")),
          headers: [{ name: "accept", value: "*/*" }], body: (bytes/from-string ""), stream: "none"
        })
      META_ADS_CAMPAIGNS_REPLIED -> idle when (>= @payload.status 500)
        (emit META_ADS_FAILED { message: (str/concat "Meta Graph API returned " (default (format/number @payload.status) "")) })
      META_ADS_CAMPAIGNS_REPLIED -> idle when (and (< @payload.status 500) (or (< @payload.status 200) (>= @payload.status 300)))
        (emit META_ADS_FAILED { message: (str/concat "Meta Graph API error: " (let ((e (json/parse @payload.body MetaErrorReply))) (default (if (= @e null) null (object/get @e "error.message" null)) (default (format/number @payload.status) "")))) })
      META_ADS_CAMPAIGNS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (not (json/valid @payload.body)))
        (emit META_ADS_FAILED { code: "MALFORMED_REPLY", message: "Meta Graph API replied with a body that is not valid JSON" })
      META_ADS_CAMPAIGNS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body) (let ((r (json/parse @payload.body MetaCampaignsReply))) (if (= @r null) true (not (validate/array (default (object/get @r data []) []))))))
        (emit META_ADS_FAILED { code: "MALFORMED_REPLY", message: "Meta Graph API replied with campaigns that are not a list" })
      META_ADS_CAMPAIGNS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body) (let ((r (json/parse @payload.body MetaCampaignsReply))) (if (= @r null) false (validate/array (default (object/get @r data []) [])))))
        (let ((rows (array/map (default (object/get (default (json/parse @payload.body MetaCampaignsReply) { data: [] }) data []) []) (fn row {
            id: (object/get @row id ""),
            name: (object/get @row name ""),
            status: (object/get @row status ""),
            dailyBudget: (if (= (str/trim (object/get @row daily_budget "")) "") 0 (let ((n (str/to-number (str/trim (object/get @row daily_budget ""))))) (if (= @n null) null (/ @n 100))))
          }))))
          (if (array/some @rows (fn r (= @r.dailyBudget null)))
            (emit META_ADS_FAILED { code: "MALFORMED_REPLY", message: "Meta Graph API replied with a campaign whose daily budget is not a number" })
            (emit META_ADS_CAMPAIGNS_RESULT { campaigns: @rows })))
      META_ADS_CAMPAIGNS_FAILED -> idle when (= @payload.kind "denied")
        (emit META_ADS_FAILED { message: @payload.error })
      META_ADS_CAMPAIGNS_FAILED -> idle when (= @payload.kind "timeout")
        (emit META_ADS_FAILED { message: "The operation was aborted due to timeout" })
      META_ADS_CAMPAIGNS_FAILED -> idle when (and (!= @payload.kind "denied") (!= @payload.kind "timeout"))
        (emit META_ADS_FAILED { message: "fetch failed" })
    }

    emits {
      META_ADS_SPEND_RESULT -> external {
        spend : number
        currency : string!
        impressions : number
        clicks : number
      }
        @description "Total spend, impressions and clicks of the ad account over the range; zeros and an empty currency when Meta returns no rows, spend null when Meta's figure is not numeric."
        @synonyms "ad spend, meta spend, facebook ads cost, campaign insights"
        @tier "primary"
      META_ADS_CAMPAIGNS_RESULT -> external {
        campaigns : [MetaCampaign]!
      }
        @description "The ad account's campaigns with id, name, status and dailyBudget in major currency units."
        @synonyms "meta campaigns, facebook ad campaigns, campaign list"
        @tier "primary"
      META_ADS_FAILED -> external {
        code : string
        message : string!
      }
        @description "The Meta Graph call failed: no ad account, missing access token, unreachable API, a 5xx reply, a Graph API error message, or a 2xx campaigns reply that is not valid JSON or not a list (code MALFORMED_REPLY)."
        @synonyms "meta ads error, graph api failure"
        @tier "primary"
      META_ADS_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one Graph API request, for the HTTP client."
        @tier "secondary"
    }

    listens {
      META_ADS_GET_SPEND -> input {
        accountId : string
        since : string!
        until : string!
      }
        @description "Fetch total spend, impressions and clicks of an ad account (id with or without the act_ prefix; defaults to the defaultAccountId knob) for a date range (YYYY-MM-DD)."
        @synonyms "get ad spend, meta spend report, insights for range"
      META_ADS_LIST_CAMPAIGNS -> input {
        accountId : string
        status : string
      }
        @description "List campaigns of an ad account, optionally filtered by effective status (ACTIVE, PAUSED)."
        @synonyms "list meta campaigns, campaigns by status"
      META_ADS_SPEND_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      META_ADS_SPEND_FAILED {
        error : string!
        kind : string!
      }
      META_ADS_CAMPAIGNS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      META_ADS_CAMPAIGNS_FAILED {
        error : string!
        kind : string!
      }
      MetaAdsHttp.HTTP_REPLIED -> META_ADS_SPEND_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "spend")
      MetaAdsHttp.HTTP_FAILED -> META_ADS_SPEND_FAILED with { error: ?error, kind: ?kind } when (= ?key "spend")
      MetaAdsHttp.HTTP_REPLIED -> META_ADS_CAMPAIGNS_REPLIED with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "campaigns")
      MetaAdsHttp.HTTP_FAILED -> META_ADS_CAMPAIGNS_FAILED with { error: ?error, kind: ?kind } when (= ?key "campaigns")
      MetaAdsTimeout.TIMED_OUT -> META_ADS_SPEND_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "spend")
      MetaAdsTimeout.TIMED_OUT -> META_ADS_CAMPAIGNS_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "campaigns")
    }

    config {
      apiVersion : string = "v21.0"
        @label "Graph API version"
        @description "The Graph API version path segment."
        @synonyms "api version, graph version"
        @tier "infra"
      defaultAccountId : string = ""
        @label "Default ad account id"
        @description "Ad account id used when a request passes none (with or without the act_ prefix)."
        @synonyms "ad account, default account"
        @tier "infra"
    }
  }

  page boot as MetaAdsPage -> MetaAdsClient, MetaAdsHttp, MetaAdsTimeout
}
