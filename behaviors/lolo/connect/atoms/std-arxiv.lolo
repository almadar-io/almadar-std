app std-arxiv [
  version: "1.0.0",
  description: "std-arxiv — arXiv paper search through the keyless public Atom API (export.arxiv.org). ARXIV_SEARCH requests a relevance-ranked feed; a blank query or a non-2xx reply answers an empty result list. A 2xx feed is read with xml/parse into the paper list; a failed call or a 2xx body that is not well-formed XML answers ARXIV_SEARCH_ERROR { error, kind } (kind: timeout, failed, refused, unconfigured or malformed).",
  egress: ["https://export.arxiv.org"]
]
type ArxivAuthor = { name : string }
type ArxivLink = { "@href" : string, "@rel" : string }
type ArxivEntry = { id : string, title : string, summary : string, published : string, author : [ArxivAuthor], link : [ArxivLink] }
type ArxivFeed = { entry : [ArxivEntry] }
type ArxivPaper = { id : string, title : string, summary : string, authors : [string], published : string, url : string }
orbital ArxivOrbital {
  entity ArxivLookup [runtime] {
    id : string!
  }

  trait ArxivClient -> ArxivLookup [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle

      ARXIV_SEARCH -> idle when (!= (str/trim @payload.query) "")
        (http GET @config.origin "/api/query" {
          query: {
            search_query: (str/concat "all:" (str/trim @payload.query)),
            start: 0,
            max_results: (math/default @payload.maxResults 8),
            sortBy: "relevance"
          },
          headers: { Accept: "application/atom+xml" },
          timeoutMs: @config.timeoutMs
        } { emit: { success: ARXIV_SEARCH_REPLIED, failure: ARXIV_SEARCH_FAILED } })
      ARXIV_SEARCH -> idle when (= (str/trim @payload.query) "")
        (emit ARXIV_SEARCH_RESULT { results: [] })
      ARXIV_SEARCH_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (xml/valid @payload.body))
        (emit ARXIV_SEARCH_RESULT {
          results: (array/map
            (array/filter
              (let ((feed (xml/parse @payload.body ArxivFeed))) (if (validate/object @feed) (object/get @feed entry []) []))
              (fn e (or (!= (object/get @e id "") "") (!= (object/get @e title "") ""))))
            (fn e {
              id: (object/get @e id ""),
              title: (object/get @e title ""),
              summary: (object/get @e summary ""),
              authors: (array/map
                (array/filter (object/get @e author []) (fn a (object/has @a name)))
                (fn a (object/get @a name ""))),
              published: (object/get @e published ""),
              url: (let ((alt (array/find
                  (object/get @e link [])
                  (fn l (and (= (object/get @l (quote "@rel") "") "alternate") (!= (object/get @l (quote "@href") "") ""))))))
                (if (!= @alt null) (object/get @alt (quote "@href") "") (object/get @e id "")))
            }))
        })
      ARXIV_SEARCH_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (not (xml/valid @payload.body)))
        (emit ARXIV_SEARCH_ERROR { error: "arXiv returned a malformed Atom feed", kind: "malformed" })
      ARXIV_SEARCH_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit ARXIV_SEARCH_RESULT { results: [] })
      ARXIV_SEARCH_FAILED -> idle
        (emit ARXIV_SEARCH_ERROR { error: @payload.error, kind: @payload.kind })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "arXiv unavailable: " @payload.error) })
    }

    emits {
      ARXIV_SEARCH_RESULT -> external {
        results : [ArxivPaper]!
      }
        @description "Papers matching the search, most relevant first; empty when the query is blank or arXiv answered non-2xx."
        @synonyms "paper search results, preprints, academic papers"
        @tier "primary"
      ARXIV_SEARCH_ERROR -> external {
        error : string!
        kind : string!
      }
        @description "The search failed: the call timed out, failed, was refused or unconfigured, or the 2xx body is not a well-formed XML document; no paper list is produced."
        @synonyms "malformed feed, arxiv parse failure"
        @tier "primary"
      ARXIV_SEARCH_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the search call's HTTP reply."
        @tier "secondary"
      ARXIV_SEARCH_FAILED {
        error : string!
        kind : string!
      }
        @description "Internal: the search call never produced a reply."
        @tier "secondary"
    }

    listens {
      ARXIV_SEARCH -> external {
        query : string!
        maxResults : number
      }
        @description "Search arXiv by relevance across all fields; maxResults defaults to 8."
        @synonyms "find papers, search preprints, look up research"
      ARXIV_SEARCH_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      ARXIV_SEARCH_FAILED {
        error : string!
        kind : string!
      }
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports an unreachable arXiv call; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      origin : url = "https://export.arxiv.org"
        @label "arXiv API origin"
        @description "The arXiv API origin (scheme://host, no path). Must be declared in the app egress list."
        @synonyms "arxiv url, api host"
        @tier "infra"
      timeoutMs : number = 10000
        @label "Request timeout (ms)"
        @description "Milliseconds each arXiv request may take before it counts as failed."
        @synonyms "timeout, request deadline, wait limit"
        @tier "infra"
    }
  }

  page "/arxiv" as ArxivPage -> ArxivClient
}
