        @tier "primary"
      GITHUB_LIST_RUNNERS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the runner list's HTTP reply; key carries the scope."
        @tier "secondary"
      GITHUB_LIST_RUNNERS_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the runner list never produced a reply."
        @tier "secondary"
      GITHUB_RUNS -> external {
        owner : string!
        repo : string!
        runs : [GithubRun]!
      }
        @description "A repository's workflow runs, newest first: id, workflow name, status, conclusion (absent while running), creation time and page url."
        @synonyms "workflow runs, actions runs, ci runs"
        @tier "primary"
      GITHUB_LIST_RUNS_FAILED -> external {
        owner : string!
        repo : string!
        code : string
        message : string!
      }
        @description "Listing a repository's workflow runs failed: the repository, GitHub's code and message."
        @synonyms "listing runs failed, github error"
        @tier "primary"
      GITHUB_LIST_RUNS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the run list's HTTP reply; key carries the repository."
        @tier "secondary"
      GITHUB_LIST_RUNS_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the run list never produced a reply."
        @tier "secondary"
      GITHUB_RUN_JOBS -> external {
        owner : string!
        repo : string!
        runId : number!
        jobs : [GithubJob]!
      }
        @description "A workflow run's jobs: id, name, status, conclusion and page url."
        @synonyms "run jobs, workflow jobs"
        @tier "primary"
      GITHUB_LIST_RUN_JOBS_FAILED -> external {
        owner : string!
        repo : string!
        runId : number!
        code : string
        message : string!
      }
        @description "Listing a run's jobs failed: the repository and run, GitHub's code and message."
        @synonyms "listing jobs failed, github error"
        @tier "primary"
      GITHUB_LIST_RUN_JOBS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the job list's HTTP reply; key carries the repository and run."
        @tier "secondary"
      GITHUB_LIST_RUN_JOBS_UNREACHABLE {
        error : string!
