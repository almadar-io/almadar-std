      GITHUB_GET_FILE -> external {
        owner : string!
        repo : string!
        path : string!
        ref : string
      }
        @description "Read a file of a repository at an optional branch, tag or commit; the content is decoded to text."
        @synonyms "read file, get file contents, fetch source file"
      GITHUB_GET_FILE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      GITHUB_GET_FILE_UNREACHABLE {
        error : string!
        kind : string!
      }
      GITHUB_LIST_COMMITS -> external {
        owner : string!
        repo : string!
        path : string
        ref : string
        per_page : number
      }
        @description "List commits of a repository, optionally only those touching a path, starting from a branch, tag or commit."
        @synonyms "list commits, commit history, file history"
      GITHUB_LIST_COMMITS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      GITHUB_LIST_COMMITS_UNREACHABLE {
        error : string!
        kind : string!
      }
      GITHUB_CREATE_ISSUE -> external {
        owner : string!
        repo : string!
        title : string!
        body : string
        labels : [string]
      }
        @description "Open an issue on a repository, with an optional body and labels."
        @synonyms "open issue, create issue, file a bug"
      GITHUB_CREATE_ISSUE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      GITHUB_CREATE_ISSUE_UNREACHABLE {
        error : string!
        kind : string!
      }
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports an unreachable GitHub call; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      origin : url = "https://api.github.com"
        @label "GitHub API origin"
        @description "The GitHub API origin (scheme://host, no path); a GitHub Enterprise host must also be declared in the app egress list."
        @synonyms "github url, api host, enterprise host"
        @tier "infra"
      token : secret = "GITHUB_TOKEN"
        @label "GitHub token"
        @description "Name of the credential holding the GitHub personal access token."
        @synonyms "github token, access token, pat"
        @tier "infra"
      owner : string = ""
        @label "Default repository owner"
        @description "Owner (user or org) of the repository the pull request and issue actions without an owner parameter act on; set from GITHUB_OWNER."
        @synonyms "repo owner, organization, account"
        @tier "infra"
      repo : string = ""
        @label "Default repository name"
        @description "Name of the repository the pull request and issue actions without a repo parameter act on; set from GITHUB_REPO."
        @synonyms "repository, repo name"
        @tier "infra"
      apiVersion : string = "2022-11-28"
        @label "API version"
        @description "Value of the X-GitHub-Api-Version header sent with every request."
        @synonyms "api version, github version header"
        @tier "infra"
      timeoutMs : number = 30000
        @label "Request timeout (ms)"
        @description "Milliseconds each GitHub request may take before it fails as unreachable."
        @synonyms "timeout, request deadline, wait limit"
        @tier "infra"
      statusText : Map string string = { "400": "Bad Request", "401": "Unauthorized", "402": "Payment Required", "403": "Forbidden", "404": "Not Found", "405": "Method Not Allowed", "408": "Request Timeout", "409": "Conflict", "410": "Gone", "413": "Payload Too Large", "422": "Unprocessable Entity", "500": "Internal Server Error", "501": "Not Implemented", "502": "Bad Gateway", "503": "Service Unavailable", "504": "Gateway Timeout" }
        @label "Status texts"
        @description "Reason phrase by HTTP status, used in the failure message when GitHub's error body carries no message."
        @synonyms "reason phrases, status names"
        @tier "infra"
    }
  }

  page "/github" as GithubPage -> GithubClient
}
