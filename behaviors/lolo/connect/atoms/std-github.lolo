app std-github [
  version: "1.0.0",
  description: "std-github — the GitHub REST API (api.github.com) as one atom: open a pull request, list a pull request's review comments, list and read issues, open an issue, read a file at a ref, list commits, list a repository's workflow runs and a run's jobs, read an organization's or user's monthly billing usage, and run a GraphQL query (answered as the reply text; its failure carries the HTTP status, 0 when unreachable). Requests are authenticated with the GitHub token knob and carry the 2022-11-28 API version. A non-2xx reply answers the action's failure event with GitHub's code (RATE_LIMIT_ERROR for 429, AUTH_ERROR for 401/403, SERVICE_ERROR otherwise) and message; an unreachable API answers NETWORK_ERROR. The git CLI actions (clone, branch, commit, push) are local processes, not HTTP, and are not part of this atom.",
  egress: ["https://api.github.com"]
]
uses Spec from "almadar-std/github"
type GithubError = { message : string }
type GithubRef = { ref : string }
type GithubPull = { number : number, url : string, html_url : string, title : string, state : string, draft : boolean, head : GithubRef, base : GithubRef }
type GithubUser = { login : string }
type GithubLabel = { name : string, color : string }
type GithubComment = { id : number, body : string, user : GithubUser, created_at : string }
type GithubIssue = { number : number, url : string, title : string, body : string, state : string, labels : [GithubLabel], created_at : string, updated_at : string }
type GithubCommit = { sha : string, message : string, author : string, date : string }
type GithubFileData = { path : string, content : string, sha : string, size : number, encoding : string }
type GithubCommitAuthor = { name : string, email : string, date : string }
type GithubCommitDetail = { message : string, author : GithubCommitAuthor }
type GithubCommitItem = { sha : string, commit : GithubCommitDetail }
type GithubCreatedIssue = { number : number, title : string, url : string }
type GithubRun = { id : number, name : string, status : string, conclusion : string, created_at : string, html_url : string }
type GithubRunList = { workflow_runs : [GithubRun] }
type GithubJob = { id : number, name : string, status : string, conclusion : string, html_url : string }
type GithubJobList = { jobs : [GithubJob] }
type GithubRunner = { id : number, name : string, status : string, busy : boolean }
type GithubRunnerList = { runners : [GithubRunner] }
type GithubRunnersKey = { scope : string }
type GithubRunsKey = { owner : string, repo : string }
type GithubJobsKey = { owner : string, repo : string, runId : number }
type GithubUsageItem = { product : string, sku : string, quantity : number, unitType : string, grossAmount : number, discountAmount : number, netAmount : number, repositoryName : string }
type GithubUsageReport = { usageItems : [GithubUsageItem] }
type GithubBillingKey = { account : string, kind : string, year : number, month : number }
orbital GithubOrbital {
  entity GithubCall [runtime] {
    id : string!
  }

  trait GithubClient -> GithubCall [integration, instance] {
    initial: idle

    state idle {
      INIT -> idle

      GITHUB_CREATE_PR -> idle when (and (!= @config.owner "") (!= @config.repo ""))
        (http POST @config.origin (str/concat "/repos/" @config.owner "/" @config.repo "/pulls") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion, Content-Type: "text/plain;charset=UTF-8" },
          text: (json/stringify { title: @payload.title, body: @payload.body, base: @payload.baseBranch, head: @payload.headBranch, draft: (or @payload.draft false) }),
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_CREATE_PR_REPLIED, failure: GITHUB_CREATE_PR_UNREACHABLE } })
      GITHUB_CREATE_PR -> idle when (or (= @config.owner "") (= @config.repo ""))
        (emit GITHUB_CREATE_PR_FAILED { code: null, message: "GitHub owner and repo must be configured. Either set GITHUB_OWNER/GITHUB_REPO or clone a repository first." })
      GITHUB_CREATE_PR_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((pr (json/parse @payload.body GithubPull)))
          (emit GITHUB_PR_CREATED { number: @pr.number, url: @pr.url, html_url: @pr.html_url, title: @pr.title, state: @pr.state, draft: @pr.draft, head: @pr.head, base: @pr.base }))
      GITHUB_CREATE_PR_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_CREATE_PR_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_CREATE_PR_UNREACHABLE -> idle
        (emit GITHUB_CREATE_PR_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_GET_PR_COMMENTS -> idle when (and (!= @config.owner "") (!= @config.repo ""))
        (http GET @config.origin (str/concat "/repos/" @config.owner "/" @config.repo "/pulls/" @payload.prNumber "/comments") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_GET_PR_COMMENTS_REPLIED, failure: GITHUB_GET_PR_COMMENTS_UNREACHABLE } })
      GITHUB_GET_PR_COMMENTS -> idle when (or (= @config.owner "") (= @config.repo ""))
        (emit GITHUB_GET_PR_COMMENTS_FAILED { code: null, message: "GitHub owner and repo must be configured. Either set GITHUB_OWNER/GITHUB_REPO or clone a repository first." })
      GITHUB_GET_PR_COMMENTS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit GITHUB_PR_COMMENTS { comments: (json/parse @payload.body [GithubComment]) })
      GITHUB_GET_PR_COMMENTS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_GET_PR_COMMENTS_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_GET_PR_COMMENTS_UNREACHABLE -> idle
        (emit GITHUB_GET_PR_COMMENTS_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_LIST_ISSUES -> idle when (and (!= @config.owner "") (!= @config.repo ""))
        (http GET @config.origin (str/concat "/repos/" @config.owner "/" @config.repo "/issues?state=" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component (if (not (validate/required @payload.state)) "open" @payload.state)) "%20" "+") "!" "%21") "~" "%7E") "'" "%27") "(" "%28") ")" "%29") "&per_page=" (math/min (if (= @payload.per_page null) 30 @payload.per_page) 100) (if (> (array/len (or @payload.labels [])) 0) (str/concat "&labels=" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component (str/join (or @payload.labels []) ",")) "%20" "+") "!" "%21") "~" "%7E") "'" "%27") "(" "%28") ")" "%29")) "")) {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_LIST_ISSUES_REPLIED, failure: GITHUB_LIST_ISSUES_UNREACHABLE } })
      GITHUB_LIST_ISSUES -> idle when (or (= @config.owner "") (= @config.repo ""))
        (emit GITHUB_LIST_ISSUES_FAILED { code: null, message: "GitHub owner and repo must be configured. Either set GITHUB_OWNER/GITHUB_REPO or clone a repository first." })
      GITHUB_LIST_ISSUES_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit GITHUB_ISSUES { issues: (json/parse @payload.body [GithubIssue]) })
      GITHUB_LIST_ISSUES_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_LIST_ISSUES_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_LIST_ISSUES_UNREACHABLE -> idle
        (emit GITHUB_LIST_ISSUES_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_GET_ISSUE -> idle when (and (!= @config.owner "") (!= @config.repo ""))
        (http GET @config.origin (str/concat "/repos/" @config.owner "/" @config.repo "/issues/" @payload.issueNumber) {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: (str/concat @payload.issueNumber), emit: { success: GITHUB_GET_ISSUE_REPLIED, failure: GITHUB_GET_ISSUE_UNREACHABLE } })
      GITHUB_GET_ISSUE -> idle when (or (= @config.owner "") (= @config.repo ""))
        (emit GITHUB_GET_ISSUE_FAILED { code: null, message: "GitHub owner and repo must be configured. Either set GITHUB_OWNER/GITHUB_REPO or clone a repository first." })
      GITHUB_GET_ISSUE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (http GET @config.origin (str/concat "/repos/" @config.owner "/" @config.repo "/issues/" @payload.key "/comments") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: @payload.body, emit: { success: GITHUB_GET_ISSUE_COMMENTS_REPLIED, failure: GITHUB_GET_ISSUE_COMMENTS_UNREACHABLE } })
      GITHUB_GET_ISSUE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_GET_ISSUE_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_GET_ISSUE_UNREACHABLE -> idle
        (emit GITHUB_GET_ISSUE_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })
      GITHUB_GET_ISSUE_COMMENTS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit GITHUB_ISSUE { issue: (json/parse @payload.key GithubIssue), comments: (json/parse @payload.body [GithubComment]) })
      GITHUB_GET_ISSUE_COMMENTS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_GET_ISSUE_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_GET_ISSUE_COMMENTS_UNREACHABLE -> idle
        (emit GITHUB_GET_ISSUE_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_GET_FILE -> idle
        (http GET @config.origin (str/concat "/repos/" @payload.owner "/" @payload.repo "/contents/" @payload.path) {
          query: { ref: (if (= (or @payload.ref "") "") null @payload.ref) },
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_GET_FILE_REPLIED, failure: GITHUB_GET_FILE_UNREACHABLE } })
      GITHUB_GET_FILE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((file (json/parse @payload.body GithubFileData)))
          (emit GITHUB_FILE { path: @file.path, content: (if (= @file.encoding "base64") (base64/decode (str/replaceAll (str/replaceAll (str/replaceAll @file.content "\n" "") "\r" "") " " "")) @file.content), sha: @file.sha, size: @file.size }))
      GITHUB_GET_FILE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_GET_FILE_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_GET_FILE_UNREACHABLE -> idle
        (emit GITHUB_GET_FILE_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_LIST_COMMITS -> idle
        (let ((query (str/join (array/filter [(if (!= (or @payload.path "") "") (str/concat "path=" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component (or @payload.path "")) "%20" "+") "!" "%21") "~" "%7E") "'" "%27") "(" "%28") ")" "%29")) ""), (if (!= (or @payload.ref "") "") (str/concat "sha=" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component (or @payload.ref "")) "%20" "+") "!" "%21") "~" "%7E") "'" "%27") "(" "%28") ")" "%29")) ""), (if (!= (or @payload.per_page 0) 0) (str/concat "per_page=" @payload.per_page) "")] (fn p (!= @p ""))) "&")))
          (http GET @config.origin (str/concat "/repos/" @payload.owner "/" @payload.repo "/commits" (if (= @query "") "" (str/concat "?" @query))) {
            headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
            auth: { scheme: bearer, credential: @config.token },
            timeoutMs: @config.timeoutMs
          } { emit: { success: GITHUB_LIST_COMMITS_REPLIED, failure: GITHUB_LIST_COMMITS_UNREACHABLE } }))
      GITHUB_LIST_COMMITS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit GITHUB_COMMITS { commits: (array/map (json/parse @payload.body [GithubCommitItem]) (fn c { sha: @c.sha, message: @c.commit.message, author: @c.commit.author.name, date: @c.commit.author.date })) })
      GITHUB_LIST_COMMITS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_LIST_COMMITS_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_LIST_COMMITS_UNREACHABLE -> idle
        (emit GITHUB_LIST_COMMITS_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_CREATE_ISSUE -> idle
        (http POST @config.origin (str/concat "/repos/" @payload.owner "/" @payload.repo "/issues") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion, Content-Type: "text/plain;charset=UTF-8" },
          text: (json/stringify (object/merge { title: @payload.title } (if (not (validate/required @payload.body)) {} { body: @payload.body }) (if (= @payload.labels null) {} { labels: @payload.labels }))),
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_CREATE_ISSUE_REPLIED, failure: GITHUB_CREATE_ISSUE_UNREACHABLE } })
      GITHUB_CREATE_ISSUE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((issue (json/parse @payload.body GithubCreatedIssue)))
          (emit GITHUB_ISSUE_CREATED { number: @issue.number, title: @issue.title, url: @issue.url }))
      GITHUB_CREATE_ISSUE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_CREATE_ISSUE_FAILED {
          code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")),
          message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) ""))))
        })
      GITHUB_CREATE_ISSUE_UNREACHABLE -> idle
        (emit GITHUB_CREATE_ISSUE_FAILED { code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })
      GITHUB_GRAPHQL -> idle
        (http POST @config.origin "/graphql" {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion, Content-Type: "application/json" },
          text: (str/concat "{\"query\":" (json/stringify @payload.query) ",\"variables\":" (if (= (or @payload.variables "") "") "{}" @payload.variables) "}"),
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { emit: { success: GITHUB_GRAPHQL_REPLIED, failure: GITHUB_GRAPHQL_UNREACHABLE } })
      GITHUB_GRAPHQL_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (emit GITHUB_GRAPHQL_ANSWERED { body: @payload.body })
      GITHUB_GRAPHQL_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit GITHUB_GRAPHQL_FAILED { status: @payload.status, code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")), message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) "")))) })
      GITHUB_GRAPHQL_UNREACHABLE -> idle
        (emit GITHUB_GRAPHQL_FAILED { status: 0, code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_LIST_RUNNERS -> idle
        (http GET @config.origin (str/concat "/" @payload.scope "/actions/runners") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: (json/stringify { scope: @payload.scope }), emit: { success: GITHUB_LIST_RUNNERS_REPLIED, failure: GITHUB_LIST_RUNNERS_UNREACHABLE } })
      GITHUB_LIST_RUNNERS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body))
        (let ((at (json/parse @payload.key GithubRunnersKey)))
          (emit GITHUB_RUNNERS { scope: @at.scope, runners: (array/map (object/get (json/parse @payload.body GithubRunnerList) runners []) (fn r { id: @r.id, name: @r.name, status: @r.status, busy: @r.busy })) }))
      GITHUB_LIST_RUNNERS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (not (json/valid @payload.body)))
        (let ((at (json/parse @payload.key GithubRunnersKey)))
          (emit GITHUB_LIST_RUNNERS_FAILED { scope: @at.scope, status: @payload.status, code: "PARSE_ERROR", message: "GitHub answered a runner list body that is not JSON" }))
      GITHUB_LIST_RUNNERS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((at (json/parse @payload.key GithubRunnersKey)))
          (emit GITHUB_LIST_RUNNERS_FAILED { scope: @at.scope, status: @payload.status, code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")), message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (and (json/valid @payload.body) (!= (object/get (json/parse @payload.body GithubError) message "") "")) (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) "")))) }))
      GITHUB_LIST_RUNNERS_UNREACHABLE -> idle
        (let ((at (json/parse @payload.key GithubRunnersKey)))
          (emit GITHUB_LIST_RUNNERS_FAILED { scope: @at.scope, status: 0, code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) }))
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_LIST_RUNS -> idle
        (http GET @config.origin (str/concat "/repos/" @payload.owner "/" @payload.repo "/actions/runs") {
          query: { per_page: (if (== @payload.per_page null) null (str/concat @payload.per_page)) },
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: (json/stringify { owner: @payload.owner, repo: @payload.repo }), emit: { success: GITHUB_LIST_RUNS_REPLIED, failure: GITHUB_LIST_RUNS_UNREACHABLE } })
      GITHUB_LIST_RUNS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((at (json/parse @payload.key GithubRunsKey)))
          (emit GITHUB_RUNS { owner: @at.owner, repo: @at.repo, runs: (array/map (object/get (json/parse @payload.body GithubRunList) workflow_runs []) (fn r { id: @r.id, name: @r.name, status: @r.status, conclusion: @r.conclusion, created_at: @r.created_at, html_url: @r.html_url })) }))
      GITHUB_LIST_RUNS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((at (json/parse @payload.key GithubRunsKey)))
          (emit GITHUB_LIST_RUNS_FAILED { owner: @at.owner, repo: @at.repo, code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")), message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) "")))) }))
      GITHUB_LIST_RUNS_UNREACHABLE -> idle
        (let ((at (json/parse @payload.key GithubRunsKey)))
          (emit GITHUB_LIST_RUNS_FAILED { owner: @at.owner, repo: @at.repo, code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) }))
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_LIST_RUN_JOBS -> idle
        (http GET @config.origin (str/concat "/repos/" @payload.owner "/" @payload.repo "/actions/runs/" @payload.runId "/jobs") {
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: (json/stringify { owner: @payload.owner, repo: @payload.repo, runId: @payload.runId }), emit: { success: GITHUB_LIST_RUN_JOBS_REPLIED, failure: GITHUB_LIST_RUN_JOBS_UNREACHABLE } })
      GITHUB_LIST_RUN_JOBS_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300))
        (let ((at (json/parse @payload.key GithubJobsKey)))
          (emit GITHUB_RUN_JOBS { owner: @at.owner, repo: @at.repo, runId: @at.runId, jobs: (array/map (object/get (json/parse @payload.body GithubJobList) jobs []) (fn j { id: @j.id, name: @j.name, status: @j.status, conclusion: @j.conclusion, html_url: @j.html_url })) }))
      GITHUB_LIST_RUN_JOBS_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((at (json/parse @payload.key GithubJobsKey)))
          (emit GITHUB_LIST_RUN_JOBS_FAILED { owner: @at.owner, repo: @at.repo, runId: @at.runId, code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")), message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (!= (object/get (json/parse @payload.body GithubError) message "") "") (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) "")))) }))
      GITHUB_LIST_RUN_JOBS_UNREACHABLE -> idle
        (let ((at (json/parse @payload.key GithubJobsKey)))
          (emit GITHUB_LIST_RUN_JOBS_FAILED { owner: @at.owner, repo: @at.repo, runId: @at.runId, code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) }))
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

      GITHUB_BILLING_USAGE -> idle
        (http GET @config.origin (str/concat (if (= @payload.kind "org") "/organizations/" "/users/") @payload.account "/settings/billing/usage") {
          query: { year: (str/concat @payload.year), month: (str/concat @payload.month) },
          headers: { Accept: "application/vnd.github+json", X-GitHub-Api-Version: @config.apiVersion },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: (json/stringify { account: @payload.account, kind: @payload.kind, year: @payload.year, month: @payload.month }), emit: { success: GITHUB_BILLING_USAGE_REPLIED, failure: GITHUB_BILLING_USAGE_UNREACHABLE } })
      GITHUB_BILLING_USAGE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body))
        (let ((at (json/parse @payload.key GithubBillingKey)))
          (emit GITHUB_BILLING_USAGE_ANSWERED { account: @at.account, kind: @at.kind, year: @at.year, month: @at.month, items: (object/get (json/parse @payload.body GithubUsageReport) "usageItems" []) }))
      GITHUB_BILLING_USAGE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (not (json/valid @payload.body)))
        (let ((at (json/parse @payload.key GithubBillingKey)))
          (emit GITHUB_BILLING_USAGE_FAILED { account: @at.account, kind: @at.kind, status: @payload.status, code: "PARSE_ERROR", message: "GitHub answered a billing usage body that is not JSON" }))
      GITHUB_BILLING_USAGE_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (let ((at (json/parse @payload.key GithubBillingKey)))
          (emit GITHUB_BILLING_USAGE_FAILED { account: @at.account, kind: @at.kind, status: @payload.status, code: (if (= @payload.status 429) "RATE_LIMIT_ERROR" (if (or (= @payload.status 401) (= @payload.status 403)) "AUTH_ERROR" "SERVICE_ERROR")), message: (if (= @payload.status 429) "GitHub API rate limit exceeded" (str/concat (if (or (= @payload.status 401) (= @payload.status 403)) "GitHub API authentication failed: " "GitHub API request failed: ") (if (and (json/valid @payload.body) (!= (object/get (json/parse @payload.body GithubError) message "") "")) (object/get (json/parse @payload.body GithubError) message "") (object/get @config.statusText (str/concat @payload.status) "")))) }))
      GITHUB_BILLING_USAGE_UNREACHABLE -> idle
        (let ((at (json/parse @payload.key GithubBillingKey)))
          (emit GITHUB_BILLING_USAGE_FAILED { account: @at.account, kind: @at.kind, status: 0, code: "NETWORK_ERROR", message: (str/concat "GitHub API request failed: " @payload.error) }))
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "GitHub unavailable: " @payload.error) })

    }

    emits {
      GITHUB_BILLING_USAGE_ANSWERED -> external {
        account : string!
        kind : string!
        year : number!
        month : number!
        items : [GithubUsageItem]!
      }
        @description "An account's billing usage for the month: GitHub's usage items (product, SKU, quantity and unit, gross, discount and net amounts, repository)."
        @synonyms "billing usage, github spend, actions cost"
        @tier "primary"
      GITHUB_BILLING_USAGE_FAILED -> external {
        account : string!
        kind : string!
        status : number!
        code : string
        message : string!
      }
        @description "The account's billing usage could not be read: the HTTP status (0 when unreachable), GitHub's code (PARSE_ERROR for a body that is not JSON) and message."
        @synonyms "billing unavailable"
        @tier "primary"
      GITHUB_BILLING_USAGE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the billing usage call's HTTP reply; key carries the account and month."
        @tier "secondary"
      GITHUB_BILLING_USAGE_UNREACHABLE {
        error : string!
        kind : string!
        key : string!
      }
        @description "Internal: the billing usage call never produced a reply."
        @tier "secondary"
      GITHUB_GRAPHQL_ANSWERED -> external {
        body : string!
      }
        @description "The GraphQL reply body as JSON text, data and errors both, for the caller to read with its own types."
        @synonyms "graphql result, query answer"
        @tier "primary"
      GITHUB_GRAPHQL_FAILED -> external {
        status : number!
        code : string
        message : string!
      }
        @description "The GraphQL query failed: the HTTP status (0 when GitHub was unreachable), GitHub's code (RATE_LIMIT_ERROR, AUTH_ERROR, SERVICE_ERROR, NETWORK_ERROR) and message."
        @synonyms "graphql error, query failed"
        @tier "primary"
      GITHUB_GRAPHQL_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the GraphQL call's HTTP reply."
        @tier "secondary"
      GITHUB_GRAPHQL_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the GraphQL call never produced a reply."
        @tier "secondary"
      GITHUB_RUNNERS -> external {
        scope : string!
        runners : [GithubRunner]!
      }
        @description "The self-hosted runners registered at an organization or repository scope: id, name, status (online or offline) and whether a job is running on it."
        @synonyms "self-hosted runners, ci runners, runner fleet"
        @tier "primary"
      GITHUB_LIST_RUNNERS_FAILED -> external {
        scope : string!
        status : number!
        code : string
        message : string!
      }
        @description "Listing the scope's self-hosted runners failed: the HTTP status (0 when unreachable), GitHub's code and message."
