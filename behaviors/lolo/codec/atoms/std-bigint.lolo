    emits {
      FROM_BYTES_ANSWERED -> external {
        value : [number]!
      }
        @description "The limbs of the big-endian bytes, normalized."
        @tier "primary"
      TO_BYTES_ANSWERED -> external {
        value : bytes!
      }
        @description "The standard padded base64 of the number, big-endian, minimal or size bytes."
        @tier "primary"
      ADD_ANSWERED -> external {
        value : [number]!
      }
        @description "a + b."
        @tier "primary"
      SUB_ANSWERED -> external {
        value : [number]!
      }
        @description "a - b."
        @tier "primary"
      MUL_ANSWERED -> external {
        value : [number]!
      }
        @description "a * b."
        @tier "primary"
      COMPARE_ANSWERED -> external {
        value : number!
      }
        @description "-1, 0 or 1 as a is below, equal to or above b."
        @tier "primary"
      DIVMOD_ANSWERED -> external {
        quotient : [number]!
        remainder : [number]!
      }
        @description "floor(a / b) and a mod b."
        @tier "primary"
      MOD_ANSWERED -> external {
        value : [number]!
      }
        @description "a mod b."
        @tier "primary"
      MODPOW_ANSWERED -> external {
        value : [number]!
      }
        @description "a ^ e mod m."
        @tier "primary"
      MODINV_ANSWERED -> external {
        value : [number]!
      }
        @description "The inverse of a modulo m."
        @tier "primary"
      BIGINT_REFUSED -> external {
        operation : string!
        reason : string!
      }
        @description "The request was refused: invalid (non-canonical base64, a limb outside 0..2^24-1, a non-normalized number, a bad size), negative (a - b below zero), zero-divisor, zero-modulus, modulus (m not above 1), size or no-inverse."
        @tier "primary"
      MUL_RUN -> internal { }
        @description "Internal: Run the multiply engine over xa and xb into res."
        @tier "internal"
      MUL_DONE -> internal { }
        @description "Internal: The multiply engine finished; ret names the caller."
        @tier "internal"
      DIV_RUN -> internal { }
        @description "Internal: Run the division engine over xa and xb."
        @tier "internal"
      DIV_DONE -> internal { }
        @description "Internal: The division engine finished; ret names the caller."
        @tier "internal"
      INV_FINISH -> internal { }
        @description "Internal: The inverse is computed; answer it or refuse no-inverse."
        @tier "internal"
    }

    listens {
      FROM_BYTES -> input {
        data : string!
      }
        @description "Decode big-endian base64 bytes into limbs."
      TO_BYTES -> input {
        value : [number]!
        size : number
      }
        @description "Encode limbs as big-endian base64, left-padded to size bytes when given."
      ADD -> input {
        a : [number]!
        b : [number]!
      }
        @description "Add two numbers."
      SUB -> input {
        a : [number]!
        b : [number]!
      }
        @description "Subtract b from a (a >= b)."
      MUL -> input {
        a : [number]!
        b : [number]!
      }
        @description "Multiply two numbers."
      COMPARE -> input {
        a : [number]!
        b : [number]!
      }
        @description "Compare two numbers."
      DIVMOD -> input {
        a : [number]!
        b : [number]!
      }
        @description "Quotient and remainder."
      MOD -> input {
        a : [number]!
        b : [number]!
      }
        @description "Remainder."
      MODPOW -> input {
        a : [number]!
        e : [number]!
        m : [number]!
      }
        @description "Modular exponentiation."
      MODINV -> input {
        a : [number]!
        m : [number]!
      }
        @description "Modular inverse."
    }
  }

  page boot as BigIntOrbitalStart -> BigIntCodec
}
