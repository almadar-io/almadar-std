app std-bigint [
  version: "1.0.0",
  description: "std-bigint — exact non-negative integers of any size as little-endian limb arrays in base 2^24, over array/*, math/* and bytes/*. Base 2^24 because a limb product is below 2^48 and the schoolbook columns split into low and high 24-bit halves whose sums stay below 2^53, so every f64 step is exact; 24 bits is also three whole bytes, so bytes map to limbs with no bit shifting. A number is normalized: every limb a whole number in 0..16777215, the last (highest) limb nonzero, zero is the empty array. FROM_BYTES { data } decodes big-endian padded base64. TO_BYTES { value, size? } encodes big-endian base64, minimal (one 0 byte for zero) or left-padded to size bytes. COMPARE { a, b } answers -1, 0 or 1. ADD, SUB (a >= b), MUL { a, b } answer value. DIVMOD { a, b } answers quotient and remainder by schoolbook long division: each quotient limb is a float estimate from the top three dividend limbs over the top two divisor limbs plus one (never above the true digit, short by at most 3), then corrective subtractions of the divisor until the remainder is below it. MOD { a, b } answers the remainder. MODPOW { a, e, m } answers a^e mod m by left-to-right square-and-multiply from the top set bit of e. MODINV { a, m } answers the inverse of a mod m by the extended Euclid algorithm over unsigned values, refusing no-inverse when gcd(a, m) is not 1. BIGINT_REFUSED { operation, reason } with reason invalid, negative, zero-divisor, zero-modulus, modulus (m not above 1), size or no-inverse. Golden vectors (python3): [5] ^ [117] mod [1000003] is pow(5,117,1000003) = 136318; 3^-1 mod 7 is 5; 2^255-19 is the modulus of the 250-bit inverse probe; every 2048-bit ADD, SUB, MUL, DIVMOD, MOD, MODPOW and MODINV probe matches python's int arithmetic. MUL, DIVMOD and MOD run on engine events (MUL_RUN, DIV_RUN) reached through the ret register; MODPOW and MODINV are each one bounded array/reduce inside a single event (bits of e from the top set bit; at most ceil(1.4405 * bits) + 2 Euclid steps), so they never cascade."
]
uses Spec from "almadar-std/bigint"

orbital BigIntOrbital {
  entity BigIntRun [runtime] {
    id : string!
    xa : [number] @description "left operand of the engines." = []
    xb : [number] @description "right operand of the engines." = []
    res : [number] @description "product of the multiply engine." = []
    dq : [number] @description "quotient of the division engine." = []
    dr : [number] @description "remainder of the division engine." = []
    inv : [number] @description "the inverse a MODINV computed, empty when none exists." = []
    ret : string @description "Which caller the engine that just finished returns to." = ""
  }

  trait BigIntCodec -> BigIntRun [client] {
    initial: idle

    config {
      base : number = 16777216
        @label "Limb base"
        @description "2^24: a limb product is below 2^48 and the low/high column sums stay below 2^53, and a limb is three whole bytes."
        @synonyms "radix, limb size"
        @tier "domain"
      base64Pattern : string = "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
        @label "Canonical padded base64"
        @description "The pattern a bytes value must match: whole groups of four, correct padding, no stray bits."
        @synonyms "base64 rule, padded base64"
        @tier "domain"
    }

    state idle {
      FROM_BYTES -> idle when (not (validate/pattern @payload.data @config.base64Pattern))
        (emit BIGINT_REFUSED { operation: "bigint/from-bytes" reason: "invalid" })

      FROM_BYTES -> idle when (validate/pattern @payload.data @config.base64Pattern)
        (emit FROM_BYTES_ANSWERED
          { value: (let ((n (bytes/length @payload.data)))
                     (let ((t (array/map
                               (array/range 0 (math/ceil (/ @n 3)))
                               (fn k
                                 (array/reduce
                                   (array/range 0 3)
                                   0
                                   (fn s t
                                     (let ((p (- (- @n 1) (+ (* @k 3) @t))))
                                       (if
                                         (>= @p 0)
                                         (+
                                           @s
                                           (*
                                             (bytes/read-uint @payload.data @p 1 "be")
                                             (math/pow 256 @t)))
                                         @s))))))))
                       (array/slice
                         @t
                         0
                         (+
                           1
                           (array/reduce
                             (array/range 0 (array/len @t))
                             -1
                             (fn m i (if (!= (array/nth @t @i) 0) @i @m))))))) })

      TO_BYTES -> idle when (not
          (and
            (and
              (array/every
                @payload.value
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.value) 0)
                (!= (array/nth @payload.value (- (array/len @payload.value) 1)) 0)))
            (or
              (== @payload.size null)
              (and (== @payload.size (math/floor @payload.size)) (>= @payload.size 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/to-bytes" reason: "invalid" })

      TO_BYTES -> idle when (and
          (and
            (and
              (array/every
                @payload.value
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.value) 0)
                (!= (array/nth @payload.value (- (array/len @payload.value) 1)) 0)))
            (or
              (== @payload.size null)
              (and (== @payload.size (math/floor @payload.size)) (>= @payload.size 0))))
          (and
            (!= @payload.size null)
            (<
              @payload.size
              (if
                (== (array/len @payload.value) 0)
                1
                (let ((top (array/nth @payload.value (- (array/len @payload.value) 1))))
                  (+
                    (* 3 (- (array/len @payload.value) 1))
                    (if (< @top 256) 1 (if (< @top 65536) 2 3))))))))
        (emit BIGINT_REFUSED { operation: "bigint/to-bytes" reason: "size" })

      TO_BYTES -> idle when (and
          (and
            (and
              (array/every
                @payload.value
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.value) 0)
                (!= (array/nth @payload.value (- (array/len @payload.value) 1)) 0)))
            (or
              (== @payload.size null)
              (and (== @payload.size (math/floor @payload.size)) (>= @payload.size 0))))
          (not
            (and
              (!= @payload.size null)
              (<
                @payload.size
                (if
                  (== (array/len @payload.value) 0)
                  1
                  (let ((top (array/nth @payload.value (- (array/len @payload.value) 1))))
                    (+
                      (* 3 (- (array/len @payload.value) 1))
                      (if (< @top 256) 1 (if (< @top 65536) 2 3)))))))))
        (emit TO_BYTES_ANSWERED
          { value: (let ((n (if
                             (== @payload.size null)
                             (if
                               (== (array/len @payload.value) 0)
                               1
                               (let ((top (array/nth @payload.value (- (array/len @payload.value) 1))))
                                 (+
                                   (* 3 (- (array/len @payload.value) 1))
                                   (if (< @top 256) 1 (if (< @top 65536) 2 3)))))
                             @payload.size)))
                     (bytes/concat
                       (array/map
                         (array/range 0 @n)
                         (fn k
                           (let ((p (- (- @n 1) @k)))
                             (bytes/write-uint
                               (math/mod
                                 (math/floor
                                   (or (/
                                     (if
                                       (and
                                         (>= (math/floor (/ @p 3)) 0)
                                         (< (math/floor (/ @p 3)) (array/len @payload.value)))
                                       (array/nth @payload.value (math/floor (/ @p 3)))
                                       0)
                                     (math/pow 256 (math/mod @p 3))) 0))
                                 256)
                               1
                               "be")))))) })

      COMPARE -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/compare" reason: "invalid" })

      COMPARE -> idle when (and
          (and
            (array/every
              @payload.a
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.a) 0)
              (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
          (and
            (array/every
              @payload.b
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.b) 0)
              (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
        (emit COMPARE_ANSWERED
          { value: (if
                     (!= (array/len @payload.a) (array/len @payload.b))
                     (math/sign (- (array/len @payload.a) (array/len @payload.b)))
                     (array/reduce
                       (array/range 0 (array/len @payload.a))
                       0
                       (fn r t
                         (if
                           (!= @r 0)
                           @r
                           (let ((i (- (- (array/len @payload.a) 1) @t)))
                             (math/sign (- (array/nth @payload.a @i) (array/nth @payload.b @i)))))))) })

      ADD -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/add" reason: "invalid" })

      ADD -> idle when (and
          (and
            (array/every
              @payload.a
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.a) 0)
              (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
          (and
            (array/every
              @payload.b
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.b) 0)
              (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
        (emit ADD_ANSWERED
          { value: (let ((t (object/get
                             (array/reduce
                               (array/range
                                 0
                                 (+ (math/max (array/len @payload.a) (array/len @payload.b)) 1))
                               { out: (array/range 0 0) c: 0 }
                               (fn acc i
                                 (let ((s (+
                                           (if
                                             (and (>= @i 0) (< @i (array/len @payload.a)))
                                             (array/nth @payload.a @i)
                                             0)
                                           (if
                                             (and (>= @i 0) (< @i (array/len @payload.b)))
                                             (array/nth @payload.b @i)
                                             0)
                                           @acc.c)))
                                   { out: (array/append @acc.out (math/mod @s @config.base)),
                                     c: (math/floor (/ @s @config.base)) })))
                             "out")))
                     (array/slice
                       @t
                       0
                       (+
                         1
                         (array/reduce
                           (array/range 0 (array/len @t))
                           -1
                           (fn m i (if (!= (array/nth @t @i) 0) @i @m)))))) })

      SUB -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/sub" reason: "invalid" })

      SUB -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (<
            (if
              (!= (array/len @payload.a) (array/len @payload.b))
              (math/sign (- (array/len @payload.a) (array/len @payload.b)))
              (array/reduce
                (array/range 0 (array/len @payload.a))
                0
                (fn r t
                  (if
                    (!= @r 0)
                    @r
                    (let ((i (- (- (array/len @payload.a) 1) @t)))
                      (math/sign (- (array/nth @payload.a @i) (array/nth @payload.b @i))))))))
            0))
        (emit BIGINT_REFUSED { operation: "bigint/sub" reason: "negative" })

      SUB -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (not
            (<
              (if
                (!= (array/len @payload.a) (array/len @payload.b))
                (math/sign (- (array/len @payload.a) (array/len @payload.b)))
                (array/reduce
                  (array/range 0 (array/len @payload.a))
                  0
                  (fn r t
                    (if
                      (!= @r 0)
                      @r
                      (let ((i (- (- (array/len @payload.a) 1) @t)))
                        (math/sign (- (array/nth @payload.a @i) (array/nth @payload.b @i))))))))
              0)))
        (emit SUB_ANSWERED
          { value: (let ((t (object/get
                             (array/reduce
                               (array/range 0 (array/len @payload.a))
                               { out: (array/range 0 0) c: 0 }
                               (fn acc i
                                 (let ((s (-
                                           (-
                                             (if
                                               (and (>= @i 0) (< @i (array/len @payload.a)))
                                               (array/nth @payload.a @i)
                                               0)
                                             (if
                                               (and (>= @i 0) (< @i (array/len @payload.b)))
                                               (array/nth @payload.b @i)
                                               0))
                                           @acc.c)))
                                   { out: (array/append
                                            @acc.out
                                            (if (< @s 0) (+ @s @config.base) @s)),
                                     c: (if (< @s 0) 1 0) })))
                             "out")))
                     (array/slice
                       @t
                       0
                       (+
                         1
                         (array/reduce
                           (array/range 0 (array/len @t))
                           -1
                           (fn m i (if (!= (array/nth @t @i) 0) @i @m)))))) })

      MUL -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/mul" reason: "invalid" })

      MUL -> idle when (and
          (and
            (array/every
              @payload.a
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.a) 0)
              (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
          (and
            (array/every
              @payload.b
              (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
            (or
              (== (array/len @payload.b) 0)
              (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
        (set @entity.xa @payload.a)
        (set @entity.xb @payload.b)
        (set @entity.ret "mul")
        (emit MUL_RUN {  })

      DIVMOD -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/divmod" reason: "invalid" })

      DIVMOD -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (== (array/len @payload.b) 0))
        (emit BIGINT_REFUSED { operation: "bigint/divmod" reason: "zero-divisor" })

      DIVMOD -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (not (== (array/len @payload.b) 0)))
        (set @entity.xa @payload.a)
        (set @entity.xb @payload.b)
        (set @entity.ret "divmod")
        (emit DIV_RUN {  })

      MOD -> idle when (not
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0)))))
        (emit BIGINT_REFUSED { operation: "bigint/mod" reason: "invalid" })

      MOD -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (== (array/len @payload.b) 0))
        (emit BIGINT_REFUSED { operation: "bigint/mod" reason: "zero-divisor" })

      MOD -> idle when (and
          (and
            (and
              (array/every
                @payload.a
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.a) 0)
                (!= (array/nth @payload.a (- (array/len @payload.a) 1)) 0)))
            (and
              (array/every
                @payload.b
                (fn l (and (>= @l 0) (< @l @config.base) (== @l (math/floor @l)))))
              (or
                (== (array/len @payload.b) 0)
                (!= (array/nth @payload.b (- (array/len @payload.b) 1)) 0))))
          (not (== (array/len @payload.b) 0)))
        (set @entity.xa @payload.a)
        (set @entity.xb @payload.b)
        (set @entity.ret "mod")
        (emit DIV_RUN {  })

      MUL_RUN -> idle
        (set @entity.res
          (let ((ma0 @entity.xa)
                (mb1 @entity.xb))
            (let ((na2 (array/len @ma0))
                  (nb3 (array/len @mb1)))
              (if
                (or (== @na2 0) (== @nb3 0))
                (array/range 0 0)
                (let ((cols4 (array/map
                              (array/range 0 (+ @na2 @nb3))
                              (fn k
                                (array/reduce
                                  (array/range 0 @na2)
                                  { lo: 0 hi: 0 }
                                  (fn s i
                                    (let ((j (- @k @i)))
                                      (if
                                        (and (>= @j 0) (< @j @nb3))
                                        (let ((p (* (array/nth @ma0 @i) (array/nth @mb1 @j))))
                                          { lo: (+ @s.lo (math/mod @p @config.base)),
                                            hi: (+ @s.hi (math/floor (/ @p @config.base))) })
                                        @s))))))))
                  (let ((tot5 (array/map
                               (array/range 0 (array/len @cols4))
                               (fn k
                                 (+
                                   (object/get (array/nth @cols4 @k) "lo")
                                   (if (> @k 0) (object/get (array/nth @cols4 (- @k 1)) "hi") 0))))))
                    (let ((t (object/get
                              (array/reduce
                                (array/range 0 (array/len @tot5))
                                { out: (array/range 0 0) c: 0 }
                                (fn acc i
                                  (let ((s (+ (array/nth @tot5 @i) @acc.c)))
                                    { out: (array/append @acc.out (math/mod @s @config.base)),
                                      c: (math/floor (/ @s @config.base)) })))
                              "out")))
                      (array/slice
                        @t
                        0
                        (+
                          1
                          (array/reduce
                            (array/range 0 (array/len @t))
                            -1
