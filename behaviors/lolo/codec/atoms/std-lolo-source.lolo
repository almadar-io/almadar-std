          (let ((entLines (let ((tpl (object/get @config.modelImports "entity" ""))) (if (or (= @tpl "") (= (array/len @ents) 0)) [] (if @config.modelImportEach (array/map @ents (fn nm (let ((v244 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f245p (str/split @tpl "{{"))) (str/concat (default (array/first @f245p) "") (str/join (array/map (array/drop @f245p 1) (fn f245q (let ((f245r (str/split @f245q "}}"))) (if (< (array/len @f245r) 2) (str/concat "{{" @f245q) (str/concat (object/get @v244 (default (array/first @f245r) "") (str/concat "{{" (default (array/first @f245r) "") "}}")) (str/join (array/drop @f245r 1) "}}")))))) "")))))) [(let ((v246 : SrcVars (object/fromEntries [["names" (str/join @ents @config.modelImportSep)]]))) (let ((f247p (str/split @tpl "{{"))) (str/concat (default (array/first @f247p) "") (str/join (array/map (array/drop @f247p 1) (fn f247q (let ((f247r (str/split @f247q "}}"))) (if (< (array/len @f247r) 2) (str/concat "{{" @f247q) (str/concat (object/get @v246 (default (array/first @f247r) "") (str/concat "{{" (default (array/first @f247r) "") "}}")) (str/join (array/drop @f247r 1) "}}")))))) ""))))]))))
                (plLines (let ((tpl (object/get @config.modelImports "payload" ""))) (if (or (= @tpl "") (= (array/len @pls) 0)) [] (if @config.modelImportEach (array/map @pls (fn nm (let ((v248 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f249p (str/split @tpl "{{"))) (str/concat (default (array/first @f249p) "") (str/join (array/map (array/drop @f249p 1) (fn f249q (let ((f249r (str/split @f249q "}}"))) (if (< (array/len @f249r) 2) (str/concat "{{" @f249q) (str/concat (object/get @v248 (default (array/first @f249r) "") (str/concat "{{" (default (array/first @f249r) "") "}}")) (str/join (array/drop @f249r 1) "}}")))))) "")))))) [(let ((v250 : SrcVars (object/fromEntries [["names" (str/join @pls @config.modelImportSep)]]))) (let ((f251p (str/split @tpl "{{"))) (str/concat (default (array/first @f251p) "") (str/join (array/map (array/drop @f251p 1) (fn f251q (let ((f251r (str/split @f251q "}}"))) (if (< (array/len @f251r) 2) (str/concat "{{" @f251q) (str/concat (object/get @v250 (default (array/first @f251r) "") (str/concat "{{" (default (array/first @f251r) "") "}}")) (str/join (array/drop @f251r 1) "}}")))))) ""))))])))))
            (let ((sections (array/filter (array/concat
                                [@config.fileHeader (str/join (array/concat @importLines (if @config.renderModels [] (array/concat @entLines @plLines))) "\n")]
                                [(str/join @entity.helperTexts @config.helperGap)]
                                (array/map @entity.blocks (fn b (str/join @b "\n"))))
                              (fn s (!= @s "")))))
              (str/concat (str/join @sections @config.sectionGap) "\n")))))
        (emit SOURCE_RENDERED { text: @entity.text, warnings: @entity.warnings })
    }

    emits {
      SOURCE_RENDERED -> external { text : string!  warnings : [string]! }
        @description "The .lolo source rendered as native code, with one warning per operator that had no template and per effect that goes through the ports object."
      SOURCE_RENDER_FAILED -> external { error : string! }
        @description "The .lolo source could not be rendered, with the reason."
      SRC_PREPARE { }
        @description "Internal: collect the containers, traits and expression jobs."
        @tier "internal"
      SRC_RENDER { }
        @description "Internal: render the type and expression trees."
        @tier "internal"
      SRC_ASSEMBLE { }
        @description "Internal: assemble the class blocks from the rendered trees."
        @tier "internal"
      SRC_FINISH { }
        @description "Internal: write the imports and the text."
        @tier "internal"
    }

    listens {
      LOLO_TO_SOURCE -> input { source : string!  path : string? }
        @description "Render this .lolo program text as native code. With the absolute path of the file the reader also answers the checker's type of every node, which typed targets need."
        @synonyms "lolo to source, show as code"
      SRC_STD { data : bytes! }
        @description "Internal: the installed @almadar/std manifest."
        @tier "internal"
      SRC_OPERATORS { data : bytes! }
        @description "Internal: the installed operator table."
        @tier "internal"
      SRC_TABLE_FAILED { error : string }
        @description "Internal: a table file could not be read."
        @tier "internal"
      LOLO_READ { result : SrcProgram! }
        @description "Internal: the program read by program/read."
        @tier "internal"
      LOLO_INSPECTED { result : SrcInspect! }
        @description "Internal: the program and its types read by program/read with inspect."
        @tier "internal"
      LOLO_READ_FAILED { error : string }
        @description "Internal: program/read could not read the source."
        @tier "internal"
    }
  }

  page boot as LoloSourceStart -> LoloSource
}
