      mapOpen : string = "{"
        @label "Map open"
        @description "Start of a map literal"
        @tier "domain"
      mapEmpty : string = ""
        @label "Empty map"
        @description "The map literal with no pair (a config with no knob included); empty means mapOpen followed by mapClose"
        @tier "domain"
      mapClose : string = "}"
        @label "Map close"
        @description "End of a map literal"
