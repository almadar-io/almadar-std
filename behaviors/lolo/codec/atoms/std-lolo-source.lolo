          (let ((entLines (let ((tpl (object/get @config.modelImports "entity" ""))) (if (or (= @tpl "") (= (array/len @ents) 0)) [] (if @config.modelImportEach (array/map @ents (fn nm (let ((v591 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f592p (str/split @tpl "{{"))) (str/concat (default (array/first @f592p) "") (str/join (array/map (array/drop @f592p 1) (fn f592q (let ((f592r (str/split @f592q "}}"))) (if (< (array/len @f592r) 2) (str/concat "{{" @f592q) (str/concat (object/get @v591 (default (array/first @f592r) "") (str/concat "{{" (default (array/first @f592r) "") "}}")) (str/join (array/drop @f592r 1) "}}")))))) "")))))) [(let ((v593 : SrcVars (object/fromEntries [["names" (str/join @ents @config.modelImportSep)]]))) (let ((f594p (str/split @tpl "{{"))) (str/concat (default (array/first @f594p) "") (str/join (array/map (array/drop @f594p 1) (fn f594q (let ((f594r (str/split @f594q "}}"))) (if (< (array/len @f594r) 2) (str/concat "{{" @f594q) (str/concat (object/get @v593 (default (array/first @f594r) "") (str/concat "{{" (default (array/first @f594r) "") "}}")) (str/join (array/drop @f594r 1) "}}")))))) ""))))]))))
                (plLines (let ((tpl (object/get @config.modelImports "payload" ""))) (if (or (= @tpl "") (= (array/len @pls) 0)) [] (if @config.modelImportEach (array/map @pls (fn nm (let ((v595 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f596p (str/split @tpl "{{"))) (str/concat (default (array/first @f596p) "") (str/join (array/map (array/drop @f596p 1) (fn f596q (let ((f596r (str/split @f596q "}}"))) (if (< (array/len @f596r) 2) (str/concat "{{" @f596q) (str/concat (object/get @v595 (default (array/first @f596r) "") (str/concat "{{" (default (array/first @f596r) "") "}}")) (str/join (array/drop @f596r 1) "}}")))))) "")))))) [(let ((v597 : SrcVars (object/fromEntries [["names" (str/join @pls @config.modelImportSep)]]))) (let ((f598p (str/split @tpl "{{"))) (str/concat (default (array/first @f598p) "") (str/join (array/map (array/drop @f598p 1) (fn f598q (let ((f598r (str/split @f598q "}}"))) (if (< (array/len @f598r) 2) (str/concat "{{" @f598q) (str/concat (object/get @v597 (default (array/first @f598r) "") (str/concat "{{" (default (array/first @f598r) "") "}}")) (str/join (array/drop @f598r 1) "}}")))))) ""))))])))))
            (let ((sections (array/filter (array/concat
                                [@config.fileHeader (str/join (array/concat @importLines (if @config.renderModels [] (array/concat @entLines @plLines))) "\n")]
                                [(str/join @entity.helperTexts @config.helperGap)]
                                (array/map @entity.blocks (fn b (str/join @b "\n"))))
                              (fn s (!= @s "")))))
              (str/concat (str/join @sections @config.sectionGap) "\n")))))
        (emit SOURCE_RENDERED { text: @entity.text, warnings: @entity.warnings })
    }

    emits {
      SOURCE_RENDERED -> external { text : string!  warnings : [string]! }
        @description "The .lolo source rendered as native code, with one warning per operator that had no template and per effect that goes through the ports object."
      SOURCE_RENDER_FAILED -> external { error : string! }
        @description "The .lolo source could not be rendered, with the reason."
      SRC_PREPARE { }
        @description "Internal: collect the containers, traits and expression jobs."
        @tier "internal"
      SRC_RENDER { }
        @description "Internal: render the type and expression trees."
        @tier "internal"
      SRC_ASSEMBLE { }
        @description "Internal: assemble the class blocks from the rendered trees."
        @tier "internal"
      SRC_FINISH { }
        @description "Internal: write the imports and the text."
        @tier "internal"
    }

    listens {
      LOLO_TO_SOURCE -> input { source : string!  path : string? }
        @description "Render this .lolo program text as native code. With the absolute path of the file the reader also answers the checker's type of every node, which typed targets need."
        @synonyms "lolo to source, show as code"
      SRC_STD { data : bytes! }
        @description "Internal: the installed @almadar/std manifest."
        @tier "internal"
      SRC_OPERATORS { data : bytes! }
        @description "Internal: the installed operator table."
        @tier "internal"
      SRC_TABLE_FAILED { error : string }
        @description "Internal: a table file could not be read."
        @tier "internal"
      LOLO_READ { result : SrcProgram! }
        @description "Internal: the program read by program/read."
        @tier "internal"
      LOLO_INSPECTED { result : SrcInspect! }
        @description "Internal: the program and its types read by program/read with inspect."
        @tier "internal"
      LOLO_READ_FAILED { error : string }
        @description "Internal: program/read could not read the source."
        @tier "internal"
    }
  }

  page boot as LoloSourceStart -> LoloSource
}
