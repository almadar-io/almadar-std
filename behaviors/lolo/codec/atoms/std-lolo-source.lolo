        @tier "domain"
      localCase : string = "keep"
        @label "Local case"
        @description "keep, lower, upper, camel or pascal (each word lowercased first), or split-camel or split-pascal (the shell models' identifier spelling: split on _ and -, each word's tail kept), or lower-camel (split-pascal with its first letter lowered)"
        @tier "domain"
      methodCase : string = "keep"
        @label "Method case"
        @description "How the event key reads inside methodName"
        @tier "domain"
      methodName : string = "on{{event}}"
        @label "Method name"
        @description "The method of an event: {{event}}"
        @tier "domain"
      configType : string = ""
        @label "Config type name"
        @description "Name of the shell-generated config type of a trait that declares config ({{trait}}); empty keeps config as the {{config}} map literal. When set, the type is imported with the payload types, a constructor line naming {{configType}} or {{withConfig}} (filled empty) is written only for a trait that declares config, and one naming {{noConfig}} (filled empty) only for a trait that does not"
        @tier "domain"
      modelImports : Map string string = {  }
        @label "Model imports"
        @description "Import of the shell's generated models: entity and payload templates with {{names}} (joined) or {{name}} (one per line)"
        @tier "domain"
      entityNames : Map string string = {  }
        @label "Entity names"
        @description "Generated name per .lolo entity or type name, written wherever the name appears: the constructor {{entity}}, the model imports, and the model classes, aliases and projected references when renderModels is true; a name missing here is written as it is"
        @tier "domain"
      modelImportEach : boolean = false
        @label "One import per name"
        @description "Write one model import line per name"
        @tier "domain"
      modelImportSep : string = ", "
        @label "Model import separator"
        @description "Between names in one import line"
        @tier "domain"
      fileHeader : string = ""
        @label "File header"
        @description "Text written first in the file, before the imports and followed by sectionGap; empty writes nothing (a package declaration)"
        @tier "domain"
      sectionGap : string = "\n\n\n"
        @label "Section gap"
        @description "Between the imports, the helpers and each class"
        @tier "domain"
      classOpen : string = "class {{class}} {"
        @label "Class open"
        @description "Head of a trait class"
        @tier "domain"
      classClose : string = "}"
        @label "Class close"
        @description "Foot of a trait class; empty when none"
        @tier "domain"
      classEmpty : string = ""
        @label "Class empty"
        @description "Body of a trait class that has no state machine (pass); empty when none is needed"
        @tier "domain"
      constructor : [string] = []
        @label "Constructor"
        @description "Lines of the constructor and fields: {{i}} indent, {{class}}, {{entity}}, {{initial}} quoted, {{config}} the config map literal, {{configType}} the trait's config type (configType); a line starting {{withStore}} is written only for a trait with a routed effect and one starting {{noStore}} only for one without; {{withUser}} and {{noUser}} the same for a trait that reads @user"
        @tier "domain"
      emitMethod : [string] = []
        @label "Emit method"
        @description "Lines of the method that records an emit"
        @tier "domain"
      methodOpen : string = "{{i}}fun {{method}}(payload: {{payloadType}}) {"
        @label "Method open"
        @description "Head of an event method that has a payload: {{i}}, {{method}}, {{payloadType}}"
        @tier "domain"
      methodOpenPlain : string = "{{i}}fun {{method}}() {"
        @label "Method open (no payload)"
        @description "Head of an event method with no payload"
        @tier "domain"
      methodClose : string = "{{i}}}"
        @label "Method close"
        @description "Foot of an event method; empty when none"
        @tier "domain"
      branchFirst : string = "{{i}}{{i}}if ({{test}}) {"
        @label "First branch"
        @description "Head of the first transition of an event"
        @tier "domain"
      branchNext : string = "{{i}}{{i}}} else if ({{test}}) {"
        @label "Next branch"
        @description "Head of the next transitions"
        @tier "domain"
      branchClose : string = "{{i}}{{i}}}"
        @label "Branch close"
        @description "Foot of the branches; empty when none"
        @tier "domain"
      branchTest : string = "{{stateTest}} && {{guard}}"
        @label "Branch test"
        @description "State test and guard"
        @tier "domain"
      branchTestPlain : string = "{{stateTest}}"
        @label "Branch test (no guard)"
        @description "State test alone"
        @tier "domain"
      stateTest : string = "state == {{state}}"
        @label "State test"
        @description "From-state test, {{state}} quoted"
        @tier "domain"
      stateAssign : string = "state = {{state}}"
        @label "State assignment"
        @description "New-state statement, {{state}} quoted"
        @tier "domain"
      bodyPrefix : string = "{{i}}{{i}}{{i}}"
        @label "Body prefix"
        @description "Indentation of the statements of a branch"
        @tier "domain"
      renderModels : boolean = false
        @label "Render models"
        @description "True writes the entities and type aliases as model code; false imports the shell's generated models (modelImports)"
        @tier "domain"
      modelAnnotation : string = ""
        @label "Model annotation"
        @description "Line before a model class ({{at}} is the at sign)"
        @tier "domain"
      modelClassOpen : string = "class {{name}} {"
        @label "Model open"
        @description "Head of a model class"
        @tier "domain"
      modelClassClose : string = "}"
        @label "Model close"
        @description "Foot of a model class"
        @tier "domain"
      modelField : string = "{{i}}{{name}}: {{type}}{{default}}"
        @label "Model field"
        @description "One model field"
        @tier "domain"
      modelDefault : string = " = {{value}}"
        @label "Model default"
        @description "A field default"
        @tier "domain"
      modelFactory : string = " = {{value}}"
        @label "Model collection default"
        @description "A list or map field default"
        @tier "domain"
      modelEmpty : string = ""
        @label "Model empty"
        @description "Body of a model with no field"
        @tier "domain"
      modelAlias : string = "{{name}} = {{type}}"
        @label "Model alias"
        @description "A type alias"
        @tier "domain"
      typeMap : Map string string = {  }
        @label "Type map"
        @description "Target type per lolo field type; a type missing here is written as typeAny"
        @tier "domain"
      typeList : string = "[{{0}}]"
        @label "List type"
        @description "A list of {{0}}"
        @tier "domain"
      typeListBare : string = "list"
        @label "Bare list type"
        @description "A list of unknown items"
        @tier "domain"
      typeDict : string = "Map<String, {{0}}>"
        @label "Map type"
        @description "A map of {{0}}"
        @tier "domain"
      typeDictBare : string = "dict"
        @label "Bare map type"
        @description "A map of unknown values"
        @tier "domain"
      typeLiteral : string = "{{*}}"
        @label "Literal type"
        @description "A union of string values"
        @tier "domain"
      typeNullable : string = "{{0}}?"
        @label "Nullable type"
        @description "An optional type"
        @tier "domain"
      typeAny : string = "Any"
        @label "Any type"
        @description "The type of what no map covers"
        @tier "domain"
    }

    state ready {
      INIT -> ready

      LOLO_TO_SOURCE -> ready when (and @config.requiresTypes (= (default @payload.path "") ""))
        (emit SOURCE_RENDER_FAILED { error: "this target needs the checker's types, so the request must carry the absolute path of the .lolo file" })

      LOLO_TO_SOURCE -> std when (or (not @config.requiresTypes) (!= (default @payload.path "") ""))
        (set @entity.source @payload.source)
        (set @entity.path (default @payload.path ""))
        (set @entity.only (default @payload.orbitals []))
        (set @entity.typed (!= (default @payload.path "") ""))
        (set @entity.types {})
        (set @entity.expected {})
        (set @entity.models {})
        (os/read-file { anchor: "cwd" path: "node_modules/@almadar/std/package.json" } { key: "std" emit: { success: SRC_STD, failure: SRC_TABLE_FAILED } })
    }

    state std {
      INIT -> std
      LOLO_TO_SOURCE -> std
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })
      SRC_TABLE_FAILED -> ready
        (emit SOURCE_RENDER_FAILED { error: (str/concat "the operator table is not readable: " (default @payload.error "")) })
      SRC_STD -> ready when (= (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") ""))))) "")
        (emit SOURCE_RENDER_FAILED { error: "the installed @almadar/std declares no orbLanguage operators" })
      SRC_STD -> table when (!= (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") ""))))) "")
        (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/std/" (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") "")))))) } { key: "operators" emit: { success: SRC_OPERATORS, failure: SRC_TABLE_FAILED } })
    }

    state table {
      INIT -> table
      LOLO_TO_SOURCE -> table
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })
      SRC_TABLE_FAILED -> ready
        (emit SOURCE_RENDER_FAILED { error: (str/concat "the operator table is not readable: " (default @payload.error "")) })
      SRC_OPERATORS -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") SrcOperatorTable) null)
        (emit SOURCE_RENDER_FAILED { error: "the operator table is not valid JSON" })
      SRC_OPERATORS -> reading when (and (!= (json/parse (default (bytes/to-string @payload.data) "") SrcOperatorTable) null) @entity.typed)
        (set @entity.operatorNames (let ((tbl (json/parse (default (bytes/to-string @payload.data) "") SrcOperatorTable))) (default (object/keys (object/get @tbl "operators")) [])))
        (program/read @entity.source { inspect: true, path: @entity.path } { emit: { success: LOLO_INSPECTED, failure: LOLO_READ_FAILED } })
      SRC_OPERATORS -> reading when (and (!= (json/parse (default (bytes/to-string @payload.data) "") SrcOperatorTable) null) (not @entity.typed))
        (set @entity.operatorNames (let ((tbl (json/parse (default (bytes/to-string @payload.data) "") SrcOperatorTable))) (default (object/keys (object/get @tbl "operators")) [])))
        (program/read @entity.source { emit: { success: LOLO_READ, failure: LOLO_READ_FAILED } })
    }

    state reading {
      INIT -> reading
      LOLO_TO_SOURCE -> reading
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })
      LOLO_READ_FAILED -> ready
        (emit SOURCE_RENDER_FAILED { error: (default @payload.error "the source could not be read") })
      LOLO_READ -> rendering when (not (array/some (object/get @payload.result "orbitals") (fn co (array/some (object/get @co "traits") (fn ct (!= (object/get @ct "ref" null) null))))))
        (set @entity.program @payload.result)
        (emit SRC_PREPARE { })
      LOLO_READ -> reading when (and (array/some (object/get @payload.result "orbitals") (fn co (array/some (object/get @co "traits") (fn ct (!= (object/get @ct "ref" null) null))))) (!= @entity.path ""))
        (program/read @entity.source { resolve: true, text: false, path: @entity.path } { emit: { success: LOLO_RESOLVED, failure: LOLO_READ_FAILED } })
      LOLO_READ -> ready when (and (array/some (object/get @payload.result "orbitals") (fn co (array/some (object/get @co "traits") (fn ct (!= (object/get @ct "ref" null) null))))) (= @entity.path ""))
        (emit SOURCE_RENDER_FAILED { error: "a program that composes behaviors renders from its composed program, which needs the source's absolute path" })
      LOLO_RESOLVED -> rendering
        (set @entity.program @payload.result.program)
        (emit SRC_PREPARE { })
      LOLO_INSPECTED -> rendering
        (set @entity.program (if (array/some (object/get @payload.result.authoredProgram "orbitals") (fn co (array/some (object/get @co "traits") (fn ct (!= (object/get @ct "ref" null) null))))) @payload.result.program @payload.result.authoredProgram))
        (set @entity.types @payload.result.types)
        (set @entity.expected @payload.result.expected)
        (set @entity.models @payload.result.models)
        (emit SRC_PREPARE { })
    }

    state rendering {
      INIT -> rendering
      LOLO_TO_SOURCE -> rendering
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })

      SRC_PREPARE -> ready when (array/some @entity.only (fn on (not (array/some (object/get (default @entity.program { orbitals: [] }) "orbitals") (fn po (= (object/get @po "name") @on))))))
        (emit SOURCE_RENDER_FAILED { error: (str/concat "the program has no orbital named " (str/join (array/filter @entity.only (fn on (not (array/some (object/get (default @entity.program { orbitals: [] }) "orbitals") (fn po (= (object/get @po "name") @on)))))) ", ")) })
      SRC_PREPARE -> rendering when (not (array/some @entity.only (fn on (not (array/some (object/get (default @entity.program { orbitals: [] }) "orbitals") (fn po (= (object/get @po "name") @on)))))))
        (set @entity.program (let ((pg : SrcProgram (default @entity.program { orbitals: [] }))) (if (= (array/len @entity.only) 0) @pg (object/set @pg "orbitals" (array/filter (object/get @pg "orbitals") (fn po (array/includes @entity.only (object/get @po "name"))))))))
        (set @entity.containers (let ((prog (default @entity.program { orbitals: [] })))
          (array/concat
            (array/map (object/entries (default (object/get @prog "types") {})) (fn en
              { name: (default (array/nth @en 0) ""), alias: (array/some (array/take (default (array/nth @en 1) []) 1) (fn f (= (default (object/get @f "name") "x") ""))), fields: (default (array/nth @en 1) []) }))
            (array/map (array/filter (object/get @prog "orbitals") (fn o (validate/object (object/get @o "entity" null)))) (fn o
              { name: (object/get (default (object/get @o "entity") { name: "", fields: [] }) "name"), alias: false, fields: (object/get (default (object/get @o "entity") { name: "", fields: [] }) "fields") })))))
        (set @entity.traits (let ((orbs : [SrcOrbital] (default (object/get (default @entity.program { orbitals: [] }) "orbitals") [])))
          (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
            (let ((o (default (array/nth @orbs @oi) { name: "", traits: [] })))
              (array/map (array/range 0 (array/len (object/get @o "traits"))) (fn ti
                (let ((t (default (array/nth (object/get @o "traits") @ti) { name: "" }))
                      (tn : string (default (object/get (default (array/nth (object/get @o "traits") @ti) { name: "" }) "name") "")))
                  (let ((machine (default (object/get @t "stateMachine") { states: [], transitions: [] }))
                        (initials (array/filter (object/get (default (object/get @t "stateMachine") { states: [], transitions: [] }) "states") (fn s (= (object/get @s "isInitial" false) true))))
                        (evs (default (object/get (default (object/get @t "stateMachine") { states: [], transitions: [] }) "events") []))
                        (ems (default (object/get @t "emits") [])))
                    { name: @tn,
                      path: (str/concat "orbitals[" @oi "].traits[" @ti "]"),
                      entity: (default (object/get @t "linkedEntity") ""),
                      initial: (default (object/get (default (array/first @initials) { name: "" }) "name") ""),
                      hasMachine: (> (array/len (object/get @machine "states")) 0),
                      knobs: (array/map (object/entries (default (object/get @t "config") {})) (fn en { key: (default (array/nth @en 0) ""), default: (object/get (default (array/nth @en 1) {}) "default" null) })),
                      configType: (if (or (= @config.configType "") (= (array/len (object/keys (default (object/get @t "config") {}))) 0)) "" (let ((v1 : SrcVars (object/fromEntries [["trait" @tn]]))) (let ((f2p (str/split @config.configType "{{"))) (str/concat (default (array/first @f2p) "") (str/join (array/map (array/drop @f2p 1) (fn f2q (let ((f2r (str/split @f2q "}}"))) (if (< (array/len @f2r) 2) (str/concat "{{" @f2q) (str/concat (object/get @v1 (default (array/first @f2r) "") (str/concat "{{" (default (array/first @f2r) "") "}}")) (str/join (array/drop @f2r 1) "}}")))))) ""))))),
                      transitions: (object/get @machine "transitions"),
                      events: (array/unique (array/map (object/get @machine "transitions") (fn tr (object/get @tr "event")))),
                      listenTypes: (object/fromEntries (array/map (array/filter @evs (fn ev (> (array/len (default (object/get @ev "payloadSchema") [])) 0))) (fn ev [(object/get @ev "key") (let ((v9 : SrcVars (object/fromEntries [["trait" @tn] ["event" (let ((cb3 (str/replace-pattern (str/replaceAll (object/get @ev "key") "-" "_") "[.]" "_"))) (let ((cw4 (array/filter (str/split (str/lower @cb3) "_") (fn cx5 (!= @cx5 ""))))) (if (= "keep" "lower") (str/lower @cb3) (if (= "keep" "upper") (str/upper @cb3) (if (= "keep" "camel") (str/concat (default (array/first @cw4) "") (str/join (array/map (array/drop @cw4 1) (fn cy6 (str/capitalize @cy6))) "")) (if (= "keep" "pascal") (str/join (array/map @cw4 (fn cy6 (str/capitalize @cy6))) "") (let ((ck7 (str/split @cb3 "_"))) (if (= "keep" "split-camel") (str/concat (default (array/first @ck7) "") (str/join (array/map (array/drop @ck7 1) (fn cy6 (str/concat (str/upper (str/slice @cy6 0 1)) (str/slice @cy6 1 (str/len @cy6))))) "")) (if (= "keep" "split-pascal") (str/join (array/map @ck7 (fn cy6 (str/concat (str/upper (str/slice @cy6 0 1)) (str/slice @cy6 1 (str/len @cy6))))) "") (if (= "keep" "lower-camel") (let ((cl8 (str/join (array/map @ck7 (fn cy6 (str/concat (str/upper (str/slice @cy6 0 1)) (str/slice @cy6 1 (str/len @cy6))))) ""))) (str/concat (str/lower (str/slice @cl8 0 1)) (str/slice @cl8 1 (str/len @cl8)))) @cb3))))))))))]]))) (let ((f10p (str/split @config.payloadType "{{"))) (str/concat (default (array/first @f10p) "") (str/join (array/map (array/drop @f10p 1) (fn f10q (let ((f10r (str/split @f10q "}}"))) (if (< (array/len @f10r) 2) (str/concat "{{" @f10q) (str/concat (object/get @v9 (default (array/first @f10r) "") (str/concat "{{" (default (array/first @f10r) "") "}}")) (str/join (array/drop @f10r 1) "}}")))))) ""))))]))),
                      emitTypes: (object/fromEntries (array/map (array/filter @ems (fn ev (> (array/len (default (object/get @ev "payloadSchema") [])) 0))) (fn ev [(object/get @ev "event") (let ((v17 : SrcVars (object/fromEntries [["trait" @tn] ["event" (let ((cb11 (str/replace-pattern (str/replaceAll (object/get @ev "event") "-" "_") "[.]" "_"))) (let ((cw12 (array/filter (str/split (str/lower @cb11) "_") (fn cx13 (!= @cx13 ""))))) (if (= "keep" "lower") (str/lower @cb11) (if (= "keep" "upper") (str/upper @cb11) (if (= "keep" "camel") (str/concat (default (array/first @cw12) "") (str/join (array/map (array/drop @cw12 1) (fn cy14 (str/capitalize @cy14))) "")) (if (= "keep" "pascal") (str/join (array/map @cw12 (fn cy14 (str/capitalize @cy14))) "") (let ((ck15 (str/split @cb11 "_"))) (if (= "keep" "split-camel") (str/concat (default (array/first @ck15) "") (str/join (array/map (array/drop @ck15 1) (fn cy14 (str/concat (str/upper (str/slice @cy14 0 1)) (str/slice @cy14 1 (str/len @cy14))))) "")) (if (= "keep" "split-pascal") (str/join (array/map @ck15 (fn cy14 (str/concat (str/upper (str/slice @cy14 0 1)) (str/slice @cy14 1 (str/len @cy14))))) "") (if (= "keep" "lower-camel") (let ((cl16 (str/join (array/map @ck15 (fn cy14 (str/concat (str/upper (str/slice @cy14 0 1)) (str/slice @cy14 1 (str/len @cy14))))) ""))) (str/concat (str/lower (str/slice @cl16 0 1)) (str/slice @cl16 1 (str/len @cl16)))) @cb11))))))))))]]))) (let ((f18p (str/split @config.payloadType "{{"))) (str/concat (default (array/first @f18p) "") (str/join (array/map (array/drop @f18p 1) (fn f18q (let ((f18r (str/split @f18q "}}"))) (if (< (array/len @f18r) 2) (str/concat "{{" @f18q) (str/concat (object/get @v17 (default (array/first @f18r) "") (str/concat "{{" (default (array/first @f18r) "") "}}")) (str/join (array/drop @f18r 1) "}}")))))) ""))))])))
                      emitVoid: (array/map (array/filter @ems (fn ev (= (array/len (default (object/get @ev "payloadSchema") [])) 0))) (fn ev (object/get @ev "event")))
                      orbital: (object/get @o "name")
                      listenRows: (array/map (array/filter (default (object/get @t "listens") []) (fn l (= (object/get (default (object/get @l "source") { kind: "" }) "kind") "trait")))
                        (fn l { source: (default (object/get (default (object/get @l "source") { kind: "" }) "trait") ""), event: (object/get @l "event"), trigger: (default (object/get @l "triggers") (object/get @l "event")), guard: (object/get @l "guard" null), map: (object/get @l "payloadMapping" null) })) }))))))))))
        (set @entity.groups (array/concat
          (if @config.renderModels (array/map @entity.containers (fn c (array/map (object/get @c "fields") (fn f [0, (object/get @f "default" null)])))) [])
          (array/map @entity.traits (fn t
            (array/concat
              [(array/concat [0] (array/map (object/get @t "knobs") (fn kb (object/get @kb "default" null))))]
              (array/map (object/get @t "transitions") (fn tr (array/concat [0, (if (!= (object/get @tr "guard" null) null) (object/get @tr "guard") true)] (default (object/get @tr "effects" []) []))))
              (array/map (object/get @t "listenRows") (fn lr [0, (if (!= (object/get @lr "guard" null) null) (object/get @lr "guard") true), (default (object/get @lr "map" null) {})])))))))
        (set @entity.groupCtx (array/concat
          (if @config.renderModels (array/map @entity.containers (fn c { emitTypes: {}, emitVoid: [], defaults: {} })) [])
          (array/map @entity.traits (fn t
            { emitTypes: (object/get @t "emitTypes"),
              emitVoid: (object/get @t "emitVoid"),
              defaults: (let ((en (default (array/find @entity.containers (fn c (and (= (object/get @c "name") (object/get @t "entity")) (not (object/get @c "alias"))))) { name: "", alias: true, fields: [] })))
                (object/fromEntries (array/filter (array/map (object/get @en "fields") (fn f [(default (object/get @f "name") "")
                  (let ((d (object/get @f "default" null)))
                    (if (= @d null) ""
