              )])))))
        (set @entity.tokens (array/concat
          (array/flatten (array/flatten (array/map @entity.renders (fn g (array/map @g (fn r (object/get @r "uses")))))))
          (array/flatten (array/flatten (array/map @entity.typeRenders (fn g (array/map @g (fn r (object/get @r "uses")))))))
          (if (and @config.renderModels (array/some @entity.containers (fn c (not (object/get @c "alias"))))) ["dataclass"] [])
          (if (and @config.renderModels (array/some @entity.containers (fn c (array/some (object/get @c "fields") (fn f (and (!= (object/get @f "default" null) null) (or (validate/array (object/get @f "default" null)) (validate/object (object/get @f "default" null))))))))) ["field"] [])))
        (set @entity.tokens (array/concat @entity.tokens (if (and (> (array/len @config.programOpen) 0) (or (array/some @entity.traits (fn t (> (array/len (object/get @t "listenRows")) 0))) (array/includes @entity.tokens "store"))) ["router"] [])))
        (set @entity.helperTexts (array/sort (array/unique (array/flatten (array/map (array/unique @entity.tokens) (fn tk (object/get @config.helpers @tk [])))))))
        (emit SRC_FINISH { })

      SRC_FINISH -> ready
        (set @entity.text (let ((importLines (array/sort (array/unique (array/filter (array/map @entity.tokens (fn tk (object/get @config.imports @tk ""))) (fn l (!= @l ""))))))
                                (ents (array/sort (array/unique (array/concat (array/map (array/filter (array/map @entity.traits (fn t (object/get @t "entity"))) (fn x (!= @x ""))) (fn x (let ((en630 @x)) (object/get @config.entityNames @en630 @en630))))
                                  (if (= @config.recordForm "") [] (array/flatten (array/map (object/values @entity.expected) (fn v (if (str/startsWith @v "enum:") [(str/slice @v 5 (str/len @v))] (str/split @v "."))))))))))
                                (pls (array/sort (array/unique (array/flatten (array/map @entity.traits (fn t (array/concat (object/values (object/get @t "listenTypes")) (object/values (object/get @t "emitTypes")) (if (= (object/get @t "configType") "") [] [(object/get @t "configType")])))))))))
          (let ((entLines (let ((tpl (object/get @config.modelImports "entity" ""))) (if (or (= @tpl "") (= (array/len @ents) 0)) [] (if @config.modelImportEach (array/map @ents (fn nm (let ((v631 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f632p (str/split @tpl "{{"))) (str/concat (default (array/first @f632p) "") (str/join (array/map (array/drop @f632p 1) (fn f632q (let ((f632r (str/split @f632q "}}"))) (if (< (array/len @f632r) 2) (str/concat "{{" @f632q) (str/concat (object/get @v631 (default (array/first @f632r) "") (str/concat "{{" (default (array/first @f632r) "") "}}")) (str/join (array/drop @f632r 1) "}}")))))) "")))))) [(let ((v633 : SrcVars (object/fromEntries [["names" (str/join @ents @config.modelImportSep)]]))) (let ((f634p (str/split @tpl "{{"))) (str/concat (default (array/first @f634p) "") (str/join (array/map (array/drop @f634p 1) (fn f634q (let ((f634r (str/split @f634q "}}"))) (if (< (array/len @f634r) 2) (str/concat "{{" @f634q) (str/concat (object/get @v633 (default (array/first @f634r) "") (str/concat "{{" (default (array/first @f634r) "") "}}")) (str/join (array/drop @f634r 1) "}}")))))) ""))))]))))
