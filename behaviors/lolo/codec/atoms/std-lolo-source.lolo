        @tier "domain"
      stringEscapes : Map string string = {  }
        @label "String escapes"
        @description "Extra replacements applied to the inner text of every string literal after the standard JSON escaping (Kotlin writes a dollar as backslash dollar). They run one after another in sorted key order, so a later key sees the output of an earlier one; the quotes are never touched"
        @tier "domain"
      numberForm : string = "{{json}}"
        @label "Number form"
