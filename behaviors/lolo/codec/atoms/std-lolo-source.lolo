        @tier "domain"
      numberIntForm : string = "{{json}}"
        @label "Integer form"
        @description "A number literal whose JSON text is an integer (optional minus, digits only), {{json}} its text; a target that wants a floating literal writes {{json}}.0"
        @tier "domain"
      listForm : string = "[{{*}}]"
        @label "List literal"
