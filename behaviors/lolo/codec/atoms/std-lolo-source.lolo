app std-lolo-source [
  version: "1.0.0",
  fs: { cwd: "node_modules/@almadar/std/**": [read] },
  description: "std-lolo-source \u{2014} renders .lolo source as native code in any target language, with every spelling of the language in config. LOLO_TO_SOURCE { source, path? } answers SOURCE_RENDERED { text, warnings }, or SOURCE_RENDER_FAILED { error } when the source cannot be read, the installed operator table is not readable, a render is already running, or the target needs the checker's types (requiresTypes) and the request carries no path. The output never calls the kernel and gives the kernel's answers. \nPipeline: it reads the installed operator table once per request (the file @almadar/std declares as orbLanguage.operators, for the operator names only), reads the program with program/read, collects the containers and the traits, renders every guard, effect and default with tree/fold, and assembles imports, helpers and one class per trait. A list is a call exactly when its first item is a string naming an operator of that table (a form included: fn, let, if, do, set, emit, render-ui, when) or match or invoke; any other list is a list literal. \nTemplates are strings with {{key}} placeholders filled in one pass, so text that looks like a placeholder inside a program string is never filled twice. A call takes the first of: the lambda template (lambdaOperators, when the second argument is an fn), the unary template (one argument), the infix symbol (two or more arguments), operators[op#N] (exactly N arguments), operators[op], the callee (callees). An operator no table covers is the unsupported form, which must raise when run, plus the warning unsupportedWarn: the output never calls a name it does not define. helpers keys an operator or token to the definitions it needs; each used definition is written once, sorted. imports keys an operator or token to its import line. \nAn effect listed in portEffects is called on the ports object (portCall) and each is a warning that names the site (Trait.EVENT). render-ui is a comment. emit builds the payload as the shell's generated payload type (payloadType names it like the TypeScript shell, <Trait><EVENT>Payload) and the entity and payload types are imported (modelImports) unless renderModels is true, which writes the entities and type aliases as model code. set is an assignment, or with setStyle copy a rebuilt entity (one field deep; a deeper path warns). entityReadDefault, when set, reads a defaulted entity field with a scalar or empty default as coalesce(field, default). \nTypes: with the original absolute path of the .lolo file the reader answers the kernel checker's type of every node (program/read with inspect) by ir-path. {{type}} in an operator template is the type of the call, {{type0}}, {{type1}}... the types of its arguments, and {{type}} in letStmt and letExpr the type of the bound value; each is typeNames[type text] when listed, else the checker's text, else typeUnknown. The atom infers no type itself. A typed target sets requiresTypes. \nLiterals: stringEscapes adds target-specific replacements inside every string literal (sorted key order, quotes untouched); numberIntForm writes a number whose JSON text is an integer and numberForm writes any other. A map literal with no pair is mapEmpty when set. entityNames renames the .lolo entity wherever its name is written, payloadFieldOrder sorted lists payload fields by name, and fileHeader is written before the imports.\nKnown limits: a let binding named like an operator (path, list, log...) adds a spurious unsupported or port warning for the binding; entityReadDefault covers scalar and empty-collection defaults only; a fn body renders its last expression only."
]
;; Generated by spec/codec/lolo-source.gen/build.py; regenerate, never hand-edit.
uses Spec from "almadar-std/lolo-source"

type SrcExpr = string | number | boolean | [SrcExpr?] | Map string SrcExpr?
type SrcJob = [SrcExpr?]
type SrcList = [SrcExpr]
type SrcLists = [SrcList]
type SrcVars = Map string string
type SrcRef = { type : string! }
type SrcField = { name : string?, type : string!, required : boolean?, nullable : boolean?, values : [string]?, items : SrcField?, properties : Map string SrcField?, projectedFrom : SrcRef?, default : SrcExpr? }
type SrcKnobDecl = { default : SrcExpr? }
type SrcState = { name : string!, isInitial : boolean? }
type SrcTransition = { from : string!, to : string!, event : string!, guard : SrcExpr?, effects : [SrcExpr?]? }
type SrcEvent = { key : string!, payloadSchema : [SrcField]? }
type SrcMachine = { states : [SrcState]!, transitions : [SrcTransition]!, events : [SrcEvent]? }
type SrcEmitDecl = { event : string!, payloadSchema : [SrcField]? }
type SrcTraitDecl = { name : string!, linkedEntity : string?, config : Map string SrcKnobDecl?, emits : [SrcEmitDecl]?, stateMachine : SrcMachine? }
type SrcEntityDecl = { name : string!, fields : [SrcField]! }
type SrcOrbital = { name : string!, entity : SrcEntityDecl?, traits : [SrcTraitDecl]! }
type SrcProgram = { types : Map string [SrcField]?, orbitals : [SrcOrbital]! }
type SrcInspect = { program : SrcProgram!, types : Map string string! }
type SrcContainer = { name : string!, alias : boolean!, fields : [SrcField]! }
type SrcKnob = { key : string!, default : SrcExpr? }
type SrcTraitInfo = { name : string!, path : string!, entity : string!, initial : string!, hasMachine : boolean!, knobs : [SrcKnob]!, transitions : [SrcTransition]!, events : [string]!, listenTypes : Map string string!, emitTypes : Map string string! }
type SrcCtx = { emitTypes : Map string string!, defaults : Map string string! }
type SrcRender = { expr : string!, stmt : [string]!, params : [string]!, body : string!, items : [string]!, keys : [string]!, stmts : [[string]]!, pairVals : [string]!, warns : [string]!, uses : [string]! }
type SrcTypeRender = { text : string!, uses : [string]! }
type SrcManifestLanguage = { operators : string? }
type SrcManifest = { orbLanguage : SrcManifestLanguage? }
type SrcOperator = { category : string? }
type SrcOperatorTable = { operators : Map string SrcOperator! }

orbital LoloSourceOrbital [fs: { cwd: "node_modules/@almadar/std/**": [read] }] {
  entity LoloSourceRun [runtime] {
    id : string!
    source : string = ""
    path : string = ""
    typed : boolean = false
    types : Map string string = {}
    operatorNames : [string] = []
    program : SrcProgram?
    containers : [SrcContainer] = []
    traits : [SrcTraitInfo] = []
    groups : [[SrcJob]] = []
    groupCtx : [SrcCtx] = []
    renders : [[SrcRender]] = []
    typeRenders : [[SrcTypeRender]] = []
    blocks : [[string]] = []
    helperTexts : [string] = []
    tokens : [string] = []
    warnings : [string] = []
    text : string = ""
  }

  trait LoloSource -> LoloSourceRun [optimistic] {
    initial: ready

    config {
      language : string = ""
        @label "Language name"
        @description "Target language name, used in the warning of an operator that has no template"
        @tier "domain"
      requiresTypes : boolean = false
        @label "Needs checker types"
        @description "True for a typed target: a request without the absolute .lolo path answers SOURCE_RENDER_FAILED, because the types come from the kernel checker (program/read inspect)"
        @tier "domain"
      operators : Map string string = {  }
        @label "Operator templates"
        @description "Template per operator name: {{0}}, {{1}}... are the rendered arguments, {{*}} all of them joined by a comma, {{type}} the checker type of the call and {{type0}}, {{type1}}... the types of the arguments. A key `op#N` applies only when the call has N arguments and wins over `op`"
        @tier "domain"
      unary : Map string string = {  }
        @label "Unary templates"
        @description "Template per operator used with exactly one argument (negation, not...); it wins over every other template for that call"
        @tier "domain"
      infix : Map string string = {  }
        @label "Infix operators"
        @description "Symbol per variadic infix operator; a call with two or more arguments joins the rendered arguments by it (infixForm) and wins over operators"
        @tier "domain"
      infixForm : string = "({{*}})"
        @label "Infix form"
        @description "How the joined infix arguments are wrapped"
        @tier "domain"
      lambdaOperators : Map string string = {  }
        @label "Lambda operators"
        @description "Template per operator whose second argument is an fn: {{src}} is the collection (indexedSource when the fn takes an index), {{vars}} the loop target, {{item}} the first parameter and {{body}} the fn body"
        @tier "domain"
      lambdaForm : string = ""
        @label "Lambda form"
        @description "An fn as an expression: {{params}} joined by a comma, {{body}}"
        @tier "domain"
      indexedSource : string = "{{src}}"
        @label "Indexed source"
        @description "The collection when the fn takes an index as well as the item"
        @tier "domain"
      indexedVars : string = "{{item}}"
        @label "Indexed loop target"
        @description "The loop target when the fn takes an index: {{index}} and {{item}}"
        @tier "domain"
      callees : Map string string = {  }
        @label "Callees"
        @description "Callee name per operator that is a plain function of the target (math/ceil to math.ceil); an operator listed nowhere has no template"
        @tier "domain"
      calleeForm : string = "{{callee}}({{*}})"
        @label "Callee form"
        @description "How a call to a callee is written"
        @tier "domain"
      unsupportedForm : string = ""
        @label "Unsupported form"
        @description "The expression written for an operator with no template; it must raise when run ({{op}} is the quoted operator name). The helper it needs is helpers[\"unsupported\"]"
        @tier "domain"
      unsupportedWarn : string = "no {{language}} template for operator {{op}}"
        @label "Unsupported warning"
        @description "The warning written for an operator with no template"
        @tier "domain"
      helpers : Map string [string] = {  }
        @label "Helpers"
        @description "Source text of the helper definitions an operator needs, keyed by operator (or token); the output carries each used definition once, sorted"
        @tier "domain"
      helperGap : string = "\n"
        @label "Helper gap"
        @description "Text between two helper definitions"
        @tier "domain"
      imports : Map string string = {  }
        @label "Imports"
        @description "Import line per used operator or token (Literal, Any, field, dataclass); written sorted and without duplicates"
        @tier "domain"
      portEffects : [string] = []
        @label "Port effects"
        @description "Effects outside the native core, called on the ports object the caller injects"
        @tier "domain"
      portCall : string = ""
        @label "Port call"
        @description "How a port effect is called: {{name}} and {{*}}"
        @tier "domain"
      portCase : string = "keep"
        @label "Port name case"
        @description "keep, lower, upper, camel or pascal"
        @tier "domain"
      portWarn : string = "{{op}} is called on the ports object"
        @label "Port warning"
        @description "The warning written for each port effect"
        @tier "domain"
      attributeRoots : Map string string = {  }
        @label "Attribute roots"
        @description "Target expression per sigil whose path reads as attributes (@entity.x)"
        @tier "domain"
      itemRoots : Map string string = {  }
        @label "Item roots"
        @description "Target expression per sigil whose path reads as items (@config.x)"
        @tier "domain"
      attrAccess : string = ".{{name}}"
        @label "Attribute access"
        @description "Attribute step of a path"
        @tier "domain"
      itemAccess : string = "[{{key}}]"
        @label "Item access"
        @description "Item step of a path, {{key}} the quoted key"
        @tier "domain"
      indexAccess : string = "[{{0}}]"
        @label "Index access"
        @description "Step for a numeric path segment"
        @tier "domain"
      localAccess : string = "item"
        @label "Local access"
        @description "item or attr: how a path under a let or fn name reads"
        @tier "domain"
      entityReadDefault : string = ""
        @label "Entity read default"
        @description "When not empty, a read of a defaulted entity field with a scalar or empty default is written with it: {{read}}, {{default}}"
        @tier "domain"
      typeNames : Map string string = {  }
        @label "Type names"
        @description "Target text per checker type text, for {{type}} placeholders; a type missing here is written as the checker gives it"
        @tier "domain"
      typeUnknown : string = ""
        @label "Unknown type"
        @description "Written for a {{type}} placeholder whose path the checker has no type for"
        @tier "domain"
      nullLit : string = "null"
        @label "null"
        @description "The null literal"
        @tier "domain"
      trueLit : string = "true"
        @label "true"
        @description "The true literal"
        @tier "domain"
      falseLit : string = "false"
        @label "false"
        @description "The false literal"
        @tier "domain"
      stringForm : string = "{{json}}"
        @label "String form"
        @description "A string literal, {{json}} its quoted and escaped text"
        @tier "domain"
      stringEscapes : Map string string = {  }
        @label "String escapes"
        @description "Extra replacements applied to the inner text of every string literal after the standard JSON escaping (Kotlin writes a dollar as backslash dollar). They run one after another in sorted key order, so a later key sees the output of an earlier one; the quotes are never touched"
        @tier "domain"
      numberForm : string = "{{json}}"
        @label "Number form"
        @description "A number literal, {{json}} its text; used for every number whose text is not an integer (numberIntForm covers the integers)"
        @tier "domain"
      numberIntForm : string = "{{json}}"
        @label "Integer form"
        @description "A number literal whose JSON text is an integer (optional minus, digits only), {{json}} its text; a target that wants a floating literal writes {{json}}.0"
        @tier "domain"
      listForm : string = "[{{*}}]"
        @label "List literal"
        @description "A list literal"
        @tier "domain"
      mapOpen : string = "{"
        @label "Map open"
        @description "Start of a map literal"
        @tier "domain"
      mapEmpty : string = ""
        @label "Empty map"
        @description "The map literal with no pair (a config with no knob included); empty means mapOpen followed by mapClose"
        @tier "domain"
      mapClose : string = "}"
        @label "Map close"
        @description "End of a map literal"
        @tier "domain"
      mapPair : string = "{{key}}: {{value}}"
        @label "Map pair"
        @description "One member of a map literal"
        @tier "domain"
      mapSep : string = ", "
        @label "Map separator"
        @description "Between members of a map literal"
        @tier "domain"
      letStmt : string = "{{name}} = {{value}}"
        @label "Let statement"
        @description "A binding in statement position: {{name}}, {{value}}, {{type}}"
        @tier "domain"
      letExpr : string = "{{body}}"
        @label "Let expression"
        @description "A binding in expression position, one per name, nested: {{name}}, {{value}}, {{body}}, {{type}}"
        @tier "domain"
      condExpr : string = "{{cond}} ? {{then}} : {{else}}"
        @label "Conditional expression"
        @description "if in expression position"
        @tier "domain"
      ifOpen : string = "if ({{cond}}) {"
        @label "If open"
        @description "Head of an if statement"
        @tier "domain"
      elseOpen : string = "} else {"
        @label "Else open"
        @description "Head of the else part"
        @tier "domain"
      blockClose : string = "}"
        @label "Block close"
        @description "End of a block; empty when the target closes by indentation"
        @tier "domain"
      emptyBody : string = ""
        @label "Empty body"
        @description "The statement of a block with no statement (pass); empty when none is needed"
        @tier "domain"
      setStyle : string = "assign"
        @label "Set style"
        @description "assign (target = value) or copy (the entity is rebuilt with one field replaced)"
        @tier "domain"
      setAssign : string = "{{target}} = {{value}}"
        @label "Set assign"
        @description "An assignment: {{target}}, {{value}}"
        @tier "domain"
      setCopy : string = "{{root}} = {{root}}.copy({{field}} = {{value}})"
        @label "Set copy"
        @description "A copy: {{root}}, {{field}}, {{value}}; a deeper path warns"
        @tier "domain"
      emitForm : string = "emit({{event}}, {{payload}})"
        @label "Emit"
        @description "An emit statement: {{event}} quoted, {{payload}}"
        @tier "domain"
      payloadType : string = "{{trait}}{{event}}Payload"
        @label "Payload type name"
        @description "Name of the shell-generated payload type of an event, as the TypeScript shell names it"
        @tier "domain"
      payloadCtor : string = "{{type}}({{fields}})"
        @label "Payload constructor"
        @description "A payload value: {{type}}, {{fields}}"
        @tier "domain"
      payloadField : string = "{{name}}={{value}}"
        @label "Payload field"
        @description "One field of a payload value"
        @tier "domain"
      payloadSep : string = ", "
        @label "Payload separator"
        @description "Between payload fields"
        @tier "domain"
      payloadFieldOrder : string = "declared"
        @label "Payload field order"
        @description "declared (the order of the object literal) or sorted (by field name, matching a target whose generated payload type lists its fields sorted and whose constructor takes them in that order)"
        @tier "domain"
      commentForm : string = "// {{text}}"
        @label "Comment"
        @description "How render-ui is written"
        @tier "domain"
      indent : string = "  "
        @label "Indent"
        @description "One level of indentation"
        @tier "domain"
      terminator : string = ""
        @label "Terminator"
        @description "Ends a simple statement"
        @tier "domain"
      classCase : string = "keep"
        @label "Class case"
        @description "keep, lower, upper, camel or pascal"
        @tier "domain"
      fieldCase : string = "keep"
        @label "Field case"
        @description "keep, lower, upper, camel or pascal"
        @tier "domain"
      localCase : string = "keep"
        @label "Local case"
        @description "keep, lower, upper, camel or pascal"
        @tier "domain"
      methodCase : string = "keep"
        @label "Method case"
        @description "How the event key reads inside methodName"
        @tier "domain"
      methodName : string = "on{{event}}"
        @label "Method name"
        @description "The method of an event: {{event}}"
        @tier "domain"
      modelImports : Map string string = {  }
        @label "Model imports"
        @description "Import of the shell's generated models: entity and payload templates with {{names}} (joined) or {{name}} (one per line)"
        @tier "domain"
      entityNames : Map string string = {  }
        @label "Entity names"
        @description "Generated name per .lolo entity or type name, written wherever the name appears: the constructor {{entity}}, the model imports, and the model classes, aliases and projected references when renderModels is true; a name missing here is written as it is"
        @tier "domain"
      modelImportEach : boolean = false
        @label "One import per name"
        @description "Write one model import line per name"
        @tier "domain"
      modelImportSep : string = ", "
        @label "Model import separator"
        @description "Between names in one import line"
        @tier "domain"
      fileHeader : string = ""
        @label "File header"
        @description "Text written first in the file, before the imports and followed by sectionGap; empty writes nothing (a package declaration)"
        @tier "domain"
      sectionGap : string = "\n\n\n"
        @label "Section gap"
        @description "Between the imports, the helpers and each class"
        @tier "domain"
      classOpen : string = "class {{class}} {"
        @label "Class open"
        @description "Head of a trait class"
        @tier "domain"
      classClose : string = "}"
        @label "Class close"
        @description "Foot of a trait class; empty when none"
        @tier "domain"
      classEmpty : string = ""
        @label "Class empty"
        @description "Body of a trait class that has no state machine (pass); empty when none is needed"
        @tier "domain"
      constructor : [string] = []
        @label "Constructor"
        @description "Lines of the constructor and fields: {{i}} indent, {{class}}, {{entity}}, {{initial}} quoted, {{config}} the config map literal"
        @tier "domain"
      emitMethod : [string] = []
        @label "Emit method"
        @description "Lines of the method that records an emit"
        @tier "domain"
      methodOpen : string = "{{i}}fun {{method}}(payload: {{payloadType}}) {"
        @label "Method open"
        @description "Head of an event method that has a payload: {{i}}, {{method}}, {{payloadType}}"
        @tier "domain"
      methodOpenPlain : string = "{{i}}fun {{method}}() {"
        @label "Method open (no payload)"
        @description "Head of an event method with no payload"
        @tier "domain"
      methodClose : string = "{{i}}}"
        @label "Method close"
        @description "Foot of an event method; empty when none"
        @tier "domain"
      branchFirst : string = "{{i}}{{i}}if ({{test}}) {"
        @label "First branch"
        @description "Head of the first transition of an event"
        @tier "domain"
      branchNext : string = "{{i}}{{i}}} else if ({{test}}) {"
        @label "Next branch"
        @description "Head of the next transitions"
        @tier "domain"
      branchClose : string = "{{i}}{{i}}}"
        @label "Branch close"
        @description "Foot of the branches; empty when none"
        @tier "domain"
      branchTest : string = "{{stateTest}} && {{guard}}"
        @label "Branch test"
        @description "State test and guard"
        @tier "domain"
      branchTestPlain : string = "{{stateTest}}"
        @label "Branch test (no guard)"
        @description "State test alone"
        @tier "domain"
      stateTest : string = "state == {{state}}"
        @label "State test"
        @description "From-state test, {{state}} quoted"
        @tier "domain"
      stateAssign : string = "state = {{state}}"
        @label "State assignment"
        @description "New-state statement, {{state}} quoted"
        @tier "domain"
      bodyPrefix : string = "{{i}}{{i}}{{i}}"
        @label "Body prefix"
        @description "Indentation of the statements of a branch"
        @tier "domain"
      renderModels : boolean = false
        @label "Render models"
        @description "True writes the entities and type aliases as model code; false imports the shell's generated models (modelImports)"
        @tier "domain"
      modelAnnotation : string = ""
        @label "Model annotation"
        @description "Line before a model class ({{at}} is the at sign)"
        @tier "domain"
      modelClassOpen : string = "class {{name}} {"
        @label "Model open"
        @description "Head of a model class"
        @tier "domain"
      modelClassClose : string = "}"
        @label "Model close"
        @description "Foot of a model class"
        @tier "domain"
      modelField : string = "{{i}}{{name}}: {{type}}{{default}}"
        @label "Model field"
        @description "One model field"
        @tier "domain"
      modelDefault : string = " = {{value}}"
        @label "Model default"
        @description "A field default"
        @tier "domain"
      modelFactory : string = " = {{value}}"
        @label "Model collection default"
        @description "A list or map field default"
        @tier "domain"
      modelEmpty : string = ""
        @label "Model empty"
        @description "Body of a model with no field"
        @tier "domain"
      modelAlias : string = "{{name}} = {{type}}"
        @label "Model alias"
        @description "A type alias"
        @tier "domain"
      typeMap : Map string string = {  }
        @label "Type map"
        @description "Target type per lolo field type; a type missing here is written as typeAny"
        @tier "domain"
      typeList : string = "[{{0}}]"
        @label "List type"
        @description "A list of {{0}}"
        @tier "domain"
      typeListBare : string = "list"
        @label "Bare list type"
        @description "A list of unknown items"
        @tier "domain"
      typeDict : string = "Map<String, {{0}}>"
        @label "Map type"
        @description "A map of {{0}}"
        @tier "domain"
      typeDictBare : string = "dict"
        @label "Bare map type"
        @description "A map of unknown values"
        @tier "domain"
      typeLiteral : string = "{{*}}"
        @label "Literal type"
        @description "A union of string values"
        @tier "domain"
      typeNullable : string = "{{0}}?"
        @label "Nullable type"
        @description "An optional type"
        @tier "domain"
      typeAny : string = "Any"
        @label "Any type"
        @description "The type of what no map covers"
        @tier "domain"
    }

    state ready {
      INIT -> ready

      LOLO_TO_SOURCE -> ready when (and @config.requiresTypes (= (default @payload.path "") ""))
        (emit SOURCE_RENDER_FAILED { error: "this target needs the checker's types, so the request must carry the absolute path of the .lolo file" })

      LOLO_TO_SOURCE -> std when (or (not @config.requiresTypes) (!= (default @payload.path "") ""))
        (set @entity.source @payload.source)
        (set @entity.path (default @payload.path ""))
        (set @entity.typed (!= (default @payload.path "") ""))
        (set @entity.types {})
        (os/read-file { anchor: "cwd" path: "node_modules/@almadar/std/package.json" } { key: "std" emit: { success: SRC_STD, failure: SRC_TABLE_FAILED } })
    }

    state std {
      INIT -> std
      LOLO_TO_SOURCE -> std
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })
      SRC_TABLE_FAILED -> ready
        (emit SOURCE_RENDER_FAILED { error: (str/concat "the operator table is not readable: " (default @payload.error "")) })
      SRC_STD -> ready when (= (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") ""))))) "")
        (emit SOURCE_RENDER_FAILED { error: "the installed @almadar/std declares no orbLanguage operators" })
      SRC_STD -> table when (!= (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") ""))))) "")
        (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/std/" (let ((man (json/parse (default (bytes/to-string @payload.data) "") SrcManifest))) (if (= @man null) "" (let ((lang (object/get @man "orbLanguage"))) (if (= @lang null) "" (default (object/get @lang "operators") "")))))) } { key: "operators" emit: { success: SRC_OPERATORS, failure: SRC_TABLE_FAILED } })
    }

    state table {
      INIT -> table
      LOLO_TO_SOURCE -> table
        (emit SOURCE_RENDER_FAILED { error: "a render is already in progress" })
      SRC_TABLE_FAILED -> ready
