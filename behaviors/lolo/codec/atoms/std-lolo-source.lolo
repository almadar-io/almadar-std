              )])))))
        (set @entity.tokens (array/concat
          (array/flatten (array/flatten (array/map @entity.renders (fn g (array/map @g (fn r (object/get @r "uses")))))))
          (array/flatten (array/flatten (array/map @entity.typeRenders (fn g (array/map @g (fn r (object/get @r "uses")))))))
          (if (and @config.renderModels (array/some @entity.containers (fn c (not (object/get @c "alias"))))) ["dataclass"] [])
          (if (and @config.renderModels (array/some @entity.containers (fn c (array/some (object/get @c "fields") (fn f (and (!= (object/get @f "default" null) null) (or (validate/array (object/get @f "default" null)) (validate/object (object/get @f "default" null))))))))) ["field"] [])))
        (set @entity.tokens (array/concat @entity.tokens (if (and (> (array/len @config.programOpen) 0) (or (array/some @entity.traits (fn t (> (array/len (object/get @t "listenRows")) 0))) (array/includes @entity.tokens "store"))) ["router"] [])))
        (set @entity.helperTexts (array/sort (array/unique (array/flatten (array/map (array/unique @entity.tokens) (fn tk (object/get @config.helpers @tk [])))))))
        (emit SRC_FINISH { })

      SRC_FINISH -> ready
        (set @entity.text (let ((importLines (array/sort (array/unique (array/filter (array/map @entity.tokens (fn tk (object/get @config.imports @tk ""))) (fn l (!= @l ""))))))
                                (ents (array/sort (array/unique (array/concat (array/map (array/filter (array/map @entity.traits (fn t (object/get @t "entity"))) (fn x (!= @x ""))) (fn x (let ((en644 @x)) (object/get @config.entityNames @en644 @en644))))
                                  (if (= @config.recordForm "") [] (array/flatten (array/map (object/values @entity.expected) (fn v (if (str/startsWith @v "enum:") [(str/slice @v 5 (str/len @v))] (str/split @v "."))))))))))
                                (pls (array/sort (array/unique (array/flatten (array/map @entity.traits (fn t (array/concat (object/values (object/get @t "listenTypes")) (object/values (object/get @t "emitTypes")) (if (= (object/get @t "configType") "") [] [(object/get @t "configType")])))))))))
          (let ((entLines (let ((tpl (object/get @config.modelImports "entity" ""))) (if (or (= @tpl "") (= (array/len @ents) 0)) [] (if @config.modelImportEach (array/map @ents (fn nm (let ((v645 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f646p (str/split @tpl "{{"))) (str/concat (default (array/first @f646p) "") (str/join (array/map (array/drop @f646p 1) (fn f646q (let ((f646r (str/split @f646q "}}"))) (if (< (array/len @f646r) 2) (str/concat "{{" @f646q) (str/concat (object/get @v645 (default (array/first @f646r) "") (str/concat "{{" (default (array/first @f646r) "") "}}")) (str/join (array/drop @f646r 1) "}}")))))) "")))))) [(let ((v647 : SrcVars (object/fromEntries [["names" (str/join @ents @config.modelImportSep)]]))) (let ((f648p (str/split @tpl "{{"))) (str/concat (default (array/first @f648p) "") (str/join (array/map (array/drop @f648p 1) (fn f648q (let ((f648r (str/split @f648q "}}"))) (if (< (array/len @f648r) 2) (str/concat "{{" @f648q) (str/concat (object/get @v647 (default (array/first @f648r) "") (str/concat "{{" (default (array/first @f648r) "") "}}")) (str/join (array/drop @f648r 1) "}}")))))) ""))))]))))
                (plLines (let ((tpl (object/get @config.modelImports "payload" ""))) (if (or (= @tpl "") (= (array/len @pls) 0)) [] (if @config.modelImportEach (array/map @pls (fn nm (let ((v649 : SrcVars (object/fromEntries [["name" @nm]]))) (let ((f650p (str/split @tpl "{{"))) (str/concat (default (array/first @f650p) "") (str/join (array/map (array/drop @f650p 1) (fn f650q (let ((f650r (str/split @f650q "}}"))) (if (< (array/len @f650r) 2) (str/concat "{{" @f650q) (str/concat (object/get @v649 (default (array/first @f650r) "") (str/concat "{{" (default (array/first @f650r) "") "}}")) (str/join (array/drop @f650r 1) "}}")))))) "")))))) [(let ((v651 : SrcVars (object/fromEntries [["names" (str/join @pls @config.modelImportSep)]]))) (let ((f652p (str/split @tpl "{{"))) (str/concat (default (array/first @f652p) "") (str/join (array/map (array/drop @f652p 1) (fn f652q (let ((f652r (str/split @f652q "}}"))) (if (< (array/len @f652r) 2) (str/concat "{{" @f652q) (str/concat (object/get @v651 (default (array/first @f652r) "") (str/concat "{{" (default (array/first @f652r) "") "}}")) (str/join (array/drop @f652r 1) "}}")))))) ""))))])))))
