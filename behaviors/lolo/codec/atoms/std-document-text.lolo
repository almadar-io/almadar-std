app std-document-text [
  version: "1.0.0",
  exec: ["pdftotext", "pdftoppm", "tesseract"],
  fs: { cwd: "**": [read], "~/.almadar/ocr/**": [read, write, create, remove], "~/.almadar/ocr": [read, create] },
  description: "std-document-text — the one owner for turning a file into text by pages, composing std-pdf-text, std-ocr and the file read. DOC_TEXT_READ { key, path } chooses by the path's extension, compared case-insensitively against three declared lists: a path in pdfExtensions is read by pdftotext through std-pdf-text and answers DOC_TEXT with method pdftotext, and when the PDF carries no text layer it is read by OCR through std-ocr and answers method ocr; a path in imageExtensions is read by OCR and answers method ocr; a path in textExtensions is read as UTF-8 text and answers one page with method text. DOC_TEXT { key, pages, method } numbers the pages from 1 in document order, nothing truncated. DOC_TEXT_FAILED { key, error, code } answers doc_unsupported (the extension is in no list), doc_not_text (a text file that is not valid UTF-8), doc_unreadable (a text file that could not be read), doc_no_text (OCR found no text on any page) and doc_busy (a read while another is in flight); a failure of the composed readers passes through with its own pdf_unreadable, pdf_command_failed, ocr_unreadable, ocr_command_failed or ocr_unsupported code. The pdftotext, pdftoppm and tesseract exec grants and the OCR work directory grant are this atom's own; the path is opened by the child or by the host relative to the working directory, so the composer decides which files it can name and may narrow the cwd read grant."
]
;; @capabilities "turn a PDF, a scanned PDF, an image or a text file into text, page by page, with OCR as the fallback for pages without a text layer"
uses Spec from "almadar-std/document-text"
uses Pdf from "std/behaviors/std-pdf-text"
uses Ocr from "std/behaviors/std-ocr"
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"

type DocPage = { page : number!, text : string! }
type DocPageFile = { page : number!, name : string!, path : string! }
type DocImageType = { ext : string!, mediaType : string! }

orbital DocumentTextOrbital {
  entity DocRead [runtime] {
    id : string!
    key : string @description "The caller's name for the read in flight; blank when idle." = ""
    path : string @description "The file being read." = ""
    mediaType : string @description "The media type of the image being transcribed by the model." = ""
    pagePaths : [DocPageFile] @description "The rendered page images of a scanned PDF read by the model, in page order." = []
    rendered : boolean @description "The vision read is of a scanned PDF rendered to page images, which must be released at the end." = false
    cursor : number @description "Index of the page the model is transcribing." = 0
    pages : [DocPage] @description "The pages the model has transcribed so far." = []
    failed : boolean @description "The vision read has failed; the rendered pages are released, then the failure is answered." = false
    error : string @description "The failure message of the vision read." = ""
    code : string @description "The failure code of the vision read." = ""
  }

  trait PdfCli = Pdf.traits.PdfCli {
    listens {
      PdfText.PDF_EXEC -> CLI_RUN
    }
  }

  trait PdfText = Pdf.traits.PdfText {
    listens {
      DocumentText.DOC_PDF_REQUEST -> PDF_READ
      PdfCli.CLI_DONE -> PDF_RAN
      PdfCli.CLI_FAILED -> PDF_CLI_FAILED
      PDF_READ {
        key : string!
        path : string!
      }
      PDF_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
      PDF_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
    }
  }

  trait OcrRenderCli = Ocr.traits.OcrRenderCli {
    listens {
      OcrReader.OCR_RENDER_EXEC -> CLI_RUN
    }
  }

  trait OcrCli = Ocr.traits.OcrCli {
    listens {
      OcrReader.OCR_EXEC -> CLI_RUN
    }
  }

  trait OcrReader = Ocr.traits.OcrReader {
    listens {
      DocumentText.DOC_OCR_REQUEST -> OCR_READ
      OcrRenderCli.CLI_DONE -> OCR_RENDER_RAN
      OcrRenderCli.CLI_FAILED -> OCR_RENDER_CLI_FAILED
      OcrCli.CLI_DONE -> OCR_RAN
      OcrCli.CLI_FAILED -> OCR_CLI_FAILED
      OCR_READ {
        key : string!
        path : string!
      }
      OCR_RENDER_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
      OCR_RENDER_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
      OCR_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
      OCR_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
    }
  }

  trait PageRenderCli = Ocr.traits.OcrRenderCli {
    listens {
      PageRenderer.OCR_RENDER_EXEC -> CLI_RUN
    }
  }

  trait PageRenderer = Ocr.traits.OcrReader {
    config {
      mode: "render"
      workDir: "~/.almadar/ocr"
    }
    listens {
      DocumentText.DOC_RENDER_REQUEST -> OCR_READ
      DocumentText.DOC_RENDER_RELEASE -> OCR_RELEASE
      PageRenderCli.CLI_DONE -> OCR_RENDER_RAN
      PageRenderCli.CLI_FAILED -> OCR_RENDER_CLI_FAILED
      OCR_READ {
        key : string!
        path : string!
      }
      OCR_RELEASE {
        key : string!
      }
      OCR_RENDER_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
      OCR_RENDER_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
    }
  }

  trait VisionLlm = Llm.traits.LlmClient {
    listens {
      DocumentText.LLM_GENERATE -> LLM_GENERATE
      VisionRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      VisionRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      VisionRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      VisionHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait VisionRequest = Req.traits.HttpRequest {
    listens {
      VisionRequestDelay.ELAPSED -> RETRY_ELAPSED
      VisionRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      VisionLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      VisionLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      VisionHttp.HTTP_REPLIED -> HTTP_REPLIED
      VisionHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait VisionRequestDelay = Req.traits.RequestDelay {
    listens {
      VisionRequest.RETRY_WAIT -> START
      VisionRequest.RETRY_STOP -> CANCEL
    }
  }

  trait VisionRequestDeadline = Req.traits.RequestDeadline {
    listens {
      VisionRequest.TIMEOUT_START -> START
      VisionRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait VisionHttpFrame = Frame.traits.HttpFrame {
    listens {
      VisionHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait VisionHttp = Http.traits.HttpClient {
    listens {
      VisionRequest.HTTP_SEND -> HTTP_SEND
      VisionRequest.HTTP_CANCEL -> HTTP_CANCEL
      VisionHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      VisionHttpFrame.FRAME_DRAINED -> HC_DRAINED
      VisionHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait DocumentText -> DocRead [optimistic] {
    initial: ready

    config {
      pdfExtensions : [string] = [".pdf"]
        @label "PDF extensions"
        @description "Path extensions, lower case with the dot, read as PDF documents: pdftotext first, OCR when the PDF has no text layer. Compared case-insensitively against the end of the path."
        @synonyms "document extensions, pdf files"
        @tier "domain"
      imageExtensions : [string] = [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp", ".webp"]
        @label "Image extensions"
        @description "Path extensions, lower case with the dot, read as one image page by OCR. Compared case-insensitively against the end of the path."
        @synonyms "picture extensions, photo, scan"
        @tier "domain"
      workDir : string = "~/.almadar/ocr"
        @label "Work directory"
        @description "The directory the vision reader reads the rendered page images from: it must equal the PageRenderer work directory, which std-ocr writes them to, and the composing program's fs grant must cover it."
        @synonyms "scratch directory, temp directory"
        @tier "policy"
      reader : "ocr" | "vision" = "ocr"
        @label "Reader"
        @description "How an image, and a PDF with no text layer, is turned into text: ocr recognizes it by tesseract through std-ocr; vision sends each image, or each rendered PDF page in order, to the composed std-llm model with the visionPrompt and answers method vision. A PDF with a text layer is always read by pdftotext and a text file as text."
        @synonyms "ocr or vision, model transcription"
        @tier "domain"
      visionPrompt : string = "Transcribe all the text in the image exactly as written, in its original language. Output only the text."
        @label "Vision prompt"
        @description "The user prompt sent with each image when the reader is vision."
        @synonyms "transcription prompt"
        @tier "domain"
      imageMediaTypes : [DocImageType] = [{ ext: ".png", mediaType: "image/png" }, { ext: ".jpg", mediaType: "image/jpeg" }, { ext: ".jpeg", mediaType: "image/jpeg" }, { ext: ".webp", mediaType: "image/webp" }, { ext: ".tif", mediaType: "image/tiff" }, { ext: ".tiff", mediaType: "image/tiff" }]
        @label "Image media types"
        @description "The declared media type sent to the model for each image extension (lower case with the dot, compared case-insensitively against the end of the path) when the reader is vision. An image extension with no entry fails doc_unsupported; nothing is guessed."
        @synonyms "mime types, image formats"
        @tier "domain"
      textExtensions : [string] = [".txt", ".eml", ".md", ".csv"]
        @label "Text extensions"
        @description "Path extensions, lower case with the dot, read as UTF-8 text and answered as one page. Compared case-insensitively against the end of the path."
        @synonyms "plain text extensions, mail, markdown"
        @tier "domain"
    }

    state ready {
      INIT -> ready
        (set @entity.key "")
      DOC_TEXT_READ -> pdf when (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))
        (set @entity.key @payload.key)
        (set @entity.path @payload.path)
        (emit DOC_PDF_REQUEST { key: @payload.key, path: @payload.path })
      DOC_TEXT_READ -> ocr when (and (== @config.reader "ocr") (not (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (array/some @config.imageExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e)))))
        (set @entity.key @payload.key)
        (set @entity.path @payload.path)
        (emit DOC_OCR_REQUEST { key: @payload.key, path: @payload.path })
      DOC_TEXT_READ -> visionOpen when (and (== @config.reader "vision") (not (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (array/some @config.imageExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e)))) (!= (array/find @config.imageMediaTypes (fn m (str/endsWith (str/lower @payload.path) (str/lower @m.ext)))) null))
        (set @entity.key @payload.key)
        (set @entity.path @payload.path)
        (set @entity.mediaType (default (object/get (array/find @config.imageMediaTypes (fn m (str/endsWith (str/lower @payload.path) (str/lower @m.ext)))) mediaType "") ""))
        (set @entity.pagePaths [])
        (set @entity.rendered false)
        (set @entity.cursor 0)
        (set @entity.pages [])
        (set @entity.failed false)
        (set @entity.error "")
        (set @entity.code "")
        (os/read-file { anchor: "cwd", path: @payload.path } { key: "image", emit: { success: DOC_FILE_READ, failure: DOC_FILE_FAILED } })
      DOC_TEXT_READ -> ready when (and (== @config.reader "vision") (not (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (array/some @config.imageExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e)))) (== (array/find @config.imageMediaTypes (fn m (str/endsWith (str/lower @payload.path) (str/lower @m.ext)))) null))
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "the image extension has no declared media type", code: "doc_unsupported" })
      DOC_TEXT_READ -> reading when (and (not (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (not (array/some @config.imageExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (array/some @config.textExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e)))))
        (set @entity.key @payload.key)
        (set @entity.path @payload.path)
        (os/read-file { anchor: "cwd", path: @payload.path } { key: "text", emit: { success: DOC_FILE_READ, failure: DOC_FILE_FAILED } })
      DOC_TEXT_READ -> ready when (and (not (array/some @config.pdfExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (not (array/some @config.imageExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))) (not (array/some @config.textExtensions (fn e (str/endsWith (str/lower @payload.path) (str/lower @e))))))
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "the file extension is in none of the pdf, image or text lists", code: "doc_unsupported" })
    }

    state pdf {
      INIT -> pdf
      DOC_TEXT_READ -> pdf
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_PDF_TEXT -> ready
        (emit DOC_TEXT { key: @entity.key, pages: @payload.pages, method: "pdftotext" })
        (set @entity.key "")
      DOC_PDF_NO_TEXT -> ocr when (== @config.reader "ocr")
        (emit DOC_OCR_REQUEST { key: @entity.key, path: @entity.path })
      DOC_PDF_NO_TEXT -> rendering when (== @config.reader "vision")
        (set @entity.pagePaths [])
        (set @entity.rendered true)
        (set @entity.mediaType "")
        (set @entity.cursor 0)
        (set @entity.pages [])
        (set @entity.failed false)
        (set @entity.error "")
        (set @entity.code "")
        (emit DOC_RENDER_REQUEST { key: @entity.key, path: @entity.path })
      DOC_PDF_FAILED -> ready
        (emit DOC_TEXT_FAILED { key: @entity.key, error: @payload.error, code: @payload.code })
        (set @entity.key "")
    }

    state ocr {
      INIT -> ocr
      DOC_TEXT_READ -> ocr
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_OCR_TEXT -> ready
        (emit DOC_TEXT { key: @entity.key, pages: @payload.pages, method: "ocr" })
        (set @entity.key "")
      DOC_OCR_NO_TEXT -> ready
        (emit DOC_TEXT_FAILED { key: @entity.key, error: "OCR found no text on any of the pages", code: "doc_no_text" })
        (set @entity.key "")
      DOC_OCR_FAILED -> ready
        (emit DOC_TEXT_FAILED { key: @entity.key, error: @payload.error, code: @payload.code })
        (set @entity.key "")
    }

    state rendering {
      INIT -> rendering
      DOC_TEXT_READ -> rendering
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_RENDER_PAGES -> visionOpen
        (set @entity.pagePaths @payload.pages)
        (set @entity.mediaType "image/png")
        (set @entity.cursor 0)
        (os/read-file (str/concat @config.workDir "/" (default (array/first (array/map @payload.pages (fn pf @pf.name))) "")) { key: "page", emit: { success: DOC_FILE_READ, failure: DOC_FILE_FAILED } })
      DOC_RENDER_FAILED -> ready
        (emit DOC_TEXT_FAILED { key: @entity.key, error: @payload.error, code: @payload.code })
        (set @entity.key "")
    }

    state visionOpen {
      INIT -> visionOpen
      DOC_TEXT_READ -> visionOpen
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_FILE_READ -> describing
        (emit LLM_GENERATE { userPrompt: @config.visionPrompt, temperature: 0, maxTokens: 0, images: [{ mediaType: @entity.mediaType, data: (bytes/to-base64 @payload.data) }] })
      DOC_FILE_FAILED -> releasing when @entity.rendered
        (set @entity.failed true)
        (set @entity.error (str/concat "a page image could not be read: " (default @payload.error "unknown")))
        (set @entity.code "doc_unreadable")
        (emit DOC_RENDER_RELEASE { key: @entity.key })
      DOC_FILE_FAILED -> ready when (not @entity.rendered)
        (emit DOC_TEXT_FAILED { key: @entity.key, error: (str/concat "the file could not be read: " (default @payload.error "unknown")), code: "doc_unreadable" })
        (set @entity.key "")
    }

    state describing {
      INIT -> describing
      DOC_TEXT_READ -> describing
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_VISION_TEXT -> ready when (not @entity.rendered)
        (emit DOC_TEXT { key: @entity.key, pages: [{ page: 1, text: @payload.content }], method: "vision" })
        (set @entity.key "")
      DOC_VISION_TEXT -> visionOpen when (and @entity.rendered (< (+ @entity.cursor 1) (array/len @entity.pagePaths)))
        (os/read-file (str/concat @config.workDir "/" (default (array/nth (array/map @entity.pagePaths (fn pf @pf.name)) (+ @entity.cursor 1)) "")) { key: "page", emit: { success: DOC_FILE_READ, failure: DOC_FILE_FAILED } })
        (set @entity.pages (array/append @entity.pages { page: (+ @entity.cursor 1), text: @payload.content }))
        (set @entity.cursor (+ @entity.cursor 1))
      DOC_VISION_TEXT -> releasing when (and @entity.rendered (>= (+ @entity.cursor 1) (array/len @entity.pagePaths)))
        (set @entity.pages (array/append @entity.pages { page: (+ @entity.cursor 1), text: @payload.content }))
        (emit DOC_RENDER_RELEASE { key: @entity.key })
      DOC_VISION_FAILED -> releasing when @entity.rendered
        (set @entity.failed true)
        (set @entity.error @payload.message)
        (set @entity.code "doc_vision_failed")
        (emit DOC_RENDER_RELEASE { key: @entity.key })
      DOC_VISION_FAILED -> ready when (not @entity.rendered)
        (emit DOC_TEXT_FAILED { key: @entity.key, error: @payload.message, code: "doc_vision_failed" })
        (set @entity.key "")
    }

    state releasing {
      INIT -> releasing
      DOC_TEXT_READ -> releasing
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_RENDER_RELEASED -> ready when @entity.failed
        (emit DOC_TEXT_FAILED { key: @entity.key, error: @entity.error, code: @entity.code })
        (set @entity.key "")
      DOC_RENDER_RELEASED -> ready when (not @entity.failed)
        (emit DOC_TEXT { key: @entity.key, pages: @entity.pages, method: "vision" })
        (set @entity.key "")
    }

    state reading {
      INIT -> reading
      DOC_TEXT_READ -> reading
        (emit DOC_TEXT_FAILED { key: @payload.key, error: "another document is being read", code: "doc_busy" })
      DOC_FILE_READ -> ready when (== (bytes/to-string @payload.data) null)
        (emit DOC_TEXT_FAILED { key: @entity.key, error: "the file is not valid UTF-8 text", code: "doc_not_text" })
        (set @entity.key "")
      DOC_FILE_READ -> ready when (!= (bytes/to-string @payload.data) null)
        (emit DOC_TEXT { key: @entity.key, pages: [{ page: 1, text: (default (bytes/to-string @payload.data) "") }], method: "text" })
        (set @entity.key "")
      DOC_FILE_FAILED -> ready
        (emit DOC_TEXT_FAILED { key: @entity.key, error: (str/concat "the file could not be read: " (default @payload.error "unknown")), code: "doc_unreadable" })
        (set @entity.key "")
    }

    emits {
      DOC_TEXT -> external {
        key : string!
        pages : [DocPage]!
        method : string!
      }
        @description "The file was read: one entry per page, numbered from 1 in document order, and the method that produced the text: text (a plain text file), pdftotext (the PDF's text layer) or ocr (recognized from page images)."
        @synonyms "document pages, extracted text, file text"
        @tier "domain"
      DOC_TEXT_FAILED -> external {
        key : string!
        error : string!
        code : string!
      }
        @description "The read failed: doc_unsupported, doc_not_text, doc_unreadable, doc_no_text, doc_busy, or the pdf_* / ocr_* code of the composed reader that failed."
        @synonyms "document error, unreadable file"
        @tier "domain"
      DOC_PDF_REQUEST -> external {
        key : string!
        path : string!
      }
        @description "The PDF read, handed to std-pdf-text."
        @tier "internal"
      DOC_OCR_REQUEST -> external {
        key : string!
        path : string!
      }
        @description "The OCR read, handed to std-ocr."
        @tier "internal"
      DOC_RENDER_REQUEST -> external {
        key : string!
        path : string!
      }
        @description "The page rendering of a scanned PDF for the vision reader, handed to std-ocr in render mode."
        @tier "internal"
      DOC_RENDER_RELEASE -> external {
        key : string!
      }
        @description "The rendered page images are no longer needed; std-ocr removes them."
        @tier "internal"
      LLM_GENERATE -> external {
        userPrompt : string!
        temperature : number
        maxTokens : number
        images : [{ mediaType : string!, data : string! }]
      }
        @description "One transcription call to std-llm: the vision prompt with one image, temperature 0 and no token cap."
        @tier "internal"
    }

    listens {
      DOC_TEXT_READ -> input {
        key : string!
        path : string!
      }
        @description "Read the text of the file at path, page by page, choosing the reader by the path's extension; key names the read in the answer."
        @synonyms "read document, file to text, extract text, ocr or pdf text"
      PdfText.PDF_TEXT -> DOC_PDF_TEXT
      PdfText.PDF_NO_TEXT -> DOC_PDF_NO_TEXT
      PdfText.PDF_FAILED -> DOC_PDF_FAILED
      OcrReader.OCR_TEXT -> DOC_OCR_TEXT
      OcrReader.OCR_NO_TEXT -> DOC_OCR_NO_TEXT
      OcrReader.OCR_FAILED -> DOC_OCR_FAILED
      PageRenderer.OCR_PAGES -> DOC_RENDER_PAGES
      PageRenderer.OCR_RELEASED -> DOC_RENDER_RELEASED
      PageRenderer.OCR_FAILED -> DOC_RENDER_FAILED
      VisionLlm.LLM_GENERATE_RESULT -> DOC_VISION_TEXT
      VisionLlm.LLM_FAILED -> DOC_VISION_FAILED
      DOC_PDF_TEXT {
        key : string!
        pages : [DocPage]!
      }
        @description "std-pdf-text's PDF_TEXT."
      DOC_PDF_NO_TEXT {
        key : string!
        pageCount : number!
      }
        @description "std-pdf-text's PDF_NO_TEXT."
      DOC_PDF_FAILED {
        key : string!
        error : string!
        code : string!
      }
        @description "std-pdf-text's PDF_FAILED."
      DOC_OCR_TEXT {
        key : string!
        pages : [DocPage]!
      }
        @description "std-ocr's OCR_TEXT."
      DOC_OCR_NO_TEXT {
        key : string!
        pageCount : number!
      }
        @description "std-ocr's OCR_NO_TEXT."
      DOC_OCR_FAILED {
        key : string!
        error : string!
        code : string!
      }
        @description "std-ocr's OCR_FAILED."
      DOC_RENDER_PAGES {
        key : string!
        pages : [DocPageFile]!
      }
        @description "std-ocr's OCR_PAGES in render mode."
      DOC_RENDER_RELEASED {
        key : string!
      }
        @description "std-ocr's OCR_RELEASED."
      DOC_RENDER_FAILED {
        key : string!
        error : string!
        code : string!
      }
        @description "std-ocr's OCR_FAILED in render mode."
      DOC_VISION_TEXT {
        content : string!
        usage : { promptTokens : number!, completionTokens : number!, totalTokens : number! }!
      }
        @description "std-llm's LLM_GENERATE_RESULT: the model's transcription of one image."
      DOC_VISION_FAILED {
        code : string
        message : string!
        key : string
      }
        @description "std-llm's LLM_FAILED."
      DOC_FILE_READ {
        data : bytes!
        key : string
      }
        @description "The os/read-file answer for a text file."
      DOC_FILE_FAILED {
        error : string
        kind : string
        key : string
      }
        @description "The os/read-file failure."
    }
  }

  page boot as DocumentTextOrbitalStart -> DocumentText, PdfText, PdfCli, OcrReader, OcrRenderCli, OcrCli, PageRenderer, PageRenderCli, VisionLlm, VisionRequest, VisionRequestDelay, VisionRequestDeadline, VisionHttpFrame, VisionHttp
}
