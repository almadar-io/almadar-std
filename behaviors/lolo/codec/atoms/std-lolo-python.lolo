app std-lolo-python [
  version: "2.0.0",
  description: "std-lolo-python \u{2014} renders .lolo source as Python text, so a learner who reads an exercise written in .lolo can see the same program as Python that runs and gives the kernel's answers. It is std-lolo-source with the Python vocabulary in config and nothing else: LOLO_TO_PYTHON { source } answers PYTHON_RENDERED { text, warnings }, or PYTHON_RENDER_FAILED { error } when the source cannot be read. Each trait becomes a class holding state, entity, ports and config, with one on_<event> method per event: an if/elif branch per transition (the from-state and the guard), the effects, then the new state; an emit records (event, payload) in self.emitted with the payload built as the shell's generated payload type. The entity and payload types are imported from orbital_app.generated.entities and orbital_app.generated.events, the modules the Python shell generates. Kernel answers that are null (a division by zero, nth past the end, a missing key) come from small helper functions written once, and only the ones the output uses. An operator with no Python template is a named warning and a stub that raises when run. persist, fetch, notify, navigate and call-service are called on the injected ports object and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-python"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloPythonOrbital {
  entity LoloPythonRun [runtime] {
    id : string!
  }

  trait LoloPython = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_PYTHON
      SOURCE_RENDERED: PYTHON_RENDERED
      SOURCE_RENDER_FAILED: PYTHON_RENDER_FAILED
    }
    config {
      language: "Python"
      requiresTypes: false
      operators: { "/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "str/len": "len({{0}})", "str/upper": "{{0}}.upper()", "str/lower": "{{0}}.lower()", "str/trim": "{{0}}.strip()", "str/trimStart": "{{0}}.lstrip()", "str/trimEnd": "{{0}}.rstrip()", "str/capitalize": "{{0}}.capitalize()", "str/split": "_split({{0}}, {{1}})", "str/join": "_join({{0}}, {{1}})", "str/concat": "\"\".join(_text(v_) for v_ in [{{*}}])", "str/includes": "({{1}} in {{0}})", "str/startsWith": "{{0}}.startswith({{1}})", "str/endsWith": "{{0}}.endswith({{1}})", "str/replace": "{{0}}.replace({{1}}, {{2}}, 1)", "str/replaceAll": "{{0}}.replace({{1}}, {{2}})", "str/repeat": "({{0}} * {{1}})", "str/reverse": "{{0}}[::-1]", "str/slice#2": "_str_slice({{0}}, {{1}})", "str/slice#3": "_str_slice({{0}}, {{1}}, {{2}})", "str/padStart#2": "_pad_start({{0}}, {{1}})", "str/padStart#3": "_pad_start({{0}}, {{1}}, {{2}})", "str/padEnd#2": "_pad_end({{0}}, {{1}})", "str/padEnd#3": "_pad_end({{0}}, {{1}}, {{2}})", "str/truncate#2": "_truncate({{0}}, {{1}})", "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})", "str/to-int": "_to_int({{0}})", "array/len": "len({{0}})", "array/sum#2": "_sum({{0}}, {{1}})", "array/avg#1": "_avg({{0}})", "array/avg#2": "_avg({{0}}, {{1}})", "array/max#1": "_amax({{0}})", "array/max#2": "_amax({{0}}, {{1}})", "array/min#1": "_amin({{0}})", "array/min#2": "_amin({{0}}, {{1}})", "array/first": "_first({{0}})", "array/last": "_last({{0}})", "array/nth": "_nth({{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}})", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice({{0}}, {{1}})", "array/slice#3": "_slice({{0}}, {{1}}, {{2}})", "array/take": "_take({{0}}, {{1}})", "array/drop": "_drop({{0}}, {{1}})", "array/takeLast": "_take_last({{0}}, {{1}})", "array/dropLast": "_drop_last({{0}}, {{1}})", "array/append": "({{0}} + [{{1}}])", "array/prepend": "([{{1}}] + {{0}})", "array/includes": "({{1}} in {{0}})", "array/indexOf": "_index_of({{0}}, {{1}})", "array/reverse": "list(reversed({{0}}))", "array/unique": "_unique({{0}})", "array/flatten": "[y_ for x_ in {{0}} for y_ in x_]", "array/zip": "[list(p_) for p_ in zip({{0}}, {{1}})]", "array/sort#1": "_sort({{0}})", "array/sort#2": "_sort({{0}}, {{1}})", "array/sort#3": "_sort({{0}}, {{1}}, {{2}})", "array/reduce": "functools.reduce({{2}}, {{0}}, {{1}})", "list": "[{{*}}]", "object/get#2": "_get({{0}}, {{1}})", "object/get#3": "_get({{0}}, {{1}}, {{2}})", "object/has": "_has({{0}}, {{1}})", "object/set": "_set({{0}}, {{1}}, {{2}})", "object/keys": "list({{0}}.keys())", "object/values": "list({{0}}.values())", "object/entries": "[[k_, v_] for k_, v_ in {{0}}.items()]", "object/fromEntries": "{p_[0]: p_[1] for p_ in {{0}}}", "object/merge#2": "{**{{0}}, **{{1}}}", "object/pick": "_pick({{0}}, {{1}})", "object/omit": "_omit({{0}}, {{1}})", "json/parse": "_json_parse({{0}})", "json/stringify#1": "_json_dumps({{0}})", "math/abs": "abs({{0}})", "math/max": "max({{*}})", "math/min": "min({{*}})", "math/round#1": "_round({{0}})", "math/round#2": "_round({{0}}, {{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "_sign({{0}})", "math/clamp": "_clamp({{0}}, {{1}}, {{2}})", "default": "_default({{0}}, {{1}})", "as": "{{0}}", "validate/required": "_required({{0}})", "validate/string": "isinstance({{0}}, str)", "validate/number": "_is_number({{0}})", "validate/array": "isinstance({{0}}, list)", "validate/object": "isinstance({{0}}, dict)", "validate/boolean": "isinstance({{0}}, bool)", "validate/length": "(len({{0}}) == {{1}})", "validate/minLength": "(len({{0}}) >= {{1}})", "validate/maxLength": "(len({{0}}) <= {{1}})", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "({{1}} <= {{0}} <= {{2}})", "validate/oneOf": "({{0}} in {{1}})", "validate/equals": "({{0}} == {{1}})", "array/cosine": "_cos({{0}}, {{1}})", "array/nearest": "_ne