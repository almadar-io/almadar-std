 out.append(x)\n    return out"], "array/sort": ["def _sort(a, k=None, o='asc'): return sorted(a, key=None if k is None else (lambda x: x[k]), reverse=(o == 'desc'))"], "object/get": ["def _get(o, p, d=None):\n    for s in p.replace(chr(92) + '.', chr(0)).split('.'):\n        s = s.replace(chr(0), '.')\n        if isinstance(o, dict) and s in o: o = o[s]\n        elif isinstance(o, list) and s.isdigit() and int(s) < len(o): o = o[int(s)]\n        else: return d\n    return o"], "object/has": ["def _has(o, p):\n    for s in p.replace(chr(92) + '.', chr(0)).split('.'):\n        s = s.replace(chr(0), '.')\n        if isinstance(o, dict) and s in o: o = o[s]\n        elif isinstance(o, list) and s.isdigit() and int(s) < len(o): o = o[int(s)]\n        else: return False\n    return True"], "object/set": ["def _set(o, p, v):\n    out = dict(o)\n    cur = out\n    parts = [s.replace(chr(0), '.') for s in p.replace(chr(92) + '.', chr(0)).split('.')]\n    for s in parts[:-1]:\n        cur[s] = dict(cur[s]) if isinstance(cur.get(s), dict) else {}\n        cur = cur[s]\n    cur[parts[-1]] = v\n    return out"], "object/pick": ["def _pick(o, ks): return {k: o[k] for k in ks if k in o}"], "object/omit": ["def _omit(o, ks): return {k: v for k, v in o.items() if k not in ks}"], "json/parse": ["def _json_parse(t):\n    try: return json.loads(t)\n    except ValueError: return None"], "json/stringify": ["def _json_dumps(v):\n    def n(x):\n        if isinstance(x, float) and x - x == 0 and x == int(x): return int(x)\n        if isinstance(x, list): return [n(y) for y in x]\n        if isinstance(x, dict): return {k: n(y) for k, y in x.items()}\n        return x\n    return json.dumps(n(v), separators=(',', ':'), ensure_ascii=False)", "def _jsnum(n):\n    if n != n: return 'NaN'\n    if n in (math.inf, -math.inf): return 'Infinity' if n > 0 else '-Infinity'\n    if n == 0: return '0'\n    t = decimal.Decimal(repr(abs(float(n)))).as_tuple()\n    d = ''.join(map(str, t.digits))\n    p = len(d) + t.exponent\n    d = d.rstrip('0')\n    k = len(d)\n    if k <= p <= 21: b = d + '0' * (p - k)\n    elif 0 < p <= 21: b = d[:p] + '.' + d[p:]\n    elif -6 < p <= 0: b = '0.' + '0' * -p + d\n    else:\n        e = p - 1\n        e = '+' + str(e) if e >= 0 else str(e)\n        b = d + 'e' + e if k == 1 else d[0] + '.' + d[1:] + 'e' + e\n    return ('-' if n < 0 else '') + b", "def _jsjson(v):\n    if v is None: return 'null'\n    if isinstance(v, bool): return 'true' if v else 'false'\n    if isinstance(v, (int, float)): return _jsnum(v) if v - v == 0 else 'null'\n    if isinstance(v, str): return json.dumps(v, ensure_ascii=False)\n    if isinstance(v, list): return '[' + ','.join(_jsjson(x) for x in v) + ']'\n    return '{' + ','.join(json.dumps(k, ensure_ascii=False) + ':' + _jsjson(x) for k, x in v.items()) + '}'", "def _json_dumps2(v, o):\n    if not isinstance(o, dict): raise TypeError('options must be a record')\n    f = []\n    for k in ('pretty', 'sorted'):\n        x = o.get(k)\n        if x is not None and not isinstance(x, bool): raise TypeError('options.' + k + ' must be a boolean')\n        f.append(bool(x))\n    pretty, srt = f\n    def w(x, ind):\n        if isinstance(x, list):\n            if not x: return '[]'\n            if not pretty: return '[' + ','.join(w(y, ind) for y in x) + ']'\n            pad = '  ' * (ind + 1)\n            return '[\\n' + ',\\n'.join(pad + w(y, ind + 1) for y in x) + '\\n' + '  ' * ind + ']'\n        if isinstance(x, dict):\n            if not x: return '{}'\n            ks = sorted(x) if srt else list(x)\n            if not pretty: return '{' + ','.join(json.dumps(k, ensure_ascii=False) + ':' + w(x[k], ind) for k in ks) + '}'\n            pad = '  ' * (ind + 1)\n            return '{\\n' + ',\\n'.join(pad + json.dumps(k, ensure_ascii=False) + ': ' + w(x[k], ind + 1) for k in ks) + '\\n' + '  ' * ind + '}'\n        return _jsjson(x)\n    return w(v, 0)"], "math/round": ["def _round(x, d=0):\n    m = 10 ** d\n    