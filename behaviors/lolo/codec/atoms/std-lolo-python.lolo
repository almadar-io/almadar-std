M_PIO2_1T\n        y1 = (z - y0) + 2.0 * _LIBM_PIO2_1T\n        return -2, y0, y1\n    if ix <= 0x401c463b:\n        if ix <= 0x4015fdbc:\n            if ix == 0x4012d97c: return _libm_rem_pio2_medium(x, ix)\n            if sign == 0:\n                z = x - 3.0 * _LIBM_PIO2_1\n                y0 = z - 3.0 * _LIBM_PIO2_1T\n                y1 = (z - y0) - 3.0 * _LIBM_PIO2_1T\n                return 3, y0, y1\n            z = x + 3.0 * _LIBM_PIO2_1\n            y0 = z + 3.0 * _LIBM_PIO2_1T\n            y1 = (z - y0) + 3.0 * _LIBM_PIO2_1T\n            return -3, y0, y1\n        if ix == 0x401921fb: return _libm_rem_pio2_medium(x, ix)\n        if sign == 0:\n            z = x - 4.0 * _LIBM_PIO2_1\n            y0 = z - 4.0 * _LIBM_PIO2_1T\n            y1 = (z - y0) - 4.0 * _LIBM_PIO2_1T\n            return 4, y0, y1\n        z = x + 4.0 * _LIBM_PIO2_1\n        y0 = z + 4.0 * _LIBM_PIO2_1T\n        y1 = (z - y0) + 4.0 * _LIBM_PIO2_1T\n        return -4, y0, y1\n    if ix < 0x413921fb: return _libm_rem_pio2_medium(x, ix)\n    if ix >= 0x7ff00000:\n        y0 = x - x\n        return 0, y0, y0\n    ui = _libm_bits(x)\n    ui &= 0x000FFFFFFFFFFFFF\n    ui |= (0x3ff + 23) << 52\n    z = _libm_from(ui)\n    tx = [0.0, 0.0, 0.0]\n    for i in range(2):\n        tx[i] = float(int(z))\n        z = (z - tx[i]) * _LIBM_X1P24\n    tx[2] = z\n    i = 2\n    while i != 0 and tx[i] == 0.0: i -= 1\n    n, y0, y1 = _libm_rem_pio2_large(tx[:i + 1], (ix >> 20) - (0x3ff + 23))\n    if sign != 0: return -n, -y0, -y1\n    return n, y0, y1", "def _libm_sin(x):\n    x = float(x)\n    ix = (_libm_bits(x) >> 32) & 0x7fffffff\n    if ix <= 0x3fe921fb:\n        if ix < 0x3e500000: return x\n        return _libm_k_sin(x, 0.0, 0)\n    if ix >= 0x7ff00000: return x - x\n    n, y0, y1 = _libm_rem_pio2(x)\n    m = n & 3\n    if m == 0: return _libm_k_sin(y0, y1, 1)\n    if m == 1: return _libm_k_cos(y0, y1)\n    if m == 2: return -_libm_k_sin(y0, y1, 1)\n    return -_libm_k_cos(y0, y1)", "def _libm_cos(x):\n    x = float(x)\n    ix = (_libm_bits(x) >> 32) & 0x7fffffff\n    if ix <= 0x3fe921fb:\n        if ix < 0x3e46a09e: return 1.0\n        return _libm_k_cos(x, 0.0)\n    if ix >= 0x7ff00000: return x - x\n    n, y0, y1 = _libm_rem_pio2(x)\n    m = n & 3\n    if m == 0: return _libm_k_cos(y0, y1)\n    if m == 1: return -_libm_k_sin(y0, y1, 1)\n    if m == 2: return -_libm_k_cos(y0, y1)\n    return _libm_k_sin(y0, y1, 1)"], "vec/clamp-length": ["def _vec(v): return v['x'], v['y'], v.get('z', 0.0), 'z' in v", "def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _vclamp_length(a, m):\n    x, y, z, w = _vec(a)\n    n = math.sqrt(x * x + y * y + z * z)\n    if n > m and n != 0.0:\n        k = m / n\n        return _mk(x * k, y * k, z * k, w)\n    return _mk(x, y, z, w)"], "geo/aabb-overlap": ["def _aabb_overlap(a, b): return a['x'] < b['x'] + b['w'] and a['x'] + a['w'] > b['x'] and a['y'] < b['y'] + b['h'] and a['y'] + a['h'] > b['y']"], "geo/circle-overlap": ["def _circle_overlap(a, b):\n    dx = a['x'] - b['x']\n    dy = a['y'] - b['y']\n    return math.sqrt(dx * dx + dy * dy) <= a['r'] + b['r']"], "geo/rect-circle-overlap": ["def _clampf(v, lo, hi):\n    if lo > hi or lo != lo or hi != hi: raise ValueError('clamp: min is greater than max')\n    return lo if v < lo else hi if v > hi else v", "def _rect_circle_overlap(r, c):\n    nx = _clampf(c['x'], r['x'], r['x'] + r['w'])\n    ny = _clampf(c['y'], r['y'], r['y'] + r['h'])\n    dx = c['x'] - nx\n    dy = c['y'] - ny\n    return dx * dx + dy * dy <= c['r'] * c['r']"], "geo/point-in-rect": ["def _point_in_rect(p, r): return p['x'] >= r['x'] and p['x'] <= r['x'] + r['w'] and p['y'] >= r['y'] and p['y'] <= r['y'] + r['h']"], "geo/point-in-circle": ["def _point_in_circle(p, c):\n    dx = p['x'] - c['x']\n    dy = p['y'] - c['y']\n    return dx * dx + dy * dy <= c['r'] * c['r']"], "geo/reflect": ["def _vec(v): return v['x'], v['y'], v.get('z', 0.0), 'z' in v", "def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _reflect(v, n):\n    x, y, z, w = _vec(v)\n    p, q, r, _ = _vec(n)\n    d = x * p + y * q + z * r\n    return _mk(x - 2.0 * d * p, y - 2.0 * d * q, z - 2.0 * d * r, w)"], "geo/segment-intersect": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _segment_intersect(a, b):\n    x1, y1, x2, y2 = a['x1'], a['y1'], a['x2'], a['y2']\n    x3, y3, x4, y4 = b['x1'], b['y1'], b['x2'], b['y2']\n    den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)\n    if den == 0.0: return None\n    t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / den\n    u = ((x1 - x3) * (y1 - y2) - (y1 - y3) * (x1 - x2)) / den\n    if 0.0 <= t <= 1.0 and 0.0 <= u <= 1.0: return _mk(x1 + t * (x2 - x1), y1 + t * (y2 - y1), 0.0, False)\n    return None"], "grid/to-world": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _grid_to_world(c, s): return _mk((c['x'] + 0.5) * s, (c['y'] + 0.5) * s, 0.0, False)"], "grid/from-world": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _ffloor(x): return float(math.floor(x)) if x - x == 0 else x", "def _grid_from_world(p, s):\n    if s == 0.0: raise ValueError('grid/from-world: cellSize must not be 0')\n    return _mk(_ffloor(p['x'] / s), _ffloor(p['y'] / s), 0.0, False)"], "grid/iso-to-screen": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _iso_to_screen(c, w, h): return _mk((c['x'] - c['y']) * w / 2.0, (c['x'] + c['y']) * h / 2.0, 0.0, False)"], "grid/screen-to-iso": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _screen_to_iso(p, w, h):\n    hw = w / 2.0\n    hh = h / 2.0\n    if hw == 0.0 or hh == 0.0: raise ValueError('grid/screen-to-iso: tileW and tileH must not be 0')\n    return _mk((p['x'] / hw + p['y'] / hh) / 2.0, (p['y'] / hh - p['x'] / hw) / 2.0, 0.0, False)"], "grid/manhattan-distance": ["def _manhattan(a, b): return abs(a['x'] - b['x']) + abs(a['y'] - b['y'])"], "grid/neighbors": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _neighbors(c, diag=False):\n    x, y = c['x'], c['y']\n    out = [_mk(x, y - 1.0, 0.0, False), _mk(x + 1.0, y, 0.0, False), _mk(x, y + 1.0, 0.0, False), _mk(x - 1.0, y, 0.0, False)]\n    if diag: out += [_mk(x + 1.0, y - 1.0, 0.0, False), _mk(x + 1.0, y + 1.0, 0.0, False), _mk(x - 1.0, y + 1.0, 0.0, False), _mk(x - 1.0, y - 1.0, 0.0, False)]\n    return out"], "grid/cells-in-radius": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _ffloor(x): return float(math.floor(x)) if x - x == 0 else x", "def _toi(x):\n    if x != x: return 0\n    if x in (math.inf, -math.inf): return 2 ** 63 - 1 if x > 0 else -2 ** 63\n    return max(min(int(x), 2 ** 63 - 1), -2 ** 63)", "def _cells_in_radius(c, r):\n    ri = _toi(_ffloor(r))\n    r2 = r * r\n    out = []\n    for dy in range(-ri, ri + 1):\n        for dx in range(-ri, ri + 1):\n            if float(dx) * float(dx) + float(dy) * float(dy) <= r2: out.append(_mk(c['x'] + float(dx), c['y'] + float(dy), 0.0, False))\n    return out"], "grid/line": ["def _mk(x, y, z, w): return {'x': x, 'y': y, 'z': z} if w else {'x': x, 'y': y}", "def _grid_line(a, b):\n    for v in (a['x'], a['y'], b['x'], b['y']):\n        if v - v != 0 or v != int(v): raise ValueError('grid/line: not a whole number')\n    x0, y0, x1, y1 = int(a['x']), int(a['y']), int(b['x']), int(b['y'])\n    dx = abs(x1 - x0)\n    dy = -abs(y1 - y0)\n    sx = 1 if x0 < x1 else -1\n    sy = 1 if y0 < y1 else -1\n    err = dx + dy\n    out = []\n    while True:\n        out.append(_mk(float(x0), float(y0), 0.0, False))\n        if x0 == x1 and y0 == y1: break\n        e2 = 2 * err\n        if e2 >= dy:\n            err += dy\n            x0 += sx\n        if e2 <= dx:\n            err += dx\n            y0 += sy\n    return out"], "grid/in-bounds": ["def _in_bounds(c, w, h): return c['x'] >= 0.0 and c['x'] < w and c['y'] >= 0.0 and c['y'] < h"], "ease/apply": ["def _bounce(t):\n    n1 = 7.5625\n    d1 = 2.75\n    if t < 1.0 / d1: return n1 * t * t\n    if t < 2.0 / d1:\n        t2 = t - 1.5 / d1\n        return n1 * t2 * t2 + 0.75\n    if t < 2.5 / d1:\n        t2 = t - 2.25 / d1\n        return n1 * t2 * t2 + 0.9375\n    t2 = t - 2.625 / d1\n    return n1 * t2 * t2 + 0.984375", "def _ease(curve, t):\n    t = 0.0 if t < 0.0 else 1.0 if t > 1.0 else t\n    if curve == 'in-quad': return t * t\n    if curve == 'out-quad': return t * (2.0 - t)\n    if curve == 'in-out-quad': return 2.0 * t * t if t < 0.5 else -1.0 + (4.0 - 2.0 * t) * t\n    if curve == 'in-cubic': return t * t * t\n    if curve == 'out-cubic':\n        f = t - 1.0\n        return f * f * f + 1.0\n    if curve == 'in-out-cubic':\n        if t < 0.5: return 4.0 * t * t * t\n        f = 2.0 * t - 2.0\n        return 0.5 * f * f * f + 1.0\n    if curve == 'elastic-out':\n        if t == 0.0 or t == 1.0: return t\n        p = 0.3\n        s = p / 4.0\n        return _libm_pow(2.0, -10.0 * t) * _libm_sin((t - s) * (2.0 * math.pi) / p) + 1.0\n    if curve == 'bounce-out': return _bounce(t)\n    return t", "_LIBM_M64 = 0xFFFFFFFFFFFFFFFF\n_LIBM_X1P1023 = float.fromhex('0x1p1023')\n_LIBM_X1PM1022 = float.fromhex('0x1p-1022')\n_LIBM_X1P53 = float.fromhex('0x1p53')\ndef _libm_bits(x): return struct.unpack('<Q', struct.pack('<d', x))[0]\ndef _libm_from(u): return struct.unpack('<d', struct.pack('<Q', u & _LIBM_M64))[0]\ndef _libm_set_hi(x, hi): return _libm_from((_libm_bits(x) & 0xFFFFFFFF) | ((hi & 0xFFFFFFFF) << 32))\ndef _libm_set_lo(x, lo): return _libm_from((_libm_bits(x) & 0xFFFFFFFF00000000) | (lo & 0xFFFFFFFF))\ndef _libm_i32(v):\n    v &= 0xFFFFFFFF\n    return v - 0x100000000 if v >= 0x80000000 else v\ndef _libm_div(a, b):\n    if b == 0.0:\n        if a == 0.0 or a != a: return math.nan\n        return math.copysign(math.inf, a) * math.copysign(1.0, b)\n    return a / b\ndef _libm_sqrt(x): return math.nan if x < 0.0 else math.sqrt(x)\ndef _libm_floor(x):\n    ix = _libm_bits(x)\n    e = ((ix >> 52) & 0x7FF) - 1023\n    if e >= 52: return x\n    if e >= 0:\n        m = 0x000FFFFFFFFFFFFF >> e\n        if ix & m == 0: return x\n        if ix >> 63: ix += m\n        return _libm_from(ix & ~m)\n    if ix >> 63 == 0: return 0.0\n    if (ix << 1) & _LIBM_M64 != 0: return -1.0\n    return x\ndef _libm_scalbn(x, n):\n    if n > 1023:\n        x *= _LIBM_X1P1023\n        n -= 1023\n        if n > 1023:\n            x *= _LIBM_X1P1023\n            n -= 1023\n            if n > 1023: n = 1023\n    elif n < -1022:\n        mul = _LIBM_X1PM1022 * _LIBM_X1P53\n        x *= mul\n        n += 969\n        if n < -1022:\n            x *= mul\n            n += 969\n            if n < -1022: n = -1022\n    return x * _libm_from((1023 + n) << 52)", "_LIBM_BP = (1.0, 1.5)\n_LIBM_DP_H = (0.0, 5.84962487220764160156e-01)\n_LIBM_DP_L = (0.0, 1.35003920212974897128e-08)\n_LIBM_TWO53 = 9007199254740992.0\n_LIBM_HUGE = 1.0e300\n_LIBM_TINY = 1.0e-300\n_LIBM_L1 = 5.99999999999994648725e-01\n_LIBM_L2 = 4.28571428578550184252e-01\n_LIBM_L3 = 3.33333329818377432918e-01\n_LIBM_L4 = 2.72728123808534006489e-01\n_LIBM_L5 = 2.30660745775561754067e-01\n_LIBM_L6 = 2.06975017800338417784e-01\n_LIBM_P1 = 1.66666666666666019037e-01\n_LIBM_P2 = -2.77777777770155933842e-03\n_LIBM_P3 = 6.61375632143793436117e-05\n_LIBM_P4 = -1.65339022054652515390e-06\n_LIBM_P5 = 4.13813679705723846039e-08\n_LIBM_PLG2 = 6.93147180559945286227e-01\n_LIBM_PLG2_H = 6.93147182464599609375e-01\n_LIBM_PLG2_L = -1.90465429995776804525e-09\n_LIBM_OVT = 8.0085662595372944372e-017\n_LIBM_CP = 9.61796693925975554329e-01\n_LIBM_CP_H = 9.61796700954437255859e-01\n_LIBM_CP_L = -7.02846165095275826516e-09\n_LIBM_IVLN2 = 1.44269504088896338700e+00\n_LIBM_IVLN2_H = 1.44269502162933349609e+00\n_LIBM_IVLN2_L = 1.92596299112661746887e-08\ndef _libm_pow(x, y):\n    x = float(x)\n    y = float(y)\n  