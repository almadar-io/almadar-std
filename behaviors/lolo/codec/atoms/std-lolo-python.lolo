\n    return dot / (math.sqrt(na) * math.sqrt(nb))", "def _nearest(q, cs):\n    if not cs: return None\n    sc = []\n    for c in cs:\n        if not isinstance(c, list): raise TypeError('expected array')\n        s = _cos(q, c)\n        if s is None: return None\n        sc.append(s)\n    bi = 0\n    for i in range(1, len(sc)):\n        if sc[i] > sc[bi]: bi = i\n    second = -math.inf\n    for i, s in enumerate(sc):\n        if i != bi and s > second: second = s\n    return {'index': bi, 'score': sc[bi], 'margin': 0.0 if len(sc) == 1 else sc[bi] - second}"], "array/insert": ["def _insert(a, i, x):\n    if i != int(i) or i < 0: raise ValueError('insert: index is not a whole number from 0')\n    if i > len(a): raise ValueError('insert: index is past the end')\n    return a[:int(i)] + [x] + a[int(i):]"], "array/remove": ["def _remove(a, i):\n    if i != int(i) or i < 0: raise ValueError('remove: index is not a whole number from 0')\n    if i >= len(a): raise ValueError('remove: index is outside the array')\n    return a[:int(i)] + a[int(i) + 1:]"], "array/removeItem": ["def _remove_item(a, x):\n    out = list(a)\n    if x in out: out.remove(x)\n    return out"], "array/groupBy": ["def _call(f, *a): return f(*a[:f.__code__.co_argcount])", "def _jsnum(n):\n    if n != n: return 'NaN'\n    if n in (math.inf, -math.inf): return 'Infinity' if n > 0 else '-Infinity'\n    if n == 0: return '0'\n    t = decimal.Decimal(repr(abs(float(n)))).as_tuple()\n    d = ''.join(map(str, t.digits))\n    p = len(d) + t.exponent\n    d = d.rstrip('0')\n    k = len(d)\n    if k <= p <= 21: b = d + '0' * (p - k)\n    elif 0 < p <= 21: b = d[:p] + '.' + d[p:]\n    elif -6 < p <= 0: b = '0.' + '0' * -p + d\n    else:\n        e = p - 1\n        e = '+' + str(e) if e >= 0 else str(e)\n        b = d + 'e' + e if k == 1 else d[0] + '.' + d[1:] + 'e' + e\n    return ('-' if n < 0 else '') + b", "def _jsjson(v):\n    if v is None: return 'null'\n    if isinstance(v, bool): return 'true' if v else 