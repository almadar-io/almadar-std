else (int(''.join(ch[i:j])), j)\n    low, i = num(at + 1)\n    if low is None or low > 1000: return None\n    if i < n and ch[i] == ',':\n        high, j = num(i + 1)\n        i += 1\n        if high is not None:\n            if high > 1000 or high < low: return None\n            i = j\n    if i >= n or ch[i] != '}': return None\n    return ''.join(ch[at:i + 1]), i + 1", "def _rx_translate(p):\n    ch = list(p)\n    n = len(ch)\n    out = []\n    i = 0\n    depth = 0\n    q = False\n    while i < n:\n        c = ch[i]\n        if c == '(':\n            if i + 1 < n and ch[i + 1] == '?':\n                if i + 2 >= n or ch[i + 2] != ':': return None\n                out.append('(?:')\n                i += 3\n            else:\n                out.append('(')\n                i += 1\n            depth += 1\n            q = False\n        elif c == ')':\n            if depth == 0: return None\n            depth -= 1\n            out.append(')')\n            i += 1\n            q = True\n        elif c in '|^$':\n            out.append({'|': '|', '^': r'\\A', '$': r'\\Z'}[c])\n            i += 1\n            q = False\n        elif c in '*+?{':\n            if not q: return None\n            if c == '{':\n                r = _rx_braces(ch, i)\n                if r is None: return None\n                out.append(r[0])\n                i = r[1]\n            else:\n                out.append(c)\n                i += 1\n            if i < n and ch[i] == '?':\n                out.append('?')\n                i += 1\n            q = False\n        elif c in '}]': return None\n        elif c == '.':\n            out.append(r'[^\\n\\r\\u2028\\u2029]')\n            i += 1\n            q = True\n        elif c == '[':\n            r = _rx_class(ch, i + 1)\n            if r is None: return None\n            out.append(r[0])\n            i = r[1]\n            q = True\n        elif c == '\\\\':\n            if i + 1 >= n: return None\n            e = ch[i + 1]\n            if e == 'b': out.append(r'(?a:\\b)')\n            elif e == 'B': out.append(r'(?a:\\B)')\n            elif e == 'd': out.append('[0-9]')\n            elif e == 'D': out.append('[^0-9]')\n            elif e == 'w': out.append('[0-9A-Za-z_]')\n            elif e == 'W': out.append('[^0-9A-Za-z_]')\n            elif e == 's': out.append('[' + _RX_SPACE + ']')\n            elif e == 'S': out.append('[^' + _RX_SPACE + ']')\n            elif e in 'pP':\n                end = _rx_prop_end(ch, i + 1)\n                if end is None: return None\n                out.append('[' + _rx_ranges(''.join(ch[i + 3:end - 1]), e == 'P') + ']')\n                i = end\n                q = True\n                continue\n            elif e == 'x' or e == 'u':\n                w = 2 if e == 'x' else 4\n                v = _rx_hex(ch, i + 2, w)\n                if v is None or (e == 'u' and 0xD800 <= v <= 0xDFFF): return None\n                out.append('\\\\U%08x' % v)\n                i += 2 + w\n                q = True\n                continue\n            elif e in '\\\\^$.*+?()[]{}|/': out.append(re.escape(e))\n            elif e in 'nrtfv': out.append('\\\\' + e)\n            else: return None\n            i += 2\n            q = e not in 'bB'\n        else:\n            out.append(re.escape(c))\n            i += 1\n            q = True\n    return ''.join(out) if depth == 0 else None", "def _rx(p):\n    if p not in _RX_CACHE:\n        t = _rx_translate(p)\n        try: _RX_CACHE[p] = None if t is None else re.compile(t)\n        except re.error: _RX_CACHE[p] = None\n    return _RX_CACHE[p]", "def _rx_test(t, p):\n    r = _rx(p)\n    return r is not None and r.search(t) is not None", "def _replace_pattern(t, p, r):\n    rx = _rx(p)\n    if rx is None: return None\n    out = []\n    copied = 0\n    at = 0\n    while at <= len(t):\n        m = rx.search(t, at)\n        if m is None: break\n        out.append(t[copied:m.start()])\n        out.append(r)\n        copied = m.end()\n        a