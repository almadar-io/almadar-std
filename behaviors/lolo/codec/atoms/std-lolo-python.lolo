02d' % mo), ('DD', '%02d' % d), ('HH', '%02d' % h), ('mm', '%02d' % mi), ('ss', '%02d' % s), ('M', str(mo)), ('D', str(d)), ('H', str(h)), ('m', str(mi)), ('s', str(s))]\n    out = []\n    i = 0\n    while i < len(fmt):\n        for t, v in toks:\n            if fmt.startswith(t, i):\n                if shape == 'date' and t in ('HH', 'mm', 'ss', 'H', 'm', 's'): _tm_needs('time/format')\n                out.append(v)\n                i += len(t)\n                break\n        else:\n            out.append(fmt[i])\n            i += 1\n    return ''.join(out)"], "time/month": ["_TM_UNITS = {'ms': 'ms', 'millisecond': 'ms', 'milliseconds': 'ms', 's': 's', 'second': 's', 'seconds': 's', 'm': 'm', 'minute': 'm', 'minutes': 'm', 'h': 'h', 'hour': 'h', 'hours': 'h', 'd': 'd', 'day': 'd', 'days': 'd', 'w': 'w', 'week': 'w', 'weeks': 'w', 'month': 'month', 'months': 'month', 'quarter': 'quarter', 'quarters': 'quarter', 'year': 'year', 'years': 'year'}", "_TM_FIXED = {'ms': 1.0, 's': 1000.0, 'm': 60000.0, 'h': 3600000.0, 'd': 86400000.0, 'w': 604800000.0}", "def _tm_unit(u):\n    if u not in _TM_UNITS: raise TypeError('time unit expected: ' + u)\n    return _TM_UNITS[u]", "def _tm_leap(y): return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0", "def _tm_dim(y, m):\n    if m in (1, 3, 5, 7, 8, 10, 12): return 31\n    if m in (4, 6, 9, 11): return 30\n    if m == 2: return 29 if _tm_leap(y) else 28\n    return 30", "def _tm_ymd(days):\n    z = days + 719468\n    era = z // 146097\n    doe = z % 146097\n    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365\n    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)\n    mp = (5 * doy + 2) // 153\n    d = doy - (153 * mp + 2) // 5 + 1\n    m = mp + 3 if mp < 10 else mp - 9\n    return yoe + era * 400 + (1 if m <= 2 else 0), m, d", "def _tm_date(ts):\n    return _tm_ymd(int(math.floor(ts / 86400000.0)))", "def _tm_stamp(y, m, d):\n    yy = y - (1 if m <= 2 else 0)\n    era = yy // 400\n    yoe = yy % 400\n    mp = (m + 9) %