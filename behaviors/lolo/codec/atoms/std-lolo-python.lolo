if isinstance(v, list): return '[' + ','.join(_jsjson(x) for x in v) + ']'\n    return '{' + ','.join(json.dumps(k, ensure_ascii=False) + ':' + _jsjson(x) for k, x in v.items()) + '}'", "def _tostr(v):\n    if isinstance(v, str): return v\n    return _jsjson(v) if isinstance(v, (list, dict)) else _jsjson(v)", "def _template(t, o):\n    if not isinstance(o, dict): raise TypeError('expected object')\n    out = []\n    rest = t\n    while True:\n        i = rest.find('{{')\n        if i < 0: break\n        out.append(rest[:i])\n        after = rest[i + 2:]\n        j = after.find('}}')\n        if j >= 0 and after[:j] in o:\n            out.append(_tostr(o[after[:j]]))\n            rest = after[j + 2:]\n        else:\n            out.append('{')\n            rest = rest[i + 1:]\n    out.append(rest)\n    return ''.join(out)"], "str/to-number": ["def _radix(d, w):\n    ok = {1: '01', 3: '01234567', 4: '0123456789abcdefABCDEF'}[w]\n    if d == '' or not all(c in ok for c in d): return math.nan\n    try: return float(int(d, {1: 2, 3: 8, 4: 16}[w]))\n    except OverflowError: return math.inf", "def _to_number(s):\n    t = s.strip('\\t\\n\\x0b\\x0c\\r \\xa0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff')\n    if t == '': return 0.0\n    for p, w in (('0x', 4), ('0X', 4), ('0b', 1), ('0B', 1), ('0o', 3), ('0O', 3)):\n        if t.startswith(p):\n            r = _radix(t[2:], w)\n            return None if r != r else r\n    sign = 1.0\n    u = t\n    if t[0] == '-':\n        sign = -1.0\n        u = t[1:]\n    elif t[0] == '+': u = t[1:]\n    if u == 'Infinity': return sign * math.inf\n    if not u or not (u[0] in '0123456789.') or not all(c in '0123456789.eE+-' for c in u) or not any(c in '0123456789' for c in u): return None\n    try: return sign * float(u)\n    except ValueError: return None"], "str/decode-uri-component": ["def _uri_decode(s):\n    out = []\n    pend = bytearray()\n    i = 0\n