ear": ["_TM_UNITS = {'ms': 'ms', 'millisecond': 'ms', 'milliseconds': 'ms', 's': 's', 'second': 's', 'seconds': 's', 'm': 'm', 'minute': 'm', 'minutes': 'm', 'h': 'h', 'hour': 'h', 'hours': 'h', 'd': 'd', 'day': 'd', 'days': 'd', 'w': 'w', 'week': 'w', 'weeks': 'w', 'month': 'month', 'months': 'month', 'quarter': 'quarter', 'quarters': 'quarter', 'year': 'year', 'years': 'year'}", "_TM_FIXED = {'ms': 1.0, 's': 1000.0, 'm': 60000.0, 'h': 3600000.0, 'd': 86400000.0, 'w': 604800000.0}", "def _tm_unit(u):\n    if u not in _TM_UNITS: raise TypeError('time unit expected: ' + u)\n    return _TM_UNITS[u]", "def _tm_leap(y): return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0", "def _tm_dim(y, m):\n    if m in (1, 3, 5, 7, 8, 10, 12): return 31\n    if m in (4, 6, 9, 11): return 30\n    if m == 2: return 29 if _tm_leap(y) else 28\n    return 30", "def _tm_ymd(days):\n    z = days + 719468\n    era = z // 146097\n    doe = z % 146097\n    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365\n    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)\n    mp = (5 * doy + 2) // 153\n    d = doy - (153 * mp + 2) // 5 + 1\n    m = mp + 3 if mp < 10 else mp - 9\n    return yoe + era * 400 + (1 if m <= 2 else 0), m, d", "def _tm_date(ts):\n    return _tm_ymd(int(math.floor(ts / 86400000.0)))", "def _tm_stamp(y, m, d):\n    yy = y - (1 if m <= 2 else 0)\n    era = yy // 400\n    yoe = yy % 400\n    mp = (m + 9) % 12\n    doy = (153 * mp + 2) // 5 + d - 1\n    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy\n    return float((era * 146097 + doe - 719468)) * 86400000.0", "def _tm_parse(t):\n    n = len(t)\n    def num(frm, ln):\n        s = t[frm:frm + ln]\n        return int(s) if len(s) == ln and all(c in '0123456789' for c in s) else None\n    if t[4:5] != '-' or t[7:8] != '-': return None\n    y, mo, d = num(0, 4), num(5, 2), num(8, 2)\n    if y is None or mo is None or d is None or not 1 <= mo <= 12 or not 1 <= d <= _tm_dim(y, mo): return None\n    ms = int(_tm_stamp(y, mo, d))\n    if n == 10: return ms, 'date'\n    if t[10:11] != 'T' or t[13:14] != ':': return None\n    h, mi = num(11, 2), num(14, 2)\n    if h is None or mi is None or h > 23 or mi > 59: return None\n    ms += h * 3600000 + mi * 60000\n    at = 16\n    if t[at:at + 1] == ':':\n        s = num(at + 1, 2)\n        if s is None or s > 59: return None\n        ms += s * 1000\n        at += 3\n        if t[at:at + 1] == '.':\n            st = at + 1\n            en = st\n            while en < n and t[en] in '0123456789': en += 1\n            if en == st: return None\n            ms += int((t[st:en] + '000')[:3])\n            at = en\n    z = t[at:]\n    if z == 'Z': return ms, 'datetime'\n    if len(z) == 6 and z[0] in '+-' and z[3] == ':':\n        oh, om = num(at + 1, 2), num(at + 4, 2)\n        if oh is None or om is None or oh > 23 or om > 59: return None\n        off = (oh * 60 + om) * 60000\n        return (ms + off if z[0] == '-' else ms - off), 'datetime'\n    return None", "def _tm_moment(v):\n    if not isinstance(v, str): raise TypeError('expected date or datetime (ISO-8601 text)')\n    r = _tm_parse(v)\n    if r is None: raise TypeError('expected date or datetime (ISO-8601 text): ' + v)\n    return float(r[0]), r[1]", "def _tm_utc(ms):\n    if ms - ms != 0: raise ValueError('time: outside the years 0000 to 9999')\n    f = int(math.floor(ms))\n    days = f // 86400000\n    rem = f - days * 86400000\n    y, m, d = _tm_ymd(days)\n    if not 0 <= y <= 9999: raise ValueError('time: outside the years 0000 to 9999')\n    return y, m, d, rem // 3600000, rem // 60000 % 60, rem // 1000 % 60, rem % 1000", "def _tm_render(ms, shape):\n    y, m, d, h, mi, s, f = _tm_utc(ms)\n    if shape == 'date': return '%04d-%02d-%02d' % (y, m, d)\n    return '%04d-%02d-%02dT%02d:%02d:%02d.%03dZ' % (y, m, d, h, mi, s, f)", "def _tm_needs(op): raise ValueError(op + ' needs a time of day and a date carries none: pass a datetime')", "def _tm_below(u): return u in ('ms', 's', 'm', 'h')", "def