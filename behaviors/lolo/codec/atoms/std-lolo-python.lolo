anges(''.join(ch[at + 3:end - 1]), e == 'P'), end)\n    if e == '-': return ('c', 45, at + 2)\n    if e in '\\\\^$.*+?()[]{}|/': return ('c', ord(e), at + 2)\n    if e in 'nrtfv': return ('c', ord({'n': '\\n', 'r': '\\r', 't': '\\t', 'f': '\\x0c', 'v': '\\x0b'}[e]), at + 2)\n    if e == 'x':\n        v = _rx_hex(ch, at + 2, 2)\n        return None if v is None else ('c', v, at + 4)\n    if e == 'u':\n        v = _rx_hex(ch, at + 2, 4)\n        return None if v is None or 0xD800 <= v <= 0xDFFF else ('c', v, at + 6)\n    return None", "def _rx_class(ch, start):\n    i = start\n    out = ['[']\n    if i < len(ch) and ch[i] == '^':\n        out.append('^')\n        i += 1\n    if i < len(ch) and ch[i] == ']': return None\n    while i < len(ch):\n        if ch[i] == ']':\n            out.append(']')\n            return ''.join(out), i + 1\n        a = _rx_atom(ch, i)\n        if a is None: return None\n        kind, val, i = a\n        rng = i < len(ch) and ch[i] == '-' and (i + 1 >= len(ch) or ch[i + 1] != ']')\n        if kind == 's':\n            if rng: return None\n            out.append(val)\n        else:\n            out.append('\\\\U%08x' % val)\n            if rng:\n                b = _rx_atom(ch, i + 1)\n                if b is None or b[0] != 'c' or val > b[1]: return None\n                out.append('-\\\\U%08x' % b[1])\n                i = b[2]\n    return None", "def _rx_braces(ch, at):\n    n = len(ch)\n    def num(i):\n        j = i\n        while j < n and ch[j] in '0123456789': j += 1\n        return (None, i) if j == i else (int(''.join(ch[i:j])), j)\n    low, i = num(at + 1)\n    if low is None or low > 1000: return None\n    if i < n and ch[i] == ',':\n        high, j = num(i + 1)\n        i += 1\n        if high is not None:\n            if high > 1000 or high < low: return None\n            i = j\n    if i >= n or ch[i] != '}': return None\n    return ''.join(ch[at:i + 1]), i + 1", "def _rx_translate(p):\n    ch = list(p)\n    n = len(ch)\n    out = []\n    i = 0\n    depth = 0\n    q = False\n    while i < n:\n        c = ch[i]\n        if c == '(':\n            if i + 1 < n and ch[i + 1] == '?':\n                if i + 2 >= n or ch[i + 2] != ':': return None\n                out.append('(?:')\n                i += 3\n            else:\n                out.append('(')\n                i += 1\n            depth += 1\n            q = False\n        elif c == ')':\n            if depth == 0: return None\n            depth -= 1\n            out.append(')')\n            i += 1\n            q = True\n        elif c in '|^$':\n            out.append({'|': '|', '^': r'\\A', '$': r'\\Z'}[c])\n            i += 1\n            q = False\n        elif c in '*+?{':\n            if not q: return None\n            if c == '{':\n                r = _rx_braces(ch, i)\n                if r is None: return None\n                out.append(r[0])\n                i = r[1]\n            else:\n                out.append(c)\n                i += 1\n            if i < n and ch[i] == '?':\n                out.append('?')\n                i += 1\n            q = False\n        elif c in '}]': return None\n        elif c == '.':\n            out.append(r'[^\\n\\r\\u2028\\u2029]')\n            i += 1\n            q = True\n        elif c == '[':\n            r = _rx_class(ch, i + 1)\n            if r is None: return None\n            out.append(r[0])\n            i = r[1]\n            q = True\n        elif c == '\\\\':\n            if i + 1 >= n: return None\n            e = ch[i + 1]\n            if e == 'b': out.append(r'(?a:\\b)')\n            elif e == 'B': out.append(r'(?a:\\B)')\n            elif e == 'd': out.append('[0-9]')\n            elif e == 'D': out.append('[^0-9]')\n            elif e == 'w': out.append('[0-9A-Za-z_]')\n            elif e == 'W': out.append('[^0-9A-Za-z_]')\n            elif e == 's': out.append('[' + _RX_SPACE + ']')\n            elif e == 'S': out.append('[^' + _RX_SPACE + ']')\n            elif e in 'pP':\n                end = _rx_prop_end(ch, i + 1)\n                if end is None: return None\n                out.append('[' + _rx_ranges(''.join(ch[i + 3:end - 1]), e == 'P') + ']')\n                i = end\n                q = True\n                continue\n            elif e == 'x' or e == 'u':\n                w = 2 if e == 'x' else 4\n                v = _rx_hex(ch, i + 2, w)\n                if v is None or (e == 'u' and 0xD800 <= v <= 0xDFFF): return None\n                out.append('\\\\U%08x' % v)\n                i += 2 + w\n                q = True\n                continue\n            elif e in '\\\\^$.*+?()[]{}|/': out.append(re.escape(e))\n            elif e in 'nrtfv': out.append('\\\\' + e)\n            else: return None\n            i += 2\n            q = e not in 'bB'\n        else:\n            out.append(re.escape(c))\n            i += 1\n            q = True\n    return ''.join(out) if depth == 0 else None", "def _rx(p):\n    if p not in _RX_CACHE:\n        t = _rx_translate(p)\n        try: _RX_CACHE[p] = None if t is None else re.compile(t)\n        except re.error: _RX_CACHE[p] = None\n    return _RX_CACHE[p]", "def _rx_test(t, p):\n    r = _rx(p)\n    return r is not None and r.search(t) is not None", "def _find_pattern(t, p, frm=0):\n    rx = _rx(p)\n    if rx is None: return None\n    at = int(frm) if frm == frm and frm not in (math.inf, -math.inf) and frm > 0 else 0\n    out = []\n    if at > len(t): return out\n    while at <= len(t):\n        m = rx.search(t, at)\n        if m is None: break\n        out.append({'start': m.start(), 'end': m.end(), 'text': m.group(0)})\n        at = m.end() + 1 if m.end() == m.start() else m.end()\n    return out"], "str/uri-component-valid": ["def _uri_decode(s):\n    out = []\n    pend = bytearray()\n    i = 0\n    while i < len(s):\n        if s[i] == '%':\n            h = s[i + 1:i + 3]\n            if len(h) != 2 or not all(c in '0123456789abcdefABCDEF' for c in h): return None\n            pend.append(int(h, 16))\n            i += 3\n        else:\n            try: out.append(pend.decode('utf-8'))\n            except UnicodeDecodeError: return None\n            pend = bytearray()\n            out.append(s[i])\n            i += 1\n    try: out.append(pend.decode('utf-8'))\n    except UnicodeDecodeError: return None\n    return ''.join(out)"], "time/add": ["_TM_UNITS = {'ms': 'ms', 'millisecond': 'ms', 'milliseconds': 'ms', 's': 's', 'second': 's', 'seconds': 's', 'm': 'm', 'minute': 'm', 'minutes': 'm', 'h': 'h', 'hour': 'h', 'hours': 'h', 'd': 'd', 'day': 'd', 'days': 'd', 'w': 'w', 'week': 'w', 'weeks': 'w', 'month': 'month', 'months': 'month', 'quarter': 'quarter', 'quarters': 'quarter', 'year': 'year', 'years': 'year'}", "_TM_FIXED = {'ms': 1.0, 's': 1000.0, 'm': 60000.0, 'h': 3600000.0, 'd': 86400000.0, 'w': 604800000.0}", "def _tm_unit(u):\n    if u not in _TM_UNITS: raise TypeError('time unit expected: ' + u)\n    return _TM_UNITS[u]", "def _tm_leap(y): return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0", "def _tm_dim(y, m):\n    if m in (1, 3, 5, 7, 8, 10, 12): return 31\n    if m in (4, 6, 9, 11): return 30\n    if m == 2: return 29 if _tm_leap(y) else 28\n    return 30", "def _tm_ymd(days):\n    z = days + 719468\n    era = z // 146097\n    doe = z % 146097\n    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365\n    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)\n    mp = (5 * doy + 2) // 153\n    d = doy - (153 * mp + 2) // 5 + 1\n    m = mp + 3 if mp < 10 else mp - 9\n    return yoe + era * 400 + (1 if m <= 2 else 0), m, d", "def _tm_date(ts):\n    return _tm_ymd(int(math.floor(ts / 86400000.0)))", "def _tm_stamp(y, m, d):\n    yy = y - (1 if m <= 2 else 0)\n    era = yy // 400\n    yoe = yy % 400\n    mp = (m + 9) % 12\n    doy = (153 * mp + 2) // 5 + d - 1\n    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy\n    return float((era * 146097 + doe - 719468)) * 86400000.0", "def _tm_parse(t):\n    n = len(t)\n    def num(frm, ln):\n        s = t[frm:frm + ln]\n        return int(s) if len(s) == ln and all(c in '0123456789' for c in s) else None\n    if t[4:5] != '-' or t[7:8] != '-': return None\n    y, mo, d = num(0, 4), num(5, 2), num(8, 2)\n    if y is None or mo is None or d is None or not 1 <= mo <= 12 or not 1 <= d <= _tm_dim(y, mo): return None\n    ms = int(_tm_stamp(y, mo, d))\n    if n == 10: return ms, 'date'\n    if t[10:11] != 'T' or t[13:14] != ':': return None\n    h, mi = num(11, 2), num(14, 2)\n    if h is None or mi is None or h > 23 or mi > 59: return None\n    ms += h * 3600000 + mi * 60000\n    at = 16\n    if t[at:at + 1] == ':':\n        s = num(at + 1, 2)\n        if s is None or s > 59: return None\n        ms += s * 1000\n        at += 3\n        if t[at:at + 1] == '.':\n            st = at + 1\n            en = st\n            while en < n and t[en] in '0123456789': en += 1\n            if en == st: return None\n            ms += int((t[st:en] + '000')[:3])\n            at = en\n    z = t[at:]\n    if z == 'Z': return ms, 'datetime'\n    if len(z) == 6 and z[0] in '+-' and z[3] == ':':\n        oh, om = num(at + 1, 2), num(at + 4, 2)\n        if oh is None or om is None or oh > 23 or om > 59: return None\n        off = (oh * 60 + om) * 60000\n        return (ms + off if z[0] == '-' else ms - off), 'datetime'\n    return None", "def _tm_moment(v):\n    if not isinstance(v, str): raise TypeError('expected date or datetime (ISO-8601 text)')\n    r = _tm_parse(v)\n    if r is None: raise TypeError('expected date or datetime (ISO-8601 text): ' + v)\n    return float(r[0]), r[1]", "def _tm_utc(ms):\n    if ms - ms != 0: raise ValueError('time: outside the years 0000 to 9999')\n    f = int(math.floor(ms))\n    days = f // 86400000\n    rem = f - days * 86400000\n    y, m, d = _tm_ymd(days)\n    if not 0 <= y <= 9999: raise ValueError('time: outside the years 0000 to 9999')\n    return y, m, d, rem // 3600000, rem // 60000 % 60, rem // 1000 % 60, rem % 1000", "def _tm_render(ms, shape):\n    y, m, d, h, mi, s, f = _tm_utc(ms)\n    if shape == 'date': return '%04d-%02d-%02d' % (y, m, d)\n    return '%04d-%02d-%02dT%02d:%02d:%02d.%03dZ' % (y, m, d, h, mi, s, f)", "def _tm_needs(op): raise ValueError(op + ' needs a time of day and a date carries none: pass a datetime')", "def _tm_below(u): return u in ('ms', 's', 'm', 'h')", "def _tm_same_shape(a, b):\n    if a[1] != b[1]: raise TypeError('expected two dates or two datetimes')", "def _tm_months(ts, months):\n    y, m, d = _tm_date(ts)\n    tod = ts - _tm_stamp(y, m, d)\n    total = y * 12 + (m - 1) + months\n    ny = total // 12\n    nm = total % 12 + 1\n    return _tm_stamp(ny, nm, min(d, _tm_dim(ny, nm))) + tod", "def _tm_shift(ts, amount, u):\n    if u in _TM_FIXED: return ts + amount * _TM_FIXED[u]\n    if amount != math.floor(amount) or abs(amount) > 4294967295.0: raise ValueError('a calendar unit takes a whole amount')\n    months = int(amount) * 12 if u == 'year' else int(amount) * 3 if u == 'quarter' else int(amount)\n    return _tm_months(ts, months)", "def _tm_start(ts, u):\n    day = 86400000.0\n    if u == 'ms': return float(math.floor(ts))\n    if u == 's': return math.floor(ts / 1000.0) * 1000.0\n    if u == 'm': return math.floor(ts / 60000.0) * 60000.0\n    if u == 'h': return math.floor(ts / 3600000.0) * 3600000.0\n    if u == 'd': return math.floor(ts / day) * day\n    if u == 'w':\n        days = int(math.floor(ts / day))\n        return float(days - (days + 3) % 7) * day\n    y, m, d = _tm_date(ts)\n    if u == 'month': return _tm_stamp(y, m, 1)\n    if u == 'quarter': return _tm_stamp(y, (m - 1) // 3 * 3 + 1, 1)\n    return _tm_stamp(y, 1, 1)", "def _tm_clock(): return time.time() * 1000.0", "def _tm_add(v, amount, unit, sign, op):\n    m = _tm_moment(v)\n    u = _tm_unit(unit)\n    amount = amount * sign if sign < 0 else amount\n    if m[1] == 'date':\n        if _tm_below(u): _tm_needs(op)\n        if u in _TM_FIXED and amount != math.floor(amount): raise Valu