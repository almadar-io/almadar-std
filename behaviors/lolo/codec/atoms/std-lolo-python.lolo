 i < len(d) else '0' for i in range(p))\n    out = [0] * (-p) if p < 0 else []\n    out += d[max(p, 0):]\n    out = out[:mx]\n    while len(out) > mn and out and out[-1] == 0: out.pop()\n    while len(out) < mn: out.append(0)\n    frac = ''.join(str(x) for x in out)\n    if len(integer) >= 3 + loc[2]:\n        first = len(integer) % 3\n        parts = ([integer[:first]] if first else []) + [integer[i:i + 3] for i in range(first, len(integer), 3)]\n        integer = loc[0].join(parts)\n    return sign + integer + (loc[1] + frac if frac else '')", "def _format_number(n, o=None):\n    if isinstance(n, bool) or not isinstance(n, (int, float)): raise TypeError('expected number')\n    o = {} if o is None else o\n    if not isinstance(o, dict): raise TypeError('expected object')\n    tag = o.get('locale')\n    if tag is None: loc = _LOC_EN\n    elif isinstance(tag, str):\n        loc = _LOCALES.get(tag)\n        if loc is None: return None\n    else: raise ValueError('format/number: locale must be a string')\n    def digits(k):\n        v = o.get(k)\n        if v is None: return None\n        if isinstance(v, bool) or not isinstance(v, (int, float)): raise ValueError('format/number: ' + k + ' must be a whole number from 0 to 100')\n        return v if v == int(v) and 0 <= v <= 100 else -1\n    dec, mn, mx = digits('decimals'), digits('minimumFractionDigits'), digits('maximumFractionDigits')\n    if dec == -1 or mn == -1 or mx == -1: return None\n    if dec is not None: lo = hi = int(dec)\n    elif mn is not None and mx is not None:\n        if mx < mn: return None\n        lo, hi = int(mn), int(mx)\n    elif mn is not None: lo, hi = int(mn), max(int(mn), 3)\n    elif mx is not None: lo, hi = 0, int(mx)\n    else: lo, hi = 0, 3\n    return _fmt_render(n, loc, lo, hi, 0)"], "format/percent": ["_LOC_EN = (',', '.', 1, '-')", "_LOCALES = {'en': (',', '.', 1, '-'), 'en-US': (',', '.', 1, '-'), 'en-GB': (',', '.', 1, '-'), 'en-CA': (',', '.', 1, '-'), 'en-AU': (',', '.', 1, '-')