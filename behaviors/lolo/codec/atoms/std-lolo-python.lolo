app std-lolo-python [
  version: "2.0.0",
  description: "std-lolo-python \u{2014} renders .lolo source as Python text, so a learner who reads an exercise written in .lolo can see the same program as Python that runs and gives the kernel's answers. It is std-lolo-source with the Python vocabulary in config and nothing else: LOLO_TO_PYTHON { source } answers PYTHON_RENDERED { text, warnings }, or PYTHON_RENDER_FAILED { error } when the source cannot be read. Each trait becomes a class holding state, entity, ports and config, with one on_<event> method per event: an if/elif branch per transition (the from-state and the guard), the effects, then the new state; an emit records (event, payload) in self.emitted with the payload built as the shell's generated payload type. The entity and payload types are imported from orbital_app.generated.entities and orbital_app.generated.events, the modules the Python shell generates. Kernel answers that are null (a division by zero, nth past the end, a missing key) come from small helper functions written once, and only the ones the output uses. An operator with no Python template is a named warning and a stub that raises when run. persist, fetch, notify, navigate and call-service are called on the injected ports object and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-python"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloPythonOrbital {
  entity LoloPythonRun [runtime] {
    id : string!
  }

  trait LoloPython = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_PYTHON
      SOURCE_RENDERED: PYTHON_RENDERED
      SOURCE_RENDER_FAILED: PYTHON_RENDER_FAILED
    }
    config {
      language: "Python"
      requiresTypes: false
      operators: { "/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "str/len": "len({{0}})", "str/upper": "{{0}}.upper()", "str/lower": "{{0}}.lower()", "str/trim": "{{0}}.strip()", "str/trimStart": "{{0}}.lstrip()", "str/trimEnd": "{{0}}.rstrip()", "str/capitalize": "{{0}}.capitalize()", "str/split": "_split({{0}}, {{1}})", "str/join": "_join({{0}}, {{1}})", "str/concat": "\"\".join(_text(v_) for v_ in [{{*}}])", "str/includes": "({{1}} in {{0}})", "str/startsWith": "{{0}}.startswith({{1}})", "str/endsWith": "{{0}}.endswith({{1}})", "str/replace": "{{0}}.replace({{1}}, {{2}}, 1)", "str/replaceAll": "{{0}}.replace({{1}}, {{2}})", "str/repeat": "({{0}} * {{1}})", "str/reverse": "{{0}}[::-1]", "str/slice#2": "_str_slice({{0}}, {{1}})", "str/slice#3": "_str_slice({{0}}, {{1}}, {{2}})", "str/padStart#2": "_pad_start({{0}}, {{1}})", "str/padStart#3": "_pad_start({{0}}, {{1}}, {{2}})", "str/padEnd#2": "_pad_end({{0}}, {{1}})", "str/padEnd#3": "_pad_end({{0}}, {{1}}, {{2}})", "str/truncate#2": "_truncate({{0}}, {{1}})", "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})", "str/to-int": "_to_int({{0}})", "array/len": "len({{0}})", "array/sum#2": "_sum({{0}}, {{1}})", "array/avg#1": "_avg({{0}})", "array/avg#2": "_avg({{0}}, {{1}})", "array/max#1": "_amax({{0}})", "array/max#2": "_amax({{0}}, {{1}})", "array/min#1": "_amin({{0}})", "array/min#2": "_amin({{0}}, {{1}})", "array/first": "_first({{0}})", "array/last": "_last({{0}})", "array/nth": "_nth({{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}})", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice({{0}}, {{1}})", "array/slice#3": "_slice({{0}}, {{1}}, {{2}})", "array/take": "_take({{0}}, {{1}})", "array/drop": "_drop({{0}}, {{1}})", "array/takeLast": "_take_last({{0}}, {{1}})", "array/dropLast": "_drop_last({{0}}, {{1}})", "array/append": "({{0}} + [{{1}}])", "array/prepend": "([{{1}}] + {{0}})", "array/includes": "({{1}} in {{0}})", "array/indexOf": "_index_of({{0}}, {{1}})", "array/reverse": "list(reversed({{0}}))", "array/unique": "_unique({{0}})", "array/flatten": "[y_ for x_ in {{0}} for y_ in x_]", "array/zip": "[list(p_) for p_ in zip({{0}}, {{1}})]", "array/sort#1": "_sort({{0}})", "array/sort#2": "_sort({{0}}, {{1}})", "array/sort#3": "_sort({{0}}, {{1}}, {{2}})", "array/reduce": "functools.reduce({{2}}, {{0}}, {{1}})", "list": "[{{*}}]", "object/get#2": "_get({{0}}, {{1}})", "object/get#3": "_get({{0}}, {{1}}, {{2}})", "object/has": "_has({{0}}, {{1}})", "object/set": "_set({{0}}, {{1}}, {{2}})", "object/keys": "list({{0}}.keys())", "object/values": "list({{0}}.values())", "object/entries": "[[k_, v_] for k_, v_ in {{0}}.items()]", "object/fromEntries": "{p_[0]: p_[1] for p_ in {{0}}}", "object/merge#2": "{**{{0}}, **{{1}}}", "object/pick": "_pick({{0}}, {{1}})", "object/omit": "_omit({{0}}, {{1}})", "json/parse": "_json_parse({{0}})", "json/stringify#1": "_json_dumps({{0}})", "math/abs": "abs({{0}})", "math/max": "max({{*}})", "math/min": "min({{*}})", "math/round#1": "_round({{0}})", "math/round#2": "_round({{0}}, {{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "_sign({{0}})", "math/clamp": "_clamp({{0}}, {{1}}, {{2}})", "default": "_default({{0}}, {{1}})", "as": "{{0}}", "validate/required": "_required({{0}})", "validate/string": "isinstance({{0}}, str)", "validate/number": "_is_number({{0}})", "validate/array": "isinstance({{0}}, list)", "validate/object": "isinstance({{0}}, dict)", "validate/boolean": "isinstance({{0}}, bool)", "validate/length": "(len({{0}}) == {{1}})", "validate/minLength": "(len({{0}}) >= {{1}})", "validate/maxLength": "(len({{0}}) <= {{1}})", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "({{1}} <= {{0}} <= {{2}})", "validate/oneOf": "({{0}} in {{1}})", "validate/equals": "({{0}} == {{1}})" }
      unary: { "-": "(-{{0}})", "not": "(not {{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "len({{0}})", "array/sort": "_sort({{0}})", "json/stringify": "_json_dumps({{0}})", "math/round": "_round({{0}})", "array/concat": "{{0}}", "object/merge": "{{0}}" }
      infix: { "+": "+", "-": "-", "*": "*", "=": "==", "==": "==", "!=": "!=", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "and", "or": "or", "array/concat": "+" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "[{{body}} for {{vars}} in {{src}}]", "array/filter": "[{{item}} for {{vars}} in {{src}} if {{body}}]", "array/reject": "[{{item}} for {{vars}} in {{src}} if not ({{body}})]", "array/some": "any({{body}} for {{vars}} in {{src}})", "array/every": "all({{body}} for {{vars}} in {{src}})", "array/count": "sum(1 for {{vars}} in {{src}} if {{body}})", "array/find": "next(({{item}} for {{vars}} in {{src}} if {{body}}), None)", "array/findIndex": "next((i_ for i_, {{item}} in enumerate({{src}}) if {{body}}), -1)" }
      lambdaForm: "lambda {{params}}: {{body}}"
      indexedSource: "enumerate({{src}})"
      indexedVars: "{{index}}, {{item}}"
      callees: { "math/ceil": "math.ceil", "math/floor": "math.floor", "math/sin": "math.sin", "math/cos": "math.cos", "math/tan": "math.tan", "math/atan": "math.atan", "math/atan2": "math.atan2", "math/hypot": "math.hypot" }
      calleeForm: "{{callee}}({{*}})"
      unsupportedForm: "_unsupported({{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: { "/": ["def _div(a, b): return None if b == 0 else a / b"], "%": ["def _mod(a, b): return None if b == 0 else math.fmod(a, b)"], "math/mod": ["def _mod(a, b): return None if b == 0 else math.fmod(a, b)"], "default": ["def _default(v, d): return d if v is None else v"], "str/split": ["def _split(s, d): return list(s) if d == '' else s.split(d)"], "str/join": ["def _join(a, d): return d.join(_text(v) for v in a)", "def _text(v):\n    if isinstance(v, bool): return 'true' if v else 'false'\n    if isinstance(v, float) and v - v == 0 and v == int(v): return str(int(v))\n    if isinstance(v, (int, float, str)): return str(v)\n    raise TypeError('expected string, number or boolean')"], "str/concat": ["def _text(v):\n    if isinstance(v, bool): return 'true' if v else 'false'\n    if isinstance(v, float) and v - v == 0 and v == int(v): return str(int(v))\n    if isinstance(v, (int, float, str)): return str(v)\n    raise TypeError('expected string, number or boolean')"], "str/slice": ["def _str_slice(s, a, b=None):\n    if a != int(a) or (b is not None and b != int(b)): raise ValueError('slice: not a whole number')\n    return s[int(a):None if b is None else int(b)]"], "str/padStart": ["def _pad_start(s, n, p=' '):\n    if len(p) != 1: raise ValueError('expected a single padding character')\n    return s.rjust(int(n), p)"], "str/padEnd": ["def _pad_end(s, n, p=' '):\n    if len(p) != 1: raise ValueError('expected a single padding character')\n    return s.ljust(int(n), p)"], "str/truncate": ["def _truncate(s, n, suffix='...'): return s if len(s) <= n else s[:int(n)] + suffix"], "str/to-int": ["def _to_int(s):\n    t = s[1:] if s[:1] in ('+', '-') else s\n    return int(s) if t.isascii() and t.isdigit() and -2 ** 63 <= int(s) < 2 ** 63 else None"], "array/sum": ["def _sum(a, k=None): return sum(a) if k is None else sum(x[k] for x in a)"], "array/avg": ["def _avg(a, k=None):\n    v = a if k is None else [x[k] for x in a]\n    return sum(v) / len(v) if v else None"], "array/max": ["def _amax(a, k=None):\n    v = a if k is None else [x[k] for x in a]\n    return max(v) if v else None"], "array/min": ["def _amin(a, k=None):\n    v = a if k is None else [x[k] for x in a]\n    return min(v) if v else None"], "array/first": ["def _first(a): return a[0] if a else None"], "array/last": ["def _last(a): return a[-1] if a else None"], "array/nth": ["def _nth(a, i):\n    if i != int(i) or i < 0: raise ValueError('nth: index is not a whole number from 0')\n    return a[int(i)] if i < len(a) else None"], "array/range": ["def _range(a, b=None, step=1):\n    start, end = (0, a) if b is None else (a, b)\n    if step == 0: raise ValueError('range: step 0 must be a non-zero finite number')\n    out = []\n    x = start\n    while (x < end) if step > 0 else (x > end):\n        out.append(x)\n        x += step\n    return out"], "array/slice": ["def _slice(a, s, e=None):\n    if s != int(s) or s < 0 or (e is not None and (e != int(e) or e < 0)): raise ValueError('slice: not a whole number from 0')\n    return a[int(s):None if e is None else int(e)]"], "array/take": ["def _take(a, n):\n    if n != int(n) or n < 0: raise ValueError('count is not a whole number from 0')\n    return a[:int(n)]"], "array/drop": ["def _drop(a, n):\n    if n != int(n) or n < 0: raise ValueError('count is not a whole number from 0')\n    return a[int(n):]"], "array/takeLast": ["def _take_last(a, n):\n    if n != int(n) or n < 0: raise ValueError('count is not a whole number from 0')\n    return a[len(a) - int(n):] if n < len(a) else a[:]"], "array/dropLast": ["def _drop_last(a, n):\n    if n != int(n) or n < 0: raise ValueError('count is not a whole number from 0')\n    return a[:len(a) - int(n)] if n < len(a) else []"], "array/indexOf": ["def _index_of(a, x): return a.index(x) if x in a else -1"], "array/unique": ["def _unique(a):\n    out = []\n    for x in a:\n        if x not in out: out.append(x)\n    return out"], "array/sort": ["def _sort(a, k=None, o='asc'): return sorted(a, key=None if k is None else (lambda x: x[k]), reverse=(o == 'desc'))"], "object/get": ["def _get(o, p, d=None):\n    for s in p.replace(chr(92) + '.', chr(0)).split('.'):\n        s = s.replace(chr(0), '.')\n        if isinstance(o, dict) and s in o: o = o[s]\n        elif isinstance(o, list) and s.isdigit() and int(s) < len(o): o = o[int(s)]\n        else: return d\n    return o"], "object/has": ["def _has(o, p):\n    for s in p.replace(chr(92) + '.', chr(0)).split('.'):\n        s = s.replace(chr(0), '.')\n        if isinstance(o, dict) and s in o: o = o[s]\n        elif isinstance(o, list) and s.isdigit() and int(s) < len(o): o = o[int(s)]\n        else: return False\n    return True"], "object/set": ["def _set(o, p, v):\n    out = dict(o)\n    cur = out\n    parts = [s.replace(chr(0), '.') for s in p.replace(chr(92) + '.', chr(0)).split('.')]\n    for s in parts[:-1]:\n        cur[s] = dict(cur[s]) if isinstance(cur.get(s), dict) else {}\n        cur = cur[s]\n    cur[parts[-1]] = v\n    return out"], "object/pick": ["def _pick(o, ks): return {k: o[k] for k in ks if k in o}"], "object/omit": ["def _omit(o, ks): return {k: v for k, v in o.items() if k not in ks}"], "json/parse": ["def _json_parse(t):\n    try: return json.loads(t)\n    except ValueError: return None"], "json/stringify": ["def _json_dumps(v):\n    def n(x):\n        if isinstance(x, float) and x - x == 0 and x == int(x): return int(x)\n        if isinstance(x, list): return [n(y) for y in x]\n        if isinstance(x, dict): return {k: n(y) for k, y in x.items()}\n        return x\n    return json.dumps(n(v), separators=(',', ':'), ensure_ascii=False)"], "math/round": ["def _round(x, d=0):\n    m = 10 ** d\n    return math.copysign(math.floor(abs(x) * m + 0.5) / m, x)"], "math/sqrt": ["def _sqrt(x): return None if x < 0 else math.sqrt(x)"], "math/ln": ["def _ln(x): return None if x <= 0 else math.log(x)"], "math/log10": ["def _log10(x): return None if x <= 0 else math.log10(x)"], "math/pow": ["def _pow(a, b):\n    try: return math.pow(a, b)\n    except (ValueError, OverflowError, ZeroDivisionError): return None"], "math/sign": ["def _sign(x): return (x > 0) - (x < 0)"], "math/clamp": ["def _clamp(v, lo, hi): return min(max(v, lo), hi)"], "validate/required": ["def _required(v): return v is not None and v != ''"], "validate/number": ["def _is_number(v): return isinstance(v, (int, float)) and not isinstance(v, bool)"], "unsupported": ["def _unsupported(name): raise NotImplementedError('no native template for operator ' + name)"] }
      helperGap: "\n"
      imports: { "Literal": "from typing import Literal", "Any": "from typing import Any", "field": "from dataclasses import field", "dataclass": "from dataclasses import dataclass", "%": "import math", "math/mod": "import math", "math/ceil": "import math", "math/floor": "import math", "math/sin": "import math", "math/cos": "import math", "math/tan": "import math", "math/atan": "import math", "math/atan2": "import math", "math/hypot": "import math", "math/round": "import math", "math/sqrt": "import math", "math/ln": "import math", "math/log10": "import math", "math/pow": "import math", "array/reduce": "import functools", "json/parse": "import json", "json/stringify": "import json" }
      portEffects: ["persist", "fetch", "fetch-stream", "notify", "navigate", "navigate-back", "call-service", "cancel-call", "send-server", "spawn", "despawn", "log"]
      portCall: "self.ports.{{name}}({{*}})"
      portCase: "lower"
      portWarn: "{{op}} is called on the ports object"
      attributeRoots: { "entity": "self.entity", "state": "self.state", "user": "self.user", "now": "self.now", "locale": "self.locale", "trait": "self.trait", "event": "self.event", "payload": "payload" }
      itemRoots: { "config": "self.config" }
      attrAccess: ".{{name}}"
      itemAccess: "[{{key}}]"
      indexAccess: "[{{0}}]"
      localAccess: "item"
      entityReadDefault: ""
      nullLit: "None"
      trueLit: "True"
      falseLit: "False"
      stringForm: "{{json}}"
      listForm: "[{{*}}]"
      mapOpen: "{"
      mapClose: "}"
      mapPair: "{{key}}: {{value}}"
      mapSep: ", "
      letStmt: "{{name}} = {{value}}"
      letExpr: "(lambda {{name}}: {{body}})({{value}})"
      condExpr: "({{then}} if {{cond}} else {{else}})"
      ifOpen: "if {{cond}}:"
      elseOpen: "else:"
      blockClose: ""
      emptyBody: "pass"
      setStyle: "assign"
      setAssign: "{{target}} = {{value}}"
      emitForm: "self.emit({{event}}, {{payload}})"
      payloadType: "{{trait}}{{event}}Payload"
      payloadCtor: "{{type}}({{fields}})"
      payloadField: "{{name}}={{value}}"
      payloadSep: ", "
      commentForm: "# {{text}}"
      indent: "    "
      terminator: ""
      classCase: "keep"
      fieldCase: "keep"
      localCase: "keep"
      methodCase: "lower"
      methodName: "on_{{event}}"
      modelImports: { "entity": "from orbital_app.generated.entities import {{names}}", "payload": "from orbital_app.generated.events import {{names}}" }
      modelImportEach: false
      modelImportSep: ", "
      sectionGap: "\n\n\n"
      classOpen: "class {{class}}:"
      classClose: ""
      classEmpty: "{{i}}pass"
      constructor: ["{{i}}def __init__(self, entity: {{entity}}, ports=None, config: dict | None = None):", "{{i}}{{i}}self.state = {{initial}}", "{{i}}{{i}}self.entity = entity", "{{i}}{{i}}self.ports = ports", "{{i}}{{i}}self.config = {{config}} | (config or {})", "{{i}}{{i}}self.emitted: list[tuple[str, object]] = []"]
      emitMethod: ["{{i}}def emit(self, event, payload):", "{{i}}{{i}}self.emitted.append((event, payload))"]
      methodOpen: "{{i}}def {{method}}(self, payload: {{payloadType}}) -> None:"
      methodOpenPlain: "{{i}}def {{method}}(self, payload=None) -> None:"
      methodClose: ""
      branchFirst: "{{i}}{{i}}if {{test}}:"
      branchNext: "{{i}}{{i}}elif {{test}}:"
      branchClose: ""
      branchTest: "{{stateTest}} and {{guard}}"
      branchTestPlain: "{{stateTest}}"
      stateTest: "self.state == {{state}}"
      stateAssign: "self.state = {{state}}"
      bodyPrefix: "{{i}}{{i}}{{i}}"
      renderModels: false
      modelAnnotation: "{{at}}dataclass"
      modelClassOpen: "class {{name}}:"
      modelClassClose: ""
      modelField: "{{i}}{{name}}: {{type}}{{default}}"
      modelDefault: " = {{value}}"
      modelFactory: " = field(default_factory=lambda: {{value}})"
      modelEmpty: "{{i}}pass"
      modelAlias: "{{name}} = {{type}}"
      typeMap: { "string": "str", "number": "float", "float": "float", "int": "int", "integer": "int", "boolean": "bool", "bool": "bool", "date": "str", "datetime": "str", "timestamp": "str", "instant": "str", "duration": "float", "email": "str", "url": "str", "uuid": "str", "bytes": "bytes" }
      typeList: "list[{{0}}]"
      typeListBare: "list"
      typeDict: "dict[str, {{0}}]"
      typeDictBare: "dict"
      typeLiteral: "Literal[{{*}}]"
      typeNullable: "{{0}} | None"
      typeAny: "Any"
    }
  }

  page boot as LoloPythonStart -> LoloPython
}
