rn _fsum((v - m) * (v - m) for v in xs) / len(xs)"], "prob/histogram": ["def _histogram(xs, bins):\n    if bins < 1.0 or bins != int(bins): return None\n    if not xs: return {'binEdges': [], 'counts': []}\n    mn = math.inf\n    mx = -math.inf\n    for s in xs:\n        if s == s and s < mn: mn = s\n        if s == s and s > mx: mx = s\n    w = (mx - mn) / bins\n    if w == 0.0 or w != w: w = 1.0\n    n = int(bins)\n    counts = [0] * n\n    for s in xs:\n        v = (s - mn) / w\n        i = 0 if v != v or v < 0 else n - 1 if v == math.inf else min(int(math.floor(v)), n - 1)\n        counts[i] += 1\n    return {'binEdges': [mn + i * w for i in range(n + 1)], 'counts': counts}"], "prob/percentile": ["def _percentile(xs, p):\n    if not 0.0 <= p <= 100.0 or not xs: return None\n    s = sorted(xs)\n    i = (p / 100.0) * (len(s) - 1)\n    lo, hi = int(math.floor(i)), int(math.ceil(i))\n    if lo == hi: return s[lo]\n    f = i - lo\n    return s[lo] * (1.0 - f) + s[hi] * f"], "prob/credible-interval": ["def _credible(xs, a):\n    if not 0.0 <= a <= 1.0 or not xs: return None\n    s = sorted(xs)\n    last = len(s) - 1\n    return [s[int(math.floor((a / 2.0) * last))], s[int(math.ceil((1.0 - a / 2.0) * last))]]"], "str/camelCase": ["def _words(s):\n    out = []\n    cur = ''\n    for c in s:\n        if c.isalnum(): cur += c\n        elif cur:\n            out.append(cur)\n            cur = ''\n    if cur: out.append(cur)\n    return out", "def _cap(w): return w[:1].upper() + w[1:].lower()", "def _camel(s):\n    w = _words(s)\n    return ''.join(x.lower() if i == 0 else _cap(x) for i, x in enumerate(w))"], "str/kebabCase": ["def _case_words(s):\n    out = []\n    cur = ''\n    for i, c in enumerate(s):\n        if not c.isalnum():\n            if cur:\n                out.append(cur.lower())\n                cur = ''\n            continue\n        if c.isupper() and i > 0:\n            p = s[i - 1]\n            nl = i + 1 < len(s) and s[i + 1].islower()\n            if (