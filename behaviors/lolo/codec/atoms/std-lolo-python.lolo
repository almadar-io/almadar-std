= num(at + 1, 2)\n        if s is None or s > 59: return None\n        ms += s * 1000\n        at += 3\n        if t[at:at + 1] == '.':\n            st = at + 1\n            en = st\n            while en < n and t[en] in '0123456789': en += 1\n            if en == st: return None\n            ms += int((t[st:en] + '000')[:3])\n            at = en\n    z = t[at:]\n    if z == 'Z': return ms, 'datetime'\n    if len(z) == 6 and z[0] in '+-' and z[3] == ':':\n        oh, om = num(at + 1, 2), num(at + 4, 2)\n        if oh is None or om is None or oh > 23 or om > 59: return None\n        off = (oh * 60 + om) * 60000\n        return (ms + off if z[0] == '-' else ms - off), 'datetime'\n    return None", "def _tm_moment(v):\n    if not isinstance(v, str): raise TypeError('expected date or datetime (ISO-8601 text)')\n    r = _tm_parse(v)\n    if r is None: raise TypeError('expected date or datetime (ISO-8601 text): ' + v)\n    return float(r[0]), r[1]", "def _tm_utc(ms):\n    if ms - ms != 0: raise ValueError('time: outside the years 0000 to 9999')\n    f = int(math.floor(ms))\n    days = f // 86400000\n    rem = f - days * 86400000\n    y, m, d = _tm_ymd(days)\n    if not 0 <= y <= 9999: raise ValueError('time: outside the years 0000 to 9999')\n    return y, m, d, rem // 3600000, rem // 60000 % 60, rem // 1000 % 60, rem % 1000", "def _tm_render(ms, shape):\n    y, m, d, h, mi, s, f = _tm_utc(ms)\n    if shape == 'date': return '%04d-%02d-%02d' % (y, m, d)\n    return '%04d-%02d-%02dT%02d:%02d:%02d.%03dZ' % (y, m, d, h, mi, s, f)", "def _tm_needs(op): raise ValueError(op + ' needs a time of day and a date carries none: pass a datetime')", "def _tm_below(u): return u in ('ms', 's', 'm', 'h')", "def _tm_same_shape(a, b):\n    if a[1] != b[1]: raise TypeError('expected two dates or two datetimes')", "def _tm_months(ts, months):\n    y, m, d = _tm_date(ts)\n    tod = ts - _tm_stamp(y, m, d)\n    total = y * 12 + (m - 1) + months\n    ny = total // 12\n    nm = total % 12 + 1\n   