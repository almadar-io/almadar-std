point_in_rect({{0}}, {{1}})", "geo/point-in-circle": "_point_in_circle({{0}}, {{1}})", "geo/reflect": "_reflect({{0}}, {{1}})", "geo/segment-intersect": "_segment_intersect({{0}}, {{1}})", "grid/to-world": "_grid_to_world({{0}}, {{1}})", "grid/from-world": "_grid_from_world({{0}}, {{1}})", "grid/iso-to-screen": "_iso_to_screen({{0}}, {{1}}, {{2}})", "grid/screen-to-iso": "_screen_to_iso({{0}}, {{1}}, {{2}})", "grid/distance": "_cheb({{0}}, {{1}})", "grid/manhattan-distance": "_manhattan({{0}}, {{1}})", "grid/neighbors#1": "_neighbors({{0}})", "grid/neighbors#2": "_neighbors({{0}}, {{1}})", "grid/cells-in-radius": "_cells_in_radius({{0}}, {{1}})", "grid/line": "_grid_line({{0}}, {{1}})", "grid/in-bounds": "_in_bounds({{0}}, {{1}}, {{2}})", "ease/apply": "_ease({{0}}, {{1}})", "ease/smoothstep": "_smoothstep({{0}}, {{1}}, {{2}})", "anim/frame-at#3": "_frame_at({{0}}, {{1}}, {{2}})", "anim/frame-at#4": "_frame_at({{0}}, {{1}}, {{2}}, {{3}})", "anim/sheet-rect": "_sheet_rect({{0}}, {{1}}, {{2}}, {{3}})", "anim/direction-from-delta#2": "_direction({{0}}, {{1}})", "anim/direction-from-delta#3": "_direction({{0}}, {{1}}, {{2}})", "bit/xor": "_bit_fold('xor', {{*}})", "bit/and": "_bit_fold('and', {{*}})", "bit/or": "_bit_fold('or', {{*}})", "bit/not": "_bit_not({{0}})", "bit/shl": "_bit_shift('shl', {{0}}, {{1}})", "bit/shr": "_bit_shift('shr', {{0}}, {{1}})", "bit/rotl": "_bit_shift('rotl', {{0}}, {{1}})", "bit/rotr": "_bit_shift('rotr', {{0}}, {{1}})", "json/valid": "_json_valid({{0}})", "json/nodes": "_nodes({{0}})", "json/stringify#2": "_json_dumps2({{0}}, {{1}})", "math/acos": "_acos({{0}})", "math/asin": "_asin({{0}})", "math/approach": "_approach({{0}}, {{1}}, {{2}})", "math/deg-rad": "({{0}} * math.pi / 180.0)", "math/rad-deg": "({{0}} * 180.0 / math.pi)", "math/lerp": "_lerp({{0}}, {{1}}, {{2}})", "math/map": "_map({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "math/wrap": "_wrap({{0}}, {{1}}, {{2}})", "math/random": "random.random()", "math/randomInt": "_random_int({{0}}, {{1}})", "noise/perlin#2": "_perlin({{0}}, {{1}}, 0.0)", "noise/perlin#3": "_perlin({{0}}, {{1}}, {{2}})", "noise/simplex#2": "_simplex({{0}}, {{1}}, 0.0)", "noise/simplex#3": "_simplex({{0}}, {{1}}, {{2}})", "noise/fbm#3": "_fbm({{0}}, {{1}}, {{2}}, 0.0)", "noise/fbm#4": "_fbm({{0}}, {{1}}, {{2}}, {{3}})", "object/clone": "_clone_object({{0}})", "object/deepClone": "_deep_clone({{0}})", "object/deepMerge": "_deep_merge({{*}})", "object/equals": "_object_equals({{0}}, {{1}})", "object/filter": "_object_filter({{0}}, {{1}})", "object/mapKeys": "_map_keys({{0}}, {{1}})", "object/mapValues": "_map_values({{0}}, {{1}})", "object/merge": "_merge_all({{*}})", "path/astar#5": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "path/astar#6": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "path/reachable#5": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "path/reachable#6": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "prob/seed": "_prob_seed({{0}})", "prob/flip": "(_prob_next() < {{0}})", "prob/gaussian": "_prob_gaussian({{0}}, {{1}})", "prob/uniform": "_prob_uniform({{0}}, {{1}})", "prob/beta": "_prob_beta({{0}}, {{1}})", "prob/categorical": "_prob_categorical({{0}}, {{1}})", "prob/poisson": "_prob_poisson({{0}})", "prob/sample": "[{{1}} for _ in range(_prob_count({{0}}))]", "prob/expected-value": "_expected({{0}})", "prob/variance": "_variance({{0}})", "prob/histogram": "_histogram({{0}}, {{1}})", "prob/percentile": "_percentile({{0}}, {{1}})", "prob/credible-interval": "_credible({{0}}, {{1}})", "str/camelCase": "_camel({{0}})", "str/kebabCase": "'-'.join(_case_words({{0}}))", "str/snakeCase": "'_'.join(_case_words({{0}}))", "str/titleCase": "_title({{0}})", "str/template": "_template({{0}}, {{1}})", "str/to-number": "_to_number({{0}})", "str/encode-uri-component": "urllib.parse.quote({{0}}, safe=\"-_.!~*'()\")", "str/decode-uri-component": "_uri_decode({{0}})", "str/uri-component-valid": "(_uri_decode({{0}}) is not None)", "str/replace-pattern": "_replace_pattern({{0}}, {{1}}, {{2}})", "str/find-pattern#2": "_find_pattern({{0}}, {{1}})", "str/find-pattern#3": "_find_pattern({{0}}, {{1}}, {{2}})", "time/now": "_tm_render(_tm_clock(), 'datetime')", "time/today": "_tm_render(math.floor(_tm_clock() / 86400000.0) * 86400000.0, 'datetime')", "time/add": "_tm_add({{0}}, {{1}}, {{2}}, 1.0, 'time/add')", "time/subtract": "_tm_add({{0}}, {{1}}, {{2}}, -1.0, 'time/subtract')", "time/diff#2": "_tm_diff({{0}}, {{1}})", "time/diff#3": "_tm_diff({{0}}, {{1}}, {{2}})", "time/isBefore": "_tm_cmp({{0}}, {{1}}, 'lt')", "time/isAfter": "_tm_cmp({{0}}, {{1}}, 'gt')", "time/isBetween": "_tm_between({{0}}, {{1}}, {{2}})", "time/isSame#2": "_tm_is_same({{0}}, {{1}})", "time/isSame#3": "_tm_is_same({{0}}, {{1}}, {{2}})", "time/parse": "_tm_parse_value({{0}})", "time/valid": "(_tm_parse(_tm_text({{0}})) is not None)", "time/format": "_tm_format(_tm_moment({{0}}), {{1}})", "time/year": "_tm_part({{0}}, 0)", "time/month": "_tm_part({{0}}, 1)", "time/day": "_tm_part({{0}}, 2)", "time/weekday": "_tm_weekday({{0}})", "time/hour": "_tm_clockpart({{0}}, 3, 'time/hour')", "time/minute": "_tm_clockpart({{0}}, 4, 'time/minute')", "time/second": "_tm_clockpart({{0}}, 5, 'time/second')", "time/startOf": "_tm_bound({{0}}, {{1}}, False, 'time/startOf')", "time/endOf": "_tm_bound({{0}}, {{1}}, True, 'time/endOf')", "time/isPast": "(_tm_instant({{0}}, 'time/isPast') < _tm_clock())", "time/isFuture": "(_tm_instant({{0}}, 'time/isFuture') > _tm_clock())", "time/isToday": "_tm_is_today({{0}})", "time/duration": "_tm_duration({{0}})", "time/relative": "_tm_relative({{0}})", "tree/index#2": "_tree_index({{0}}, {{1}})", "tree/index#3": "_tree_index({{0}}, {{1}}, {{2}})", "quote": "json.loads({{0}})", "tree/fold#3": "_tree_fold({{0}}, {{1}}, {{2}})", "tree/fold#4": "_tree_fold({{0}}, {{1}}, {{2}}, {{3}})", "validate/pattern": "_pat_test({{0}}, {{1}})", "validate/email": "_rx_test({{0}}, '^[^\\\\s@]+@[^\\\\s@.]+\\\\.[^\\\\s@]+$')", "validate/url": "_rx_test({{0}}, '^https?://[^\\\\s]+$')", "validate/phone": "_rx_test({{0}}, '^[+]?[\\\\d\\\\s().-]{7,}$')", "validate/uuid": "_rx_test({{0}}, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$')", "validate/date": "_valid_date({{0}})", "validate/creditCard": "_luhn({{0}})", "validate/noneOf": "({{0}} not in {{1}})", "validate/check": "_check({{0}}, {{1}})", "math/sin": "_libm_sin({{0}})", "math/cos": "_libm_cos({{0}})", "math/tan": "_libm_tan({{0}})", "math/atan": "_libm_atan({{0}})", "math/atan2": "_libm_atan2({{0}}, {{1}})", "math/hypot": "_libm_hypot({{0}}, {{1}})" }
      unary: { "-": "(-{{0}})", "not": "(not {{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "len({{0}})", "array/sort": "_sort({{0}})", "json/stringify": "_json_dumps({{0}})", "math/round": "_round({{0}})", "array/concat": "{{0}}", "object/merge": "{{0}}" }
      infix: { "+": "+", "-": "-", "*": "*", "=": "==", "==": "==", "!=": "!=", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "and", "or": "or", "array/concat": "+" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "[{{body}} for {{vars}} in {{src}}]", "array/filter": "[{{item}} for {{vars}} in {{src}} if {{body}}]", "array/reject": "[{{item}} for {{vars}} in {{src}} if not ({{body}})]", "array/some": "any({{body}} for {{vars}} in {{src}})", "array/every": "all({{body}} for {{vars}} in {{src}})", "array/count": "sum(1 for {{vars}} in {{src}} if {{body}})", "array/find": "next(({{item}} for {{vars}} in {{src}} if {{body}}), None)", "array/findIndex": "next((i_ for i_, {{item}} in enumerate({{src}}) if {{body}}), -1)" }
      lambdaForm: "lambda {{params}}: {{body}}"
      indexedSource: "enumerate({{src}})"
      indexedVars: "{{index}}, {{item}}"
      callees: { "math/ceil": "math.ceil", "math/floor": "math.floor" }
      calleeForm: "{{callee}}({{*}})"
      unsupportedForm: "_unsupported({{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: { "user": ["class Viewer:\n    def __init__(self):\n        self.sign_in(None)\n\n    def sign_in(self, row):\n        row = row if row is not None else {\"id\": \"anonymous\", \"role\": \"anonymous\"}\n        self.id = row.get(\"id\")\n        self.email = row.get(\"email\")\n        self.name = row.get(\"name\")\n        self.role = row.get(\"role\")"], "store": ["class MemoryStore:\n    def __init__(self):\n        self.tables = {}\n        self.minted = 0\n\n    def persist(self, op, entity, data):\n        rows = self.tables.setdefault(entity, {})\n        if op == \"create\":\n            row = dict(_plain(data))\n            if not row.get(\"id\"):\n                self.minted += 1\n                row[\"id\"] = entity + \"-\" + str(self.minted)\n            rows[row[\"id\"]] = row\n            return True, dict(row)\n        key = data if isinstance(data, str) else _plain(data).get(\"id\")\n        if key not in rows:\n            return False, {\"error\": entity + \" \" + str(key) + \" not found\", \"code\": \"not-found\"}\n        if op == \"delete\":\n            del rows[key]\n            return True, {\"id\": key, \"deleted\": True}\n        rows[key].update(_plain(data))\n        return True, dict(rows[key])\n\n    def fetch(self, entity, keep, offset=None, limit=None):\n        rows = [dict(r) for r in self.tables.get(entity, {}).values() if keep is None or keep(dict(r))]\n        rows.sort(key=lambda r: (0, r[\"createdAt\"], r[\"id\"]) if \"createdAt\" in r else (1, 0, r[\"id\"]))\n        total = len(rows)\n        start = int(offset or 0)\n        rows = rows[start:] if limit is None else rows[start:start + int(limit)]\n        return True, {\"data\": rows, \"totalCount\": total}"], "router": ["def _plain(v):\n    if dataclasses.is_dataclass(v):\n        return dataclasses.asdict(v)\n    return {} if v is None else v", "def _decode(cls, payload):\n    names = {f.name for f in dataclasses.fields(cls)}\n    return cls(**{k: v for k, v in (payload or {}).items() if k in names})", "class _Router:\n    def __init__(self):\n        self.traits = {}\n        self.handles = {}\n        self.rows = []\n        self.log = []\n\n    def add(self, key, trait):\n        self.traits[key] = trait\n\n    def row(self, source, event, target, trigger, guard, mapping):\n        self.rows.append((source, event, target, trigger, guard, mapping))\n\n    def targets(self, source, event, payload, completion):\n        return [{\"trait\": target, \"event\": trigger, \"payload\": mapping(payload) if mapping else payload, \"source\": payload,\n                 \"guard\": guard, \"fans\": False, \"completion\": completion}\n                for (s, e, target, trigger, guard, mapping) in self.rows if s == source and e == event]\n\n    def dispatch(self, trait, event, payload):\n        queue = deque([{\"trait\": trait, \"event\": event, \"payload\": payload, \"source\": payload, \"guard\": None, \"fans\": True, \"completion\": False}])\n        seen = set()\n        steps = 0\n        while queue:\n            item = queue.popleft()\n            t = self.traits[item[\"trait\"]]\n            key = json.dumps([item[\"trait\"], item[\"event\"], t.state, item[\"payload\"], _plain(t.entity)], sort_keys=True, default=str)\n            if not item[\"completion\"] and key in seen:\n                continue\n            if item[\"guard\"] is not None and not item[\"guard\"](item[\"source\"]):\n                continue\n            if steps >= 2000:\n                break\n            steps += 1\n            seen.add(key)\n            n = len(t.emitted)\n            self.deliver(item[\"trait\"], item[\"event\"], item[\"payload\"])\n            own, fanned = [], []\n            if item[\"fans\"]:\n                fanned += self.targets(item[\"trait\"], item[\"event\"], item[\"payload\"], False)\n            for emitted in t.emitted[n:]:\n                ev, out = emitted[0], _plain(emitted[1])\n                completion = len(emitted) > 2 and emitted[2]\n                self.log.append((item[\"trait\"], ev, out))\n                if ev in self.handles[item[\"trait\"]].get(t.state, ()):\n                    own.append({\"trait\": item[\"trait\"], \"event\": ev, \"payload\": out, \"source\": out, \"guard\": None, \"fans\": False, \"completion\": completion})\n                fanned += self.targets(item[\"trait\"], ev, out, completion)\n            queue.extendleft(reversed(own))\n            queue.extend(fanned)"], "/": ["def _div(a, b): return None if b == 0 else a / b"], "%": ["def _mod(a, b): return None if b == 0 else math.fmod(a, b)"], "math/mod": ["def _mod(a, b): return None if b == 0 else math.fmod(a, b)"], "default": ["def _default(v, d): return d if v is None else v"], "str/split": ["def _split(s, d): return list(s) if d == '' else s.split(d)"], "str/join": ["def _join(a, d): return d.join(_text(v) for v in a)", "def _text(v):\n    if isinstance(v, bool): return 'true' if v else 'false'\n    if isinstance(v, float) and v - v == 0 and v == int(v): return str(int(v))\n    if isinstance(v, (int, float, str)): return str(v)\n    raise TypeError('expected string, number or boolean')"], "str/concat": ["def _text(v):\n    if isinstance(v, bool): return 'true' if v else 'false'\n    if isinstance(v, float) and v - v == 0 and v == int(v): return str(int(v))\n    if isinstance(v, (int, float, str)): return str(v)\n    raise TypeError('expected string, number or boolean')"], "str/slice": ["def _str_slice(s, a, b=None):\n    if a != int(a) or (b is not None and b != int(b)): raise ValueError('slice: not a whole number')\n    return s[int(a):None if b is None else int(b)]"], "str/padStart": ["def _pad_start(s, n, p=' '):\n    if len(p) != 1: raise ValueError('expected a single padding character')\n    return s.rjust(int(n), p)"], "str/padEnd": ["def _pad_end(s, n, p=' '):\n    if len(p) != 1: raise ValueError('expected a single padding character')\n    return s.ljust(int(n), p)"], "str/truncate": [