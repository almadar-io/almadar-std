eturn (ms + off if z[0] == '-' else ms - off), 'datetime'\n    return None", "def _tm_moment(v):\n    if not isinstance(v, str): raise TypeError('expected date or datetime (ISO-8601 text)')\n    r = _tm_parse(v)\n    if r is None: raise TypeError('expected date or datetime (ISO-8601 text): ' + v)\n    return float(r[0]), r[1]", "def _tm_utc(ms):\n    if ms - ms != 0: raise ValueError('time: outside the years 0000 to 9999')\n    f = int(math.floor(ms))\n    days = f // 86400000\n    rem = f - days * 86400000\n    y, m, d = _tm_ymd(days)\n    if not 0 <= y <= 9999: raise ValueError('time: outside the years 0000 to 9999')\n    return y, m, d, rem // 3600000, rem // 60000 % 60, rem // 1000 % 60, rem % 1000", "def _tm_render(ms, shape):\n    y, m, d, h, mi, s, f = _tm_utc(ms)\n    if shape == 'date': return '%04d-%02d-%02d' % (y, m, d)\n    return '%04d-%02d-%02dT%02d:%02d:%02d.%03dZ' % (y, m, d, h, mi, s, f)", "def _tm_needs(op): raise ValueError(op + ' needs a time of day and a date carries none: pass a datetime')", "def _tm_below(u): return u in ('ms', 's', 'm', 'h')", "def _tm_same_shape(a, b):\n    if a[1] != b[1]: raise TypeError('expected two dates or two datetimes')", "def _tm_months(ts, months):\n    y, m, d = _tm_date(ts)\n    tod = ts - _tm_stamp(y, m, d)\n    total = y * 12 + (m - 1) + months\n    ny = total // 12\n    nm = total % 12 + 1\n    return _tm_stamp(ny, nm, min(d, _tm_dim(ny, nm))) + tod", "def _tm_shift(ts, amount, u):\n    if u in _TM_FIXED: return ts + amount * _TM_FIXED[u]\n    if amount != math.floor(amount) or abs(amount) > 4294967295.0: raise ValueError('a calendar unit takes a whole amount')\n    months = int(amount) * 12 if u == 'year' else int(amount) * 3 if u == 'quarter' else int(amount)\n    return _tm_months(ts, months)", "def _tm_start(ts, u):\n    day = 86400000.0\n    if u == 'ms': return float(math.floor(ts))\n    if u == 's': return math.floor(ts / 1000.0) * 1000.0\n    if u == 'm': return math.floor(ts / 60000.0) * 60000.0\n    if u == 'h': return math.floor(ts / 3600000.0) * 3600000.0\n    if u == 'd': return math.floor(ts / day) * day\n    if u == 'w':\n        days = int(math.floor(ts / day))\n        return float(days - (days + 3) % 7) * day\n    y, m, d = _tm_date(ts)\n    if u == 'month': return _tm_stamp(y, m, 1)\n    if u == 'quarter': return _tm_stamp(y, (m - 1) // 3 * 3 + 1, 1)\n    return _tm_stamp(y, 1, 1)", "def _tm_clock(): return time.time() * 1000.0", "def _tm_add(v, amount, unit, sign, op):\n    m = _tm_moment(v)\n    u = _tm_unit(unit)\n    amount = amount * sign if sign < 0 else amount\n    if m[1] == 'date':\n        if _tm_below(u): _tm_needs(op)\n        if u in _TM_FIXED and amount != math.floor(amount): raise ValueError(op + ' on a date takes a whole amount of days or weeks')\n    return _tm_render(_tm_shift(m[0], amount, u), m[1])"], "tree/index": ["def _tree_index(value, heads, options=None):\n    def bad(m): raise ValueError('tree/index: ' + m)\n    if not isinstance(heads, list) or not all(isinstance(h, str) for h in heads): bad('heads must be a list of strings')\n    found = {}\n    for h in heads: found.setdefault(h, [])\n    head_keys = set(found)\n    prefixes = []\n    keys = []\n    if options is not None:\n        if not isinstance(options, dict): bad('options must be a record')\n        objs = options.get('objects')\n        if objs is not None:\n            if not isinstance(objs, list) or not all(isinstance(k, str) for k in objs): bad('options.objects must be a list of strings')\n            for k in objs:\n                if k not in keys:\n                    keys.append(k)\n                    found.setdefault(k, [])\n        pre = options.get('prefixes')\n        if pre is not None:\n            if not isinstance(pre, list) or not all(isinstance(k, str) for k in pre): bad('options.prefixes must be a list of strings')\n            for k in pre:\n                if k not in prefixes:\n                    prefixes.append(k)\n                    found.setdefault(k, [])\n    visited = 0\n    stack = [(value, '')]\n    while stack:\n        node, path = stack.pop()\n        at = visited\n        visited += 1\n        hit = {'path': path, 'node': node, 'at': at}\n        if isinstance(node, list):\n            if node and isinstance(node[0], str) and node[0] in head_keys: found[node[0]].append(hit)\n            for i in range(len(node) - 1, -1, -1): stack.append((node[i], path + '[' + str(i) + ']'))\n        elif isinstance(node, dict):\n            for k in keys:\n                if k in node: found[k].append(hit)\n            for k, v in reversed(list(node.items())): stack.append((v, k if path == '' else path + '.' + k))\n        elif isinstance(node, str):\n            for p in prefixes:\n                if node.startswith(p):\n                    found[p].append(hit)\n                    break\n    return found"], "tree/fold": ["def _tree_fold(value, step, shape, definition=None):\n    def bad(m): raise ValueError('tree/fold: ' + m)\n    if not isinstance(shape, str): bad(\"the third argument names the value's type\")\n    if not isinstance(definition, str): bad('the declaration of ' + str(shape) + ' was not written into the call')\n    try: dfn = json.loads(definition)\n    except ValueError as e: bad('the definition is not a field definition: ' + str(e))\n    if not callable(step) or step.__code__.co_argcount != 2: bad('the step takes exactly (node childResults)')\n    root = dfn.get('name') or shape\n    def ref(d):\n        if d is None or d.get('type') != 'union' or d.get('properties') is not None: return None\n        v = d.get('values')\n        return v[0] if isinstance(v, list) and len(v) == 1 else None\n    def is_map(d): return d.get('type') == 'object' and d.get('properties') is None and d.get('items') is not None\n    def position(d):\n        if d is None: return None\n        if ref(d) == root: return 'field'\n        el = d.get('items')\n        if el is None or ref(el) != root: return None\n        if d.get('type') == 'array': return 'list'\n        if d.get('type') == 'object' and d.get('properties') is None: return 'map'\n        return None\n    def variants_of(d):\n        names, vs = d.get('values'), d.get('properties')\n        if names is None or vs is None: bad('a union definition declares its variants (values + properties)')\n        return names, vs\n    def map_variant(d):\n        names, vs = variants_of(d)\n        maps = [vs[n] for n in names if n in vs and is_map(vs[n])]\n        return maps[0] if len(maps) == 1 else None\n    def select(d, node):\n        names, vs = variants_of(d)\n        keys = list(node.keys())\n        untagged = []\n        open_maps = []\n        for n in names:\n            if n not in vs: bad('the union names variant ' + n + ' but does not declare it')\n            v = vs[n]\n            props = v.get('properties')\n            if props is None:\n                if v.get('type') == 'object': open_maps.append(v)\n                continue\n            tags = [(f, x['values'][0]) for f, x in props.items() if isinstance(x.get('values'), list) and len(x['values']) == 1 and ref(x) is None]\n            if not tags:\n                untagged.append(v)\n                continue\n            if all(isinstance(node.get(f), str) and node.get(f) == t for f, t in tags): return v\n        fits = [v for v in untagged if v.get('properties') is not None and all(k in v['properties'] for k in keys)]\n        if len(fits) > 1:\n            complete = [v for v in fits if all(x.get('required') is not True or k in keys for k, x in v['properties'].items())]\n            if complete: fits = complete\n        if len(fits) == 1: return fits[0]\n        if not fits: return open_maps[0] if len(open_maps) == 1 else map_variant(d)\n        return None\n    def kind(d, v):\n        names, vs = variants_of(d)\n        def fits(x):\n            t = x.get('type')\n            if isinstance(v, list): return t == 'array'\n            if isinstance(v, bool): return t == 'boolean'\n            if isinstance(v, (int, float)):\n                whole = v - v == 0 and v == int(v) and -2 ** 63 <= v < 2 ** 63\n                if t == 'number': return True\n                if t == 'int': return whole\n                rng = {'i8': (-128, 127), 'i16': (-32768, 32767), 'i32': (-2 ** 31, 2 ** 31 - 1), 'u8': (0, 255), 'u16': (0, 65535), 'u32': (0, 4294967295), 'u64': (0, 2 ** 63 - 1)}.get(t)\n                if rng is not None: return whole and rng[0] <= v <= rng[1]\n                if t == 'f32': return v - v == 0 and abs(v) <= 3.4028234663852886e38\n                return t == 'f64' and v - v == 0\n            if isinstance(v, str): return t == 'string' and (x.get('values') is None or v in x['values'])\n            return False\n        m = [vs[n] for n in names if n in vs and fits(vs[n])]\n        if len(m) == 1: return m[0]\n        if not m: raise TypeError('expected ' + shape)\n        return None\n    def expand(v):\n        ft = dfn.get('type')\n        if isinstance(v, dict):\n            if ft == 'union': chosen = select(dfn, v)\n            elif ft == 'object': chosen = dfn\n            else: bad('the definition is not a struct or a tagged union')\n        elif ft == 'union': chosen = kind(dfn, v)\n        elif isinstance(v, list) and ft == 'array': chosen = dfn\n        else: raise TypeError('expected ' + shape)\n        if chosen is None: return None\n        children = []\n        if isinstance(v, list):\n            if ref(chosen.get('items')) == root:\n                children.extend(v)\n                plan = ('list',)\n            else: plan = ('leaf',)\n        elif isinstance(v, dict) and is_map(chosen):\n            if ref(chosen.get('items')) == root:\n                children.extend(v.values())\n                plan = ('map', list(v.keys()))\n            else: plan = ('leaf',)\n        elif isinstance(v, dict):\n            fields = chosen.get('properties')\n            if fields is None: bad('the definition declares no fields')\n            slots = []\n            for k, c in v.items():\n                pos = position(fields.get(k))\n                if pos is None or c is None: continue\n                if pos == 'field':\n                    children.append(c)\n                    slots.append((k, ('field',)))\n                elif pos == 'list':\n                    if not isinstance(c, list): raise TypeError('expected [' + shape + ']')\n                    children.extend(c)\n                    slots.append((k, ('list', len(c))))\n                else:\n                    if not isinstance(c, dict): raise TypeError('expected Map string ' + shape)\n                    children.extend(c.values())\n                    slots.append((k, ('map', list(c.keys()))))\n            plan = ('fields', slots)\n        else: plan = ('leaf',)\n        return [v, plan, children, []]\n    def run_step(f):\n        v, plan, _, res = f\n        if plan[0] == 'leaf': kids = {}\n        elif plan[0] == 'list': kids = list(res)\n        elif plan[0] == 'map': kids = dict(zip(plan[1], res))\n        else:\n            it = iter(res)\n            kids = {}\n            for k, slot in plan[1]:\n                if slot[0] == 'field': kids[k] = next(it)\n                elif slot[0] == 'list': kids[k] = [next(it) for _ in range(slot[1])]\n                else: kids[k] = {key: next(it) for key in slot[1]}\n        return step(v, kids)\n    if value is None: return None\n    first = expand(value)\n    if first is None: return None\n    stack = [first]\n    while True:\n        top = stack[-1]\n        if len(top[3]) < len(top[2]):\n            child = top[2][len(top[3])]\n            if child is None: top[3].append(None)\n            else:\n                f = expand(child)\n                if f is None: return None\n                stack.append(f)\n            continue\n        done = stack.pop()\n        r = run_step(done)\n        if not stack: return r\n        stack[-1][3].append(r)"], "validate/pattern": ["_RX_SPACE = r'\\t\\n\\x0b\\x0c\\r \\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff'", "_RX_CATS = ('L', 'Lu', 'Ll', 'Lt', 'Lm', 'Lo', 'M', 'Mn', 'Mc', 'Me', 'N', 'Nd', 'Nl', 'No', 'P', 'Pc', 'Pd', 'Ps', 'Pe', 'Pi', 'Pf', 'Po', 'S', 'Sm', 'Sc', 'Sk', 'So', 'Z', 'Zs', 'Zl', 'Zp', 'Cc', 'Cf', 'Co')", "_RX_PROPS = {}", "_RX_CACHE = {}", "def _rx_ranges(name, neg):\n    key = (name, neg)\n    if key not in _RX_PROPS:\n        out = []\n        start = None\n        for c in range(0x110001):\n            ok = c < 0x110000 and not 0xD800 <= c <= 0xDFFF and unicodedata.category(chr(c)).startswith(name) != neg\n            if ok:\n                if start is None: start = c\n            elif start is not None:\n                out.append('\\\\U%08x-\\\\U%08x' % (start, c - 1))\n                start = None\n        _RX_PROPS[key] = ''.join(out)\n    return _RX_PROPS[key]", "def _rx_hex(ch, at, n):\n    d = ch[at:at + n]\n    if len(d) != n or not all(c in '0123456789abcdefABCDEF' for c in d): return None\n    return int(''.join(d), 16)", "def _rx_prop_end(ch, at):\n    if at + 1 >= len(ch) or ch[at + 1] != '{': return None\n    for k in range(at + 2, len(ch)):\n        if ch[k] == '}':\n            return k + 1 if ''.join(ch[at + 2:k]) in _RX_CATS else None\n    return None", "def _rx_atom(ch, at):\n    if at >= len(ch): return None\n    c = ch[at]\n    if c in '[]': return None\n    if c != '\\\\':\n        if c in '&~-' and at + 1 < len(ch) and ch[at + 1] == c: return None\n        return ('c', ord(c), at + 1)\n    if at + 1 >= len(ch): return None\n    e = ch[at + 1]\n    if e == 'd': return ('s', '0-9', at + 2)\n    if e == 'w': return ('s', '0-9A-Za-z_', at + 2)\n    if e == 's': return ('s', _RX_SPACE, at + 2)\n    if e in 'pP':\n        end = _rx_prop_end(ch, at + 1)\n        return None if end is None else ('s', _rx_ranges(''.join(ch[at + 3:end - 1]), e == 'P'), end)\n    if e == '-': return ('c', 45, at + 2)\n    if e in '\\\\^$.*+?()[]{}|/': return ('c', ord(e), at + 2)\n    if e in 'nrtfv': return ('c', ord({'n': '\\n', 'r': '\\r', 't': '\\t', 'f': '\\x0c', 'v': '\\x0b'}[e]), at + 2)\n    if e == 'x':\n        v = _rx_hex(ch, at + 2, 2)\n        return None if v is None else ('c', v, at + 4)\n    if e == 'u':\n        v = _rx_hex(ch, at + 2, 4)\n        return None if v is None or 0xD800 <= v <= 0xDFFF else ('c', v, at + 6)\n    return None", "def _rx_class(ch, start):\n    i = start\n    out = ['[']\n    if i < len(ch) and ch[i] == '^':\n        out.append('^')\n        i += 1\n    if i < len(ch) and ch[i] == ']': return None\n    while i < len(ch):\n        if ch[i] == ']':\n            out.append(']')\n            return ''.join(out), i + 1\n        a = _rx_atom(ch, i)\n        if a is None: return None\n        kind, val, i = a\n        rng = i < len(ch) and ch[i] == '-' and (i + 1 >= len(ch) or ch[i + 1] != ']')\n        if kind == 's':\n            if rng: return None\n            out.append(val)\n        else:\n            out.append('\\\\U%08x' % val)\n            if rng:\n                b = _rx_atom(ch, i + 1)\n                if b is None or b[0] != 'c' or val > b[1]: return None\n                out.append('-\\\\U%08x' % b[1])\n                i = b[2]\n    return None", "def _rx_braces(ch, at):\n    n = len(ch)\n    def num(i):\n        j = i\n        while j < n and ch[j] in '0123456789': j += 1\n        return (None, i) if j == i else (int(''.join(ch[i:j])), j)\n    low, i = num(at + 1)\n    if low is None or low > 1000: return None\n    if i < n and ch[i] == ',':\n        high, j = num(i + 1)\n        i += 1\n        if high is not None:\n            if high > 1000 or high < low: return None\n            i = j\n    if i >= n or ch[i] != '}': return None\n    return ''.join(ch[at:i + 1]), i + 1", "def _rx_translate(p):\n    ch = list(p)\n    n = len(ch)\n    out = []\n    i = 0\n    depth = 0\n    q = False\n    while i < n:\n        c = ch[i]\n        if c == '(':\n            if i + 1 < n and ch[i + 1] == '?':\n                if i + 2 >= n or ch[i + 2] != ':': return None\n                out.append('(?:')\n                i += 3\n            else:\n                out.append('(')\n                i += 1\n            depth += 1\n            q = False\n        elif c == ')':\n            if depth == 0: return None\n            depth -= 1\n            out.append(')')\n            i += 1\n            q = True\n        elif c in '|^$':\n            out.append({'|': '|', '^': r'\\A', '$': r'\\Z'}[c])\n            i += 1\n            q = False\n        elif c in '*+?{':\n            if not q: return None\n            if c == '{':\n                r = _rx_braces(ch, i)\n                if r is None: return None\n                out.append(r[0])\n                i = r[1]\n            else:\n                out.append(c)\n                i += 1\n            if i < n and ch[i] == '?':\n                out.append('?')\n                i += 1\n            q = False\n        elif c in '}]': return None\n        elif c == '.':\n            out.append(r'[^\\n\\r\\u2028\\u2029]')\n            i += 1\n            q = True\n        elif c == '[':\n            r = _rx_class(ch, i + 1)\n            if r is None: return None\n            out.append(r[0])\n            i = r[1]\n            q = True\n        elif c == '\\\\':\n            if i + 1 >= n: return None\n            e = ch[i + 1]\n            if e == 'b': out.append(r'(?a:\\b)')\n            elif e == 'B': out.append(r'(?a:\\B)')\n            elif e == 'd': out.append('[0-9]')\n            elif e == 'D': out.append('[^0-9]')\n            elif e == 'w': out.append('[0-9A-Za-z_]')\n            elif e == 'W': out.append('[^0-9A-Za-z_]')\n            elif e == 's': out.append('[' + _RX_SPACE + ']')\n            elif e == 'S': out.append('[^' + _RX_SPACE + ']')\n            elif e in 'pP':\n                end = _rx_prop_end(ch, i + 1)\n                if end is None: return None\n                out.append('[' + _rx_ranges(''.join(ch[i + 3:end - 1]), e == 'P') + ']')\n                i = end\n                q = True\n                continue\n            elif e == 'x' or e == 'u':\n                w = 2 if e == 'x' else 4\n                v = _rx_hex(ch, i + 2, w)\n                if v is None or (e == 'u' and 0xD800 <= v <= 0xDFFF): return None\n                out.append('\\\\U%08x' % v)\n                i += 2 + w\n                q = True\n                continue\n            elif e in '\\\\^$.*+?()[]{}|/': out.append(re.escape(e))\n            elif e in 'nrtfv': out.append('\\\\' + e)\n            else: return None\n            i += 2\n            q = e not in 'bB'\n        else:\n            out.append(re.escape(c))\n            i += 1\n            q = True\n    return ''.join(out) if depth == 0 else None", "def _rx(p):\n    if p not in _RX_CACHE:\n        t = _rx_translate(p)\n        try: _RX_CACHE[p] = None if t is None else re.compile(t)\n        except re.error: _RX_CACHE[p] = None\n    return _RX_CACHE[p]", "def _rx_test(t, p):\n    r = _rx(p)\n    return r is not None and r.search(t) is not None", "def _pat_test(v, p):\n    if not isinstance(v, str) or not isinstance(p, str): raise TypeError('expected string')\n    return _rx_test(v, p)"], "validate/email": ["_RX_SPACE = r'\\t\\n\\x0b\\x0c\\r \\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff'", "_RX_CATS = ('L', 'Lu', 'Ll', 'Lt', 'Lm', 'Lo', 'M', 'Mn', 'Mc', 'Me', 'N', 'Nd', 'Nl', 'No', 'P', 'Pc', 'Pd', 'Ps', 'Pe', 'Pi', 'Pf', 'Po', 'S', 'Sm', 'Sc', 'Sk', 'So', 'Z', 'Zs', 'Zl', 'Zp', 'Cc', 'Cf', 'Co')", "_RX_PROPS = {}", "_RX_CACHE = {}", "def _rx_ranges(name, neg):\n    key = (name, neg)\n    if key not in _RX_PROPS:\n        out = []\n        start = None\n        for c in range(0x110001):\n            ok = c < 0x110000 and not 0xD800 <= c <= 0xDFFF and unicodedata.category(chr(c)).startswith(name) != neg\n            if ok:\n                if start is None: st