app std-lolo-typescript [
  version: "1.0.0",
  description: "std-lolo-typescript \u{2014} renders .lolo source as TypeScript text, so a learner who reads an exercise written in .lolo can see the same program as strict TypeScript that type-checks and gives the kernel's answers. It is std-lolo-source with the TypeScript vocabulary in config and nothing else: LOLO_TO_TYPESCRIPT { source, path } answers TYPESCRIPT_RENDERED { text, warnings }, or TYPESCRIPT_RENDER_FAILED { error } when the source cannot be read or the request carries no absolute path (the types come from the kernel checker). Each trait becomes an exported class holding state, entity, ports and config, with one on<Event> method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records { event, payload } in emitted with the payload checked against the shell's generated payload type. The entity and payload types are imported from ../types/entities and ../types/events, the modules of the TypeScript shell's generated @app/shared package, so the file belongs in packages/shared/src/traits/. Kernel answers that are null (a division by zero, nth past the end, a missing key) come from small helper functions written once, and only the ones the output uses. Strings are measured and sliced by Unicode code points. object/get and json/parse are cast to the checker's type of the call (typeNames). An operator with no TypeScript template is a named warning and a stub that throws when run. persist, fetch, notify, navigate and call-service go through callPort on the injected ports object and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-typescript"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloTypescriptOrbital {
  entity LoloTypescriptRun [runtime] {
    id : string!
  }

  trait LoloTypescript = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_TYPESCRIPT
      SOURCE_RENDERED: TYPESCRIPT_RENDERED
      SOURCE_RENDER_FAILED: TYPESCRIPT_RENDER_FAILED
    }
    config {
      language: "TypeScript"
      requiresTypes: true
      operators: { "/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "=": "_eq({{0}}, {{1}})", "==": "_eq({{0}}, {{1}})", "!=": "(!_eq({{0}}, {{1}}))", "str/len": "[...{{0}}].length", "str/upper": "{{0}}.toUpperCase()", "str/lower": "{{0}}.toLowerCase()", "str/trim": "{{0}}.trim()", "str/trimStart": "{{0}}.trimStart()", "str/trimEnd": "{{0}}.trimEnd()", "str/capitalize": "_capitalize({{0}})", "str/split": "_split({{0}}, {{1}})", "str/join": "_join({{0}}, {{1}})", "str/concat": "[{{*}}].map(_text).join('')", "str/includes": "{{0}}.includes({{1}})", "str/startsWith": "{{0}}.startsWith({{1}})", "str/endsWith": "{{0}}.endsWith({{1}})", "str/replace": "_replace({{0}}, {{1}}, {{2}})", "str/replaceAll": "_replaceAll({{0}}, {{1}}, {{2}})", "str/repeat": "_repeat({{0}}, {{1}})", "str/reverse": "[...{{0}}].reverse().join('')", "str/slice#2": "_strSlice({{0}}, {{1}})", "str/slice#3": "_strSlice({{0}}, {{1}}, {{2}})", "str/padStart#2": "_padStart({{0}}, {{1}})", "str/padStart#3": "_padStart({{0}}, {{1}}, {{2}})", "str/padEnd#2": "_padEnd({{0}}, {{1}})", "str/padEnd#3": "_padEnd({{0}}, {{1}}, {{2}})", "str/truncate#2": "_truncate({{0}}, {{1}})", "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})", "str/to-int": "_toInt({{0}})", "array/len": "{{0}}.length", "array/sum#2": "_sum({{0}}, {{1}})", "array/avg#1": "_avg({{0}})", "array/avg#2": "_avg({{0}}, {{1}})", "array/max#1": "_amax({{0}})", "array/max#2": "_amax({{0}}, {{1}})", "array/min#1": "_amin({{0}})", "array/min#2": "_amin({{0}}, {{1}})", "array/first": "_first({{0}})", "array/last": "_last({{0}})", "array/nth": "_nth({{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}})", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice({{0}}, {{1}})", "array/slice#3": "_slice({{0}}, {{1}}, {{2}})", "array/take": "_take({{0}}, {{1}})", "array/drop": "_drop({{0}}, {{1}})", "array/takeLast": "_takeLast({{0}}, {{1}})", "array/dropLast": "_dropLast({{0}}, {{1}})", "array/append": "[...{{0}}, {{1}}]", "array/prepend": "[{{1}}, ...{{0}}]", "array/includes": "_includes({{0}}, {{1}})", "array/indexOf": "_indexOf({{0}}, {{1}})", "array/reverse": "[...{{0}}].reverse()", "array/unique": "_unique({{0}})", "array/flatten": "{{0}}.flat()", "array/zip": "_zip({{0}}, {{1}})", "array/concat": "_concat({{*}})", "array/sort#1": "_sort({{0}})", "array/sort#2": "_sort({{0}}, {{1}})", "array/sort#3": "_sort({{0}}, {{1}}, {{2}})", "array/reduce": "{{0}}.reduce({{2}}, {{1}})", "list": "[{{*}}]", "object/get#2": "(_get({{0}}, {{1}}) as {{type}})", "object/get#3": "(_get({{0}}, {{1}}, {{2}}) as {{type}})", "object/has": "_has({{0}}, {{1}})", "object/set": "(_set({{0}}, {{1}}, {{2}}) as {{type}})", "object/keys": "Object.keys({{0}})", "object/values": "Object.values({{0}})", "object/entries": "Object.entries({{0}})", "object/fromEntries": "(_fromEntries({{0}}) as {{type}})", "object/merge": "(_merge({{*}}) as {{type}})", "object/pick": "(_pick({{0}}, {{1}}) as {{type}})", "object/omit": "(_omit({{0}}, {{1}}) as {{type}})", "json/parse": "(_jsonParse({{0}}) as {{type}})", "json/stringify#1": "JSON.stringify({{0}})", "math/abs": "Math.abs({{0}})", "math/max": "Math.max({{*}})", "math/min": "Math.min({{*}})", "math/round#1": "_round({{0}})", "math/round#2": "_round({{0}}, {{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "Math.sign({{0}})", "math/clamp": "_clamp({{0}}, {{1}}, {{2}})", "default": "({{0}} ?? {{1}})", "as": "{{0}}", "validate/required": "_required({{0}})", "validate/string": "(typeof {{0}} === 'string')", "validate/number": "(typeof {{0}} === 'number')", "validate/array": "Array.isArray({{0}})", "validate/object": "_isObject({{0}})", "validate/boolean": "(typeof {{0}} === 'boolean')", "validate/length": "(_length({{0}}) === {{1}})", "validate/minLength": "(_length({{0}}) >= {{1}})", "validate/maxLength": "(_length({{0}}) <= {{1}})", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "({{1}} <= {{0}} && {{0}} <= {{2}})", "validate/oneOf": "_includes({{1}}, {{0}})", "validate/equals": "_eq({{0}}, {{1}})" }
      unary: { "-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "{{0}}.length", "array/sort": "_sort({{0}})", "json/stringify": "JSON.stringify({{0}})", "math/round": "_round({{0}})", "array/concat": "{{0}}", "object/merge": "{{0}}" }
      infix: { "+": "+", "-": "-", "*": "*", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "{{src}}.map(({{vars}}) => ({{body}}))", "array/filter": "{{src}}.filter(({{vars}}) => ({{body}}))", "array/reject": "{{src}}.filter(({{vars}}) => !({{body}}))", "array/some": "{{src}}.some(({{vars}}) => ({{body}}))", "array/every": "{{src}}.every(({{vars}}) => ({{body}}))", "array/count": "{{src}}.filter(({{vars}}) => ({{body}})).length", "array/find": "_find({{src}}, ({{vars}}) => ({{body}}))", "array/findIndex": "{{src}}.findIndex(({{vars}}) => ({{body}}))" }
      lambdaForm: "({{params}}) => ({{body}})"
      indexedSource: "{{src}}"
      indexedVars: "{{item}}, {{index}}"
      callees: { "math/ceil": "Math.ceil", "math/floor": "Math.floor", "math/sin": "Math.sin", "math/cos": "Math.cos", "math/tan": "Math.tan", "math/atan": "Math.atan", "math/atan2": "Math.atan2", "math/hypot": "Math.hypot" }
      calleeForm: "{{callee}}({{*}})"
      unsupportedForm: "_unsupported({{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: { "payload": ["function _opt<T extends {} | null>(v: T): T;\nfunction _opt<T extends {} | null>(v: T | undefined): T | null;\nfunction _opt<T>(v: T | undefined): T | null {\n  return v === undefined ? null : v;\n}"], "store": ["export interface Answer {\n  ok: boolean;\n  payload: EventPayload;\n}\nexport interface Store {\n  persist(op: string, entity: string, data: EventPayload | string): Answer;\n  fetch(entity: string, keep: ((row: EventPayload) => boolean) | null): Answer;\n}\nfunction _order(a: EventPayload, b: EventPayload): number {\n  const sa = a['createdAt'];\n  const sb = b['createdAt'];\n  const ha = sa !== undefined && sa !== null;\n  const hb = sb !== undefined && sb !== null;\n  if (ha !== hb) return ha ? -1 : 1;\n  if (typeof sa === 'number' && typeof sb === 'number' && sa !== sb) return sa < sb ? -1 : 1;\n  if (typeof sa === 'string' && typeof sb === 'string' && sa !== sb) return sa < sb ? -1 : 1;\n  const ia = String(a['id']);\n  const ib = String(b['id']);\n  return ia < ib ? -1 : ia > ib ? 1 : 0;\n}\nexport class MemoryStore implements Store {\n  readonly tables: Record<string, Map<string, EventPayload>> = {};\n  minted = 0;\n\n  private table(entity: string): Map<string, EventPayload> {\n    const t = this.tables[entity] ?? new Map<string, EventPayload>();\n    this.tables[entity] = t;\n    return t;\n  }\n\n  persist(op: string, entity: string, data: EventPayload | string): Answer {\n    const rows = this.table(entity);\n    if (op === 'create' && typeof data !== 'string') {\n      const row: EventPayload = { ...data };\n      const given = row['id'];\n      const id = typeof given === 'string' && given !== '' ? given : entity + '-' + String((this.minted += 1));\n      row['id'] = id;\n      rows.set(id, row);\n      return { ok: true, payload: { ...row } };\n    }\n    const key = typeof data === 'string' ? data : String(data['id'] ?? '');\n    const found = rows.get(key);\n    if (found === undefined) return { ok: false, payload: { error: entity + ' ' + key + ' not found', code: 'not-found' } };\n    if (op === 'delete') {\n      rows.delete(key);\n      return { ok: true, payload: { id: key, deleted: true } };\n    }\n    const next: EventPayload = typeof data === 'string' ? { ...found } : { ...found, ...data };\n    rows.set(key, next);\n    return { ok: true, payload: { ...next } };\n  }\n\n  fetch(entity: string, keep: ((row: EventPayload) => boolean) | null): Answer {\n    const rows = [...this.table(entity).values()].filter((r) => keep === null || keep({ ...r })).map((r) => ({ ...r }));\n    rows.sort(_order);\n    return { ok: true, payload: { data: rows, totalCount: rows.length } };\n  }\n}"], "router": ["type _Guard = (payload: EventPayload) => boolean;\ntype _Map = (payload: EventPayload) => EventPayload;\ninterface _Routed {\n  readonly state: string;\n  readonly entity: object;\n  readonly emitted: ReadonlyArray<{ event: string; payload: EventPayload; completion?: boolean }>;\n}\ninterface _Item {\n  trait: string;\n  event: string;\n  payload: EventPayload;\n  source: EventPayload;\n  guard: _Guard | null;\n  fans: boolean;\n  completion: boolean;\n}\nfunction _decode<T extends EventPayload>(payload: EventPayload): T {\n  return payload as T;\n}\nfunction _canon(value: object): string {\n  return JSON.stringify(value, (_key: string, v: object | null) =>\n    v !== null && typeof v === 'object' && !Array.isArray(v)\n      ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))\n      : v,\n  );\n}\nabstract class _Router {\n  readonly traits: Record<string, _Routed> = {};\n  readonly handles: Record<string, Record<string, string[]>> = {};\n  readonly rows: Array<{ source: string; event: string; target: string; trigger: string; guard: _Guard | null; mapping: _Map | null }> = [];\n  readonly log: Array<{ trait: string; event: string; payload: EventPayload }> = [];\n\n  add(key: string, trait: _Routed): void {\n    this.traits[key] = trait;\n  }\n\n  row(source: string, event: string, target: string, trigger: string, guard: _Guard | null, mapping: _Map | null): void {\n    this.rows.push({ source, event, target, trigger, guard, mapping });\n  }\n\n  abstract deliver(target: string, event: string, payload: EventPayload): void;\n\n  targets(source: string, event: string, payload: EventPayload, completion: boolean): _Item[] {\n    return this.rows\n      .filter((r) => r.source === source && r.event === event)\n      .map((r) => ({ trait: r.target, event: r.trigger, payload: r.mapping ? r.mapping(payload) : payload, source: payload, guard: r.guard, fans: false, completion }));\n  }\n\n  dispatch(trait: string, event: string, payload: EventPayload): void {\n    const queue: _Item[] = [{ trait, event, payload, source: payload, guard: null, fans: true, completion: false }];\n    const seen = new Set<string>();\n    let steps = 0;\n    for (let item = queue.shift(); item !== undefined; item = queue.shift()) {\n      const t = this.traits[item.trait];\n      if (t === undefined) continue;\n      const key = _canon([item.trait, item.event, t.state, item.payload, t.entity]);\n      if (!item.completion && seen.has(key)) continue;\n      if (item.guard !== null && !item.guard(item.source)) continue;\n      if (steps >= 2000) break;\n      steps += 1;\n      seen.add(key);\n      const n = t.emitted.length;\n      this.deliver(item.trait, item.event, item.payload);\n      const own: _Item[] = [];\n      const fanned: _Item[] = item.fans ? this.targets(item.trait, item.event, item.payload, false) : [];\n      for (const e of t.emitted.slice(n)) {\n        this.log.push({ trait: item.trait, event: e.event, payload: e.payload });\n        if ((this.handles[item.trait]?.[t.state] ?? []).includes(e.event)) {\n          own.push({ trait: item.trait, event: e.event, payload: e.payload, source: e.payload, guard: null, fans: false, completion: e.completion === true });\n        }\n        fanned.push(...this.targets(item.trait, e.event, e.payload, e.completion === true));\n      }\n      queue.unshift(...own);\n      queue.push(...fanned);\n    }\n  }\n}"], "/": ["function _div(a: number, b: number): number | null {\n  return b === 0 ? null : a / b;\n}"], "%": ["function _mod(a: number, b: number): number | null {\n  return b === 0 ? null : a % b;\n}"], "math/mod": ["function _mod(a: number, b: number): number | null {\n  return b === 0 ? null : a % b;\n}"], "=": ["type Json = null | boolean | number | string | Json[] | { [k: string]: Json };", "function _eq(a: Json | undefined, b: Json | undefined): boolean {\n  const x = a ?? null;\n  const y = b ?? null;\n  if (x === y) return true;\n  if (Array.isArray(x) && Array.isArray(y)) return x.length === y.length && x.every((v, i) => _eq(v, y[i]));\n  if (x !== null && y !== null && typeof x === 'object' && typeof y === 'object' && !Array.isArray(x) && !Array.isArray(y)) {\n    const kx = Object.keys(x);\n    return kx.length === Object.keys(y).length && kx.every((k) => Object.hasOwn(y, k) && _eq(x[k], y[k]));\n  }\n  return false;\n}"], "==": ["type Json = null | boolean | number | string | Json[] | { [k: string]: Json };", "function _eq(a: Json | undefined, b: Json | undefined): boolean {\n  const x = a ?? null;\n  const y = b ?? null;\n  if (x === y) return true;\n  if (Array.isArray(x) && Array.isArray(y)) return x.length === y.length && x.every((v, i) => _eq(v, y[i]));\n  if (x !== null && y !== null && typeof x === 'object' && typeof y === 'object' && !Array.isArray(x) && !Array.isArray(y)) {\n    const kx = Object.keys(x);\n    return kx.length === Object.keys(y).length && kx.every((k) => Object.hasOwn(y, k) && _eq(x[k], y[k]));\n  }\n  return false;\n}"], "!=": ["type Json = null | boolean | number | string | Json[] | { [k: string]: Json };", "function _eq(a: Json | undefined, b: Json | undefined): boolean {\n  const x = a ?? null;\n  const y = b ?? null;\n  if (x === y) return true;\n  if (Array.isArray(x) && Array.isArray(y)) return x.length === y.length && x.every((v, i) => _eq(v, y[i]));\n  if (x !== null && y !== null && typeof x === 'object' && typeof y === 'object' && !Array.isArray(x) && !Array.isArray(y)) {\n    const kx = Object.keys(x);\n    return kx.length === Object.keys(y).length && kx.every((k) => Object.hasOwn(y, k) && _eq(x[k], y[k]));\n  }\n  return false;\n}"], "str/split": ["function _split(s: string, d: string): string[] {\n  return d === '' ? [...s] : s.split(d);\n}"], "str/join": ["function _text(v: string | number | boolean): string {\n  return String(v);\n}", "function _join(a: ReadonlyArray<string | number | boolean>, d: string): string {\n  return a.map(_text).join(d);\n}"], "str/concat": ["function _text(v: string | number | boolean): string {\n  return String(v);\n}"], "str/replace": ["function _replace(s: string, a: string, b: string): string {\n  const i = s.indexOf(a);\n  return i < 0 ? s : s.slice(0, i) + b + s.slice(i + a.length);\n}"], "str/replaceAll": ["function _replaceAll(s: string, a: string, b: string): string {\n  return a === '' ? b + [...s].map((c) => c + b).join('') : s.split(a).join(b);\n}"], "str/repeat": ["function _nat(n: number): number {\n  if (!Number.isInteger(n) || n < 0) throw new RangeError('expected a whole number from 0, got ' + n);\n  return n;\n}", "function _repeat(s: string, n: number): string {\n  return s.repeat(_nat(n));\n}"], "str/capitalize": ["function _capitalize(s: string): string {\n  const cs = [...s];\n  return (cs[0] ?? '').toUpperCase() + cs.slice(1).join('').toLowerCase();\n}"], "str/slice": ["function _whole(n: number): number {\n  if (!Number.isInteger(n)) throw new RangeError('expected a whole number, got ' + n);\n  return n;\n}", "function _strSlice(s: string, a: number, b?: number): string {\n  _whole(a);\n  if (b !== undefined) _whole(b);\n  return [...s].slice(a, b).join('');\n}"], "str/padStart": ["function _nat(n: number): number {\n  if (!Number.isInteger(n) || n < 0) throw new RangeError('expected a whole numb