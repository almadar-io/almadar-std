app std-lolo-typescript [
  version: "1.0.0",
  description: "std-lolo-typescript \u{2014} renders .lolo source as TypeScript text, so a learner who reads an exercise written in .lolo can see the same program as strict TypeScript that type-checks and gives the kernel's answers. It is std-lolo-source with the TypeScript vocabulary in config and nothing else: LOLO_TO_TYPESCRIPT { source, path } answers TYPESCRIPT_RENDERED { text, warnings }, or TYPESCRIPT_RENDER_FAILED { error } when the source cannot be read or the request carries no absolute path (the types come from the kernel checker). Each trait becomes an exported class holding state, entity, ports and config, with one on<Event> method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records { event, payload } in emitted with the payload checked against the shell's generated payload type. The entity and payload types are imported from ../types/entities and ../types/events, the modules of the TypeScript shell's generated @app/shared package, so the file belongs in packages/shared/src/traits/. Kernel answers that are null (a division by zero, nth past the end, a missing key) come from small helper functions written once, and only the ones the output uses. Strings are measured and sliced by Unicode code points. object/get and json/parse are cast to the checker's type of the call (typeNames). An operator with no TypeScript template is a named warning and a stub that throws when run. persist, fetch, notify, navigate and call-service go through callPort on the injected ports object and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-typescript"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloTypescriptOrbital {
  entity LoloTypescriptRun [runtime] {
    id : string!
  }

  trait LoloTypescript = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_TYPESCRIPT
      SOURCE_RENDERED: TYPESCRIPT_RENDERED
      SOURCE_RENDER_FAILED: TYPESCRIPT_RENDER_FAILED
    }
    config {
      language: "TypeScript"
      requiresTypes: true
      operators: {"/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "=": "_eq({{0}}, {{1}})", "==": "_eq({{0}}, {{1}})", "!=": "(!_eq({{0}}, {{1}}))", "str/len": "[...{{0}}].length", "str/upper": "{{0}}.toUpperCase()", "str/lower": "{{0}}.toLowerCase()", "str/trim": "{{0}}.trim()", "str/trimStart": "{{0}}.trimStart()", "str/trimEnd": "{{0}}.trimEnd()", "str/capitalize": "_capitalize({{0}})", "str/split": "_split({{0}}, {{1}})", "str/join": "_join({{0}}, {{1}})", "str/concat": "[{{*}}].map(_text).join('')", "str/includes": "{{0}}.includes({{1}})", "str/startsWith": "{{0}}.startsWith({{1}})", "str/endsWith": "{{0}}.endsWith({{1}})", "str/replace": "_replace({{0}}, {{1}}, {{2}})", "str/replaceAll": "_replaceAll({{0}}, {{1}}, {{2}})", "str/repeat": "_repeat({{0}}, {{1}})", "str/reverse": "[...{{0}}].reverse().join('')", "str/slice#2": "_strSlice({{0}}, {{1}})", "str/slice#3": "_strSlice({{0}}, {{1}}, {{2}})", "str/padStart#2": "_padStart({{0}}, {{1}})", "str/padStart#3": "_padStart({{0}}, {{1}}, {{2}})", "str/padEnd#2": "_padEnd({{0}}, {{1}})", "str/padEnd#3": "_padEnd({{0}}, {{1}}, {{2}})", "str/truncate#2": "_truncate({{0}}, {{1}})", "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})", "str/to-int": "_toInt({{0}})", "array/len": "{{0}}.length", "array/sum#2": "_sum({{0}}, {{1}})", "array/avg#1": "_avg({{0}})", "array/avg#2": "_avg({{0}}, {{1}})", "array/max#1": "_amax({{0}})", "array/max#2": "_amax({{0}}, {{1}})", "array/min#1": "_amin({{0}})", "array/min#2": "_amin({{0}}, {{1}})", "array/first": "_first({{0}})", "array/last": "_last({{0}})", "array/nth": "_nth({{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}})", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice({{0}}, {{1}})", "array/slice#3": "_slice({{0}}, {{1}}, {{2}})", "array/take": "_take({{0}}, {{1}})", "array/drop": "_drop({{0}}, {{1}})", "array/takeLast": "_takeLast({{0}}, {{1}})", "array/dropLast": "_dropLast({{0}}, {{1}})", "array/append": "[...{{0}}, {{1}}]", "array/prepend": "[{{1}}, ...{{0}}]", "array/includes": "_includes({{0}}, {{1}})", "array/indexOf": "_indexOf({{0}}, {{1}})", "array/reverse": "[...{{0}}].reverse()", "array/unique": "_unique({{0}})", "array/flatten": "{{0}}.flat()", "array/zip": "_zip({{0}}, {{1}})", "array/concat": "_concat({{*}})", "array/sort#1": "_sort({{0}})", "array/sort#2": "_sort({{0}}, {{1}})", "array/sort#3": "_sort({{0}}, {{1}}, {{2}})", "array/reduce": "{{0}}.reduce<{{type}}>({{2}}, {{1}})", "list": "[{{*}}]", "object/get#2": "(_get({{0}}, {{1}}) as {{type}})", "object/get#3": "(_get({{0}}, {{1}}, {{2}}) as {{type}})", "object/has": "_has({{0}}, {{1}})", "object/set": "_set({{0}}, {{1}}, {{2}})", "object/keys": "Object.keys({{0}})", "object/values": "Object.values({{0}})", "object/entries": "Object.entries({{0}})", "object/fromEntries": "(_fromEntries({{0}}) as {{type}})", "object/merge": "_merge({{*}})", "object/pick": "_pick({{0}}, {{1}})", "object/omit": "_omit({{0}}, {{1}})", "json/parse": "_jsonParse({{0}})", "json/stringify#1": "JSON.stringify({{0}})", "math/abs": "Math.abs({{0}})", "math/max": "Math.max({{*}})", "math/min": "Math.min({{*}})", "math/round#1": "_round({{0}})", "math/round#2": "_round({{0}}, {{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "Math.sign({{0}})", "math/clamp": "_clamp({{0}}, {{1}}, {{2}})", "default": "_default({{0}}, {{1}})", "as": "{{0}}", "validate/required": "_required({{0}})", "validate/string": "(typeof {{0}} === 'string')", "validate/number": "(typeof {{0}} === 'number')", "validate/array": "Array.isArray({{0}})", "validate/object": "_isObject({{0}})", "validate/boolean": "(typeof {{0}} === 'boolean')", "validate/length": "(_length({{0}}) === {{1}})", "validate/minLength": "(_length({{0}}) >= {{1}})", "validate/maxLength": "(_length({{0}}) <= {{1}})", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "({{1}} <= {{0}} && {{0}} <= {{2}})", "validate/oneOf": "_includes({{1}}, {{0}})", "validate/equals": "_eq({{0}}, {{1}})", "math/acos": "_acos({{0}})", "math/asin": "_asin({{0}})", "math/approach": "_approach({{0}}, {{1}}, {{2}})", "math/deg-rad": "({{0}} * Math.PI / 180)", "math/rad-deg": "({{0}} * 180 / Math.PI)", "math/lerp": "_lerp({{0}}, {{1}}, {{2}})", "math/map": "_map({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "math/wrap": "_wrap({{0}}, {{1}}, {{2}})", "math/random": "Math.random()", "math/randomInt": "_randomInt({{0}}, {{1}})", "str/titleCase": "_titleCase({{0}})", "str/camelCase": "_camelCase({{0}})", "str/kebabCase": "_caseWords({{0}}).join('-')", "str/snakeCase": "_caseWords({{0}}).join('_')", "str/to-number": "_toNumber({{0}})", "str/template": "_template({{0}}, {{1}})", "str/collate": "_collate({{0}}, {{1}})", "str/encode-uri-component": "encodeURIComponent({{0}})", "str/decode-uri-component": "_decodeUri({{0}})", "str/uri-component-valid": "(_decodeUri({{0}}) !== null)", "str/replace-pattern": "_replacePattern({{0}}, {{1}}, {{2}})", "math/tan": "_libm_tan({{0}})", "array/insert": "_insert({{0}}, {{1}}, {{2}})", "array/remove": "_remove({{0}}, {{1}})", "array/removeItem": "_removeItem({{0}}, {{1}})", "array/shuffle": "_shuffle({{0}})", "array/cosine": "_cosine({{0}}, {{1}})", "array/nearest": "_nearest({{0}}, {{1}})", "array/groupBy": "_groupByField({{0}}, {{1}})", "array/preduce": "_preduce({{0}}, {{1}}, {{2}})", "object/clone": "({ ...{{0}} })", "object/deepClone": "structuredClone({{0}})", "object/deepMerge": "_deepMerge({{*}})", "object/equals": "_eq({{0}}, {{1}})", "json/nodes": "_nodes({{0}})", "json/valid": "_jsonValid({{0}})", "validate/email": "_semanticEmail({{0}})", "validate/url": "_semanticUrl({{0}})", "validate/phone": "_semanticPhone({{0}})", "validate/uuid": "_semanticUuid({{0}})", "validate/pattern": "_validatePattern({{0}}, {{1}})", "validate/date": "_validateDate({{0}})", "validate/creditCard": "_luhn({{0}})", "validate/noneOf": "(!_includes({{1}}, {{0}}))", "validate/check": "_check({{0}}, {{1}})", "json/stringify#2": "_stringify({{0}}, {{1}})", "ease/apply": "_ease({{0}}, {{1}})", "ease/smoothstep": "_smoothstep({{0}}, {{1}}, {{2}})", "anim/frame-at#3": "_frameAt({{0}}, {{1}}, {{2}})", "anim/frame-at#4": "_frameAt({{0}}, {{1}}, {{2}}, {{3}})", "anim/sheet-rect": "_sheetRect({{0}}, {{1}}, {{2}}, {{3}})", "anim/direction-from-delta#2": "_directionFromDelta({{0}}, {{1}})", "anim/direction-from-delta#3": "_directionFromDelta({{0}}, {{1}}, {{2}})", "vec/add": "_vadd({{0}}, {{1}})", "vec/sub": "_vsub({{0}}, {{1}})", "vec/scale": "_vscale({{0}}, {{1}})", "vec/dot": "_dot3({{0}}, {{1}})", "vec/cross": "_vcross({{0}}, {{1}})", "vec/length": "Math.sqrt(_dot3({{0}}, {{0}}))", "vec/length-sq": "_dot3({{0}}, {{0}})", "vec/normalize": "_vnormalize({{0}})", "vec/distance": "Math.sqrt(_dist2({{0}}, {{1}}))", "vec/distance-sq": "_dist2({{0}}, {{1}})", "vec/lerp": "_vlerp({{0}}, {{1}}, {{2}})", "vec/angle#1": "Math.atan2({{0}}.y, {{0}}.x)", "vec/angle#2": "_vangle({{0}}, {{1}})", "vec/rotate": "_vrotate({{0}}, {{1}})", "vec/clamp-length": "_vclamp({{0}}, {{1}})", "geo/aabb-overlap": "_aabb({{0}}, {{1}})", "geo/circle-overlap": "_circleOverlap({{0}}, {{1}})", "geo/rect-circle-overlap": "_rectCircle({{0}}, {{1}})", "geo/point-in-rect": "_pointInRect({{0}}, {{1}})", "geo/point-in-circle": "_pointInCircle({{0}}, {{1}})", "geo/reflect": "_reflect({{0}}, {{1}})", "geo/segment-intersect": "_segmentIntersect({{0}}, {{1}})", "grid/to-world": "_toWorld({{0}}, {{1}})", "grid/from-world": "_fromWorld({{0}}, {{1}})", "grid/iso-to-screen": "_isoToScreen({{0}}, {{1}}, {{2}})", "grid/screen-to-iso": "_screenToIso({{0}}, {{1}}, {{2}})", "grid/distance": "Math.max(Math.abs({{0}}.x - {{1}}.x), Math.abs({{0}}.y - {{1}}.y))", "grid/manhattan-distance": "(Math.abs({{0}}.x - {{1}}.x) + Math.abs({{0}}.y - {{1}}.y))", "grid/neighbors#1": "_neighbors({{0}})", "grid/neighbors#2": "_neighbors({{0}}, {{1}})", "grid/cells-in-radius": "_cellsInRadius({{0}}, {{1}})", "grid/line": "_gridLine({{0}}, {{1}})", "grid/in-bounds": "_inBounds({{0}}, {{1}}, {{2}})", "base64/encode": "_b64Encode({{0}})", "base64/decode": "_b64Decode({{0}})", "base64/valid": "(_b64Decode({{0}}) !== null)", "bit/and": "_bitFold((a, b) => a & b, {{*}})", "bit/or": "_bitFold((a, b) => a | b, {{*}})", "bit/xor": "_bitFold((a, b) => a ^ b, {{*}})", "bit/not": "_bitNot({{0}})", "bit/shl": "_bitShift((a, n) => a << n, {{0}}, {{1}})", "bit/shr": "_bitShift((a, n) => a >>> n, {{0}}, {{1}})", "bit/rotl": "_bitShift((a, n) => (a << n) | (a >>> (32 - n)), {{0}}, {{1}})", "bit/rotr": "_bitShift((a, n) => (a >>> n) | (a << (32 - n)), {{0}}, {{1}})", "format/number#1": "_formatNumber({{0}})", "format/number#2": "_formatNumber({{0}}, {{1}})", "format/percent#1": "_formatPercent({{0}})", "format/percent#2": "_formatPercent({{0}}, {{1}})", "format/currency#2": "_formatCurrency({{0}}, {{1}})", "format/currency#3": "_formatCurrency({{0}}, {{1}}, {{2}})", "format/bytes": "_formatBytes({{0}})", "format/list#1": "_formatList({{0}})", "format/list#2": "_formatList({{0}}, {{1}})", "format/phone#1": "_formatPhone({{0}})", "format/phone#2": "_formatPhone({{0}}, {{1}})", "format/ordinal": "_ordinal({{0}})", "format/plural": "_plural({{0}}, {{1}}, {{2}})", "format/creditCard": "_maskCard({{0}})", "noise/perlin#2": "_perlin({{0}}, {{1}}, 0)", "noise/perlin#3": "_perlin({{0}}, {{1}}, {{2}})", "noise/simplex#2": "_simplex({{0}}, {{1}}, 0)", "noise/simplex#3": "_simplex({{0}}, {{1}}, {{2}})", "noise/fbm#3": "_fbm({{0}}, {{1}}, {{2}}, 0)", "noise/fbm#4": "_fbm({{0}}, {{1}}, {{2}}, {{3}})", "path/astar#5": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "path/astar#6": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "path/reachable#5": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "path/reachable#6": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "prob/seed": "_probSeed({{0}})", "prob/flip": "_flip({{0}})", "prob/gaussian": "_gaussian({{0}}, {{1}})", "prob/uniform": "_uniform({{0}}, {{1}})", "prob/beta": "_beta({{0}}, {{1}})", "prob/categorical": "_categorical({{0}}, {{1}})", "prob/poisson": "_poisson({{0}})", "prob/sample": "_sample({{0}}, () => ({{1}}))", "prob/expected-value": "_meanOf({{0}})", "prob/variance": "_variance({{0}})", "prob/histogram": "_histogram({{0}}, {{1}})", "prob/percentile": "_percentile({{0}}, {{1}})", "prob/credible-interval": "_credible({{0}}, {{1}})", "time/add": "_timeAdd({{0}}, {{1}}, {{2}})", "time/subtract": "_timeSubtract({{0}}, {{1}}, {{2}})", "time/diff#2": "_timeDiff({{0}}, {{1}})", "time/diff#3": "_timeDiff({{0}}, {{1}}, {{2}})", "time/isBefore": "_timeIsBefore({{0}}, {{1}})", "time/isAfter": "_timeIsAfter({{0}}, {{1}})", "time/isBetween": "_timeIsBetween({{0}}, {{1}}, {{2}})", "time/isSame#2": "_timeIsSame({{0}}, {{1}})", "time/isSame#3": "_timeIsSame({{0}}, {{1}}, {{2}})", "time/parse": "_timeParse({{0}})", "time/valid": "(_parseIso({{0}}) !== null)", "time/format": "_timeFormat({{0}}, {{1}})", "time/year": "_utc(_moment({{0}}).ms).year", "time/month": "_utc(_moment({{0}}).ms).month", "time/day": "_utc(_moment({{0}}).ms).day", "time/weekday": "_utc(_moment({{0}}).ms).weekday", "time/hour": "_timeOfDay({{0}}, 'time/hour').hour", "time/minute": "_timeOfDay({{0}}, 'time/minute').minute", "time/second": "_timeOfDay({{0}}, 'time/second').second", "time/startOf": "_timeStartOf({{0}}, {{1}})", "time/endOf": "_timeEndOf({{0}}, {{1}})", "time/duration": "_timeDuration({{0}})", "time/now": "_renderMoment(Date.now(), 'datetime')", "time/today": "_renderMoment(Math.floor(Date.now() / 86400000) * 86400000, 'datetime')", "time/isFuture": "(_atTime({{0}}, 'time/isFuture') > Date.now())", "time/isPast": "(_atTime({{0}}, 'time/isPast') < Date.now())", "time/isToday": "(Math.floor(_moment({{0}}).ms / 86400000) === Math.floor(Date.now() / 86400000))", "time/relative": "_timeRelative({{0}})", "tree/index#2": "_treeIndex({{0}}, {{1}})", "tree/index#3": "_treeIndex({{0}}, {{1}}, {{2}})", "tree/fold": "null", "str/find-pattern#2": "_findPattern({{0}}, {{1}})", "str/find-pattern#3": "_findPattern({{0}}, {{1}}, {{2}})", "tree/fold#3": "_treeFold({{0}}, {{1}}, {{2}})", "tree/fold#4": "_treeFold({{0}}, {{1}}, {{2}}, {{3}})"}
      unary: {"-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "{{0}}.length", "array/sort": "_sort({{0}})", "json/stringify": "JSON.stringify({{0}})", "math/round": "_round({{0}})", "array/concat": "{{0}}", "object/merge": "{{0}}"}
      infix: {"+": "+", "-": "-", "*": "*", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||"}
      infixForm: "({{*}})"
      lambdaOperators: {"array/map": "{{src}}.map(({{vars}}) => ({{body}}))", "array/filter": "{{src}}.filter(({{vars}}) => ({{body}}))", "array/reject": "{{src}}.filter(({{vars}}) => !({{body}}))", "array/some": "{{src}}.some(({{vars}}) => ({{body}}))", "array/every": "{{src}}.every(({{vars}}) => ({{body}}))", "array/count": "{{src}}.filter(({{vars}}) => ({{body}})).length", "array/find": "_find({{src}}, ({{vars}}) => ({{body}}))", "array/findIndex": "{{src}}.findIndex(({{vars}}) => ({{body}}))", "array/groupBy": "_groupBy({{src}}, ({{vars}}) => ({{body}}))", "array/partition": "_partition({{src}}, ({{vars}}) => ({{body}}))", "array/pmap": "{{src}}.map(({{vars}}) => ({{body}}))", "object/filter": "_objFilter({{src}}, ({{vars}}) => ({{body}}))", "object/mapKeys": "_objMapKeys({{src}}, ({{vars}}) => ({{body}}))", "object/mapValues": "_objMapValues({{src}}, ({{vars}}) => ({{body}}))"}
      lambdaForm: "({{params}}) => ({{body}})"
      indexedSource: "{{src}}"
      indexedVars: "{{item}}, {{index}}"
      callees: {"math/ceil": "Math.ceil", "math/floor": "Math.floor", "math/sin": "_libm_sin", "math/cos": "_libm_cos", "math/tan": "_libm_tan", "math/atan": "_libm_atan", "math/atan2": "_libm_atan2", "math/hypot": "_libm_hypot"}
      calleeForm: "{{callee}}({{*}})"
      unsupportedForm: "_unsupported({{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: {"user": ["export interface IdentityRow {\n  id: string;\n  email?: string;\n  name?: string;\n  role?: string;\n}\nexport class Viewer {\n  id = 'anonymous';\n  email: string | null = null;\n  name: string | null = null;\n  role: string | null = 'anonymous';\n\n  signIn(row: IdentityRow | null): void {\n    this.id = row === null ? 'anonymous' : row.id;\n    this.email = row?.email ?? null;\n    this.name = row?.name ?? null;\n    this.role = row === null ? 'anonymous' : (row.role ?? null);\n  }\n}"], "payload": ["function _opt<T extends {} | null>(v: T): T;\nfunction _opt<T extends {} | null>(v: T | undefined): T | null;\nfunction _opt<T>(v: T | undefined): T | null {\n  return v === undefined ? null : v;\n}"], "store": ["export interface Answer {\n  ok: boolean;\n  payload: EventPayload;\n}\nexport interface Store {\n  persist(op: string, entity: string, data: EventPayload | string): Answer;\n  fetch(entity: string, keep: ((row: EventPayload) => boolean) | null, offset: number | null, limit: number | null): Answer;\n}\nfunction _order(a: EventPayload, b: EventPayload): number {\n  const sa = a['createdAt'];\n  const sb = b['createdAt'];\n  const ha = sa !== undefined && sa !== null;\n  const hb = sb !== undefined && sb !== null;\n  if (ha !== hb) return ha ? -1 : 1;\n  if (typeof sa === 'number' && typeof sb === 'number' && sa !== sb) return sa < sb ? -1 : 1;\n  if (typeof sa === 'string' && typeof sb === 'string' && sa !== sb) return sa < sb ? -1 : 1;\n  const ia = String(a['id']);\n  const ib = String(b['id']);\n  return ia < ib ? -1 : ia > ib ? 1 : 0;\n}\nexport class MemoryStore implements Store {\n  readonly tables: Record<string, Map<string, EventPayload>> = {};\n  minted = 0;\n\n  private table(entity: string): Map<string, EventPayload> {\n    const t = this.tables[entity] ?? new Map<string, EventPayload>();\n    this.tables[entity] = t;\n    return t;\n  }\n\n  persist(op: string, entity: string, data: EventPayload | string): Answer {\n    const rows = this.table(entity);\n    if (op === 'create' && typeof data !== 'string') {\n      const row: EventPayload = { ...data };\n      const given = row['id'];\n      const id = typeof given === 'string' && given !== '' ? given : entity + '-' + String((this.minted += 1));\n      row['id'] = id;\n      rows.set(id, row);\n      return { ok: true, payload: { ...row } };\n    }\n    const key = typeof data === 'string' ? data : String(data['id'] ?? '');\n    const found = rows.get(key);\n    if (found === undefined) return { ok: false, payload: { error: entity + ' ' + key + ' not found', code: 'not-found' } };\n    if (op === 'delete') {\n      rows.delete(key);\n      return { ok: true, payload: { id: key, deleted: true } };\n    }\n    const next: EventPayload = typeof data === 'string' ? { ...found } : { ...found, ...data };\n    rows.set(key, next);\n    return { ok: true, payload: { ...next } };\n  }\n\n  fetch(entity: string, keep: ((row: EventPayload) => boolean) | null, offset: number | null, limit: number | null): Answer {\n    const rows = [...this.table(entity).values()].filter((r) => keep === null || keep({ ...r })).map((r) => ({ ...r }));\n    rows.sort(_order);\n    const start = offset ?? 0;\n    const page = limit === null ? rows.slice(start) : rows.slice(start, start + limit);\n    return { ok: true, payload: { data: page, totalCount: rows.length } };\n  }\n}"], "router": ["type _Guard = (payload: EventPayload) => boolean;\ntype _Map = (payload: EventPayload) => EventPayload;\ninterface _Routed {\n  readonly state: string;\n  readonly entity: object;\n  readonly emitted: ReadonlyArray<{ event: string; payload: EventPayload; completion?: boolean }>;\n}\ninterface _Item {\n  trait: string;\n  event: string;\n  payload: EventPayload;\n  source: EventPayload;\n  guard: _Guard | null;\n  fans: boolean;\n  completion: boolean;\n}\nfunction _decode<T extends EventPayload>(payload: EventPayload): T {\n  return payload as T;\n}\nfunction _canon(value: ob