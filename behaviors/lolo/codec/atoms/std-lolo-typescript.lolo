      typeMap: { "string": "string", "number": "number", "float": "number", "int": "number", "integer": "number", "boolean": "boolean", "bool": "boolean", "date": "string", "datetime": "string", "timestamp": "string", "instant": "string", "duration": "number", "email": "string", "url": "string", "uuid": "string" }
      typeList: "{{0}}[]"
      typeListBare: "Json[]"
      typeDict: "Record<string, {{0}}>"
      typeDictBare: "Record<string, Json>"
      typeLiteral: "{{*}}"
      typeNullable: "{{0}} | null"
      typeAny: "Json"
    }
  }

  page boot as LoloTypescriptStart -> LoloTypescript
}
