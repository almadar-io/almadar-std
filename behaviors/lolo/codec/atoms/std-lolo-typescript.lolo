      classCase: "keep"
      fieldCase: "keep"
      localCase: "keep"
      methodCase: "pascal"
      methodName: "on{{event}}"
      modelImports: { "entity": "import type { EventPayload } from '@almadar/core';\nimport type { {{names}} } from '../types/entities';", "payload": "import type { {{names}} } from '../types/events';" }
      modelImportEach: false
      modelImportSep: ", "
      sectionGap: "\n\n"
      classOpen: "export class {{class}} {"
      classClose: "}"
      classEmpty: ""
      constructor: ["{{i}}state: string = {{initial}};", "{{i}}entity: {{entity}};", "{{i}}readonly ports: Record<string, (...args: EventPayload[string][]) => void>;", "{{i}}readonly config = {{config}};", "{{i}}readonly emitted: Array<{ event: string; payload: EventPayload; completion?: boolean }> = [];", "", "{{i}}constructor(entity: {{entity}}, ports: Record<string, (...args: EventPayload[string][]) => void> = {}, config: Partial<{{class}}['config']> = {}) {", "{{i}}{{i}}this.entity = entity;", "{{i}}{{i}}this.ports = ports;", "{{i}}{{i}}this.config = { ...this.config, ...config };", "{{i}}}"]
      emitMethod: ["{{i}}emit(event: string, payload: EventPayload): void {", "{{i}}{{i}}this.emitted.push({ event, payload });", "{{i}}}", "", "{{i}}callPort(name: string, ...args: EventPayload[string][]): void {", "{{i}}{{i}}const port = this.ports[name];", "{{i}}{{i}}if (port === undefined) throw new Error('no port named ' + name);", "{{i}}{{i}}port(...args);", "{{i}}}"]
      completeMethod: ["", "{{i}}store: Store | null = null;", "", "{{i}}complete(answer: Answer, success: string | null, failure: string | null): void {", "{{i}}{{i}}const route = answer.ok ? success : failure;", "{{i}}{{i}}if (route !== null) this.emitted.push({ event: route, payload: answer.payload, completion: true });", "{{i}}}", "", "{{i}}useStore(): Store {", "{{i}}{{i}}if (this.store === null) throw new Error('no store');", "{{i}}{{i}}return this.store;", "{{i}}}"]
      routedEffects: {"persist": "this.complete(this.useStore().persist({{args}}), {{success}}, {{failure}})", "fetch": "this.complete(this.useStore().fetch({{entity}}, {{filter}}), {{success}}, {{failure}})"}
      fetchAll: "null"
      programStoreParam: ", store: Store = new MemoryStore()"
      programTraitStore: "{{i}}{{i}}const t{{n}} = new {{class}}(entities[{{key}}]);\n{{i}}{{i}}t{{n}}.store = store;\n{{i}}{{i}}this.add({{key}}, t{{n}});"
      methodOpen: "{{i}}{{method}}(payload: {{payloadType}}): void {"
      methodOpenPlain: "{{i}}{{method}}(): void {"
      methodClose: "{{i}}}"
      branchFirst: "{{i}}{{i}}if ({{test}}) {"
      branchNext: "{{i}}{{i}}} else if ({{test}}) {"
      branchClose: "{{i}}{{i}}}"
      branchTest: "{{stateTest}} && {{guard}}"
      branchTestPlain: "{{stateTest}}"
      stateTest: "this.state === {{state}}"
      stateAssign: "this.state = {{state}}"
      bodyPrefix: "{{i}}{{i}}{{i}}"
      renderModels: false
      modelClassOpen: "export interface {{name}} {"
      modelClassClose: "}"
      modelField: "{{i}}{{name}}: {{type}}{{default}};"
      modelAlias: "export type {{name}} = {{type}};"
      typeMap: { "string": "string", "number": "number", "float": "number", "int": "number", "integer": "number", "boolean": "boolean", "bool": "boolean", "date": "string", "datetime": "string", "timestamp": "string", "instant": "string", "duration": "number", "email": "string", "url": "string", "uuid": "string" }
      typeList: "{{0}}[]"
      typeListBare: "Json[]"
      typeDict: "Record<string, {{0}}>"
      typeDictBare: "Record<string, Json>"
      typeLiteral: "{{*}}"
      typeNullable: "{{0}} | null"
      typeAny: "Json"
    }
  }

  page boot as LoloTypescriptStart -> LoloTypescript
}
