          "path/astar": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}\nfileprivate struct _PCell: Hashable { let x: Int; let y: Int }\nfileprivate func _pcell<A: Encodable>(_ a: A) -> _PCell {\n    let p = _fields(a, [\"x\", \"y\"])\n    for n in p { guard n.isFinite && n == n.rounded(.towardZero) else { fatalError(\"a cell is not a whole number\") } }\n    return _PCell(x: Int(p[0]), y: Int(p[1]))\n}\nfileprivate func _pblocked<B: Encodable>(_ b: B) -> Set<_PCell> {\n    let d = try! JSONDecoder().decode([[String: Double]].self, from: JSONEncoder().encode(b))\n    return Set(d.map { _pcell($0) })\n}\nfileprivate func _poffsets(_ diagonal: Bool) -> [(Int, Int)] {\n    var o = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n    if diagonal { o += [(1, -1), (1, 1), (-1, 1), (-1, -1)] }\n    return o\n}\nfileprivate func _pwhole(_ n: Double) -> Int {\n    guard n.isFinite && n == n.rounded(.towardZero) else { fatalError(\"expected a whole number\") }\n    return Int(n)\n}\nfileprivate func _pcells<T: Decodable>(_ cs: [_PCell]) -> [T] { try! JSONDecoder().decode([T].self, from: JSONEncoder().encode(cs.map { [\"x\": Double($0.x), \"y\": Double($0.y)] })) }", "fileprivate struct _ANode { let cell: _PCell; let g: Int; let h: Int; let f: Int; let order: Int }\nfileprivate func _astar<A: Encodable, B: Encodable, K: Encodable, T: Decodable>(_ a: A, _ b: B, _ blocked: K, _ w: Double, _ h: Double, _ diagonal: Bool) -> [T] {\n    let start = _pcell(a), goal = _pcell(b)\n    let block = _pblocked(blocked)\n    let w = _pwhole(w), h = _pwhole(h)\n    let offs = _poffsets(diagonal)\n    func heuristic(_ c: _PCell) -> Int {\n        let dx = abs(c.x - goal.x), dy = abs(c.y - goal.y)\n        return diagonal ? max(dx, dy) : dx + dy\n    }\n    var counter = 0\n    var open: [_ANode] = []\n    var cameFrom: [_PCell: _PCell] = [:]\n    var gScore: [_PCell: Int] = [:]\n    var closed = Set<_PCell>()\n    let h0 = heuristic(start)\n    open.append(_ANode(cell: start, g: 0, h: h0, f: h0, order: counter))\n    counter += 1\n    gScore[start] = 0\n    while !open.isEmpty {\n        var best = 0\n        for i in 1..<max(open.count, 1) {\n            let n = open[i], bn = open[best]\n            if n.f < bn.f || (n.f == bn.f && n.h < bn.h) || (n.f == bn.f && n.h == bn.h && n.order < bn.order) { best = i }\n        }\n        let current = open.remove(at: best)\n        if current.cell == goal {\n            var path = [goal]\n            var k = goal\n            while let prev = cameFrom[k] { path.append(prev); k = prev }\n            return _pcells(path.reversed())\n        }\n        closed.insert(current.cell)\n        for (dx, dy) in offs {\n            let nb = _PCell(x: current.cell.x + dx, y: current.cell.y + dy)\n            if nb.x < 0 || nb.x >= w || nb.y < 0 || nb.y >= h { continue }\n            if block.contains(nb) || closed.contains(nb) { continue }\n            let tentative = current.g + 1\n            if let known = gScore[nb], tentative >= known { continue }\n            cameFrom[nb] = current.cell\n            gScore[nb] = tentative\n            let hh = heuristic(nb)\n            open.append(_ANode(cell: nb, g: tentative, h: hh, f: tentative + hh, order: counter))\n            counter += 1\n        }\n    }\n    return []\n}"],
          "path/reachable": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}\nfileprivate struct _PCell: Hashable { let x: Int; let y: Int }\nfileprivate func _pcell<A: Encodable>(_ a: A) -> _PCell {\n    let p = _fields(a, [\"x\", \"y\"])\n    for n in p { guard n.isFinite && n == n.rounded(.towardZero) else { fatalError(\"a cell is not a whole number\") } }\n    return _PCell(x: Int(p[0]), y: Int(p[1]))\n}\nfileprivate func _pblocked<B: Encodable>(_ b: B) -> Set<_PCell> {\n    let d = try! JSONDecoder().decode([[String: Double]].self, from: JSONEncoder().encode(b))\n    return Set(d.map { _pcell($0) })\n}\nfileprivate func _poffsets(_ diagonal: Bool) -> [(Int, Int)] {\n    var o = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n    if diagonal { o += [(1, -1), (1, 1), (-1, 1), (-1, -1)] }\n    return o\n}\nfileprivate func _pwhole(_ n: Double) -> Int {\n    guard n.isFinite && n == n.rounded(.towardZero) else { fatalError(\"expected a whole number\") }\n    return Int(n)\n}\nfileprivate func _pcells<T: Decodable>(_ cs: [_PCell]) -> [T] { try! JSONDecoder().decode([T].self, from: JSONEncoder().encode(cs.map { [\"x\": Double($0.x), \"y\": Double($0.y)] })) }", "fileprivate func _reachable<A: Encodable, K: Encodable, T: Decodable>(_ a: A, _ steps: Double, _ blocked: K, _ w: Double, _ h: Double, _ diagonal: Bool) -> [T] {\n    let start = _pcell(a)\n    let steps = _pwhole(steps), w = _pwhole(w), h = _pwhole(h)\n    let block = _pblocked(blocked)\n    let offs = _poffsets(diagonal)\n    var visited: Set<_PCell> = [start]\n    var result = [start]\n    var frontier: [(_PCell, Int)] = [(start, 0)]\n    var idx = 0\n    while idx < frontier.count {\n        let (cell, dist) = frontier[idx]\n        idx += 1\n        if dist >= steps { continue }\n        for (dx, dy) in offs {\n            let nb = _PCell(x: cell.x + dx, y: cell.y + dy)\n            if nb.x < 0 || nb.x >= w || nb.y < 0 || nb.y >= h { continue }\n            if block.contains(nb) || visited.contains(nb) { continue }\n            visited.insert(nb)\n            result.append(nb)\n            frontier.append((nb, dist + 1))\n        }\n    }\n    result.sort { $0.y != $1.y ? $0.y < $1.y : $0.x < $1.x }\n    return _pcells(result)\n}"],
          "json/valid": ["fileprivate func _json_valid(_ text: String) -> Bool {\n    let b = Array(text.utf8)\n    var i = 0\n    func ws() { while i < b.count, b[i] == 32 || b[i] == 9 || b[i] == 10 || b[i] == 13 { i += 1 } }\n    func hex4() -> UInt32? {\n        guard i + 4 <= b.count else { return nil }\n        var v: UInt32 = 0\n        for k in 0..<4 {\n            let c = b[i + k]\n            let d: UInt32\n            switch c {\n            case 48...57: d = UInt32(c) - 48\n            case 97...102: d = UInt32(c) - 87\n            case 65...70: d = UInt32(c) - 55\n            default: return nil\n            }\n            v = v * 16 + d\n        }\n        i += 4\n        return v\n    }\n    func str() -> Bool {\n        i += 1\n        while i < b.count {\n            let c = b[i]\n            if c == 34 { i += 1; return true }\n            if c < 32 { return false }\n            if c == 92 {\n                i += 1\n                guard i < b.count else { return false }\n                switch b[i] {\n                case 34, 92, 47, 98, 102, 110, 114, 116: i += 1\n                case 117:\n                    i += 1\n                    guard let u = hex4() else { return false }\n                    if u >= 0xD800 && u <= 0xDBFF {\n                        guard i + 1 < b.count, b[i] == 92, b[i + 1] == 117 else { return false }\n                        i += 2\n                        guard let lo = hex4(), lo >= 0xDC00, lo <= 0xDFFF else { return false }\n                    } else if u >= 0xDC00 && u <= 0xDFFF { return false }\n                default: return false\n                }\n            } else { i += 1 }\n        }\n        return false\n    }\n    func num() -> Bool {\n        if i < b.count, b[i] == 45 { i += 1 }\n        guard i < b.count else { return false }\n        if b[i] == 48 { i += 1 } else if b[i] >= 49 && b[i] <= 57 { while i < b.count, b[i] >= 48 && b[i] <= 57 { i += 1 } } else { return false }\n        if i < b.count, b[i] == 46 {\n            i += 1\n            guard i < b.count, b[i] >= 48 && b[i] <= 57 else { return false }\n            while i < b.count, b[i] >= 48 && b[i] <= 57 { i += 1 }\n        }\n        if i < b.count, b[i] == 101 || b[i] == 69 {\n            i += 1\n            if i < b.count, b[i] == 43 || b[i] == 45 { i += 1 }\n            guard i < b.count, b[i] >= 48 && b[i] <= 57 else { return false }\n            while i < b.count, b[i] >= 48 && b[i] <= 57 { i += 1 }\n        }\n        return true\n    }\n    func lit(_ s: String) -> Bool {\n        let u = Array(s.utf8)\n        guard i + u.count <= b.count, Array(b[i..<i + u.count]) == u else { return false }\n        i += u.count\n        return true\n    }\n    func value(_ depth: Int) -> Bool {\n        if depth > 128 { return false }\n        ws()\n        guard i < b.count else { return false }\n        switch b[i] {\n        case 123:\n            i += 1\n            ws()\n            if i < b.count, b[i] == 125 { i += 1; return true }\n            while true {\n                ws()\n                guard i < b.count, b[i] == 34, str() else { return false }\n                ws()\n                guard i < b.count, b[i] == 58 else { return false }\n                i += 1\n                guard value(depth + 1) else { return false }\n                ws()\n                guard i < b.count else { return false }\n                if b[i] == 44 { i += 1; continue }\n                if b[i] == 125 { i += 1; return true }\n                return false\n            }\n        case 91:\n            i += 1\n            ws()\n            if i < b.count, b[i] == 93 { i += 1; return true }\n            while true {\n                guard value(depth + 1) else { return false }\n                ws()\n                guard i < b.count else { return false }\n                if b[i] == 44 { i += 1; continue }\n                if b[i] == 93 { i += 1; return true }\n                return false\n            }\n        case 34: return str()\n        case 116: return lit(\"true\")\n        case 102: return lit(\"false\")\n        case 110: return lit(\"null\")\n        default: return num()\n        }\n    }\n    guard value(0) else { return false }\n    ws()\n    return i == b.count\n}"],
