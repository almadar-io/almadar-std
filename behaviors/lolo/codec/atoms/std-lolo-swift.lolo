 digits) = table[code] else { return nil }\n    let amount = _render_number(n, _en_locale, digits, digits, 0)\n    return amount.hasPrefix(\"-\") ? \"-\" + symbol + amount.dropFirst() : symbol + amount\n}"],
          "format/bytes": ["fileprivate struct _Dec { var digits: [Int]; var point: Int }\nfileprivate func _dec_of(_ x: Double) -> _Dec {\n    if x == 0 { return _Dec(digits: [], point: 0) }\n    var d = abs(x).description\n    var e = 0\n    if let i = d.firstIndex(where: { $0 == \"e\" || $0 == \"E\" }) {\n        e = Int(d[d.index(after: i)...]) ?? 0\n        d = String(d[..<i])\n    }\n    var digits = d\n    var point = d.count\n    if let i = d.firstIndex(of: \".\") {\n        point = d.distance(from: d.startIndex, to: i)\n        digits = d.replacingOccurrences(of: \".\", with: \"\")\n    }\n    var n = point + e\n    while digits.hasPrefix(\"0\") && digits.count > 1 { digits.removeFirst(); n -= 1 }\n    while digits.hasSuffix(\"0\") && digits.count > 1 { digits.removeLast() }\n    return _Dec(digits: digits.map { Int(String($0))! }, point: n)\n}\nfileprivate func _dec_rounded(_ s: _Dec, _ fraction: Int) -> _Dec {\n    var s = s\n    let keep = s.point + fraction\n    if keep < 0 { return _Dec(digits: [], point: 0) }\n    if keep >= s.digits.count { return s }\n    let up = s.digits[keep] >= 5\n    s.digits = Array(s.digits[0..<keep])\n    if !up { return s.digits.isEmpty ? _Dec(digits: [], point: 0) : s }\n    if keep == 0 { return _Dec(digits: [1], point: 1 - fraction) }\n    var at = keep\n    while at > 0 {\n        at -= 1\n        if s.digits[at] == 9 { s.digits[at] = 0 } else { s.digits[at] += 1; return s }\n    }\n    return _Dec(digits: [1], point: s.point + 1)\n}\nfileprivate func _dec_integer(_ s: _Dec) -> String {\n    if s.point <= 0 || s.digits.isEmpty { return \"0\" }\n    return (0..<s.point).map { String($0 < s.digits.count ? s.digits[$0] : 0) }.joined()\n}\nfileprivate func _dec_fraction(_ s: _Dec, _ mn: Int, _ mx: Int) -> String {\n    var out: [Int] = []\n    if s.point < 0 { out += [Int](repeating: 0, count: -s.point) }\n    out += s.digits.dropFirst(max(s.point, 0))\n    out = Array(out.prefix(mx))\n    while out.count > mn && out.last == 0 { out.removeLast() }\n    while out.count < mn { out.append(0) }\n    return out.map { String($0) }.joined()\n}\nfileprivate func _plain(_ x: Double) -> String {\n    let s = _dec_of(x)\n    if s.digits.isEmpty { return \"0\" }\n    let ds = s.digits.map { String($0) }.joined()\n    let body: String\n    if s.point <= 0 { body = \"0.\" + String(repeating: \"0\", count: -s.point) + ds }\n    else if s.point >= s.digits.count { body = ds + String(repeating: \"0\", count: s.point - s.digits.count) }\n    else { body = String(ds.prefix(s.point)) + \".\" + String(ds.dropFirst(s.point)) }\n    return x < 0 ? \"-\" + body : body\n}\nfileprivate func _js_number(_ n: Double) -> String { n == n.rounded(.towardZero) ? String(Int64(n)) : _plain(n) }\nfileprivate struct _Locale { let group: String; let decimal: String; let minGroup: Int; let minus: String }\nfileprivate func _locale(_ tag: String) -> _Locale? {\n    let en = _Locale(group: \",\", decimal: \".\", minGroup: 1, minus: \"-\")\n    let de = _Locale(group: \".\", decimal: \",\", minGroup: 1, minus: \"-\")\n    let fr = _Locale(group: \"\\u{202f}\", decimal: \",\", minGroup: 1, minus: \"-\")\n    let es = _Locale(group: \".\", decimal: \",\", minGroup: 2, minus: \"-\")\n    let sl = _Locale(group: \".\", decimal: \",\", minGroup: 2, minus: \"\\u{2212}\")\n    let ar = _Locale(group: \",\", decimal: \".\", minGroup: 1, minus: \"\\u{200e}-\")\n    let ru = _Locale(group: \"\\u{a0}\", decimal: \",\", minGroup: 1, minus: \"-\")\n    switch tag {\n    case \"en\", \"en-US\", \"en-GB\", \"en-CA\", \"en-AU\", \"ja\", \"ja-JP\": return en\n    case \"de\", \"de-DE\", \"pt\", \"pt-BR\", \"nl\", \"nl-NL\": return de\n    case \"fr\", \"fr-FR\": return fr\n    case \"es\", \"es-ES\", \"it\", \"it-IT\": return es\n    case \"sl\", \"sl-SI\": return sl\n    case \"ar\": return ar\n    case \"ru\", \"ru-RU\": return ru\n    default: return nil\n    }\n}\nfileprivate let _en_locale = _locale(\"en\")!\nfileprivate func _group(_ integer: String, _ l: _Locale) -> String {\n    let n = integer.count\n    if n < 3 + l.minGroup { return integer }\n    let chars = Array(integer)\n    let first = n % 3\n    var parts: [String] = []\n    if first > 0 { parts.append(String(chars[0..<first])) }\n    var at = first\n    while at < n { parts.append(String(chars[at..<at + 3])); at += 3 }\n    return parts.joined(separator: l.group)\n}\nfileprivate func _render_number(_ n: Double, _ l: _Locale, _ mn: Int, _ mx: Int, _ shift: Int) -> String {\n    if n.isNaN { return \"NaN\" }\n    let sign = n.sign == .minus ? l.minus : \"\"\n    if n.isInfinite { return sign + \"\\u{221e}\" }\n    var d = _dec_of(abs(n))\n    if !d.digits.isEmpty { d.point += shift }\n    d = _dec_rounded(d, mx)\n    let fraction = _dec_fraction(d, mn, mx)\n    let integer = _group(_dec_integer(d), l)\n    return fraction.isEmpty ? sign + integer : sign + integer + l.decimal + fraction\n}", "fileprivate func _to_fixed(_ x: Double, _ digits: Int) -> String {\n    let exact = String(format: \"%.60f\", x)\n    let parts = exact.split(separator: \".\", omittingEmptySubsequences: false)\n    let whole = String(parts[0]), fraction = parts.count > 1 ? String(parts[1]) : \"\"\n    var kept = (whole + String(fraction.prefix(digits))).map { Int(String($0))! }\n    let fa = Array(fraction)\n    if digits < fa.count, fa[digits] >= \"5\" {\n        var at = kept.count\n        while true {\n            if at == 0 { kept.insert(1, at: 0); break }\n            at -= 1\n            if kept[at] == 9 { kept[at] = 0 } else { kept[at] += 1; break }\n        }\n    }\n    let split = kept.count - digits\n    let text = kept.map { String($0) }.joined()\n    return digits == 0 ? text : String(text.prefix(split)) + \".\" + String(text.dropFirst(split))\n}", "fileprivate func _fmt_bytes(_ b: Double) -> String? {\n    if !b.isFinite || b < 0 { return nil }\n    if b == 0 { return \"0 B\" }\n    let units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"]\n    let step = min(max(Int((log(b) / log(1024.0)).rounded(.down)), 0), 5)\n    if step == 0 { return _js_number(b) + \" B\" }\n    let value = b / pow(1024.0, Double(step))\n    let text: String\n    if value >= 10 { text = _js_number((value + 0.5).rounded(.down)) }\n    else if value == value.rounded(.towardZero) { text = _js_number(value) }\n    else { text = _to_fixed(value, 1) }\n    return text + \" \" + units[step]\n}"],
          "format/creditCard": ["fileprivate func _fmt_card(_ s: String) -> String {\n    let digits = String(String.UnicodeScalarView(s.unicodeScalars.filter { $0.value >= 48 && $0.value <= 57 }))\n    if digits.count <= 4 { return digits }\n    let mask = digits.count - 4\n    var groups: [String] = []\n    var i = 0\n    while i < mask {\n        let g = min(mask - i, 4)\n        groups.append(String(repeating: \"\\u{2022}\", count: g))\n        i += g\n    }\n    groups.append(String(digits.suffix(4)))\n    return groups.joined(separator: \" \")\n}"],
          "format/list": ["fileprivate func _num_text(_ x: Double) -> String {\n    if x.isNaN { return \"NaN\" }\n    if x.isInfinite { return x < 0 ? \"-Infinity\" : \"Infinity\" }\n    if x == 0 { return \"0\" }\n    var d = abs(x).description\n    var e = 0\n    if let i = d.firstIndex(where: { $0 == \"e\" || $0 == \"E\" }) {\n        e = Int(d[d.index(after: i)...]) ?? 0\n        d = String(d[..<i])\n    }\n    var digits = d\n    var point = d.count\n    if let i = d.firstIndex(of: \".\") {\n        point = d.distance(from: d.startIndex, to: i)\n        digits = d.replacingOccurrences(of: \".\", with: \"\")\n    }\n    var n = point + e\n    while digits.hasPrefix(\"0\") && digits.count > 1 { digits.removeFirst(); n -= 1 }\n    while digits.hasSuffix(\"0\") && digits.count > 1 { digits.removeLast() }\n    let k = digits.count\n    var out: String\n    if k <= n && n <= 21 {\n        out = digits + String(repeating: \"0\", count: n - k)\n    } else if 0 < n && n <= 21 {\n        out = String(digits.prefix(n)) + \".\" + String(digits.dropFirst(n))\n    } else if -6 < n && n <= 0 {\n        out = \"0.\" + String(repeating: \"0\", count: -n) + digits\n    } else {\n        let m = n - 1\n        let sign = m < 0 ? \"-\" : \"+\"\n        out = String(digits.prefix(1)) + (k > 1 ? \".\" + String(digits.dropFirst()) : \"\") + \"e\" + sign + String(abs(m))\n    }\n    return x < 0 ? \"-\" + out : out\n}\nfileprivate protocol _Textual { var _text: String { get } }\nextension String: _Textual { fileprivate var _text: String { self } }\nextension Bool: _Textual { fileprivate var _text: String { self ? \"true\" : \"false\" } }\nextension Double: _Textual { fileprivate var _text: String { _num_text(self) } }\nextension Int: _Textual { fileprivate var _text: String { String(self) } }", "fileprivate func _fmt_list<T: _Textual>(_ a: [T], _ style: String) -> String {\n    let items = a.map { $0._text }\n    switch items.count {\n    case 0: return \"\"\n    case 1: return items[0]\n    case 2: return items[0] + \" \" + style + \" \" + items[1]\n    default: return items.dropLast().joined(separator: \", \") + \", \" + style + \" \" + items[items.count - 1]\n    }\n}", "fileprivate func _fmt_list(_ a: [Never], _ style: String) -> String { \"\" }"],
          "format/ordinal": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _fmt_ordinal(_ x: Double) -> String {\n    let n = _whole(x)\n    let suffix: String\n    switch (n % 10, n % 100) {\n    case (1, 11), (2, 12), (3, 13): suffix = \"th\"\n    case (1, _): suffix = \"st\"\n    case (2, _): suffix = \"nd\"\n    case (3, _): suffix = \"rd\"\n    default: suffix = \"th\"\n    }\n    return String(n) + suffix\n}"],
          "format/plural": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _fmt_plural(_ c: Double, _ one: String, _ many: String) -> String {\n    let n = _whole(c)\n    return String(n) + \" \" + (n == 1 ? one : many)\n}"],
          "format/phone": ["fileprivate func _fmt_phone(_ text: String, _ format: String) -> String {\n    let digits = Array(text.unicodeScalars.filter { $0.value >= 48 && $0.value <= 57 }.map { Character($0) })\n    func s(_ a: Int, _ b: Int) -> String { String(digits[a..<b]) }\n    if format == \"US\" && digits.count == 10 { return \"(\" + s(0, 3) + \") \" + s(3, 6) + \"-\" + String(digits[6...]) }\n    if format == \"US\" && digits.count == 11 && digits[0] == \"1\" { return \"+1 (\" + s(1, 4) + \") \" + s(4, 7) + \"-\" + String(digits[7...]) }\n    if digits.count >= 10 { return s(0, 3) + \"-\" + s(3, 6) + \"-\" + String(digits[6...]) }\n    return text\n}"],
          "validate/email": ["fileprivate func _js_space(_ c: Unicode.Scalar) -> Bool {\n    switch c.value {\n    case 0x09...0x0d, 0x20, 0xa0, 0x1680, 0x2000...0x200a, 0x2028, 0x2029, 0x202f, 0x205f, 0x3000, 0xfeff: return true\n    default: return false\n    }\n}", "fileprivate func _is_email(_ s: String) -> Bool {\n    let sc = Array(s.unicodeScalars)\n    guard !sc.contains(where: { _js_space($0) }), let at = sc.firstIndex(of: \"@\"), at >= 1 else { return false }\n    let rest = Array(sc[(at + 1)...])\n    guard !rest.contains(\"@\"), let dot = rest.firstIndex(of: \".\"), dot >= 1 else { return false }\n    return dot + 1 < rest.count\n}"],
          "validate/url": ["fileprivate func _js_space(_ c: Unicode.Scalar) -> Bool {\n    switch c.value {\n    case 0x09...0x0d, 0x20, 0xa0, 0x1680, 0x2000...0x200a, 0x2028, 0x2029, 0x202f, 0x205f, 0x3000, 0xfeff: return true\n    default: return false\n    }\n}", "fileprivate func _is_url(_ s: String) -> Bool {\n    let sc = Array(s.unicodeScalars)\n    let http = Array(\"http://\".unicodeScalars), https = Array(\"https://\".unicodeScalars)\n    let rest: ArraySlice<Unicode.Scalar>\n    if sc.starts(with: https) { rest = sc[https.count...] } else if sc.starts(with: http) { rest = sc[http.count...] } else { return false }\n    return !rest.isEmpty && !rest.contains(where: { _js_space($0) })\n}"],
          "validate/phone": ["fileprivate func _js_space(_ c: Unicode.Scalar) -> Bool {\n    switch c.value {\n    case 0x09...0x0d, 0x20, 0xa0, 0x1680, 0x2000...0x200a, 0x2028, 0x2029, 0x202f, 0x205f, 0x3000, 0xfeff: return true\n    default: return false\n    }\n}", "fileprivate func _is_phone(_ s: String) -> Bool {\n    var sc = Array(s.unicodeScalars)\n    if sc.first == \"+\" { sc.removeFirst() }\n    return sc.count >= 7 && sc.allSatisfy { ($0.value >= 48 && $0.value <= 57) || _js_space($0) || $0 == \"(\" || $0 == \")\" || $0 == \".\" || $0 == \"-\" }\n}"],
          "validate/uuid": ["fileprivate func _is_uuid(_ s: String) -> Bool {\n    let sc = Array(s.unicodeScalars)\n    guard sc.count == 36 else { return false }\n    for (i, c) in sc.enumerated() {\n        if i == 8 || i == 13 || i == 18 || i == 23 { if c != \"-\" { return false } }\n        else if !((c.value >= 48 && c.value <= 57) || (c.value >= 97 && c.value <= 102) || (c.value >= 65 && c.value <= 70)) { return false }\n    }\n    return true\n}"],
          "validate/date": ["fileprivate func _valid_date(_ v: Any) -> Bool {\n    guard let s = v as? String else { return false }\n    let sep: Character\n    if s.unicodeScalars.contains(\"-\") { sep = \"-\" } else if s.unicodeScalars.contains(\"/\") { sep = \"/\" } else { return false }\n    let parts = s.split(separator: sep, omittingEmptySubsequences: false)\n    guard parts.count == 3, Int32(parts[0]) != nil, let m = UInt32(parts[1]), let d = UInt32(parts[2]) else { return false }\n    return m >= 1 && m <= 12 && d >= 1 && d <= 31\n}"],
          "validate/creditCard": ["fileprivate func _valid_card(_ s: String) -> Bool {\n    let digits = s.unicodeScalars.filter { $0.value >= 48 && $0.value <= 57 }.map { Int($0.value) - 48 }\n    if digits.count < 13 || digits.count > 19 { return false }\n    var sum = 0\n    var double = false\n    for digit in digits.reversed() {\n        var d = digit\n        if double {\n            d *= 2\n            if d > 9 { d -= 9 }\n        }\n        sum += d\n        double = !double\n    }\n    return sum % 10 == 0\n}"],
