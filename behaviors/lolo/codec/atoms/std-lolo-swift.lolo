          "math/rad-deg": "({{0}} * 180 / Double.pi)",
          "math/lerp": "_lerp({{0}}, {{1}}, {{2}})",
          "math/map": "_remap({{0}}, {{1}}, {{2}}, {{3}}, {{4}})",
          "math/wrap": "_wrap({{0}}, {{1}}, {{2}})",
          "math/random": "Double(UInt64.random(in: 0...UInt64.max) >> 11) / 9007199254740992",
          "math/randomInt": "_random_int({{0}}, {{1}})",
          "str/camelCase": "_camel_case({{0}})",
          "str/titleCase": "_title_case({{0}})",
          "str/kebabCase": "_case_words({{0}}).joined(separator: \"-\")",
          "str/snakeCase": "_case_words({{0}}).joined(separator: \"_\")",
          "str/encode-uri-component": "_uri_encode({{0}})",
          "str/decode-uri-component": "_uri_decode({{0}})",
          "str/uri-component-valid": "(_uri_decode({{0}}) != nil)",
          "str/template": "_template({{0}}, {{1}})",
          "str/to-number": "_to_number({{0}})",
          "array/cosine": "_cos_sim({{0}}, {{1}})",
          "array/nearest": "_nearest({{0}}, {{1}})",
          "array/insert": "_insert({{0}}, {{1}}, {{2}})",
          "array/remove": "_remove({{0}}, {{1}})",
          "array/removeItem": "_remove_item({{0}}, {{1}})",
          "array/shuffle": "_shuffle({{0}})",
          "array/preduce#3": "_preduce({{0}}, {{1}}, {{2}})",
          "bit/xor": "_bit_fold([{{*}}], { $0 ^ $1 })",
          "bit/and": "_bit_fold([{{*}}], { $0 & $1 })",
          "bit/or": "_bit_fold([{{*}}], { $0 | $1 })",
          "bit/not": "_word({{0}}).map { Double(~$0) }",
          "bit/shl": "_bit_shift({{0}}, {{1}}, { $0 << $1 })",
          "bit/shr": "_bit_shift({{0}}, {{1}}, { $0 >> $1 })",
          "bit/rotl": "_bit_shift({{0}}, {{1}}, { ($0 << $1) | ($0 >> (32 - $1)) })",
          "bit/rotr": "_bit_shift({{0}}, {{1}}, { ($0 >> $1) | ($0 << (32 - $1)) })",
          "vec/add": "_vadd({{0}}, {{1}})",
          "vec/sub": "_vsub({{0}}, {{1}})",
          "vec/scale": "_vscale({{0}}, {{1}})",
          "vec/dot": "_vdot2({{0}}, {{1}})",
          "vec/cross": "_vcross({{0}}, {{1}})",
          "vec/distance": "_vdist({{0}}, {{1}})",
          "vec/distance-sq": "_vdistsq({{0}}, {{1}})",
          "vec/lerp": "_vlerp({{0}}, {{1}}, {{2}})",
          "vec/angle#1": "_vang1({{0}})",
          "vec/angle#2": "_vang2({{0}}, {{1}})",
          "vec/rotate": "_vrot({{0}}, {{1}})",
          "vec/clamp-length": "_vclamp({{0}}, {{1}})",
          "ease/apply": "_ease_curve({{0}}, min(max({{1}}, 0), 1))",
          "ease/smoothstep": "_smoothstep({{0}}, {{1}}, {{2}})",
          "anim/frame-at#3": "_frame_at({{0}}, {{1}}, {{2}}, true)",
          "anim/frame-at#4": "_frame_at({{0}}, {{1}}, {{2}}, {{3}})",
          "anim/sheet-rect": "_sheet_rect({{0}}, {{1}}, {{2}}, {{3}})",
          "anim/direction-from-delta#2": "_direction({{0}}, {{1}}, 4)",
          "anim/direction-from-delta#3": "_direction({{0}}, {{1}}, {{2}})",
          "geo/aabb-overlap": "_aabb({{0}}, {{1}})",
          "geo/circle-overlap": "_circ_overlap({{0}}, {{1}})",
          "geo/rect-circle-overlap": "_rect_circ({{0}}, {{1}})",
          "geo/point-in-rect": "_pt_rect({{0}}, {{1}})",
          "geo/point-in-circle": "_pt_circ({{0}}, {{1}})",
          "geo/reflect": "_reflect({{0}}, {{1}})",
          "geo/segment-intersect": "_seg_hit({{0}}, {{1}})",
          "grid/to-world": "_to_world({{0}}, {{1}})",
          "grid/from-world": "_from_world({{0}}, {{1}})",
          "grid/iso-to-screen": "_iso_to_screen({{0}}, {{1}}, {{2}})",
          "grid/screen-to-iso": "_screen_to_iso({{0}}, {{1}}, {{2}})",
          "grid/distance": "_grid_dist({{0}}, {{1}})",
          "grid/manhattan-distance": "_grid_manhattan({{0}}, {{1}})",
          "grid/neighbors#1": "_neighbors({{0}}, false)",
          "grid/neighbors#2": "_neighbors({{0}}, {{1}})",
          "grid/cells-in-radius": "_cells_in_radius({{0}}, {{1}})",
          "grid/line": "_grid_line({{0}}, {{1}})",
          "grid/in-bounds": "_in_bounds({{0}}, {{1}}, {{2}})",
          "noise/perlin#2": "_perlin({{0}}, {{1}}, 0)",
          "noise/perlin#3": "_perlin({{0}}, {{1}}, {{2}})",
          "noise/simplex#2": "_simplex({{0}}, {{1}}, 0)",
          "noise/simplex#3": "_simplex({{0}}, {{1}}, {{2}})",
          "noise/fbm#3": "_fbm({{0}}, {{1}}, {{2}}, 0)",
          "noise/fbm#4": "_fbm({{0}}, {{1}}, {{2}}, {{3}})",
          "prob/seed": "_prob_seed({{0}})",
          "prob/uniform": "_prob_uniform({{0}}, {{1}})",
          "prob/flip": "(_prob_next() < {{0}})",
          "prob/gaussian": "_prob_gaussian({{0}}, {{1}})",
          "prob/beta": "_prob_beta({{0}}, {{1}})",
          "prob/categorical": "_prob_categorical({{0}}, {{1}})",
