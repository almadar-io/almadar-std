          "str/template": ["fileprivate func _find(_ s: [Unicode.Scalar], _ d: [Unicode.Scalar], _ from: Int) -> Int? {\n    var i = from\n    while i + d.count <= s.count {\n        if s[i..<i + d.count].elementsEqual(d) { return i }\n        i += 1\n    }\n    return nil\n}", "fileprivate func _num_text(_ x: Double) -> String {\n    if x.isNaN { return \"NaN\" }\n    if x.isInfinite { return x < 0 ? \"-Infinity\" : \"Infinity\" }\n    if x == 0 { return \"0\" }\n    var d = abs(x).description\n    var e = 0\n    if let i = d.firstIndex(where: { $0 == \"e\" || $0 == \"E\" }) {\n        e = Int(d[d.index(after: i)...]) ?? 0\n        d = String(d[..<i])\n    }\n    var digits = d\n    var point = d.count\n    if let i = d.firstIndex(of: \".\") {\n        point = d.distance(from: d.startIndex, to: i)\n        digits = d.replacingOccurrences(of: \".\", with: \"\")\n    }\n    var n = point + e\n    while digits.hasPrefix(\"0\") && digits.count > 1 { digits.removeFirst(); n -= 1 }\n    while digits.hasSuffix(\"0\") && digits.count > 1 { digits.removeLast() }\n    let k = digits.count\n    var out: String\n    if k <= n && n <= 21 {\n        out = digits + String(repeating: \"0\", count: n - k)\n    } else if 0 < n && n <= 21 {\n        out = String(digits.prefix(n)) + \".\" + String(digits.dropFirst(n))\n    } else if -6 < n && n <= 0 {\n        out = \"0.\" + String(repeating: \"0\", count: -n) + digits\n    } else {\n        let m = n - 1\n        let sign = m < 0 ? \"-\" : \"+\"\n        out = String(digits.prefix(1)) + (k > 1 ? \".\" + String(digits.dropFirst()) : \"\") + \"e\" + sign + String(abs(m))\n    }\n    return x < 0 ? \"-\" + out : out\n}\nfileprivate protocol _Textual { var _text: String { get } }\nextension String: _Textual { fileprivate var _text: String { self } }\nextension Bool: _Textual { fileprivate var _text: String { self ? \"true\" : \"false\" } }\nextension Double: _Textual { fileprivate var _text: String { _num_text(self) } }\nextension Int: _Textual { fileprivate var _text: String { String(self) } }", "fileprivate func _val_text(_ v: Any) -> String {\n    switch v {\n    case let s as String: return s\n    case let b as Bool: return b ? \"true\" : \"false\"\n    case let n as Double: return _num_text(n)\n    case let i as Int: return String(i)\n    default: fatalError(\"str/template: a value of this type is not supported\")\n    }\n}", "fileprivate func _template<V>(_ t: String, _ d: [String: V]) -> String {\n    let sc = Array(t.unicodeScalars)\n    var out = String.UnicodeScalarView()\n    var p = 0\n    while let open = _find(sc, [\"{\", \"{\"], p) {\n        out.append(contentsOf: sc[p..<open])\n        let key = _find(sc, [\"}\", \"}\"], open + 2).map { Array(sc[open + 2..<$0]) }\n        let hit = key.flatMap { k in d.first { $0.key.unicodeScalars.elementsEqual(k) } }\n        if let key, let hit {\n            out.append(contentsOf: _val_text(hit.value).unicodeScalars)\n            p = open + 2 + key.count + 2\n        } else {\n            out.append(\"{\")\n            p = open + 1\n        }\n    }\n    out.append(contentsOf: sc[p...])\n    return String(out)\n}"],
          "str/to-number": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _radix(_ digits: ArraySlice<UInt8>, _ width: Int) -> Double? {\n    if digits.isEmpty { return nil }\n    var length = 0\n    var significand: UInt64 = 0\n    var guardBit = false\n    var sticky = false\n    for byte in digits {\n        let digit: UInt8\n        switch byte {\n        case 48...57: digit = byte - 48\n        case 97...102: digit = byte - 87\n        case 65...70: digit = byte - 55\n        default: return nil\n        }\n        if Int(digit) >= 1 << width { return nil }\n        for shift in stride(from: width - 1, through: 0, by: -1) {\n            let bit = UInt64((digit >> UInt8(shift)) & 1)\n            if length == 0 && bit == 0 { continue }\n            length += 1\n            switch length {\n            case 1...53: significand = (significand << 1) | bit\n            case 54: guardBit = bit != 0\n            default: sticky = sticky || bit != 0\n            }\n        }\n    }\n    if length <= 53 { return Double(significand) }\n    if length > 1024 { return Double.infinity }\n    var exponent = length - 1\n    if guardBit && (sticky || significand & 1 != 0) { significand += 1 }\n    if significand == 1 << 53 {\n        significand >>= 1\n        exponent += 1\n    }\n    if exponent > 1023 { return Double.infinity }\n    return Double(bitPattern: (UInt64(exponent + 1023) << 52) | (significand & ((1 << 52) - 1)))\n}", "fileprivate func _to_number(_ text: String) -> Double? {\n    func space(_ c: Unicode.Scalar) -> Bool {\n        switch c.value {\n        case 0x09...0x0d, 0x20, 0xa0, 0x1680, 0x2000...0x200a, 0x2028, 0x2029, 0x202f, 0x205f, 0x3000, 0xfeff: return true\n        default: return false\n        }\n    }\n    var sc = Array(text.unicodeScalars)\n    while let f = sc.first, space(f) { sc.removeFirst() }\n    while let l = sc.last, space(l) { sc.removeLast() }\n    if sc.isEmpty { return 0 }\n    let bytes = Array(_str(sc).utf8)\n    for (prefix, width) in [(\"0x\", 4), (\"0X\", 4), (\"0b\", 1), (\"0B\", 1), (\"0o\", 3), (\"0O\", 3)] where bytes.starts(with: prefix.utf8) {\n        return _radix(bytes[2...], width)\n    }\n    var sign = 1.0\n    var rest = bytes[...]\n    if rest.first == 45 { sign = -1; rest = rest.dropFirst() } else if rest.first == 43 { rest = rest.dropFirst() }\n    if rest.elementsEqual(\"Infinity\".utf8) { return sign * Double.infinity }\n    guard let f = rest.first, (f >= 48 && f <= 57) || f == 46,\n          rest.allSatisfy({ ($0 >= 48 && $0 <= 57) || $0 == 46 || $0 == 101 || $0 == 69 || $0 == 43 || $0 == 45 }),\n          rest.contains(where: { $0 >= 48 && $0 <= 57 }) else { return nil }\n    return Double(String(decoding: rest, as: UTF8.self)).map { sign * $0 }\n}"],
          "str/join": ["fileprivate func _num_text(_ x: Double) -> String {\n    if x.isNaN { return \"NaN\" }\n    if x.isInfinite { return x < 0 ? \"-Infinity\" : \"Infinity\" }\n    if x == 0 { return \"0\" }\n    var d = abs(x).description\n    var e = 0\n    if let i = d.firstIndex(where: { $0 == \"e\" || $0 == \"E\" }) {\n        e = Int(d[d.index(after: i)...]) ?? 0\n        d = String(d[..<i])\n    }\n    var digits = d\n    var point = d.count\n    if let i = d.firstIndex(of: \".\") {\n        point = d.distance(from: d.startIndex, to: i)\n        digits = d.replacingOccurrences(of: \".\", with: \"\")\n    }\n    var n = point + e\n    while digits.hasPrefix(\"0\") && digits.count > 1 { digits.removeFirst(); n -= 1 }\n    while digits.hasSuffix(\"0\") && digits.count > 1 { digits.removeLast() }\n    let k = digits.count\n    var out: String\n    if k <= n && n <= 21 {\n        out = digits + String(repeating: \"0\", count: n - k)\n    } else if 0 < n && n <= 21 {\n        out = String(digits.prefix(n)) + \".\" + String(digits.dropFirst(n))\n    } else if -6 < n && n <= 0 {\n        out = \"0.\" + String(repeating: \"0\", count: -n) + digits\n    } else {\n        let m = n - 1\n        let sign = m < 0 ? \"-\" : \"+\"\n        out = String(digits.prefix(1)) + (k > 1 ? \".\" + String(digits.dropFirst()) : \"\") + \"e\" + sign + String(abs(m))\n    }\n    return x < 0 ? \"-\" + out : out\n}\nfileprivate protocol _Textual { var _text: String { get } }\nextension String: _Textual { fileprivate var _text: String { self } }\nextension Bool: _Textual { fileprivate var _text: String { self ? \"true\" : \"false\" } }\nextension Double: _Textual { fileprivate var _text: String { _num_text(self) } }\nextension Int: _Textual { fileprivate var _text: String { String(self) } }", "fileprivate func _join<T: _Textual>(_ a: [T], _ d: String) -> String { a.map { $0._text }.joined(separator: d) }", "fileprivate func _join(_ a: [Never], _ d: String) -> String { \"\" }"],
          "array/cosine": ["fileprivate func _cos_sim(_ a: [Double], _ b: [Double]) -> Double? {\n    if a.count != b.count || a.isEmpty { return nil }\n    var dot = 0.0, na = 0.0, nb = 0.0\n    for (x, y) in zip(a, b) {\n        dot += x * y\n        na += x * x\n        nb += y * y\n    }\n    if na == 0 || nb == 0 { return nil }\n    return dot / (na.squareRoot() * nb.squareRoot())\n}"],
          "array/nearest": ["fileprivate func _cos_sim(_ a: [Double], _ b: [Double]) -> Double? {\n    if a.count != b.count || a.isEmpty { return nil }\n    var dot = 0.0, na = 0.0, nb = 0.0\n    for (x, y) in zip(a, b) {\n        dot += x * y\n        na += x * x\n        nb += y * y\n    }\n    if na == 0 || nb == 0 { return nil }\n    return dot / (na.squareRoot() * nb.squareRoot())\n}", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate struct _NearRow: Encodable { let index: Double; let score: Double; let margin: Double }", "fileprivate func _nearest<T: Decodable>(_ q: [Double], _ c: [[Double]]) -> T? {\n    if c.isEmpty { return nil }\n    var scores: [Double] = []\n    for v in c {\n        guard let s = _cos_sim(q, v) else { return nil }\n        scores.append(s)\n    }\n    var best = 0\n    for i in 1..<scores.count where scores[i] > scores[best] { best = i }\n    var second = -Double.infinity\n    for (i, s) in scores.enumerated() where i != best && s > second { second = s }\n    let margin = scores.count == 1 ? 0 : scores[best] - second\n    return _recast(_NearRow(index: Double(best), score: scores[best], margin: margin))\n}"],
          "array/insert": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _insert<T>(_ a: [T], _ i: Double, _ x: T) -> [T] {\n    let k = _count(i)\n    guard k <= a.count else { fatalError(\"insert: index is past the end of the array\") }\n    var out = a\n    out.insert(x, at: k)\n    return out\n}"],
          "array/remove": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _remove<T>(_ a: [T], _ i: Double) -> [T] {\n    let k = _count(i)\n    guard k < a.count else { fatalError(\"remove: index is outside the array\") }\n    var out = a\n    out.remove(at: k)\n    return out\n}"],
          "array/removeItem": ["fileprivate protocol _Eq { func _same(_ o: Self) -> Bool }\nextension String: _Eq { fileprivate func _same(_ o: String) -> Bool { unicodeScalars.elementsEqual(o.unicodeScalars) } }\nextension Double: _Eq { fileprivate func _same(_ o: Double) -> Bool { self == o } }\nextension Bool: _Eq { fileprivate func _same(_ o: Bool) -> Bool { self == o } }\nextension Array: _Eq where Element: _Eq { fileprivate func _same(_ o: [Element]) -> Bool { count == o.count && zip(self, o).allSatisfy { $0._same($1) } } }\nextension Optional: _Eq where Wrapped: _Eq {\n    fileprivate func _same(_ o: Wrapped?) -> Bool {\n        switch (self, o) {\n        case (nil, nil): return true\n        case let (a?, b?): return a._same(b)\n        default: return false\n        }\n    }\n}\nextension Dictionary: _Eq where Value: _Eq { fileprivate func _same(_ o: [Key: Value]) -> Bool { count == o.count && allSatisfy { kv in o[kv.key].map { kv.value._same($0) } ?? false } } }\nfileprivate func _eq<T: _Eq>(_ a: T, _ b: T) -> Bool { a._same(b) }", "enum _JV: Codable, Equatable, ExpressibleByStringLiteral, ExpressibleByFloatLiteral, ExpressibleByIntegerLiteral, ExpressibleByBooleanLiteral {\n    case null, bool(Bool), number(Double), string(String), array([_JV]), object([String: _JV])\n\n    init(stringLiteral v: String) { self = .string(v) }\n    init(floatLiteral v: Double) { self = .number(v) }\n    init(integerLiteral v: Int) { self = .number(Double(v)) }\n    init(booleanLiteral v: Bool) { self = .bool(v) }\n\n    init(from decoder: Decoder) throws {\n        let c = try decoder.singleValueContainer()\n        if c.decodeNil() { self = .null }\n        else if let b = try? c.decode(Bool.self) { self = .bool(b) }\n        else if let n = try? c.decode(Double.self) { self = .number(n) }\n        else if let v = try? c.decode(String.self) { self = .string(v) }\n        else if let a = try? c.decode([_JV].self) { self = .array(a) }\n        else { self = .object(try c.decode([String: _JV].self)) }\n    }\n\n    func encode(to encoder: Encoder) throws {\n        var c = encoder.singleValueContainer()\n        switch self {\n        case .null: try c.encodeNil()\n        case .bool(let b): try c.encode(b)\n        case .number(let n): try c.encode(n)\n        case .string(let v): try c.encode(v)\n        case .array(let a): try c.encode(a)\n        case .object(let o): try c.encode(o)\n        }\n    }\n}\n\nextension _JV: _Eq { fileprivate func _same(_ o: _JV) -> Bool { self == o } }", "extension _JV: ExpressibleByArrayLiteral, ExpressibleByDictionaryLiteral {\n    init(arrayLiteral e: _JV...) { self = .array(e) }\n    init(dictionaryLiteral e: (String, _JV)...) { self = .object(Dictionary(e) { _, last in last }) }\n}", "fileprivate func _eq(_ a: [_JV], _ b: [_JV]) -> Bool { a == b }", "fileprivate func _remove_item<T: _Eq>(_ a: [T], _ x: T) -> [T] {\n    var out = a\n    if let i = a.firstIndex(where: { $0._same(x) }) { out.remove(at: i) }\n    return out\n}", "fileprivate func _remove_item(_ a: [Never], _ x: Double) -> [Double] { [] }"],
          "array/shuffle": ["fileprivate func _shuffle<T>(_ a: [T]) -> [T] {\n    var out = a\n    out.shuffle()\n    return out\n}"],
          "array/partition": ["fileprivate func _partition<T>(_ a: [T], _ f: (T) -> Bool) -> [[T]] {\n    [a.filter(f), a.filter { !f($0) }]\n}"],
          "array/pmap": [],
          "array/preduce": ["fileprivate func _preduce<T>(_ a: [T], _ initial: T, _ f: (T, T) -> T) -> T {\n    var out = initial\n    for start in stride(from: 0, to: a.count, by: 1024) {\n        let chunk = a[start..<min(start + 1024, a.count)]\n        out = f(out, chunk.dropFirst().reduce(chunk[chunk.startIndex], f))\n    }\n    return out\n}", "\n@_disfavoredOverload fileprivate func _preduce<A, T>(_ a: [T], _ initial: A, _ f: (A, T) -> A) -> A {\n    guard a.isEmpty else { fatalError(\"array/preduce: the accumulator and the items differ in type\") }\n    return initial\n}"],
          "bit/xor": ["fileprivate func _word(_ x: Double, _ hi: Double = 4294967295) -> UInt32? { x == x.rounded() && x >= 0 && x <= hi ? UInt32(x) : nil }", "fileprivate func _bit_fold(_ a: [Double], _ f: (UInt32, UInt32) -> UInt32) -> Double? {\n    let words = a.map { _word($0) }\n    guard var acc = words[0] else { return nil }\n    for w in words.dropFirst() {\n        guard let w else { return nil }\n        acc = f(acc, w)\n    }\n    return Double(acc)\n}"],
          "bit/and": ["fileprivate func _word(_ x: Double, _ hi: Double = 4294967295) -> UInt32? { x == x.rounded() && x >= 0 && x <= hi ? UInt32(x) : nil }", "fileprivate func _bit_fold(_ a: [Double], _ f: (UInt32, UInt32) -> UInt32) -> Double? {\n    let words = a.map { _word($0) }\n    guard var acc = words[0] else { return nil }\n    for w in words.dropFirst() {\n        guard let w else { return nil }\n        acc = f(acc, w)\n    }\n    return Double(acc)\n}"],
          "bit/or": ["fileprivate func _word(_ x: Double, _ hi: Double = 4294967295) -> UInt32? { x == x.rounded() && x >= 0 && x <= hi ? UInt32(x) : nil }", "fileprivate func _bit_fold(_ a: [Double], _ f: (UInt32, UInt32) -> UInt32) -> Double? {\n    let words = a.map { _word($0) }\n    guard var acc = words[0] else { return nil }\n    for w in words.dropFirst() {\n        guard let w else { return nil }\n        acc = f(acc, w)\n    }\n    return Double(acc)\n}"],
