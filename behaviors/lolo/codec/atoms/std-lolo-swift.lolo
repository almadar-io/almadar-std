          "bit/rotr": ["fileprivate func _word(_ x: Double, _ hi: Double = 4294967295) -> UInt32? { x == x.rounded() && x >= 0 && x <= hi ? UInt32(x) : nil }", "fileprivate func _bit_shift(_ a: Double, _ n: Double, _ f: (UInt32, UInt32) -> UInt32) -> Double? {\n    guard let w = _word(a), let k = _word(n, 31) else { return nil }\n    return Double(f(w, k))\n}"],
          "vec/add": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vadd<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> T {\n    let p = _vec(a), q = _vec(b)\n    return _recast(_Vec(p.x + q.x, p.y + q.y, p.z + q.z, p.hasZ))\n}"],
          "vec/sub": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vsub<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> T {\n    let p = _vec(a), q = _vec(b)\n    return _recast(_Vec(p.x - q.x, p.y - q.y, p.z - q.z, p.hasZ))\n}"],
          "vec/scale": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vscale<A: Encodable, T: Decodable>(_ a: A, _ k: Double) -> T {\n    let p = _vec(a)\n    return _recast(_Vec(p.x * k, p.y * k, p.z * k, p.hasZ))\n}"],
          "vec/dot": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vdot2<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    _vdot(_vec(a), _vec(b))\n}"],
          "vec/cross": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vcross<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> T {\n    let p = _vec(a), q = _vec(b)\n    if p.hasZ || q.hasZ {\n        return _recast(_Vec(p.y * q.z - p.z * q.y, p.z * q.x - p.x * q.z, p.x * q.y - p.y * q.x, true))\n    }\n    return _recast(p.x * q.y - p.y * q.x)\n}"],
          "vec/length": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vlen<A: Encodable>(_ a: A) -> Double {\n    _vec(a).dot.squareRoot()\n}"],
          "vec/length-sq": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vlensq<A: Encodable>(_ a: A) -> Double {\n    _vec(a).dot\n}"],
          "vec/normalize": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vnorm<A: Encodable, T: Decodable>(_ a: A) -> T {\n    let p = _vec(a)\n    let len = p.dot.squareRoot()\n    if len == 0 { return _recast(_Vec(0, 0, 0, p.hasZ)) }\n    return _recast(_Vec(p.x / len, p.y / len, p.z / len, p.hasZ))\n}"],
          "vec/distance": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vdist<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    let p = _vec(a), q = _vec(b)\n    let dx = p.x - q.x, dy = p.y - q.y, dz = p.z - q.z\n    return (dx * dx + dy * dy + dz * dz).squareRoot()\n}"],
          "vec/distance-sq": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vdistsq<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    let p = _vec(a), q = _vec(b)\n    let dx = p.x - q.x, dy = p.y - q.y, dz = p.z - q.z\n    return dx * dx + dy * dy + dz * dz\n}"],
          "vec/lerp": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vlerp<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B, _ t: Double) -> T {\n    let p = _vec(a), q = _vec(b)\n    return _recast(_Vec(p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t, p.z + (q.z - p.z) * t, p.hasZ))\n}"],
          "vec/angle": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vang1<A: Encodable>(_ a: A) -> Double {\n    let p = _vec(a)\n    return atan2(p.y, p.x)\n}", "fileprivate func _vang2<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    let p = _vec(a), q = _vec(b)\n    let la = p.dot.squareRoot(), lb = q.dot.squareRoot()\n    if la == 0 || lb == 0 { return 0 }\n    return acos(min(max(_vdot(p, q) / (la * lb), -1), 1))\n}"],
          "vec/rotate": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vrot<A: Encodable, T: Decodable>(_ a: A, _ rad: Double) -> T {\n    let p = _vec(a)\n    let s = sin(rad), c = cos(rad)\n    return _recast(_Vec(p.x * c - p.y * s, p.x * s + p.y * c, p.z, p.hasZ))\n}"],
          "vec/clamp-length": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _vclamp<A: Encodable, T: Decodable>(_ a: A, _ mx: Double) -> T {\n    let p = _vec(a)\n    let len = p.dot.squareRoot()\n    if len > mx && len != 0 {\n        let k = mx / len\n        return _recast(_Vec(p.x * k, p.y * k, p.z * k, p.hasZ))\n    }\n    return _recast(p)\n}"],
          "ease/apply": ["fileprivate func _ease_curve(_ curve: String, _ t: Double) -> Double {\n    switch curve {\n    case \"in-quad\": return t * t\n    case \"out-quad\": return t * (2.0 - t)\n    case \"in-out-quad\": return t < 0.5 ? 2.0 * t * t : -1.0 + (4.0 - 2.0 * t) * t\n    case \"in-cubic\": return t * t * t\n    case \"out-cubic\":\n        let f = t - 1.0\n        return f * f * f + 1.0\n    case \"in-out-cubic\":\n        if t < 0.5 { return 4.0 * t * t * t }\n        let f = 2.0 * t - 2.0\n        return 0.5 * f * f * f + 1.0\n    case \"elastic-out\":\n        if t == 0.0 || t == 1.0 { return t }\n        let p = 0.3\n        let s = p / 4.0\n        return pow(2.0, -10.0 * t) * sin((t - s) * (2.0 * Double.pi) / p) + 1.0\n    case \"bounce-out\":\n        let n1 = 7.5625, d1 = 2.75\n        if t < 1.0 / d1 { return n1 * t * t }\n        if t < 2.0 / d1 {\n            let t2 = t - 1.5 / d1\n            return n1 * t2 * t2 + 0.75\n        }\n        if t < 2.5 / d1 {\n            let t2 = t - 2.25 / d1\n            return n1 * t2 * t2 + 0.9375\n        }\n        let t2 = t - 2.625 / d1\n        return n1 * t2 * t2 + 0.984375\n    default: return t\n    }\n}"],
          "ease/smoothstep": ["fileprivate func _smoothstep(_ e0: Double, _ e1: Double, _ x: Double) -> Double {\n    if e0 == e1 { return 0 }\n    let t = min(max((x - e0) / (e1 - e0), 0), 1)\n    return t * t * (3 - 2 * t)\n}"],
          "anim/frame-at": ["fileprivate func _frame_at(_ elapsed: Double, _ dur: Double, _ count: Double, _ looped: Bool) -> Double {\n    guard dur != 0 else { fatalError(\"anim/frame-at: frameDur must not be 0\") }\n    guard count > 0 else { fatalError(\"anim/frame-at: frameCount must be positive\") }\n    let i = (elapsed / dur).rounded(.down)\n    if looped {\n        let m = fmod(i, count)\n        return m < 0 ? m + count : m\n    }\n    return min(i, count - 1)\n}"],
          "anim/sheet-rect": ["fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate struct _SheetRow: Encodable { let sx: Double; let sy: Double; let sw: Double; let sh: Double }", "fileprivate func _sheet_rect<T: Decodable>(_ i: Double, _ cols: Double, _ w: Double, _ h: Double) -> T {\n    guard cols > 0 else { fatalError(\"anim/sheet-rect: cols must be positive\") }\n    return _recast(_SheetRow(sx: fmod(i, cols) * w, sy: (i / cols).rounded(.down) * h, sw: w, sh: h))\n}"],
          "anim/direction-from-delta": ["fileprivate func _direction(_ dx: Double, _ dy: Double, _ ways: Double) -> String {\n    guard ways == 4 || ways == 8 else { fatalError(\"anim/direction-from-delta: ways: expected 4 or 8\") }\n    let angle = atan2(dy, dx)\n    let two = Double.pi * 2\n    func sector(_ n: Double) -> Int {\n        let r = fmod((angle / (two / n)).rounded(), n)\n        return Int(r < 0 ? r + n : r)\n    }\n    if ways == 8 {\n        return [\"right\", \"down-right\", \"down\", \"down-left\", \"left\", \"up-left\", \"up\", \"up-right\"][sector(8)]\n    }\n    return [\"right\", \"down\", \"left\", \"up\"][sector(4)]\n}"],
          "geo/aabb-overlap": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _aabb<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Bool {\n    let p = _fields(a, [\"x\", \"y\", \"w\", \"h\"]), q = _fields(b, [\"x\", \"y\", \"w\", \"h\"])\n    return p[0] < q[0] + q[2] && p[0] + p[2] > q[0] && p[1] < q[1] + q[3] && p[1] + p[3] > q[1]\n}"],
          "geo/circle-overlap": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _circ_overlap<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Bool {\n    let p = _fields(a, [\"x\", \"y\", \"r\"]), q = _fields(b, [\"x\", \"y\", \"r\"])\n    let dx = p[0] - q[0], dy = p[1] - q[1]\n    return (dx * dx + dy * dy).squareRoot() <= p[2] + q[2]\n}"],
          "geo/rect-circle-overlap": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _rect_circ<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Bool {\n    let p = _fields(a, [\"x\", \"y\", \"w\", \"h\"]), q = _fields(b, [\"x\", \"y\", \"r\"])\n    let nx = min(max(q[0], p[0]), p[0] + p[2]), ny = min(max(q[1], p[1]), p[1] + p[3])\n    let dx = q[0] - nx, dy = q[1] - ny\n    return dx * dx + dy * dy <= q[2] * q[2]\n}"],
          "geo/point-in-rect": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _pt_rect<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Bool {\n    let p = _fields(a, [\"x\", \"y\"]), q = _fields(b, [\"x\", \"y\", \"w\", \"h\"])\n    return p[0] >= q[0] && p[0] <= q[0] + q[2] && p[1] >= q[1] && p[1] <= q[1] + q[3]\n}"],
          "geo/point-in-circle": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _pt_circ<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Bool {\n    let p = _fields(a, [\"x\", \"y\"]), q = _fields(b, [\"x\", \"y\", \"r\"])\n    let dx = p[0] - q[0], dy = p[1] - q[1]\n    return dx * dx + dy * dy <= q[2] * q[2]\n}"],
          "geo/reflect": ["fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _reflect<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> T {\n    let p = _vec(a), n = _vec(b)\n    let dot = p.x * n.x + p.y * n.y + p.z * n.z\n    return _recast(_Vec(p.x - 2.0 * dot * n.x, p.y - 2.0 * dot * n.y, p.z - 2.0 * dot * n.z, p.hasZ))\n}"],
          "geo/segment-intersect": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _seg_hit<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> T? {\n    let p = _fields(a, [\"x1\", \"y1\", \"x2\", \"y2\"]), q = _fields(b, [\"x1\", \"y1\", \"x2\", \"y2\"])\n    let (x1, y1, x2, y2, x3, y3, x4, y4) = (p[0], p[1], p[2], p[3], q[0], q[1], q[2], q[3])\n    let denom = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)\n    if denom == 0 { return nil }\n    let t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / denom\n    let u = ((x1 - x3) * (y1 - y2) - (y1 - y3) * (x1 - x2)) / denom\n    if t >= 0 && t <= 1 && u >= 0 && u <= 1 {\n        return _recast(_Vec(x1 + t * (x2 - x1), y1 + t * (y2 - y1), 0, false))\n    }\n    return nil\n}"],
          "grid/to-world": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _to_world<A: Encodable, T: Decodable>(_ a: A, _ size: Double) -> T {\n    let p = _fields(a, [\"x\", \"y\"])\n    return _recast(_Vec((p[0] + 0.5) * size, (p[1] + 0.5) * size, 0, false))\n}"],
          "grid/from-world": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _from_world<A: Encodable, T: Decodable>(_ a: A, _ size: Double) -> T {\n    let p = _fields(a, [\"x\", \"y\"])\n    guard size != 0 else { fatalError(\"grid/from-world: cellSize must not be 0\") }\n    return _recast(_Vec((p[0] / size).rounded(.down), (p[1] / size).rounded(.down), 0, false))\n}"],
          "grid/iso-to-screen": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _iso_to_screen<A: Encodable, T: Decodable>(_ a: A, _ tw: Double, _ th: Double) -> T {\n    let p = _fields(a, [\"x\", \"y\"])\n    return _recast(_Vec((p[0] - p[1]) * tw / 2.0, (p[0] + p[1]) * th / 2.0, 0, false))\n}"],
          "grid/screen-to-iso": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _screen_to_iso<A: Encodable, T: Decodable>(_ a: A, _ tw: Double, _ th: Double) -> T {\n    let p = _fields(a, [\"x\", \"y\"])\n    let hw = tw / 2.0, hh = th / 2.0\n    guard hw != 0 && hh != 0 else { fatalError(\"grid/screen-to-iso: tileW and tileH must not be 0\") }\n    return _recast(_Vec((p[0] / hw + p[1] / hh) / 2.0, (p[1] / hh - p[0] / hw) / 2.0, 0, false))\n}"],
          "grid/distance": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _grid_dist<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    let p = _fields(a, [\"x\", \"y\"]), q = _fields(b, [\"x\", \"y\"])\n    return max(abs(p[0] - q[0]), abs(p[1] - q[1]))\n}"],
          "grid/manhattan-distance": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _grid_manhattan<A: Encodable, B: Encodable>(_ a: A, _ b: B) -> Double {\n    let p = _fields(a, [\"x\", \"y\"]), q = _fields(b, [\"x\", \"y\"])\n    return abs(p[0] - q[0]) + abs(p[1] - q[1])\n}"],
          "grid/neighbors": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _neighbors<A: Encodable, T: Decodable>(_ a: A, _ diagonal: Bool) -> [T] {\n    let p = _fields(a, [\"x\", \"y\"])\n    let (cx, cy) = (p[0], p[1])\n    var out = [_Vec(cx, cy - 1, 0, false), _Vec(cx + 1, cy, 0, false), _Vec(cx, cy + 1, 0, false), _Vec(cx - 1, cy, 0, false)]\n    if diagonal {\n        out += [_Vec(cx + 1, cy - 1, 0, false), _Vec(cx + 1, cy + 1, 0, false), _Vec(cx - 1, cy + 1, 0, false), _Vec(cx - 1, cy - 1, 0, false)]\n    }\n    return _recast(out)\n}"],
          "grid/cells-in-radius": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _cells_in_radius<A: Encodable, T: Decodable>(_ a: A, _ r: Double) -> [T] {\n    let p = _fields(a, [\"x\", \"y\"])\n    let ri = Int(r.rounded(.down))\n    let r2 = r * r\n    var out: [_Vec] = []\n    var dy = -ri\n    while dy <= ri {\n        var dx = -ri\n        while dx <= ri {\n            let fx = Double(dx), fy = Double(dy)\n            if fx * fx + fy * fy <= r2 { out.append(_Vec(p[0] + fx, p[1] + fy, 0, false)) }\n            dx += 1\n        }\n        dy += 1\n    }\n    return _recast(out)\n}"],
          "grid/line": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate struct _Vec: Codable {\n    var x: Double, y: Double, z: Double, hasZ: Bool\n    enum K: String, CodingKey { case x, y, z }\n    init(_ x: Double, _ y: Double, _ z: Double, _ hasZ: Bool) { self.x = x; self.y = y; self.z = z; self.hasZ = hasZ }\n    init(from d: Decoder) throws {\n        let c = try d.container(keyedBy: K.self)\n        x = try c.decode(Double.self, forKey: .x)\n        y = try c.decode(Double.self, forKey: .y)\n        z = try c.decodeIfPresent(Double.self, forKey: .z) ?? 0\n        hasZ = c.contains(.z)\n    }\n    func encode(to e: Encoder) throws {\n        var c = e.container(keyedBy: K.self)\n        try c.encode(x, forKey: .x)\n        try c.encode(y, forKey: .y)\n        if hasZ { try c.encode(z, forKey: .z) }\n    }\n    var dot: Double { x * x + y * y + z * z }\n}\nfileprivate func _vec<A: Encodable>(_ a: A) -> _Vec { try! JSONDecoder().decode(_Vec.self, from: JSONEncoder().encode(a)) }\nfileprivate func _vdot(_ a: _Vec, _ b: _Vec) -> Double { a.x * b.x + a.y * b.y + a.z * b.z }", "fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _grid_line<A: Encodable, B: Encodable, T: Decodable>(_ a: A, _ b: B) -> [T] {\n    let p = _fields(a, [\"x\", \"y\"]), q = _fields(b, [\"x\", \"y\"])\n    for n in p + q { guard n.isFinite && n == n.rounded(.towardZero) else { fatalError(\"grid/line: a cell is not a whole number\") } }\n    var x0 = Int(p[0]), y0 = Int(p[1])\n    let x1 = Int(q[0]), y1 = Int(q[1])\n    let dx = abs(x1 - x0), dy = -abs(y1 - y0)\n    let sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1\n    var err = dx + dy\n    var out: [_Vec] = []\n    while true {\n        out.append(_Vec(Double(x0), Double(y0), 0, false))\n        if x0 == x1 && y0 == y1 { break }\n        let e2 = 2 * err\n        if e2 >= dy { err += dy; x0 += sx }\n        if e2 <= dx { err += dx; y0 += sy }\n    }\n    return _recast(out)\n}"],
          "grid/in-bounds": ["fileprivate func _fields<A: Encodable>(_ a: A, _ names: [String]) -> [Double] {\n    let d = try! JSONDecoder().decode([String: Double].self, from: JSONEncoder().encode(a))\n    return names.map { n in\n        guard let x = d[n] else { fatalError(\"missing field \" + n) }\n        return x\n    }\n}", "fileprivate func _in_bounds<A: Encodable>(_ a: A, _ w: Double, _ h: Double) -> Bool {\n    let p = _fields(a, [\"x\", \"y\"])\n    return p[0] >= 0 && p[0] < w && p[1] >= 0 && p[1] < h\n}"],
          "noise/perlin": ["fileprivate let _perm: [Int] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180]\nfileprivate func _p(_ i: Int) -> Int { _perm[i & 255] }\nfileprivate func _fade(_ t: Double) -> Double { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfileprivate func _nlerp(_ a: Double, _ b: Double, _ t: Double) -> Double { a + t * (b - a) }\nfileprivate func _grad2(_ hash: Int, _ x: Double, _ y: Double) -> Double {\n    let h = hash & 7\n    let u = h < 4 ? x : y\n    let v = h < 4 ? y : x\n    return (h & 1 == 0 ? u : -u) + (h & 2 == 0 ? v : -v)\n}\nfileprivate func _perlin(_ x: Double, _ y: Double, _ seed: Double) -> Double {\n    let s = Int(seed.rounded(.down)) & 255\n    let xi = (Int(x.rounded(.down)) + s) & 255\n    let yi = (Int(y.rounded(.down)) + s) & 255\n    let xf = x - x.rounded(.down)\n    let yf = y - y.rounded(.down)\n    let u = _fade(xf), v = _fade(yf)\n    let aa = _p(_p(xi) + yi)\n    let ab = _p(_p(xi) + yi + 1)\n    let ba = _p(_p(xi + 1) + yi)\n    let bb = _p(_p(xi + 1) + yi + 1)\n    let x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    let x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}"],
          "noise/simplex": ["fileprivate let _perm: [Int] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180]\nfileprivate func _p(_ i: Int) -> Int { _perm[i & 255] }\nfileprivate func _fade(_ t: Double) -> Double { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfileprivate func _nlerp(_ a: Double, _ b: Double, _ t: Double) -> Double { a + t * (b - a) }\nfileprivate func _grad2(_ hash: Int, _ x: Double, _ y: Double) -> Double {\n    let h = hash & 7\n    let u = h < 4 ? x : y\n    let v = h < 4 ? y : x\n    return (h & 1 == 0 ? u : -u) + (h & 2 == 0 ? v : -v)\n}\nfileprivate func _perlin(_ x: Double, _ y: Double, _ seed: Double) -> Double {\n    let s = Int(seed.rounded(.down)) & 255\n    let xi = (Int(x.rounded(.down)) + s) & 255\n    let yi = (Int(y.rounded(.down)) + s) & 255\n    let xf = x - x.rounded(.down)\n    let yf = y - y.rounded(.down)\n    let u = _fade(xf), v = _fade(yf)\n    let aa = _p(_p(xi) + yi)\n    let ab = _p(_p(xi) + yi + 1)\n    let ba = _p(_p(xi + 1) + yi)\n    let bb = _p(_p(xi + 1) + yi + 1)\n    let x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    let x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "fileprivate func _simplex(_ x: Double, _ y: Double, _ seed: Double) -> Double {\n    (_perlin(x, y, seed) + _perlin(x * 2.0 + 5.2, y * 2.0 + 1.3, seed) * 0.5 + _perlin(x * 4.0 + 9.1, y * 4.0 + 7.7, seed) * 0.25) / 1.75\n}"],
          "noise/fbm": ["fileprivate let _perm: [Int] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180]\nfileprivate func _p(_ i: Int) -> Int { _perm[i & 255] }\nfileprivate func _fade(_ t: Double) -> Double { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfileprivate func _nlerp(_ a: Double, _ b: Double, _ t: Double) -> Double { a + t * (b - a) }\nfileprivate func _grad2(_ hash: Int, _ x: Double, _ y: Double) -> Double {\n    let h = hash & 7\n    let u = h < 4 ? x : y\n    let v = h < 4 ? y : x\n    return (h & 1 == 0 ? u : -u) + (h & 2 == 0 ? v : -v)\n}\nfileprivate func _perlin(_ x: Double, _ y: Double, _ seed: Double) -> Double {\n    let s = Int(seed.rounded(.down)) & 255\n    let xi = (Int(x.rounded(.down)) + s) & 255\n    let yi = (Int(y.rounded(.down)) + s) & 255\n    let xf = x - x.rounded(.down)\n    let yf = y - y.rounded(.down)\n    let u = _fade(xf), v = _fade(yf)\n    let aa = _p(_p(xi) + yi)\n    let ab = _p(_p(xi) + yi + 1)\n    let ba = _p(_p(xi + 1) + yi)\n    let bb = _p(_p(xi + 1) + yi + 1)\n    let x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    let x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "fileprivate func _fbm(_ x: Double, _ y: Double, _ octaves: Double, _ seed: Double) -> Double {\n    let n = min(max(Int(octaves.rounded(.down)), 1), 8)\n    var total = 0.0, freq = 1.0, amp = 1.0, mx = 0.0\n    for _ in 0..<n {\n        total += _perlin(x * freq, y * freq, seed) * amp\n        mx += amp\n        freq *= 2.0\n        amp *= 0.5\n    }\n    return total / mx\n}"],
          "prob/seed": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}"],
          "prob/uniform": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}", "fileprivate func _prob_uniform(_ lo: Double, _ hi: Double) -> Double { lo + _prob_next() * (hi - lo) }"],
          "prob/flip": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}"],
          "prob/gaussian": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}", "fileprivate func _prob_normal() -> Double {\n    let u1 = _prob_next()\n    let u2 = _prob_next()\n    return (-2.0 * log(u1)).squareRoot() * cos(2.0 * Double.pi * u2)\n}", "fileprivate func _prob_gaussian(_ mu: Double, _ sigma: Double) -> Double { mu + sigma * _prob_normal() }"],
          "prob/beta": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}", "fileprivate func _prob_normal() -> Double {\n    let u1 = _prob_next()\n    let u2 = _prob_next()\n    return (-2.0 * log(u1)).squareRoot() * cos(2.0 * Double.pi * u2)\n}", "fileprivate func _prob_gamma(_ shape: Double) -> Double {\n    if shape.isNaN { return Double.nan }\n    if shape < 1.0 {\n        let u = _prob_next()\n        return _prob_gamma(shape + 1.0) * pow(u, 1.0 / shape)\n    }\n    let d = shape - 1.0 / 3.0\n    let c = 1.0 / (9.0 * d).squareRoot()\n    while true {\n        var x = 0.0, v = 0.0\n        while true {\n            x = _prob_normal()\n            v = 1.0 + c * x\n            if v > 0.0 || v.isNaN { break }\n        }\n        v = v * v * v\n        let u = _prob_next()\n        if u < 1.0 - 0.0331 * (x * x) * (x * x) { return d * v }\n        if log(u) < 0.5 * x * x + d * (1.0 - v + log(v)) { return d * v }\n    }\n}", "fileprivate func _prob_beta(_ a: Double, _ b: Double) -> Double {\n    let x = _prob_gamma(a)\n    let y = _prob_gamma(b)\n    return x / (x + y)\n}"],
          "prob/categorical": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}", "fileprivate func _prob_categorical<T>(_ items: [T], _ weights: [Double]) -> T {\n    guard items.count == weights.count else { fatalError(\"prob/categorical: the items and the weights differ in number\") }\n    let total = weights.reduce(0, +)\n    guard !items.isEmpty, !weights.contains(where: { $0 < 0 || $0.isNaN }), total > 0 else { fatalError(\"prob/categorical: needs at least one item and non-negative weights with a positive sum\") }\n    var r = _prob_next() * total\n    for (item, w) in zip(items, weights) {\n        r -= w\n        if r <= 0 { return item }\n    }\n    return items[items.count - 1]\n}"],
          "prob/poisson": ["fileprivate var _prob_state: UInt32 = 0\nfileprivate var _prob_started = false\nfileprivate func _prob_seed(_ n: Double) -> Double? {\n    if n.isFinite {\n        let m = n.rounded(.towardZero).truncatingRemainder(dividingBy: 4294967296)\n        _prob_state = UInt32(m < 0 ? m + 4294967296 : m)\n    } else {\n        _prob_state = 0\n    }\n    _prob_started = true\n    return nil\n}\nfileprivate func _prob_next() -> Double {\n    if !_prob_started {\n        _prob_state = UInt32.random(in: 0...UInt32.max)\n        _prob_started = true\n    }\n    _prob_state = _prob_state &+ 0x6D2B79F5\n    var t = _prob_state\n    t = (t ^ (t >> 15)) &* (t | 1)\n    t ^= t &+ ((t ^ (t >> 7)) &* (t | 61))\n    return Double(t ^ (t >> 14)) / 4294967296.0\n}", "fileprivate func _prob_poisson(_ lambda: Double) -> Double {\n    let limit = exp(-lambda)\n    var k = 0.0, p = 1.0\n    while true {\n        k += 1.0\n        p *= _prob_next()\n        if p <= limit || p.isNaN { break }\n    }\n    return k - 1.0\n}"],
          "prob/sample": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _prob_sample<T>(_ n: Double, _ f: () -> T) -> [T] { (0..<_count(n)).map { _ in f() } }"],
          "prob/expected-value": ["fileprivate func _prob_mean(_ a: [Double]) -> Double {\n    guard !a.isEmpty else { fatalError(\"prob: needs at least one sample\") }\n    return a.reduce(0, +) / Double(a.count)\n}"],
          "prob/variance": ["fileprivate func _prob_mean(_ a: [Double]) -> Double {\n    guard !a.isEmpty else { fatalError(\"prob: needs at least one sample\") }\n    return a.reduce(0, +) / Double(a.count)\n}", "fileprivate func _prob_variance(_ a: [Double]) -> Double {\n    let m = _prob_mean(a)\n    return a.map { ($0 - m) * ($0 - m) }.reduce(0, +) / Double(a.count)\n}"],
          "prob/histogram": ["fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate struct _HistRow: Encodable { let binEdges: [Double]; let counts: [Double] }", "fileprivate func _prob_histogram<T: Decodable>(_ a: [Double], _ bins: Double) -> T? {\n    if bins < 1 || bins != bins.rounded(.towardZero) { return nil }\n    if a.isEmpty { return _recast(_HistRow(binEdges: [], counts: [])) }\n    let mn = a.reduce(Double.infinity, { Swift.min($0, $1) }), mx = a.reduce(-Double.infinity, { Swift.max($0, $1) })\n    var width = (mx - mn) / bins\n    if width == 0 || width.isNaN { width = 1 }\n    let n = Int(bins)\n    var counts = [Double](repeating: 0, count: n)\n    for s in a {\n        let i = Swift.min(Int(((s - mn) / width).rounded(.down)), n - 1)\n        counts[Swift.max(i, 0)] += 1\n    }\n    return _recast(_HistRow(binEdges: (0...n).map { mn + Double($0) * width }, counts: counts))\n}"],
          "prob/percentile": ["fileprivate func _prob_sorted(_ a: [Double]) -> [Double] { a.enumerated().sorted { $0.element < $1.element || ($0.element == $1.element && $0.offset < $1.offset) }.map { $0.element } }", "fileprivate func _prob_percentile(_ a: [Double], _ p: Double) -> Double? {\n    if !(p >= 0 && p <= 100) || a.isEmpty { return nil }\n    let s = _prob_sorted(a)\n    let idx = (p / 100.0) * Double(s.count - 1)\n    let lo = Int(idx.rounded(.down)), hi = Int(idx.rounded(.up))\n    if lo == hi { return s[lo] }\n    let frac = idx - Double(lo)\n    return s[lo] * (1.0 - frac) + s[hi] * frac\n}"],
          "prob/credible-interval": ["fileprivate func _prob_sorted(_ a: [Double]) -> [Double] { a.enumerated().sorted { $0.element < $1.element || ($0.element == $1.element && $0.offset < $1.offset) }.map { $0.element } }", "fileprivate func _prob_interval(_ a: [Double], _ alpha: Double) -> [Double]? {\n    if !(alpha >= 0 && alpha <= 1) || a.isEmpty { return nil }\n    let s = _prob_sorted(a)\n    let last = Double(s.count - 1)\n    let lo = Int(((alpha / 2.0) * last).rounded(.down))\n    let hi = Int(((1.0 - alpha / 2.0) * last).rounded(.up))\n    return [s[lo], s[hi]]\n}"],
          "time/add": ["fileprivate struct _Moment { var ms: Double; var dateOnly: Bool }\nfileprivate func _ediv(_ a: Int, _ b: Int) -> Int { let q = a / b; return (a % b != 0 && (a < 0) != (b < 0)) ? q - 1 : q }\nfileprivate func _erem(_ a: Int, _ b: Int) -> Int { a - _ediv(a, b) * b }\nfileprivate func _leap(_ y: Int) -> Bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }\nfileprivate func _dim(_ y: Int, _ m: Int) -> Int {\n    switch m {\n    case 1, 3, 5, 7, 8, 10, 12: return 31\n    case 4, 6, 9, 11: return 30\n    case 2: return _leap(y) ? 29 : 28\n    default: return 30\n    }\n}\nfileprivate func _ts_date(_ ts: Double) -> (Int, Int, Int) {\n    let days = Int((ts / 86_400_000.0).rounded(.down))\n    let shifted = days + 719_468\n    let era = _ediv(shifted, 146_097)\n    let doe = _erem(shifted, 146_097)\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    let mp = (5 * doy + 2) / 153\n    let day = doy - (153 * mp + 2) / 5 + 1\n    let month = mp < 10 ? mp + 3 : mp - 9\n    return (yoe + era * 400 + (month <= 2 ? 1 : 0), month, day)\n}\nfileprivate func _date_ts(_ year: Int, _ month: Int, _ day: Int) -> Double {\n    let y = year - (month <= 2 ? 1 : 0)\n    let era = _ediv(y, 400)\n    let yoe = _erem(y, 400)\n    let mp = (month + 9) % 12\n    let doy = (153 * mp + 2) / 5 + day - 1\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n    return Double(era * 146_097 + doe - 719_468) * 86_400_000.0\n}\nfileprivate func _parse_iso(_ text: String) -> _Moment? {\n    let b = Array(text.utf8)\n    func num(_ from: Int, _ len: Int) -> Int? {\n        guard from + len <= b.count else { return nil }\n        var v = 0\n        for c in b[from..<from + len] {\n            guard c >= 48 && c <= 57 else { return nil }\n            v = v * 10 + Int(c - 48)\n        }\n        return v\n    }\n    guard b.count > 7, b[4] == 45, b[7] == 45, let y = num(0, 4), let mo = num(5, 2), let d = num(8, 2), mo >= 1, mo <= 12, d >= 1, d <= _dim(y, mo) else { return nil }\n    var ms = _date_ts(y, mo, d)\n    if b.count == 10 { return _Moment(ms: ms, dateOnly: true) }\n    guard b.count > 13, b[10] == 84, b[13] == 58, let hour = num(11, 2), let minute = num(14, 2), hour <= 23, minute <= 59 else { return nil }\n    ms += Double(hour * 3_600_000 + minute * 60_000)\n    var at = 16\n    if at < b.count, b[at] == 58 {\n        guard let second = num(at + 1, 2), second <= 59 else { return nil }\n        ms += Double(second * 1000)\n        at += 3\n        if at < b.count, b[at] == 46 {\n            let start = at + 1\n            var end = start\n            while end < b.count, b[end] >= 48, b[end] <= 57 { end += 1 }\n            if end == start { return nil }\n            var digits = Array(b[start..<end]).prefix(3).map { Int($0 - 48) }\n            while digits.count < 3 { digits.append(0) }\n            ms += Double(digits[0] * 100 + digits[1] * 10 + digits[2])\n            at = end\n        }\n    }\n    let rest = Array(b[min(at, b.count)...])\n    if rest == [90] { return _Moment(ms: ms, dateOnly: false) }\n    guard rest.count == 6, rest[0] == 43 || rest[0] == 45, rest[3] == 58 else { return nil }\n    guard let oh = num(at + 1, 2), let om = num(at + 4, 2), oh <= 23, om <= 59 else { return nil }\n    let offset = Double((oh * 60 + om) * 60_000)\n    return _Moment(ms: rest[0] == 45 ? ms + offset : ms - offset, dateOnly: false)\n}\nfileprivate func _mo(_ v: Any) -> _Moment {\n    guard let s = v as? String, let m = _parse_iso(s) else { fatalError(\"expected a date or datetime (ISO-8601 text)\") }\n    return m\n}\nfileprivate func _need_tod(_ op: String) -> Never { fatalError(op + \" needs a time of day and a date carries none: pass a datetime\") }\nfileprivate func _checked_year(_ ms: Double) -> Double {\n    guard ms.isFinite else { fatalError(\"a time is outside the years 0000 to 9999\") }\n    let y = _ts_date(ms).0\n    guard y >= 0 && y <= 9999 else { fatalError(\"a time is outside the years 0000 to 9999\") }\n    return ms\n}\nfileprivate func _render(_ ms: Double, _ dateOnly: Bool) -> String {\n    let t = _checked_year(ms).rounded(.down)\n    let (y, m, d) = _ts_date(t)\n    if dateOnly { return String(format: \"%04d-%02d-%02d\", y, m, d) }\n    let tod = _erem(Int(t), 86_400_000)\n    return String(format: \"%04d-%02d-%02dT%02d:%02d:%02d.%03dZ\", y, m, d, tod / 3_600_000, (tod / 60_000) % 60, (tod / 1000) % 60, tod % 1000)\n}\nfileprivate enum _Unit { case ms, s, m, h, d, w, month, quarter, year }\nfileprivate func _unit(_ u: String) -> _Unit {\n    switch u {\n    case \"ms\", \"millisecond\", \"milliseconds\": return .ms\n    case \"s\", \"second\", \"seconds\": return .s\n    case \"m\", \"minute\", \"minutes\": return .m\n    case \"h\", \"hour\", \"hours\": return .h\n    case \"d\", \"day\", \"days\": return .d\n    case \"w\", \"week\", \"weeks\": return .w\n    case \"month\", \"months\": return .month\n    case \"quarter\", \"quarters\": return .quarter\n    case \"year\", \"years\": return .year\n    default: fatalError(\"expected a time unit, got \" + u)\n    }\n}\nfileprivate func _fixed(_ u: _Unit) -> Double? {\n    switch u {\n    case .ms: return 1\n    case .s: return 1000\n    case .m: return 60_000\n    case .h: return 3_600_000\n    case .d: return 86_400_000\n    case .w: return 604_800_000\n    default: return nil\n    }\n}\nfileprivate func _below_day(_ u: _Unit) -> Bool { u == .ms || u == .s || u == .m || u == .h }\nfileprivate func _add_months(_ ts: Double, _ months: Int) -> Double {\n    let (y, m, d) = _ts_date(ts)\n    let tod = ts - _date_ts(y, m, d)\n    let total = y * 12 + (m - 1) + months\n    let ny = _ediv(total, 12), nm = _erem(total, 12) + 1\n    return _date_ts(ny, nm, min(d, _dim(ny, nm))) + tod\n}\nfileprivate func _shift(_ m: _Moment, _ amount: Double, _ u: _Unit, _ op: String) -> String {\n    if m.dateOnly {\n        if _below_day(u) { _need_tod(op) }\n        if _fixed(u) != nil && amount != amount.rounded(.towardZero) { fatalError(op + \" on a date takes a whole amount of days or weeks\") }\n    }\n    if let f = _fixed(u) { return _render(m.ms + amount * f, m.dateOnly) }\n    guard amount == amount.rounded(.towardZero), abs(amount) <= 4294967295 else { fatalError(\"a calendar unit takes a whole amount\") }\n    let n = Int(amount)\n    return _render(_add_months(m.ms, u == .year ? n * 12 : (u == .quarter ? n * 3 : n)), m.dateOnly)\n}\nfileprivate func _time_add(_ d: Any, _ n: Double, _ u: String) -> String { _shift(_mo(d), n, _unit(u), \"time/add\") }\nfileprivate func _time_subtract(_ d: Any, _ n: Double, _ u: String) -> String { _shift(_mo(d), -n, _unit(u), \"time/subtract\") }\nfileprivate func _pair(_ a: Any, _ b: Any) -> (_Moment, _Moment) {\n    let x = _mo(a), y = _mo(b)\n    guard x.dateOnly == y.dateOnly else { fatalError(\"expected two dates or two datetimes\") }\n    return (x, y)\n}\nfileprivate func _months_between(_ from: Double, _ to: Double) -> Int {\n    let lo = min(from, to), hi = max(from, to)\n    let (y1, m1, d1) = _ts_date(lo), (y2, m2, d2) = _ts_date(hi)\n    let tod1 = lo - _date_ts(y1, m1, d1), tod2 = hi - _date_ts(y2, m2, d2)\n    var months = (y2 - y1) * 12 + (m2 - m1)\n    if d2 < d1 || (d2 == d1 && tod2 < tod1) { months -= 1 }\n    return to < from ? -months : months\n}\nfileprivate func _time_diff(_ a: Any, _ b: Any, _ unit: String? = nil) -> Double {\n    let (x, y) = _pair(a, b)\n    let diff = x.ms - y.ms\n    guard let unit else { return diff }\n    let u = _unit(unit)\n    if let f = _fixed(u) { return (diff / f).rounded(.towardZero) }\n    let months = Double(_months_between(y.ms, x.ms))\n    switch u {\n    case .year: return (months / 12.0).rounded(.towardZero)\n    case .quarter: return (months / 3.0).rounded(.towardZero)\n    default: return months\n    }\n}\nfileprivate func _time_before(_ a: Any, _ b: Any) -> Bool { let (x, y) = _pair(a, b); return x.ms < y.ms }\nfileprivate func _time_after(_ a: Any, _ b: Any) -> Bool { let (x, y) = _pair(a, b); return x.ms > y.ms }\nfileprivate func _time_between(_ t: Any, _ s: Any, _ e: Any) -> Bool {\n    let x = _mo(t), y = _mo(s), z = _mo(e)\n    guard x.dateOnly == y.dateOnly, x.dateOnly == z.dateOnly else { fatalError(\"expected two dates or two datetimes\") }\n    return x.ms >= y.ms && x.ms <= z.ms\n}\nfileprivate func _start_of(_ ts: Double, _ u: _Unit) -> Double {\n    let day = 86_400_000.0\n    switch u {\n    case .ms: return ts.rounded(.down)\n    case .s: return (ts / 1000.0).rounded(.down) * 1000.0\n    case .m: return (ts / 60_000.0).rounded(.down) * 60_000.0\n    case .h: return (ts / 3_600_000.0).rounded(.down) * 3_600_000.0\n    case .d: return (ts / day).rounded(.down) * day\n    case .w:\n        let days = Int((ts / day).rounded(.down))\n        return Double(days - _erem(days + 3, 7)) * day\n    case .month:\n        let (y, m, _) = _ts_date(ts)\n        return _date_ts(y, m, 1)\n    case .quarter:\n        let (y, m, _) = _ts_date(ts)\n        return _date_ts(y, (m - 1) / 3 * 3 + 1, 1)\n    case .year: return _date_ts(_ts_date(ts).0, 1, 1)\n    }\n}\nfileprivate func _time_same(_ a: Any, _ b: Any, _ unit: String? = nil) -> Bool {\n    let (x, y) = _pair(a, b)\n    guard let unit else { return abs(x.ms - y.ms) < 1.0 }\n    let u = _unit(unit)\n    if _below_day(u) && (x.dateOnly || y.dateOnly) { _need_tod(\"time/isSame\") }\n    return _start_of(x.ms, u) == _start_of(y.ms, u)\n}\nfileprivate func _time_start_of(_ d: Any, _ unit: String) -> String {\n    let m = _mo(d), u = _unit(unit)\n    if m.dateOnly && _below_day(u) { _need_tod(\"time/startOf\") }\n    return _render(_start_of(m.ms, u), m.dateOnly)\n}\nfileprivate func _time_end_of(_ d: Any, _ unit: String) -> String {\n    let m = _mo(d), u = _unit(unit)\n    if m.dateOnly && _below_day(u) { _need_tod(\"time/endOf\") }\n    let ts = m.ms, day = 86_400_000.0\n    let r: Double\n    switch u {\n    case .ms: r = ts.rounded(.down)\n    case .s: r = ((ts / 1000.0).rounded(.down) + 1.0) * 1000.0 - 1.0\n    case .m: r = ((ts / 60_000.0).rounded(.down) + 1.0) * 60_000.0 - 1.0\n    case .h: r = ((ts / 3_600_000.0).rounded(.down) + 1.0) * 3_600_000.0 - 1.0\n    case .d: r = ((ts / day).rounded(.down) + 1.0) * day - 1.0\n    case .w:\n        let days = Int((ts / day).rounded(.down))\n        r = Double(days - _erem(days + 3, 7) + 7) * day - 1.0\n    case .month:\n        let (y, mo, _) = _ts_date(ts)\n        r = (mo >= 12 ? _date_ts(y + 1, 1, 1) : _date_ts(y, mo + 1, 1)) - 1.0\n    case .quarter:\n        let (y, mo, _) = _ts_date(ts)\n        let next = (mo - 1) / 3 * 3 + 4\n        r = (next > 12 ? _date_ts(y + 1, next - 12, 1) : _date_ts(y, next, 1)) - 1.0\n    case .year: r = _date_ts(_ts_date(ts).0 + 1, 1, 1) - 1.0\n    }\n    return _render(r, m.dateOnly)\n}\nfileprivate func _time_parse(_ s: String) -> String? { _parse_iso(s).map { _render($0.ms, $0.dateOnly) } }\nfileprivate func _time_valid(_ s: String) -> Bool { _parse_iso(s) != nil }\nfileprivate func _time_part(_ d: Any, _ part: String) -> Double {\n    let m = _mo(d)\n    if part == \"hour\" || part == \"minute\" || part == \"second\" {\n        if m.dateOnly { _need_tod(\"time/\" + part) }\n    }\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    switch part {\n    case \"year\": return Double(y)\n    case \"month\": return Double(mo)\n    case \"day\": return Double(da)\n    case \"weekday\": return Double(_erem(Int((t / 86_400_000.0).rounded(.down)) + 4, 7))\n    case \"hour\": return Double(tod / 3_600_000)\n    case \"minute\": return Double((tod / 60_000) % 60)\n    default: return Double((tod / 1000) % 60)\n    }\n}\nfileprivate func _time_format(_ d: Any, _ format: String) -> String {\n    let m = _mo(d)\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    let (hh, mi, ss) = (tod / 3_600_000, (tod / 60_000) % 60, (tod / 1000) % 60)\n    let dow = _erem(Int((t / 86_400_000.0).rounded(.down)) + 4, 7)\n    let wl = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n    let ml = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"]\n    let tokens: [(String, String)] = [(\"YYYY\", String(format: \"%04d\", y)), (\"MMMM\", ml[mo - 1]), (\"dddd\", wl[dow]), (\"MMM\", String(ml[mo - 1].prefix(3))), (\"ddd\", String(wl[dow].prefix(3))), (\"YY\", String(format: \"%02d\", _erem(y, 100))), (\"MM\", String(format: \"%02d\", mo)), (\"DD\", String(format: \"%02d\", da)), (\"HH\", String(format: \"%02d\", hh)), (\"mm\", String(format: \"%02d\", mi)), (\"ss\", String(format: \"%02d\", ss)), (\"M\", String(mo)), (\"D\", String(da)), (\"H\", String(hh)), (\"m\", String(mi)), (\"s\", String(ss))]\n    let sc = Array(format.unicodeScalars)\n    var out = String.UnicodeScalarView()\n    var i = 0\n    outer: while i < sc.count {\n        for (token, value) in tokens {\n            let tk = Array(token.unicodeScalars)\n            if i + tk.count <= sc.count && sc[i..<i + tk.count].elementsEqual(tk) {\n                if m.dateOnly && [\"HH\", \"mm\", \"ss\", \"H\", \"m\", \"s\"].contains(token) { _need_tod(\"time/format\") }\n                out.append(contentsOf: value.unicodeScalars)\n                i += tk.count\n                continue outer\n            }\n        }\n        out.append(sc[i])\n        i += 1\n    }\n    return String(out)\n}\nfileprivate func _time_duration(_ ms: Double) -> String {\n    let total = UInt64((ms / 1000.0).magnitude)\n    let days = total / 86400, hours = (total % 86400) / 3600, minutes = (total % 3600) / 60, seconds = total % 60\n    var parts: [String] = []\n    if days > 0 { parts.append(\"\\(days)d\") }\n    if hours > 0 { parts.append(\"\\(hours)h\") }\n    if minutes > 0 { parts.append(\"\\(minutes)m\") }\n    if seconds > 0 || parts.isEmpty { parts.append(\"\\(seconds)s\") }\n    return parts.joined(separator: \" \")\n}\nfileprivate func _now_ms() -> Double { (Date().timeIntervalSince1970 * 1000).rounded(.down) }\nfileprivate func _time_now() -> String { _render(_now_ms(), false) }\nfileprivate func _time_today() -> String { _render((_now_ms() / 86_400_000.0).rounded(.down) * 86_400_000.0, false) }\nfileprivate func _time_past(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isPast\") }; return m.ms < _now_ms() }\nfileprivate func _time_future(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isFuture\") }; return m.ms > _now_ms() }\nfileprivate func _time_today_is(_ d: Any) -> Bool { (_mo(d).ms / 86_400_000.0).rounded(.down) == (_now_ms() / 86_400_000.0).rounded(.down) }\nfileprivate func _time_relative(_ d: Any) -> String {\n    let m = _mo(d)\n    if m.dateOnly { _need_tod(\"time/relative\") }\n    let diff = _now_ms() - m.ms\n    func phrase(_ n: Int, _ unit: String) -> String {\n        let plural = n == 1 ? \"\" : \"s\"\n        return diff < 0 ? \"in \\(n) \\(unit)\\(plural)\" : \"\\(n) \\(unit)\\(plural) ago\"\n    }\n    let ms = abs(diff)\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0)\n    if ms < minute { return \"just now\" }\n    if ms < hour { return phrase(Int((ms / minute).rounded()), \"minute\") }\n    if ms < day { return phrase(Int((ms / hour).rounded()), \"hour\") }\n    if ms < 7.0 * day { return phrase(Int((ms / day).rounded()), \"day\") }\n    if ms < 30.0 * day { return phrase(Int((ms / (7.0 * day)).rounded()), \"week\") }\n    if ms < 365.0 * day { return phrase(Int((ms / (30.0 * day)).rounded()), \"month\") }\n    return phrase(Int((ms / (365.0 * day)).rounded()), \"year\")\n}"],
