          "math/lerp": ["fileprivate func _lerp(_ a: Double, _ b: Double, _ t: Double) -> Double { a + (b - a) * t }"],
          "math/map": ["fileprivate func _remap(_ v: Double, _ inMin: Double, _ inMax: Double, _ outMin: Double, _ outMax: Double) -> Double {\n    if abs(inMax - inMin) < Double.ulpOfOne { return outMin }\n    return (v - inMin) / (inMax - inMin) * (outMax - outMin) + outMin\n}"],
