          "array/nth": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _nth<T>(_ a: [T], _ i: Double) -> T? {\n    let k = _count(i)\n    return k < a.count ? a[k] : nil\n}"],
          "array/range": ["fileprivate func _range(_ a: Double, _ b: Double? = nil, _ step: Double = 1) -> [Double] {\n    let start = b == nil ? 0 : a\n    let end = b ?? a\n    guard step != 0, step.isFinite else { fatalError(\"range: step must be a non-zero finite number\") }\n    var out: [Double] = []\n    var x = start\n    while step > 0 ? x < end : x > end {\n        out.append(x)\n        x += step\n    }\n    return out\n}"],
