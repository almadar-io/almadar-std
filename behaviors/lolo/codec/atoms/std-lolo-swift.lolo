          "str/slice": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _str_slice(_ s: String, _ a: Double, _ b: Double? = nil) -> String {\n    let sc = Array(s.unicodeScalars)\n    let n = sc.count\n    func at(_ i: Int) -> Int { i < 0 ? max(0, n + i) : min(i, n) }\n    let lo = at(_whole(a))\n    let hi = b.map { at(_whole($0)) } ?? n\n    return lo < hi ? _str(sc[lo..<hi]) : \"\"\n}"],
          "str/padStart": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _pad_start(_ s: String, _ n: Double, _ p: String = \" \") -> String {\n    guard p.unicodeScalars.count == 1 else { fatalError(\"expected a single padding character\") }\n    let k = max(0, _whole(n) - s.unicodeScalars.count)\n    return String(repeating: p, count: k) + s\n}"],
