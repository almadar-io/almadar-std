    case .s: r = ((ts / 1000.0).rounded(.down) + 1.0) * 1000.0 - 1.0\n    case .m: r = ((ts / 60_000.0).rounded(.down) + 1.0) * 60_000.0 - 1.0\n    case .h: r = ((ts / 3_600_000.0).rounded(.down) + 1.0) * 3_600_000.0 - 1.0\n    case .d: r = ((ts / day).rounded(.down) + 1.0) * day - 1.0\n    case .w:\n        let days = Int((ts / day).rounded(.down))\n        r = Double(days - _erem(days + 3, 7) + 7) * day - 1.0\n    case .month:\n        let (y, mo, _) = _ts_date(ts)\n        r = (mo >= 12 ? _date_ts(y + 1, 1, 1) : _date_ts(y, mo + 1, 1)) - 1.0\n    case .quarter:\n        let (y, mo, _) = _ts_date(ts)\n        let next = (mo - 1) / 3 * 3 + 4\n        r = (next > 12 ? _date_ts(y + 1, next - 12, 1) : _date_ts(y, next, 1)) - 1.0\n    case .year: r = _date_ts(_ts_date(ts).0 + 1, 1, 1) - 1.0\n    }\n    return _render(r, m.dateOnly)\n}\nfileprivate func _time_parse(_ s: String) -> String? { _parse_iso(s).map { _render($0.ms, $0.dateOnly) } }\nfileprivate func _time_valid(_ s: String) -> Bool { _parse_iso(s) != nil }\nfileprivate func _time_part(_ d: Any, _ part: String) -> Double {\n    let m = _mo(d)\n    if part == \"hour\" || part == \"minute\" || part == \"second\" {\n        if m.dateOnly { _need_tod(\"time/\" + part) }\n    }\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    switch part {\n    case \"year\": return Double(y)\n    case \"month\": return Double(mo)\n    case \"day\": return Double(da)\n    case \"weekday\": return Double(_erem(Int((t / 86_400_000.0).rounded(.down)) + 4, 7))\n    case \"hour\": return Double(tod / 3_600_000)\n    case \"minute\": return Double((tod / 60_000) % 60)\n    default: return Double((tod / 1000) % 60)\n    }\n}\nfileprivate func _time_format(_ d: Any, _ format: String) -> String {\n    let m = _mo(d)\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    let (hh, mi, ss) = (tod / 3_600_000, (tod / 60_000) % 60, (tod / 1000) % 60)\n    let dow = _erem(Int((t / 86_400_000.0).rounded(.down)) + 4, 7)\n    let wl = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n    let ml = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"]\n    let tokens: [(String, String)] = [(\"YYYY\", String(format: \"%04d\", y)), (\"MMMM\", ml[mo - 1]), (\"dddd\", wl[dow]), (\"MMM\", String(ml[mo - 1].prefix(3))), (\"ddd\", String(wl[dow].prefix(3))), (\"YY\", String(format: \"%02d\", _erem(y, 100))), (\"MM\", String(format: \"%02d\", mo)), (\"DD\", String(format: \"%02d\", da)), (\"HH\", String(format: \"%02d\", hh)), (\"mm\", String(format: \"%02d\", mi)), (\"ss\", String(format: \"%02d\", ss)), (\"M\", String(mo)), (\"D\", String(da)), (\"H\", String(hh)), (\"m\", String(mi)), (\"s\", String(ss))]\n    let sc = Array(format.unicodeScalars)\n    var out = String.UnicodeScalarView()\n    var i = 0\n    outer: while i < sc.count {\n        for (token, value) in tokens {\n            let tk = Array(token.unicodeScalars)\n            if i + tk.count <= sc.count && sc[i..<i + tk.count].elementsEqual(tk) {\n                if m.dateOnly && [\"HH\", \"mm\", \"ss\", \"H\", \"m\", \"s\"].contains(token) { _need_tod(\"time/format\") }\n                out.append(contentsOf: value.unicodeScalars)\n                i += tk.count\n                continue outer\n            }\n        }\n        out.append(sc[i])\n        i += 1\n    }\n    return String(out)\n}\nfileprivate func _time_duration(_ ms: Double) -> String {\n    let total = UInt64((ms / 1000.0).magnitude)\n    let days = total / 86400, hours = (total % 86400) / 3600, minutes = (total % 3600) / 60, seconds = total % 60\n    var parts: [String] = []\n    if days > 0 { parts.append(\"\\(days)d\") }\n    if hours > 0 { parts.append(\"\\(hours)h\") }\n    if minutes > 0 { parts.append(\"\\(minutes)m\") }\n    if seconds > 0 || parts.isEmpty { parts.append(\"\\(seconds)s\") }\n    return parts.joined(separator: \" \")\n}\nfileprivate func _now_ms() -> Double { (Date().timeIntervalSince1970 * 1000).rounded(.down) }\nfileprivate func _time_now() -> String { _render(_now_ms(), false) }\nfileprivate func _time_today() -> String { _render((_now_ms() / 86_400_000.0).rounded(.down) * 86_400_000.0, false) }\nfileprivate func _time_past(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isPast\") }; return m.ms < _now_ms() }\nfileprivate func _time_future(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isFuture\") }; return m.ms > _now_ms() }\nfileprivate func _time_today_is(_ d: Any) -> Bool { (_mo(d).ms / 86_400_000.0).rounded(.down) == (_now_ms() / 86_400_000.0).rounded(.down) }\nfileprivate func _time_relative(_ d: Any) -> String {\n    let m = _mo(d)\n    if m.dateOnly { _need_tod(\"time/relative\") }\n    let diff = _now_ms() - m.ms\n    func phrase(_ n: Int, _ unit: String) -> String {\n        let plural = n == 1 ? \"\" : \"s\"\n        return diff < 0 ? \"in \\(n) \\(unit)\\(plural)\" : \"\\(n) \\(unit)\\(plural) ago\"\n    }\n    let ms = abs(diff)\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0)\n    if ms < minute { return \"just now\" }\n    if ms < hour { return phrase(Int((ms / minute).rounded()), \"minute\") }\n    if ms < day { return phrase(Int((ms / hour).rounded()), \"hour\") }\n    if ms < 7.0 * day { return phrase(Int((ms / day).rounded()), \"day\") }\n    if ms < 30.0 * day { return phrase(Int((ms / (7.0 * day)).rounded()), \"week\") }\n    if ms < 365.0 * day { return phrase(Int((ms / (30.0 * day)).rounded()), \"month\") }\n    return phrase(Int((ms / (365.0 * day)).rounded()), \"year\")\n}"],
          "time/startOf": ["fileprivate struct _Moment { var ms: Double; var dateOnly: Bool }\nfileprivate func _ediv(_ a: Int, _ b: Int) -> Int { let q = a / b; return (a % b != 0 && (a < 0) != (b < 0)) ? q - 1 : q }\nfileprivate func _erem(_ a: Int, _ b: Int) -> Int { a - _ediv(a, b) * b }\nfileprivate func _leap(_ y: Int) -> Bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }\nfileprivate func _dim(_ y: Int, _ m: Int) -> Int {\n    switch m {\n    case 1, 3, 5, 7, 8, 10, 12: return 31\n    case 4, 6, 9, 11: return 30\n    case 2: return _leap(y) ? 29 : 28\n    default: return 30\n    }\n}\nfileprivate func _ts_date(_ ts: Double) -> (Int, Int, Int) {\n    let days = Int((ts / 86_400_000.0).rounded(.down))\n    let shifted = days + 719_468\n    let era = _ediv(shifted, 146_097)\n    let doe = _erem(shifted, 146_097)\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    let mp = (5 * doy + 2) / 153\n    let day = doy - (153 * mp + 2) / 5 + 1\n    let month = mp < 10 ? mp + 3 : mp - 9\n    return (yoe + era * 400 + (month <= 2 ? 1 : 0), month, day)\n}\nfileprivate func _date_ts(_ year: Int, _ month: Int, _ day: Int) -> Double {\n    let y = year - (month <= 2 ? 1 : 0)\n    let era = _ediv(y, 400)\n    let yoe = _erem(y, 400)\n    let mp = (month + 9) % 12\n    let doy = (153 * mp + 2) / 5 + day - 1\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n    return Double(era * 146_097 + doe - 719_468) * 86_400_000.0\n}\nfileprivate func _parse_iso(_ text: String) -> _Moment? {\n    let b = Array(text.utf8)\n    func num(_ from: Int, _ len: Int) -> Int? {\n        guard from + len <= b.count else { return nil }\n        var v = 0\n        for c in b[from..<from + len] {\n            guard c >= 48 && c <= 57 else { return nil }\n            v = v * 10 + Int(c - 48)\n        }\n        return v\n    }\n    guard b.count > 7, b[4] == 45, b[7] == 45, let y = num(0, 4), let mo = num(5, 2), let d =