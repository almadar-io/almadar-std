          "validate/check": ["fileprivate func _recast<T: Decodable, S: Encodable>(_ s: S) -> T { try! JSONDecoder().decode(T.self, from: try! JSONEncoder().encode(s)) }", "fileprivate func _js_space(_ c: Unicode.Scalar) -> Bool {\n    switch c.value {\n    case 0x09...0x0d, 0x20, 0xa0, 0x1680, 0x2000...0x200a, 0x2028, 0x2029, 0x202f, 0x205f, 0x3000, 0xfeff: return true\n    default: return false\n    }\n}", "fileprivate func _is_email(_ s: String) -> Bool {\n    let sc = Array(s.unicodeScalars)\n    guard !sc.contains(where: { _js_space($0) }), let at = sc.firstIndex(of: \"@\"), at >= 1 else { return false }\n    let rest = Array(sc[(at + 1)...])\n    guard !rest.contains(\"@\"), let dot = rest.firstIndex(of: \".\"), dot >= 1 else { return false }\n    return dot + 1 < rest.count\n}", "fileprivate struct _Rules: ExpressibleByDictionaryLiteral {\n    let fields: [(String, [[Any]])]\n    init(dictionaryLiteral e: (String, [[Any]])...) { fields = e }\n}", "fileprivate struct _CheckRow: Encodable { let valid: Bool; let errors: [String] }", "fileprivate func _any_num(_ v: Any) -> Double? { if let d = v as? Double { return d }; if let i = v as? Int { return Double(i) }; return nil }", "fileprivate func _any_eq(_ a: Any, _ b: Any) -> Bool {\n    if let x = a as? String, let y = b as? String { return x.unicodeScalars.elementsEqual(y.unicodeScalars) }\n    if let x = a as? Bool, let y = b as? Bool { return x == y }\n    if let x = _any_num(a), let y = _any_num(b), !(a is Bool), !(b is Bool) { return x == y }\n    return false\n}", "fileprivate func _validate_check<T: Decodable>(_ value: [String: Any], _ rules: _Rules) -> T {\n    var errors: [String] = []\n    for (field, list) in rules.fields {\n        let fv = value[field]\n        for rule in list {\n            guard let name = rule.first as? String else { fatalError(\"validate/check: a rule has no name\") }\n            let args = Array(rule.dropFirst())\n            func num(_ at: Int) -> Double {\n                gu