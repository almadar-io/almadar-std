          "str/replace": ["fileprivate func _replace(_ s: String, _ d: String, _ r: String, _ all: Bool) -> String {\n    let sc = Array(s.unicodeScalars), dc = Array(d.unicodeScalars)\n    var out = String.UnicodeScalarView()\n    var i = 0\n    var done = false\n    while i <= sc.count {\n        if !done, i + dc.count <= sc.count, sc[i..<i + dc.count].elementsEqual(dc) {\n            out.append(contentsOf: r.unicodeScalars)\n            done = !all\n            if dc.isEmpty {\n                if i < sc.count { out.append(sc[i]) }\n                i += 1\n            } else {\n                i += dc.count\n            }\n        } else {\n            if i < sc.count { out.append(sc[i]) }\n            i += 1\n        }\n    }\n    return String(out)\n}"],
          "str/replaceAll": ["fileprivate func _replace(_ s: String, _ d: String, _ r: String, _ all: Bool) -> String {\n    let sc = Array(s.unicodeScalars), dc = Array(d.unicodeScalars)\n    var out = String.UnicodeScalarView()\n    var i = 0\n    var done = false\n    while i <= sc.count {\n        if !done, i + dc.count <= sc.count, sc[i..<i + dc.count].elementsEqual(dc) {\n            out.append(contentsOf: r.unicodeScalars)\n            done = !all\n            if dc.isEmpty {\n                if i < sc.count { out.append(sc[i]) }\n                i += 1\n            } else {\n                i += dc.count\n            }\n        } else {\n            if i < sc.count { out.append(sc[i]) }\n            i += 1\n        }\n    }\n    return String(out)\n}"],
          "str/repeat": ["fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _repeat(_ s: String, _ n: Double) -> String { String(repeating: s, count: _count(n)) }"],
