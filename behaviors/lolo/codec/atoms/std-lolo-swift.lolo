{ return \"[]\" }\n        let items = a.map { _json_text($0, sorted, pretty, inner) }\n        return pretty ? \"[\\n\" + items.map { inner + $0 }.joined(separator: \",\\n\") + \"\\n\" + indent + \"]\" : \"[\" + items.joined(separator: \",\") + \"]\"\n    case .object(let o):\n        if o.isEmpty { return \"{}\" }\n        let keys = o.keys.sorted { Array($0.unicodeScalars).lexicographicallyPrecedes(Array($1.unicodeScalars)) }\n        let items = keys.map { quote($0) + (pretty ? \": \" : \":\") + _json_text(o[$0]!, sorted, pretty, inner) }\n        return pretty ? \"{\\n\" + items.map { inner + $0 }.joined(separator: \",\\n\") + \"\\n\" + indent + \"}\" : \"{\" + items.joined(separator: \",\") + \"}\"\n    }\n}", "fileprivate func _json_stringify(_ v: Any, _ o: [String: Bool]) -> String { _json_text(_any_jv(v), o[\"sorted\"] ?? false, o[\"pretty\"] ?? false) }"],
