          "time/add": "_time_add({{0}}, {{1}}, {{2}})",
          "time/subtract": "_time_subtract({{0}}, {{1}}, {{2}})",
          "time/diff#2": "_time_diff({{0}}, {{1}})",
          "time/diff#3": "_time_diff({{0}}, {{1}}, {{2}})",
          "time/isBefore": "_time_before({{0}}, {{1}})",
          "time/isAfter": "_time_after({{0}}, {{1}})",
          "time/isBetween": "_time_between({{0}}, {{1}}, {{2}})",
          "time/isSame#2": "_time_same({{0}}, {{1}})",
          "time/isSame#3": "_time_same({{0}}, {{1}}, {{2}})",
          "time/startOf": "_time_start_of({{0}}, {{1}})",
          "time/endOf": "_time_end_of({{0}}, {{1}})",
          "time/parse": "_time_parse({{0}})",
          "time/valid": "_time_valid({{0}})",
          "time/year": "_time_part({{0}}, \"year\")",
          "time/month": "_time_part({{0}}, \"month\")",
          "time/day": "_time_part({{0}}, \"day\")",
