  case .s: r = ((ts / 1000.0).rounded(.down) + 1.0) * 1000.0 - 1.0\n    case .m: r = ((ts / 60_000.0).rounded(.down) + 1.0) * 60_000.0 - 1.0\n    case .h: r = ((ts / 3_600_000.0).rounded(.down) + 1.0) * 3_600_000.0 - 1.0\n    case .d: r = ((ts / day).rounded(.down) + 1.0) * day - 1.0\n    case .w:\n        let days = Int((ts / day).rounded(.down))\n        r = Double(days - _erem(days + 3, 7) + 7) * day - 1.0\n    case .month:\n        let (y, mo, _) = _ts_date(ts)\n        r = (mo >= 12 ? _date_ts(y + 1, 1, 1) : _date_ts(y, mo + 1, 1)) - 1.0\n    case .quarter:\n        let (y, mo, _) = _ts_date(ts)\n        let next = (mo - 1) / 3 * 3 + 4\n        r = (next > 12 ? _date_ts(y + 1, next - 12, 1) : _date_ts(y, next, 1)) - 1.0\n    case .year: r = _date_ts(_ts_date(ts).0 + 1, 1, 1) - 1.0\n    }\n    return _render(r, m.dateOnly)\n}\nfileprivate func _time_parse(_ s: String) -> String? { _parse_iso(s).map { _render($0.ms, $0.dateOnly) } }\nfileprivate func _time_valid(_ s: String) -> Bool { _parse_iso(s) != nil }\nfileprivate func _time_part(_ d: Any, _ part: String) -> Double {\n    let m = _mo(d)\n    if part == \"hour\" || part == \"minute\" || part == \"second\" {\n        if m.dateOnly { _need_tod(\"time/\" + part) }\n    }\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    switch part {\n    case \"year\": return Double(y)\n    case \"month\": return Double(mo)\n    case \"day\": return Double(da)\n    case \"weekday\": return Double(_erem(Int((t / 86_400_000.0).rounded(.down)) + 4, 7))\n    case \"hour\": return Double(tod / 3_600_000)\n    case \"minute\": return Double((tod / 60_000) % 60)\n    default: return Double((tod / 1000) % 60)\n    }\n}\nfileprivate func _time_format(_ d: Any, _ format: String) -> String {\n    let m = _mo(d)\n    let t = _checked_year(m.ms).rounded(.down)\n    let (y, mo, da) = _ts_date(t)\n    let tod = _erem(Int(t), 86_400_000)\n    let (hh, mi, ss) = (to