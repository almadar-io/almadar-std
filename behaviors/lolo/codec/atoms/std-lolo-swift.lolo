app std-lolo-swift [
  version: "1.0.0",
  description: "std-lolo-swift — renders .lolo source as Swift, so a learner who reads an exercise written in .lolo can see the same program as Swift that compiles against the iOS shell's generated models and gives the kernel's answers. It is std-lolo-source with the Swift vocabulary in config and nothing else: LOLO_TO_SWIFT { source, path } answers SWIFT_RENDERED { text, warnings }, or SWIFT_RENDER_FAILED { error } when the source cannot be read or the request carries no path (Swift is typed, so the types come from the kernel checker). Each trait becomes a final class holding state, entity, ports and config, with one on<Event> method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records (event, payload) in emitted with the payload built as the shell's generated payload struct. The entity and payload structs are the ones Entities.swift and Events.swift of the iOS shell declare in the same module, so the output imports nothing but Foundation. entityNames mirrors the iOS shell's SWIFT_RESERVED_TYPES table (orbital-shell-ios backend.rs): an entity named like a Swift, Foundation or SwiftUI type is generated with the suffix Entity (Task is TaskEntity), and the constructor uses that name. payloadFieldOrder sorted builds a payload struct with its fields by name, the order the shell declares them in, which the memberwise initializer needs; mapEmpty writes the empty map as [:]. Every number is a Double, a string is measured and sliced by Unicode scalar like the kernel, and an answer that is null in the kernel (a division by zero, nth past the end, a missing key) is an Optional that default reads with ??. Kernel-semantics helpers are fileprivate functions written once, and only the ones the output uses. An operator with no Swift template is a named warning and a generic stub that stops when run. persist, fetch, notify, navigate and call-service are called on the ports dictionary of closures and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-swift"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloSwiftOrbital {
  entity LoloSwiftRun [runtime] {
    id : string!
  }

  trait LoloSwift = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_SWIFT
      SOURCE_RENDERED: SWIFT_RENDERED
      SOURCE_RENDER_FAILED: SWIFT_RENDER_FAILED
    }
    config {
      language: "Swift"
      requiresTypes: true
      operators: {
          "/": "_div({{0}}, {{1}})",
          "%": "_mod({{0}}, {{1}})",
          "math/mod": "_mod({{0}}, {{1}})",
          "str/len": "Double({{0}}.unicodeScalars.count)",
          "str/upper": "{{0}}.uppercased()",
          "str/lower": "{{0}}.lowercased()",
          "str/trim": "{{0}}.trimmingCharacters(in: .whitespacesAndNewlines)",
          "str/trimStart": "_trim_start({{0}})",
          "str/trimEnd": "_trim_end({{0}})",
          "str/capitalize": "_capitalize({{0}})",
          "str/split": "_split({{0}}, {{1}})",
          "str/join": "_join({{0}}, {{1}})",
          "str/concat": "_concat({{*}})",
          "str/includes": "_str_includes({{0}}, {{1}})",
          "str/startsWith": "{{0}}.unicodeScalars.starts(with: {{1}}.unicodeScalars)",
          "str/endsWith": "{{0}}.unicodeScalars.reversed().starts(with: {{1}}.unicodeScalars.reversed())",
          "str/replace": "_replace({{0}}, {{1}}, {{2}}, false)",
          "str/replaceAll": "_replace({{0}}, {{1}}, {{2}}, true)",
          "str/repeat": "_repeat({{0}}, {{1}})",
          "str/reverse": "_reverse_str({{0}})",
          "str/slice#2": "_str_slice({{0}}, {{1}})",
          "str/slice#3": "_str_slice({{0}}, {{1}}, {{2}})",
          "str/padStart#2": "_pad_start({{0}}, {{1}})",
          "str/padStart#3": "_pad_start({{0}}, {{1}}, {{2}})",
          "str/padEnd#2": "_pad_end({{0}}, {{1}})",
          "str/padEnd#3": "_pad_end({{0}}, {{1}}, {{2}})",
          "str/truncate#2": "_truncate({{0}}, {{1}})",
          "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})",
          "str/to-int": "_to_int({{0}})",
          "array/len": "Double({{0}}.count)",
          "array/first": "{{0}}.first",
          "array/last": "{{0}}.last",
          "array/nth": "_nth({{0}}, {{1}})",
          "array/range#2": "_range({{0}}, {{1}})",
          "array/range#3": "_range({{0}}, {{1}}, {{2}})",
          "array/slice#2": "_slice({{0}}, {{1}})",
          "array/slice#3": "_slice({{0}}, {{1}}, {{2}})",
          "array/take": "_take({{0}}, {{1}})",
          "array/drop": "_drop({{0}}, {{1}})",
          "array/takeLast": "_take_last({{0}}, {{1}})",
          "array/dropLast": "_drop_last({{0}}, {{1}})",
          "array/append": "({{0}} + [{{1}}])",
          "array/prepend": "([{{1}}] + {{0}})",
          "array/includes": "_includes({{0}}, {{1}})",
          "array/indexOf": "_index_of({{0}}, {{1}})",
          "array/reverse": "Array({{0}}.reversed())",
          "array/unique": "_unique({{0}})",
          "array/flatten": "{{0}}.flatMap { $0 }",
          "array/zip": "zip({{0}}, {{1}}).map { [$0.0, $0.1] }",
          "array/reduce": "{{0}}.reduce({{1}}, {{2}})",
          "list": "[{{*}}]",
          "object/set": "_set({{0}}, {{1}}, {{2}})",
          "math/abs": "abs({{0}})",
          "math/max": "max({{*}})",
          "math/min": "min({{*}})",
          "math/round#2": "_round({{0}}, {{1}})",
          "math/sqrt": "_sqrt({{0}})",
          "math/ln": "_ln({{0}})",
          "math/log10": "_log10({{0}})",
          "math/pow": "_pow({{0}}, {{1}})",
          "math/sign": "_sign({{0}})",
          "math/clamp": "min(max({{0}}, {{1}}), {{2}})",
          "default": "({{0}} ?? {{1}})",
          "validate/required": "_required({{0}})",
          "validate/length": "(_size({{0}}) == {{1}})",
          "validate/minLength": "(_size({{0}}) >= {{1}})",
          "validate/maxLength": "(_size({{0}}) <= {{1}})",
          "validate/min": "({{0}} >= {{1}})",
          "validate/max": "({{0}} <= {{1}})",
          "validate/range": "({{0}} >= {{1}} && {{0}} <= {{2}})",
          "validate/oneOf": "_includes({{1}}, {{0}})",
          "validate/equals": "_eq({{0}}, {{1}})",
          "=#2": "_eq({{0}}, {{1}})",
          "==#2": "_eq({{0}}, {{1}})",
