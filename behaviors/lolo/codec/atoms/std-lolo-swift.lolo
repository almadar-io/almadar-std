          "str/trimStart": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _trim_start(_ s: String) -> String { _str(s.unicodeScalars.drop(while: { CharacterSet.whitespacesAndNewlines.contains($0) })) }"],
          "str/trimEnd": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _trim_end(_ s: String) -> String { _str(s.unicodeScalars.reversed().drop(while: { CharacterSet.whitespacesAndNewlines.contains($0) }).reversed()) }"],
          "str/capitalize": ["fileprivate func _capitalize(_ s: String) -> String {\n    guard let f = s.unicodeScalars.first else { return s }\n    return String(f).uppercased() + String(s.unicodeScalars.dropFirst()).lowercased()\n}"],
          "str/split": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _find(_ s: [Unicode.Scalar], _ d: [Unicode.Scalar], _ from: Int) -> Int? {\n    var i = from\n    while i + d.count <= s.count {\n        if s[i..<i + d.count].elementsEqual(d) { return i }\n        i += 1\n    }\n    return nil\n}", "fileprivate func _split(_ s: String, _ d: String) -> [String] {\n    let sc = Array(s.unicodeScalars), dc = Array(d.unicodeScalars)\n    if dc.isEmpty { return sc.map { String($0) } }\n    var out: [String] = []\n    var at = 0\n    while let i = _find(sc, dc, at) {\n        out.append(_str(sc[at..<i]))\n        at = i + dc.count\n    }\n    out.append(_str(sc[at...]))\n    return out\n}"],
          "str/concat": ["fileprivate func _num_text(_ x: Double) -> String {\n    if x.isNaN { return \"NaN\" }\n    if x.isInfinite { return x < 0 ? \"-Infinity\" : \"Infinity\" }\n    if x == 0 { return \"0\" }\n    var d = abs(x).description\n    var e = 0\n    if let i = d.firstIndex(where: { $0 == \"e\" || $0 == \"E\" }) {\n        e = Int(d[d.index(after: i)...]) ?? 0\n        d = String(d[..<i])\n    }\n    var digits = d\n    var point = d.count\n    if let i = d.firstIndex(of: \".\") {\n        point = d.distance(from: d.startIndex, to: i)\n        digits = d.replacingOccurrences(of: \".\", with: \"\")\n    }\n    var n = point + e\n    while digits.hasPrefix(\"0\") && digits.count > 1 { digits.removeFirst(); n -= 1 }\n    while digits.hasSuffix(\"0\") && digits.count > 1 { digits.removeLast() }\n    let k = digits.count\n    var out: String\n    if k <= n && n <= 21 {\n        out = digits + String(repeating: \"0\", count: n - k)\n    } else if 0 < n && n <= 21 {\n        out = String(digits.prefix(n)) + \".\" + String(digits.dropFirst(n))\n    } else if -6 < n && n <= 0 {\n        out = \"0.\" + String(repeating: \"0\", count: -n) + digits\n    } else {\n        let m = n - 1\n        let sign = m < 0 ? \"-\" : \"+\"\n        out = String(digits.prefix(1)) + (k > 1 ? \".\" + String(digits.dropFirst()) : \"\") + \"e\" + sign + String(abs(m))\n    }\n    return x < 0 ? \"-\" + out : out\n}\nfileprivate protocol _Textual { var _text: String { get } }\nextension String: _Textual { fileprivate var _text: String { self } }\nextension Bool: _Textual { fileprivate var _text: String { self ? \"true\" : \"false\" } }\nextension Double: _Textual { fileprivate var _text: String { _num_text(self) } }\nextension Int: _Textual { fileprivate var _text: String { String(self) } }", "fileprivate func _concat(_ parts: any _Textual...) -> String { parts.map { $0._text }.joined() }"],
          "str/includes": ["fileprivate func _find(_ s: [Unicode.Scalar], _ d: [Unicode.Scalar], _ from: Int) -> Int? {\n    var i = from\n    while i + d.count <= s.count {\n        if s[i..<i + d.count].elementsEqual(d) { return i }\n        i += 1\n    }\n    return nil\n}", "fileprivate func _str_includes(_ s: String, _ d: String) -> Bool { _find(Array(s.unicodeScalars), Array(d.unicodeScalars), 0) != nil }"],
