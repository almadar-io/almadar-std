ppend(\"\\(minutes)m\") }\n    if seconds > 0 || parts.isEmpty { parts.append(\"\\(seconds)s\") }\n    return parts.joined(separator: \" \")\n}\nfileprivate func _now_ms() -> Double { (Date().timeIntervalSince1970 * 1000).rounded(.down) }\nfileprivate func _time_now() -> String { _render(_now_ms(), false) }\nfileprivate func _time_today() -> String { _render((_now_ms() / 86_400_000.0).rounded(.down) * 86_400_000.0, false) }\nfileprivate func _time_past(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isPast\") }; return m.ms < _now_ms() }\nfileprivate func _time_future(_ d: Any) -> Bool { let m = _mo(d); if m.dateOnly { _need_tod(\"time/isFuture\") }; return m.ms > _now_ms() }\nfileprivate func _time_today_is(_ d: Any) -> Bool { (_mo(d).ms / 86_400_000.0).rounded(.down) == (_now_ms() / 86_400_000.0).rounded(.down) }\nfileprivate func _time_relative(_ d: Any) -> String {\n    let m = _mo(d)\n    if m.dateOnly { _need_tod(\"time/relative\") }\n    let diff = _now_ms() - m.ms\n    func phrase(_ n: Int, _ unit: String) -> String {\n        let plural = n == 1 ? \"\" : \"s\"\n        return diff < 0 ? \"in \\(n) \\(unit)\\(plural)\" : \"\\(n) \\(unit)\\(plural) ago\"\n    }\n    let ms = abs(diff)\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0)\n    if ms < minute { return \"just now\" }\n    if ms < hour { return phrase(Int((ms / minute).rounded()), \"minute\") }\n    if ms < day { return phrase(Int((ms / hour).rounded()), \"hour\") }\n    if ms < 7.0 * day { return phrase(Int((ms / day).rounded()), \"day\") }\n    if ms < 30.0 * day { return phrase(Int((ms / (7.0 * day)).rounded()), \"week\") }\n    if ms < 365.0 * day { return phrase(Int((ms / (30.0 * day)).rounded()), \"month\") }\n    return phrase(Int((ms / (365.0 * day)).rounded()), \"year\")\n}"],
          "time/now": ["fileprivate struct _Moment { var ms: Double; var dateOnly: Bool }\nfileprivate func _ediv(_ a: Int, _ b: Int) -> Int { let q = a / b; return (a % b != 0 && (a < 0) != (b < 0)) ? q - 1 : q }\nfileprivate func _erem(_ a: Int, _ b: Int) -> Int { a - _ediv(a, b) * b }\nfileprivate func _leap(_ y: Int) -> Bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }\nfileprivate func _dim(_ y: Int, _ m: Int) -> Int {\n    switch m {\n    case 1, 3, 5, 7, 8, 10, 12: return 31\n    case 4, 6, 9, 11: return 30\n    case 2: return _leap(y) ? 29 : 28\n    default: return 30\n    }\n}\nfileprivate func _ts_date(_ ts: Double) -> (Int, Int, Int) {\n    let days = Int((ts / 86_400_000.0).rounded(.down))\n    let shifted = days + 719_468\n    let era = _ediv(shifted, 146_097)\n    let doe = _erem(shifted, 146_097)\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    let mp = (5 * doy + 2) / 153\n    let day = doy - (153 * mp + 2) / 5 + 1\n    let month = mp < 10 ? mp + 3 : mp - 9\n    return (yoe + era * 400 + (month <= 2 ? 1 : 0), month, day)\n}\nfileprivate func _date_ts(_ year: Int, _ month: Int, _ day: Int) -> Double {\n    let y = year - (month <= 2 ? 1 : 0)\n    let era = _ediv(y, 400)\n    let yoe = _erem(y, 400)\n    let mp = (month + 9) % 12\n    let doy = (153 * mp + 2) / 5 + day - 1\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n    return Double(era * 146_097 + doe - 719_468) * 86_400_000.0\n}\nfileprivate func _parse_iso(_ text: String) -> _Moment? {\n    let b = Array(text.utf8)\n    func num(_ from: Int, _ len: Int) -> Int? {\n        guard from + len <= b.count else { return nil }\n        var v = 0\n        for c in b[from..<from + len] {\n            guard c >= 48 && c <= 57 else { return nil }\n            v = v * 10 + Int(c - 48)\n        }\n        return v\n    }\n    guard b.count > 7, b[4] == 45, b[7] == 45, let y = num(0, 4), let mo = num(5, 2), let d = num(8, 2), mo >= 1, mo <= 12, d >= 1, d <= _dim(y, mo) else { return nil }\n    var ms = _date_ts(y, mo, d)\n    if b.count == 10 { return _Moment(ms: ms, dateOnly: true) }\n    guard b.count > 13, b[10] == 84, b[13] == 58, let hour = num(11, 2), let minute = num(14, 2), hour <= 23, minute <= 59 else { return nil }\n    ms += Double(hour * 3_600_000 + minute * 60_000)\n    var at = 16\n    if at < b.count, b[at] == 58 {\n        guard let second = num(at + 1, 2), second <= 59 else { return nil }\n        ms += Double(second * 1000)\n        at += 3\n        if at < b.count, b[at] == 46 {\n            let start = at + 1\n            var end = start\n            while end < b.count, b[end] >= 48, b[end] <= 57 { end += 1 }\n            if end == start { return nil }\n            var digits = Array(b[start..<end]).prefix(3).map { Int($0 - 48) }\n            while digits.count < 3 { digits.append(0) }\n            ms += Double(digits[0] * 100 + digits[1] * 10 + digits[2])\n            at = end\n        }\n    }\n    let rest = Array(b[min(at, b.count)...])\n    if rest == [90] { return _Moment(ms: ms, dateOnly: false) }\n    guard rest.count == 6, rest[0] == 43 || rest[0] == 45, rest[3] == 58 else { return nil }\n    guard let oh = num(at + 1, 2), let om = num(at + 4, 2), oh <= 23, om <= 59 else { return nil }\n    let offset = Double((oh * 60 + om) * 60_000)\n    return _Moment(ms: rest[0] == 45 ? ms + offset : ms - offset, dateOnly: false)\n}\nfileprivate func _mo(_ v: Any) -> _Moment {\n    guard let s = v as? String, let m = _parse_iso(s) else { fatalError(\"expected a date or datetime (ISO-8601 text)\") }\n    return m\n}\nfileprivate func _need_tod(_ op: String) -> Never { fatalError(op + \" needs a time of day and a date carries none: pass a datetime\") }\nfileprivate func _checked_year(_ ms: Double) -> Double {\n    guard ms.isFinite else { fatalError(\"a time is outside the years 0000 to 9999\") }\n    let y = _ts_date(ms).0\n    guard y >= 0 && y <= 9999 else { fa