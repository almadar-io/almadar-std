          "str/camelCase": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _isnum(_ c: Unicode.Scalar) -> Bool {\n    switch c.properties.generalCategory {\n    case .decimalNumber, .letterNumber, .otherNumber: return true\n    default: return false\n    }\n}\nfileprivate func _isalnum(_ c: Unicode.Scalar) -> Bool { c.properties.isAlphabetic || _isnum(c) }", "fileprivate func _cap(_ w: [Unicode.Scalar]) -> String {\n    guard let f = w.first else { return \"\" }\n    return f.properties.uppercaseMapping + _str(w.dropFirst()).lowercased()\n}", "fileprivate func _camel_case(_ s: String) -> String {\n    var words: [[Unicode.Scalar]] = []\n    var cur: [Unicode.Scalar] = []\n    for c in s.unicodeScalars {\n        if _isalnum(c) { cur.append(c) } else if !cur.isEmpty { words.append(cur); cur = [] }\n    }\n    if !cur.isEmpty { words.append(cur) }\n    return words.enumerated().map { $0.offset == 0 ? _str($0.element).lowercased() : _cap($0.element) }.joined()\n}"],
          "str/titleCase": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _cap(_ w: [Unicode.Scalar]) -> String {\n    guard let f = w.first else { return \"\" }\n    return f.properties.uppercaseMapping + _str(w.dropFirst()).lowercased()\n}", "fileprivate func _title_case(_ s: String) -> String {\n    var words: [[Unicode.Scalar]] = []\n    var cur: [Unicode.Scalar] = []\n    for c in s.unicodeScalars {\n        if c.properties.isWhitespace { if !cur.isEmpty { words.append(cur); cur = [] } } else { cur.append(c) }\n    }\n    if !cur.isEmpty { words.append(cur) }\n    return words.map { _cap($0) }.joined(separator: \" \")\n}"],
          "str/kebabCase": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _isnum(_ c: Unicode.Scalar) -> Bool {\n    switch c.properties.generalCategory {\n    case .decimalNumber, .letterNumber, .otherNumber: return true\n    default: return false\n    }\n}\nfileprivate func _isalnum(_ c: Unicode.Scalar) -> Bool { c.properties.isAlphabetic || _isnum(c) }", "fileprivate func _case_words(_ s: String) -> [String] {\n    let cs = Array(s.unicodeScalars)\n    var words: [String] = []\n    var cur: [Unicode.Scalar] = []\n    func flush() {\n        if !cur.isEmpty { words.append(_str(cur).lowercased()); cur = [] }\n    }\n    for (i, c) in cs.enumerated() {\n        if !_isalnum(c) { flush(); continue }\n        if c.properties.isUppercase && i > 0 {\n            let p = cs[i - 1]\n            let nextLower = i + 1 < cs.count && cs[i + 1].properties.isLowercase\n            if p.properties.isLowercase || _isnum(p) || (p.properties.isUppercase && nextLower) { flush() }\n        }\n        cur.append(c)\n    }\n    flush()\n    return words\n}"],
