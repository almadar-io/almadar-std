          "bit/shl": ["fileprivate func _word(_ x: Double, _ hi: Double = 4294967295) -> UInt32? { x == x.rounded() && x >= 0 && x <= hi ? UInt32(x) : nil }", "fileprivate func _bit_shift(_ a: Double, _ n: Double, _ f: (UInt32, UInt32) -> UInt32) -> Double? {\n    guard let w = _word(a), let k = _word(n, 31) else { return nil }\n    return Double(f(w, k))\n}"],
