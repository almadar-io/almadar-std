          "object/pick": "_pick({{0}}, {{1}})",
          "object/omit": "_omit({{0}}, {{1}})",
          "object/get#2": "_get({{0}}, {{1}})",
          "object/get#3": "(_get({{0}}, {{1}}) ?? {{2}})",
          "object/has": "_has({{0}}, {{1}})",
          "path/astar#5": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, false)",
          "path/astar#6": "_astar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})",
          "path/reachable#5": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, false)",
          "path/reachable#6": "_reachable({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})",
          "json/valid": "_json_valid({{0}})",
          "json/parse": "_json_parse({{0}})",
          "json/stringify#1": "_json_stringify({{0}}, [:])",
          "json/stringify#2": "_json_stringify({{0}}, {{1}})",
          "json/nodes": "_json_nodes({{0}})"
        }
      unary: {
          "-": "(-{{0}})",
          "not": "(!{{0}})",
          "array/range": "_range({{0}})",
          "array/sum": "{{0}}.reduce(0, +)",
          "array/count": "Double({{0}}.count)",
          "array/sort": "{{0}}.sorted()",
          "math/round": "_round({{0}})",
          "array/concat": "{{0}}",
          "object/merge": "{{0}}",
          "array/avg": "_avg({{0}})",
          "array/max": "{{0}}.max()",
          "array/min": "{{0}}.min()",
          "vec/length": "_vlen({{0}})",
          "vec/length-sq": "_vlensq({{0}})",
          "vec/normalize": "_vnorm({{0}})",
          "object/clone": "_obj_clone({{0}})",
          "object/deepClone": "_obj_clone({{0}})"
        }
      infix: {"+": "+", "-": "-", "*": "*", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||", "array/concat": "+"}
      infixForm: "({{*}})"
      lambdaOperators: {
          "array/map": "{{src}}.map { {{vars}} in {{body}} }",
          "array/filter": "{{src}}.filter { {{vars}} in {{body}} }",
          "array/reject": "{{src}}.filter { {{vars}} in !({{body}}) }",
          "array/some": "{{src}}.contains { {{vars}} in {{body}} }",
          "array/every": "{{src}}.allSatisfy { {{vars}} in {{body}} }",
          "array/count": "Double({{src}}.filter { {{vars}} in {{body}} }.count)",
          "array/find": "{{src}}.first { {{vars}} in {{body}} }",
          "array/findIndex": "({{src}}.firstIndex { {{vars}} in {{body}} }.map { Double($0) } ?? -1)",
          "array/partition": "_partition({{src}}) { {{vars}} in {{body}} }",
          "array/pmap": "{{src}}.map { {{vars}} in {{body}} }",
          "object/filter": "_obj_filter({{src}}) { {{vars}} in {{body}} }",
          "object/mapValues": "_map_values({{src}}) { {{vars}} in {{body}} }",
          "object/mapKeys": "_map_keys({{src}}) { {{vars}} in {{body}} }",
          "array/groupBy": "_group_by({{src}}) { {{vars}} in {{body}} }"
        }
      lambdaForm: "{ {{params}} in {{body}} }"
      indexedSource: "{{src}}.enumerated().map { (Double($0.offset), $0.element) }"
      indexedVars: "{{index}}, {{item}}"
      callees: {"math/ceil": "ceil", "math/floor": "floor", "math/sin": "sin", "math/cos": "cos", "math/tan": "tan", "math/atan": "atan", "math/atan2": "atan2", "math/hypot": "hypot"}
      calleeForm: "{{callee}}({{*}})"
      unsupportedForm: "_unsupported({{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: {
        "user": ["final class Viewer {\n    var id = \"anonymous\"\n    var email: String? = nil\n    var name: String? = nil\n    var role: String? = \"anonymous\"\n\n    func signIn(_ row: [String: String]?) {\n        guard let row else {\n            id = \"anonymous\"; email = nil; name = nil; role = \"anonymous\"\n            return\n        }\n        id = row[\"id\"] ?? \"\"\n        email = row[\"email\"]\n        name = row[\"name\"]\n        role = row[\"role\"]\n    }\n}"],
        "store": ["fileprivate protocol _Eq { func _same(_ o: Self) -> Bool }\nextension String: _Eq { fileprivate func _same(_ o: String) -> Bool { unicodeScalars.elementsEqual(o.unicodeScalars) } }\nextension Double: _Eq { fileprivate func _same(_ o: Double) -> Bool { self == o } }\nextension Bool: _Eq { fileprivate func _same(_ o: Bool) -> Bool { self == o } }\nextension Array: _Eq where Element: _Eq { fileprivate func _same(_ o: [Element]) -> Bool { count == o.count && zip(self, o).allSatisfy { $0._same($1) } } }\nextension Optional: _Eq where Wrapped: _Eq {\n    fileprivate func _same(_ o: Wrapped?) -> Bool {\n        switch (self, o) {\n        case (nil, nil): return true\n        case let (a?, b?): return a._same(b)\n        default: return false\n        }\n    }\n}\nextension Dictionary: _Eq where Value: _Eq { fileprivate func _same(_ o: [Key: Value]) -> Bool { count == o.count && allSatisfy { kv in o[kv.key].map { kv.value._same($0) } ?? false } } }\nfileprivate func _eq<T: _Eq>(_ a: T, _ b: T) -> Bool { a._same(b) }", "enum _JV: Codable, Equatable, ExpressibleByStringLiteral, ExpressibleByFloatLiteral, ExpressibleByIntegerLiteral, ExpressibleByBooleanLiteral {\n    case null, bool(Bool), number(Double), string(String), array([_JV]), object([String: _JV])\n\n    init(stringLiteral v: String) { self = .string(v) }\n    init(floatLiteral v: Double) { self = .number(v) }\n    init(integerLiteral v: Int) { self = .number(Double(v)) }\n    init(booleanLiteral v: Bool) { self = .bool(v) }\n\n    init(from decoder: Decoder) throws {\n        let c = try decoder.singleValueContainer()\n        if c.decodeNil() { self = .null }\n        else if let b = try? c.decode(Bool.self) { self = .bool(b) }\n        else if let n = try? c.decode(Double.self) { self = .number(n) }\n        else if let v = try? c.decode(String.self) { self = .string(v) }\n        else if let a = try? c.decode([_JV].self) { self = .array(a) }\n        else { self = .object(try c.decode([String: _JV].self)) }\n    }\n\n    func encode(to encoder: Encoder) throws {\n        var c = encoder.singleValueContainer()\n        switch self {\n        case .null: try c.encodeNil()\n        case .bool(let b): try c.encode(b)\n        case .number(let n): try c.encode(n)\n        case .string(let v): try c.encode(v)\n        case .array(let a): try c.encode(a)\n        case .object(let o): try c.encode(o)\n        }\n    }\n}\n\nextension _JV: _Eq { fileprivate func _same(_ o: _JV) -> Bool { self == o } }\n\nfileprivate protocol _JVValue { var _jv: _JV { get } }\nextension String: _JVValue { fileprivate var _jv: _JV { .string(self) } }\nextension Double: _JVValue { fileprivate var _jv: _JV { .number(self) } }\nextension Bool: _JVValue { fileprivate var _jv: _JV { .bool(self) } }\nfileprivate func _eq<T: _JVValue>(_ a: _JV?, _ b: T?) -> Bool { (a ?? .null) == (b?._jv ?? .null) }\nfileprivate func _eq<T: _JVValue>(_ a: T?, _ b: _JV?) -> Bool { (a?._jv ?? .null) == (b ?? .null) }\nfileprivate func _get<T>(_ o: [String: T], _ p: String?) -> T? { p.flatMap { o[$0] } }\nfileprivate func _get<T>(_ o: [String: T], _ p: _JV?) -> T? { if case .string(let k)? = p { return o[k] }; return nil }\nfileprivate func _get<R: Encodable>(_ r: R, _ p: String) -> _JV? { if case .object(let o) = _decode(_JV.self, _encode(r)) { return o[p] }; return nil }\nfileprivate func _get<R: Encodable>(_ r: R, _ p: String?) -> _JV? { p.flatMap { _get(r, $0) } }\nfileprivate func _get<R: Encodable>(_ r: R, _ p: _JV?) -> _JV? { if case .string(let k)? = p { return _get(r, k) }; return nil }\nfileprivate func _merge<R: Codable, V: Encodable>(_ r: R, _ b: [String: V]) -> R {\n    guard case .object(var o) = _decode(_JV.self, _encode(r)), case .object(let extra) = _decode(_JV.self, _encode(b)) else { fatalError(\"object/merge: the value is not a record\") }\n    for (k, v) in extra { o[k] = v }\n    return _decode(R.self, _encode(_JV.object(o)))\n}\nfileprivate func _str_includes(_ s: _JV, _ d: String) -> Bool {\n    guard case .string(let v) = s else { return false }\n    let sc = Array(v.unicodeScalars), dc = Array(d.unicodeScalars)\n    var i = 0\n    while i + dc.count <= sc.count {\n        if sc[i..<i + dc.count].elementsEqual(dc) { return true }\n        i += 1\n    }\n    return false\n}\n\nstruct Answer {\n    let ok: Bool\n    let payload: [String: _JV]\n}\n\nprotocol Store: AnyObject {\n    func persist(_ op: String, _ entity: String, _ data: any Encodable) -> Answer\n    func fetch(_ entity: String, _ keep: (([String: _JV]) -> Bool)?, _ offset: Double?, _ limit: Double?) -> Answer\n}\n\nfileprivate func _before(_ a: [String: _JV], _ b: [String: _JV]) -> Bool {\n    let sa = a[\"createdAt\"].flatMap { $0 == .null ? nil : $0 }\n    let sb = b[\"createdAt\"].flatMap { $0 == .null ? nil : $0 }\n    switch (sa, sb) {\n    case (.some, nil): return true\n    case (nil, .some): return false\n    case let (.number(x)?, .number(y)?) where x != y: return x < y\n    case let (.string(x)?, .string(y)?) where x != y: return x.unicodeScalars.lexicographicallyPrecedes(y.unicodeScalars)\n    default: break\n    }\n    guard case .string(let ia)? = a[\"id\"], case .string(let ib)? = b[\"id\"] else { return false }\n    return ia.unicodeScalars.lexicographicallyPrecedes(ib.unicodeScalars)\n}\n\nfinal class MemoryStore: Store {\n    private var tables: [String: [(String, [String: _JV])]] = [:]\n    private var minted = 0\n\n    func persist(_ op: String, _ entity: String, _ data: any Encodable) -> Answer {\n        var rows = tables[entity] ?? []\n        defer { tables[entity] = rows }\n        let value = _decode(_JV.self, _encode(data))\n        if op == \"create\", case .object(var row) = value {\n            let id: String\n            if case .string(let given)? = row[\"id\"], !given.isEmpty {\n                id = given\n            } else {\n                minted += 1\n                id = entity + \"-\" + String(minted)\n            }\n            row[\"id\"] = .string(id)\n            rows.append((id, row))\n            return Answer(ok: true, payload: row)\n        }\n        var key = \"\"\n        if case .string(let v) = value { key = v }\n        if case .object(let o) = value, case .string(let v)? = o[\"id\"] { key = v }\n        guard let pos = rows.firstIndex(where: { $0.0 == key }) else {\n            return Answer(ok: false, payload: [\"error\": .string(entity + \" \" + key + \" not found\"), \"code\": \"not-found\"])\n        }\n        if op == \"delete\" {\n            rows.remove(at: pos)\n            return Answer(ok: true, payload: [\"id\": .string(key), \"deleted\": true])\n        }\n        if case .object(let o) = value {\n            for (k, v) in o { rows[pos].1[k] = v }\n        }\n        return Answer(ok: true, payload: rows[pos].1)\n    }\n\n    func fetch(_ entity: String, _ keep: (([String: _JV]) -> Bool)?, _ offset: Double?, _ limit: Double?) -> Answer {\n        var rows = (tables[entity] ?? []).map { $0.1 }.filter { keep?($0) ?? true }\n        rows.sort(by: _before)\n        let start = min(max(Int(offset ?? 0), 0), rows.count)\n        let end = limit.map { min(start + max(Int($0), 0), rows.count) } ?? rows.count\n        return Answer(ok: true, payload: [\"data\": .array(rows[start..<end].map { .object($0) }), \"totalCount\": .number(Double(rows.count))])\n    }\n}"],
        "router": ["typealias _Guard = (Data) -> Bool\ntypealias _Map = (Data) -> Data\n\nstruct _Entry {\n    let key: String\n    let trait: AnyObject\n    let state: () -> String\n    let entity: () -> Data\n    let count: () -> Int\n    let from: (Int) -> [(String, Data, Bool)]\n}\n\nstruct _Item {\n    let target: String\n    let event: String\n    let payload: Data\n    let source: Data\n    let guard_: _Guard?\n    let fans: Bool\n    let completion: Bool\n}\n\nfunc _encode(_ value: any Encodable) -> Data {\n    let encoder = JSONEncoder()\n    encoder.outputFormatting = [.sortedKeys]\n    return (try? encoder.encode(value)) ?? Data(\"{}\".utf8)\n}\n\nfunc _decode<T: Decodable>(_ type: T.Type, _ data: Data) -> T {\n    do {\n        return try JSONDecoder().decode(type, from: data)\n    } catch {\n        fatalError(\"a payload of the declared shape: \\(error)\")\n    }\n}\n\nclass _Router {\n    var entries: [_Entry] = []\n    var handles: [String: [String: [String]]] = [:]\n    var rows: [(source: String, event: String, target: String, trigger: String, guard_: _Guard?, mapping: _Map?)] = []\n    var log: [(trait: String, event: String, payload: Data)] = []\n\n    func add(_ key: String, _ trait: AnyObject, state: @escaping () -> String, entity: @escaping () -> Data, count: @escaping () -> Int, from: @escaping (Int) -> [(String, Data, Bool)]) {\n        entries.append(_Entry(key: key, trait: trait, state: state, entity: entity, count: count, from: from))\n    }\n\n    func row(_ source: String, _ event: String, _ target: String, _ trigger: String, _ guard_: _Guard?, _ mapping: _Map?) {\n        rows.append((source: source, event: event, target: target, trigger: trigger, guard_: guard_, mapping: mapping))\n    }\n\n    func entry(_ key: String) -> _Entry? {\n        entries.first { $0.key == key }\n    }\n\n    func trait(_ key: String) -> AnyObject? {\n        entry(key)?.trait\n    }\n\n    func deliver(_ target: String, _ event: String, _ payload: Data) {}\n\n    func targets(_ source: String, _ event: String, _ payload: Data, _ completion: Bool) -> [_Item] {\n        rows.filter { $0.source == source && $0.event == event }.map {\n            _Item(target: $0.target, event: $0.trigger, payload: $0.mapping.map { m in m(payload) } ?? payload, source: payload, guard_: $0.guard_, fans: false, completion: completion)\n        }\n    }\n\n    func dispatch(_ trait: String, _ event: String, _ payload: Data) {\n        var queue = [_Item(target: trait, event: event, payload: payload, source: payload, guard_: nil, fans: true, completion: false)]\n        var seen = Set<String>()\n        var steps = 0\n        while !queue.isEmpty {\n            let item = queue.removeFirst()\n            guard let e = entry(item.target) else { continue }\n            let key = [item.target, item.event, e.state(), String(decoding: item.payload, as: UTF8.self), String(decoding: e.entity(), as: UTF8.self)].joined(separator: \"\\u{1f}\")\n            if !item.completion && seen.contains(key) { continue }\n            if let g = item.guard_, !g(item.source) { continue }\n            if steps >= 2000 { break }\n            steps += 1\n            seen.insert(key)\n            let n = e.count()\n            deliver(item.target, item.event, item.payload)\n            var fanned = item.fans ? targets(item.target, item.event, item.payload, false) : []\n            var own: [_Item] = []\n            let newState = e.state()\n            for (ev, out, completion) in e.from(n) {\n                log.append((trait: item.target, event: ev, payload: out))\n                if handles[item.target]?[newState]?.contains(ev) ?? false {\n                    own.append(_Item(target: item.target, event: ev, payload: out, source: out, guard_: nil, fans: false, completion: completion))\n                }\n                fanned += targets(item.target, ev, out, completion)\n            }\n            queue.insert(contentsOf: own, at: 0)\n            queue += fanned\n        }\n    }\n}"],
          "/": ["fileprivate func _div(_ a: Double, _ b: Double) -> Double? { b == 0 ? nil : a / b }"],
