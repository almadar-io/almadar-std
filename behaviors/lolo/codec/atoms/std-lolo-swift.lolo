          "str/encode-uri-component": ["fileprivate func _uri_encode(_ s: String) -> String {\n    var out = \"\"\n    for b in s.utf8 {\n        if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || \"-_.!~*'()\".utf8.contains(b) {\n            out.unicodeScalars.append(Unicode.Scalar(b))\n        } else {\n            out += String(format: \"%%%02X\", b)\n        }\n    }\n    return out\n}"],
          "str/decode-uri-component": ["fileprivate func _uri_decode(_ s: String) -> String? {\n    let bytes = Array(s.utf8)\n    var out: [UInt8] = []\n    func hex(_ b: UInt8) -> UInt8? {\n        switch b {\n        case 48...57: return b - 48\n        case 97...102: return b - 87\n        case 65...70: return b - 55\n        default: return nil\n        }\n    }\n    var i = 0\n    while i < bytes.count {\n        if bytes[i] == 37 {\n            guard i + 2 < bytes.count, let hi = hex(bytes[i + 1]), let lo = hex(bytes[i + 2]) else { return nil }\n            out.append(hi * 16 + lo)\n            i += 3\n        } else {\n            out.append(bytes[i])\n            i += 1\n        }\n    }\n    return String(bytes: out, encoding: .utf8)\n}"],
