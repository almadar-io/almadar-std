          "time/minute": "_time_part({{0}}, \"minute\")",
          "time/second": "_time_part({{0}}, \"second\")",
          "time/format": "_time_format({{0}}, {{1}})",
          "time/duration": "_time_duration({{0}})",
          "time/now": "_time_now()",
          "time/today": "_time_today()",
          "time/isPast": "_time_past({{0}})",
          "time/isFuture": "_time_future({{0}})",
          "time/isToday": "_time_today_is({{0}})",
          "time/relative": "_time_relative({{0}})",
          "format/number#1": "_fmt_number({{0}}, [:])",
          "format/number#2": "_fmt_number({{0}}, {{1}})",
          "format/percent#1": "_fmt_percent({{0}}, 0)",
          "format/percent#2": "_fmt_percent({{0}}, {{1}})",
          "format/currency#2": "_fmt_currency({{0}}, {{1}}, \"en-US\")",
          "format/currency#3": "_fmt_currency({{0}}, {{1}}, {{2}})",
          "format/bytes": "_fmt_bytes({{0}})",
          "format/creditCard": "_fmt_card({{0}})",
          "format/list#1": "_fmt_list({{0}}, \"and\")",
          "format/list#2": "_fmt_list({{0}}, {{1}})",
          "format/ordinal": "_fmt_ordinal({{0}})",
          "format/plural": "_fmt_plural({{0}}, {{1}}, {{2}})",
          "format/phone#1": "_fmt_phone({{0}}, \"US\")",
          "format/phone#2": "_fmt_phone({{0}}, {{1}})",
          "validate/email": "_is_email({{0}})",
          "validate/url": "_is_url({{0}})",
          "validate/phone": "_is_phone({{0}})",
          "validate/uuid": "_is_uuid({{0}})",
          "validate/date": "_valid_date({{0}})",
          "validate/creditCard": "_valid_card({{0}})",
          "validate/noneOf": "(!_includes({{1}}, {{0}}))",
          "validate/string": "_is_string({{0}})",
          "validate/number": "_is_number({{0}})",
          "validate/boolean": "_is_boolean({{0}})",
          "validate/array": "_is_array({{0}})",
          "validate/object": "_is_object({{0}})",
          "validate/check": "_validate_check({{0}}, {{1}})",
          "base64/encode": "Data({{0}}.utf8).base64EncodedString()",
          "base64/decode": "_b64_text({{0}})",
          "base64/valid": "(_b64_text({{0}}) != nil)",
          "object/deepMerge#2": "_deep_merge({{0}}, {{1}})",
          "object/equals": "(_jv({{0}}) == _jv({{1}}))",
          "object/fromEntries": "_from_entries({{0}})",
          "array/sum#2": "_sum_by({{0}}, {{1}})",
