          "str/truncate": ["fileprivate func _str<S: Sequence>(_ a: S) -> String where S.Element == Unicode.Scalar {\n    var v = String.UnicodeScalarView()\n    v.append(contentsOf: a)\n    return String(v)\n}", "fileprivate func _whole(_ x: Double) -> Int {\n    guard x == x.rounded(), abs(x) < 9007199254740992 else { fatalError(\"expected a whole number\") }\n    return Int(x)\n}", "fileprivate func _count(_ x: Double) -> Int {\n    let k = _whole(x)\n    guard k >= 0 else { fatalError(\"expected a whole number from 0\") }\n    return k\n}", "fileprivate func _truncate(_ s: String, _ n: Double, _ suffix: String = \"...\") -> String {\n    let sc = Array(s.unicodeScalars)\n    return Double(sc.count) <= n ? s : _str(sc[0..<_count(n)]) + suffix\n}"],
