        (set @entity.op "minC")
        (set @entity.inputs (array/map @entity.prims (fn q @q.lo)))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_STAGED -> idle when (and (== @entity.reason "") (== @entity.op "minC"))
        (set @entity.cand (let ((n (array/len @entity.prims))) (let ((bests (array/filter (array/map (array/range 0 @entity.nSets) (fn s (let ((grp (array/filter (array/range 0 @n) (fn i (let ((q (array/nth @entity.prims @i))) (and (validate/required @q) (and (== @q.set @s) @q.lb))))))) (array/find @grp (fn i (array/every @grp (fn j (let ((cv (array/nth @entity.cmps (+ (* @i @n) @j)))) (and (validate/required @cv) (>= @cv 0)))))))))) (fn b (!= @b null))))) (let ((ch (array/find @bests (fn c (and (validate/required @c) (array/every @bests (fn d (and (validate/required @d) (let ((cv (array/nth @entity.cmps (+ (* @c @n) @d)))) (and (validate/required @cv) (<= @cv 0))))))))))) (if (== @ch null) "" (array/nth (array/map @entity.prims (fn q @q.lo)) @ch))))))
        (emit SEMVER_PICKED { requestId: @entity.requestId })

      SEMVER_PICKED -> idle when (== @entity.cand "")
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "min", reason: "range" })
      SEMVER_PICKED -> idle when (!= @entity.cand "")
        (set @entity.op "minD")
        (set @entity.inputs (array/prepend (array/map @entity.prims (fn q @q.v)) @entity.cand))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_STAGED -> idle when (and (== @entity.reason "") (and (== @entity.op "minD") @entity.satisfied))
        (emit SEMVER_MINIMUM { requestId: @entity.requestId, version: @entity.cand })
      SEMVER_STAGED -> idle when (and (== @entity.reason "") (and (== @entity.op "minD") (not @entity.satisfied)))
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "min", reason: "range" })

      SEMVER_STAGED -> idle when (and (== @entity.reason "") (== @entity.op "bump"))
        (set @entity.next (let ((p (array/nth @entity.parsed 0))) (let ((hasPre (> (array/len @p.pre) 0))) (if (== @entity.kind "major") (if (and @hasPre (and (== @p.minor 0) (== @p.patch 0))) { ok: true, major: @p.major, minor: 0, patch: 0, pre: [], build: "" } { ok: true, major: (+ @p.major 1), minor: 0, patch: 0, pre: [], build: "" }) (if (== @entity.kind "minor") (if (and @hasPre (== @p.patch 0)) { ok: true, major: @p.major, minor: @p.minor, patch: 0, pre: [], build: "" } { ok: true, major: @p.major, minor: (+ @p.minor 1), patch: 0, pre: [], build: "" }) (if (== @entity.kind "patch") (if @hasPre { ok: true, major: @p.major, minor: @p.minor, patch: @p.patch, pre: [], build: "" } { ok: true, major: @p.major, minor: @p.minor, patch: (+ @p.patch 1), pre: [], build: "" }) (let ((bp (if @hasPre @p.patch (+ @p.patch 1))) (basePre (if @hasPre @p.pre []))) (let ((idx (array/reduce (array/range 0 (+ (array/len @basePre) 0)) -1 (fn acc i (let ((b (array/nth @basePre @i))) (if (and (validate/required @b) (and (> (str/len @b) 0) (and (== (str/replace-pattern @b "[0-9]" "") "") (validate/required (str/to-int @b))))) @i @acc)))))) (let ((inc (if (>= @idx 0) (array/map @basePre (fn b i (if (== @i @idx) (let ((bi (str/to-int @b))) (if (validate/required @bi) (str/concat (+ @bi 1)) @b)) @b))) (array/append @basePre "0")))) { ok: true, major: @p.major, minor: @p.minor, patch: @bp, pre: (if (== @entity.identifier "") @inc (if (== (array/nth @inc 0) @entity.identifier) (if (and (!= (array/nth @inc 1) null) (and (> (str/len (array/nth @inc 1)) 0) (== (str/replace-pattern (array/nth @inc 1) "[0-9]" "") ""))) @inc (str/split (str/concat @entity.identifier ".0") ".")) (str/split (str/concat @entity.identifier ".0") "."))), build: "" })))))))))
        (set @entity.version (str/concat @entity.next.major "." @entity.next.minor "." @entity.next.patch (if (> (array/len @entity.next.pre) 0) (str/concat "-" (str/join @entity.next.pre ".")) "")))
        (emit SEMVER_BUMPED { requestId: @entity.requestId, version: @entity.version })
    }

    emits {
      SEMVER_DESUGAR -> internal { requestId : string! }
      SEMVER_PICKED -> internal { requestId : string! }
      SEMVER_STAGE -> internal { requestId : string! }
      SEMVER_STAGED -> internal { requestId : string! }
      SEMVER_PARSED -> external {
        requestId : string!
        valid : boolean!
        major : number!
        minor : number!
        patch : number!
        prerelease : string!
        build : string!
      }
        @description "The parts of the version text; valid is false (parts zero) when it is not strict semver."
        @tier "primary"
      SEMVER_COMPARED -> external {
        requestId : string!
        value : number!
      }
        @description "-1, 0 or 1: a is below, equal to or above b by semver precedence."
        @tier "primary"
      SEMVER_BUMPED -> external {
        requestId : string!
        version : string!
      }
        @description "The version after the bump."
        @tier "primary"
      SEMVER_SATISFIED -> external {
        requestId : string!
        value : boolean!
      }
        @description "Whether the version satisfies the range."
        @tier "primary"
      SEMVER_MINIMUM -> external {
        requestId : string!
        version : string!
      }
        @description "The lowest version the range admits."
        @tier "primary"
      SEMVER_REFUSED -> external {
        requestId : string!
        operation : string!
        reason : string!
      }
        @description "Why the request was refused: invalid, range, workspace, kind or identifier."
        @tier "primary"
    }

    listens {
      SEMVER_PARSE -> input {
        requestId : string
        version : string!
      }
        @description "Parse this version text."
        @synonyms "parse semver, read version"
      SEMVER_COMPARE -> input {
        requestId : string
        a : string!
        b : string!
      }
        @description "Compare two versions by semver precedence."
        @synonyms "compare versions, version order"
      SEMVER_BUMP -> input {
        requestId : string
        version : string!
        kind : string!
        identifier : string
      }
        @description "Increment a version: kind major, minor, patch or prerelease, with an optional prerelease identifier."
        @synonyms "next version, increment version"
      SEMVER_SATISFIES -> input {
        requestId : string
        version : string!
        range : string!
      }
        @description "Whether the version falls in the range (exact, ^, ~, >=, >, <=, <, *)."
        @synonyms "version in range, range check"
      SEMVER_MIN -> input {
        requestId : string
        range : string!
      }
        @description "The lowest version the range admits."
        @synonyms "min version, range floor"
    }
  }

  page boot as SemverOrbitalStart -> Semver
}
