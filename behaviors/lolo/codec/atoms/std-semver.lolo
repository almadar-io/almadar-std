app std-semver [
  version: "1.0.0",
  description: "std-semver — Semantic Versioning 2.0.0 over str/*, array/* and math/*. SEMVER_PARSE { version } answers SEMVER_PARSED { valid, major, minor, patch, prerelease, build } (valid false with zeros when the text is not strict MAJOR.MINOR.PATCH[-pre][+build]: no leading v, no leading zeros). SEMVER_COMPARE { a, b } answers SEMVER_COMPARED { value } -1, 0 or 1 by semver precedence (build ignored; a prerelease sorts below its release; prerelease identifiers compare numerically when both numeric, numeric below alphanumeric, alphanumerics by byte order, a shorter list below a longer one with equal prefix). SEMVER_BUMP { version, kind, identifier? } answers SEMVER_BUMPED { version } for kind major, minor, patch or prerelease with the node-semver inc rules (a prerelease major/minor/patch graduates to its release, prerelease increments the rightmost numeric identifier or appends 0, identifier restarts the counter at identifier.0 unless the list already starts with it followed by a number); the build is dropped. SEMVER_SATISFIES { version, range } answers SEMVER_SATISFIED { value } for the single-comparator forms exact, =, ^, ~, >=, >, <=, < and *, with the node-semver rule that a prerelease satisfies only a comparator with a prerelease on the same MAJOR.MINOR.PATCH. SEMVER_MIN { range } answers SEMVER_MINIMUM { version } (the lowest version the range admits; refused for < and <=). SEMVER_REFUSED { operation, reason }; every request takes an optional requestId that every answer and internal stage event echoes, so identical requests with different ids both complete inside one cascade with reason invalid (a version that does not parse), range (an unsupported or unparseable range: partials like ^1, x-ranges, compound ranges), workspace (a workspace:, link: or file: pin, never a version range), kind or identifier."
]
uses Spec from "almadar-std/semver"

type SemverPrim = { set : number!, op : string!, v : string!, lo : string!, lb : boolean! }
type SemverParts = { ok : boolean!, major : number!, minor : number!, patch : number!, pre : [string]!, build : string! }

orbital SemverOrbital {
  entity SemverRun [runtime] {
    id : string!
    op : string = ""
    inputs : [string] = []
    parsed : [SemverParts] = []
    cmps : [number] = []
    kind : string = ""
    identifier : string = ""
    reason : string = ""
    requestId : string = ""
    range : string = ""
    cand : string = ""
    prims : [SemverPrim] = []
    nSets : number = 0
    bad : boolean = false
    next : SemverParts = { ok: true, major: 0, minor: 0, patch: 0, pre: [], build: "" }
    value : number = 0
    satisfied : boolean = false
    version : string = ""
  }

  trait Semver -> SemverRun [client] {
    initial: idle

    state idle {
      SEMVER_PARSE -> idle
        (set @entity.requestId (default ?requestId ""))
        (set @entity.op "parse")
        (set @entity.bad false)
        (set @entity.inputs (array/append [] ?version))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_COMPARE -> idle
        (set @entity.requestId (default ?requestId ""))
        (set @entity.op "compare")
        (set @entity.bad false)
        (set @entity.inputs (array/append (array/append [] ?a) ?b))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_BUMP -> idle when (not (array/includes (str/split "major,minor,patch,prerelease" ",") ?kind))
        (set @entity.requestId (default ?requestId ""))
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "bump", reason: "kind" })
      SEMVER_BUMP -> idle when (and (array/includes (str/split "major,minor,patch,prerelease" ",") ?kind) (!= (str/replace-pattern (default ?identifier "") "[0-9A-Za-z-]" "") ""))
        (set @entity.requestId (default ?requestId ""))
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "bump", reason: "identifier" })
      SEMVER_BUMP -> idle when (and (array/includes (str/split "major,minor,patch,prerelease" ",") ?kind) (== (str/replace-pattern (default ?identifier "") "[0-9A-Za-z-]" "") ""))
        (set @entity.requestId (default ?requestId ""))
        (set @entity.op "bump")
        (set @entity.bad false)
        (set @entity.kind ?kind)
        (set @entity.identifier (default ?identifier ""))
        (set @entity.inputs (array/append [] ?version))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_SATISFIES -> idle when (or (str/startsWith (str/trim ?range) "workspace:") (or (str/startsWith (str/trim ?range) "link:") (str/startsWith (str/trim ?range) "file:")))
        (set @entity.requestId (default ?requestId ""))
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "satisfies", reason: "workspace" })
      SEMVER_SATISFIES -> idle when (not (or (str/startsWith (str/trim ?range) "workspace:") (or (str/startsWith (str/trim ?range) "link:") (str/startsWith (str/trim ?range) "file:"))))
        (set @entity.requestId (default ?requestId ""))
        (set @entity.op "satisfies")
        (set @entity.cand ?version)
        (set @entity.range (str/trim ?range))
        (emit SEMVER_DESUGAR { requestId: @entity.requestId })

      SEMVER_MIN -> idle when (or (str/startsWith (str/trim ?range) "workspace:") (or (str/startsWith (str/trim ?range) "link:") (str/startsWith (str/trim ?range) "file:")))
        (set @entity.requestId (default ?requestId ""))
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: "min", reason: "workspace" })
      SEMVER_MIN -> idle when (not (or (str/startsWith (str/trim ?range) "workspace:") (or (str/startsWith (str/trim ?range) "link:") (str/startsWith (str/trim ?range) "file:"))))
        (set @entity.requestId (default ?requestId ""))
        (set @entity.op "minA")
        (set @entity.cand "0.0.0")
        (set @entity.range (str/trim ?range))
        (emit SEMVER_DESUGAR { requestId: @entity.requestId })

      SEMVER_DESUGAR -> idle
        (set @entity.prims (array/flatten (array/map (str/split @entity.range "||") (fn sr si (let ((st (str/trim @sr))) (let ((hy (str/split @st " - "))) (let ((toks (if (> (array/len @hy) 1) (if (== (array/len @hy) 2) (array/map @hy (fn h hi (str/concat (if (== @hi 0) ">=" "<=") (str/trim @h)))) (array/append [] "!")) (if (== @st "") (array/append [] "*") (str/split (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replace-pattern @st "[ ]+" " ") ">= " ">=") "<= " "<=") "~> " "~>") "> " ">") "< " "<") "= " "=") "^ " "^") "~ " "~") " "))))) (array/flatten (array/map @toks (fn t (let ((op (if (str/startsWith @t ">=") ">=" (if (str/startsWith @t "<=") "<=" (if (str/startsWith @t "~>") "~" (if (str/startsWith @t ">") ">" (if (str/startsWith @t "<") "<" (if (str/startsWith @t "=") "=" (if (str/startsWith @t "^") "^" (if (str/startsWith @t "~") "~" ""))))))))) (ol (if (str/startsWith @t "~>") 2 (if (str/startsWith @t ">=") 2 (if (str/startsWith @t "<=") 2 (if (or (str/startsWith @t ">") (or (str/startsWith @t "<") (or (str/startsWith @t "=") (or (str/startsWith @t "^") (str/startsWith @t "~"))))) 1 0)))))) (let ((b0 (str/slice @t @ol (str/len @t)))) (let ((body (if (or (str/startsWith @b0 "v") (str/startsWith @b0 "V")) (str/slice @b0 1 (str/len @b0)) @b0))) (let ((hd (array/first (str/split @body "+")))) (if (validate/required @hd) (let ((dp (str/split @hd "-"))) (let ((core (if (== @body "") "*" (array/nth @dp 0))) (hasPre (> (array/len @dp) 1)) (pre (str/join (array/drop @dp 1) "-"))) (let ((nums (str/split @core "."))) (let ((okAll (if (and (<= (array/len @nums) 3) (array/every @nums (fn x (or (or (== @x "x") (or (== @x "X") (== @x "*"))) (and (> (str/len @x) 0) (and (== (str/replace-pattern @x "[0-9]" "") "") (and (validate/required (str/to-int @x)) (or (== (str/len @x) 1) (!= (str/slice @x 0 1) "0"))))))))) true false))) (let ((a0 (if (and @okAll (not (or (== (array/nth @nums 0) "x") (or (== (array/nth @nums 0) "X") (== (array/nth @nums 0) "*"))))) (let ((x0 (array/nth @nums 0))) (if (validate/required @x0) (let ((n0 (str/to-int @x0))) (if (validate/required @n0) (math/floor @n0) -1)) -1)) -1))) (let ((a1 (if (and @okAll (and (> (array/len @nums) 1) (and (>= @a0 0) (not (or (== (array/nth @nums 1) "x") (or (== (array/nth @nums 1) "X") (== (array/nth @nums 1) "*"))))))) (let ((x1 (array/nth @nums 1))) (if (validate/required @x1) (let ((n1 (str/to-int @x1))) (if (validate/required @n1) (math/floor @n1) -1)) -1)) -1))) (let ((a2 (if (and @okAll (and (> (array/len @nums) 2) (and (>= @a1 0) (not (or (== (array/nth @nums 2) "x") (or (== (array/nth @nums 2) "X") (== (array/nth @nums 2) "*"))))))) (let ((x2 (array/nth @nums 2))) (if (validate/required @x2) (let ((n2 (str/to-int @x2))) (if (validate/required @n2) (math/floor @n2) -1)) -1)) -1))) (let ((suf (if @hasPre (str/concat "-" @pre) ""))) (if (and @okAll (or (not @hasPre) (>= @a2 0))) (if (< @a0 0) (if (or (== @op ">") (== @op "<")) (array/append [] { set: @si, op: "<", v: "0.0.0-0", lo: "0.0.0", lb: false }) (array/append [] { set: @si, op: ">=", v: "0.0.0", lo: "0.0.0", lb: true })) (if (or (== @op "") (== @op "=")) (if (>= @a2 0) (array/append [] { set: @si, op: "=", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: (str/concat @a0 "." @a1 "." @a2 @suf), lb: true }) (if (>= @a1 0) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 ".0"), lo: (str/concat @a0 "." @a1 ".0"), lb: true }) { set: @si, op: "<", v: (str/concat @a0 "." (+ @a1 1) ".0-0"), lo: "0.0.0", lb: false }) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 ".0.0"), lo: (str/concat @a0 ".0.0"), lb: true }) { set: @si, op: "<", v: (str/concat (+ @a0 1) ".0.0-0"), lo: "0.0.0", lb: false }))) (if (== @op ">=") (if (>= @a2 0) (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: (str/concat @a0 "." @a1 "." @a2 @suf), lb: true }) (if (>= @a1 0) (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 ".0"), lo: (str/concat @a0 "." @a1 ".0"), lb: true }) (array/append [] { set: @si, op: ">=", v: (str/concat @a0 ".0.0"), lo: (str/concat @a0 ".0.0"), lb: true }))) (if (== @op ">") (if (>= @a2 0) (array/append [] { set: @si, op: ">", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: (if @hasPre (str/concat (str/concat @a0 "." @a1 "." @a2 @suf) ".0") (str/concat @a0 "." @a1 "." (+ @a2 1))), lb: true }) (if (>= @a1 0) (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." (+ @a1 1) ".0"), lo: (str/concat @a0 "." (+ @a1 1) ".0"), lb: true }) (array/append [] { set: @si, op: ">=", v: (str/concat (+ @a0 1) ".0.0"), lo: (str/concat (+ @a0 1) ".0.0"), lb: true }))) (if (== @op "<") (if (>= @a2 0) (array/append [] { set: @si, op: "<", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: "0.0.0", lb: false }) (if (>= @a1 0) (array/append [] { set: @si, op: "<", v: (str/concat @a0 "." @a1 ".0-0"), lo: "0.0.0", lb: false }) (array/append [] { set: @si, op: "<", v: (str/concat @a0 ".0.0-0"), lo: "0.0.0", lb: false }))) (if (== @op "<=") (if (>= @a2 0) (array/append [] { set: @si, op: "<=", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: "0.0.0", lb: false }) (if (>= @a1 0) (array/append [] { set: @si, op: "<", v: (str/concat @a0 "." (+ @a1 1) ".0-0"), lo: "0.0.0", lb: false }) (array/append [] { set: @si, op: "<", v: (str/concat (+ @a0 1) ".0.0-0"), lo: "0.0.0", lb: false }))) (if (== @op "~") (if (>= @a2 0) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: (str/concat @a0 "." @a1 "." @a2 @suf), lb: true }) { set: @si, op: "<", v: (str/concat @a0 "." (+ @a1 1) ".0-0"), lo: "0.0.0", lb: false }) (if (>= @a1 0) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 ".0"), lo: (str/concat @a0 "." @a1 ".0"), lb: true }) { set: @si, op: "<", v: (str/concat @a0 "." (+ @a1 1) ".0-0"), lo: "0.0.0", lb: false }) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 ".0.0"), lo: (str/concat @a0 ".0.0"), lb: true }) { set: @si, op: "<", v: (str/concat (+ @a0 1) ".0.0-0"), lo: "0.0.0", lb: false }))) (if (>= @a2 0) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 "." @a2 @suf), lo: (str/concat @a0 "." @a1 "." @a2 @suf), lb: true }) { set: @si, op: "<", v: (if (> @a0 0) (str/concat (+ @a0 1) ".0.0-0") (if (> @a1 0) (str/concat "0." (+ @a1 1) ".0-0") (str/concat "0.0." (+ @a2 1) "-0"))), lo: "0.0.0", lb: false }) (if (>= @a1 0) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 "." @a1 ".0"), lo: (str/concat @a0 "." @a1 ".0"), lb: true }) { set: @si, op: "<", v: (if (> @a0 0) (str/concat (+ @a0 1) ".0.0-0") (str/concat @a0 "." (+ @a1 1) ".0-0")), lo: "0.0.0", lb: false }) (array/append (array/append [] { set: @si, op: ">=", v: (str/concat @a0 ".0.0"), lo: (str/concat @a0 ".0.0"), lb: true }) { set: @si, op: "<", v: (str/concat (+ @a0 1) ".0.0-0"), lo: "0.0.0", lb: false })))))))))) (array/append [] { set: @si, op: "!", v: "0.0.0", lo: "0.0.0", lb: false })))))))))) (array/append [] { set: @si, op: "!", v: "0.0.0", lo: "0.0.0", lb: false }))))))))))))))))
        (set @entity.bad (array/some @entity.prims (fn q (== @q.op "!"))))
        (set @entity.nSets (+ 1 (array/reduce @entity.prims 0 (fn m q (math/max @m @q.set)))))
        (set @entity.inputs (array/prepend (array/map @entity.prims (fn q @q.v)) @entity.cand))
        (emit SEMVER_STAGE { requestId: @entity.requestId })

      SEMVER_STAGE -> idle
        (set @entity.parsed (array/map @entity.inputs (fn raw (let ((halves (str/split @raw "+"))) (let ((h0 (array/first @halves))) (if (validate/required @h0)  (let ((hasBuild (== (array/len @halves) 2)) (dparts (str/split @h0 "-"))) (let ((d0 (array/first @dparts))) (if (validate/required @d0) (let ((nums (str/split @d0 ".")) (hasPre (> (array/len @dparts) 1)) (preStr (str/join (array/drop @dparts 1) "-")) (build (if @hasBuild (str/join (array/drop @halves 1) "+") ""))) (let ((preIds (if @hasPre (str/split @preStr ".") []))) (let ((ok (if (and (<= (array/len @halves) 2) (and (== (array/len @nums) 3) (and (array/every @nums (fn n (and (> (str/len @n) 0) (and (== (str/replace-pattern @n "[0-9]" "") "") (or (== (str/len @n) 1) (!= (str/slice @n 0 1) "0")))))) (and (or (not @hasPre) (array/every @preIds (fn q (and (> (str/len @q) 0) (and (== (str/replace-pattern @q "[0-9A-Za-z-]" "") "") (or (!= (str/replace-pattern @q "[0-9]" "") "") (or (== (str/len @q) 1) (!= (str/slice @q 0 1) "0")))))))) (or (not @hasBuild) (array/every (str/split @build ".") (fn w (and (> (str/len @w) 0) (== (str/replace-pattern @w "[0-9A-Za-z-]" "") ""))))))))) true false))) { ok: @ok, major: (let ((x0 (array/nth @nums 0))) (if (and @ok (validate/required @x0)) (default (str/to-int @x0) 0) 0)), minor: (let ((x1 (array/nth @nums 1))) (if (and @ok (validate/required @x1)) (default (str/to-int @x1) 0) 0)), patch: (let ((x2 (array/nth @nums 2))) (if (and @ok (validate/required @x2)) (default (str/to-int @x2) 0) 0)), pre: (if @ok @preIds []), build: (if @ok @build "") }))) { ok: false, major: 0, minor: 0, patch: 0, pre: [], build: "" }))) { ok: false, major: 0, minor: 0, patch: 0, pre: [], build: "" }))))))
        (set @entity.reason (if (== @entity.op "parse") "" (if (and (array/every @entity.parsed (fn p (== @p.ok true))) (not @entity.bad)) "" (if (or (== @entity.op "compare") (== @entity.op "bump")) "invalid" (if (and (== @entity.op "satisfies") (== (array/nth (array/map @entity.parsed (fn p (if @p.ok 1 0))) 0) 0)) "invalid" "range")))))
        (set @entity.cmps (array/map (let ((p0 (array/nth @entity.parsed 0)) (p1 (if (> (array/len @entity.parsed) 1) (array/nth @entity.parsed 1) (array/nth @entity.parsed 0)))) (if (== @entity.op "compare") (array/append [] [@p0, @p1]) (if (== @entity.op "minC") (array/flatten (array/map (array/range 0 (array/len @entity.prims)) (fn i (array/map (array/range 0 (array/len @entity.prims)) (fn j (let ((li (array/nth @entity.parsed @i)) (rj (array/nth @entity.parsed @j))) [@li, @rj])))))) (if (or (== @entity.op "satisfies") (or (== @entity.op "minA") (or (== @entity.op "minB") (== @entity.op "minD")))) (array/map (array/range 0 (array/len @entity.prims)) (fn i [@p0, (array/nth @entity.parsed (+ @i 1))])) (array/append [] [@p0, @p0]))))) (fn pr (let ((l (array/nth @pr 0)) (r (array/nth @pr 1))) (let ((d0 (math/sign (- @l.major @r.major))) (d1 (math/sign (- @l.minor @r.minor))) (d2 (math/sign (- @l.patch @r.patch)))) (let ((c (if (!= @d0 0) @d0 (if (!= @d1 0) @d1 @d2)))) (if (!= @c 0) @c (if (and (== (array/len @l.pre) 0) (== (array/len @r.pre) 0)) 0 (if (== (array/len @l.pre) 0) 1 (if (== (array/len @r.pre) 0) -1 (array/reduce (array/range 0 (math/max (array/len @l.pre) (array/len @r.pre))) 0 (fn acc i (if (!= @acc 0) @acc (let ((x (array/nth @l.pre @i)) (y (array/nth @r.pre @i))) (if (== @x null) -1 (if (== @y null) 1 (let ((xn (== (str/replace-pattern @x "[0-9]" "") "")) (yn (== (str/replace-pattern @y "[0-9]" "") ""))) (if (and @xn @yn) (if (< (str/len @x) (str/len @y)) -1 (if (> (str/len @x) (str/len @y)) 1 (if (< @x @y) -1 (if (> @x @y) 1 0)))) (if @xn -1 (if @yn 1 (if (< @x @y) -1 (if (> @x @y) 1 0))))))))))))))))))))))
        (set @entity.satisfied (if (or (== @entity.op "satisfies") (or (== @entity.op "minA") (or (== @entity.op "minB") (== @entity.op "minD")))) (let ((v (array/nth @entity.parsed 0)) (n (array/len @entity.prims))) (if (array/some (array/range 0 @entity.nSets) (fn s (let ((idx (array/filter (array/range 0 @n) (fn i (== (array/nth (array/map @entity.prims (fn q @q.set)) @i) @s))))) (and (array/every @idx (fn i (let ((o (array/nth (array/map @entity.prims (fn q @q.op)) @i)) (c (array/nth @entity.cmps @i))) (if (== @o ">=") (>= @c 0) (if (== @o ">") (> @c 0) (if (== @o "<=") (<= @c 0) (if (== @o "<") (< @c 0) (== @c 0)))))))) (or (== (array/len @v.pre) 0) (array/some @idx (fn i (let ((cv (array/nth @entity.parsed (+ @i 1)))) (and (> (array/len @cv.pre) 0) (and (== @v.major @cv.major) (and (== @v.minor @cv.minor) (== @v.patch @cv.patch)))))))))))) true false)) false))
        (emit SEMVER_STAGED { requestId: @entity.requestId })

      SEMVER_STAGED -> idle when (!= @entity.reason "")
        (emit SEMVER_REFUSED { requestId: @entity.requestId, operation: (if (str/startsWith @entity.op "min") "min" @entity.op), reason: @entity.reason })

      SEMVER_STAGED -> idle when (and (== @entity.reason "") (== @entity.op "parse") (validate/required (array/first @entity.parsed)))
        (emit SEMVER_PARSED { requestId: @entity.requestId, valid: (object/get (array/first @entity.parsed) ok), major: (object/get (array/first @entity.parsed) major), minor: (object/get (array/first @entity.parsed) minor), patch: (object/get (array/first @entity.parsed) patch), prerelease: (str/join (object/get (array/first @entity.parsed) pre) "."), build: (object/get (array/first @entity.parsed) build) })
      SEMVER_STAGED -> idle when (and (== @entity.reason "") (== @entity.op "parse") (not (validate/required (array/first @entity.parsed))))
