app std-tar [
  version: "1.0.0",
  description: "std-tar — unpack a decompressed tar archive (ustar + PAX path records) into file rows over bytes/*, array/*, object literals, math/* and str/*. TAR_UNPACK { data } answers TAR_ANSWERED { files } with { path, kind, mode, size, data } per regular file and directory (kind file or directory), and TAR_REFUSED { reason, entry } otherwise: truncated, octal, checksum, end-marker, pax, pax-key, unsafe-path, symlink, hardlink, device, gnu-long-name, pax-global, typeflag. One array/reduce over a bounded range walks the headers (each entry consumes at least one 512-byte block); the first zero block must be followed by a second. Name + prefix are joined, a PAX path and size override the next entry only; PAX keys atime mtime ctime uid gid uname gname charset hdrcharset comment linkpath are metadata and ignored, any other key is refused as pax-key (entry = the key)."
]
uses Spec from "almadar-std/tar"

type TarFile = { path : string!, kind : "file" | "directory", mode : number!, size : number!, data : bytes! }
type TarAcc = { off : number!, files : [TarFile]!, pax : string!, psize : number!, err : string!, entry : string!, done : boolean! }

orbital TarOrbital {
  entity TarRun [runtime] {
    id : string!
    data : bytes = ""
    acc : TarAcc = { off: 0, files: [], pax: "", psize: -1, err: "", entry: "", done: false }
  }

  trait Untar -> TarRun [client] {
    initial: idle

    state idle {
      TAR_UNPACK -> idle
        (set @entity.data @payload.data)
        (set @entity.acc (array/reduce (array/range 0 (+ (math/floor (/ (bytes/length @entity.data) 512)) 1)) { off: 0, files: [], pax: "", psize: -1, err: "", entry: "", done: false } (fn acc t (if (or @acc.done (!= @acc.err "")) @acc (let ((off @acc.off)) (if (> (+ @off 512) (bytes/length @entity.data)) { off: @off, files: @acc.files, pax: @acc.pax, psize: @acc.psize, err: "truncated", entry: "", done: false } (let ((bs (array/map (array/range 0 512) (fn bi (bytes/at @entity.data (+ @off @bi)))))) (if (== (array/reduce @bs 0 (fn zs zb (+ @zs @zb))) 0) (if (> (+ @off 1024) (bytes/length @entity.data)) { off: @off, files: @acc.files, pax: @acc.pax, psize: @acc.psize, err: "truncated", entry: "", done: false } (if (array/every (array/range 512 1024) (fn iz (== (bytes/at @entity.data (+ @off @iz)) 0))) { off: @off, files: @acc.files, pax: @acc.pax, psize: @acc.psize, err: "", entry: "", done: true } { off: @off, files: @acc.files, pax: @acc.pax, psize: @acc.psize, err: "end-marker", entry: "", done: false })) (let ((oct (array/map [[148, 156], [124, 136], [100, 108]] (fn orr (array/reduce (array/range (array/nth @orr 0) (array/nth @orr 1)) { v: 0, ended: false, bad: false } (fn oa oi (let ((ob (array/nth @bs @oi))) (if (not (validate/required @ob)) { v: @oa.v, ended: true, bad: true } (if (and (>= @ob 48) (<= @ob 55)) (if @oa.ended { v: @oa.v, ended: true, bad: true } { v: (+ (* 8 @oa.v) (- @ob 48)), ended: false, bad: @oa.bad }) (if (or (== @ob 0) (== @ob 32)) { v: @oa.v, ended: true, bad: @oa.bad } { v: @oa.v, ended: true, bad: true })))))))))) (let ((ck (array/nth @oct 0)) (sd (array/nth @oct 1)) (mo (array/nth @oct 2)) (tf (array/nth @bs 156)))  (let ((sum (array/reduce (array/range 0 512) 0 (fn ca ci (+ @ca (if (and (>= @ci 148) (< @ci 156)) 32 (array/nth @bs @ci))))))        (ne0 (array/findIndex (array/range 0 100) (fn ni (== (array/nth @bs @ni) 0))))        (pe0 (array/findIndex (array/range 345 500) (fn pk (== (array/nth @bs @pk) 0))))        (dstart (+ @off 512)) (esz (if (and (>= @acc.psize 0) (!= @tf 120)) @acc.psize @sd.v)))   (let ((ne (if (< @ne0 0) 100 @ne0)) (pl (if (< @pe0 0) 155 @pe0)) (nxt (+ @dstart (* 512 (math/ceil (/ @esz 512))))))    (let ((name (bytes/to-string (bytes/slice @entity.data @off (+ @off @ne))))          (prefix (bytes/to-string (bytes/slice @entity.data (+ @off 345) (+ @off 345 @pl))))          (magic (== (bytes/to-string (bytes/slice @entity.data (+ @off 257) (+ @off 262))) "ustar"))          (verdict (if (or @ck.bad @sd.bad @mo.bad) "octal" (if (!= @sum @ck.v) "checksum" (if (> @nxt (bytes/length @entity.data)) "truncated" "ok")))))     (let ((path0 (if (or (== @name null) (== @prefix null)) "" (if (and @magic (> @pl 0)) (str/concat @prefix "/" @name) @name))))      (let ((path (if (!= @acc.pax "") @acc.pax @path0)))       (let ((unsafe (or (== (str/len @path) 0) (== (str/slice @path 0 1) "/") (array/includes (str/split @path "/") ".."))) (px (if (== @tf 120) (array/reduce (array/range 0 @sd.v) { p: 0, path: "", size: -1, key: "", bad: false } (fn pa pj (if (or (>= @pa.p @sd.v) @pa.bad) @pa (let ((sp (array/findIndex (array/range @pa.p @sd.v) (fn qk (== (bytes/at @entity.data (+ @dstart @qk)) 32))))) (if (< @sp 1) { p: @pa.p, path: @pa.path, size: @pa.size, key: @pa.key, bad: true } (let ((rs (bytes/to-string (bytes/slice @entity.data (+ @dstart @pa.p) (+ @dstart @pa.p @sp))))) (let ((rl (if (== @rs null) null (str/to-int @rs)))) (if (or (== @rl null) (< @rl (+ @sp 3)) (> (+ @pa.p @rl) @sd.v)) { p: @pa.p, path: @pa.path, size: @pa.size, key: @pa.key, bad: true } (let ((kv (bytes/to-string (bytes/slice @entity.data (+ @dstart @pa.p @sp 1) (- (+ @dstart @pa.p @rl) 1))))) (if (== @kv null) { p: @pa.p, path: @pa.path, size: @pa.size, key: @pa.key, bad: true } (let ((kk (array/nth (str/split @kv "=") 0))) (let ((vv (str/slice @kv (+ (str/len @kk) 1) (str/len @kv)))) { p: (+ @pa.p @rl), path: (if (== @kk "path") @vv @pa.path), size: (if (== @kk "size") (str/to-int @vv) @pa.size), key: (if (and (== @pa.key "") (not (array/includes ["path", "size", "atime", "mtime", "ctime", "uid", "gid", "uname", "gname", "charset", "hdrcharset", "comment", "linkpath"] @kk))) @kk @pa.key), bad: (and (== @kk "size") (or (== (str/to-int @vv) null) (< (str/to-int @vv) 0))) })))))))))))) { p: 0, path: "", size: -1, key: "", bad: false })))        (let ((reason (if (!= @verdict "ok") @verdict (if (and (== @tf 120) @px.bad) "pax" (if (and (== @tf 120) (!= @px.key "")) "pax-key" (if (array/includes [0, 48, 53, 120] @tf) (if (and (!= @tf 120) @unsafe) "unsafe-path" "") (if (== @tf 50) "symlink" (if (== @tf 49) "hardlink" (if (or (== @tf 51) (== @tf 52)) "device" (if (or (== @tf 76) (== @tf 75)) "gnu-long-name" (if (== @tf 103) "pax-global" "typeflag")))))))))))         { off: @nxt, files: (if (and (== @reason "") (or (== @tf 0) (== @tf 48) (== @tf 53))) (array/append @acc.files { path: @path, mode: @mo.v, size: (if (== @tf 53) 0 @esz), data: (bytes/slice @entity.data @dstart (if (== @tf 53) @dstart (+ @dstart @esz))), kind: (if (== @tf 53) "directory" "file") }) @acc.files), pax: (if (== @reason "") (if (== @tf 120) @px.path "") ""), psize: (if (and (== @reason "") (== @tf 120)) @px.size -1), err: @reason, entry: (if (== @reason "") "" (if (== @reason "pax-key") @px.key @path)), done: false })))))))))))))))))
        (emit TAR_PARSED { })

      TAR_PARSED -> idle when (!= @entity.acc.err "")
        (emit TAR_REFUSED { reason: @entity.acc.err, entry: @entity.acc.entry })
      TAR_PARSED -> idle when (== @entity.acc.err "")
        (emit TAR_ANSWERED { files: @entity.acc.files })
    }

    emits {
      TAR_PARSED -> internal { }
      TAR_ANSWERED -> external {
        files : [TarFile]!
      }
        @description "The unpacked entries in archive order: path, octal mode, size and data bytes (kind says file or directory; directories carry empty data)."
        @tier "primary"
      TAR_REFUSED -> external {
        reason : string!
        entry : string!
      }
        @description "Why the archive was refused (truncated, octal, checksum, end-marker, pax, pax-key, unsafe-path, symlink, hardlink, device, gnu-long-name, pax-global, typeflag) and the path of the refused entry."
        @tier "primary"
    }

    listens {
      TAR_UNPACK -> input {
        data : bytes!
      }
        @description "Unpack this base64 tar archive (already decompressed)."
        @synonyms "untar, extract tar, unpack tarball entries"
    }
  }

  page boot as TarOrbitalStart -> Untar
}
