   val ex = uxi ushr 52\n    val ey = uyi ushr 52\n    x = Double.fromBits(uxi)\n    y = Double.fromBits(uyi)\n    if (ey == 0x7ffL) {\n        return y\n    }\n    if (ex == 0x7ffL || uyi == 0L) {\n        return x\n    }\n    if (ex - ey > 64L) {\n        return x + y\n    }\n    var z = 1.0\n    if (ex > 0x3ffL + 510L) {\n        z = x1p700\n        x *= x1p_700\n        y *= x1p_700\n    } else if (ey < 0x3ffL - 450L) {\n        z = x1p_700\n        x *= x1p700\n        y *= x1p700\n    }\n    val a = _libm_sq(x)\n    val b = _libm_sq(y)\n    return z * kotlin.math.sqrt(b[1] + a[1] + b[0] + a[0])\n}", "private fun _clamp01(x: Double): Double = if (x.isNaN()) x else if (x < 0.0) 0.0 else if (x > 1.0) 1.0 else x", "private fun _bounceOut(t: Double): Double {\n    val n1 = 7.5625\n    val d1 = 2.75\n    return if (t < 1.0 / d1) n1 * t * t\n    else if (t < 2.0 / d1) { val t2 = t - 1.5 / d1; n1 * t2 * t2 + 0.75 }\n    else if (t < 2.5 / d1) { val t2 = t - 2.25 / d1; n1 * t2 * t2 + 0.9375 }\n    else { val t2 = t - 2.625 / d1; n1 * t2 * t2 + 0.984375 }\n}", "private fun _ease(curve: String, x: Number): Double {\n    val t = _clamp01(x.toDouble())\n    return when (curve) {\n        \"in-quad\" -> t * t\n        \"out-quad\" -> t * (2.0 - t)\n        \"in-out-quad\" -> if (t < 0.5) 2.0 * t * t else -1.0 + (4.0 - 2.0 * t) * t\n        \"in-cubic\" -> t * t * t\n        \"out-cubic\" -> { val f = t - 1.0; f * f * f + 1.0 }\n        \"in-out-cubic\" -> if (t < 0.5) 4.0 * t * t * t else { val f = 2.0 * t - 2.0; 0.5 * f * f * f + 1.0 }\n        \"elastic-out\" -> if (t == 0.0 || t == 1.0) t else { val p = 0.3; val s = p / 4.0; _libm_pow(2.0, -10.0 * t) * _libm_sin((t - s) * (2.0 * Math.PI) / p) + 1.0 }\n        \"bounce-out\" -> _bounceOut(t)\n        else -> t\n    }\n}"], "ease/smoothstep": ["private fun _clamp01(x: Double): Double = if (x.isNaN()) x else if (x < 0.0) 0.0 else if (x > 1.0) 1.0 else x", "private fun _smoothstep(a: Number, b: Number, x: Number): Double {\n    val e0 = a.toDouble()\n    val e1 = b.toDouble()\n    if (e0 == e1) return 0.0\n    val t = _clamp01((x.toDouble() - e0) / (e1 - e0))\n    return t * t * (3.0 - 2.0 * t)\n}"], "noise/perlin": ["private val _PERM: IntArray = intArrayOf(151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180)\n\nprivate fun _p(i: Long): Long = _PERM[(i and 255L).toInt()].toLong()\n\nprivate fun _fade(t: Double): Double = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nprivate fun _nlerp(a: Double, b: Double, t: Double): Double = a + t * (b - a)\n\nprivate fun _grad2(hash: Long, x: Double, y: Double): Double {\n    val h = hash and 7L\n    val u = if (h < 4) x else y\n    val v = if (h < 4) y else x\n    return (if (h and 1L == 0L) u else -u) + (if (h and 2L == 0L) v else -v)\n}\n\nprivate fun _perlin(x: Double, y: Double, seed: Double): Double {\n    val s = Math.floor(seed).toLong() and 255L\n    val xi = (Math.floor(x).toLong() + s) and 255L\n    val yi = (Math.floor(y).toLong() + s) and 255L\n    val xf = x - Math.floor(x)\n    val yf = y - Math.floor(y)\n    val u = _fade(xf)\n    val v = _fade(yf)\n    val aa = _p(_p(xi) + yi)\n    val ab = _p(_p(xi) + yi + 1)\n    val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}"], "noise/simplex": ["private val _PERM: IntArray = intArrayOf(151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180)\n\nprivate fun _p(i: Long): Long = _PERM[(i and 255L).toInt()].toLong()\n\nprivate fun _fade(t: Double): Double = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nprivate fun _nlerp(a: Double, b: Double, t: Double): Double = a + t * (b - a)\n\nprivate fun _grad2(hash: Long, x: Double, y: Double): Double {\n    val h = hash and 7L\n    val u = if (h < 4) x else y\n    val v = if (h < 4) y else x\n    return (if (h and 1L == 0L) u else -u) + (if (h and 2L == 0L) v else -v)\n}\n\nprivate fun _perlin(x: Double, y: Double, seed: Double): Double {\n    val s = Math.floor(seed).toLong() and 255L\n    val xi = (Math.floor(x).toLong() + s) and 255L\n    val yi = (Math.floor(y).toLong() + s) and 255L\n    val xf = x - Math.floor(x)\n    val yf = y - Math.floor(y)\n    val u = _fade(xf)\n    val v = _fade(yf)\n    val aa = _p(_p(xi) + yi)\n    val ab = _p(_p(xi) + yi + 1)\n    val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "private fun _simplex(x: Double, y: Double, seed: Double): Double =\n    (_perlin(x, y, seed) + _perlin(x * 2.0 + 5.2, y * 2.0 + 1.3, seed) * 0.5 + _perlin(x * 4.0 + 9.1, y * 4.0 + 7.7, seed) * 0.25) / 1.75"], "noise/fbm": ["private val _PERM: IntArray = intArrayOf(151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180)\n\nprivate fun _p(i: Long): Long = _PERM[(i and 255L).toInt()].toLong()\n\nprivate fun _fade(t: Double): Double = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nprivate fun _nlerp(a: Double, b: Double, t: Double): Double = a + t * (b - a)\n\nprivate fun _grad2(hash: Long, x: Double, y: Double): Double {\n    val h = hash and 7L\n    val u = if (h < 4) x else y\n    val v = if (h < 4) y else x\n    return (if (h and 1L == 0L) u else -u) + (if (h and 2L == 0L) v else -v)\n}\n\nprivate fun _perlin(x: Double, y: Double, seed: Double): Double {\n    val s = Math.floor(seed).toLong() and 255L\n    val xi = (Math.floor(x).toLong() + s) and 255L\n    val yi = (Math.floor(y).toLong() + s) and 255L\n    val xf = x - Math.floor(x)\n    val yf = y - Math.floor(y)\n    val u = _fade(xf)\n    val v = _fade(yf)\n    val aa = _p(_p(xi) + yi)\n    val ab = _p(_p(xi) + yi + 1)\n    val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "private fun _fbm(x: Double, y: Double, oct: Double, seed: Double): Double {\n    val octaves = Math.floor(oct).toLong().coerceIn(1L, 8L)\n    var total = 0.0\n    var freq = 1.0\n    var amp = 1.0\n    var max = 0.0\n    for (i in 0 until octaves) {\n        total += _perlin(x * freq, y * freq, seed) * amp\n        max += amp\n        freq *= 2.0\n        amp *= 0.5\n    }\n    return total / max\n}"], "anim/frame-at": ["private fun _frameAt(elapsed: Number, dur: Number, count: Number, looped: Boolean): Double {\n    val fd = dur.toDouble()\n    val fc = count.toDouble()\n    if (fd == 0.0) throw IllegalArgumentException(\"anim/frame-at: frameDur must not be 0\")\n    if (fc <= 0.0) throw IllegalArgumentException(\"anim/frame-at: frameCount \" + fc + \" must be positive\")\n    val i = Math.floor(elapsed.toDouble() / fd)\n    if (looped) {\n        val m = i % fc\n        return if (m < 0.0) m + fc else m\n    }\n    return Math.min(i, fc - 1.0)\n}"], "anim/sheet-rect": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnk