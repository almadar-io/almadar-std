      helperGap: "\n\n"
      portEffects: ["persist", "fetch", "fetch-stream", "notify", "navigate", "navigate-back", "call-service", "cancel-call", "send-server", "spawn", "despawn", "log"]
      portCall: "ports?.invoke(\"{{name}}\", listOf({{*}}))"
      portCase: "lower"
      attributeRoots: { "entity": "entity", "state": "state", "payload": "payload", "config": "config" }
      itemRoots: {  }
      attrAccess: ".{{name}}"
      indexAccess: "[{{0}}]"
      entityReadDefault: "({{read}} ?: {{default}})"
      numberIntForm: "{{json}}.0"
      stringEscapes: { "$": "\\$" }
      fileHeader: "package generated"
      listForm: "listOf({{*}})"
      mapOpen: "mapOf("
      mapClose: ")"
      mapPair: "{{key}} to {{value}}"
      letStmt: "val {{name}} = {{value}}"
      letExpr: "run { val {{name}} = {{value}}; {{body}} }"
      condExpr: "(if ({{cond}}) {{then}} else {{else}})"
      setStyle: "copy"
      fieldCase: "split-camel"
      voidPayload: "Unit"
      programOpen: ["class Program({{entities}}{{store}}) : _Router() {", "{{i}}init {"]
      programEntity: "e{{n}}: {{entity}}"
      programEntitySep: ", "
      programTrait: "{{i}}{{i}}val t{{n}} = {{class}}(e{{n}}); add({{key}}, t{{n}}, { t{{n}}.state }, { _json(t{{n}}.entity) }, { t{{n}}.emitted.size }, { n -> t{{n}}.emitted.drop(n).map { Triple(it.event, _json(it.payload), false) } })"
      programHandles: "{{i}}{{i}}handles[{{key}}] = {{table}}"
      programRow: "{{i}}{{i}}row({{source}}, {{event}}, {{target}}, {{trigger}}, {{guard}}, {{map}})"
      deliverOpen: ["{{i}}}", "", "{{i}}override fun deliver(target: String, event: String, payload: kotlinx.serialization.json.JsonElement) {"]
      deliverCase: "{{i}}{{i}}if (target == {{target}} && event == {{event}}) { (trait(target) as? {{class}})?.{{method}}({{arg}}); return }"
      deliverCasePlain: "{{i}}{{i}}if (target == {{target}} && event == {{event}}) { (trait(target) as? {{class}})?.{{method}}(); return }"
      deliverClose: ["{{i}}}"]
      programClose: ["}"]
      payloadDecode: "_decode<{{type}}>({{value}})"
      guardForm: ["", "private fun {{name}}(payload_json: kotlinx.serialization.json.JsonElement): Boolean {", "{{i}}val payload = {{decode}}", "{{i}}return {{expr}}", "}"]
      mapForm: ["", "private fun {{name}}(payload_json: kotlinx.serialization.json.JsonElement): kotlinx.serialization.json.JsonElement {", "{{i}}val payload = {{decode}}", "{{i}}return _json({{expr}})", "}"]
      guardName: "_guard{{n}}"
      mapName: "_map{{n}}"
      guardRef: "::{{name}}"
      mapRef: "::{{name}}"
      recordForm: "{{type}}({{fields}})"
      recordField: "{{name}} = {{value}}"
      unionArmForm: "{{union}}.{{union}}{{arm}}({{inner}})"
      enumForm: "{{enum}}.{{member}}"
      enumMemberCase: "split-pascal"
      methodCase: "pascal"
      classOpen: "class {{class}}("
      classEmpty: ""
      constructor: ["{{i}}var entity: {{entity}},", "{{i}}val ports: ((String, List<Any?>) -> Unit)? = null,", "{{i}}val config: {{configType}} = {{configType}}(),", ") {", "{{i}}var state: String = {{initial}}", "{{i}}val emitted = mutableListOf<Emitted>()", "{{withStore}}{{i}}var store: Store? = null", "{{withStore}}{{i}}val completed = mutableSetOf<Int>()", "", "{{i}}data class Emitted(val event: String, val payload: Any)"]
      configType: "{{trait}}Config"
      emitMethod: ["{{i}}fun emit(event: String, payload: Any) {", "{{i}}{{i}}emitted.add(Emitted(event, payload))", "{{i}}}"]
      completeMethod: ["", "{{i}}fun complete(answer: Answer, success: String?, failure: String?) {", "{{i}}{{i}}val route = (if (answer.ok) success else failure) ?: return", "{{i}}{{i}}completed.add(emitted.size)", "{{i}}{{i}}emitted.add(Emitted(route, answer.payload))", "{{i}}}", "", "{{i}}fun useStore(): Store = store ?: error(\"no store\")"]
      routedEffects: {"persist": "complete(useStore().persist({{0}}, {{1}}, {{2}}), {{success}}, {{failure}})", "fetch": "complete(useStore().fetch({{entity}}, {{filter}}), {{success}}, {{failure}})"}
      fetchAll: "null"
      programStoreParam: ", store: Store"
      programTraitStore: "{{i}}{{i}}val t{{n}} = {{class}}(e{{n}}); t{{n}}.store = store; add({{key}}, t{{n}}, { t{{n}}.state }, { _json(t{{n}}.entity) }, { t{{n}}.emitted.size }, { n -> t{{n}}.emitted.drop(n).mapIndexed { j, it -> Triple(it.event, _json(it.payload), (n + j) in t{{n}}.completed) } })"
      entityNames: { "Any": "AnyEntity", "Array": "ArrayEntity", "Boolean": "BooleanEntity", "Box": "BoxEntity", "Button": "ButtonEntity", "Card": "CardEntity", "Char": "CharEntity", "Color": "ColorEntity", "Column": "ColumnEntity", "Double": "DoubleEntity", "Enum": "EnumEntity", "Exception": "ExceptionEntity", "Float": "FloatEntity", "Image": "ImageEntity", "Int": "IntEntity", "List": "ListEntity", "Long": "LongEntity", "Map": "MapEntity", "Modifier": "ModifierEntity", "Nothing": "NothingEntity", "Number": "NumberEntity", "Pair": "PairEntity", "Result": "ResultEntity", "Row": "RowEntity", "Set": "SetEntity", "Short": "ShortEntity", "State": "StateEntity", "String": "StringEntity", "Surface": "SurfaceEntity", "Text": "TextEntity", "Throwable": "ThrowableEntity", "Triple": "TripleEntity", "Unit": "UnitEntity" }
      typeMap: {  }
      indent: "    "
      sectionGap: "\n\n"
      payloadField: "{{name}} = {{value}}"
    }
  }

