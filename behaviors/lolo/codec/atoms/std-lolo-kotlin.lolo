3600000.0 - 1.0\n        4 -> (Math.floor(ts / day) + 1.0) * day - 1.0\n        5 -> { val days = Math.floor(ts / day).toLong(); val dow = Math.floorMod(days + 3L, 7L); ((days - dow) + 7L).toDouble() * day - 1.0 }\n        6 -> { val d = _tsToDate(ts); if (d[1] >= 12) _dateToTs(d[0] + 1, 1, 1) - 1.0 else _dateToTs(d[0], d[1] + 1, 1) - 1.0 }\n        7 -> { val d = _tsToDate(ts); val next = (d[1] - 1) / 3 * 3 + 4; if (next > 12) _dateToTs(d[0] + 1, next - 12, 1) - 1.0 else _dateToTs(d[0], next, 1) - 1.0 }\n        else -> { val d = _tsToDate(ts); _dateToTs(d[0] + 1, 1, 1) - 1.0 }\n    }\n}\n\nprivate fun _roundAway(x: Double): Double {\n    if (x.isNaN() || x.isInfinite()) return x\n    val f = Math.floor(x)\n    val d = x - f\n    return if (d < 0.5) f else if (d > 0.5) f + 1.0 else if (x > 0.0) f + 1.0 else f\n}", "private fun _nowMs(): Double = System.currentTimeMillis().toDouble()", "private fun _tTod(t: String, op: String): Double { val m = _moment(t); if (m.dateOnly) throw IllegalArgumentException(op + \" needs a time of day and a date carries none: pass a datetime\"); return m.ms }", "private fun _tRelative(t: String): String {\n    val ts = _tTod(t, \"time/relative\")\n    val diff = _nowMs() - ts\n    fun phrase(n: Long, unit: String): String {\n        val plural = if (n == 1L) \"\" else \"s\"\n        return if (diff < 0.0) \"in \" + n + \" \" + unit + plural else n.toString() + \" \" + unit + plural + \" ago\"\n    }\n    val ms = Math.abs(diff)\n    val minute = 60000.0\n    val hour = 3600000.0\n    val day = 86400000.0\n    return if (ms < minute) \"just now\"\n    else if (ms < hour) phrase(_roundAway(ms / minute).toLong(), \"minute\")\n    else if (ms < day) phrase(_roundAway(ms / hour).toLong(), \"hour\")\n    else if (ms < 7.0 * day) phrase(_roundAway(ms / day).toLong(), \"day\")\n    else if (ms < 30.0 * day) phrase(_roundAway(ms / (7.0 * day)).toLong(), \"week\")\n    else if (ms < 365.0 * day) phrase(_roundAway(ms / (30.0 * day)).toLong(), \"mon