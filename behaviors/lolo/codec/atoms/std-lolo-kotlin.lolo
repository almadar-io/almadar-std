   val blocked = blockedIn.map { _pkey(_pcell(it, \"blocked\")) }.toSet()\n    val offs = _poffs(diagonal)\n    val heuristic = { c: _Cell ->\n        val dx = Math.abs(c.x - goal.x)\n        val dy = Math.abs(c.y - goal.y)\n        if (diagonal) Math.max(dx, dy) else dx + dy\n    }\n    var counter = 0L\n    val open = mutableListOf<_Node>()\n    val cameFrom = HashMap<String, _Cell>()\n    val gScore = HashMap<String, Long>()\n    val closed = HashSet<String>()\n    val h0 = heuristic(start)\n    open.add(_Node(start, 0L, h0, h0, counter))\n    counter += 1\n    gScore[_pkey(start)] = 0L\n    while (open.isNotEmpty()) {\n        var best = 0\n        for (i in 1 until open.size) {\n            val n = open[i]\n            val b = open[best]\n            if (n.f < b.f || (n.f == b.f && n.h < b.h) || (n.f == b.f && n.h == b.h && n.order < b.order)) best = i\n        }\n        val current = open[best]\n        open[best] = open[open.size - 1]\n        open.removeAt(open.size - 1)\n        if (current.cell.x == goal.x && current.cell.y == goal.y) {\n            val path = mutableListOf(goal)\n            var k = _pkey(goal)\n            while (true) {\n                val prev = cameFrom[k] ?: break\n                path.add(prev)\n                k = _pkey(prev)\n            }\n            path.reverse()\n            return path\n        }\n        closed.add(_pkey(current.cell))\n        for ((dx, dy) in offs) {\n            val nb = _Cell(current.cell.x + dx, current.cell.y + dy)\n            if (nb.x < 0 || nb.x >= w || nb.y < 0 || nb.y >= h) continue\n            val nk = _pkey(nb)\n            if (blocked.contains(nk) || closed.contains(nk)) continue\n            val tentative = current.g + 1\n            val known = gScore[nk]\n            if (known == null || tentative < known) {\n                cameFrom[nk] = current.cell\n                gScore[nk] = tentative\n                val hh = heuristic(nb)\n                open.add(_Node(nb, tentative, hh, tentat