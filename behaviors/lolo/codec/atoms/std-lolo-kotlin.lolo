0000.0\n    else -> null\n}\n\nprivate fun _belowDay(unit: Int): Boolean = unit <= 3\n\nprivate fun _addMonths(ts: Double, months: Long): Double {\n    val d = _tsToDate(ts)\n    val tod = ts - _dateToTs(d[0], d[1], d[2])\n    val total = d[0].toLong() * 12L + (d[1] - 1).toLong() + months\n    val ny = Math.floorDiv(total, 12L).toInt()\n    val nm = Math.floorMod(total, 12L).toInt() + 1\n    return _dateToTs(ny, nm, minOf(d[2], _dim(ny, nm))) + tod\n}\n\nprivate fun _wholeMonths(from: Double, to: Double): Long {\n    val lo = Math.min(from, to)\n    val hi = Math.max(from, to)\n    val a = _tsToDate(lo)\n    val b = _tsToDate(hi)\n    val tod1 = lo - _dateToTs(a[0], a[1], a[2])\n    val tod2 = hi - _dateToTs(b[0], b[1], b[2])\n    var months = (b[0] - a[0]).toLong() * 12L + (b[1] - a[1]).toLong()\n    if (b[2] < a[2] || (b[2] == a[2] && tod2 < tod1)) months -= 1L\n    return if (to < from) -months else months\n}\n\nprivate fun _shiftTime(ts: Double, amount: Double, unit: Int): Double {\n    val fixed = _fixedMs(unit)\n    if (fixed != null) return ts + amount * fixed\n    if (amount != Math.floor(amount) || Math.abs(amount) > 4294967295.0) throw IllegalArgumentException(\"a calendar unit takes a whole amount, got \" + amount)\n    val months = when (unit) { 8 -> amount.toLong() * 12L; 7 -> amount.toLong() * 3L; else -> amount.toLong() }\n    return _addMonths(ts, months)\n}\n\nprivate fun _shiftMoment(text: String, amount: Double, unitName: String, op: String): String {\n    val m = _moment(text)\n    val unit = _unit(unitName)\n    if (m.dateOnly) {\n        if (_belowDay(unit)) throw IllegalArgumentException(op + \" needs a time of day and a date carries none: pass a datetime\")\n        if (_fixedMs(unit) != null && amount != Math.floor(amount)) throw IllegalArgumentException(op + \" on a date takes a whole amount of days or weeks, got \" + amount)\n    }\n    return _render(_shiftTime(m.ms, amount, unit), m.dateOnly)\n}\n\nprivate fun _pair(a: String, b: String,