        '|'.code -> { out.append('|'); i += 1; quantifiable = false }\n            '^'.code -> { out.append('^'); i += 1; quantifiable = false }\n            '$'.code -> { out.append(\"\\\\z\"); i += 1; quantifiable = false }\n            '*'.code, '+'.code, '?'.code, '{'.code -> {\n                if (!quantifiable) return null\n                if (ch == '{'.code) {\n                    val (text, next) = _rxBraces(c, i) ?: return null\n                    out.append(text)\n                    i = next\n                } else {\n                    out.appendCodePoint(ch)\n                    i += 1\n                }\n                if (i < c.size && c[i] == '?'.code) { out.append('?'); i += 1 }\n                quantifiable = false\n            }\n            '}'.code, ']'.code -> return null\n            '.'.code -> { out.append(\"[^\\\\n\\\\r\\\\x{2028}\\\\x{2029}]\"); i += 1; quantifiable = true }\n            '['.code -> {\n                val (text, next) = _rxClass(c, i + 1) ?: return null\n                out.append(text)\n                i = next\n                quantifiable = true\n            }\n            '\\\\'.code -> {\n                if (i + 1 >= c.size) return null\n                val e = c[i + 1]\n                val ec = if (e < 0x80) e.toChar() else '\\u0000'\n                when (ec) {\n                    'b' -> out.append(\"(?:(?<=\" + _RX_WORD + \")(?!\" + _RX_WORD + \")|(?<!\" + _RX_WORD + \")(?=\" + _RX_WORD + \"))\")\n                    'B' -> out.append(\"(?:(?<=\" + _RX_WORD + \")(?=\" + _RX_WORD + \")|(?<!\" + _RX_WORD + \")(?!\" + _RX_WORD + \"))\")\n                    'd' -> out.append(\"[0-9]\")\n                    'D' -> out.append(\"[^0-9]\")\n                    'w' -> out.append(_RX_WORD)\n                    'W' -> out.append(\"[^0-9A-Za-z_]\")\n                    's' -> out.append(\"[\" + _RX_SPACE + \"]\")\n                    'S' -> out.append(\"[^\" + _RX_SPACE + \"]\")\n                    'p', 'P' -> {\n                        val end = _rxPropEnd(c, i + 1) ?: return null\n                        out.append('\\\\').append(String(c, i + 1, end - (i + 1)))\n                        i = end\n                        quantifiable = true\n                        continue\n                    }\n                    'x' -> {\n                        out.append(_rxHex(_rxHexAt(c, i + 2, 2) ?: return null))\n                        i += 4\n                        quantifiable = true\n                        continue\n                    }\n                    'u' -> {\n                        val code = _rxHexAt(c, i + 2, 4) ?: return null\n                        if (code in 0xD800..0xDFFF) return null\n                        out.append(_rxHex(code))\n                        i += 6\n                        quantifiable = true\n                        continue\n                    }\n                    else -> {\n                        val ctl = _rxControl(e)\n                        if (e < 0x80 && _RX_SYNTAX.indexOf(ec) >= 0) out.append(_rxHex(e))\n                        else if (ctl != null) out.append(_rxHex(ctl))\n                        else return null\n                    }\n                }\n                i += 2\n                quantifiable = !(ec == 'b' || ec == 'B')\n            }\n            else -> { out.append(_rxHex(ch)); i += 1; quantifiable = true }\n        }\n    }\n    return if (depth == 0) out.toString() else null\n}\n\nprivate fun _rxCompile(pattern: String): java.util.regex.Pattern? {\n    val t = _rxTranslate(pattern) ?: return null\n    return try { java.util.regex.Pattern.compile(t) } catch (e: java.util.regex.PatternSyntaxException) { null }\n}\n\nprivate fun _rxIs(pattern: String, value: String): Boolean = _rxCompile(pattern)?.matcher(value)?.find() ?: false\n\nprivate fun _rxReplace(text: String, pattern: String, rep: String): String? {\n    val re = _rxCompile(pattern) ?: return null\n    val m = re.matcher(text)\n    val out = StringBuilder()\n    var copied = 0\n    var at = 0\n    while (at <= text.length) {\n        if (!m.find(at)) break\n        out.append(text, copied, m.start())\n        out.append(rep)\n        copied = m.end()\n        at = if (m.end() == m.start()) m.end() + (if (m.end() < text.length) Character.charCount(text.codePointAt(m.end())) else 1) else m.end()\n    }\n    out.append(text, copied, text.length)\n    return out.toString()\n}", "private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromJsonElement(kotlinx.serialization.serializer<R>(), _jv(v))\n}", "private fun _obj(v: Any?): Map<String, Any?> {\n    @Suppress(\"UNCHECKED_CAST\")\n    if (v is Map<*, *>) return v as Map<String, Any?>\n    val j = _jv(v)\n    if (j !is kotlinx.serialization.json.JsonObject) throw IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private fun _lenOf(v: Any?): Int = when (v) {\n    is String -> v.codePointCount(0, v.length)\n    is List<*> -> v.size\n    else -> throw IllegalArgumentException(\"expected string or array\")\n}", "private const val _RX_EMAIL = \"^[^\\\\s@]+@[^\\\\s@.]+\\\\.[^\\\\s@]+\\u0024\"", "private fun _ruleHolds(name: String, value: Any?, args: List<Any?>): Boolean? {\n    fun arg(at: Int): Any? {\n        if (at >= args.size) throw IllegalArgumentException(\"validate/check: the rule \" + name + \" is missing its argument \" + (at + 1))\n        return args[at]\n    }\n    fun number(at: Int): Double = (arg(at) as? Number)?.toDouble() ?: throw IllegalArgumentException(\"expected number\")\n    val valueRule = name == \"email\" || name == \"minLength\" || name == \"maxLength\" || name == \"min\" || name == \"max\" || name == \"range\" || name == \"pattern\" || name == \"oneOf\"\n    if (valueRule && value == null) return true\n    return when (name) {\n        \"required\" -> value != null && value != \"\"\n        \"string\" -> value is String\n        \"number\" -> value is Int || (value is Number && !value.toDouble().isNaN())\n        \"boolean\" -> value is Boolean\n        \"email\" -> _rxIs(_RX_EMAIL, value as? String ?: throw IllegalArgumentException(\"expected string\"))\n        \"minLength\" -> _lenOf(value).toDouble() >= number(0)\n        \"maxLength\" -> _lenOf(value).toDouble() <= number(0)\n        \"min\" -> ((value as? Number)?.toDouble() ?: throw IllegalArgumentException(\"expected number\")) >= number(0)\n        \"max\" -> ((value as? Number)?.toDouble() ?: throw IllegalArgumentException(\"expected number\")) <= number(0)\n        \"range\" -> { val n = (value as? Number)?.toDouble() ?: throw IllegalArgumentException(\"expected number\"); n >= number(0) && n <= number(1) }\n        \"pattern\" -> _rxIs(arg(0) as? String ?: throw IllegalArgumentException(\"expected string\"), value as? String ?: throw IllegalArgumentException(\"expected string\"))\n        \"oneOf\" -> (arg(0) as? List<*> ?: throw IllegalArgumentException(\"expected array\")).any { it == value }\n        else -> null\n    }\n}", "private inline fun <reified R> _check(value: Any?, rules: Map<String, List<List<Any?>>>): R {\n    val obj = _obj(value)\n    val errors = mutableListOf<String>()\n    for ((field, list) in rules) {\n        val fv = obj[field]\n        for (rule in list) {\n            val name = rule[0] as String\n            if (_ruleHolds(name, fv, rule.drop(1)) == false) errors.add(field + \": \" + name + \" validation failed\")\n        }\n    }\n    return _ret(linkedMapOf<String, Any?>(\"valid\" to errors.isEmpty(), \"errors\" to errors))\n}"], "time/parse": ["private const val _DAY_MS = 86400000.0\n\nprivate fun _isLeap(y: Int): Boolean = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0\n\nprivate fun _dim(y: Int, m: Int): Int = when (m) {\n    1, 3, 5, 7, 8, 10, 12 -> 31\n    4, 6, 9, 11 -> 30\n    2 -> if (_isLeap(y)) 29 else 28\n    else -> 30\n}\n\nprivate fun _tsToDate(ts: Double): IntArray {\n    val days = Math.floor(ts / 86400000.0).toLong()\n    val shifted = days + 719468L\n    val era = Math.floorDiv(shifted, 146097L)\n    val doe = Math.floorMod(shifted, 146097L)\n    val yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L\n    val doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)\n    val mp = (5L * doy + 2L) / 153L\n    val day = (doy - (153L * mp + 2L) / 5L + 1L).toInt()\n    val month = (if (mp < 10L) mp + 3L else mp - 9L).toInt()\n    val year = (yoe + era * 400L + (if (month <= 2) 1L else 0L)).toInt()\n    return intArrayOf(year, month, day)\n}\n\nprivate fun _dateToTs(year: Int, month: Int, day: Int): Double {\n    val y = year.toLong() - (if (month <= 2) 1L else 0L)\n    val era = Math.floorDiv(y, 400L)\n    val yoe = Math.floorMod(y, 400L)\n    val mp = ((month + 9) % 12).toLong()\n    val doy = (153L * mp + 2L) / 5L + day.toLong() - 1L\n    val doe = yoe * 365L + yoe / 4L - yoe / 100L + doy\n    return (era * 146097L + doe - 719468L).toDouble() * 86400000.0\n}\n\nprivate class _Mo(val ms: Double, val dateOnly: Boolean)\n\nprivate fun _parseIso(text: String): _Mo? {\n    fun num(from: Int, len: Int): Int? {\n        if (from < 0 || from + len > text.length) return null\n        for (k in from until from + len) if (text[k] !in '0'..'9') return null\n        return text.substring(from, from + len).toInt()\n    }\n    if (text.length < 8 || text[4] != '-' || text[7] != '-') return null\n    val y = num(0, 4) ?: return null\n    val mo = num(5, 2) ?: return null\n    val d = num(8, 2) ?: return null\n    if (mo < 1 || mo > 12 || d < 1 || d > _dim(y, mo)) return null\n    var ms = _dateToTs(y, mo, d)\n    if (text.length == 10) return _Mo(ms, true)\n    if (text.length < 14 || text[10] != 'T' || text[13] != ':') return null\n    val hour = num(11, 2) ?: return null\n    val minute = num(14, 2) ?: return null\n    if (hour > 23 || minute > 59) return null\n    ms += hour * 3600000.0 + minute * 60000.0\n    var at = 16\n    if (at < text.length && text[at] == ':') {\n        val second = num(at + 1, 2) ?: return null\n        if (second > 59) return null\n        ms += second * 1000.0\n        at += 3\n        if (at < text.length && text[at] == '.') {\n            val start = at + 1\n            var end = start\n            while (end < text.length && text[end] in '0'..'9') end += 1\n            if (end == start) return null\n            ms += text.substring(start, end).padEnd(3, '0').substring(0, 3).toLong().toDouble()\n            at = end\n        }\n    }\n    if (at > text.length) return null\n    val zone = text.substring(at)\n    if (zone == \"Z\") return _Mo(ms, false)\n    if (zone.length == 6 && (zone[0] == '+' || zone[0] == '-') && zone[3] == ':') {\n        val oh = num(at + 1, 2) ?: return null\n        val om = num(at + 4, 2) ?: return null\n        if (oh > 23 || om > 59) return null\n        val offset = (oh * 60L + om) * 60000.0\n        return _Mo(if (zone[0] == '-') ms + offset else ms - offset, false)\n    }\n    return null\n}\n\nprivate fun _moment(text: String): _Mo = _parseIso(text) ?: throw IllegalArgumentException(\"expected date or datetime (ISO-8601 text), got \" + text)\n\nprivate fun _utcParts(ms: Double): IntArray {\n    if (ms.isNaN() || ms.isInfinite()) throw IllegalArgumentException(ms.toString() + \" ms is outside the years 0000 to 9999\")\n    val t = Math.floor(ms).toLong()\n    val days = Math.floorDiv(t, 86400000L)\n    val rem = Math.floorMod(t, 86400000L)\n    val d = _tsToDate(days.toDouble() * 86400000.0)\n    if (d[0] < 0 || d[0] > 9999) throw IllegalArgumentException(ms.toString() + \" ms is outside the years 0000 to 9999\")\n    val wd = Math.floorMod(days + 4L, 7L).toInt()\n    return intArrayOf(d[0], d[1], d[2], (rem / 3600000L).toInt(), ((rem / 60000L) % 60L).toInt(), ((rem / 1000L) % 60L).toInt(), (rem % 1000L).toInt(), wd)\n}\n\nprivate fun _render(ms: Double, dateOnly: Boolean): String {\n    val p = _utcParts(ms)\n    return if (dateOnly) String.format(\"%04d-%02d-%02d\", p[0], p[1], p[2])\n    else String.format(\"%04d-%02d-%02dT%02d:%02d:%02d.%03dZ\", p[0], p[1], p[2], p[3], p[4], p[5], p[6])\n}\n\nprivate fun _unit(u: String): Int = when (u) {\n    \"ms\", \"millisecond\", \"milliseconds\" -> 0\n    \"s\", \"second\", \"seconds\" -> 1\n    \"m\", \"minute\", \"minutes\" -> 2\n    \"h\", \"hour\", \"hours\" -> 3\n    \"d\", \"day\", \"days\" -> 4\n    \"w\", \"week\", \"weeks\" -> 5\n    \"month\", \"months\" -> 6\n    \"quarter\", \"quarters\" -> 7\n    \"year\", \"years\" -> 8\n    else -> throw IllegalArgumentException(\"expected time unit, got \" + u)\n}\n\nprivate fun _fixedMs(unit: Int): Double? = when (unit) {\n    0 -> 1.0\n    1 -> 1000.0\n    2 -> 60000.0\n    3 -> 3600000.0\n    4 -> 86400000.0\n    5 -> 604800000.0\n    else -> null\n}\n\nprivate fun _belowDay(unit: Int): Boolean = unit <= 3\n\nprivate fun _addMonths(ts: Double, months: Long): Double {\n    val d = _tsToDate(ts)\n    val tod = ts - _dateToTs(d[0], d[1], d[2])\n    val total = d[0].toLong() * 12L + (d[1] - 1).toLong() + months\n    val ny = Math.floorDiv(total, 12L).toInt()\n    val nm = Math.floorMod(total, 12L).toInt() + 1\n    return _dateToTs(ny, nm, minOf(d[2], _dim(ny, nm))) + tod\n}\n\nprivate fun _wholeMonths(from: Double, to: Double): Long {\n    val lo = Math.min(from, to)\n    val hi = Math.max(from, to)\n    val a = _tsToDate(lo)\n    val b = _tsToDate(hi)\n    val tod1 = lo - _dateToTs(a[0], a[1], a[2])\n    val tod2 = hi - _dateToTs(b[0], b[1], b[2])\n    var months = (b[0] - a[0]).toLong() * 12L + (b[1] - a[1]).toLong()\n    if (b[2] < a[2] || (b[2] == a[2] && tod2 < tod1)) months -= 1L\n    return if (to < from) -months else months\n}\n\nprivate fun _shiftTime(ts: Double, amount: Double, unit: Int): Double {\n    val fixed = _fixedMs(unit)\n    if (fixed != null) return ts + amount * fixed\n    if (amount != Math.floor(amount) || Math.abs(amount) > 4294967295.0) throw IllegalArgumentException(\"a calendar unit takes a whole amount, got \" + amount)\n    val months = when (unit) { 8 -> amount.toLong() * 12L; 7 -> amount.toLong() * 3L; else -> amount.toLong() }\n    return _addMonths(ts, months)\n}\n\nprivate fun _shiftMoment(text: String, amount: Double, unitName: String, op: String): String {\n    val m = _moment(text)\n    val unit = _unit(unitName)\n    if (m.dateOnly) {\n        if (_belowDay(unit)) throw IllegalArgumentException(op + \" needs a time of day and a date carries none: pass a datetime\")\n        if (_fixedMs(unit) != null && amount != Math.floor(amount)) throw IllegalArgumentException(op + \" on a date takes a whole amount of days or weeks, got \" + amount)\n    }\n    return _render(_shiftTime(m.ms, amount, unit), m.dateOnly)\n}\n\nprivate fun _pair(a: String, b: String, op: String): Pair<_Mo, _Mo> {\n    val x = _moment(a)\n    val y = _moment(b)\n    if (x.dateOnly != y.dateOnly) throw IllegalArgumentException(op + \" got a date and a datetime: convert one explicitly\")\n    return Pair(x, y)\n}\n\nprivate fun _startOf(ts: Double, unit: Int): Double {\n    val day = 86400000.0\n    return when (unit) {\n        0 -> Math.floor(ts)\n        1 -> Math.floor(ts / 1000.0) * 1000.0\n        2 -> Math.floor(ts / 60000.0) * 60000.0\n        3 -> Math.floor(ts / 3600000.0) * 3600000.0\n        4 -> Math.floor(ts / day) * day\n        5 -> { val days = Math.floor(ts / day).toLong(); val dow = Math.floorMod(days + 3L, 7L); (days - dow).toDouble() * day }\n        6 -> { val d = _tsToDate(ts); _dateToTs(d[0], d[1], 1) }\n        7 -> { val d = _tsToDate(ts); _dateToTs(d[0], (d[1] - 1) / 3 * 3 + 1, 1) }\n        else -> { val d = _tsToDate(ts); _dateToTs(d[0], 1, 1) }\n    }\n}\n\nprivate fun _endOf(ts: Double, unit: Int): Double {\n    val day = 86400000.0\n    return when (unit) {\n        0 -> Math.floor(ts)\n        1 -> (Math.floor(ts / 1000.0) + 1.0) * 1000.0 - 1.0\n        2 -> (Math.floor(ts / 60000.0) + 1.0) * 60000.0 - 1.0\n        3 -> (Math.floor(ts / 3600000.0) + 1.0) * 3600000.0 - 1.0\n        4 -> (Math.floor(ts / day) + 1.0) * day - 1.0\n        5 -> { val days = Math.floor(ts / day).toLong(); val dow = Math.floorMod(days + 3L, 7L); ((days - dow) + 7L).toDouble() * day - 1.0 }\n        6 -> { val d = _tsToDate(ts); if (d[1] >= 12) _dateToTs(d[0] + 1, 1, 1) - 1.0 else _dateToTs(d[0], d[1] + 1, 1) - 1.0 }\n        7 -> { val d = _tsToDate(ts); val next = (d[1] - 1) / 3 * 3 + 4; if (next > 12) _dateToTs(d[0] + 1, next - 12, 1) - 1.0 else _dateToTs(d[0], next, 1) - 1.0 }\n       