itleCase({{0}})", "str/camelCase": "_camelCase({{0}})", "str/kebabCase": "_caseWords({{0}}).joinToString(\"-\")", "str/snakeCase": "_caseWords({{0}}).joinToString(\"_\")", "str/template": "_template({{0}}, {{1}})", "str/to-number": "_toNumber({{0}})", "str/encode-uri-component": "_uriEncode({{0}})", "str/decode-uri-component": "_uriDecode({{0}})", "str/uri-component-valid": "(_uriDecode({{0}}) != null)", "math/approach": "_approach({{0}}, {{1}}, {{2}})", "math/lerp": "(({{0}}).toDouble() + (({{1}}).toDouble() - ({{0}}).toDouble()) * ({{2}}).toDouble())", "math/map": "_mapRange({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "math/wrap": "_wrap({{0}}, {{1}}, {{2}})", "math/deg-rad": "(({{0}}).toDouble() * Math.PI / 180.0)", "math/rad-deg": "(({{0}}).toDouble() * 180.0 / Math.PI)", "math/random#0": "Math.random()", "math/randomInt": "_randomInt({{0}}, {{1}})", "list#0": "listOf<Nothing>()", "array/sort#2": "_sortBy({{0}}, {{1}})", "array/sort#3": "_sortBy({{0}}, {{1}}, {{2}})", "array/avg#2": "_avg(_numsBy({{0}}, {{1}}))", "array/max#2": "_amax(_numsBy({{0}}, {{1}}))", "array/min#2": "_amin(_numsBy({{0}}, {{1}}))", "array/sum#2": "_sum(_numsBy({{0}}, {{1}}))", "array/cosine": "_cosine({{0}}, {{1}})", "array/insert": "_insert({{0}}, {{1}}, {{2}})", "array/remove": "_removeAt({{0}}, {{1}})", "array/removeItem": "_removeItem({{0}}, {{1}})", "array/partition": "_partition({{0}}, {{1}})", "array/pmap": "{{0}}.map({{1}})", "array/preduce": "_preduce({{0}}, {{1}}, {{2}})", "array/groupBy#2": "_groupBy({{0}}, {{1}})", "array/shuffle": "{{0}}.shuffled()", "array/nearest": "_nearest({{0}}, {{1}})", "object/clone": "_oclone({{0}})", "object/deepClone": "_odeepClone({{0}})", "object/deepMerge": "_odeepMerge({{*}})", "object/entries": "_oentries({{0}})", "object/equals": "_oequals({{0}}, {{1}})", "object/filter": "_ofilter({{0}}, {{1}})", "object/fromEntries": "_ofromEntries({{0}})", "object/has": "_ohas({{0}}, {{1}})", "object/keys": "_okeys({{0}})", "object/values": "_ovalues({{0}})", "object/mapKeys": "_omapKeys({{0}}, {{1}})", "object/mapValues": "_omapValues({{0}}, {{1}})", "object/merge": "_omerge({{*}})", "object/omit": "_oomit({{0}}, {{1}})", "object/pick": "_opick({{0}}, {{1}})", "object/set": "_oset({{0}}, {{1}}, {{2}})", "object/get#3": "_oget({{0}}, {{1}}, {{2}})", "bit/xor": "_bitFold(0, {{*}})", "bit/and": "_bitFold(1, {{*}})", "bit/or": "_bitFold(2, {{*}})", "bit/not": "_bitNot({{0}})", "bit/shl": "_bitShift(0, {{0}}, {{1}})", "bit/shr": "_bitShift(1, {{0}}, {{1}})", "bit/rotl": "_bitShift(2, {{0}}, {{1}})", "bit/rotr": "_bitShift(3, {{0}}, {{1}})", "ease/apply": "_ease({{0}}, {{1}})", "ease/smoothstep": "_smoothstep({{0}}, {{1}}, {{2}})", "noise/perlin#2": "_perlin(({{0}}).toDouble(), ({{1}}).toDouble(), 0.0)", "noise/perlin#3": "_perlin(({{0}}).toDouble(), ({{1}}).toDouble(), ({{2}}).toDouble())", "noise/simplex#2": "_simplex(({{0}}).toDouble(), ({{1}}).toDouble(), 0.0)", "noise/simplex#3": "_simplex(({{0}}).toDouble(), ({{1}}).toDouble(), ({{2}}).toDouble())", "noise/fbm#3": "_fbm(({{0}}).toDouble(), ({{1}}).toDouble(), ({{2}}).toDouble(), 0.0)", "noise/fbm#4": "_fbm(({{0}}).toDouble(), ({{1}}).toDouble(), ({{2}}).toDouble(), ({{3}}).toDouble())", "anim/frame-at#3": "_frameAt({{0}}, {{1}}, {{2}}, true)", "anim/frame-at#4": "_frameAt({{0}}, {{1}}, {{2}}, {{3}})", "anim/sheet-rect": "_sheetRect({{0}}, {{1}}, {{2}}, {{3}})", "anim/direction-from-delta#2": "_direction({{0}}, {{1}}, 4.0)", "anim/direction-from-delta#3": "_direction({{0}}, {{1}}, {{2}})", "base64/encode": "java.util.Base64.getEncoder().encodeToString(({{0}}).toByteArray(Charsets.UTF_8))", "base64/decode": "_b64text({{0}})", "base64/valid": "(_b64text({{0}}) != null)", "format/number#1": "_formatNumber({{0}}, mapOf())", "format/number#2": "_formatNumber({{0}}, {{1}})", "format/percent#1": "(_render(({{0}}).toDouble(), _EN, 0, 0, 2) + \"%\")", "format/percent#2": "_percent({{0}}, {{1}})", "format/currency#2": "_currency({{0}}, {{1}})", "format/currency#3": "_currency({{0}}, {{1}}, {{2}})", "format/bytes": "_formatBytes({{0}})", "format/list#1": "_formatList({{0}}, \"and\")", "format/list#2": "_formatList({{0}}, {{1}})", "format/phone#1": "_formatPhone({{0}})", "format/phone#2": "_formatPhone({{0}}, {{1}})", "format/creditCard": "_creditCard({{0}})", "format/ordinal": "_ordinal({{0}})", "format/plural": "_plural({{0}}, {{1}}, {{2}})", "json/valid": "_jvalid({{0}})", "json/parse#2": "_jparse({{0}})", "json/nodes": "_jnodes({{0}})", "json/stringify#1": "_jstringify({{0}})", "json/stringify#2": "_jstringify({{0}}, {{1}})", "str/replace-pattern": "_rxReplace({{0}}, {{1}}, {{2}})", "validate/pattern": "_rxIs({{1}}, {{0}})", "validate/email": "_rxIs(_RX_EMAIL, {{0}})", "validate/url": "_rxIs(_RX_URL, {{0}})", "validate/phone": "_rxIs(_RX_PHONE, {{0}})", "validate/uuid": "_rxIs(_RX_UUID, {{0}})", "validate/string": "_isStr({{0}})", "validate/number": "_isNum({{0}})", "validate/boolean": "_isBool({{0}})", "validate/array": "_isArr({{0}})", "validate/object": "_isObj({{0}})", "validate/noneOf": "(!({{1}}).contains({{0}}))", "validate/creditCard": "_luhn({{0}})", "validate/date": "_isDate({{0}})", "validate/check": "_check({{0}}, {{1}})", "time/parse": "_tParse({{0}})", "time/valid": "(_parseIso({{0}}) != null)", "time/add": "_tShift({{0}}, {{1}}, {{2}}, \"time/add\")", "time/subtract": "_tShift({{0}}, -({{1}}).toDouble(), {{2}}, \"time/subtract\")", "time/diff#2": "_tDiff({{0}}, {{1}}, null)", "time/diff#3": "_tDiff({{0}}, {{1}}, {{2}})", "time/isBefore": "_tCmp({{0}}, {{1}}, -1, \"time/isBefore\")", "time/isAfter": "_tCmp({{0}}, {{1}}, 1, \"time/isAfter\")", "time/isBetween": "_tBetween({{0}}, {{1}}, {{2}})", "time/isSame#2": "_tSame({{0}}, {{1}}, null)", "time/isSame#3": "_tSame({{0}}, {{1}}, {{2}})", "time/startOf": "_tBound({{0}}, {{1}}, false)", "time/endOf": "_tBound({{0}}, {{1}}, true)", "time/year": "_tPart({{0}}, 0, false)", "time/month": "_tPart({{0}}, 1, false)", "time/day": "_tPart({{0}}, 2, false)", "time/weekday": "_tPart({{0}}, 7, false)", "time/hour": "_tPart({{0}}, 3, true)", "time/minute": "_tPart({{0}}, 4, true)", "time/second": "_tPart({{0}}, 5, true)", "time/format": "_tFormat({{0}}, {{1}})", "time/duration": "_tDuration({{0}})", "time/now#0": "_render(_nowMs(), false)", "time/today#0": "_render(Math.floor(_nowMs() / _DAY_MS) * _DAY_MS, false)", "time/isFuture": "_tTod({{0}}, \"time/isFuture\") > _nowMs()", "time/isPast": "_tTod({{0}}, \"time/isPast\") < _nowMs()", "time/isToday": "(Math.floor(_moment({{0}}).ms / _DAY_MS) == Math.floor(_nowMs() / _DAY_MS))", "time/relative": "_tRelative({{0}})", "vec/add": "_vadd({{0}}, {{1}})", "vec/sub": "_vsub({{0}}, {{1}})", "vec/scale": "_vscale({{0}}, {{1}})", "vec/dot": "_dot3(_vec({{0}}), _vec({{1}}))", "vec/cross": "_vcross({{0}}, {{1}})", "vec/length": "Math.sqrt(_dot3(_vec({{0}}), _vec({{0}})))", "vec/length-sq": "_dot3(_vec({{0}}), _vec({{0}}))", "vec/normalize": "_vnormalize({{0}})", "vec/distance": "Math.sqrt(_vdist2(_vec({{0}}), _vec({{1}})))", "vec/distance-sq": "_vdist2(_vec({{0}}), _vec({{1}}))", "vec/lerp": "_vlerp({{0}}, {{1}}, {{2}})", "vec/angle#1": "_libm_atan2(_vec({{0}}).y, _vec({{0}}).x)", "vec/angle#2": "_vangle(_vec({{0}}), _vec({{1}}))", "vec/rotate": "_vrotate({{0}}, {{1}})", "vec/clamp-length": "_vclamp({{0}}, {{1}})", "geo/aabb-overlap": "_gAabb({{0}}, {{1}})", "geo/circle-overlap": "_gCircles({{0}}, {{1}})", "geo/rect-circle-overlap": "_gRectCircle({{0}}, {{1}})", "geo/point-in-rect": "_gPointRect({{0}}, {{1}})", "geo/point-in-circle": "_gPointCircle({{0}}, {{1}})", "geo/reflect": "_gReflect({{0}}, {{1}})", "geo/segment-intersect": "_gSegments({{0}}, {{1}})", "grid/to-world": "_gToWorld({{0}}, {{1}})", "grid/from-world": "_gFromWorld({{0}}, {{1}})", "grid/iso-to-screen": "_gIsoToScreen({{0}}, {{1}}, {{2}})", "grid/screen-to-iso": "_gScreenToIso({{0}}, {{1}}, {{2}})", "grid/distance": "_gDist({{0}}, {{1}}, false)", "grid/manhattan-distance": "_gDist({{0}}, {{1}}, true)", "grid/neighbors#1": "_gNeighbors({{0}}, false)", "grid/neighbors#2": "_gNeighbors({{0}}, {{1}})", "grid/cells-in-radius": "_gRadius({{0}}, {{1}})", "grid/line": "_gLine({{0}}, {{1}})", "grid/in-bounds": "_gInBounds({{0}}, {{1}}, {{2}})", "path/astar#5": "_pAstar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, false)", "path/astar#6": "_pAstar({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "path/reachable#5": "_pReach({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, false)", "path/reachable#6": "_pReach({{0}}, {{1}}, {{2}}, {{3}}, {{4}}, {{5}})", "tree/index#2": "_treeIndex({{0}}, {{1}}, mapOf())", "tree/index#3": "_treeIndex({{0}}, {{1}}, {{2}})", "prob/seed": "_probSeed({{0}})", "prob/flip": "(_probNext() < ({{0}}).toDouble())", "prob/gaussian": "(({{0}}).toDouble() + ({{1}}).toDouble() * _probNormal())", "prob/uniform": "_probUniform({{0}}, {{1}})", "prob/beta": "_probBeta({{0}}, {{1}})", "prob/categorical": "_probCategorical({{0}}, {{1}})", "prob/poisson": "_probPoisson({{0}})", "prob/sample": "_probSample({{0}}, { {{1}} })", "prob/expected-value": "_probMean(\"prob/expected-value\", {{0}})", "prob/variance": "_probVariance({{0}})", "prob/histogram": "_probHistogram({{0}}, {{1}})", "prob/percentile": "_probPercentile({{0}}, {{1}})", "prob/credible-interval": "_probCredible({{0}}, {{1}})", "str/find-pattern#2": "_rxFind({{0}}, {{1}}, 0.0)", "str/find-pattern#3": "_rxFind({{0}}, {{1}}, {{2}})", "math/acos": "_acos({{0}})", "math/asin": "_asin({{0}})" }
      unary: { "-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "{{0}}.size.toDouble()", "array/sort": "_sortBy({{0}}, null)", "math/round": "_round({{0}})", "array/concat": "{{0}}" }
      infix: { "+": "+", "-": "-", "*": "*", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||", "array/concat": "+" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "{{src}}.map { {{vars}} -> {{body}} }", "array/some": "{{src}}.any { {{vars}} -> {{body}} }", "array/every": "{{src}}.all { {{vars}} -> {{body}} }", "array/count": "{{src}}.count { {{vars}} -> {{body}} }.toDouble()" }
      lambdaForm: "{ {{params}} -> {{body}} }"
      indexedSource: "{{src}}.mapIndexed { i_, x_ -> Pair(i_.toDouble(), x_) }"
      indexedVars: "({{index}}, {{item}})"
      unsupportedForm: "_unsupported({{op}})"
      helpers: { "user": ["class Viewer {\n    var id: String = \"anonymous\"\n    var email: String? = null\n    var name: String? = null\n    var role: String? = \"anonymous\"\n\n    fun signIn(row: Map<String, String>?) {\n        id = if (row == null) \"anonymous\" else row[\"id\"] ?: \"\"\n        email = row?.get(\"email\")\n        name = row?.get(\"name\")\n        role = if (row == null) \"anonymous\" else row[\"role\"]\n    }\n}"], "object/get": ["private fun <V> _get(o: Map<String, V>, p: String): V? {\n    if (p.contains(\".\")) error(\"object/get: a dotted path is not supported on a typed map\")\n    return o[p]\n}", "private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromJsonElement(kotlinx.serialization.serializer<R>(), _jv(v))\n}", "private fun _obj(v: Any?): Map<String, Any?> {\n    @Suppress(\"UNCHECKED_CAST\")\n    if (v is Map<*, *>) return v as Map<String, Any?>\n    val j = _jv(v)\n    if (j !is kotlinx.serialization.json.JsonObject) throw IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private fun _nodot(p: String): String {\n    if (p.contains(\".\")) error(\"a dotted path is not supported on a typed map\")\n    return p\n}", "private inline fun <reified R> _oget(o: Any?, p: String, d: R): R { val m = _obj(o); return if (m.containsKey(_nodot(p))) _ret(m[p]) else d }"], "store": ["class Answer(val ok: Boolean, val payload: Map<String, Any?>)\n\ninterface Store {\n    fun persist(op: String, entity: String, data: Any?): Answer\n    fun fetch(entity: String, keep: ((Map<String, Any?>) -> Boolean)?, offset: Number?, limit: Number?): Answer\n}\n\nprivate fun _codePoints(a: String, b: String): Int {\n    val x = a.codePoints().toArray()\n    val y = b.codePoints().toArray()\n    for (i in 0 until minOf(x.size, y.size)) if (x[i] != y[i]) return x[i].compareTo(y[i])\n    return x.size.compareTo(y.size)\n}\n\nprivate fun _stampOrder(a: Map<String, Any?>, b: Map<String, Any?>): Int {\n    val sa = a[\"createdAt\"]\n    val sb = b[\"createdAt\"]\n    if ((sa == null) != (sb == null)) return if (sa != null) -1 else 1\n    if (sa is Number && sb is Number && sa.toDouble() != sb.toDouble()) return sa.toDouble().compareTo(sb.toDouble())\n    if (sa is String && sb is String && sa != sb) return _codePoints(sa, sb)\n    return _codePoints(a[\"id\"].toString(), b[\"id\"].toString())\n}\n\nclass MemoryStore : Store {\n    private val tables = mutabl