out.toString()\n}"], "str/to-number": ["private fun _jsWs(c: Char): Boolean = when (c.code) {\n    in 9..13, 32, 0xA0, 0x1680, in 0x2000..0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000, 0xFEFF -> true\n    else -> false\n}", "private fun _radix(d: String, bits: Int): Double? {\n    if (d.isEmpty()) return null\n    for (c in d) {\n        val v = when (c) {\n            in '0'..'9' -> c - '0'\n            in 'a'..'f' -> c - 'a' + 10\n            in 'A'..'F' -> c - 'A' + 10\n            else -> return null\n        }\n        if (v >= (1 shl bits)) return null\n    }\n    return java.math.BigInteger(d, 1 shl bits).toDouble()\n}", "private fun _toNumber(s: String): Double? {\n    val t = s.trim { _jsWs(it) }\n    if (t.isEmpty()) return 0.0\n    for ((p, bits) in listOf(\"0x\" to 4, \"0X\" to 4, \"0b\" to 1, \"0B\" to 1, \"0o\" to 3, \"0O\" to 3)) {\n        if (t.startsWith(p)) return _radix(t.substring(2), bits)\n    }\n    val neg = t.startsWith(\"-\")\n    val u = if (neg || t.startsWith(\"+\")) t.substring(1) else t\n    if (u == \"Infinity\") return if (neg) Double.NEGATIVE_INFINITY else Double.POSITIVE_INFINITY\n    if (u.isEmpty() || !(u[0] in '0'..'9' || u[0] == '.')) return null\n    if (!u.all { it in '0'..'9' || it == '.' || it == 'e' || it == 'E' || it == '+' || it == '-' }) return null\n    if (!u.any { it in '0'..'9' }) return null\n    val n = u.toDoubleOrNull() ?: return null\n    return if (neg) -n else n\n}"], "str/encode-uri-component": ["private fun _uriEncode(s: String): String {\n    val sb = StringBuilder()\n    for (b in s.toByteArray(Charsets.UTF_8)) {\n        val c = b.toInt() and 0xFF\n        if ((c in 48..57) || (c in 65..90) || (c in 97..122) || \"-_.!~*'()\".indexOf(c.toChar()) >= 0) sb.append(c.toChar())\n        else {\n            sb.append('%')\n            sb.append(\"0123456789ABCDEF\"[c shr 4])\n            sb.append(\"0123456789ABCDEF\"[c and 15])\n        }\n    }\n    return sb.toString()\n}"], "str/decode-uri-component": ["private fun _hexv(c: Char): Int = when (c) {\n    in '0'..'9' -> c - '0'\n    in 'a'..'f' -> c - 'a' + 10\n    in 'A'..'F' -> c - 'A' + 10\n    else -> -1\n}", "private fun _uriDecode(s: String): String? {\n    val out = StringBuilder()\n    val pending = java.io.ByteArrayOutputStream()\n    fun flush(): Boolean {\n        if (pending.size() == 0) return true\n        val decoder = Charsets.UTF_8.newDecoder()\n            .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)\n            .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)\n        try {\n            out.append(decoder.decode(java.nio.ByteBuffer.wrap(pending.toByteArray())).toString())\n        } catch (e: java.nio.charset.CharacterCodingException) {\n            return false\n        }\n        pending.reset()\n        return true\n    }\n    var i = 0\n    while (i < s.length) {\n        val c = s[i]\n        if (c == '%') {\n            val hi = if (i + 1 < s.length) _hexv(s[i + 1]) else -1\n            val lo = if (i + 2 < s.length) _hexv(s[i + 2]) else -1\n            if (hi < 0 || lo < 0) return null\n            pending.write(hi * 16 + lo)\n            i += 3\n        } else {\n            if (!flush()) return null\n            out.append(c)\n            i += 1\n        }\n    }\n    if (!flush()) return null\n    return out.toString()\n}"], "str/uri-component-valid": ["private fun _hexv(c: Char): Int = when (c) {\n    in '0'..'9' -> c - '0'\n    in 'a'..'f' -> c - 'a' + 10\n    in 'A'..'F' -> c - 'A' + 10\n    else -> -1\n}", "private fun _uriDecode(s: String): String? {\n    val out = StringBuilder()\n    val pending = java.io.ByteArrayOutputStream()\n    fun flush(): Boolean {\n        if (pending.size() == 0) return true\n        val decoder = Charsets.UTF_8.newDecoder()\n            .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)\n            .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)\n        try {\n            out.append(decoder.de