rmat/ordinal": ["private fun _wholeL(v: Number): Long {\n    val n = v.toDouble()\n    if (n != Math.floor(n) || Math.abs(n) > 9007199254740991.0) throw IllegalArgumentException(\"expected a whole number, got \" + n)\n    return n.toLong()\n}", "private fun _ordinal(v: Number): String {\n    val num = _wholeL(v)\n    val suffix = if ((num % 10 == 1L && num % 100 == 11L) || (num % 10 == 2L && num % 100 == 12L) || (num % 10 == 3L && num % 100 == 13L)) \"th\"\n        else if (num % 10 == 1L) \"st\" else if (num % 10 == 2L) \"nd\" else if (num % 10 == 3L) \"rd\" else \"th\"\n    return num.toString() + suffix\n}"], "format/plural": ["private fun _wholeL(v: Number): Long {\n    val n = v.toDouble()\n    if (n != Math.floor(n) || Math.abs(n) > 9007199254740991.0) throw IllegalArgumentException(\"expected a whole number, got \" + n)\n    return n.toLong()\n}", "private fun _plural(c: Number, one: String, many: String): String { val n = _wholeL(c); return n.toString() + \" \" + (if (n == 1L) one else many) }"], "json/valid": ["private fun _jvalid(s: String): Boolean = try { kotlinx.serialization.json.Json.parseToJsonElement(s); true } catch (e: Exception) { false }"], "json/parse": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private inline fun <reified R : Any> _jparse(s: String): R?