le() ?: throw IllegalArgumentException(\"missing or non-number field \" + names[i]) }\n}", "private fun _cellMap(x: Double, y: Double): Map<String, Any?> = linkedMapOf<String, Any?>(\"x\" to x, \"y\" to y)", "private fun _wholeI(what: String, n: Double): Long {\n    if (n.isInfinite() || n.isNaN() || n != Math.floor(n)) throw IllegalArgumentException(what + \" \" + n + \" is not a whole number\")\n    return n.toLong()\n}", "private inline fun <reified R> _gLine(a: Any?, b: Any?): R {\n    val p = _fld(a, \"x\", \"y\")\n    val q = _fld(b, \"x\", \"y\")\n    var x0 = _wholeI(\"cell a.x\", p[0])\n    var y0 = _wholeI(\"cell a.y\", p[1])\n    val x1 = _wholeI(\"cell b.x\", q[0])\n    val y1 = _wholeI(\"cell b.y\", q[1])\n    val dx = Math.abs(x1 - x0)\n    val dy = -Math.abs(y1 - y0)\n    val sx = if (x0 < x1) 1L else -1L\n    val sy = if (y0 < y1) 1L else -1L\n    var err = dx + dy\n    val out = mutableListOf<Map<String, Any?>>()\n    while (true) {\n        out.add(_cellMap(x0.toDouble(), y0.toDouble()))\n        if (x0 == x1 && y0 == y1) break\n        val e2 = 2L * err\n        if (e2 >= dy) { err += dy; x0 += sx }\n        if (e2 <= dx) { err += dx; y0 += sy }\n    }\n    return _ret(out)\n}"], "grid/in-bounds": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plai