n-GB\" to _EN, \"en-CA\" to _EN, \"en-AU\" to _EN, \"ja\" to _EN, \"ja-JP\" to _EN,\n        \"de\" to de, \"de-DE\" to de, \"pt\" to de, \"pt-BR\" to de, \"nl\" to de, \"nl-NL\" to de,\n        \"fr\" to fr, \"fr-FR\" to fr, \"es\" to es, \"es-ES\" to es, \"it\" to es, \"it-IT\" to es,\n        \"sl\" to sl, \"sl-SI\" to sl, \"ar\" to ar, \"ru\" to ru, \"ru-RU\" to ru)\n}", "private fun _group(integer: String, loc: _Loc): String {\n    if (integer.length < 3 + loc.minGroup) return integer\n    val first = integer.length % 3\n    val parts = mutableListOf<String>()\n    if (first > 0) parts.add(integer.substring(0, first))\n    var at = first\n    while (at < integer.length) {\n        parts.add(integer.substring(at, at + 3))\n        at += 3\n    }\n    return parts.joinToString(loc.group)\n}\n\nprivate fun _render(n: Double, loc: _Loc, min: Int, max: Int, shift: Int): String {\n    if (n.isNaN()) return \"NaN\"\n    val sign = if (java.lang.Double.doubleToRawLongBits(n) < 0L) loc.minus else \"\"\n    if (n.isInfinite()) return sign + \"\\u221e\"\n    val dec = _Dec.of(Math.abs(n)).shifted(shift).rounded(max)\n    val fraction = dec.fraction(min, max)\n    val integer = _group(dec.integer(), loc)\n    return if (fraction.isEmpty()) sign + integer else sign + integer + loc.decimal + fraction\n}", "private val _CURRENCIES: Map<String, Pair<String, Int>> = mapOf(\n    \"USD\" to Pair(\"$\", 2), \"EUR\" to Pair(\"\\u20ac\", 2), \"GBP\" to Pair(\"\\u00a3\", 2), \"JPY\" to Pair(\"\\u00a5\", 0),\n    \"CNY\" to Pair(\"CN\\u00a5\", 2), \"INR\" to Pair(\"\\u20b9\", 2), \"KRW\" to Pair(\"\\u20a9\", 0), \"CAD\" to Pair(\"CA$\", 2),\n    \"AUD\" to Pair(\"A$\", 2), \"CHF\" to Pair(\"CHF\\u00a0\", 2), \"MXN\" to Pair(\"MX$\", 2), \"BRL\" to Pair(\"R$\", 2),\n    \"SEK\" to Pair(\"SEK\\u00a0\", 2), \"NOK\" to Pair(\"NOK\\u00a0\", 2), \"DKK\" to Pair(\"DKK\\u00a0\", 2), \"PLN\" to Pair(\"PLN\\u00a0\", 2),\n    \"CZK\" to Pair(\"CZK\\u00a0\", 2), \"ZAR\" to Pair(\"ZAR\\u00a0\", 2), \"NZD\" to Pair(\"NZ$\", 2), \"SGD\" to Pair(\"SGD\\u00a0\", 2),\n    \"HKD\" to Pair(\"HK$\", 2), \"AED\" to Pair(\"AED\\u00a0\", 2), \"SAR\" to Pair(\"SAR\\u00a0\", 2), \"ILS\" to Pair(\"\\u20aa\", 2),\n    \"TRY\" to Pair(\"TRY\\u00a0\", 2), \"RUB\" to Pair(\"RUB\\u00a0\", 2), \"KWD\" to Pair(\"KWD\\u00a0\", 3), \"BHD\" to Pair(\"BHD\\u00a0\", 3),\n    \"CLP\" to Pair(\"CLP\\u00a0\", 0), \"VND\" to Pair(\"\\u20ab\", 0))", "private fun _currency(n: Number, code: String, locale: String = \"en-US\"): String? {\n    if (locale != \"en\" && locale != \"en-US\") return null\n    val (symbol, digits) = _CURRENCIES[code] ?: return null\n    val amount = _render(n.toDouble(), _EN, digits, digits, 0)\n    return if (amount.startsWith(\"-\")) \"-\" + symbol + amount.substring(1) else symbol + amount\n}"], "format/bytes": ["private fun _jsNumber(n: Double): String =\n    if (n == Math.floor(n)) n.toLong().toString() else java.math.BigDecimal(java.lang.Double.toString(n)).stripTrailingZeros().toPlainString()\n\nprivate fun _formatBytes(x: Number): String? {\n    val bytes = x.toDouble()\n    if (bytes.isNaN() || bytes.isInfinite() || bytes < 0.0) return null\n    if (bytes == 0.0) return \"0 B\"\n    val units = listOf(\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\")\n    val step = Math.floor(Math.log(bytes) / Math.log(1024.0)).toLong().coerceIn(0L, 5L).toInt()\n    if (step == 0) return _jsNumber(bytes) + \" B\"\n    val value = bytes / Math.pow(1024.0, step.toDouble())\n    val text = if (value >= 10.0) _jsNumber(Math.floor(value + 0.5))\n        else if (value == Math.floor(value)) _jsNumber(value)\n        else java.math.BigDecimal(value).setScale(1, java.math.RoundingMode.HALF_UP).toPlainString()\n    return text + \" \" + units[step]\n}"], "format/list": ["private fun _text(v: Any?): String = when (v) {\n    is String -> v\n    is Boolean -> v.toString()\n    is Long -> v.toString()\n    is Int -> v.toString()\n    is Double -> if (v.isFinite() && v == Math.floor(v)) java.math.BigDecimal(v).toBigInteger().toString() else v.toString()\n    else -> throw IllegalArgumentException(\"expected string, number or boolean\")\n}", "private fun _formatList(a: List<Any?>, style: String): String {\n    val items = a.map { _text(it) }\n    return when (items.size) {\n        0 -> \"\"\n        1 -> items[0]\n        2 -> items[0] + \" \" + style + \" \" + items[1]\n        else -> items.dropLast(1).joinToString(\", \") + \", \" + style + \" \" + items.last()\n    }\n}"], "format/phone": ["private fun _formatPhone(text: String, format: String = \"US\"): String {\n    val digits = text.filter { it in '0'..'9' }\n    return if (format == \"US\" && digits.length == 10) \"(\" + digits.substring(0, 3) + \") \" + digits.substring(3, 6) + \"-\" + digits.substring(6)\n    else if (format == \"US\" && digits.length == 11 && digits.startsWith(\"1\")) \"+1 (\" + digits.substring(1, 4) + \") \" + digits.substring(4, 7) + \"-\" + digits.substring(7)\n    else if (digits.length >= 10) digits.substring(0, 3) + \"-\" + digits.substring(3, 6) + \"-\" + digits.substring(6)\n    else text\n}"], "format/creditCard": ["private fun _creditCard(text: String): String {\n    val digits = text.filter { it in '0'..'9' }\n    if (digits.length <= 4) return digits\n    val groups = mutableListOf<String>()\n    val maskLen = digits.length - 4\n    var i = 0\n    while (i < maskLen) {\n        val g = minOf(maskLen - i, 4)\n        groups.add(\"\\u2022\".repeat(g))\n        i += g\n    }\n    groups.add(digits.substring(digits.length - 4))\n    return groups.joinToString(\" \")\n}"], "format/ordinal": ["private fun _wholeL(v: Number): Long {\n    val n = v.toDouble()\n    if (n != Math.floor(n) || Math.abs(n) > 9007199254740991.0) throw IllegalArgumentException(\"expected a whole number, got \" + n)\n    return n.toLong()\n}", "private fun _ordinal(v: Number): String {\n    val num = _wholeL(v)\n    val suffix = if ((num % 10 == 1L && num % 100 == 11L) || (num % 10 == 2L && num % 100 == 12L) || (num % 10 == 3L && num % 100 == 13L)) \"th\"\n        else if (num % 10 == 1L) \"st\" else if (num % 10 == 2L) \"nd\" else if (num % 10 == 3L) \"rd\" else \"th\"\n    return num.toString() + suffix\n}"], "format/plural": ["private fun _wholeL(v: Number): Long {\n    val n = v.toDouble()\n    if (n != Math.floor(n) || Math.abs(n) > 9007199254740991.0) throw IllegalArgumentException(\"expected a whole number, got \" + n)\n    return n.toLong()\n}", "private fun _plural(c: Number, one: String, many: String): String { val n = _wholeL(c); return n.toString() + \" \" + (if (n == 1L) one else many) }"], "json/valid": ["private fun _jvalid(s: String): Boolean = try { kotlinx.serialization.json.Json.parseToJsonElement(s); true } catch (e: Exception) { false }"], "json/parse": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private inline fun <reified R : Any> _jparse(s: String): R? = try {\n    kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromString(kotlinx.serialization.serializer<R>(), s)\n} catch (e: Exception) {\n    null\n}"], "json/nodes": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is Stri