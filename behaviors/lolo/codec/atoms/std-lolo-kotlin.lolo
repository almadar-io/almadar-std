rayOf(3, 4, 4, 6)\n\nprivate fun _libm_rem_pio2_large(x: DoubleArray, nx: Int, y: DoubleArray, e0: Int, prec: Int): Int {\n    val x1p24 = Double.fromBits(0x4170000000000000L)\n    val x1p_24 = Double.fromBits(0x3e70000000000000L)\n    var fw: Double\n    var n: Int\n    var ih: Int\n    var z: Double\n    val f = DoubleArray(20)\n    val fq = DoubleArray(20)\n    val q = DoubleArray(20)\n    val iq = IntArray(20)\n    val jk = _libm_INIT_JK[prec]\n    val jp = jk\n    val jx = nx - 1\n    var jv = (e0 - 3) / 24\n    if (jv < 0) {\n        jv = 0\n    }\n    var q0 = e0 - 24 * (jv + 1)\n    var j0 = jv - jx\n    val m = jx + jk\n    for (i in 0..m) {\n        f[i] = if (j0 < 0) 0.0 else _libm_IPIO2[j0].toDouble()\n        j0 += 1\n    }\n    for (i in 0..jk) {\n        fw = 0.0\n        for (j in 0..jx) {\n            fw += x[j] * f[jx + i - j]\n        }\n        q[i] = fw\n    }\n    var jz = jk\n    while (true) {\n        var i = 0\n        z = q[jz]\n        var jj = jz\n        while (jj >= 1) {\n            fw = (x1p_24 * z).toInt().toDouble()\n            iq[i] = (z - x1p24 * fw).toInt()\n            z = q[jj - 1] + fw\n            i += 1\n            jj -= 1\n        }\n        z = _libm_scalbn(z, q0)\n        z -= 8.0 * Math.floor(z * 0.125)\n        n = z.toInt()\n        z -= n.toDouble()\n        ih = 0\n        if (q0 > 0) {\n            i = iq[jz - 1] shr (24 - q0)\n            n += i\n            iq[jz - 1] -= i shl (24 - q0)\n            ih = iq[jz - 1] shr (23 - q0)\n        } else if (q0 == 0) {\n            ih = iq[jz - 1] shr 23\n        } else if (z >= 0.5) {\n            ih = 2\n        }\n        if (ih > 0) {\n            n += 1\n            var carry = 0\n            for (ii in 0 until jz) {\n                val j = iq[ii]\n                if (carry == 0) {\n                    if (j != 0) {\n                        carry = 1\n                        iq[ii] = 0x1000000 - j\n                    }\n                } else {\n                  