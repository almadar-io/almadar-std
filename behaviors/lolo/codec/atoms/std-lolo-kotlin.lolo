ng() + (64L shl 20) < ix.toLong()) {\n        0.0\n    } else {\n        _libm_atan(_libm_fabs(y / x))\n    }\n    return when (m) {\n        0 -> z\n        1 -> -z\n        2 -> _libm_PI - (z - _libm_PI_LO)\n        else -> (z - _libm_PI_LO) - _libm_PI\n    }\n}\n\nprivate const val _libm_PIO2_HI = 1.57079632679489655800e+00\nprivate const val _libm_PIO2_LO = 6.12323399573676603587e-17\nprivate const val _libm_PS0 = 1.66666666666666657415e-01\nprivate const val _libm_PS1 = -3.25565818622400915405e-01\nprivate const val _libm_PS2 = 2.01212532134862925881e-01\nprivate const val _libm_PS3 = -4.00555345006794114027e-02\nprivate const val _libm_PS4 = 7.91534994289814532176e-04\nprivate const val _libm_PS5 = 3.47933107596021167570e-05\nprivate const val _libm_QS1 = -2.40339491173441421878e+00\nprivate const val _libm_QS2 = 2.02094576023350569471e+00\nprivate const val _libm_QS3 = -6.88283971605453293030e-01\nprivate const val _libm_QS4 = 7.70381505559019352791e-02\n\nprivate fun _libm_comp_r(z: Double): Double {\n    val p = z * (_libm_PS0 + z * (_libm_PS1 + z * (_libm_PS2 + z * (_libm_PS3 + z * (_libm_PS4 + z * _libm_PS5)))))\n    val q = 1.0 + z * (_libm_QS1 + z * (_libm_QS2 + z * (_libm_QS3 + z * _libm_QS4)))\n    return p / q\n}\n\nprivate fun _libm_asin(x0: Double): Double {\n    var x = x0\n    val hx = _libm_hi(x)\n    val ix = hx and 0x7fffffff\n    if (ix >= 0x3ff00000) {\n        val lx = _libm_lo(x)\n        if (((ix - 0x3ff00000) or lx) == 0) {\n            return x * _libm_PIO2_HI + Double.fromBits(0x3870000000000000L)\n        } else {\n            return 0.0 / (x - x)\n        }\n    }\n    if (ix < 0x3fe00000) {\n        if (ix >= 0x00100000 && ix < 0x3e500000) {\n            return x\n        } else {\n            return x + x * _libm_comp_r(x * x)\n        }\n    }\n    val z = (1.0 - _libm_fabs(x)) * 0.5\n    val s = kotlin.math.sqrt(z)\n    val r = _libm_comp_r(z)\n    if (ix >= 0x3fef3333) {\n        x = _libm_PIO2_HI - (2.0 * (s + s * r) - _libm_PIO2_LO)\n    } else {\n        val f = _libm_setLo(s, 0)\n        val c = (z - f * f) / (s + f)\n        x = 0.5 * _libm_PIO2_HI - (2.0 * s * r - (_libm_PIO2_LO - 2.0 * c) - (0.5 * _libm_PIO2_HI - 2.0 * f))\n    }\n    return if ((hx ushr 31) != 0) -x else x\n}\n\nprivate fun _libm_acos(x: Double): Double {\n    val x1p_120f = Double.fromBits(0x3870000000000000L)\n    val hx = (x.toRawBits() ushr 32).toInt()\n    val ix = hx and 0x7fffffff\n    if (ix >= 0x3ff00000) {\n        val lx = x.toRawBits().toInt()\n        if (((ix - 0x3ff00000) or lx) == 0) {\n            if ((hx ushr 31) != 0) {\n                return 2.0 * _libm_PIO2_HI + x1p_120f\n            }\n            return 0.0\n        }\n        return 0.0 / (x - x)\n    }\n    if (ix < 0x3fe00000) {\n        if (ix <= 0x3c600000) {\n            return _libm_PIO2_HI + x1p_120f\n        }\n        return _libm_PIO2_HI - (x - (_libm_PIO2_LO - x * _libm_comp_r(x * x)))\n    }\n    if ((hx ushr 31) != 0) {\n        val z = (1.0 + x) * 0.5\n        val s = kotlin.math.sqrt(z)\n        val w = _libm_comp_r(z) * s - _libm_PIO2_LO\n        return 2.0 * (_libm_PIO2_HI - (s + w))\n    }\n    val z = (1.0 - x) * 0.5\n    val s = kotlin.math.sqrt(z)\n    val df = Double.fromBits(s.toRawBits() and -4294967296L)\n    val c = (z - df * df) / (s + df)\n    val w = _libm_comp_r(z) * s + c\n    return 2.0 * (df + w)\n}\n\nprivate const val _libm_SPLIT = 134217728.0 + 1.0\n\nprivate fun _libm_sq(x: Double): DoubleArray {\n    val xc = x * _libm_SPLIT\n    val xh = x - xc + xc\n    val xl = x - xh\n    val hi = x * x\n    val lo = xh * xh - hi + 2.0 * xh * xl + xl * xl\n    return doubleArrayOf(hi, lo)\n}\n\nprivate fun _libm_hypot(x0: Double, y0: Double): Double {\n    var x = x0\n    var y = y0\n    val x1p700 = Double.fromBits(0x6bb0000000000000L)\n    val x1p_700 = Double.fromBits(0x1430000000000000L)\n    var uxi = x.toRawBits()\n    var uyi = y.toRawBits()\n    uxi = uxi and Long.MAX_VALUE\n    uyi = uyi and Long.MAX_VALUE\n    if (uxi < uyi) {\n        val uti = uxi\n        uxi = uyi\n        uyi = uti\n    }\n    val ex = uxi ushr 52\n    val ey = uyi ushr 52\n    x = Double.fromBits(uxi)\n    y = Double.fromBits(uyi)\n    if (ey == 0x7ffL) {\n        return y\n    }\n    if (ex == 0x7ffL || uyi == 0L) {\n        return x\n    }\n    if (ex - ey > 64L) {\n        return x + y\n    }\n    var z = 1.0\n    if (ex > 0x3ffL + 510L) {\n        z = x1p700\n        x *= x1p_700\n        y *= x1p_700\n    } else if (ey < 0x3ffL - 450L) {\n        z = x1p_700\n        x *= x1p700\n        y *= x1p700\n    }\n    val a = _libm_sq(x)\n    val b = _libm_sq(y)\n    return z * kotlin.math.sqrt(b[1] + a[1] + b[0] + a[0])\n}", "private var _probState: Int = 0\nprivate var _probStarted: Boolean = false\n\nprivate fun _probSeed(n: Number): Double? {\n    val d = n.toDouble()\n    if (d.isNaN() || d.isInfinite()) _probState = 0 else {\n        val t = if (d < 0.0) Math.ceil(d) else Math.floor(d)\n        var r = t % 4294967296.0\n        if (r < 0.0) r += 4294967296.0\n        _probState = r.toLong().toInt()\n    }\n    _probStarted = true\n    return null\n}\n\nprivate fun _probNext(): Double {\n    if (!_probStarted) {\n        _probState = java.util.concurrent.ThreadLocalRandom.current().nextInt()\n        _probStarted = true\n    }\n    _probState += 0x6D2B79F5\n    var t = _probState\n    t = (t xor (t ushr 15)) * (t or 1)\n    t = t xor (t + ((t xor (t ushr 7)) * (t or 61)))\n    return ((t xor (t ushr 14)).toLong() and 0xFFFFFFFFL).toDouble() / 4294967296.0\n}\n\nprivate fun _probNormal(): Double {\n    val u1 = _probNext()\n    val u2 = _probNext()\n    return Math.sqrt(-2.0 * _libm_log(u1)) * _libm_cos(2.0 * Math.PI * u2)\n}\n\nprivate fun _probGamma(shape: Double): Double {\n    if (shape.isNaN()) return Double.NaN\n    if (shape < 1.0) {\n        val u = _probNext()\n        return _probGamma(shape + 1.0) * _libm_pow(u, 1.0 / shape)\n    }\n    val d = shape - 1.0 / 3.0\n    val c = 1.0 / Math.sqrt(9.0 * d)\n    while (true) {\n        var x: Double\n        var v: Double\n        while (true) {\n            x = _probNormal()\n            v = 1.0 + c * x\n            if (v > 0.0 || v.isNaN()) break\n        }\n        v = v * v * v\n        val u = _probNext()\n        if (u < 1.0 - 0.0331 * (x * x) * (x * x)) return d * v\n        if (_libm_log(u) < 0.5 * x * x + d * (1.0 - v + _libm_log(v))) return d * v\n    }\n}", "private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}", "private fun <T> _probSample(n: Number, f: () -> T): List<T> { val out = mutableListOf<T>(); repeat(_count(n)) { out.add(f()) }; return out }"], "prob/expected-value": ["private fun _probMean(op: String, s: List<Number>): Double {\n    if (s.isEmpty()) throw IllegalArgumentException(op + \": needs at least one sample\")\n    return s.sumOf { it.toDouble() } / s.size\n}"], "prob/variance": ["private fun _probMean(op: String, s: List<Number>): Double {\n    if (s.isEmpty()) throw IllegalArgumentException(op + \": needs at least one sample\")\n    return s.sumOf { it.toDouble() } / s.size\n}", "private fun _probVariance(s: List<Number>): Double {\n    val mean = _probMean(\"prob/variance\", s)\n    return s.sumOf { (it.toDouble() - mean) * (it.toDouble() - mean) } / s.size\n}"], "prob/histogram": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromJsonElement(kotlinx.serialization.serializer<R>(), _jv(v))\n}", "private fun _obj(v: Any?): Map<String, Any?> {\n    @Suppress(\"UNCHECKED_CAST\")\n    if (v is Map<*, *>) return v as Map<String, Any?>\n    val j = _jv(v)\n    if (j !is kotlinx.serialization.json.JsonObject) throw IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private inline fun <reified R> _probHistogram(samplesIn: List<Number>, binsIn: Number): R? {\n    val bins = binsIn.toDouble()\n    if (bins < 1.0 || bins != Math.floor(bins)) return null\n    val samples = samplesIn.map { it.toDouble() }\n    if (samples.isEmpty()) return _ret(linkedMapOf<String, Any?>(\"binEdges\" to listOf<Double>(), \"counts\" to listOf<Double>()))\n    val min = samples.fold(Double.POSITIVE_INFINITY) { a, b -> Math.min(a, b) }\n    val max = samples.fold(Double.NEGATIVE_INFINITY) { a, b -> Math.max(a, b) }\n    val w = (max - min) / bins\n    val width = if (w == 0.0 || w.isNaN()) 1.0 else w\n    val binCount = bins.toInt()\n    val counts = DoubleArray(binCount)\n    for (s in samples) {\n        val f = Math.floor((s - min) / width)\n        val idx = if (f.isNaN() || f < 0.0) 0 else Math.min(f.toLong(), (binCount - 1).toLong()).toInt()\n        counts[idx] += 1.0\n    }\n    return _ret(linkedMapOf<String, Any?>(\"binEdges\" to (0..binCount).map { min + it.toDouble() * width }, \"counts\" to counts.toList()))\n}"], "prob/percentile": ["private fun _probPercentile(samplesIn: List<Number>, pIn: Number): Double? {\n    val p = pIn.toDouble()\n    if (!(p >= 0.0 && p <= 100.0)) return null\n    if (samplesIn.isEmpty()) return null\n    val s = samplesIn.map { it.toDouble() }.sortedWith { a, b -> if (a < b) -1 else if (a > b) 1 else 0 }\n    val idx = (p / 100.0) * (s.size - 1).toDouble()\n    val lo = Math.floor(idx).toInt()\n    val hi = Math.ceil(idx).toInt()\n    if (lo == hi) return s[lo]\n    val frac = idx - lo.toDouble()\n    return s[lo] * (1.0 - frac) + s[hi] * frac\n}"], "prob/credible-interval": ["private fun _probCredible(samplesIn: List<Number>, alphaIn: Number): List<Double>? {\n    val alpha = alphaIn.toDouble()\n    if (!(alpha >= 0.0 && alpha <= 1.0)) return null\n    if (samplesIn.isEmpty()) return null\n    val s = samplesIn.map { it.toDouble() }.sortedWith { a, b -> if (a < b) -1 else if (a > b) 1 else 0 }\n    val last = (s.size - 1).toDouble()\n    val lo = Math.floor((alpha / 2.0) * last).toInt()\n    val hi = Math.ceil((1.0 - alpha / 2.0) * last).toInt()\n    return listOf(s[lo], s[hi])\n}"], "str/find-pattern": ["private const val _RX_SPACE = \"\\\\t\\\\n\\\\x0B\\\\x0C\\\\r \\\\x{A0}\\\\x{1680}\\\\x{2000}-\\\\x{200A}\\\\x{2028}\\\\x{2029}\\\\x{202F}\\\\x{205F}\\\\x{3000}\\\\x{FEFF}\"\n\nprivate const val _RX_SYNTAX = \"\\\\^\\u0024.*+?()[]{}|/\"\n\nprivate val _RX_CATS: Set<String> = setOf(\"L\", \"Lu\", \"Ll\", \"Lt\", \"Lm\", \"Lo\", \"M\", \"Mn\", \"Mc\", \"Me\", \"N\", \"Nd\", \"Nl\", \"No\", \"P\", \"Pc\", \"Pd\", \"Ps\", \"Pe\", \"Pi\", \"Pf\", \"Po\", \"S\", \"Sm\", \"Sc\", \"Sk\", \"So\", \"Z\", \"Zs\", \"Zl\", \"Zp\", \"Cc\", \"Cf\", \"Co\")", "private fun _rxControl(e: Int): Int? = when (if (e < 0x80) e.toChar() else '\\u0000') {\n    'n' -> 10\n    'r' -> 13\n    't' -> 9\n    'f' -> 12\n    'v' -> 11\n    else -> null\n}\n\nprivate fun _rxHexAt(c: IntArray, at: Int, len: Int): Int? {\n    if (at < 0 || at + len > c.size) return null\n    var v = 0\n    for (i in at until at + len) {\n        val d = when (c[i]) {\n            in 48..57 -> c[i] - 48\n            in 97..102 -> c[i] - 87\n            in 65..70 -> c[i] - 55\n            else -> return null\n        }\n        v = v * 16 + d\n    }\n    return v\n}\n\nprivate fun _rxPropEnd(c: IntArray, at: Int): Int? {\n    if (at + 1 >= c.size || c[at + 1] != '{'.code) return null\n    var close = -1\n    for (i in at + 2 until c.size) if (c[i] == '}'.code) { close = i; break }\n    if (close < 0) return null\n    return if (String(c, at + 2, close - (at + 2)) in _RX_CATS) close + 1 else null\n}\n\nprivate class _RxAtom(val ch: Int, val set: String?)\n\nprivate fun _rxClassAtom(c: IntArray, at: Int): Pair<_RxAtom, Int>? {\n    if (at >= c.size) return null\n    val ch = c[at]\n    if (ch == '['.code || ch == ']'.code) return null\n    if (ch != '\\\\'.code) {\n        if ((ch == '&'.code || ch == '~'.code || ch == '-'.code) && at + 1 < c.size && c[at + 1] == ch) return null\n        return Pair(_RxAtom(ch, null), at + 1)\n    }\n    if (at + 1 >= c.size) return null\n    val e = c[at + 1]\n    val ec = if (e < 0x80) e.toChar() else '\\u0000'\n    when (ec) {\n        'd' -> return Pair(_RxAtom(0, \"0-9\"), at + 2)\n        'w' -> return Pair(_RxAtom(0, \"0-9A-Za-z_\"), at + 2)\n        's' -> return Pair(_RxAtom(0, _RX_SPACE), at + 2)\n        'p', 'P' -> {\n            val end = _rxPropEnd(c, at + 1) ?: return null\n            return Pair(_RxAtom(0, \"\\\\\" + String(c, at + 1, end - (at + 1))), end)\n        }\n        '-' -> return Pair(_RxAtom('-'.code, null), at + 2)\n        else -> {}\n    }\n    if (e < 0x80 && _RX_SYNTAX.indexOf(ec) >= 0) return Pair(_RxAtom(e, null), at + 2)\n    val ctl = _rxControl(e)\n    if (ctl != null) return Pair(_RxAtom(ctl, null), at + 2)\n    if (ec == 'x') {\n        val v = _rxHexAt(c, at + 2, 2) ?: return null\n        return Pair(_RxAtom(v, null), at + 4)\n    }\n    if (ec == 'u') {\n        val v = _rxHexAt(c, at + 2, 4) ?: return null\n        return if (v in 0xD800..0xDFFF) null else Pair(_RxAtom(v, null), at + 6)\n    }\n    return null\n}\n\nprivate fun _rxHex(v: Int): String = \"\\\\x{\" + Integer.toHexString(v).uppercase() + \"}\"\n\nprivate fun _rxClass(c: IntArray, start: Int): Pair<String, Int>? {\n    var i = start\n    val out = StringBuilder(\"[\")\n    if (i < c.size && c[i] == '^'.code) { out.append('^'); i += 1 }\n    if (i < c.size && c[i] == ']'.code) return null\n    while (i < c.size) {\n        if (c[i] == ']'.code) { out.append(']'); return Pair(out.toString(), i + 1) }\n        val (first, next) = _rxClassAtom(c, i) ?: return null\n        i = next\n        val rangeFollows = i < c.size && c[i] == '-'.code && !(i + 1 < c.size && c[i + 1] == ']'.code)\n        if (first.set != null) {\n            if (rangeFollows) return null\n            out.append(first.set)\n        } else {\n            out.append(_rxHex(first.ch))\n            if (rangeFollows) {\n                val (second, next2) = _rxClassAtom(c, i + 1) ?: return null\n                if (second.set != null) return null\n                if (first.ch > second.ch) return null\n                out.append(\"-\").append(_rxHex(second.ch))\n                i = next2\n            }\n        }\n    }\n    return null\n}\n\nprivate fun _rxBraces(c: IntArray, at: Int): Pair<String, Int>? {\n    var i = at + 1\n    fun number(): Int? {\n        val from = i\n        while (i < c.size && c[i] in 48..57) i += 1\n        if (i == from) return null\n        return String(c, from, i - from).toIntOrNull()\n    }\n    val low = number() ?: return null\n    if (low > 1000) return null\n    if (i < c.size && c[i] == ','.code) {\n        i += 1\n        val high = number()\n        if (high != null && (high > 1000 || high < low)) return null\n    }\n    if (i >= c.size || c[i] != '}'.code) return null\n    return Pair(String(c, at, i - at + 1), i + 1)\n}\n\nprivate const val _RX_WORD = \"[0-9A-Za-z_]\"\n\nprivate fun _rxTranslate(pattern: String): String? {\n    val c = pattern.codePoints().toArray()\n    val out = StringBuilder()\n    var i = 0\n    var depth = 0\n    var quantifiable = false\n    while (i < c.size) {\n        val ch = c[i]\n        when (ch) {\n            '('.code -> {\n                if (i + 1 < c.size && c[i + 1] == '?'.code) {\n                    if (!(i + 2 < c.size && c[i + 2] == ':'.code)) return null\n                    out.append(\"(?:\")\n                    i += 3\n                } else {\n                    out.append('(')\n                    i += 1\n                }\n                depth += 1\n                quantifiable = false\n            }\n            ')'.code -> {\n                if (depth == 0) return null\n                depth -= 1\n                out.append(')')\n                i += 1\n                quantifiable = true\n            }\n            '|'.code -> { out.append('|'); i += 1; quantifiable = false }\n            '^'.code -> { out.append('^'); i += 1; quantifiable = false }\n            '$'.code -> { out.append(\"\\\\z\"); i += 1; quantifiable = false }\n            '*'.code, '+'.code, '?'.code, '{'.code -> {\n                if (!quantifiable) return null\n                if (ch == '{'.code) {\n                    val (text, next) = _rxBraces(c, i) ?: return null\n                    out.append(text)\n                    i = next\n                } else {\n                    out.appendCodePoint(ch)\n                    i += 1\n                }\n                if (i < c.size && c[i] == '?'.code) { out.append('?'); i += 1 }\n                quantifiable = false\n            }\n            '}'.code, ']'.code -> return null\n            '.'.code -> { out.append(\"[^\\\\n\\\\r\\\\x{2028}\\\\x{2029}]\"); i += 1; quantifiable = true }\n            '['.code -> {\n                val (text, next) = _rxClass(c, i + 1) ?: return null\n                out.append(text)\n                i = next\n                quantifiable = true\n            }\n            '\\\\'.code -> {\n                if (i + 1 >= c.size) return null\n                val e = c[i + 1]\n                val ec = if (e < 0x80) e.toChar() else '\\u0000'\n                when (ec) {\n                    'b' -> out.append(\"(?:(?<=\" + _RX_WORD + \")(?!\" + _RX_WORD + \")|(?<!\" + _RX_WORD + \")(?=\" + _RX_WORD + \"))\")\n                    'B' -> out.append(\"(?:(?<=\" + _RX_WORD + \")(?=\" + _RX_WORD + \")|(?<!\" + _RX_WORD + \")(?!\" + _RX_WORD + \"))\")\n                    'd' -> out.append(\"[0-9]\")\n                    'D' -> out.append(\"[^0-9]\")\n                    'w' -> out.append(_RX_WORD)\n                    'W' -> out.append(\"[^0-9A-Za-z_]\")\n                    's' -> out.append(\"[\" + _RX_SPACE + \"]\")\n                    'S' -> out.append(\"[^\" + _RX_SPACE + \"]\")\n                    'p', 'P' -> {\n                        val end = _rxPropEnd(c, i + 1) ?: return null\n                        out.append('\\\\').append(String(c, i + 1, end - (i + 1)))\n                        i = end\n                        quantifiable = true\n                        continue\n                    }\n                    'x' -> {\n                        out.append(_rxHex(_rxHexAt(c, i + 2, 2) ?: return null))\n                        i += 4\n                        quantifiable = true\n                        continue\n                    }\n                    'u' -> {\n                        val code = _rxHexAt(c, i + 2, 4) ?: return null\n                        if (code in 0xD800..0xDFFF) return null\n                        out.append(_rxHex(code))\n                        i += 6\n                        quantifiable = true\n                        continue\n                    }\n                    else -> {\n                        val ctl = _rxControl(e)\n                        if (e < 0x80 && _RX_SYNTAX.indexOf(ec) >= 0) out.append(_rxHex(e))\n                        else if (ctl != null) out.append(_rxHex(ctl))\n                        else return null\n                    }\n                }\n                i += 2\n                quantifiable = !(ec == 'b' || ec == 'B')\n            }\n            else -> { out.append(_rxHex(ch)); i += 1; quantifiable = true }\n        }\n    }\n    return if (depth == 0) out.toString() else null\n}\n\nprivate fun _rxCompile(pattern: String): java.util.regex.Pattern? {\n    val t = _rxTranslate(pattern) ?: return null\n    return try { java.util.regex.Pattern.compile(t) } catch (e: java.util.regex.PatternSyntaxException) { null }\n}\n\nprivate fun _rxIs(pattern: String, value: String): Boolean = _rxCompile(pattern)?.matcher(value)?.find() ?: false\n\nprivate fun _rxReplace(text: String, pattern: String, rep: String): String? {\n    val re = _rxCompile(pattern) ?: return null\n    val m = re.matcher(text)\n    val out = StringBuilder()\n    var copied = 0\n    var at = 0\n    while (at <= text.length) {\n        if (!m.find(at)) break\n        out.append(text, copied, m.start())\n        out.append(rep)\n        copied = m.end()\n        at = if (m.end() == m.start()) m.end() + (if (m.end() < text.length) Character.charCount(text.codePointAt(m.end())) else 1) else m.end()\n    }\n    out.append(text, copied, text.length)\n    return out.toString()\n}", "private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromJsonElement(kotlinx.serialization.serializer<R>(), _jv(v))\n}", "private fun _obj(v: Any?): Map<String, Any?> {\n    @Suppress(\"UNCHECKED_CAST\")\n    if (v is Map<*, *>) return v as Map<String, Any?>\n    val j = _jv(v)\n    if (j !is kotlinx.serialization.json.JsonObject) throw IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private fun _rxFindAll(text: String, pattern: String, from: Double): List<Map<String, Any?>>? {\n    val re = _rxCompile(pattern) ?: return null\n    val total = text.codePointCount(0, text.length)\n    val fromChars = if (from.isNaN() || from.isInfinite() || from <= 0.0) 0 else Math.floor(from).toLong().coerceAtMost(Int.MAX_VALUE.toLong()).toInt()\n    if (fromChars > total) return listOf()\n    var at = text.offsetByCodePoints(0, fromChars)\n    var charsBefore = fromChars\n    var countedTo = at\n    val m = re.matcher(text)\n    val out = mutableListOf<Map<String, Any?>>()\n    while (at <= text.length) {\n        if (!m.find(at)) break\n        charsBefore += text.codePointCount(countedTo, m.start())\n        countedTo = m.start()\n        val len = text.codePointCount(m.start(), m.end())\n        out.add(linkedMapOf<String, Any?>(\"start\" to charsBefore.toDouble(), \"end\" to (charsBefore + len).toDouble(), \"text\" to text.substring(m.start(), m.end())))\n        at = if (m.end() == m.start()) m.end() + (if (m.end() < text.length) Character.charCount(text.codePointAt(m.end())) else 1) else m.end()\n    }\n    return out\n}", "private inline fun <reified R : Any> _rxFind(text: String, pattern: String, from: Number): R? { val r = _rxFindAll(text, pattern, from.toDouble()) ?: return null; return _ret(r) }"], "math/sin": ["private fun _libm_hi(x: Double): Int = (x.toRawBits() ushr 32).toInt()\n\nprivate fun _libm_lo(x: Double): Int = x.toRawBits().toInt()\n\nprivate fun _libm_setHi(f: Double, hi: Int): Double = Double.fromBits((f.toRawBits() and 0xffffffffL) or (hi.toLong() shl 32))\n\nprivate fun _libm_setLo(f: Double, lo: Int): Double = Double.fromBits((f.toRawBits() and -4294967296L) or (lo.toLong() and 0xffffffffL))\n\nprivate fun _libm_fabs(x: Double): Double = Double.fromBits(x.toRawBits() and Long.MAX_VALUE)\n\nprivate fun _libm_scalbn(x0: Double, n0: Int): Double {\n    var x = x0\n    var n = n0\n    val fExpMax = Double.fromBits(0x7fe0000000000000L)\n    val fExpMin = Double.fromBits(0x0010000000000000L)\n    val fPowSubnorm = Double.fromBits((53L + 1023L) shl 52)\n    if (n > 1023) {\n        x *= fExpMax\n        n -= 1023\n        if (n > 1023) {\n            x *= fExpMax\n            n -= 1023\n            if (n > 1023) {\n                n = 1023\n            }\n        }\n    } else if (n < -1022) {\n        val mul = fExpMin * fPowSubnorm\n        val add = 1022 - 53\n        x *= mul\n        n += add\n        if (n < -1022) {\n            x *= mul\n            n += add\n            if (n < -1022) {\n                n = -1022\n            }\n        }\n    }\n    val scale = Double.fromBits((1023L + n.toLong()) shl 52)\n    return x * scale\n}\n\nprivate const val _libm_S1 = -1.66666666666666324348e-01\nprivate const val _libm_S2 = 8.33333333332248946124e-03\nprivate const val _libm_S3 = -1.98412698298579493134e-04\nprivate const val _libm_S4 = 2.75573137070700676789e-06\nprivate const val _libm_S5 = -2.50507602534068634195e-08\nprivate const val _libm_S6 = 1.58969099521155010221e-10\n\nprivate fun _libm_k_sin(x: Double, y: Double, iy: Int): Double {\n    val z = x * x\n    val w = z * z\n    val r = _libm_S2 + z * (_libm_S3 + z * _libm_S4) + z * w * (_libm_S5 + z * _libm_S6)\n    val v = z * x\n    return if (iy == 0) {\n        x + v * (_libm_S1 + z * r)\n    } else {\n        x - ((z * (0.5 * y - v * r) - y) - v * _libm_S1)\n    }\n}\n\nprivate const val _libm_C1 = 4.16666666666666019037e-02\nprivate const val _libm_C2 = -1.38888888888741095749e-03\nprivate const val _libm_C3 = 2.48015872894767294178e-05\nprivate const val _libm_C4 = -2.75573143513906633035e-07\nprivate const val _libm_C5 = 2.08757232129817482790e-09\nprivate const val _libm_C6 = -1.13596475577881948265e-11\n\nprivate fun _libm_k_cos(x: Double, y: Double): Double {\n    val z = x * x\n    val w = z * z\n    val r = z * (_libm_C1 + z * (_libm_C2 + z * _libm_C3)) + w * w * (_libm_C4 + z * (_libm_C5 + z * _libm_C6)