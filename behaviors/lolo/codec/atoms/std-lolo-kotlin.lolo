600000.0\n        4 -> Math.floor(ts / day) * day\n        5 -> { val days = Math.floor(ts / day).toLong(); val dow = Math.floorMod(days + 3L, 7L); (days - dow).toDouble() * day }\n        6 -> { val d = _tsToDate(ts); _dateToTs(d[0], d[1], 1) }\n        7 -> { val d = _tsToDate(ts); _dateToTs(d[0], (d[1] - 1) / 3 * 3 + 1, 1) }\n        else -> { val d = _tsToDate(ts); _dateToTs(d[0], 1, 1) }\n    }\n}\n\nprivate fun _endOf(ts: Double, unit: Int): Double {\n    val day = 86400000.0\n    return when (unit) {\n        0 -> Math.floor(ts)\n        1 -> (Math.floor(ts / 1000.0) + 1.0) * 1000.0 - 1.0\n        2 -> (Math.floor(ts / 60000.0) + 1.0) * 60000.0 - 1.0\n        3 -> (Math.floor(ts / 3600000.0) + 1.0) * 3600000.0 - 1.0\n        4 -> (Math.floor(ts / day) + 1.0) * day - 1.0\n        5 -> { val days = Math.floor(ts / day).toLong(); val dow = Math.floorMod(days + 3L, 7L); ((days - dow) + 7L).toDouble() * day - 1.0 }\n        6 -> { val d = _tsToDate(ts); if (d[1] >= 12) _dateToTs(d[0] + 1, 1, 1) - 1.0 else _dateToTs(d[0], d[1] + 1, 1) - 1.0 }\n        7 -> { val d = _tsToDate(ts); val next = (d[1] - 1) / 3 * 3 + 4; if (next > 12) _dateToTs(d[0] + 1, next - 12, 1) - 1.0 else _dateToTs(d[0], next, 1) - 1.0 }\n        else -> { val d = _tsToDate(ts); _dateToTs(d[0] + 1, 1, 1) - 1.0 }\n    }\n}\n\nprivate fun _roundAway(x: Double): Double {\n    if (x.isNaN() || x.isInfinite()) return x\n    val f = Math.floor(x)\n    val d = x - f\n    return if (d < 0.5) f else if (d > 0.5) f + 1.0 else if (x > 0.0) f + 1.0 else f\n}", "private fun _nowMs(): Double = System.currentTimeMillis().toDouble()"], "time/relative": ["private const val _DAY_MS = 86400000.0\n\nprivate fun _isLeap(y: Int): Boolean = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0\n\nprivate fun _dim(y: Int, m: Int): Int = when (m) {\n    1, 3, 5, 7, 8, 10, 12 -> 31\n    4, 6, 9, 11 -> 30\n    2 -> if (_isLeap(y)) 29 else 28\n    else -> 30\n}\n\nprivate fun _tsToDate(ts: Double): IntArray {\n    val days = Math.fl