app std-lolo-kotlin [
  version: "1.0.0",
  description: "std-lolo-kotlin — renders .lolo source as Kotlin text, so a learner who reads an exercise written in .lolo can see the same program as Kotlin that compiles against the Android shell's generated models and gives the kernel's answers. It is std-lolo-source with the Kotlin vocabulary in config and nothing else: LOLO_TO_KOTLIN { source, path } answers KOTLIN_RENDERED { text, warnings }, or KOTLIN_RENDER_FAILED { error } when the source cannot be read or the request carries no absolute path (the types come from the kernel checker). Each trait becomes a class holding the entity (a var, rebuilt by copy on every set), state, ports and config, with one on<Event> method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records an Emitted(event, payload) in emitted with the payload built as the shell's generated payload type. The file is in package generated, beside the shell's Entities.kt and Events.kt (written by orb compile -s android), so the entity and payload types need no import. entityNames mirrors the Android shell's KOTLIN_RESERVED_TYPES table (orbital-shell-android backend.rs): an entity named like a Kotlin or Compose type is generated with the suffix Entity (Pair is PairEntity), and the constructor uses that name. Every number is a Double, as in the kernel; a length is a Long or a Double as the checker types it. Kernel answers that are null (a division by zero, nth past the end, a square root of a negative number) are nullable values, and default is an elvis, written once as a small helper. String length and slicing count code points. An operator with no Kotlin template is a named warning and a stub that throws when run; persist, fetch, notify, navigate and call-service are invoked on the ports function and each is listed in warnings; render-ui is a comment. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-kotlin"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloKotlinOrbital {
  entity LoloKotlinRun [runtime] {
    id : string!
  }

  trait LoloKotlin = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_KOTLIN
      SOURCE_RENDERED: KOTLIN_RENDERED
      SOURCE_RENDER_FAILED: KOTLIN_RENDER_FAILED
    }
    config {
      language: "Kotlin"
      requiresTypes: false
      operators: { "object/get#2": "_get({{0}}, {{1}})", "/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "=": "_eq({{0}}, {{1}})", "==": "_eq({{0}}, {{1}})", "!=": "(!_eq({{0}}, {{1}}))", "default": "_default({{0}}, {{1}})", "as": "{{0}}", "list": "listOf({{*}})", "str/len": "_strLen({{0}}).toDouble()", "str/upper": "{{0}}.uppercase()", "str/lower": "{{0}}.lowercase()", "str/trim": "{{0}}.trim()", "str/trimStart": "{{0}}.trimStart()", "str/trimEnd": "{{0}}.trimEnd()", "str/capitalize": "_capitalize({{0}})", "str/split": "_split({{0}}, {{1}})", "str/join": "_join({{0}}, {{1}})", "str/concat": "_concat({{*}})", "str/includes": "{{0}}.contains({{1}})", "str/startsWith": "{{0}}.startsWith({{1}})", "str/endsWith": "{{0}}.endsWith({{1}})", "str/replace": "{{0}}.replaceFirst({{1}}, {{2}})", "str/replaceAll": "{{0}}.replace({{1}}, {{2}})", "str/repeat": "{{0}}.repeat(_count({{1}}))", "str/reverse": "StringBuilder({{0}}).reverse().toString()", "str/slice#2": "_strSlice({{0}}, {{1}})", "str/slice#3": "_strSlice({{0}}, {{1}}, {{2}})", "str/padStart#2": "_padStart({{0}}, {{1}})", "str/padStart#3": "_padStart({{0}}, {{1}}, {{2}})", "str/padEnd#2": "_padEnd({{0}}, {{1}})", "str/padEnd#3": "_padEnd({{0}}, {{1}}, {{2}})", "str/truncate#2": "_truncate({{0}}, {{1}})", "str/truncate#3": "_truncate({{0}}, {{1}}, {{2}})", "str/to-int": "_toInt({{0}})", "array/len": "{{0}}.size.toDouble()", "array/avg#1": "_avg({{0}})", "array/max#1": "_amax({{0}})", "array/min#1": "_amin({{0}})", "array/first": "_first({{0}})", "array/last": "_last({{0}})", "array/nth": "_nth({{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}})", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice({{0}}, {{1}})", "array/slice#3": "_slice({{0}}, {{1}}, {{2}})", "array/take": "{{0}}.take(_count({{1}}))", "array/drop": "{{0}}.drop(_count({{1}}))", "array/takeLast": "{{0}}.takeLast(_count({{1}}))", "array/dropLast": "{{0}}.dropLast(_count({{1}}))", "array/append": "_append({{0}}, {{1}})", "array/prepend": "_prepend({{0}}, {{1}})", "array/includes": "{{0}}.contains({{1}})", "array/indexOf": "_indexOf({{0}}, {{1}})", "array/reverse": "{{0}}.reversed()", "array/unique": "{{0}}.distinct()", "array/flatten": "{{0}}.flatten()", "array/zip": "{{0}}.zip({{1}}).map { listOf(it.first, it.second) }", "array/sort#1": "_sort({{0}})", "array/reduce": "{{0}}.fold({{1}}, {{2}})", "array/filter": "{{0}}.filter({{1}})", "array/reject": "{{0}}.filterNot({{1}})", "array/find": "{{0}}.firstOrNull({{1}})", "array/findIndex": "{{0}}.indexOfFirst({{1}}).toDouble()", "math/abs": "Math.abs(({{0}}).toDouble())", "math/max": "maxOf({{*}})", "math/min": "minOf({{*}})", "math/round#1": "_round({{0}})", "math/round#2": "_round({{0}}, {{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "Math.signum(({{0}}).toDouble())", "math/clamp": "Math.min(Math.max(({{0}}).toDouble(), ({{1}}).toDouble()), ({{2}}).toDouble())", "math/ceil": "Math.ceil(({{0}}).toDouble())", "math/floor": "Math.floor(({{0}}).toDouble())", "math/sin": "Math.sin(({{0}}).toDouble())", "math/cos": "Math.cos(({{0}}).toDouble())", "math/tan": "Math.tan(({{0}}).toDouble())", "math/atan": "Math.atan(({{0}}).toDouble())", "math/atan2": "Math.atan2(({{0}}).toDouble(), ({{1}}).toDouble())", "math/hypot": "Math.hypot(({{0}}).toDouble(), ({{1}}).toDouble())", "validate/required": "_required({{0}})", "validate/length": "(_strLen({{0}}).toDouble() == ({{1}}).toDouble())", "validate/minLength": "(_strLen({{0}}).toDouble() >= ({{1}}).toDouble())", "validate/maxLength": "(_strLen({{0}}).toDouble() <= ({{1}}).toDouble())", "validate/min": "(({{0}}).toDouble() >= ({{1}}).toDouble())", "validate/max": "(({{0}}).toDouble() <= ({{1}}).toDouble())", "validate/range": "(({{0}}).toDouble() in ({{1}}).toDouble()..({{2}}).toDouble())", "validate/oneOf": "{{1}}.contains({{0}})", "validate/equals": "_eq({{0}}, {{1}})" }
      unary: { "-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range({{0}})", "array/sum": "_sum({{0}})", "array/count": "{{0}}.size.toDouble()", "array/sort": "_sort({{0}})", "math/round": "_round({{0}})", "array/concat": "{{0}}" }
      infix: { "+": "+", "-": "-", "*": "*", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||", "array/concat": "+" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "{{src}}.map { {{vars}} -> {{body}} }", "array/some": "{{src}}.any { {{vars}} -> {{body}} }", "array/every": "{{src}}.all { {{vars}} -> {{body}} }", "array/count": "{{src}}.count { {{vars}} -> {{body}} }.toDouble()" }
      lambdaForm: "{ {{params}} -> {{body}} }"
      indexedSource: "{{src}}.mapIndexed { i_, x_ -> Pair(i_.toDouble(), x_) }"
      indexedVars: "({{index}}, {{item}})"
      unsupportedForm: "_unsupported({{op}})"
      helpers: { "object/get": ["private fun <V> _get(o: Map<String, V>, p: String): V? {\n    if (p.contains(\".\")) error(\"object/get: a dotted path is not supported on a typed map\")\n    return o[p]\n}"], "store": ["class Answer(val ok: Boolean, val payload: Map<String, Any?>)\n\ninterface Store {\n    fun persist(op: String, entity: String, data: Any?): Answer\n    fun fetch(entity: String, keep: ((Map<String, Any?>) -> Boolean)?): Answer\n}\n\nprivate fun _codePoints(a: String, b: String): Int {\n    val x = a.codePoints().toArray()\n    val y = b.codePoints().toArray()\n    for (i in 0 until minOf(x.size, y.size)) if (x[i] != y[i]) return x[i].compareTo(y[i])\n    return x.size.compareTo(y.size)\n}\n\nprivate fun _stampOrder(a: Map<String, Any?>, b: Map<String, Any?>): Int {\n    val sa = a[\"createdAt\"]\n    val sb = b[\"createdAt\"]\n    if ((sa == null) != (sb == null)) return if (sa != null) -1 else 1\n    if (sa is Number && sb is Number && sa.toDouble() != sb.toDouble()) return sa.toDouble().compareTo(sb.toDouble())\n    if (sa is String && sb is String && sa != sb) return _codePoints(sa, sb)\n    return _codePoints(a[\"id\"].toString(), b[\"id\"].toString())\n}\n\nclass MemoryStore : Store {\n    private val tables = mutableMapOf<String, MutableList<Pair<String, MutableMap<String, Any?>>>>()\n    private var minted = 0\n\n    override fun persist(op: String, entity: String, data: Any?): Answer {\n        val rows = tables.getOrPut(entity) { mutableListOf() }\n        if (op == \"create\" && data is Map<*, *>) {\n            val row = data.entries.associate { (k, v) -> k.toString() to v }.toMutableMap()\n            val given = row[\"id\"]\n            val id = if (given is String && given.isNotEmpty()) given else {\n                minted += 1\n                entity + \"-\" + minted\n            }\n            row[\"id\"] = id\n            rows.add(id to row)\n            return Answer(true, row.toMap())\n        }\n        val key = when (data) {\n            is String -> data\n            is Map<*, *> -> data[\"id\"]?.toString() ?: \"\"\n            else -> \"\"\n        }\n        val pos = rows.indexOfFirst { it.first == key }\n        if (pos < 0) return Answer(false, mapOf(\"error\" to entity + \" \" + key + \" not found\", \"code\" to \"not-found\"))\n        if (op == \"delete\") {\n            rows.removeAt(pos)\n            return Answer(true, mapOf(\"id\" to key, \"deleted\" to true))\n        }\n        if (data is Map<*, *>) for ((k, v) in data) rows[pos].second[k.toString()] = v\n        return Answer(true, rows[pos].second.toMap())\n    }\n\n    override fun fetch(entity: String, keep: ((Map<String, Any?>) -> Boolean)?): Answer {\n        val rows = (tables[entity] ?: mutableListOf()).map { it.second.toMap() }.filter { keep?.invoke(it) ?: true }.sortedWith(::_stampOrder)\n        return Answer(true, mapOf(\"data\" to rows, \"totalCount\" to rows.size))\n    }\n}"], "router": ["private val _routerJson = kotlinx.serialization.json.Json { encodeDefaults = true; ignoreUnknownKeys = true }\n\nprivate fun _json(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    Unit -> kotlinx.serialization.json.JsonObject(emptyMap())\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _json(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _json(it) })\n    else -> _routerJson.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}\n\nprivate inline fun <reified T> _decode(value: kotlinx.serialization.json.JsonElement): T =\n    _routerJson.decodeFromJsonElement(kotlinx.serialization.serializer<T>(), value)\n\nclass _RouterEntry(\n    val key: String,\n    val trait: Any,\n    val state: () -> String,\n    val entity: () -> kotlinx.serialization.json.JsonElement,\n    val count: () -> Int,\n    val from: (Int) -> List<Triple<String, kotlinx.serialization.json.JsonElement, Boolean>>,\n)\n\nclass _RouterItem(\n    val target: String,\n    val event: String,\n    val payload: kotlinx.serialization.json.JsonElement,\n    val source: kotlinx.serialization.json.JsonElement,\n    val guard: ((kotlinx.serialization.json.JsonElement) -> Boolean)?,\n    val fans: Boolean,\n    val completion: Boolean,\n)\n\nclass _RouterRow(\n    val source: String,\n    val event: String,\n    val target: String,\n    val trigger: String,\n    val guard: ((kotlinx.serialization.json.JsonElement) -> Boolean)?,\n    val mapping: ((kotlinx.serialization.json.JsonElement) -> kotlinx.serialization.json.JsonElement)?,\n)\n\nopen class _Router {\n    val entries = mutableListOf<_RouterEntry>()\n    val handles = mutableMapOf<String, Map<String, List<String>>>()\n    val rows = mutableListOf<_RouterRow>()\n    val log = mutableListOf<Triple<String, String, kotlinx.serialization.json.JsonElement>>()\n\n    fun add(\n        key: String,\n        trait: Any,\n        state: () -> String,\n        entity: () -> kotlinx.serialization.json.JsonElement,\n        count: () -> Int,\n        from: (Int) -> List<Triple<String, kotlinx.serialization.json.JsonElement, Boolean>>,\n    ) {\n        entries.add(_RouterEntry(key, trait, state, entity, count, from))\n    }\n\n    fun row(\n        source: String,\n        event: String,\n        target: String,\n        trigger: String,\n        guard: ((kotlinx.serialization.json.JsonElement) -> Boolean)?,\n        mapping: ((kotlinx.serialization.json.JsonElement) -> kotlinx.serialization.json.JsonElement)?,\n    ) {\n        rows.add(_RouterRow(source, event, target, trigger, guard, mapping))\n    }\n\n    fun entry(key: String): _RouterEntry? = entries.firstOrNull { it.key == key }\n\n    fun trait(key: String): Any? = entry(key)?.trait\n\n    open fun deliver(target: String, event: String, payload: kotlinx.serialization.json.JsonElement) {}\n\n    private fun targets(source: String, event: String, payload: kotlinx.serialization.json.JsonElement, completion: Boolean): List<_RouterItem> =\n        rows.filter { it.source == source && it.event == event }.map {\n            _RouterItem(it.target, it.trigger, it.mapping?.invoke(payload) ?: payload, payload, it.guard, false, completion)\n        }\n\n    fun dispatch(trait: String, event: String, payload: kotlinx.serialization.json.JsonElement) {\n        val queue = ArrayDeque(listOf(_RouterItem(trait, event, payload, payload, null, true, false)))\n        val seen = mutableSetOf<String>()\n        var steps = 0\n        while (queue.isNotEmpty()) {\n            val item = queue.removeFirst()\n            val e = entry(item.target) ?: continue\n            val key = listOf(item.target, item.event, e.state(), item.payload.toString(), e.entity().toString()).joinToString(\"\\u001f\")\n            if (!item.completion && key in seen) continue\n            val g = item.guard\n            if (g != null && !g(item.source)) continue\n            if (steps >= 2000) break\n            steps += 1\n            seen.add(key)\n            val n = e.count()\n            deliver(item.target, item.event, item.payload)\n            val fanned = if (item.fans) targets(item.target, item.event, item.payload, false).toMutableList() else mutableListOf()\n            val own = mutableListOf<_RouterItem>()\n            val newState = e.state()\n            for ((ev, out, completion) in e.from(n)) {\n                log.add(Triple(item.target, ev, out))\n                if (handles[item.target]?.get(newState)?.contains(ev) == true) {\n                    own.add(_RouterItem(item.target, ev, out, out, null, false, completion))\n                }\n                fanned.addAll(targets(item.target, ev, out, completion))\n            }\n            queue.addAll(0, own)\n            queue.addAll(fanned)\n        }\n    }\n}"], "/": ["private fun _div(a: Number, b: Number): Double? = if (b.toDouble() == 0.0) null else a.toDouble() / b.toDouble()"], "%": ["private fun _mod(a: Number, b: Number): Double? = if (b.toDouble() == 0.0) null else a.toDouble() % b.toDouble()"], "math/mod": ["private fun _mod(a: Number, b: Number): Double? = if (b.toDouble() == 0.0) null else a.toDouble() % b.toDouble()"], "=": ["private fun _eq(a: Any?, b: Any?): Boolean = if (a is Number && b is Number) a.toDouble() == b.toDouble() else a == b"], "==": ["private fun _eq(a: Any?, b: Any?): Boolean = if (a is Number && b is Number) a.toDouble() == b.toDouble() else a == b"], "!=": ["private fun _eq(a: Any?, b: Any?): Boolean = if (a is Number && b is Number) a.toDouble() == b.toDouble() else a == b"], "default": ["private fun <T : Any> _default(v: T?, d: T): T = v ?: d"], "str/len": ["private fun _strLen(s: String): Int = s.codePointCount(0, s.length)"], "str/capitalize": ["private fun _capitalize(s: String): String {\n    if (s.isEmpty()) return s\n    val n = s.offsetByCodePoints(0, 1)\n    return s.substring(0, n).uppercase() + s.substring(n).lowercase()\n}"], "str/split": ["private fun _split(s: String, d: String): List<String> =\n    if (d == \"\") s.codePoints().toArray().map { String(Character.toChars(it)) } else s.split(d)"], "str/join": ["private fun _join(a: List<Any?>, d: String): String = a.joinToString(d) { _text(it) }", "private fun _text(v: Any?): String = when (v) {\n    is String -> v\n    is Boolean -> v.toString()\n    is Long -> v.toString()\n    is Int -> v.toString()\n    is Double -> if (v.isFinite() && v == Math.floor(v)) java.math.BigDecimal(v).toBigInteger().toString() else v.toString()\n    else -> throw IllegalArgumentException(\"expected string, number or boolean\")\n}"], "str/concat": ["private fun _concat(vararg v: Any?): String = v.joinToString(\"\") { _text(it) }", "private fun _text(v: Any?): String = when (v) {\n    is String -> v\n    is Boolean -> v.toString()\n    is Long -> v.toString()\n    is Int -> v.toString()\n    is Double -> if (v.isFinite() && v == Math.floor(v)) java.math.BigDecimal(v).toBigInteger().toString() else v.toString()\n    else -> throw IllegalArgumentException(\"expected string, number or boolean\")\n}"], "str/repeat": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}"], "str/slice": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _strSlice(s: String, a: Number, b: Number? = null): String {\n    val n = s.codePointCount(0, s.length)\n    val x = _whole(a)\n    val y = if (b == null) n else _whole(b)\n    val from = if (x < 0) maxOf(n + x, 0) else minOf(x, n)\n    val to = if (y < 0) maxOf(n + y, 0) else minOf(y, n)\n    if (to <= from) return \"\"\n    return s.substring(s.offsetByCodePoints(0, from), s.offsetByCodePoints(0, to))\n}"], "str/padStart": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}", "private fun _strLen(s: String): Int = s.codePointCount(0, s.length)", "private fun _padUnit(p: String): String {\n    if (p.codePointCount(0, p.length) != 1) throw IllegalArgumentException(\"expected a single padding character, got \" + p)\n    return p\n}", "private fun _padStart(s: String, n: Number, p: String = \" \"): String {\n    val k = _count(n) - _strLen(s)\n    return if (k <= 0) s else _padUnit(p).repeat(k) + s\n}"], "str/padEnd": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}", "private fun _strLen(s: String): Int = s.codePointCount(0, s.length)", "private fun _padUnit(p: String): String {\n    if (p.codePointCount(0, p.length) != 1) throw IllegalArgumentException(\"expected a single padding character, got \" + p)\n    return p\n}", "private fun _padEnd(s: String, n: Number, p: String = \" \"): String {\n    val k = _count(n) - _strLen(s)\n    return if (k <= 0) s else s + _padUnit(p).repeat(k)\n}"], "str/truncate": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}", "private fun _strLen(s: String): Int = s.codePointCount(0, s.length)", "private fun _strSlice(s: String, a: Number, b: Number? = null): String {\n    val n = s.codePointCount(0, s.length)\n    val x = _whole(a)\n    val y = if (b == null) n else _whole(b)\n    val from = if (x < 0) maxOf(n + x, 0) else minOf(x, n)\n    val to = if (y < 0) maxOf(n + y, 0) else minOf(y, n)\n    if (to <= from) return \"\"\n    return s.substring(s.offsetByCodePoints(0, from), s.offsetByCodePoints(0, to))\n}", "private fun _truncate(s: String, n: Number, suffix: String = \"...\"): String =\n    if (_strLen(s) <= _count(n)) s else _strSlice(s, 0.0, n) + suffix"], "str/to-int": ["private fun _toInt(s: String): Double? =\n    if (Regex(\"[+-]?[0-9]+\").matches(s)) s.toLongOrNull()?.toDouble() else null"], "array/avg": ["private fun _avg(a: List<Number>): Double? = if (a.isEmpty()) null else a.sumOf { it.toDouble() } / a.size"], "array/max": ["private fun _amax(a: List<Number>): Double? = a.maxOfOrNull { it.toDouble() }"], "array/min": ["private fun _amin(a: List<Number>): Double? = a.minOfOrNull { it.toDouble() }"], "array/first": ["private fun <T> _first(a: List<T>): T? = a.firstOrNull()"], "array/last": ["private fun <T> _last(a: List<T>): T? = a.lastOrNull()"], "array/nth": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun <T> _nth(a: List<T>, i: Number): T? {\n    val k = _whole(i)\n    if (k < 0) throw IllegalArgumentException(\"nth: index \" + k + \" is not a whole number from 0\")\n    return a.getOrNull(k)\n}"], "array/range": ["private fun _range(a: Number, b: Number? = null, step: Number = 1.0): List<Double> {\n    val from = if (b == null) 0.0 else a.toDouble()\n    val to = if (b == null) a.toDouble() else b.toDouble()\n    val st = step.toDouble()\n    if (st == 0.0 || st.isNaN() || st.isInfinite()) throw IllegalArgumentException(\"range: step 0 must be a non-zero finite number\")\n    val out = mutableListOf<Double>()\n    var x = from\n    while (if (st > 0) x < to else x > to) {\n        out.add(x)\n        x += st\n    }\n    return out\n}"], "array/slice": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun <T> _slice(a: List<T>, s: Number, e: Number? = null): List<T> {\n    val from = _whole(s)\n    val to = if (e == null) a.size else _whole(e)\n    if (from < 0 || to < 0) throw IllegalArgumentException(\"slice: not a whole number from 0\")\n    val end = minOf(to, a.size)\n    return if (from >= end) listOf() else a.subList(from, end).toList()\n}"], "array/take": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}"], "array/drop": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}"], "array/takeLast": ["private fun _whole(n: Number): Int {\n    val d = n.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < -2147483648.0 || d > 2147483647.0) throw IllegalArgumentException(\"expected a whole number, got \" + d)\n    return d.toInt()\n}", "private fun _count(n: Number): Int {\n    val k = _whole(n)\n    if (k < 0) throw IllegalArgumentException(\"expected a whole number from 0, got \" + k)\n    return k\n}"], "array/dropLast": ["private fun _whole(n: Number): Int {\n    val d 