 text.substring(from, from + len).toInt()\n    }\n    if (text.length < 8 || text[4] != '-' || text[7] != '-') return null\n    val y = num(0, 4) ?: return null\n    val mo = num(5, 2) ?: return null\n    val d = num(8, 2) ?: return null\n    if (mo < 1 || mo > 12 || d < 1 || d > _dim(y, mo)) return null\n    var ms = _dateToTs(y, mo, d)\n    if (text.length == 10) return _Mo(ms, true)\n    if (text.length < 14 || text[10] != 'T' || text[13] != ':') return null\n    val hour = num(11, 2) ?: return null\n    val minute = num(14, 2) ?: return null\n    if (hour > 23 || minute > 59) return null\n    ms += hour * 3600000.0 + minute * 60000.0\n    var at = 16\n    if (at < text.length && text[at] == ':') {\n        val second = num(at + 1, 2) ?: return null\n        if (second > 59) return null\n        ms += second * 1000.0\n        at += 3\n        if (at < text.length && text[at] == '.') {\n            val start = at + 1\n            var end = start\n            while (end < text.length && text[end] in '0'..'9') end += 1\n            if (end == start) return null\n            ms += text.substring(start, end).padEnd(3, '0').substring(0, 3).toLong().toDouble()\n            at = end\n        }\n    }\n    if (at > text.length) return null\n    val zone = text.substring(at)\n    if (zone == \"Z\") return _Mo(ms, false)\n    if (zone.length == 6 && (zone[0] == '+' || zone[0] == '-') && zone[3] == ':') {\n        val oh = num(at + 1, 2) ?: return null\n        val om = num(at + 4, 2) ?: return null\n        if (oh > 23 || om > 59) return null\n        val offset = (oh * 60L + om) * 60000.0\n        return _Mo(if (zone[0] == '-') ms + offset else ms - offset, false)\n    }\n    return null\n}\n\nprivate fun _moment(text: String): _Mo = _parseIso(text) ?: throw IllegalArgumentException(\"expected date or datetime (ISO-8601 text), got \" + text)\n\nprivate fun _utcParts(ms: Double): IntArray {\n    if (ms.isNaN() || ms.isInfinite()) throw IllegalArgumentException(ms.toString() + \" ms is outside the years 0000 to 9999\")\n    val t = Math.floor(ms).toLong()\n    val days = Math.floorDiv(t, 86400000L)\n    val rem = Math.floorMod(t, 86400000L)\n    val d = _tsToDate(days.toDouble() * 86400000.0)\n    if (d[0] < 0 || d[0] > 9999) throw IllegalArgumentException(ms.toString() + \" ms is outside the years 0000 to 9999\")\n    val wd = Math.floorMod(days + 4L, 7L).toInt()\n    return intArrayOf(d[0], d[1], d[2], (rem / 3600000L).toInt(), ((rem / 60000L) % 60L).toInt(), ((rem / 1000L) % 60L).toInt(), (rem % 1000L).toInt(), wd)\n}\n\nprivate fun _render(ms: Double, dateOnly: Boolean): String {\n    val p = _utcParts(ms)\n    return if (dateOnly) String.format(\"%04d-%02d-%02d\", p[0], p[1], p[2])\n    else String.format(\"%04d-%02d-%02dT%02d:%02d:%02d.%03dZ\", p[0], p[1], p[2], p[3], p[4], p[5], p[6])\n}\n\nprivate fun _unit(u: String): Int = when (u) {\n    \"ms\", \"millisecond\", \"milliseconds\" -> 0\n    \"s\", \"second\", \"seconds\" -> 1\n    \"m\", \"minute\", \"minutes\" -> 2\n    \"h\", \"hour\", \"hours\" -> 3\n    \"d\", \"day\", \"days\" -> 4\n    \"w\", \"week\", \"weeks\" -> 5\n    \"month\", \"months\" -> 6\n    \"quarter\", \"quarters\" -> 7\n    \"year\", \"years\" -> 8\n    else -> throw IllegalArgumentException(\"expected time unit, got \" + u)\n}\n\nprivate fun _fixedMs(unit: Int): Double? = when (unit) {\n    0 -> 1.0\n    1 -> 1000.0\n    2 -> 60000.0\n    3 -> 3600000.0\n    4 -> 86400000.0\n    5 -> 604800000.0\n    else -> null\n}\n\nprivate fun _belowDay(unit: Int): Boolean = unit <= 3\n\nprivate fun _addMonths(ts: Double, months: Long): Double {\n    val d = _tsToDate(ts)\n    val tod = ts - _dateToTs(d[0], d[1], d[2])\n    val total = d[0].toLong() * 12L + (d[1] - 1).toLong() + months\n    val ny = Math.floorDiv(total, 12L).toInt()\n    val nm = Math.floorMod(total, 12L).toInt() + 1\n    return _dateToTs(ny, nm, minOf(d[2], _dim(ny, nm))) + tod\n}\n\nprivate fun _wholeMonths(from: Double, to: Double): Long {\n    val