IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private fun _treeIndex(value: Any?, headsIn: List<String>, opts: Map<String, Any?>): Map<String, List<Any?>> {\n    val found = LinkedHashMap<String, MutableList<Any?>>()\n    for (h in headsIn) found.getOrPut(h) { mutableListOf() }\n    val heads = found.keys.toList()\n    val prefixes = mutableListOf<String>()\n    val objectKeys = mutableListOf<String>()\n    for ((name, target) in listOf(\"objects\" to objectKeys, \"prefixes\" to prefixes)) {\n        val items = opts[name] ?: continue\n        if (items !is List<*>) throw IllegalArgumentException(\"tree/index: options.\" + name + \" must be a list of strings\")\n        for (item in items) {\n            if (item !is String) throw IllegalArgumentException(\"tree/index: options.\" + name + \" must be a list of strings\")\n            if (!target.contains(item)) {\n                target.add(item)\n                found.getOrPut(item) { mutableListOf() }\n            }\n        }\n    }\n    var visited = 0\n    val stack = ArrayDeque<Pair<Any?, String>>()\n    stack.addLast(Pair(_plain(_jv(value)), \"\"))\n    while (stack.isNotEmpty()) {\n        val (node, path) = stack.removeLast()\n        val at = visited\n        visited += 1\n        val hit = { linkedMapOf<String, Any?>(\"path\" to path, \"node\" to node, \"at\" to at.toDouble()) }\n        when (node) {\n            is List<*> -> {\n                val head = node.firstOrNull()\n                if (head is String && heads.contains(head)) found[head]!!.add(hit())\n                for (i in node.indices.reversed()) stack.addLast(Pair(node[i], path + \"[\" + i + \"]\"))\n            }\n            is Map<*, *> -> {\n                for (key in objectKeys) if (node.containsKey(key)) found[key]!!.add(hit())\n                for ((k, v) in node.entries.reversed()) stack.addLast(Pair(v, if (path.isEmpty()) k.toString() else path + \".\" + k))\n            }\n            is String -> {\n                val p = prefixes.firstOrNull { node.startsWith(it) }\n                if (p != null) found[p]!!.add(hit())\n            }\n        }\n    }\n    return found\n}"], "prob/seed": ["private var _probState: Int = 0\nprivate var _probStarted: Boolean = false\n\nprivate fun _probSeed(n: Number): Double? {\n    val d = n.toDouble()\n    if (d.isNaN() || d.isInfinite()) _probState = 0 else {\n        val t = if (d < 0.0) Math.ceil(d) else Math.floor(d)\n        var r = t % 4294967296.0\n        if (r < 0.0) r += 4294967296.0\n        _probState = r.toLong().toInt()\n    }\n    _probStarted = true\n    return null\n}\n\nprivate fun _probNext(): Double {\n    if (!_probStarted) {\n        _probState = java.util.concurrent.ThreadLocalRandom.current().nextInt()\n        _probStarted = true\n    }\n    _probState += 0x6D2B79F5\n    var t = _probState\n    t = (t xor (t ushr 15)) * (t or 1)\n    t = t xor (t + ((t xor (t ushr 7)) * (t or 61)))\n    return ((t xor (t ushr 14)).toLong() and 0xFFFFFFFFL).toDouble() / 4294967296.0\n}\n\nprivate fun _probNormal(): Double {\n    val u1 = _probNext()\n    val u2 = _probNext()\n    return Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2)\n}\n\nprivate fun _probGamma(shape: Double): Double {\n    if (shape.isNaN()) return Double.NaN\n    if (shape < 1.0) {\n        val u = _probNext()\n        return _probGamma(shape + 1.0) * Math.pow(u, 1.0 / shape)\n    }\n    val d = shape - 1.0 / 3.0\n    val c = 1.0 / Math.sqrt(9.0 * d)\n    while (true) {\n        var x: Double\n        var v: Double\n        while (true) {\n            x = _probNormal()\n            v = 1.0 + c * x\n            if (v > 0.0 || v.isNaN()) break\n        }\n        v = v * v * v\n        val u = _probNext()\n        if (u < 1.0 - 0.0331 * (x * x) * (x * x)) return d * v\n        if (Math.log(u) < 0.5 * x * x + d * (1.0 - v + Math.log(v))) return d * v\n    }\n}"], "prob/flip": ["private