 > 0.5) f + 1.0 else if (x > 0.0) f + 1.0 else f\n}", "private fun _nowMs(): Double = System.currentTimeMillis().toDouble()", "private fun _tTod(t: String, op: String): Double { val m = _moment(t); if (m.dateOnly) throw IllegalArgumentException(op + \" needs a time of day and a date carries none: pass a datetime\"); return m.ms }"], "time/isToday": ["private const val _DAY_MS = 86400000.0\n\nprivate fun _isLeap(y: Int): Boolean = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0\n\nprivate fun _dim(y: Int, m: Int): Int = when (m) {\n    1, 3, 5, 7, 8, 10, 12 -> 31\n    4, 6, 9, 11 -> 30\n    2 -> if (_isLeap(y)) 29 else 28\n    else -> 30\n}\n\nprivate fun _tsToDate(ts: Double): IntArray {\n    val days = Math.floor(ts / 86400000.0).toLong()\n    val shifted = days + 719468L\n    val era = Math.floorDiv(shifted, 146097L)\n    val doe = Math.floorMod(shifted, 146097L)\n    val yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L\n    val doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)\n    val mp = (5L * doy + 2L) / 153L\n    val day = (doy - (153L * mp + 2L) / 5L + 1L).toInt()\n    val month = (if (mp < 10L) mp + 3L else mp - 9L).toInt()\n    val year = (yoe + era * 400L + (if (month <= 2) 1L else 0L)).toInt()\n    return intArrayOf(year, month, day)\n}\n\nprivate fun _dateToTs(year: Int, month: Int, day: Int): Double {\n    val y = year.toLong() - (if (month <= 2) 1L else 0L)\n    val era = Math.floorDiv(y, 400L)\n    val yoe = Math.floorMod(y, 400L)\n    val mp = ((month + 9) % 12).toLong()\n    val doy = (153L * mp + 2L) / 5L + day.toLong() - 1L\n    val doe = yoe * 365L + yoe / 4L - yoe / 100L + doy\n    return (era * 146097L + doe - 719468L).toDouble() * 86400000.0\n}\n\nprivate class _Mo(val ms: Double, val dateOnly: Boolean)\n\nprivate fun _parseIso(text: String): _Mo? {\n    fun num(from: Int, len: Int): Int? {\n        if (from < 0 || from + len > text.length) return null\n        for (k in from until from + len) if (text[k] !in '0'..'9') return null