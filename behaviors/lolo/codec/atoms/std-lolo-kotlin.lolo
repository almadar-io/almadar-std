   val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}"], "noise/simplex": ["private val _PERM: IntArray = intArrayOf(151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180)\n\nprivate fun _p(i: Long): Long = _PERM[(i and 255L).toInt()].toLong()\n\nprivate fun _fade(t: Double): Double = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nprivate fun _nlerp(a: Double, b: Double, t: Double): Double = a + t * (b - a)\n\nprivate fun _grad2(hash: Long, x: Double, y: Double): Double {\n    val h = hash and 7L\n    val u = if (h < 4) x else y\n    val v = if (h < 4) y else x\n    return (if (h and 1L == 0L) u else -u) + (if (h and 2L == 0L) v else -v)\n}\n\nprivate fun _perlin(x: Double, y: Double, seed: Double): Double {\n    val s = Math.floor(seed).toLong() and 255L\n    val xi = (Math.floor(x).toLong() + s) and 255L\n    val yi = (Math.floor(y).toLong() + s) and 255L\n    val xf = x - Math.floor(x)\n    val yf = y - Math.floor(y)\n    val u = _fade(xf)\n    val v = _fade(yf)\n    val aa = _p(_p(xi) + yi)\n    val ab = _p(_p(xi) + yi + 1)\n    val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "private fun _simplex(x: Double, y: Double, seed: Double): Double =\n    (_perlin(x, y, seed) + _perlin(x * 2.0 + 5.2, y * 2.0 + 1.3, seed) * 0.5 + _perlin(x * 4.0 + 9.1, y * 4.0 + 7.7, seed) * 0.25) / 1.75"], "noise/fbm": ["private val _PERM: IntArray = intArrayOf(151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180)\n\nprivate fun _p(i: Long): Long = _PERM[(i and 255L).toInt()].toLong()\n\nprivate fun _fade(t: Double): Double = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nprivate fun _nlerp(a: Double, b: Double, t: Double): Double = a + t * (b - a)\n\nprivate fun _grad2(hash: Long, x: Double, y: Double): Double {\n    val h = hash and 7L\n    val u = if (h < 4) x else y\n    val v = if (h < 4) y else x\n    return (if (h and 1L == 0L) u else -u) + (if (h and 2L == 0L) v else -v)\n}\n\nprivate fun _perlin(x: Double, y: Double, seed: Double): Double {\n    val s = Math.floor(seed).toLong() and 255L\n    val xi = (Math.floor(x).toLong() + s) and 255L\n    val yi = (Math.floor(y).toLong() + s) and 255L\n    val xf = x - Math.floor(x)\n    val yf = y - Math.floor(y)\n    val u = _fade(xf)\n    val v = _fade(yf)\n    val aa = _p(_p(xi) + yi)\n    val ab = _p(_p(xi) + yi + 1)\n    val ba = _p(_p(xi + 1) + yi)\n    val bb = _p(_p(xi + 1) + yi + 1)\n    val x1 = _nlerp(_grad2(aa, xf, yf), _grad2(ba, xf - 1.0, yf), u)\n    val x2 = _nlerp(_grad2(ab, xf, yf - 1.0), _grad2(bb, xf - 1.0, yf - 1.0), u)\n    return _nlerp(x1, x2, v)\n}", "private fun _fbm(x: Double, y: Double, oct: Double, seed: Double): Double {\n    val octaves = Math.floor(oct).toLong().coerceIn(1L, 8L)\n    var total = 0.0\n    var freq = 1.0\n    var amp = 1.0\n    var max = 0.0\n    for (i in 0 until octaves) {\n        total += _perlin(x * freq, y * freq, seed) * amp\n        max += amp\n        freq *= 2.0\n        amp *= 0.5\n    }\n    return total / max\n}"], "anim/frame-at": ["private fun _frameAt(elapsed: Number, dur: Number, count: Number, looped: Boolean): Double {\n    val fd = dur.toDouble()\n    val fc = count.toDouble()\n    if (fd == 0.0) throw IllegalArgumentException(\"anim/frame-at: frameDur must not be 0\")\n    if (fc <= 0.0) throw IllegalArgumentException(\"anim/frame-at: frameCount \" + fc + \" must be positive\")\n    val i = Math.floor(elapsed.toDouble() / fd)\n    if (looped) {\n        val m = i % fc\n        return if (m < 0.0) m + fc else m\n    }\n    return Math.min(i, fc - 1.0)\n}"], "anim/sheet-rect": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Map<*, *> -> kotlinx.serialization.json.JsonObject(value.entries.associate { (k, v) -> k.toString() to _jv(v) })\n    is List<*> -> kotlinx.serialization.json.JsonArray(value.map { _jv(it) })\n    else -> kotlinx.serialization.json.Json { encodeDefaults = true }.encodeToJsonElement(kotlinx.serialization.serializer(value.javaClass), value)\n}", "private fun _plain(e: kotlinx.serialization.json.JsonElement): Any? = when (e) {\n    is kotlinx.serialization.json.JsonNull -> null\n    is kotlinx.serialization.json.JsonPrimitive -> if (e.isString) e.content else (e.content.toBooleanStrictOrNull() ?: e.content.toDouble())\n    is kotlinx.serialization.json.JsonArray -> e.map { _plain(it) }\n    is kotlinx.serialization.json.JsonObject -> e.mapValues { _plain(it.value) }\n}", "private inline fun <reified R> _ret(v: Any?): R {\n    val t = kotlin.reflect.typeOf<R>()\n    @Suppress(\"UNCHECKED_CAST\")\n    if (t == kotlin.reflect.typeOf<Map<String, Any?>>() || t == kotlin.reflect.typeOf<List<Any?>>() || t == kotlin.reflect.typeOf<Any?>() || t == kotlin.reflect.typeOf<Any>()) return v as R\n    return kotlinx.serialization.json.Json { ignoreUnknownKeys = true }.decodeFromJsonElement(kotlinx.serialization.serializer<R>(), _jv(v))\n}", "private fun _obj(v: Any?): Map<String, Any?> {\n    @Suppress(\"UNCHECKED_CAST\")\n    if (v is Map<*, *>) return v as Map<String, Any?>\n    val j = _jv(v)\n    if (j !is kotlinx.serialization.json.JsonObject) throw IllegalArgumentException(\"expected object\")\n    @Suppress(\"UNCHECKED_CAST\")\n    return _plain(j) as Map<String, Any?>\n}", "private inline fun <reified R> _sheetRect(index: Number, cols: Number, w: Number, h: Number): R {\n    val c = cols.toDouble()\n    if (c <= 0.0) throw IllegalArgumentException(\"anim/sheet-rect: cols \" + c + \" must be positive\")\n    val i = index.toDouble()\n    return _ret(linkedMapOf<String, Any?>(\"sx\" to (i % c) * w.toDouble(), \"sy\" to Math.floor(i / c) * h.toDouble(), \"sw\" to w.toDouble(), \"sh\" to h.toDouble()))\n}"], "anim/direction-from-delta": ["private fun _roundAway(x: Double): Double {\n    if (x.isNaN() || x.isInfinite()) return x\n    val f = Math.floor(x)\n    val d = x - f\n    return if (d < 0.5) f else if (d > 0.5) f + 1.0 else if (x > 0.0) f + 1.0 else f\n}", "private fun _remEuclid(a: Double, b: Double): Double {\n    val r = a % b\n    return if (r < 0.0) r + Math.abs(b) else r\n}", "private fun _direction(dx: Number, dy: Number, ways: Number): String {\n    val w = ways.toDouble()\n    if (w != 4.0 && w != 8.0) throw IllegalArgumentException(\"anim/direction-from-delta: ways \" + w + \": expected 4 or 8\")\n    val angle = Math.atan2(dy.toDouble(), dx.toDouble())\n    val twoPi = Math.PI * 2.0\n    if (w == 8.0) {\n        val sector = _remEuclid(_roundAway(angle / (twoPi / 8.0)), 8.0).toLong()\n        return listOf(\"right\", \"down-right\", \"down\", \"down-left\", \"left\", \"up-left\", \"up\", \"up-right\").getOrElse(sector.toInt()) { \"right\" }\n    }\n    val sector = _remEuclid(_roundAway(angle / (twoPi / 4.0)), 4.0).toLong()\n    return listOf(\"right\", \"down\", \"left\", \"up\").getOrElse(sector.toInt()) { \"right\" }\n}"], "base64/decode": ["private fun _b64decode(s: String): ByteArray? {\n    if (s.length % 4 != 0) return null\n    val alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n    val out = java.io.ByteArrayOutputStream()\n    var i = 0\n    while (i < s.length) {\n        val last = i + 4 == s.length\n        var pad = 0\n        val v = IntArray(4)\n        for (j in 0 until 4) {\n            val c = s[i + j]\n            if (c == '=') {\n                if (!last || j < 2) return null\n                pad += 1\n            } else {\n                if (pad > 0) return null\n                val k = alphabet.indexOf(c)\n                if (k < 0) return null\n                v[j] = k\n            }\n        }\n        val n = (v[0] shl 18) or (v[1] shl 12) or (v[2] shl 6) or v[3]\n        out.write((n shr 16) and 255)\n        if (pad < 2) out.write((n shr 8) and 255)\n        if (pad < 1) out.write(n and 255)\n        if (pad == 2 && (v[1] and 15) != 0) return null\n        if (pad == 1 && (v[2] and 3) != 0) return null\n        i += 4\n    }\n    return out.toByteArray()\n}", "private fun _b64text(s: String): String? {\n    val bytes = _b64decode(s) ?: return null\n    val decoder = Charsets.UTF_8.newDecoder()\n        .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)\n        .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)\n    return try {\n        decoder.decode(java.nio.ByteBuffer.wrap(bytes)).toString()\n    } catch (e: java.nio.charset.CharacterCodingException) {\n        null\n    }\n}"], "base64/valid": ["private fun _b64decode(s: String): ByteArray? {\n    if (s.length % 4 != 0) return null\n    val alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n    val out = java.io.ByteArrayOutputStream()\n    var i = 0\n    while (i < s.length) {\n        val last = i + 4 == s.length\n        var pad = 0\n        val v = IntArray(4)\n        for (j in 0 until 4) {\n            val c = s[i + j]\n            if (c == '=') {\n                if (!last || j < 2) return null\n                pad += 1\n            } else {\n                if (pad > 0) return null\n                val k = alphabet.indexOf(c)\n                if (k < 0) return null\n                v[j] = k\n            }\n        }\n        val n = (v[0] shl 18) or (v[1] shl 12) or (v[2] shl 6) or v[3]\n        out.write((n shr 16) and 255)\n        if (pad < 2) out.write((n shr 8) and 255)\n        if (pad < 1) out.write(n and 255)\n        if (pad == 2 && (v[1] and 15) != 0) return null\n        if (pad == 1 && (v[2] and 3) != 0) return null\n        i += 4\n    }\n    return out.toByteArray()\n}", "private fun _b64text(s: String): String? {\n    val bytes = _b64decode(s) ?: return null\n    val decoder = Charsets.UTF_8.newDecoder()\n        .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)\n        .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)\n    return try {\n        decoder.decode(java.nio.ByteBuffer.wrap(bytes)).toString()\n    } catch (e: java.nio.charset.CharacterCodingException) {\n        null\n    }\n}"], "format/number": ["private class _Dec(val digits: List<Int>, val point: Int) {\n    companion object {\n        fun of(abs: Double): _Dec {\n            if (abs == 0.0) return _Dec(listOf(), 0)\n            val bd = java.math.BigDecimal(java.lang.Double.toString(abs)).stripTrailingZeros()\n            return _Dec(bd.unscaledValue().toString().map { it - '0' }, bd.precision() - bd.scale())\n        }\n    }\n\n    fun rounded(fraction: Int): _Dec {\n        val keep = point + fraction\n        if (keep < 0) return _Dec(listOf(), 0)\n        if (keep >= digits.size) return this\n        val up = digits[keep] >= 5\n        val d = digits.take(keep).toMutableList()\n        if (!up) return if (d.isEmpty()) _Dec(listOf(), 0) else _Dec(d, point)\n        if (keep == 0) return _Dec(listOf(1), 1 - fraction)\n        var at = keep\n        while (at > 0) {\n            at -= 1\n            if (d[at] == 9) d[at] = 0 else {\n                d[at] += 1\n                return _Dec(d, point)\n            }\n        }\n        return _Dec(listOf(1), point + 1)\n    }\n\n    fun shifted(places: Int): _Dec = if (digits.isEmpty()) this else _Dec(digits, point + places)\n\n    fun integer(): String {\n        if (point <= 0 || digits.isEmpty()) return \"0\"\n        return (0 until point).joinToString(\"\") { (digits.getOrElse(it) { 0 }).toString() }\n    }\n\n    fun fraction(min: Int, max: Int): String {\n        val out = mutableListOf<Int>()\n        if (point < 0) repeat(-point) { out.add(0) }\n        out.addAll(digits.drop(maxOf(point, 0)))\n        while (out.size > max) out.removeAt(out.size - 1)\n        while (out.size > min && out.last() == 0) out.removeAt(out.size - 1)\n        while (out.size < min) out.add(0)\n        return out.joinToString(\"\")\n    }\n}", "private class _Loc(val group: String, val decimal: String, val minGroup: Int, val minus: String)", "private val _EN = _Loc(\",\", \".\", 1, \"-\")\nprivate val _LOCALES: Map<String, _Loc> = run {\n    val de = _Loc(\".\", \",\", 1, \"-\")\n    val fr = _Loc(\"\\u202f\", \",\", 1, \"-\")\n    val es = _Loc(\".\", \",\", 2, \"-\")\n    val sl = _Loc(\".\", \",\", 2, \"\\u2212\")\n    val ar = _Loc(\",\", \".\", 1, \"\\u200e-\")\n    val ru = _Loc(\"\\u00a0\", \",\", 1, \"-\")\n    mapOf(\"en\" to _EN, \"en-US\" to _EN, \"en-GB\" to _EN, \"en-CA\" to _EN, \"en-AU\" to _EN, \"ja\" to _EN, \"ja-JP\" to _EN,\n        \"de\" to de, \"de-DE\" to de, \"pt\" to de, \"pt-BR\" to de, \"nl\" to de, \"nl-NL\" to de,\n        \"fr\" to fr, \"fr-FR\" to fr, \"es\" to es, \"es-ES\" to es, \"it\" to es, \"it-IT\" to es,\n        \"sl\" to sl, \"sl-SI\" to sl, \"ar\" to ar, \"ru\" to ru, \"ru-RU\" to ru)\n}", "private fun _group(integer: String, loc: _Loc): String {\n    if (integer.length < 3 + loc.minGroup) return integer\n    val first = integer.length % 3\n    val parts = mutableListOf<String>()\n    if (first > 0) parts.add(integer.substring(0, first))\n    var at = first\n    while (at < integer.length) {\n        parts.add(integer.substring(at, at + 3))\n        at += 3\n    }\n    return parts.joinToString(loc.group)\n}\n\nprivate fun _render(n: Double, loc: _Loc, min: Int, max: Int, shift: Int): String {\n    if (n.isNaN()) return \"NaN\"\n    val sign = if (java.lang.Double.doubleToRawLongBits(n) < 0L) loc.minus else \"\"\n    if (n.isInfinite()) return sign + \"\\u221e\"\n    val dec = _Dec.of(Math.abs(n)).shifted(shift).rounded(max)\n    val fraction = dec.fraction(min, max)\n    val integer = _group(dec.integer(), loc)\n    return if (fraction.isEmpty()) sign + integer else sign + integer + loc.decimal + fraction\n}", "private fun _digits(o: Map<String, Any?>, key: String): Int? {\n    val v = o[key] ?: return -1\n    if (v !is Number) throw IllegalArgumentException(\"format/number: \" + key + \" must be a whole number from 0 to 100\")\n    val d = v.toDouble()\n    if (d != Math.floor(d) || d.isInfinite() || d < 0.0 || d > 100.0) return null\n    return d.toInt()\n}\n\nprivate fun _formatNumber(n: Number, o: Map<String, Any?>): String? {\n    val tag = o[\"locale\"]\n    val loc = if (tag == null) _EN else if (tag is String) (_LOCALES[tag] ?: return null) else throw IllegalArgumentException(\"format/number: locale must be a string\")\n    val decimals = _digits(o, \"decimals\")\n    val minimum = _digits(o, \"minimumFractionDigits\")\n    val maximum = _digits(o, \"maximumFractionDigits\")\n    if (decimals == null || minimum == null || maximum == null) return null\n    val min: Int\n    val max: Int\n    if (decimals >= 0) { min = decimals; max = decimals }\n    else if (minimum >= 0 && maximum >= 0) { if (maximum < minimum) return null; min = minimum; max = maximum }\n    else if (minimum >= 0) { min = minimum; max = maxOf(minimum, 3) }\n    else if (maximum >= 0) { min = 0; max = maximum }\n    else { min = 0; max = 3 }\n    return _render(n.toDouble(), loc, min, max, 0)\n}"], "format/percent": ["private class _Dec(val digits: List<Int>, val point: Int) {\n    companion object {\n        fun of(abs: Double): _Dec {\n            if (abs == 0.0) return _