) {\n            fw += x[j] * f[jx + i - j]\n        }\n        q[i] = fw\n    }\n    var jz = jk\n    while (true) {\n        var i = 0\n        z = q[jz]\n        var jj = jz\n        while (jj >= 1) {\n            fw = (x1p_24 * z).toInt().toDouble()\n            iq[i] = (z - x1p24 * fw).toInt()\n            z = q[jj - 1] + fw\n            i += 1\n            jj -= 1\n        }\n        z = _libm_scalbn(z, q0)\n        z -= 8.0 * Math.floor(z * 0.125)\n        n = z.toInt()\n        z -= n.toDouble()\n        ih = 0\n        if (q0 > 0) {\n            i = iq[jz - 1] shr (24 - q0)\n            n += i\n            iq[jz - 1] -= i shl (24 - q0)\n            ih = iq[jz - 1] shr (23 - q0)\n        } else if (q0 == 0) {\n            ih = iq[jz - 1] shr 23\n        } else if (z >= 0.5) {\n            ih = 2\n        }\n        if (ih > 0) {\n            n += 1\n            var carry = 0\n            for (ii in 0 until jz) {\n                val j = iq[ii]\n                if (carry == 0) {\n                    if (j != 0) {\n                        carry = 1\n                        iq[ii] = 0x1000000 - j\n                    }\n                } else {\n                    iq[ii] = 0xffffff - j\n                }\n            }\n            if (q0 > 0) {\n                when (q0) {\n                    1 -> iq[jz - 1] = iq[jz - 1] and 0x7fffff\n                    2 -> iq[jz - 1] = iq[jz - 1] and 0x3fffff\n                    else -> {}\n                }\n            }\n            if (ih == 2) {\n                z = 1.0 - z\n                if (carry != 0) {\n                    z -= _libm_scalbn(1.0, q0)\n                }\n            }\n        }\n        if (z == 0.0) {\n            var j = 0\n            var ii = jz - 1\n            while (ii >= jk) {\n                j = j or iq[ii]\n                ii -= 1\n            }\n            if (j == 0) {\n                var k = 1\n                while (iq[jk - k] == 0) {\n                    k += 1\n              