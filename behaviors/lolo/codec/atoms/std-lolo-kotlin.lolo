sing or non-number field \" + names[i]) }\n}", "private fun _wholeI(what: String, n: Double): Long {\n    if (n.isInfinite() || n.isNaN() || n != Math.floor(n)) throw IllegalArgumentException(what + \" \" + n + \" is not a whole number\")\n    return n.toLong()\n}", "private class _Cell(val x: Long, val y: Long)\n\nprivate fun _pcell(o: Any?, param: String): _Cell {\n    val f = _fld(o, \"x\", \"y\")\n    return _Cell(_wholeI(param + \".x\", f[0]), _wholeI(param + \".y\", f[1]))\n}\n\nprivate fun _pkey(c: _Cell): String = c.x.toString() + \",\" + c.y.toString()\n\nprivate fun _poffs(diagonal: Boolean): List<Pair<Long, Long>> {\n    val offs = mutableListOf(Pair(0L, -1L), Pair(1L, 0L), Pair(0L, 1L), Pair(-1L, 0L))\n    if (diagonal) offs.addAll(listOf(Pair(1L, -1L), Pair(1L, 1L), Pair(-1L, 1L), Pair(-1L, -1L)))\n    return offs\n}\n\nprivate fun _pcellMap(c: _Cell): Map<String, Any?> = linkedMapOf<String, Any?>(\"x\" to c.x.toDouble(), \"y\" to c.y.toDouble())", "private inline fun <reified R> _pAstar(s: Any?, g: Any?, blockedIn: List<Any?>, wIn: Number, hIn: Number, diagonal: Boolean): R = _ret(_astar(_pcell(s, \"start\"), _pcell(g, \"goal\"), blockedIn, _wholeI(\"w\", wIn.toDouble()), _wholeI(\"h\", hIn.toDouble()), diagonal).map { _pcellMap(it) })", "private class _Node(val cell: _Cell, val g: Long, val h: Long, val f: Long, val order: Long)\n\nprivate fun _astar(start: _Cell, goal: _Cell, blockedIn: List<Any?>, w: Long, h: Long, diagonal: Boolean): List<_Cell> {\n    val blocked = blockedIn.map { _pkey(_pcell(it, \"blocked\")) }.toSet()\n    val offs = _poffs(diagonal)\n    val heuristic = { c: _Cell ->\n        val dx = Math.abs(c.x - goal.x)\n        val dy = Math.abs(c.y - goal.y)\n        if (diagonal) Math.max(dx, dy) else dx + dy\n    }\n    var counter = 0L\n    val open = mutableListOf<_Node>()\n    val cameFrom = HashMap<String, _Cell>()\n    val gScore = HashMap<String, Long>()\n    val closed = HashSet<String>()\n    val h0 = heuristic(start)\n    open.add(_Node(start, 0L, h0, h0, counter))\n    counter += 1\n    gScore[_pkey(start)] = 0L\n    while (open.isNotEmpty()) {\n        var best = 0\n        for (i in 1 until open.size) {\n            val n = open[i]\n            val b = open[best]\n            if (n.f < b.f || (n.f == b.f && n.h < b.h) || (n.f == b.f && n.h == b.h && n.order < b.order)) best = i\n        }\n        val current = open[best]\n        open[best] = open[open.size - 1]\n        open.removeAt(open.size - 1)\n        if (current.cell.x == goal.x && current.cell.y == goal.y) {\n            val path = mutableListOf(goal)\n            var k = _pkey(goal)\n            while (true) {\n                val prev = cameFrom[k] ?: break\n                path.add(prev)\n                k = _pkey(prev)\n            }\n            path.reverse()\n            return path\n        }\n        closed.add(_pkey(current.cell))\n        for ((dx, dy) in offs) {\n            val nb = _Cell(current.cell.x + dx, current.cell.y + dy)\n            if (nb.x < 0 || nb.x >= w || nb.y < 0 || nb.y >= h) continue\n            val nk = _pkey(nb)\n            if (blocked.contains(nk) || closed.contains(nk)) continue\n            val tentative = current.g + 1\n            val known = gScore[nk]\n            if (known == null || tentative < known) {\n                cameFrom[nk] = current.cell\n                gScore[nk] = tentative\n                val hh = heuristic(nb)\n                open.add(_Node(nb, tentative, hh, tentative + hh, counter))\n                counter += 1\n            }\n        }\n    }\n    return listOf()\n}"], "path/reachable": ["private fun _jv(value: Any?): kotlinx.serialization.json.JsonElement = when (value) {\n    null -> kotlinx.serialization.json.JsonNull\n    is kotlinx.serialization.json.JsonElement -> value\n    is String -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Number -> kotlinx.serialization.json.JsonPrimitive(value)\n    is Boolean -> kotlinx.serialization.json.JsonPrimi