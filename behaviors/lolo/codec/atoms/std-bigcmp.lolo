app std-bigcmp [
  version: "1.0.0",
  description: "std-bigcmp — exact comparison of scaled integers, the one primitive the exact decimal rounding in std-sig6 needs. BIGCMP_BATCH { items, tag } answers BIGCMP_ANSWERED { results, tag } (the tag is echoed so two batches with equal answers stay distinct events): per item the sign (-1, 0, 1) of A * 2^p2 * 10^p10 minus B * 2^q2 * 10^q10, with A = ahi * 2^24 + alo and B = bhi * 2^24 + blo. Negative exponents move to the other side, each side becomes an integer product held as 24 little-endian limbs of 24 bits (multiplied by small chunks of 2^16 and 10^7, carries propagated), and the limbs compare from the top. Exact up to 2^570; no floating point rounding is involved."
]
uses Spec from "almadar-std/bigcmp"

type BigCmpItem = { ahi : number!, alo : number!, p2 : number!, p10 : number!, bhi : number!, blo : number!, q2 : number!, q10 : number! }

orbital BigCmpOrbital {
  entity BigCmpRun [runtime] {
    id : string!
    results : [number] = []
    tag : string = ""
  }

  trait BigCmp -> BigCmpRun [client] {
    initial: idle

    state idle {
      BIGCMP_BATCH -> idle
        (set @entity.tag (str/default @payload.tag ""))
        (set @entity.results (array/map @payload.items (fn it (let ((d2 (- @it.p2 @it.q2)) (d10 (- @it.p10 @it.q10)))  (let ((ls2 (math/max @d2 0)) (ls10 (math/max @d10 0)) (rs2 (math/max (- 0 @d2) 0)) (rs10 (math/max (- 0 @d10) 0)))  (let ((lb (array/reduce (array/concat (array/map (array/range 0 (math/floor (/ @ls2 16))) (fn z 65536)) [(array/reduce (array/range 0 (math/mod @ls2 16)) 1 (fn p z (* @p 2)))] (array/map (array/range 0 (math/floor (/ @ls10 7))) (fn z 10000000)) [(array/reduce (array/range 0 (math/mod @ls10 7)) 1 (fn p z (* @p 10)))]) (array/concat [@it.alo (math/mod @it.ahi 16777216) (math/floor (/ @it.ahi 16777216))] (array/map (array/range 0 21) (fn z 0))) (fn big c (object/get (array/reduce @big { out: [], carry: 0 } (fn st limb (let ((t (+ (* @limb @c) @st.carry))) { out: (array/append @st.out (math/mod @t 16777216)), carry: (math/floor (/ @t 16777216)) }))) "out")))) (rb (array/reduce (array/concat (array/map (array/range 0 (math/floor (/ @rs2 16))) (fn z 65536)) [(array/reduce (array/range 0 (math/mod @rs2 16)) 1 (fn p z (* @p 2)))] (array/map (array/range 0 (math/floor (/ @rs10 7))) (fn z 10000000)) [(array/reduce (array/range 0 (math/mod @rs10 7)) 1 (fn p z (* @p 10)))]) (array/concat [@it.blo (math/mod @it.bhi 16777216) (math/floor (/ @it.bhi 16777216))] (array/map (array/range 0 21) (fn z 0))) (fn big c (object/get (array/reduce @big { out: [], carry: 0 } (fn st limb (let ((t (+ (* @limb @c) @st.carry))) { out: (array/append @st.out (math/mod @t 16777216)), carry: (math/floor (/ @t 16777216)) }))) "out")))))  (array/reduce (array/range 0 24) 0 (fn s i (if (!= @s 0) @s (let ((x (array/nth @lb (- 23 @i))) (y (array/nth @rb (- 23 @i)))) (if (< @x @y) -1 (if (> @x @y) 1 0))))))))))))
        (emit BIGCMP_DONE { })

      BIGCMP_DONE -> idle
        (emit BIGCMP_ANSWERED { results: @entity.results, tag: @entity.tag })
    }

    emits {
      BIGCMP_DONE -> internal { }
      BIGCMP_ANSWERED -> external {
        results : [number]!
        tag : string
      }
        @description "The sign of left minus right for each item, in order."
        @tier "primary"
    }

    listens {
      BIGCMP_BATCH -> input {
        items : [BigCmpItem]!
        tag : string
      }
        @description "Compare these scaled integers exactly."
        @synonyms "exact compare, big integer compare, decimal compare"
    }
  }

  page boot as BigCmpOrbitalStart -> BigCmp
}
