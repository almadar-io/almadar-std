app std-gzip [
  version: "1.3.0",
  description: "Pack and unpack gzip through flate2. GZIP answers GZIP_ANSWERED { data, size, crc }; GUNZIP answers GUNZIP_ANSWERED { data, size, crc } or GZIP_REFUSED { reason }. Every gzip member is checked; crc is the last member's CRC32. level controls crate compression (0–9). maxBytes bounds decompression output; a request may supply its own cap. Refusal codes: magic, method, flags, header-crc, truncated, block, crc, size, trailing, output-limit."
]
uses Spec from "almadar-std/gzip"
type GzipResult = { ok : boolean!, data : bytes, crc : number, code : ("magic" | "method" | "flags" | "header-crc" | "truncated" | "block" | "crc" | "size" | "trailing" | "output-limit") }
orbital GzipOrbital {
  entity GzipRun [runtime] {
    id : string!
    size : number = 0
    crc : number = 0
    result : GzipResult
  }
  trait Gunzip -> GzipRun [client] {
    initial: idle
    config {
      level : number = 6
        @label "Compression level"
        @description "flate2 compression level, 0 (stored) through 9 (best)."
        @tier "domain"
      maxBytes : number = 67108864
        @label "Decompression output cap"
        @description "Maximum output bytes when GUNZIP does not state its own maxBytes."
        @tier "domain"
    }
    state idle {
      GZIP -> idle
        (set @entity.result (gzip/compress @payload.data { result: true, level: @config.level }))
        (set @entity.size (bytes/length @payload.data))
        (set @entity.crc @entity.result.crc)
        (emit GZIP_ANSWERED { data: @entity.result.data, size: @entity.size, crc: @entity.crc })
      GUNZIP -> idle
        (set @entity.result (gzip/decompress @payload.data (if (= @payload.maxBytes null) @config.maxBytes @payload.maxBytes) { result: true }))
        (emit GUNZIP_CHECKED {})
      GUNZIP_CHECKED -> idle when @entity.result.ok
        (when (!= @entity.result.data null)
          (do
            (set @entity.size (bytes/length @entity.result.data))
            (set @entity.crc @entity.result.crc)
            (emit GUNZIP_ANSWERED { data: @entity.result.data, size: @entity.size, crc: @entity.crc })))
      GUNZIP_CHECKED -> idle when (not @entity.result.ok)
        (emit GZIP_REFUSED { reason: @entity.result.code })
    }
    emits {
      GUNZIP_CHECKED -> internal {}
      GUNZIP_ANSWERED -> external { data : bytes! size : number! crc : number! }
        @description "The unpacked bytes of every member, their length and the CRC32 of the last member."
        @tier "primary"
      GZIP_ANSWERED -> external { data : bytes! size : number! crc : number! }
        @description "The gzip member at the configured level, input length and CRC32."
        @tier "primary"
      GZIP_REFUSED -> external { reason : string! }
        @description "Why the input was refused: magic, method, flags, header-crc, truncated, block, crc, size, trailing or output-limit."
        @tier "primary"
    }
    listens {
      GZIP -> input { data : bytes! }
        @description "Pack these bytes as a gzip member."
        @synonyms "gzip, compress gzip, deflate, pack gzip"
      GUNZIP -> input { data : bytes! maxBytes : number }
        @description "Unpack this gzip input within the stated output cap."
        @synonyms "gunzip, ungzip, decompress gzip, unpack tarball"
    }
  }
  page boot as GzipOrbitalStart -> Gunzip
}
