> (\"\\u{20ac}\", 2), \"GBP\" => (\"\\u{a3}\", 2), \"JPY\" => (\"\\u{a5}\", 0),\n        \"CNY\" => (\"CN\\u{a5}\", 2), \"INR\" => (\"\\u{20b9}\", 2), \"KRW\" => (\"\\u{20a9}\", 0), \"CAD\" => (\"CA$\", 2),\n        \"AUD\" => (\"A$\", 2), \"CHF\" => (\"CHF\\u{a0}\", 2), \"MXN\" => (\"MX$\", 2), \"BRL\" => (\"R$\", 2),\n        \"SEK\" => (\"SEK\\u{a0}\", 2), \"NOK\" => (\"NOK\\u{a0}\", 2), \"DKK\" => (\"DKK\\u{a0}\", 2), \"PLN\" => (\"PLN\\u{a0}\", 2),\n        \"CZK\" => (\"CZK\\u{a0}\", 2), \"ZAR\" => (\"ZAR\\u{a0}\", 2), \"NZD\" => (\"NZ$\", 2), \"SGD\" => (\"SGD\\u{a0}\", 2),\n        \"HKD\" => (\"HK$\", 2), \"AED\" => (\"AED\\u{a0}\", 2), \"SAR\" => (\"SAR\\u{a0}\", 2), \"ILS\" => (\"\\u{20aa}\", 2),\n        \"TRY\" => (\"TRY\\u{a0}\", 2), \"RUB\" => (\"RUB\\u{a0}\", 2), \"KWD\" => (\"KWD\\u{a0}\", 3), \"BHD\" => (\"BHD\\u{a0}\", 3),\n        \"CLP\" => (\"CLP\\u{a0}\", 0), \"VND\" => (\"\\u{20ab}\", 0),\n        _ => return None,\n    };\n    let amount = _fmt_render(n, (\",\", \".\", 1usize, \"-\"), digits, digits, 0);\n    Some(match amount.strip_prefix('-') {\n        Some(rest) => format!(\"-{}{}\", symbol, rest),\n        None => format!(\"{}{}\", symbol, amount),\n    })\n}"], "format/bytes": ["fn _fmt_to_fixed(x: f64, digits: usize) -> String {\n    let exact = format!(\"{:.60}\", x);\n    let (whole, fraction) = exact.split_once('.').unwrap_or((exact.as_str(), \"\"));\n    let mut kept: Vec<u8> = whole.bytes().chain(fraction.bytes().take(digits)).map(|b| b - b'0').collect();\n    let up = fraction.as_bytes().get(digits).map_or(false, |d| *d >= b'5');\n    if up {\n        let mut at = kept.len();\n        loop {\n            if at == 0 { kept.insert(0, 1); break; }\n            at -= 1;\n            if kept[at] == 9 { kept[at] = 0; } else { kept[at] += 1; break; }\n        }\n    }\n    let split = kept.len() - digits;\n    let text: String = kept.iter().map(|d| char::from(b'0' + *d)).collect();\n    if digits == 0 { text } else { format!(\"{}.{}\",