s(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_now() -> f64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as f64).unwrap_or(0.0) }", "fn _time_relative(text: &str) -> String {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/relative\"); }\n    let diff = _time_now() - ts;\n    let plural = |n: i64| if n == 1 { \"\" } else { \"s\" };\n    let phrase = |n: i64, unit: &str| if diff < 0.0 { format!(\"in {} {}{}\", n, unit, plural(n)) } else { format!(\"{} {}{} ago\", n, unit, plural(n)) };\n    let ms = diff.abs();\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0);\n    if ms < minute { \"just now\".to_string() }\n    else if ms < hour { phrase((ms / minute).round() as i64, \"minute\") }\n    else if ms < day { phrase((ms / hour).round() as i64, \"hour\") }\n    else if ms < 7.0 * day { phrase((ms / day).round() as i64, \"day\") }\n    else if ms < 30.0 * day { phrase((ms / (7.0 * day)).round() as i64, \"week\") }\n    else if ms < 365.0 * day { phrase((ms / (30.0 * day)).round() as i64, \"month\") }\n    else { phrase((ms / (365.0 * day)).round() as i64, \"year\") }\n}\nfn _time_past(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isPast\"); }\n    ts < _time_now()\n}\nfn _time_future(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isFuture\"); }\n    ts > _time_now()\n}\nfn _time_today(text: &str) -> bool {\n    let (ts, _) = _time_moment(text);\n    (ts / 86_400_000.0).floor() == (_time_now() / 86_400_000.0).floor()\n}\nfn _time_midnight() -> String { _time_render((_time_now() / 86_400_000.0).floor() * 86_400_000.0, false) }\nfn _time_now_text() -> String { _time_render(_time_now(), false) }"], "time/isToday": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "#[derive(Clone, Copy, PartialEq)]\nenum _TimeUnit { Ms, S, Min, H, D, W, Mo, Q, Y }", "fn _time_unit(u: &str) -> _TimeUnit {\n    match u {\n        \"ms\" | \"millisecond\" | \"milliseconds\" => _TimeUnit::Ms,\n        \"s\" | \"second\" | \"seconds\" => _TimeUnit::S,\n        \"m\" | \"minute\" | \"minutes\" => _TimeUnit::Min,\n        \"h\" | \"hour\" | \"hours\" => _TimeUnit::H,\n        \"d\" | \"day\" | \"days\" => _TimeUnit::D,\n        \"w\" | \"week\" | \"weeks\" => _TimeUnit::W,\n        \"month\" | \"months\" => _TimeUnit::Mo,\n        \"quarter\" | \"quarters\" => _TimeUnit::Q,\n        \"year\" | \"years\" => _TimeUnit::Y,\n        _ => panic!(\"expected time unit (ms|millisecond(s), s|second(s), m|minute(s), h|hour(s), d|day(s), w|week(s), month(s), quarter(s), year(s)), got {}\", u),\n    }\n}", "fn _time_fixed(u: _TimeUnit) -> Option<f64> {\n    match u {\n        _TimeUnit::Ms => Some(1.0),\n        _TimeUnit::S => Some(1000.0),\n        _TimeUnit::Min => Some(60_000.0),\n        _TimeUnit::H => Some(3_600_000.0),\n        _TimeUnit::D => Some(86_400_000.0),\n        _TimeUnit::W => Some(604_800_000.0),\n        _ => None,\n    }\n}\nfn _time_below_day(u: _TimeUnit) -> bool { matches!(u, _TimeUnit::Ms | _TimeUnit::S | _TimeUnit::Min | _TimeUnit::H) }", "fn _time_ymd(ts: f64) -> (i64, i64, i64) {\n    let days = (ts / 86_400_000.0).floor() as i64;\n    let shifted = days + 719_468;\n    let era = shifted.div_euclid(146_097);\n    let doe = shifted.rem_euclid(146_097);\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let day = doy - (153 * mp + 2) / 5 + 1;\n    let month = if mp < 10 { mp + 3 } else { mp - 9 };\n    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };\n    (year, month, day)\n}\nfn _time_ts(year: i64, month: i64, day: i64) -> f64 {\n    let y = year - if month <= 2 { 1 } else { 0 };\n    let era = y.div_euclid(400);\n    let yoe = y.rem_euclid(400);\n    let mp = (month + 9) % 12;\n    let doy = (153 * mp + 2) / 5 + day - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    ((era * 146_097 + doe - 719_468) as f64) * 86_400_000.0\n}\nfn _time_dim(y: i64, m: i64) -> i64 {\n    match m {\n        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,\n        4 | 6 | 9 | 11 => 30,\n        2 => if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 },\n        _ => 30,\n    }\n}", "fn _time_parts(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_now() -> f64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as f64).unwrap_or(0.0) }", "fn _time_relative(text: &str) -> String {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/relative\"); }\n    let diff = _time_now() - ts;\n    let plural = |n: i64| if n == 1 { \"\" } else { \"s\" };\n    let phrase = |n: i64, unit: &str| if diff < 0.0 { format!(\"in {} {}{}\", n, unit, plural(n)) } else { format!(\"{} {}{} ago\", n, unit, plural(n)) };\n    let ms = diff.abs();\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0);\n    if ms < minute { \"just now\".to_string() }\n    else if ms < hour { phrase((ms / minute).round() as i64, \"minute\") }\n    else if ms < day { phrase((ms / hour).round() as i64, \"hour\") }\n    else if ms < 7.0 * day { phrase((ms / day).round() as i64, \"day\") }\n    else if ms < 30.0 * day { phrase((ms / (7.0 * day)).round() as i64, \"week\") }\n    else if ms < 365.0 * day { phrase((ms / (30.0 * day)).round() as i64, \"month\") }\n    else { phrase((ms / (365.0 * day)).round() as i64, \"year\") }\n}\nfn _time_past(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isPast\"); }\n    ts < _time_now()\n}\nfn _time_future(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isFuture\"); }\n    ts > _time_now()\n}\nfn _time_today(text: &str) -> bool {\n    let (ts, _) = _time_moment(text);\n    (ts / 86_400_000.0).floor() == (_time_now() / 86_400_000.0).floor()\n}\nfn _time_midnight() -> String { _time_render((_time_now() / 86_400_000.0).floor() * 86_400_000.0, false) }\nfn _time_now_text() -> String { _time_render(_time_now(), false) }"], "time/now": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "#[derive(Clone, Copy, PartialEq)]\nenum _TimeUnit { Ms, S, Min, H, D, W, Mo, Q, Y }", "fn _time_unit(u: &str) -> _TimeUnit {\n    match u {\n        \"ms\" | \"millisecond\" | \"milliseconds\" => _TimeUnit::Ms,\n        \"s\" | \"second\" | \"seconds\" => _TimeUnit::S,\n        \"m\" | \"minute\" | \"minutes\" => _TimeUnit::Min,\n        \"h\" | \"hour\" | \"hours\" => _TimeUnit::H,\n        \"d\" | \"day\" | \"days\" => _TimeUnit::D,\n        \"w\" | \"week\" | \"weeks\" => _TimeUnit::W,\n        \"month\" | \"months\" => _TimeUnit::Mo,\n        \"quarter\" | \"quarters\" => _TimeUnit::Q,\n        \"year\" | \"years\" => _TimeUnit::Y,\n        _ => panic!(\"expected time unit (ms|millisecond(s), s|second(s), m|minute(s), h|hour(s), d|day(s), w|week(s), month(s), quarter(s), year(s)), got {}\", u),\n    }\n}", "fn _time_fixed(u: _TimeUnit) -> Option<f64> {\n    match u {\n        _TimeUnit::Ms => Some(1.0),\n        _TimeUnit::S => Some(1000.0),\n        _TimeUnit::Min => Some(60_000.0),\n        _TimeUnit::H => Some(3_600_000.0),\n        _TimeUnit::D => Some(86_400_000.0),\n        _TimeUnit::W => Some(604_800_000.0),\n        _ => None,\n    }\n}\nfn _time_below_day(u: _TimeUnit) -> bool { matches!(u, _TimeUnit::Ms | _TimeUnit::S | _TimeUnit::Min | _TimeUnit::H) }", "fn _time_ymd(ts: f64) -> (i64, i64, i64) {\n    let days = (ts / 86_400_000.0).floor() as i64;\n    let shifted = days + 719_468;\n    let era = shifted.div_euclid(146_097);\n    let doe = shifted.rem_euclid(146_097);\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let day = doy - (153 * mp + 2) / 5 + 1;\n    let month = if mp < 10 { mp + 3 } else { mp - 9 };\n    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };\n    (year, month, day)\n}\nfn _time_ts(year: i64, month: i64, day: i64) -> f64 {\n    let y = year - if month <= 2 { 1 } else { 0 };\n    let era = y.div_euclid(400);\n    let yoe = y.rem_euclid(400);\n    let mp = (month + 9) % 12;\n    let doy = (153 * mp + 2) / 5 + day - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    ((era * 146_097 + doe - 719_468) as f64) * 86_400_000.0\n}\nfn _time_dim(y: i64, m: i64) -> i64 {\n    match m {\n        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,\n        4 | 6 | 9 | 11 => 30,\n        2 => if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 },\n        _ => 30,\n    }\n}", "fn _time_parts(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_now() -> f64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as f64).unwrap_or(0.0) }", "fn _time_relative(text: &str) -> String {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/relative\"); }\n    let diff = _time_now() - ts;\n    let plural = |n: i64| if n == 1 { \"\" } else { \"s\" };\n    let phrase = |n: i64, unit: &str| if diff < 0.0 { format!(\"in {} {}{}\", n, unit, plural(n)) } else { format!(\"{} {}{} ago\", n, unit, plural(n)) };\n    let ms = diff.abs();\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0);\n    if ms < minute { \"just now\".to_string() }\n    else if ms < hour { phrase((ms / minute).round() as i64, \"minute\") }\n    else if ms < day { phrase((ms / hour).round() as i64, \"hour\") }\n    else if ms < 7.0 * day { phrase((ms / day).round() as i64, \"day\") }\n    else if ms < 30.0 * day { phrase((ms / (7.0 * day)).round() as i64, \"week\") }\n    else if ms < 365.0 * day { phrase((ms / (30.0 * day)).round() as i64, \"month\") }\n    else { phrase((ms / (365.0 * day)).round() as i64, \"year\") }\n}\nfn _time_past(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isPast\"); }\n    ts < _time_now()\n}\nfn _time_future(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isFuture\"); }\n    ts > _time_now()\n}\nfn _time_today(text: &str) -> bool {\n    let (ts, _) = _time_moment(text);\n    (ts / 86_400_000.0).floor() == (_time_now() / 86_400_000.0).floor()\n}\nfn _time_midnight() -> String { _time_render((_time_now() / 86_400_000.0).floor() * 86_400_000.0, false) }\nfn _time_now_text() -> String { _time_render(_time_now(), false) }"], "time/today": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "#[derive(Clone, Copy, PartialEq)]\nenum _TimeUnit { Ms, S, Min, H, D, W, Mo, Q, Y }", "fn _time_unit(u: &str) -> _TimeUnit {\n    match u {\n        \"ms\" | \"millisecond\" | \"milliseconds\" => _TimeUnit::Ms,\n        \"s\" | \"second\" | \"seconds\" => _TimeUnit::S,\n        \"m\" | \"minute\" | \"minutes\" => _TimeUnit::Min,\n        \"h\" | \"hour\" | \"hours\" => _TimeUnit::H,\n        \"d\" | \"day\" | \"days\" => _TimeUnit::D,\n        \"w\" | \"week\" | \"weeks\" => _TimeUnit::W,\n        \"month\" | \"months\" => _TimeUnit::Mo,\n        \"quarter\" | \"quarters\" => _TimeUnit::Q,\n        \"year\" | \"years\" => _TimeUnit::Y,\n        _ => panic!(\"expected time unit (ms|millisecond(s), s|second(s), m|minute(s), h|hour(s), d|day(s), w|week(s), month(s), quarter(s), year(s)), got {}\", u),\n    }\n}", "fn _time_fixed(u: _TimeUnit) -> Option<f64> {\n    match u {\n        _TimeUnit::Ms => Some(1.0),\n        _TimeUnit::S => Some(1000.0),\n        _TimeUnit::Min => Some(60_000.0),\n        _TimeUnit::H => Some(3_600_000.0),\n        _TimeUnit::D => Some(86_400_000.0),\n        _TimeUnit::W => Some(604_800_000.0),\n        _ => None,\n    }\n}\nfn _time_below_day(u: _TimeUnit) -> bool { matches!(u, _TimeUnit::Ms | _TimeUnit::S | _TimeUnit::Min | _TimeUnit::H) }", "fn _time_ymd(ts: f64) -> (i64, i64, i64) {\n    let days = (ts / 86_400_000.0).floor() as i64;\n    let shifted = days + 719_468;\n    let era = shifted.div_euclid(146_097);\n    let doe = shifted.rem_euclid(146_097);\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let day = doy - (153 * mp + 2) / 5 + 1;\n    let month = if mp < 10 { mp + 3 } else { mp - 9 };\n    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };\n    (year, month, day)\n}\nfn _time_ts(year: i64, month: i64, day: i64) -> f64 {\n    let y = year - if month <= 2 { 1 } else { 0 };\n    let era = y.div_euclid(400);\n    let yoe = y.rem_euclid(400);\n    let mp = (month + 9) % 12;\n    let doy = (153 * mp + 2) / 5 + day - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    ((era * 146_097 + doe - 719_468) as f64) * 86_400_000.0\n}\nfn _time_dim(y: i64, m: i64) -> i64 {\n    match m {\n        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,\n        4 | 6 | 9 | 11 => 30,\n        2 => if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 },\n        _ => 30,\n    }\n}", "fn _time_parts(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_now() -> f64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as f64).unwrap_or(0.0) }", "fn _time_relative(text: &str) -> String {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/relative\"); }\n    let diff = _time_now() - ts;\n    let plural = |n: i64| if n == 1 { \"\" } else { \"s\" };\n    let phrase = |n: i64, unit: &str| if diff < 0.0 { format!(\"in {} {}{}\", n, unit, plural(n)) } else { format!(\"{} {}{} ago\", n, unit, plural(n)) };\n    let ms = diff.abs();\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0);\n    if ms < minute { \"just now\".to_string() }\n    else if ms < hour { phrase((ms / minute).round() as i64, \"minute\") }\n    else if ms < day { phrase((ms / hour).round() as i64, \"hour\") }\n    else if ms < 7.0 * day { phrase((ms / day).round() as i64, \"day\") }\n    else if ms < 30.0 * day { phrase((ms / (7.0 * day)).round() as i64, \"week\") }\n    else if ms < 365.0 * day { phrase((ms / (30.0 * day)).round() as i64, \"month\") }\n    else { phrase((ms / (365.0 * day)).round() as i64, \"year\") }\n}\nfn _time_past(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isPast\"); }\n    ts < _time_now()\n}\nfn _time_future(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isFuture\"); }\n    ts > _time_now()\n}\nfn _time_today(text: &str) -> bool {\n    let (ts, _) = _time_moment(text);\n    (ts / 86_400_000.0).floor() == (_time_now() / 86_400_000.0).floor()\n}\nfn _time_midnight() -> String { _time_render((_time_now() / 86_400_000.0).floor() * 86_400_000.0, false) }\nfn _time_now_text() -> String { _time_render(_time_now(), false) }"], "format/ordinal": ["fn _fmt_ordinal(x: f64) -> String {\n    if !x.is_finite() || x != x.trunc() || x.abs() > 9007199254740991.0 { panic!(\"expected a whole number, got {}\", x); }\n    let n = x as i64;\n    let suffix = match (n % 10, n % 100) { (1, 11) | (2, 12) | (3, 13) => \"th\", (1, _) => \"st\", (2, _) => \"nd\", (3, _) => \"rd\", _ => \"th\" };\n    format!(\"{}{}\", n, suffix)\n}"], "format/plural": ["fn _fmt_plural(x: f64, singular: &str, plural: &str) -> String {\n    if !x.is_finite() || x != x.trunc() || x.abs() > 9007199254740991.0 { panic!(\"expected a whole number, got {}\", x); }\n    let n = x as i64;\n    format!(\"{} {}\", n, if n == 1 { singular } else { plural })\n}"], "format/creditCard": ["fn _fmt_credit_card(s: &str) -> String {\n    let digits: String = s.chars().filter(|c| c.is_ascii_digit()).collect();\n    if digits.len() <= 4 { return digits; }\n    let last4 = &digits[digits.len() - 4..];\n    let mask_len = digits.len() - 4;\n    let mut groups: Vec<String> = Vec::new();\n    let mut i = 0usize;\n    while i < mask_len {\n        let g = (mask_len - i).min(4);\n        groups.push(\"\\u{2022}\".repeat(g));\n        i += g;\n    }\n    groups.push(last4.to_string());\n    groups.join(\" \")\n}"], "format/phone": ["fn _fmt_phone(text: &str, format: &str) -> String {\n    let digits: String = text.chars().filter(|c| c.is_ascii_digit()).collect();\n    if format == \"US\" && digits.len() == 10 {\n        format!(\"({}) {}-{}\", &digits[0..3], &digits[3..6], &digits[6..])\n    } else if format == \"US\" && digits.len() == 11 && digits.starts_with('1') {\n        format!(\"+1 ({}) {}-{}\", &digits[1..4], &digits[4..7], &digits[7..])\n    } else if digits.len() >= 10 {\n        format!(\"{}-{}-{}\", &digits[0..3], &digits[3..6], &digits[6..])\n    } else {\n        text.to_string()\n    }\n}"], "format/list": ["fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "trait _Text { fn _text(&self) -> String; }\nimpl _Text for String { fn _text(&self) -> String { self.clone() } }\nimpl _Text for bool { fn _text(&self) -> String { (if *self { \"true\" } else { \"false\" }).to_string() } }\nimpl _Text for f64 { fn _text(&self) -> String { _num_text(*self) } }", "fn _fmt_list<T: _Text>(a: &[T], style: &str) -> String {\n    let items: Vec<String> = a.iter().map(|x| x._text()).collect();\n    match items.len() {\n        0 => String::new(),\n        1 => items[0].clone(),\n        2 => format!(\"{} {} {}\", items[0], style, items[1]),\n        n => format!(\"{}, {} {}\", items[..n - 1].join(\", \"), style, items[n - 1]),\n    }\n}"], "format/number": ["fn _fmt_dec(abs: f64) -> (Vec<u8>, i32) {\n    if abs == 0.0 { return (Vec::new(), 0); }\n    let text = format!(\"{:e}\", abs);\n    let (mantissa, exponent) = text.split_once('e').unwrap_or((text.as_str(), \"0\"));\n    let digits: Vec<u8> = mantissa.bytes().filter(|b| b.is_ascii_digit()).map(|b| b - b'0').collect();\n    (digits, exponent.parse::<i32>().unwrap_or(0) + 1)\n}\nfn _fmt_round(mut digits: Vec<u8>, point: i32, fraction: i32) -> (Vec<u8>, i32) {\n    let keep = point + fraction;\n    if keep < 0 { return (Vec::new(), 0); }\n    let keep = keep as usize;\n    if keep >= digits.len() { return (digits, point); }\n    let up = digits[keep] >= 5;\n    digits.truncate(keep);\n    if !up { return if digits.is_empty() { (Vec::new(), 0) } else { (digits, point) }; }\n    if keep == 0 { return (vec![1], 1 - fraction); }\n    let mut at = keep;\n    while at > 0 {\n        at -= 1;\n        if digits[at] == 9 { digits[at] = 0; } else { digits[at] += 1; return (digits, point); }\n    }\n    (vec![1], point + 1)\n}\nfn _fmt_int(digits: &[u8], point: i32) -> String {\n    if point <= 0 || digits.is_empty() { return \"0\".to_string(); }\n    (0..point as usize).map(|i| char::from(b'0' + digits.get(i).copied().unwrap_or(0))).collect()\n}\nfn _fmt_frac(digits: &[u8], point: i32, min: usize, max: usize) -> String {\n    let mut out: Vec<u8> = Vec::new();\n    if point < 0 { out.extend(std::iter::repeat(0u8).take((-point) as usize)); }\n    let from = point.max(0) as usize;\n    out.extend(digits.iter().skip(from));\n    out.truncate(max);\n    while out.len() > min && out.last() == Some(&0) { out.pop(); }\n    while out.len() < min { out.push(0); }\n    out.into_iter().map(|d| char::from(b'0' + d)).collect()\n}\nfn _fmt_locale(tag: &str) -> Option<(&'static str, &'static str, usize, &'static str)> {\n    match tag {\n        \"en\" | \"en-US\" | \"en-GB\" | \"en-CA\" | \"en-AU\" | \"ja\" | \"ja-JP\" => Some((\",\", \".\", 1, \"-\")),\n        \"de\" | \"de-DE\" | \"pt\" | \"pt-BR\" | \"nl\" | \"nl-NL\" => Some((\".\", \",\", 1, \"-\")),\n        \"fr\" | \"fr-FR\" => Some((\"\\u{202f}\", \",\", 1, \"-\")),\n        \"es\" | \"es-ES\" | \"it\" | \"it-IT\" => Some((\".\", \",\", 2, \"-\")),\n        \"sl\" | \"sl-SI\" => Some((\".\", \",\", 2, \"\\u{2212}\")),\n        \"ar\" => Some((\",\", \".\", 1, \"\\u{200e}-\")),\n        \"ru\" | \"ru-RU\" => Some((\"\\u{a0}\", \",\", 1, \"-\")),\n        _ => None,\n    }\n}\nfn _fmt_group(integer: &str, loc: (&'static str, &'static str, usize, &'static str)) -> String {\n    if integer.len() < 3 + loc.2 { return integer.to_string(); }\n    let first = integer.len() % 3;\n    let mut parts: Vec<&str> = Vec::new();\n    if first > 0 { parts.push(&integer[..first]); }\n    parts.extend((first..integer.len()).step_by(3).map(|at| &integer[at..at + 3]));\n    parts.join(loc.0)\n}\nfn _fmt_render(n: f64, loc: (&'static str, &'static str, usize, &'static str), min: usize, max: usize, shift: i32) -> String {\n    if n.is_nan() { return \"NaN\".to_string(); }\n    let sign = if n.is_sign_negative() { loc.3 } else { \"\" };\n    if n.is_infinite() { return format!(\"{}\\u{221e}\", sign); }\n    let (d0, p0) = _fmt_dec(n.abs());\n    let p1 = if d0.is_empty() { p0 } else { p0 + shift };\n    let (digits, point) = _fmt_round(d0, p1, max as i32);\n    let fraction = _fmt_frac(&digits, point, min, max);\n    let integer = _fmt_group(&_fmt_int(&digits, point), loc);\n    if fraction.is_empty() { format!(\"{}{}\", sign, integer) } else { format!(\"{}{}{}{}\", sign, integer, loc.1, fraction) }\n}", "macro_rules! _fmt_opts {\n    (std::collections::BTreeMap::new()) => { serde_json::Value::Object(serde_json::Map::new()) };\n    ($e:expr) => { _j(&$e) };\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "enum _FmtDigits { Absent, Set(usize), Out }\nfn _fmt_digits(o: &serde_json::Map<String, serde_json::Value>, key: &str) -> _FmtDigits {\n    match o.get(key) {\n        None | Some(serde_json::Value::Null) => _FmtDigits::Absent,\n        Some(serde_json::Value::Number(n)) => match n.as_f64() {\n            Some(f) if f == f.trunc() && f >= 0.0 && f <= 100.0 => _FmtDigits::Set(f as usize),\n            _ => _FmtDigits::Out,\n        },\n        Some(other) => panic!(\"format/number: `{}` must be a whole number from 0 to 100, got {}\", key, other),\n    }\n}\nfn _fmt_number(n: f64, opts: &serde_json::Value) -> Option<String> {\n    let empty = serde_json::Map::new();\n    let o = match opts {\n        serde_json::Value::Object(m) => m,\n        serde_json::Value::Null => &empty,\n        other => panic!(\"expected object, got {}\", other),\n    };\n    let loc = match o.get(\"locale\") {\n        None | Some(serde_json::Value::Null) => (\",\", \".\", 1usize, \"-\"),\n        Some(serde_json::Value::String(tag)) => match _fmt_locale(tag) { Some(l) => l, None => return None },\n        Some(other) => panic!(\"format/number: `locale` must be a string, got {}\", other),\n    };\n    let decimals = _fmt_digits(o, \"decimals\");\n    let minimum = _fmt_digits(o, \"minimumFractionDigits\");\n    let maximum = _fmt_digits(o, \"maximumFractionDigits\");\n    let (min, max) = match (decimals, minimum, maximum) {\n        (_FmtDigits::Out, _, _) | (_, _FmtDigits::Out, _) | (_, _, _FmtDigits::Out) => return None,\n        (_FmtDigits::Set(d), _, _) => (d, d),\n        (_FmtDigits::Absent, _FmtDigits::Set(lo), _FmtDigits::Set(hi)) => { if hi < lo { return None; } (lo, hi) }\n        (_FmtDigits::Absent, _FmtDigits::Set(lo), _FmtDigits::Absent) => (lo, lo.max(3)),\n        (_Fm