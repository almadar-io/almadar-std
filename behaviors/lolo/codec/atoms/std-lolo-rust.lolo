td::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_uniform(lo: f64, hi: f64) -> f64 { lo + _prob_next() * (hi - lo) }"], "prob/gaussian": ["thread_local! { static _PROB_STATE: std::cell::Cell<(u32, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_normal() -> f64 {\n    let u1 = _prob_next();\n    let u2 = _prob_next();\n    (-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos()\n}", "fn _prob_gaussian(mu: f64, sigma: f64) -> f64 { mu + sigma * _prob_normal() }"], "prob/beta": ["thread_local! { static _PROB_STATE: std::cell::Cell<(u32, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_normal() -> f64 {\n    let u1 = _prob_next();\n    let u2 = _prob_next();\n    (-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos()\n}", "fn _prob_gamma(shape: f64) -> f64 {\n    if shape.is_nan() { return f64::NAN; }\n    if shape < 1.0 {\n        let u = _prob_next();\n        return _prob_gamma(shape + 1.0) * u.powf(1.0 / shape);\n    }\n    let d = shape - 1.0 / 3.0;\n    let c = 1.0 / (9.0 * d).sqrt();\n    loop {\n        let (x, mut v) = loop {\n            let x = _prob_normal();\n            let v = 1.0 + c * x;\n            if v > 0.0 || v.is_nan() { break (x, v); }\n        };\n        v = v * v * v;\n        let u = _prob_next();\n        if u < 1.0 - 0.0331 * (x * x) * (x * x) { return d * v; }\n        if u.ln() < 0.5 * x * x + d * (1.0 - v + v.ln()) { return d * v; }\n    }\n}", "fn _prob_beta(a: f64, b: f64) -> f64 {\n    let x = _prob_gamma(a);\n    let y = _prob_gamma(b);\n    x / (x + y)\n}"], "prob/flip": ["thread_local! { static _PROB_STATE: std::cell::Cell<(u32, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_flip(p: f64) -> bool { _prob_next() < p }"], "prob/categorical": ["thread_local! { static _PROB_STATE: std::cell::Cell<(u32, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_categorical<T: Clone>(items: &[T], weights: &[f64]) -> T {\n    if items.len() != weights.len() { panic!(\"prob/categorical: {} items but {} weights\", items.len(), weights.len()); }\n    let total: f64 = weights.iter().sum();\n    if items.is_empty() || weights.iter().any(|w| *w < 0.0 || w.is_nan()) || total <= 0.0 {\n        panic!(\"prob/categorical: needs at least one item and non-negative weights with a positive sum\");\n    }\n    let mut r = _prob_next() * total;\n    for (item, weight) in items.iter().zip(weights) {\n        r -= weight;\n        if r <= 0.0 { return item.clone(); }\n    }\n    items[items.len() - 1].clone()\n}"], "prob/poisson": ["thread_local! { static _PROB_STATE: std::cell::Cell<(u32, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_seed(n: f64) -> Option<f64> {\n    let s = if n.is_finite() { n.trunc().rem_euclid(4294967296.0) as u32 } else { 0 };\n    _PROB_STATE.with(|c| c.set((s, true)));\n    None\n}\nfn _prob_next() -> f64 {\n    _PROB_STATE.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());\n            s = (ms % 4294967296_u128) as u32;\n        }\n        s = s.wrapping_add(0x6D2B_79F5_u32);\n        c.set((s, true));\n        let mut t = s;\n        t = (t ^ (t >> 15)).wrapping_mul(t | 1);\n        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));\n        f64::from(t ^ (t >> 14)) / 4294967296.0\n    })\n}", "fn _prob_poisson(lambda: f64) -> f64 {\n    let limit = (-lambda).exp();\n    let mut k = 0.0_f64;\n    let mut p = 1.0_f64;\n    loop {\n        k += 1.0;\n        p *= _prob_next();\n        if p <= limit || p.is_nan() { break; }\n    }\n    ((k - 1.0) as i64) as f64\n}"], "prob/sample": ["fn _prob_count(x: f64, op: &str) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 || x > 4294967295.0 { panic!(\"{}: n {} is not a whole number from 0 to 4294967295\", op, x); }\n    x as usize\n}", "fn _prob_sample<T, F: FnMut() -> T>(n: f64, mut f: F) -> Vec<T> {\n    let k = _prob_count(n, \"prob/sample\");\n    let mut out = Vec::with_capacity(k);\n    for _ in 0..k { out.push(f()); }\n    out\n}"], "prob/expected-value": ["fn _prob_mean(op: &str, s: &[f64]) -> f64 {\n    if s.is_empty() { panic!(\"{}: needs at least one sample\", op); }\n    s.iter().sum::<f64>() / s.len() as f64\n}"], "prob/variance": ["fn _prob_mean(op: &str, s: &[f64]) -> f64 {\n    if s.is_empty() { panic!(\"{}: needs at least one sample\", op); }\n    s.iter().sum::<f64>() / s.len() as f64\n}", "fn _prob_variance(s: &[f64]) -> f64 {\n    let mean = _prob_mean(\"prob/variance\", s);\n    s.iter().map(|v| (v - mean).powi(2)).sum::<f64>() / s.len() as f64\n}"], "prob/histogram": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _prob_histogram(samples: &[f64], bins: f64) -> _Obj {\n    if bins < 1.0 || bins.fract() != 0.0 { return _Obj(serde_json::Value::Null); }\n    let mut out = serde_json::Map::new();\n    if samples.is_empty() {\n        out.insert(\"binEdges\".to_string(), serde_json::Value::Array(Vec::new()));\n        out.insert(\"counts\".to_string(), serde_json::Value::Array(Vec::new()));\n        return _Obj(serde_json::Value::Object(out));\n    }\n    let min = samples.iter().copied().fold(f64::INFINITY, f64::min);\n    let max = samples.iter().copied().fold(f64::NEG_INFINITY, f64::max);\n    let width = match (max - min) / bins { w if w == 0.0 || w.is_nan() => 1.0, w => w };\n    let bin_count = bins as usize;\n    let mut counts = vec![0.0_f64; bin_count];\n    for s in samples {\n        let idx = (((s - min) / width).floor() as usize).min(bin_count - 1);\n        counts[idx] += 1.0;\n    }\n    out.insert(\"binEdges\".to_string(), serde_json::Value::Array((0..=bin_count).map(|i| _n(min + i as f64 * width)).collect()));\n    out.insert(\"counts\".to_string(), serde_json::Value::Array(counts.into_iter().map(_n).collect()));\n    _Obj(serde_json::Value::Object(out))\n}"], "prob/percentile": ["fn _prob_sorted(s: &[f64]) -> Vec<f64> {\n    let mut v = s.to_vec();\n    v.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));\n    v\n}", "fn _prob_percentile(samples: &[f64], p: f64) -> Option<f64> {\n    if !(0.0..=100.0).contains(&p) || samples.is_empty() { return None; }\n    let s = _prob_sorted(samples);\n    let idx = (p / 100.0) * (s.len() - 1) as f64;\n    let (lo, hi) = (idx.floor() as usize, idx.ceil() as usize);\n    if lo == hi { return Some(s[lo]); }\n    let frac = idx - lo as f64;\n    Some(s[lo] * (1.0 - frac) + s[hi] * frac)\n}"], "prob/credible-interval": ["fn _prob_sorted(s: &[f64]) -> Vec<f64> {\n    let mut v = s.to_vec();\n    v.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));\n    v\n}", "fn _prob_credible_interval(samples: &[f64], alpha: f64) -> Option<Vec<f64>> {\n    if !(0.0..=1.0).contains(&alpha) || samples.is_empty() { return None; }\n    let s = _prob_sorted(samples);\n    let last = (s.len() - 1) as f64;\n    let lo = ((alpha / 2.0) * last).floor() as usize;\n    let hi = ((1.0 - alpha / 2.0) * last).ceil() as usize;\n    Some(vec![s[lo], s[hi]])\n}"], "math/random": ["thread_local! { static _PROB_CLOCK: std::cell::Cell<(u64, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_u64() -> u64 {\n    _PROB_CLOCK.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            s = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos() as u64);\n        }\n        s = s.wrapping_add(0x9E37_79B9_7F4A_7C15_u64);\n        c.set((s, true));\n        let mut z = s;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9_u64);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB_u64);\n        z ^ (z >> 31)\n    })\n}\nfn _prob_below(bound: u64) -> u64 {\n    let threshold = bound.wrapping_neg() % bound;\n    loop {\n        let draw = _prob_u64();\n        if draw >= threshold { return draw % bound; }\n    }\n}", "fn _prob_random() -> f64 { (_prob_u64() >> 11) as f64 / (1_u64 << 53) as f64 }"], "math/randomInt": ["thread_local! { static _PROB_CLOCK: std::cell::Cell<(u64, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_u64() -> u64 {\n    _PROB_CLOCK.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            s = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos() as u64);\n        }\n        s = s.wrapping_add(0x9E37_79B9_7F4A_7C15_u64);\n        c.set((s, true));\n        let mut z = s;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9_u64);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB_u64);\n        z ^ (z >> 31)\n    })\n}\nfn _prob_below(bound: u64) -> u64 {\n    let threshold = bound.wrapping_neg() % bound;\n    loop {\n        let draw = _prob_u64();\n        if draw >= threshold { return draw % bound; }\n    }\n}", "fn _prob_random_int(min: f64, max: f64) -> Option<f64> {\n    for (what, x) in [(\"min\", min), (\"max\", max)] {\n        if !x.is_finite() || x != x.trunc() { panic!(\"randomInt: {} {} is not a whole number\", what, x); }\n    }\n    let (min, max) = (min as i64, max as i64);\n    if max < min { return None; }\n    let range = (max as i128 - min as i128 + 1) as u128;\n    let offset = match u64::try_from(range) {\n        Ok(bound) => u128::from(_prob_below(bound)),\n        Err(_) => u128::from(_prob_u64()),\n    };\n    Some((min as i128 + offset as i128) as i64 as f64)\n}"], "array/shuffle": ["thread_local! { static _PROB_CLOCK: std::cell::Cell<(u64, bool)> = std::cell::Cell::new((0, false)); }\nfn _prob_u64() -> u64 {\n    _PROB_CLOCK.with(|c| {\n        let (mut s, started) = c.get();\n        if !started {\n            s = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos() as u64);\n        }\n        s = s.wrapping_add(0x9E37_79B9_7F4A_7C15_u64);\n        c.set((s, true));\n        let mut z = s;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9_u64);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB_u64);\n        z ^ (z >> 31)\n    })\n}\nfn _prob_below(bound: u64) -> u64 {\n    let threshold = bound.wrapping_neg() % bound;\n    loop {\n        let draw = _prob_u64();\n        if draw >= threshold { return draw % bound; }\n    }\n}", "fn _prob_shuffle<T: Clone>(a: &[T]) -> Vec<T> {\n    let mut v = a.to_vec();\n    for i in (1..v.len()).rev() {\n        let j = _prob_below(i as u64 + 1) as usize;\n        v.swap(i, j);\n    }\n    v\n}"], "noise/perlin": ["const _NOISE_PERM: [i64; 256] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180];\nfn _noise_p(idx: i64) -> i64 { _NOISE_PERM[(idx & 255) as usize] }\nfn _noise_fade(t: f64) -> f64 { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfn _noise_lerp(a: f64, b: f64, t: f64) -> f64 { a + t * (b - a) }\nfn _noise_grad2(hash: i64, x: f64, y: f64) -> f64 {\n    let h = hash & 7;\n    let u = if h < 4 { x } else { y };\n    let v = if h < 4 { y } else { x };\n    (if h & 1 == 0 { u } else { -u }) + (if h & 2 == 0 { v } else { -v })\n}\nfn _noise_perlin(x: f64, y: f64, seed: f64) -> f64 {\n    let s = (seed.floor() as i64) & 255;\n    let xi = ((x.floor() as i64) + s) & 255;\n    let yi = ((y.floor() as i64) + s) & 255;\n    let xf = x - x.floor();\n    let yf = y - y.floor();\n    let u = _noise_fade(xf);\n    let v = _noise_fade(yf);\n    let aa = _noise_p(_noise_p(xi) + yi);\n    let ab = _noise_p(_noise_p(xi) + yi + 1);\n    let ba = _noise_p(_noise_p(xi + 1) + yi);\n    let bb = _noise_p(_noise_p(xi + 1) + yi + 1);\n    let x1 = _noise_lerp(_noise_grad2(aa, xf, yf), _noise_grad2(ba, xf - 1.0, yf), u);\n    let x2 = _noise_lerp(_noise_grad2(ab, xf, yf - 1.0), _noise_grad2(bb, xf - 1.0, yf - 1.0), u);\n    _noise_lerp(x1, x2, v)\n}"], "noise/simplex": ["const _NOISE_PERM: [i64; 256] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180];\nfn _noise_p(idx: i64) -> i64 { _NOISE_PERM[(idx & 255) as usize] }\nfn _noise_fade(t: f64) -> f64 { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfn _noise_lerp(a: f64, b: f64, t: f64) -> f64 { a + t * (b - a) }\nfn _noise_grad2(hash: i64, x: f64, y: f64) -> f64 {\n    let h = hash & 7;\n    let u = if h < 4 { x } else { y };\n    let v = if h < 4 { y } else { x };\n    (if h & 1 == 0 { u } else { -u }) + (if h & 2 == 0 { v } else { -v })\n}\nfn _noise_perlin(x: f64, y: f64, seed: f64) -> f64 {\n    let s = (seed.floor() as i64) & 255;\n    let xi = ((x.floor() as i64) + s) & 255;\n    let yi = ((y.floor() as i64) + s) & 255;\n    let xf = x - x.floor();\n    let yf = y - y.floor();\n    let u = _noise_fade(xf);\n    let v = _noise_fade(yf);\n    let aa = _noise_p(_noise_p(xi) + yi);\n    let ab = _noise_p(_noise_p(xi) + yi + 1);\n    let ba = _noise_p(_noise_p(xi + 1) + yi);\n    let bb = _noise_p(_noise_p(xi + 1) + yi + 1);\n    let x1 = _noise_lerp(_noise_grad2(aa, xf, yf), _noise_grad2(ba, xf - 1.0, yf), u);\n    let x2 = _noise_lerp(_noise_grad2(ab, xf, yf - 1.0), _noise_grad2(bb, xf - 1.0, yf - 1.0), u);\n    _noise_lerp(x1, x2, v)\n}", "fn _noise_simplex(x: f64, y: f64, seed: f64) -> f64 {\n    (_noise_perlin(x, y, seed) + _noise_perlin(x * 2.0 + 5.2, y * 2.0 + 1.3, seed) * 0.5 + _noise_perlin(x * 4.0 + 9.1, y * 4.0 + 7.7, seed) * 0.25) / 1.75\n}"], "noise/fbm": ["const _NOISE_PERM: [i64; 256] = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180];\nfn _noise_p(idx: i64) -> i64 { _NOISE_PERM[(idx & 255) as usize] }\nfn _noise_fade(t: f64) -> f64 { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }\nfn _noise_lerp(a: f64, b: f64, t: f64) -> f64 { a + t * (b - a) }\nfn _noise_grad2(hash: i64, x: f64, y: f64) -> f64 {\n    let h = hash & 7;\n    let u = if h < 4 { x } else { y };\n    let v = if h < 4 { y } else { x };\n    (if h & 1 == 0 { u } else { -u }) + (if h & 2 == 0 { v } else { -v })\n}\nfn _noise_perlin(x: f64, y: f64, seed: f64) -> f64 {\n    let s = (seed.floor() as i64) & 255;\n    let xi = ((x.floor() as i64) + s) & 255;\n    let yi = ((y.floor() as i64) + s) & 255;\n    let xf = x - x.floor();\n    let yf = y - y.floor();\n    let u = _noise_fade(xf);\n    let v = _noise_fade(yf);\n    let aa = _noise_p(_noise_p(xi) + yi);\n    let ab = _noise_p(_noise_p(xi) + yi + 1);\n    let ba = _noise_p(_noise_p(xi + 1) + yi);\n    let bb = _noise_p(_noise_p(xi + 1) + yi + 1);\n    let x1 = _noise_lerp(_noise_grad2(aa, xf, yf), _noise_grad2(ba, xf - 1.0, yf), u);\n    let x2 = _noise_lerp(_noise_grad2(ab, xf, yf - 1.0), _noise_grad2(bb, xf - 1.0, yf - 1.0), u);\n    _noise_lerp(x1, x2, v)\n}", "fn _noise_fbm(x: f64, y: f64, octaves_raw: f64, seed: f64) -> f64 {\n    let octaves = (octaves_raw.floor() as i64).clamp(1, 8);\n    let mut total = 0.0;\n    let mut freq = 1.0;\n    let mut amp = 1.0;\n    let mut max = 0.0;\n    for _ in 0..octaves {\n        total += _noise_perlin(x * freq, y * freq, seed) * amp;\n        max += amp;\n        freq *= 2.0;\n        amp *= 0.5;\n    }\n    total / max\n}"], "ease/apply": ["fn _ease_bounce(t: f64) -> f64 {\n    let n1 = 7.5625;\n    let d1 = 2.75;\n    if t < 1.0 / d1 {\n        n1 * t * t\n    } else if t < 2.0 / d1 {\n        let t2 = t - 1.5 / d1;\n        n1 * t2 * t2 + 0.75\n    } else if t < 2.5 / d1 {\n        let t2 = t - 2.25 / d1;\n        n1 * t2 * t2 + 0.9375\n    } else {\n        let t2 = t - 2.625 / d1;\n        n1 * t2 * t2 + 0.984375\n    }\n}\nfn _ease_apply(curve: &str, t: f64) -> f64 {\n    let t = t.clamp(0.0, 1.0);\n    match curve {\n        \"in-quad\" => t * t,\n        \"out-quad\" => t * (2.0 - t),\n        \"in-out-quad\" => if t < 0.5 { 2.0 * t * t } else { -1.0 + (4.0 - 2.0 * t) * t },\n        \"in-cubic\" => t * t * t,\n        \"out-cubic\" => { let f = t - 1.0; f * f * f + 1.0 }\n        \"in-out-cubic\" => if t < 0.5 { 4.0 * t * t * t } else { let f = 2.0 * t - 2.0; 0.5 * f * f * f + 1.0 },\n        \"elastic-out\" => if t == 0.0 || t == 1.0 { t } else {\n            let p = 0.3;\n            let s = p / 4.0;\n            2.0_f64.powf(-10.0 * t) * ((t - s) * (2.0 * std::f64::consts::PI) / p).sin() + 1.0\n        },\n        \"bounce-out\" => _ease_bounce(t),\n        _ => t,\n    }\n}"], "ease/smoothstep": ["fn _ease_smoothstep(e0: f64, e1: f64, x: f64) -> f64 {\n    if e0 == e1 { return 0.0; }\n    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}"], "anim/frame-at": ["fn _anim_frame_at(elapsed: f64, frame_dur: f64, frame_count: f64, looped: bool) -> f64 {\n    if frame_dur == 0.0 { panic!(\"anim/frame-at: frameDur must not be 0\"); }\n    if frame_count <= 0.0 { panic!(\"anim/frame-at: frameCount {} must be positive\", frame_count); }\n    let i = (elapsed / frame_dur).floor();\n    if looped {\n        let m = i % frame_count;\n        if m < 0.0 { m + frame_count } else { m }\n    } else {\n        i.min(frame_count - 1.0)\n    }\n}"], "anim/sheet-rect": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _anim_sheet_rect(frame_index: f64, cols: f64, frame_w: f64, frame_h: f64) -> _Obj {\n    if cols <= 0.0 { panic!(\"anim/sheet-rect: cols {} must be positive\", cols); }\n    let mut m = serde_json::Map::new();\n    m.insert(\"sx\".to_string(), _n((frame_index % cols) * frame_w));\n    m.insert(\"sy\".to_string(), _n((frame_index / cols).floor() * frame_h));\n    m.insert(\"sw\".to_string(), _n(frame_w));\n    m.insert(\"sh\".to_string(), _n(frame_h));\n    _Obj(serde_json::Value::Object(m))\n}"], "anim/direction-from-delta": ["fn _anim_direction(dx: f64, dy: f64, ways: f64) -> String {\n    if ways != 4.0 && ways != 8.0 { panic!(\"anim/direction-from-delta: ways {}: expected 4 or 8\", ways); }\n    let angle = dy.atan2(dx);\n    let two_pi = std::f64::consts::PI * 2.0;\n    let dir = if ways == 8.0 {\n        let sector = ((angle / (two_pi / 8.0)).round().rem_euclid(8.0)) as i64;\n        match sector { 0 => \"right\", 1 => \"down-right\", 2 => \"down\", 3 => \"down-left\", 4 => \"left\", 5 => \"up-left\", 6 => \"up\", 7 => \"up-right\", _ => \"right\" }\n    } else {\n        let sector = ((angle / (two_pi / 4.0)).round().rem_euclid(4.0)) as i64;\n        match sector { 0 => \"right\", 1 => \"down\", 2 => \"left\", 3 => \"up\", _ => \"right\" }\n    };\n    dir.to_string()\n}"], "bit/xor": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/and": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/or": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/not": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/shl": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/shr": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/rotl": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "bit/rotr": ["trait _BitIn { fn _bit_in(&self) -> f64; }\nimpl _BitIn for f64 { fn _bit_in(&self) -> f64 { *self } }\nimpl _BitIn for Option<f64> { fn _bit_in(&self) -> f64 { self.expect(\"bit: expected a number\") } }\nfn _bit_bounded(x: f64, max: u32) -> Option<u32> {\n    if x.is_finite() && x == x.trunc() && x >= 0.0 && x <= max as f64 { Some(x as u32) } else { None }\n}\nfn _bit_fold_words(w: &[f64], f: fn(u32, u32) -> u32) -> Option<f64> {\n    let words: Vec<Option<u32>> = w.iter().map(|x| _bit_bounded(*x, 4294967295_u32)).collect();\n    let mut acc = words[0]?;\n    for n in &words[1..] { acc = f(acc, (*n)?); }\n    Some(acc as f64)\n}\nmacro_rules! _bit_fold {\n    ($f:expr; $($x:expr),+ $(,)?) => { _bit_fold_words(&[$(_BitIn::_bit_in(&$x)),+], $f) };\n}\nfn _bit_shift<A: _BitIn, N: _BitIn>(a: &A, n: &N, f: fn(u32, u32) -> u32) -> Option<f64> {\n    let (a, n) = (a._bit_in(), n._bit_in());\n    let (a, n) = (_bit_bounded(a, 4294967295_u32)?, _bit_bounded(n, 31)?);\n    Some(f(a, n) as f64)\n}\nfn _bit_not<A: _BitIn>(a: &A) -> Option<f64> {\n    _bit_bounded(a._bit_in(), 4294967295_u32).map(|w| (!w) as f64)\n}"], "str/titleCase": ["fn _s_up_first(w: &str) -> String {\n    let mut c = w.chars();\n    match c.next() {\n        Some(f) => f.to_uppercase().to_string() + &c.collect::<String>().to_lowercase(),\n        None => String::new(),\n    }\n}", "fn _s_title(s: &str) -> String { s.split_whitespace().map(_s_up_first).collect::<Vec<_>>().join(\" \") }"], "str/camelCase": ["fn _s_up_first(w: &str) -> String {\n    let mut c = w.chars();\n    match c.next() {\n        Some(f) => f.to_uppercase().to_string() + &c.collect::<String>().to_lowercase(),\n        None => String::new(),\n    }\n}", "fn _s_camel(s: &str) -> String {\n    let words: Vec<&str> = s.split(|c: char| !c.is_alphanumeric()).filter(|w| !w.is_empty()).collect();\n    words.iter().enumerate().map(|(i, w)| if i == 0 { w.to_lowercase() } else { _s_up_first(w) }).collect::<String>()\n}"], "str/kebabCase": ["fn _s_case_words(s: &str) -> Vec<String> {\n    let chars: Vec<char> = s.chars().collect();\n    let mut words: Vec<String> = Vec::new();\n    let mut current = String::new();\n    for (i, &c) in chars.iter().enumerate() {\n        if !c.is_alphanumeric() {\n            if !current.is_empty() {\n                words.push(current.to_lowercase());\n                current = String::new();\n            }\n            continue;\n        }\n        if c.is_uppercase() && i > 0 {\n            let prev = chars[i - 1];\n            let next_lower = chars.get(i + 1).map_or(false, |n| n.is_lowercase());\n            let breaks = prev.is_lowercase() || prev.is_numeric() || (prev.is_uppercase() && next_lower);\n            if breaks && !current.is_empty() {\n                words.push(current.to_lowercase());\n                current = String::new();\n            }\n        }\n        current.push(c);\n    }\n    if !current.is_empty() {\n        words.push(current.to_lowercase());\n    }\n    words\n}"], "str/snakeCase": ["fn _s_case_words(s: &str) -> Vec<String> {\n    let chars: Vec<char> = s.chars().collect();\n    let mut words: Vec<String> = Vec::new();\n    let mut current = String::new();\n    for (i, &c) in chars.iter().enumerate() {\n        if !c.is_alphanumeric() {\n            if !current.is_empty() {\n                words.push(current.to_lowercase());\n                current = String::new();\n            }\n            continue;\n        }\n        if c.is_uppercase() && i > 0 {\n            let prev = chars[i - 1];\n            let next_lower = chars.get(i + 1).map_or(false, |n| n.is_lowercase());\n            let breaks = prev.is_lowercase() || prev.is_numeric() || (prev.is_uppercase() && next_lower);\n            if breaks && !current.is_empty() {\n                words.push(current.to_lowercase());\n                current = String::new();\n            }\n        }\n        current.push(c);\n    }\n    if !current.is_empty() {\n        words.push(current.to_lowercase());\n    }\n    words\n}"], "str/to-number": ["fn _s_radix_number(digits: &str, width: u32) -> f64 {\n    if digits.is_empty() { return f64::NAN; }\n    let mut length: u64 = 0;\n    let mut significand: u64 = 0;\n    let mut guard = false;\n    let mut sticky = false;\n    for byte in digits.bytes() {\n        let digit = match byte {\n            b'0'..=b'9' => byte - b'0',\n            b'a'..=b'f' => byte - b'a' + 10,\n            b'A'..=b'F' => byte - b'A' + 10,\n            _ => return f64::NAN,\n        };\n        if (digit as u32) >= (1u32 << width) { return f64::NAN; }\n        for shift in (0..width).rev() {\n            let bit = ((digit >> shift) & 1) as u64;\n            if length == 0 && bit == 0 { continue; }\n            length += 1;\n            match length {\n                1..=53 => significand = (significand << 1) | bit,\n                54 => guard = bit != 0,\n                _ => sticky |= bit != 0,\n            }\n        }\n    }\n    if length <= 53 { return significand as f64; }\n    if length > 1024 { return f64::INFINITY; }\n    let mut exponent: u64 = length - 1;\n    if guard && (sticky || significand & 1 != 0) { significand += 1; }\n    if significand == 1u64 << 53 {\n        significand >>= 1;\n        exponent += 1;\n    }\n    if exponent > 1023 { return f64::INFINITY; }\n    f64::from_bits(((exponent + 1023) << 52) | (significand & ((1u64 << 52) - 1)))\n}", "fn _s_to_number(text: &str) -> Option<f64> {\n    let text = text.trim_matches(|c: char| {\n        matches!(c,\n            '\\u{0009}'..='\\u{000d}' | '\\u{0020}' | '\\u{00a0}' | '\\u{1680}' |\n            '\\u{2000}'..='\\u{200a}' | '\\u{2028}' | '\\u{2029}' | '\\u{202f}' |\n            '\\u{205f}' | '\\u{3000}' | '\\u{feff}'\n        )\n    });\n    let n = if text.is_empty() {\n        0.0\n    } else if let Some(d) = text.strip_prefix(\"0x\").or_else(|| text.strip_prefix(\"0X\")) {\n        _s_radix_number(d, 4)\n    } else if let Some(d) = text.strip_prefix(\"0b\").or_else(|| text.strip_prefix(\"0B\")) {\n        _s_radix_number(d, 1)\n    } else if let Some(d) = text.strip_prefix(\"0o\").or_else(|| text.strip_prefix(\"0O\")) {\n        _s_radix_number(d, 3)\n    } else {\n        let (sign, unsigned) = match text.strip_prefix('-') {\n            Some(rest) => (-1.0, rest),\n            None => (1.0, text.strip_prefix('+').unwrap_or(text)),\n        };\n        if unsigned == \"Infinity\" {\n            sign * f64::INFINITY\n        } else if !unsigned.starts_with(|c: char| c.is_ascii_digit() || c == '.')\n            || !unsigned.bytes().all(|b| b.is_ascii_digit() || matches!(b, b'.' | b'e' | b'E' | b'+' | b'-'))\n            || !unsigned.bytes().any(|b| b.is_ascii_digit())\n        {\n            f64::NAN\n        } else {\n            unsigned.parse::<f64>().map_or(f64::NAN, |number| sign * number)\n        }\n    };\n    if n.is_nan() { None } else { Some(n) }\n}"], "str/encode-uri-component": ["fn _s_uri_encode(text: &str) -> String {\n    let mut out = String::with_capacity(text.len());\n    for &byte in text.as_bytes() {\n        if byte.is_ascii_alphanumeric() || b\"-_.!~*'()\".contains(&byte) {\n            out.push(byte as char);\n        } else {\n            out.push('%');\n            out.push(char::from_digit(u32::from(byte >> 4), 16).map_or('0', |c| c.to_ascii_uppercase()));\n            out.push(char::from_digit(u32::from(byte & 15), 16).map_or('0', |c| c.to_ascii_uppercase()));\n        }\n    }\n    out\n}"], "str/decode-uri-component": ["fn _s_uri_decode(text: &str) -> Option<String> {\n    fn flush(out: &mut String, pending: &mut Vec<u8>) -> Option<()> {\n        out.push_str(std::str::from_utf8(pending.as_slice()).ok()?);\n        pending.clear();\n        Some(())\n    }\n    let bytes = text.as_bytes();\n    let mut out = String::with_capacity(text.len());\n    let mut pending: Vec<u8> = Vec::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if bytes[i] == b'%' {\n            let hi = bytes.get(i + 1).and_then(|b| char::from(*b).to_digit(16));\n            let lo = bytes.get(i + 2).and_then(|b| char::from(*b).to_digit(16));\n            let (Some(hi), Some(lo)) = (hi, lo) else { return None; };\n            pending.push((hi * 16 + lo) as u8);\n            i += 3;\n        } else {\n            flush(&mut out, &mut pending)?;\n            let width = text[i..].chars().next().map_or(1, char::len_utf8);\n            out.push_str(&text[i..i + width]);\n            i += width;\n        }\n    }\n    flush(&mut out, &mut pending)?;\n    Some(out)\n}"], "str/uri-component-valid": ["fn _s_uri_decode(text: &str) -> Option<String> {\n    fn flush(out: &mut String, pending: &mut Vec<u8>) -> Option<()> {\n        out.push_str(std::str::from_utf8(pending.as_slice()).ok()?);\n        pending.clear();\n        Some(())\n    }\n    let bytes = text.as_bytes();\n    let mut out = String::with_capacity(text.len());\n    let mut pending: Vec<u8> = Vec::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if bytes[i] == b'%' {\n            let hi = bytes.get(i + 1).and_then(|b| char::from(*b).to_digit(16));\n            let lo = bytes.get(i + 2).and_then(|b| char::from(*b).to_digit(16));\n            let (Some(hi), Some(lo)) = (hi, lo) else { return None; };\n            pending.push((hi * 16 + lo) as u8);\n            i += 3;\n        } else {\n            flush(&mut out, &mut pending)?;\n            let width = text[i..].chars().next().map_or(1, char::len_utf8);\n            out.push_str(&text[i..i + width]);\n            i += width;\n        }\n    }\n    flush(&mut out, &mut pending)?;\n    Some(out)\n}"], "str/template": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "fn _s_tpl_num(n: &serde_json::Number) -> String {\n    match n.as_i64() {\n        Some(i) => i.to_string(),\n        None => _num_text(n.as_f64().unwrap_or(f64::NAN)),\n    }\n}", "fn _s_tpl_json(v: &serde_json::Value) -> String {\n    match v {\n        serde_json::Value::Null => \"null\".to_string(),\n        serde_json::Value::Bool(b) => b.to_string(),\n        serde_json::Value::Number(n) => _s_tpl_num(n),\n        serde_json::Value::String(s) => serde_json::to_string(s).expect(\"a string always writes\"),\n        serde_json::Value::Array(a) => format!(\"[{}]\", a.iter().map(_s_tpl_json).collect::<Vec<_>>().join(\",\")),\n        serde_json::Value::Object(o) => format!(\"{{{}}}\", o.iter().map(|(k, x)| format!(\"{}:{}\", serde_json::to_string(k).expect(\"a string always writes\"), _s_tpl_json(x))).collect::<Vec<_>>().join(\",\")),\n    }\n}", "fn _s_tpl_text(v: &serde_json::Value) -> String {\n    match v {\n        serde_json::Value::String(s) => s.clone(),\n        other => _s_tpl_json(other),\n    }\n}", "fn _s_template<D: serde::Serialize>(template: &str, data: &D) -> String {\n    let dv = _j(data);\n    let obj = dv.as_object().unwrap_or_else(|| panic!(\"str/template: expected an object\"));\n    let mut result = String::with_capacity(template.len());\n    let mut rest = template;\n    while let Some(open) = rest.find(\"{{\") {\n        result.push_str(&rest[..open]);\n        let after = &rest[open + 2..];\n        let found = after.find(\"}}\").and_then(|close| obj.get(&after[..close]).map(|value| (close, value)));\n        match found {\n            Some((close, value)) => {\n                result.push_str(&_s_tpl_text(value));\n                rest = &after[close + 2..];\n            }\n            None => {\n                result.push('{');\n                rest = &rest[open + 1..];\n            }\n        }\n    }\n    result.push_str(rest);\n    result\n}"], "base64/encode": ["fn _b64_encode(s: &str) -> String {\n    const T: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n    let mut out = String::new();\n    for ch in s.as_bytes().chunks(3) {\n        let n = ((ch[0] as u32) << 16) | ((*ch.get(1).unwrap_or(&0) as u32) << 8) | (*ch.get(2).unwrap_or(&0) as u32);\n        out.push(T[((n >> 18) & 63) as usize] as char);\n        out.push(T[((n >> 12) & 63) as usize] as char);\n        out.push(if ch.len() > 1 { T[((n >> 6) & 63) as usize] as char } else { '=' });\n        out.push(if ch.len() > 2 { T[(n & 63) as usize] as char } else { '=' });\n    }\n    out\n}"], "base64/decode": ["fn _b64_decode(s: &str) -> Option<String> {\n    let b = s.as_bytes();\n    if b.len() % 4 != 0 { return None; }\n    let val = |c: u8| -> Option<u32> {\n        match c {\n            b'A'..=b'Z' => Some((c - b'A') as u32),\n            b'a'..=b'z' => Some((c - b'a') as u32 + 26),\n            b'0'..=b'9' => Some((c - b'0') as u32 + 52),\n            b'+' => Some(62),\n            b'/' => Some(63),\n            _ => None,\n        }\n    };\n    let quanta = b.len() / 4;\n    let mut out: Vec<u8> = Vec::new();\n    for (qi, q) in b.chunks(4).enumerate() {\n        let pad = q.iter().rev().take_while(|&&c| c == b'=').count();\n        if pad > 2 || (pad > 0 && qi + 1 != quanta) { return None; }\n        let mut n: u32 = 0;\n        for &c in &q[..4 - pad] { n = (n << 6) | val(c)?; }\n        n <<= 6 * pad as u32;\n        if n & ((1u32 << (8 * pad as u32)) - 1) != 0 { return None; }\n        out.push((n >> 16) as u8);\n        if pad < 2 { out.push((n >> 8) as u8); }\n        if pad < 1 { out.push(n as u8); }\n    }\n    String::from_utf8(out).ok()\n}"], "base64/valid": ["fn _b64_decode(s: &str) -> Option<String> {\n    let b = s.as_bytes();\n    if b.len() % 4 != 0 { return None; }\n    let val = |c: u8| -> Option<u32> {\n        match c {\n            b'A'..=b'Z' => Some((c - b'A') as u32),\n            b'a'..=b'z' => Some((c - b'a') as u32 + 26),\n            b'0'..=b'9' => Some((c - b'0') as u32 + 52),\n            b'+' => Some(62),\n            b'/' => Some(63),\n            _ => None,\n        }\n    };\n    let quanta = b.len() / 4;\n    let mut out: Vec<u8> = Vec::new();\n    for (qi, q) in b.chunks(4).enumerate() {\n        let pad = q.iter().rev().take_while(|&&c| c == b'=').count();\n        if pad > 2 || (pad > 0 && qi + 1 != quanta) { return None; }\n        let mut n: u32 = 0;\n        for &c in &q[..4 - pad] { n = (n << 6) | val(c)?; }\n        n <<= 6 * pad as u32;\n        if n & ((1u32 << (8 * pad as u32)) - 1) != 0 { return None; }\n        out.push((n >> 16) as u8);\n        if pad < 2 { out.push((n >> 8) as u8); }\n        if pad < 1 { out.push(n as u8); }\n    }\n    String::from_utf8(out).ok()\n}"], "array/cosine": ["fn _arr_cosine_core(a: &[f64], b: &[f64]) -> Option<f64> {\n    if a.len() != b.len() || a.is_empty() { return None; }\n    let (mut dot, mut na, mut nb) = (0.0_f64, 0.0_f64, 0.0_f64);\n    for (x, y) in a.iter().zip(b.iter()) {\n        dot += x * y;\n        na += x * x;\n        nb += y * y;\n    }\n    if na == 0.0 || nb == 0.0 { return None; }\n    Some(dot / (na.sqrt() * nb.sqrt()))\n}\nfn _arr_cosine(a: &[f64], b: &[f64]) -> Option<f64> { _arr_cosine_core(a, b) }"], "array/nearest": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _arr_cosine_core(a: &[f64], b: &[f64]) -> Option<f64> {\n    if a.len() != b.len() || a.is_empty() { return None; }\n    let (mut dot, mut na, mut nb) = (0.0_f64, 0.0_f64, 0.0_f64);\n    for (x, y) in a.iter().zip(b.iter()) {\n        dot += x * y;\n        na += x * x;\n        nb += y * y;\n    }\n    if na == 0.0 || nb == 0.0 { return None; }\n    Some(dot / (na.sqrt() * nb.sqrt()))\n}\nfn _arr_cosine(a: &[f64], b: &[f64]) -> Option<f64> { _arr_cosine_core(a, b) }", "fn _arr_nearest(q: &[f64], cs: &[Vec<f64>]) -> _Obj {\n    if cs.is_empty() { return _Obj(serde_json::Value::Null); }\n    let mut scores: Vec<f64> = Vec::new();\n    for c in cs {\n        match _arr_cosine_core(q, c) {\n            Some(s) => scores.push(s),\n            None => return _Obj(serde_json::Value::Null),\n        }\n    }\n    let mut best_idx = 0usize;\n    let mut best = scores[0];\n    for (i, s) in scores.iter().enumerate().skip(1) {\n        if *s > best { best = *s; best_idx = i; }\n    }\n    let mut second = f64::NEG_INFINITY;\n    for (i, s) in scores.iter().enumerate() {\n        if i != best_idx && *s > second { second = *s; }\n    }\n    let margin = if scores.len() == 1 { 0.0 } else { best - second };\n    let mut m = serde_json::Map::new();\n    m.insert(\"index\".to_string(), _n(best_idx as f64));\n    m.insert(\"score\".to_string(), _n(best));\n    m.insert(\"margin\".to_string(), _n(margin));\n    _Obj(serde_json::Value::Object(m))\n}"], "array/groupBy": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _arr_group_field<T: Clone + serde::Serialize>(a: &[T], field: &str) -> std::collections::BTreeMap<String, Vec<T>> {\n    let mut groups: std::collections::BTreeMap<String, Vec<T>> = std::collections::BTreeMap::new();\n    for item in a {\n        let v = _j(item);\n        let row = v.as_object().unwrap_or_else(|| panic!(\"array/groupBy: an item is not an object\"));\n        let key = match row.get(field) {\n            Some(serde_json::Value::String(t)) => t.clone(),\n            Some(serde_json::Value::Null) | None => panic!(\"array/groupBy: an item has no {} key; default it to group the item\", field),\n            Some(_) => panic!(\"array/groupBy: the {} key is not a string\", field),\n        };\n        groups.entry(key).or_default().push(item.clone());\n    }\n    groups\n}"], "array/preduce": ["fn _arr_preduce<T: Clone + serde::Serialize + serde::de::DeserializeOwned, A: Clone + serde::Serialize + serde::de::DeserializeOwned>(a: &[T], init: A, f: impl Fn(A, T) -> A) -> A {\n    fn conv<X: serde::Serialize, Y: serde::de::DeserializeOwned>(x: &X) -> Y {\n        serde_json::from_value(serde_json::to_value(x).expect(\"a serializable value\")).expect(\"preduce: the item and accumulator types differ\")\n    }\n    let mut chunks: Vec<A> = Vec::new();\n    for chunk in a.chunks(1024) {\n        let mut acc: A = conv(&chunk[0]);\n        for item in &chunk[1..] { acc = f(acc, item.clone()); }\n        chunks.push(acc);\n    }\n    let mut acc = init;\n    for c in chunks { acc = f(acc, conv(&c)); }\n    acc\n}"], "time/add": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "#[derive(Clone, Copy, PartialEq)]\nenum _TimeUnit { Ms, S, Min, H, D, W, Mo, Q, Y }", "fn _time_unit(u: &str) -> _TimeUnit {\n    match u {\n        \"ms\" | \"millisecond\" | \"milliseconds\" => _TimeUnit::Ms,\n        \"s\" | \"second\" | \"seconds\" => _TimeUnit::S,\n        \"m\" | \"minute\" | \"minutes\" => _TimeUnit::Min,\n        \"h\" | \"hour\" | \"hours\" => _TimeUnit::H,\n        \"d\" | \"day\" | \"days\" => _TimeUnit::D,\n        \"w\" | \"week\" | \"weeks\" => _TimeUnit::W,\n        \"month\" | \"months\" => _TimeUnit::Mo,\n        \"quarter\" | \"quarters\" => _TimeUnit::Q,\n        \"year\" | \"years\" => _TimeUnit::Y,\n        _ => panic!(\"expected time unit (ms|millisecond(s), s|second(s), m|minute(s), h|hour(s), d|day(s), w|week(s), month(s), quarter(s), year(s)), got {}\", u),\n    }\n}", "fn _time_fixed(u: _TimeUnit) -> Option<f64> {\n    match u {\n        _TimeUnit::Ms => Some(1.0),\n        _TimeUnit::S => Some(1000.0),\n        _TimeUnit::Min => Some(60_000.0),\n        _TimeUnit::H => Some(3_600_000.0),\n        _TimeUnit::D => Some(86_400_000.0),\n        _TimeUnit::W => Some(604_800_000.0),\n        _ => None,\n    }\n}\nfn _time_below_day(u: _TimeUnit) -> bool { matches!(u, _TimeUnit::Ms | _TimeUnit::S | _TimeUnit::Min | _TimeUnit::H) }", "fn _time_ymd(ts: f64) -> (i64, i64, i64) {\n    let days = (ts / 86_400_000.0).floor() as i64;\n    let shifted = days + 719_468;\n    let era = shifted.div_euclid(146_097);\n    let doe = shifted.rem_euclid(146_097);\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let day = doy - (153 * mp + 2) / 5 + 1;\n    let month = if mp < 10 { mp + 3 } else { mp - 9 };\n    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };\n    (year, month, day)\n}\nfn _time_ts(year: i64, month: i64, day: i64) -> f64 {\n    let y = year - if month <= 2 { 1 } else { 0 };\n    let era = y.div_euclid(400);\n    let yoe = y.rem_euclid(400);\n    let mp = (month + 9) % 12;\n    let doy = (153 * mp + 2) / 5 + day - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    ((era * 146_097 + doe - 719_468) as f64) * 86_400_000.0\n}\nfn _time_dim(y: i64, m: i64) -> i64 {\n    match m {\n        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,\n        4 | 6 | 9 | 11 => 30,\n        2 => if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 },\n        _ => 30,\n    }\n}", "fn _time_parts(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_add_months(ts: f64, months: i64) -> f64 {\n    let (y, m, d) = _time_ymd(ts);\n    let tod = ts - _time_ts(y, m, d);\n    let total = y * 12 + (m - 1) + months;\n    let ny = total.div_euclid(12);\n    let nm = total.rem_euclid(12) + 1;\n    _time_ts(ny, nm, d.min(_time_dim(ny, nm))) + tod\n}\nfn _time_shift(ts: f64, amount: f64, u: _TimeUnit) -> f64 {\n    match _time_fixed(u) {\n        Some(ms) => ts + amount * ms,\n        None => {\n            if amount.fract() != 0.0 || amount.abs() > 4294967295.0 { panic!(\"a calendar unit takes a whole amount, got {}\", amount); }\n            let months = match u { _TimeUnit::Y => amount as i64 * 12, _TimeUnit::Q => amount as i64 * 3, _ => amount as i64 };\n            _time_add_months(ts, months)\n        }\n    }\n}\nfn _time_add(text: