\n    x.as_f64().unwrap_or_else(|| panic!(\"{}: field {} of argument {} is not a number\", op, f, param))\n}", "#[derive(Clone, Copy)]\nstruct _V { x: f64, y: f64, z: f64, has_z: bool }\nfn _vec<T: serde::Serialize>(a: &T, op: &str, param: &str) -> _V {\n    let v = _j(a);\n    let x = _fld(&v, op, param, \"x\");\n    let y = _fld(&v, op, param, \"y\");\n    match v.get(\"z\") {\n        Some(z) => _V { x, y, z: z.as_f64().unwrap_or_else(|| panic!(\"{}: field z of argument {} is not a number\", op, param)), has_z: true },\n        None => _V { x, y, z: 0.0, has_z: false },\n    }\n}\nfn _mkvec(x: f64, y: f64, z: f64, with_z: bool) -> _Obj {\n    let mut m = serde_json::Map::new();\n    m.insert(\"x\".to_string(), _n(x));\n    m.insert(\"y\".to_string(), _n(y));\n    if with_z { m.insert(\"z\".to_string(), _n(z)); }\n    _Obj(serde_json::Value::Object(m))\n}\nfn _dot3(a: &_V, b: &_V) -> f64 { a.x * b.x + a.y * b.y + a.z * b.z }", "fn _vec_heading<A: serde::Serialize>(a: &A) -> f64 {\n    let a = _vec(a, \"vec/angle\", \"a\");\n    a.y.atan2(a.x)\n}", "fn _vec_angle<A: serde::Serialize, B: serde::Serialize>(a: &A, b: &B) -> f64 {\n    let (a, b) = (_vec(a, \"vec/angle\", \"a\"), _vec(b, \"vec/angle\", \"b\"));\n    let (la, lb) = (_dot3(&a, &a).sqrt(), _dot3(&b, &b).sqrt());\n    if la == 0.0 || lb == 0.0 { return 0.0; }\n    (_dot3(&a, &b) / (la * lb)).clamp(-1.0, 1.0).acos()\n}"], "vec/rotate": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value