nfn _dyn_rx_hex(c: &[char], at: usize, len: usize) -> Option<u32> {\n    let d = c.get(at..at + len)?;\n    if !d.iter().all(|x| x.is_ascii_hexdigit()) { return None; }\n    u32::from_str_radix(&d.iter().collect::<String>(), 16).ok()\n}\nfn _dyn_rx_prop(c: &[char], at: usize) -> Option<(String, usize)> {\n    if c.get(at + 1) != Some(&'{') { return None; }\n    let rest = c.get(at + 2..)?;\n    let close = at + 2 + rest.iter().position(|x| *x == '}')?;\n    let name: String = c[at + 2..close].iter().collect();\n    if _DYN_RX_CATEGORIES.contains(&name.as_str()) { Some((name, close + 1)) } else { None }\n}\nfn _dyn_rx_class_atom(c: &[char], at: usize) -> Option<(_DynRxAtom, usize)> {\n    let ch = *c.get(at)?;\n    if ch == '[' || ch == ']' { return None; }\n    if ch != '\\\\' {\n        if matches!(ch, '&' | '~' | '-') && c.get(at + 1) == Some(&ch) { return None; }\n        return Some((_DynRxAtom::Char(ch as u32), at + 1));\n    }\n    let e = *c.get(at + 1)?;\n    match e {\n        'd' => Some((_DynRxAtom::Set(vec![_DynRxItem::Range(48, 57)]), at + 2)),\n        'w' => Some((_DynRxAtom::Set(_dyn_rx_word()), at + 2)),\n        's' => Some((_DynRxAtom::Set(_dyn_rx_space()), at + 2)),\n        'p' | 'P' => {\n            let (name, end) = _dyn_rx_prop(c, at + 1)?;\n            Some((_DynRxAtom::Set(vec![_DynRxItem::Prop(name, e == 'P')]), end))\n        }\n        '-' => Some((_DynRxAtom::Char('-' as u32), at + 2)),\n        _ if \"\\\\^$.*+?()[]{}|/\".contains(e) => Some((_DynRxAtom::Char(e as u32), at + 2)),\n        _ if _dyn_rx_escape_char(e).is_some() => Some((_DynRxAtom::Char(_dyn_rx_escape_char(e)? as u32), at + 2)),\n        'x' => Some((_DynRxAtom::Char(_dyn_rx_hex(c, at + 2, 2)?), at + 4)),\n        'u' => {\n            let code = _dyn_rx_hex(c, at + 2, 4)?;\n            if (0xD800..=0xDFFF).contains(&code) { None } else { Some((_DynRxAtom::Char(code), at + 6)) }\n        }\n        _ => None,\n    }\n}\nstruct _DynRxParser { c: Vec<char>, i: usize }\nimpl _DynRxParser {\n    fn alt(&mut self, depth: usize) -> Option<_DynRxNode> {\n        let mut branches = vec![self.seq(depth)?];\n        while self.c.get(self.i) == Some(&'|') {\n            self.i += 1;\n            branches.push(self.seq(depth)?);\n        }\n        Some(if branches.len() == 1 { branches.remove(0) } else { _DynRxNode::Alt(branches) })\n    }\n    fn seq(&mut self, depth: usize) -> Option<_DynRxNode> {\n        let mut items: Vec<_DynRxNode> = Vec::new();\n        loop {\n            match self.c.get(self.i).copied() {\n                None | Some('|') => break,\n                Some(')') => {\n                    if depth == 0 { return None; }\n                    break;\n                }\n                Some(_) => {}\n            }\n            let (node, quantifiable) = self.atom(depth)?;\n            let node = if quantifiable { self.quantified(node)? } else { node };\n            items.push(node);\n        }\n        Some(_DynRxNode::Cat(items))\n    }\n    fn digits(&self, j: &mut usize) -> Option<usize> {\n        let from = *j;\n        while self.c.get(*j).map_or(false, |x| x.is_ascii_digit()) { *j += 1; }\n        if *j == from { return None; }\n        let text: String = self.c[from..*j].iter().collect();\n        Some(text.parse::<usize>().unwrap_or(usize::MAX))\n    }\n    fn quantified(&mut self, node: _DynRxNode) -> Option<_DynRxNode> {\n        let (min, max) = match self.c.get(self.i).copied() {\n            Some('*') => { self.i += 1; (0, usize::MAX) }\n            Some('+') => { self.i += 1; (1, usize::MAX) }\n            Some('?') => { self.i += 1; (0, 1) }\n            Some('{') => {\n                let mut j = self.i + 1;\n                let low = self.digits(&mut j)?;\n                if low > 1000 { return None; }\n                let mut high = low;\n                if self.c.get(j) == Some(&',') {\n                    j += 1;\n                    high = match self.digits(&mut j) {\n                        Some(h) => {\n                            if h > 1000 || h < low { return None; }\n                            h\n                        }\n                        None => usize::MAX,\n                    };\n                }\n                if self.c.get(j) != Some(&'}') { return None; }\n                self.i = j + 1;\n                (low, high)\n            }\n            _ => return Some(node),\n        };\n        let mut greedy = true;\n        if self.c.get(self.i) == Some(&'?') {\n            self.i += 1;\n            greedy = false;\n        }\n        Some(_DynRxNode::Rep(Box::new(node), min, max, greedy))\n    }\n    fn class(&mut self) -> Option<_DynRxNode> {\n        let mut i = self.i + 1;\n        let mut neg = false;\n        if self.c.get(i) == Some(&'^') {\n            neg = true;\n            i += 1;\n        }\n        if self.c.get(i) == Some(&']') { return None; }\n        let mut items: Vec<_DynRxItem> = Vec::new();\n        while i < self.c.len() {\n            if self.c[i] == ']' {\n                self.i = i + 1;\n                return Some(_DynRxNode::Set(neg, items));\n            }\n            let (first, next) = _dyn_rx_class_atom(&self.c, i)?;\n            i = next;\n            let range_follows = self.c.get(i) == Some(&'-') && self.c.get(i + 1) != Some(&']');\n            match first {\n                _DynRxAtom::Set(set) => {\n                    if range_follows { return None; }\n                    items.extend(set);\n                }\n                _DynRxAtom::Char(low) => {\n                    if range_follows {\n                        let (second, next) = _dyn_rx_class_atom(&self.c, i + 1)?;\n                        let high = match second {\n                            _DynRxAtom::Char(h) => h,\n                            _ => return None,\n                        };\n                        if low > high { return None; }\n                        items.push(_DynRxItem::Range(low, high));\n                        i = next;\n                    } else {\n                        items.push(_DynRxItem::Range(low, low));\n                    }\n                }\n            }\n        }\n        None\n    }\n    fn atom(&mut self, depth: usize) -> Option<(_DynRxNode, bool)> {\n        let ch = *self.c.get(self.i)?;\n        match ch {\n            '(' => {\n                self.i += 1;\n                if self.c.get(self.i) == Some(&'?') {\n                    if self.c.get(self.i + 1) != Some(&':') { return None; }\n                    self.i += 2;\n                }\n                let inner = self.alt(depth + 1)?;\n                if self.c.get(self.i) != Some(&')') { return None; }\n                self.i += 1;\n                Some((inner, true))\n            }\n            '^' => { self.i += 1; Some((_DynRxNode::Start, false)) }\n            '$' => { self.i += 1; Some((_DynRxNode::End, false)) }\n            '*' | '+' | '?' | '{' | '}' | ']' => None,\n            '.' => { self.i += 1; Some((_DynRxNode::Any, true)) }\n            '[' => {\n                let node = self.class()?;\n                Some((node, true))\n            }\n            '\\\\' => {\n                let e = *self.c.get(self.i + 1)?;\n                match e {\n                    'b' => { self.i += 2; Some((_DynRxNode::Boundary(true), false)) }\n                    'B' => { self.i += 2; Some((_DynRxNode::Boundary(false), false)) }\n                    'd' => { self.i += 2; Some((_DynRxNode::Set(false, vec![_DynRxItem::Range(48, 57)]), true)) }\n                    'D' => { self.i += 2; Some((_DynRxNode::Set(true, vec![_DynRxItem::Range(48, 57)]), true)) }\n                    'w' => { self.i += 2; Some((_DynRxNode::Set(false, _dyn_rx_word()), true)) }\n                    'W' => { self.i += 2; Some((_DynRxNode::Set(true, _dyn_rx_word()), true)) }\n                    's' => { self.i += 2; Some((_DynRxNode::Set(false, _dyn_rx_space()), true)) }\n                    'S' => { self.i += 2; Some((_DynRxNode::Set(true, _dyn_rx_space()), true)) }\n                    'p' | 'P' => {\n                        let (name, end) = _dyn_rx_prop(&self.c, self.i + 1)?;\n                        self.i = end;\n                        Some((_DynRxNode::Set(false, vec![_DynRxItem::Prop(name, e == 'P')]), true))\n                    }\n                    'x' => {\n                        let code = _dyn_rx_hex(&self.c, self.i + 2, 2)?;\n                        self.i += 4;\n                        Some((_DynRxNode::Char(char::from_u32(code)?), true))\n                    }\n                    'u' => {\n                        let code = _dyn_rx_hex(&self.c, self.i + 2, 4)?;\n                        if (0xD800..=0xDFFF).contains(&code) { return None; }\n                        self.i += 6;\n                        Some((_DynRxNode::Char(char::from_u32(code)?), true))\n                    }\n                    _ if \"\\\\^$.*+?()[]{}|/\".contains(e) => { self.i += 2; Some((_DynRxNode::Char(e), true)) }\n                    _ if _dyn_rx_escape_char(e).is_some() => { self.i += 2; Some((_DynRxNode::Char(_dyn_rx_escape_char(e)?), true)) }\n                    _ => None,\n                }\n            }\n            _ => { self.i += 1; Some((_DynRxNode::Char(ch), true)) }\n        }\n    }\n}\nfn _dyn_rx_parse(p: &str) -> Option<_DynRxNode> {\n    let mut ps = _DynRxParser { c: p.chars().collect(), i: 0 };\n    let n = ps.alt(0)?;\n    if ps.i == ps.c.len() { Some(n) } else { None }\n}", "fn _dyn_rx_leaf(name: &str, ch: char) -> bool {\n    let x = ch as u32;\n    _dyn_rx_table(name).split(';').any(|r| match r.split_once('-') {\n        Some((a, b)) => match (u32::from_str_radix(a, 16), u32::from_str_radix(b, 16)) {\n            (Ok(lo), Ok(hi)) => lo <= x && x <= hi,\n            _ => false,\n        },\n        None => false,\n    })\n}\nfn _dyn_rx_prop_has(name: &str, ch: char) -> bool {\n    let leaves: &[&str] = match name {\n        \"L\" => &[\"Lu\", \"Ll\", \"Lt\", \"Lm\", \"Lo\"],\n        \"M\" => &[\"Mn\", \"Mc\", \"Me\"],\n        \"N\" => &[\"Nd\", \"Nl\", \"No\"],\n        \"P\" => &[\"Pc\", \"Pd\", \"Ps\", \"Pe\", \"Pi\", \"Pf\", \"Po\"],\n        \"S\" => &[\"Sm\", \"Sc\", \"Sk\", \"So\"],\n        \"Z\" => &[\"Zs\", \"Zl\", \"Zp\"],\n        _ => return _dyn_rx_leaf(name, ch),\n    };\n    leaves.iter().any(|l| _dyn_rx_leaf(l, ch))\n}\nfn _dyn_rx_item_has(items: &[_DynRxItem], ch: char) -> bool {\n    let x = ch as u32;\n    items.iter().any(|it| match it {\n        _DynRxItem::Range(lo, hi) => *lo <= x && x <= *hi,\n        _DynRxItem::Prop(name, neg) => _dyn_rx_prop_has(name, ch) != *neg,\n    })\n}\nfn _dyn_rx_word_ch(ch: char) -> bool { ch.is_ascii_alphanumeric() || ch == '_' }\nfn _dyn_rx_m(n: &_DynRxNode, c: &[char], i: usize, k: &mut dyn FnMut(usize) -> bool) -> bool {\n    match n {\n        _DynRxNode::Char(x) => i < c.len() && c[i] == *x && k(i + 1),\n        _DynRxNode::Any => i < c.len() && !matches!(c[i], '\\n' | '\\r' | '\\u{2028}' | '\\u{2029}') && k(i + 1),\n        _DynRxNode::Set(neg, items) => i < c.len() && (_dyn_rx_item_has(items, c[i]) != *neg) && k(i + 1),\n        _DynRxNode::Start => i == 0 && k(i),\n        _DynRxNode::End => i == c.len() && k(i),\n        _DynRxNode::Boundary(want) => {\n            let before = i > 0 && _dyn_rx_word_ch(c[i - 1]);\n            let after = i < c.len() && _dyn_rx_word_ch(c[i]);\n            ((before != after) == *want) && k(i)\n        }\n        _DynRxNode::Cat(ns) => _dyn_rx_cat(ns, c, i, k),\n        _DynRxNode::Alt(ns) => {\n            for b in ns {\n                if _dyn_rx_m(b, c, i, &mut *k) { return true; }\n            }\n            false\n        }\n        _DynRxNode::Rep(inner, min, max, greedy) => _dyn_rx_rep(inner, *min, *max, *greedy, c, i, 0, k),\n    }\n}\nfn _dyn_rx_cat(ns: &[_DynRxNode], c: &[char], i: usize, k: &mut dyn FnMut(usize) -> bool) -> bool {\n    match ns.split_first() {\n        None => k(i),\n        Some((head, rest)) => _dyn_rx_m(head, c, i, &mut |j| _dyn_rx_cat(rest, c, j, &mut *k)),\n    }\n}\nfn _dyn_rx_rep(n: &_DynRxNode, min: usize, max: usize, greedy: bool, c: &[char], i: usize, count: usize, k: &mut dyn FnMut(usize) -> bool) -> bool {\n    if count < min {\n        return _dyn_rx_m(n, c, i, &mut |j| _dyn_rx_rep(n, min, max, greedy, c, j, count + 1, &mut *k));\n    }\n    if greedy {\n        if count < max && _dyn_rx_m(n, c, i, &mut |j| j > i && _dyn_rx_rep(n, min, max, greedy, c, j, count + 1, &mut *k)) { return true; }\n        k(i)\n    } else {\n        if k(i) { return true; }\n        count < max && _dyn_rx_m(n, c, i, &mut |j| j > i && _dyn_rx_rep(n, min, max, greedy, c, j, count + 1, &mut *k))\n    }\n}\nfn _dyn_rx_search(re: &_DynRxNode, text: &str) -> bool {\n    let c: Vec<char> = text.chars().collect();\n    (0..=c.len()).any(|s| _dyn_rx_m(re, &c, s, &mut |_| true))\n}\nfn _dyn_pattern(v: &str, p: &str) -> bool { _dyn_rx_parse(p).map_or(false, |re| _dyn_rx_search(&re, v)) }"], "validate/url": ["fn _dyn_rx_table(name: &str) -> &'static str {\n    match name {\n        \"Lu\" => \"41-5a;c0-d6;d8-de;100-100;102-102;104-104;106-106;108-108;10a-10a;10c-10c;10e-10e;110-110;112-112;114-114;116-116;118-118;11a-11a;11c-11c;11e-11e;120-120;122-122;124-124;126-126;128-128;12a-12a;12c-12c;12e-12e;130-130;132-132;134-134;136-136;139-139;13b-13b;13d-13d;13f-13f;141-141;143-143;145-145;147-147;14a-14a;14c-14c;14e-14e;150-150;152-152;154-154;156-156;158-158;15a-15a;15c-15c;15e-15e;160-160;162-162;164-164;166-166;168-168;16a-16a;16c-16c;16e-16e;170-170;172-172;174-174;176-176;178-179;17b-17b;17d-17d;181-182;184-184;186-187;189-18b;18e-191;193-194;196-198;19c-19d;19f-1a0;1a2-1a2;1a4-1a4;1a6-1a7;1a9-1a9;1ac-1ac;1ae-1af;1b1-1b3;1b5-1b5;1b7-1b8;1bc-1bc;1c4-1c4;1c7-1c7;1ca-1ca;1cd-1cd;1cf-1cf;1d1-1d1;1d3-1d3;1d5-1d5;1d7-1d7;1d9-1d9;1db-1db;1de-1de;1e0-1e0;1e2-1e2;1e4-1e4;1e6-1e6;1e8-1e8;1ea-1ea;1ec-1ec;1ee-1ee;1f1-1f1;1f4-1f4;1f6-1f8;1fa-1fa;1fc-1fc;1fe-1fe;200-200;202-202;204-204;206-206;208-208;20a-20a;20