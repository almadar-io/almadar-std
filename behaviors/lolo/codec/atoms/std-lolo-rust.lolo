| _TimeUnit::Min | _TimeUnit::H) }", "fn _time_ymd(ts: f64) -> (i64, i64, i64) {\n    let days = (ts / 86_400_000.0).floor() as i64;\n    let shifted = days + 719_468;\n    let era = shifted.div_euclid(146_097);\n    let doe = shifted.rem_euclid(146_097);\n    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let day = doy - (153 * mp + 2) / 5 + 1;\n    let month = if mp < 10 { mp + 3 } else { mp - 9 };\n    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };\n    (year, month, day)\n}\nfn _time_ts(year: i64, month: i64, day: i64) -> f64 {\n    let y = year - if month <= 2 { 1 } else { 0 };\n    let era = y.div_euclid(400);\n    let yoe = y.rem_euclid(400);\n    let mp = (month + 9) % 12;\n    let doy = (153 * mp + 2) / 5 + day - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    ((era * 146_097 + doe - 719_468) as f64) * 86_400_000.0\n}\nfn _time_dim(y: i64, m: i64) -> i64 {\n    match m {\n        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,\n        4 | 6 | 9 | 11 => 30,\n        2 => if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 },\n        _ => 30,\n    }\n}", "fn _time_parts(ms: f64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {\n    if !ms.is_finite() { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    let t = ms.floor() as i64;\n    let days = t.div_euclid(86_400_000);\n    let rem = t.rem_euclid(86_400_000);\n    let (y, mo, d) = _time_ymd(t as f64);\n    if y < 0 || y > 9999 { panic!(\"{} ms is outside the years 0000 to 9999\", ms); }\n    (y, mo, d, rem / 3_600_000, rem % 3_600_000 / 60_000, rem % 60_000 / 1000, rem % 1000, (days + 4).rem_euclid(7))\n}\nfn _time_render(ms: f64, date: bool) -> String {\n    let (y, mo, d, h, mi, s, ml, _) = _time_parts(ms);\n    if date {\n        format!(\"{:04}-{:02}-{:02}\", y, mo, d)\n    } else {\n        format!(\"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", y, mo, d, h, mi, s, ml)\n    }\n}", "fn _time_parse(text: &str) -> Option<(i64, bool)> {\n    let b = text.as_bytes();\n    let num = |from: usize, len: usize| -> Option<i64> {\n        let slice = b.get(from..from + len)?;\n        if slice.iter().all(|c| c.is_ascii_digit()) { std::str::from_utf8(slice).ok()?.parse::<i64>().ok() } else { None }\n    };\n    if b.get(4) != Some(&b'-') || b.get(7) != Some(&b'-') { return None; }\n    let (y, m, d) = (num(0, 4)?, num(5, 2)?, num(8, 2)?);\n    if m < 1 || m > 12 || d < 1 || d > _time_dim(y, m) { return None; }\n    let mut ms = _time_ts(y, m, d) as i64;\n    if b.len() == 10 { return Some((ms, true)); }\n    if b.get(10) != Some(&b'T') || b.get(13) != Some(&b':') { return None; }\n    let (hour, minute) = (num(11, 2)?, num(14, 2)?);\n    if hour > 23 || minute > 59 { return None; }\n    ms += hour * 3_600_000 + minute * 60_000;\n    let mut at = 16usize;\n    if b.get(at) == Some(&b':') {\n        let second = num(at + 1, 2)?;\n        if second > 59 { return None; }\n        ms += second * 1000;\n        at += 3;\n        if b.get(at) == Some(&b'.') {\n            let start = at + 1;\n            let mut end = start;\n            while b.get(end).map_or(false, |c| c.is_ascii_digit()) { end += 1; }\n            if end == start { return None; }\n            let padded = format!(\"{:0<3}\", &text[start..end]);\n            ms += padded[..3].parse::<i64>().ok()?;\n            at = end;\n        }\n    }\n    let zone = &text[at..];\n    if zone == \"Z\" { return Some((ms, false)); }\n    if zone.len() == 6 && (b[at] == b'+' || b[at] == b'-') && b[at + 3] == b':' {\n        let (oh, om) = (num(at + 1, 2)?, num(at + 4, 2)?);\n        if oh > 23 || om > 59 { return None; }\n        let offset = (oh * 60 + om) * 60_000;\n        return Some((if b[at] == b'-' { ms + offset } else { ms - offset }, false));\n    }\n    None\n}\nfn _time_moment(text: &str) -> (f64, bool) {\n    match _time_parse(text) {\n        Some((ms, d)) => (ms as f64, d),\n        None => panic!(\"expected date or datetime (ISO-8601 text), got \\\"{}\\\"\", text),\n    }\n}\nfn _time_needs(op: &str) -> ! { panic!(\"{} needs a time of day and a date carries none: pass a datetime\", op) }\nfn _time_same_shape(a: bool, b: bool, op: &str) {\n    if a != b { panic!(\"expected two dates or two datetimes: {} got a date and a datetime: convert one explicitly\", op); }\n}", "fn _time_now() -> f64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as f64).unwrap_or(0.0) }", "fn _time_relative(text: &str) -> String {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/relative\"); }\n    let diff = _time_now() - ts;\n    let plural = |n: i64| if n == 1 { \"\" } else { \"s\" };\n    let phrase = |n: i64, unit: &str| if diff < 0.0 { format!(\"in {} {}{}\", n, unit, plural(n)) } else { format!(\"{} {}{} ago\", n, unit, plural(n)) };\n    let ms = diff.abs();\n    let (minute, hour, day) = (60_000.0, 3_600_000.0, 86_400_000.0);\n    if ms < minute { \"just now\".to_string() }\n    else if ms < hour { phrase((ms / minute).round() as i64, \"minute\") }\n    else if ms < day { phrase((ms / hour).round() as i64, \"hour\") }\n    else if ms < 7.0 * day { phrase((ms / day).round() as i64, \"day\") }\n    else if ms < 30.0 * day { phrase((ms / (7.0 * day)).round() as i64, \"week\") }\n    else if ms < 365.0 * day { phrase((ms / (30.0 * day)).round() as i64, \"month\") }\n    else { phrase((ms / (365.0 * day)).round() as i64, \"year\") }\n}\nfn _time_past(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isPast\"); }\n    ts < _time_now()\n}\nfn _time_future(text: &str) -> bool {\n    let (ts, date) = _time_moment(text);\n    if date { _time_needs(\"time/isFuture\"); }\n    ts > _time_now()\n}\nfn _time_today(text: &str) -> bool {\n    let (ts, _) = _time_moment(text);\n    (ts / 86_400_000.0).floor() == (_time_now() / 86_400_000.0).floor()\n}\nfn _time_midnight() -> String { _time_render((_time_now() / 86_400_000.0).floor() * 86_400_000.0, false) }\nfn _time_now_text() -> String { _time_render(_time_now(), false) }"], "time/isFuture": ["#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "#[derive(Clone, Copy, PartialEq)]\nenum _TimeUnit { Ms, S, Min, H, D, W, Mo, Q, Y }", "fn _time_unit(u: &str) -> _TimeUnit {\n    match u {\n        \"ms\" | \"millisecond\" | \"milliseconds\" => _TimeUnit::Ms,\n        \"s\" | \"second\" | \"seconds\" => _TimeUnit::S,\n        \"m\" | \"minute\" | \"minutes\" => _TimeUnit::Min,\n        \"h\" | \"hour\" | \"hours\" => _TimeUnit::H,\n        \"d\" | \"day\" | \"days\" => _TimeUnit::D,\n        \"w\" | \"week\" | \"weeks\" => _TimeUnit::