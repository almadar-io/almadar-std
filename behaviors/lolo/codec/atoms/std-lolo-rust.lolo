app std-lolo-rust [
  version: "2.0.0",
  description: "std-lolo-rust \u{2014} renders .lolo source as Rust text, so a learner who reads an exercise written in .lolo can see the same program as Rust that compiles against the Rust shell's generated models and gives the kernel's answers. It is std-lolo-source with the Rust vocabulary in config and nothing else: LOLO_TO_RUST { source, path } answers RUST_RENDERED { text, warnings }, or RUST_RENDER_FAILED { error } when the source cannot be read or the request carries no path (the checker's types are required). Each trait becomes a struct holding state, entity, a ports callback and the emitted events, with one on_<event>(&mut self, payload: &<Trait><EVENT>Payload) method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records (event, the serde_json value of the payload built as the shell's generated payload type) in self.emitted. The entity and payload types are imported from crate::generated::entities and crate::generated::events, the modules the Rust shell generates. Numbers are f64. A failable operator (division, modulo, sqrt, ln, log10, pow, acos, asin, nth, first, last, to-int, avg, max, min) answers Option<f64> and default unwraps it. A set and every payload field convert the value with clone().into(), so a defaulted entity field (Option<T> in the shell's model) and a required one are written the same way, and a read of a defaulted entity field unwraps to its declared default. Kernel answers that are null or errors come from small helper functions written once, and only the ones the output uses; string length, slicing and padding count characters, and a count or index that is not a whole number panics as the kernel errors. An operator with no Rust template is a named warning and a stub that panics when run. persist, fetch, notify, navigate and call-service are called on the injected ports callback with the effect name and their arguments as JSON, and each is listed in warnings; render-ui is a comment. Limits: a trait's config knobs are not rendered; fields the checker types int are i64 in the shell's models and are not converted from f64; a literal dotted path in object/get is read as one flat key; array/zip needs two lists of one type; object/keys, values and entries have no template because the shell's maps are ordered by key while the kernel keeps insertion order. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-rust"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloRustOrbital {
  entity LoloRustRun [runtime] {
    id : string!
  }

  trait LoloRust = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_RUST
      SOURCE_RENDERED: RUST_RENDERED
      SOURCE_RENDER_FAILED: RUST_RENDER_FAILED
    }
    config {
      language: "Rust"
      requiresTypes: true
      operators: { "/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "str/len": "({{0}}.chars().count() as f64)", "str/upper": "{{0}}.to_uppercase()", "str/lower": "{{0}}.to_lowercase()", "str/trim": "{{0}}.trim().to_string()", "str/trimStart": "{{0}}.trim_start().to_string()", "str/trimEnd": "{{0}}.trim_end().to_string()", "str/capitalize": "_capitalize(&{{0}})", "str/split": "_split(&{{0}}, &{{1}})", "str/join": "_join(&{{0}}, &{{1}})", "str/concat": "_concat!({{*}})", "str/includes": "{{0}}.contains(&{{1}})", "str/startsWith": "{{0}}.starts_with(&{{1}})", "str/endsWith": "{{0}}.ends_with(&{{1}})", "str/replace": "{{0}}.replacen(&{{1}}, &{{2}}, 1)", "str/replaceAll": "{{0}}.replace(&{{1}}, &{{2}})", "str/repeat": "_repeat(&{{0}}, {{1}})", "str/reverse": "{{0}}.chars().rev().collect::<String>()", "str/slice#2": "_str_slice(&{{0}}, {{1}}, None)", "str/slice#3": "_str_slice(&{{0}}, {{1}}, Some({{2}}))", "str/padStart#2": "_pad_start(&{{0}}, {{1}}, \" \")", "str/padStart#3": "_pad_start(&{{0}}, {{1}}, &{{2}})", "str/padEnd#2": "_pad_end(&{{0}}, {{1}}, \" \")", "str/padEnd#3": "_pad_end(&{{0}}, {{1}}, &{{2}})", "str/truncate#2": "_truncate(&{{0}}, {{1}}, \"...\")", "str/truncate#3": "_truncate(&{{0}}, {{1}}, &{{2}})", "str/to-int": "_to_int(&{{0}})", "array/len": "({{0}}.len() as f64)", "array/avg#1": "_avg(&{{0}})", "array/max#1": "_amax(&{{0}})", "array/min#1": "_amin(&{{0}})", "array/first": "_first(&{{0}})", "array/last": "_last(&{{0}})", "array/nth": "_nth(&{{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}}, 1_f64)", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice(&{{0}}, {{1}}, None)", "array/slice#3": "_slice(&{{0}}, {{1}}, Some({{2}}))", "array/take": "_take(&{{0}}, {{1}})", "array/drop": "_drop(&{{0}}, {{1}})", "array/takeLast": "_take_last(&{{0}}, {{1}})", "array/dropLast": "_drop_last(&{{0}}, {{1}})", "array/append": "_append(&{{0}}, {{1}}.clone())", "array/prepend": "_prepend(&{{0}}, {{1}}.clone())", "array/includes": "{{0}}.contains(&{{1}})", "array/indexOf": "_index_of(&{{0}}, &{{1}})", "array/reverse": "{{0}}.iter().rev().cloned().collect::<Vec<_>>()", "array/unique": "_unique(&{{0}})", "array/flatten": "_flatten(&{{0}})", "array/zip": "_zip(&{{0}}, &{{1}})", "array/concat": "_vconcat!({{*}})", "array/reduce": "_reduce(&{{0}}, ({{1}}).clone(), {{2}})", "list": "_list!({{*}})", "object/get#2": "_get(&{{0}}, &{{1}})", "object/get#3": "_get(&{{0}}, &{{1}}).unwrap_or(({{2}}).clone())", "object/has": "{{0}}.contains_key(&{{1}})", "object/merge#2": "_merge(&{{0}}, &{{1}})", "object/pick": "_pick(&{{0}}, &{{1}})", "object/omit": "_omit(&{{0}}, &{{1}})", "math/abs": "({{0}}).abs()", "math/ceil": "({{0}}).ceil()", "math/floor": "({{0}}).floor()", "math/sin": "({{0}}).sin()", "math/cos": "({{0}}).cos()", "math/tan": "({{0}}).tan()", "math/atan": "({{0}}).atan()", "math/atan2": "({{0}}).atan2({{1}})", "math/hypot": "({{0}}).hypot({{1}})", "math/max": "[{{*}}].iter().cloned().fold(f64::NEG_INFINITY, f64::max)", "math/min": "[{{*}}].iter().cloned().fold(f64::INFINITY, f64::min)", "math/round#2": "_round({{0}}, {{1}})", "math/acos": "_acos({{0}})", "math/asin": "_asin({{0}})", "math/deg-rad": "({{0}}).to_radians()", "math/rad-deg": "({{0}}).to_degrees()", "math/lerp": "(({{0}}) + (({{1}}) - ({{0}})) * ({{2}}))", "math/approach": "_approach({{0}}, {{1}}, {{2}})", "math/map": "_map({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "math/wrap": "_wrap({{0}}, {{1}}, {{2}})", "array/insert": "_insert(&{{0}}, {{1}}, ({{2}}).clone())", "array/remove": "_remove(&{{0}}, {{1}})", "array/removeItem": "_remove_item(&{{0}}, &{{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "_sign({{0}})", "math/clamp": "({{0}}).max({{1}}).min({{2}})", "default": "_default(({{0}}).clone(), ({{1}}).clone())", "as": "{{0}}", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "(({{1}} <= {{0}}) && ({{0}} <= {{2}}))", "validate/oneOf": "{{1}}.contains(&{{0}})", "validate/equals": "({{0}} == {{1}})" }
      unary: { "-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range(0_f64, {{0}}, 1_f64)", "array/sum": "_sum(&{{0}})", "array/count": "({{0}}.len() as f64)", "array/sort": "_sort(&{{0}})", "math/round": "_round({{0}}, 0_f64)", "array/concat": "{{0}}.clone()", "object/merge": "{{0}}.clone()" }
      infix: { "+": "+", "-": "-", "*": "*", "=": "==", "==": "==", "!=": "!=", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||" }
      infixForm: "({{*}})"
      lambdaOperators: { "array/map": "{{src}}.clone().into_iter().map(|{{vars}}| ({{body}}).clone()).collect::<Vec<_>>()", "array/filter": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if {{body}} { Some({{item}}) } else { None }).collect::<Vec<_>>()", "array/reject": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if !({{body}}) { Some({{item}}) } else { None }).collect::<Vec<_>>()", "array/some": "{{src}}.clone().into_iter().any(|{{vars}}| {{body}})", "array/every": "{{src}}.clone().into_iter().all(|{{vars}}| {{body}})", "array/count": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if {{body}} { Some(1.0_f64) } else { None }).fold(0.0_f64, |s, x| s + x)", "array/find": "{{src}}.clone().into_iter().find_map(|{{vars}}| if {{body}} { Some({{item}}) } else { None })", "array/findIndex": "{{src}}.clone().into_iter().enumerate().find_map(|(i_, {{vars}})| if {{body}} { Some(i_ as f64) } else { None }).unwrap_or(-1.0_f64)" }
      lambdaForm: "|{{params}}| {{body}}"
      indexedSource: "{{src}}.clone().into_iter().enumerate().map(|(i_, x_)| (i_ as f64, x_))"
      indexedVars: "({{index}}, {{item}})"
      unsupportedForm: "_unsupported(&{{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: { "/": ["fn _div(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a / b) } }"], "%": ["fn _mod(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a % b) } }"], "math/mod": ["fn _mod(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a % b) } }"], "default": ["trait _OrDefault<T> { fn _or_default(self, d: T) -> T; }\nimpl<T> _OrDefault<T> for Option<T> { fn _or_default(self, d: T) -> T { self.unwrap_or(d) } }\nimpl<T> _OrDefault<T> for T { fn _or_default(self, _d: T) -> T { self } }\nfn _default<T, V: _OrDefault<T>>(v: V, d: T) -> T { v._or_default(d) }"], "str/concat": ["fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "trait _Text { fn _text(&self) -> String; }\nimpl _Text for String { fn _text(&self) -> String { self.clone() } }\nimpl _Text for bool { fn _text(&self) -> String { (if *self { \"true\" } else { \"false\" }).to_string() } }\nimpl _Text for f64 { fn _text(&self) -> String { _num_text(*self) } }", "macro_rules! _concat {\n    ($($x:expr),+ $(,)?) => {{\n        let mut s_ = String::new();\n        $( s_.push_str(&_Text::_text(&$x)); )+\n        s_\n    }};\n}"], "str/join": ["fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "trait _Text { fn _text(&self) -> String; }\nimpl _Text for String { fn _text(&self) -> String { self.clone() } }\nimpl _Text for bool { fn _text(&self) -> String { (if *self { \"true\" } else { \"false\" }).to_string() } }\nimpl _Text for f64 { fn _text(&self) -> String { _num_text(*self) } }", "fn _join<T: _Text>(a: &[T], d: &str) -> String { a.iter().map(|x| x._text()).collect::<Vec<_>>().join(d) }"], "str/split": ["fn _split(s: &str, d: &str) -> Vec<String> {\n    if d.is_empty() { s.chars().map(|c| c.to_string()).collect() } else { s.split(d).map(|p| p.to_string()).collect() }\n}"], "str/slice": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _str_slice(s: &str, a: f64, b: Option<f64>) -> String {\n    let c: Vec<char> = s.chars().collect();\n    let n = c.len() as i64;\n    let norm = |i: i64| -> i64 { if i < 0 { (n + i).max(0) } else { i.min(n) } };\n    let st = norm(_whole(a));\n    let en = match b { Some(v) => norm(_whole(v)), None => n };\n    if en <= st { String::new() } else { c[st as usize..en as usize].iter().collect() }\n}"], "str/padStart": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _pad_start(s: &str, n: f64, p: &str) -> String {\n    if p.chars().count() != 1 { panic!(\"expected a single padding character, got {:?}\", p); }\n    let w = _whole(n);\n    let len = s.chars().count() as i64;\n    if w <= len { return s.to_string(); }\n    let pad: String = std::iter::repeat(p).take((w - len) as usize).collect();\n    format!(\"{}{}\", pad, s)\n}"], "str/padEnd": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _pad_end(s: &str, n: f64, p: &str) -> String {\n    if p.chars().count() != 1 { panic!(\"expected a single padding character, got {:?}\", p); }\n    let w = _whole(n);\n    let len = s.chars().count() as i64;\n    if w <= len { return s.to_string(); }\n    let pad: String = std::iter::repeat(p).take((w - len) as usize).collect();\n    format!(\"{}{}\", s, pad)\n}"], "str/truncate": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _truncate(s: &str, n: f64, suffix: &str) -> String {\n    let w = _whole(n);\n    if (s.chars().count() as i64) <= w { return s.to_string(); }\n    let head: String = s.chars().take(w.max(0) as usize).collect();\n    format!(\"{}{}\", head, suffix)\n}"], "str/repeat": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _repeat(s: &str, n: f64) -> String { s.repeat(_count(n)) }"], "str/capitalize": ["fn _capitalize(s: &str) -> String {\n    let mut c = s.chars();\n    match c.next() {\n        Some(f) => f.to_uppercase().collect::<String>() + &c.as_str().to_lowercase(),\n        None => String::new(),\n    }\n}"], "str/to-int": ["fn _to_int(s: &str) -> Option<f64> { s.parse::<i64>().ok().map(|v| v as f64) }"], "array/sum": ["fn _sum(a: &[f64]) -> f64 { a.iter().fold(0.0_f64, |s, x| s + x) }"], "array/avg": ["fn _avg(a: &[f64]) -> Option<f64> { if a.is_empty() { None } else { Some(a.iter().fold(0.0_f64, |s, x| s + x) / a.len() as f64) } }"], "array/max": ["fn _amax(a: &[f64]) -> Option<f64> { a.iter().cloned().fold(None, |m, x| Some(match m { Some(y) => if x > y { x } else { y }, None => x })) }"], "array/min": ["fn _amin(a: &[f64]) -> Option<f64> { a.iter().cloned().fold(None, |m, x| Some(match m { Some(y) => if x < y { x } else { y }, None => x })) }"], "array/first": ["fn _first<T: Clone>(a: &[T]) -> Option<T> { a.first().cloned() }"], "array/last": ["fn _last<T: Clone>(a: &[T]) -> Option<T> { a.last().cloned() }"], "array/nth": ["fn _nth<T: Clone>(a: &[T], i: f64) -> Option<T> {\n    if !i.is_finite() || i != i.trunc() || i < 0.0 { panic!(\"nth: index {} is not a whole number from 0\", i); }\n    a.get(i as usize).cloned()\n}"], "array/range": ["fn _range(a: f64, b: f64, step: f64) -> Vec<f64> {\n    if step == 0.0 || !step.is_finite() { panic!(\"range: step 0 must be a non-zero finite number\"); }\n    let mut out = Vec::new();\n    let mut x = a;\n    while if step > 0.0 { x < b } else { x > b } { out.push(x); x += step; }\n    out\n}"], "array/slice": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _slice<T: Clone>(a: &[T], s: f64, e: Option<f64>) -> Vec<T> {\n    let st = _whole(s);\n    let en = e.map(_whole);\n    if st < 0 || en.map_or(false, |v| v < 0) { panic!(\"slice: not a whole number from 0\"); }\n    let st = (st as usize).min(a.len());\n    let en = en.map_or(a.len(), |v| (v as usize).min(a.len()));\n    if en <= st { Vec::new() } else { a[st..en].to_vec() }\n}"], "array/take": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _take<T: Clone>(a: &[T], n: f64) -> Vec<T> { a.iter().take(_count(n)).cloned().collect() }"], "array/drop": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _drop<T: Clone>(a: &[T], n: f64) -> Vec<T> { a.iter().skip(_count(n)).cloned().collect() }"], "array/takeLast": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _take_last<T: Clone>(a: &[T], n: f64) -> Vec<T> { let k = _count(n).min(a.len()); a[a.len() - k..].to_vec() }"], "array/dropLast": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _drop_last<T: Clone>(a: &[T], n: f64) -> Vec<T> { let k = _count(n).min(a.len()); a[..a.len() - k].to_vec() }"], "array/append": ["fn _append<T: Clone>(a: &[T], x: T) -> Vec<T> { let mut v = a.to_vec(); v.push(x); v }"], "array/prepend": ["fn _prepend<T: Clone>(a: &[T], x: T) -> Vec<T> { let mut v = vec![x]; v.extend(a.iter().cloned()); v }"], "array/indexOf": ["fn _index_of<T: PartialEq>(a: &[T], x: &T) -> f64 { a.iter().position(|y| y == x).map_or(-1.0, |i| i as f64) }"], "array/unique": ["fn _unique<T: Clone + PartialEq>(a: &[T]) -> Vec<T> {\n    let mut out: Vec<T> = Vec::new();\n    for x in a { if !out.contains(x) { out.push(x.clone()); } }\n    out\n}"], "array/flatten": ["fn _flatten<T: Clone>(a: &[Vec<T>]) -> Vec<T> { a.iter().flat_map(|v| v.iter().cloned()).collect() }"], "array/zip": ["fn _zip<T: Clone>(a: &[T], b: &[T]) -> Vec<Vec<T>> { a.iter().cloned().zip(b.iter().cloned()).map(|(x, y)| vec![x, y]).collect() }"], "array/concat": ["macro_rules! _vconcat {\n    ($($x:expr),+ $(,)?) => {{\n        let mut v_ = Vec::new();\n        $( v_.extend($x.iter().cloned()); )+\n        v_\n    }};\n}"], "array/sort": ["fn _sort<T: Clone + PartialOrd>(a: &[T]) -> Vec<T> {\n    let mut v = a.to_vec();\n    v.sort_by(|x, y| x.partial_cmp(y).unwrap_or(std::cmp::Ordering::Equal));\n    v\n}"], "array/reduce": ["fn _reduce<T: Clone, A>(a: &[T], init: A, f: impl Fn(A, T) -> A) -> A { a.iter().cloned().fold(init, f) }"], "math/round": ["fn _round(x: f64, d: f64) -> f64 {\n    let m = 10.0_f64.powf(d);\n    let r = (x.abs() * m + 0.5).floor() / m;\n    if x < 0.0 { -r } else { r }\n}"], "math/acos": ["fn _acos(x: f64) -> Option<f64> { if (-1.0..=1.0).contains(&x) { Some(x.acos()) } else { None } }"], "math/asin": ["fn _asin(x: f64) -> Option<f64> { if (-1.0..=1.0).contains(&x) { Some(x.asin()) } else { None } }"], "math/approach": ["fn _approach(c: f64, t: f64, d: f64) -> f64 { if (t - c).abs() <= d { t } else { c + (t - c).signum() * d } }"], "math/map": ["fn _map(v: f64, a: f64, b: f64, c: f64, d: f64) -> f64 { if b == a { c } else { c + (v - a) / (b - a) * (d - c) } }"], "math/wrap": ["fn _wrap(v: f64, lo: f64, hi: f64) -> f64 {\n    let r = hi - lo;\n    if r <= 0.0 { lo } else { ((v - lo) % r + r) % r + lo }\n}"], "array/insert": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _insert<T: Clone>(a: &[T], i: f64, x: T) -> Vec<T> {\n    let k = _whole(i);\n    if k < 0 || k as usize > a.len() { panic!(\"insert: index {} is not within a {}-item array\", k, a.len()); }\n    let mut v = a.to_vec();\n    v.insert(k as usize, x);\n    v\n}"], "array/remove": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _remove<T: Clone>(a: &[T], i: f64) -> Vec<T> {\n    let k = _whole(i);\n    if k < 0 || k as usize >= a.len() { panic!(\"remove: index {} is outside a {}-item array\", k, a.len()); }\n    let mut v = a.to_vec();\n    v.remove(k as usize);\n    v\n}"], "array/removeItem": ["fn _remove_item<T: Clone + PartialEq>(a: &[T], x: &T) -> Vec<T> {\n    let mut v = a.to_vec();\n    if let Some(p) = v.iter().position(|y| y == x) { v.remove(p); }\n    v\n}"], "math/sqrt": ["fn _sqrt(x: f64) -> Option<f64> { if x < 0.0 { None } else { Some(x.sqrt()) } }"], "math/ln": ["fn _ln(x: f64) -> Option<f64> { if x <= 0.0 { None } else { Some(x.ln()) } }"], "math/log10": ["fn _log10(x: f64) -> Option<f64> { if x <= 0.0 { None } else { Some(x.log10()) } }"], "math/pow": ["fn _pow(a: f64, b: f64) -> Option<f64> { let r = a.powf(b); if r.is_finite() { Some(r) } else { None } }"], "math/sign": ["fn _sign(x: f64) -> f64 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }"], "object/get": ["fn _get<V: Clone>(m: &std::collections::BTreeMap<String, V>, k: &str) -> Option<V> { m.get(k).cloned() }"], "object/merge": ["fn _merge<V: Clone>(a: &std::collections::BTreeMap<String, V>, b: &std::collections::BTreeMap<String, V>) -> std::collections::BTreeMap<String, V> {\n    let mut m = a.clone();\n    for (k, v) in b { m.insert(k.clone(), v.clone()); }\n    m\n}"], "object/pick": ["fn _pick<V: Clone>(m: &std::collections::BTreeMap<String, V>, ks: &[String]) -> std::collections::BTreeMap<String, V> {\n    m.iter().filter(|(k, _)| ks.contains(k)).map(|(k, v)| (k.clone(), v.clone())).collect()\n}"], "object/omit": ["fn _omit<V: Clone>(m: &std::collections::BTreeMap<String, V>, ks: &[String]) -> std::collections::BTreeMap<String, V> {\n    m.iter().filter(|(k, _)| !ks.contains(k)).map(|(k, v)| (k.clone(), v.clone())).collect()\n}"], "unsupported": ["#[derive(Clone)]\nstruct _U;\nfn _unsupported(op: &str) -> _U { panic!(\"no native template for operator {}\", op) }\nimpl From<_U> for f64 { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for String { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for bool { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<f64> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<String> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<bool> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<T> From<_U> for Vec<T> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<T> From<_U> for Option<Vec<T>> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<K: Ord, V> From<_U> for std::collections::BTreeMap<K, V> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<K: Ord, V> From<_U> for Option<std::collections::BTreeMap<K, V>> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }"] }
      helperGap: "\n"
      portEffects: ["persist", "fetch", "fetch-stream", "notify", "navigate", "navigate-back", "call-service", "cancel-call", "send-server", "spawn", "despawn", "log"]
      portCall: "(self.ports)(\"{{name}}\", serde_json::json!([{{*}}]))"
      portCase: "lower"
      portWarn: "{{op}} is called on the ports object"
      attributeRoots: { "entity": "self.entity", "state": "self.state", "payload": "payload", "config": "self.config" }
      attrAccess: ".{{name}}"
      indexAccess: "[{{0}}]"
      localAccess: "attr"
      entityReadDefault: "{{read}}.clone().unwrap_or({{default}})"
      nullLit: "None"
      trueLit: "true"
      falseLit: "false"
      stringForm: "{{json}}.to_string()"
      numberForm: "{{json}}_f64"
      numberIntForm: "{{json}}_f64"
      listForm: "_list!({{*}})"
      mapOpen: "std::collections::BTreeMap::from(["
      mapClose: "])"
      mapEmpty: "std::collections::BTreeMap::new()"
      mapPair: "({{key}}, ({{value}}).clone())"
      mapSep: ", "
      letStmt: "let {{name}} = ({{value}}).clone()"
      letExpr: "{ let {{name}} = ({{value}}).clone(); {{body}} }"
      condExpr: "(if {{cond}} { ({{then}}).clone() } else { ({{else}}).clone() })"
      ifOpen: "if {{cond}} {"
      elseOpen: "} else {"
      blockClose: "}"
      emptyBody: ""
      setStyle: "assign"
      setAssign: "{{target}} = ({{value}}).clone().into()"
      emitForm: "self.emit({{event}}, {{payload}})"
      payloadType: "{{trait}}{{event}}Payload"
      configType: "{{trait}}Config"
      payloadCtor: "serde_json::to_value({{type}} { {{fields}} }).ok()"
      payloadField: "{{name}}: ({{value}}).clone().into()"
      payloadSep: ", "
      commentForm: "// {{text}}"
      indent: "    "
      terminator: ";"
      classCase: "keep"
      fieldCase: "keep"
      localCase: "keep"
      methodCase: "lower"
      methodName: "on_{{event}}"
      modelImports: { "entity": "use crate::generated::entities::{{name}};", "payload": "use crate::generated::events::{{name}};" }
      modelImportEach: true
      fileHeader: "#![allow(dead_code, unused_macros, unused_parens, unused_variables)]"
      sectionGap: "\n\n"
      classOpen: "macro_rules! _list {\n    ($($x:expr),* $(,)?) => { vec![$(($x).clone()),*] };\n}\n\npub struct {{class}} {"
      classClose: "}"
      classEmpty: ""
      constructor: ["{{i}}pub state: String,", "{{i}}pub entity: {{entity}},", "{{i}}pub config: {{configType}},", "{{i}}pub ports: Box<dyn FnMut(&str, serde_json::Value)>,", "{{i}}pub emitted: Vec<(String, Option<serde_json::Value>)>,", "}", "", "impl {{class}} {", "{{i}}pub fn new(entity: {{entity}}) -> Self {", "{{i}}{{i}}Self { state: {{initial}}, entity, config: {{configType}}::default(), ports: Box::new(|_, _| {}), emitted: Vec::new() }", "{{noConfig}}{{i}}{{i}}Self { state: {{initial}}, entity, ports: Box::new(|_, _| {}), emitted: Vec::new() }", "{{i}}}", "", "{{i}}pub fn with_config(mut self, config: {{configType}}) -> Self {", "{{withConfig}}{{i}}{{i}}self.config = config;", "{{withConfig}}{{i}}{{i}}self", "{{withConfig}}{{i}}}", "{{withConfig}}", "{{i}}pub fn with_ports(mut self, ports: impl FnMut(&str, serde_json::Value) + 'static) -> Self {", "{{i}}{{i}}self.ports = Box::new(ports);", "{{i}}{{i}}self", "{{i}}}"]
      emitMethod: ["{{i}}fn emit(&mut self, event: String, payload: Option<serde_json::Value>) {", "{{i}}{{i}}self.emitted.push((event, payload));", "{{i}}}"]
      methodOpen: "{{i}}pub fn {{method}}(&mut self, payload: &{{payloadType}}) {"
      methodOpenPlain: "{{i}}pub fn {{method}}(&mut self) {"
      methodClose: "{{i}}}"
      branchFirst: "{{i}}{{i}}if {{test}} {"
      branchNext: "{{i}}{{i}}} else if {{test}} {"
      branchClose: "{{i}}{{i}}}"
      branchTest: "{{stateTest}} && {{guard}}"
      branchTestPlain: "{{stateTest}}"
      stateTest: "self.state == {{state}}"
      stateAssign: "self.state = {{state}}"
      bodyPrefix: "{{i}}{{i}}{{i}}"
      renderModels: false
    }
  }

  page boot as LoloRustStart -> LoloRust
}
