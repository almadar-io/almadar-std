, g: i64, h: i64, f: i64, order: u64 }\n    let mut counter: u64 = 0;\n    let mut open: Vec<Node> = Vec::new();\n    let mut came_from: std::collections::HashMap<(i64, i64), (i64, i64)> = std::collections::HashMap::new();\n    let mut g_score: std::collections::HashMap<(i64, i64), i64> = std::collections::HashMap::new();\n    let mut closed: std::collections::HashSet<(i64, i64)> = std::collections::HashSet::new();\n    let h0 = heuristic(start);\n    open.push(Node { cell: start, g: 0, h: h0, f: h0, order: counter });\n    counter += 1;\n    g_score.insert(start, 0);\n    while !open.is_empty() {\n        let mut best = 0usize;\n        for i in 1..open.len() {\n            let (n, b) = (&open[i], &open[best]);\n            if n.f < b.f || (n.f == b.f && n.h < b.h) || (n.f == b.f && n.h == b.h && n.order < b.order) { best = i; }\n        }\n        let current = open.swap_remove(best);\n        if current.cell == goal {\n            let mut path = vec![goal];\n            let mut k = goal;\n            while let Some(&prev) = came_from.get(&k) {\n                path.push(prev);\n                k = prev;\n            }\n            path.reverse();\n            return _path_value(path);\n        }\n        closed.insert(current.cell);\n        for &(dx, dy) in &offs {\n            let nb = (current.cell.0 + dx, current.cell.1 + dy);\n            if nb.0 < 0 || nb.0 >= w || nb.1 < 0 || nb.1 >= h { continue; }\n            if blocked.contains(&nb) || closed.contains(&nb) { continue; }\n            let tentative = current.g + 1;\n            let known = g_score.get(&nb).copied();\n            if known.is_none() || tentative < known.unwrap() {\n                came_from.insert(nb, current.cell);\n                g_score.insert(nb, tentative);\n                let hh = heuristic(nb);\n                open.push(Node { cell: nb, g: tentative, h: hh, f: tentative + hh, order: counter });\n                counter += 1;\n            }\n        }\n    }\n    _path_value(Vec::