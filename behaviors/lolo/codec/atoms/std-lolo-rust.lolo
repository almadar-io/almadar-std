      recordField: "{{name}}: ({{value}}).clone().into()"
      unionArmForm: "{{union}}::{{arm}}({{inner}})"
      enumForm: "{{enum}}::{{member}}"
      enumMemberCase: "split-pascal"
      fieldNames: { "type": "type_" }
      programOpen: ["pub struct Program {", "{{i}}pub router: _Router,", "}", "", "impl Program {", "{{i}}pub fn new(entities: ({{entities}},){{store}}{{viewer}}) -> Self {", "{{i}}{{i}}let mut router = _Router::default();"]
      programEntity: "{{entity}}"
      programEntitySep: ", "
      programTrait: "{{i}}{{i}}_routed!({{class}}); let mut t{{n}} = {{class}}::new(entities.{{n}});{{binds}} router.add({{key}}, Box::new(t{{n}}));"
      programHandles: "{{i}}{{i}}router.handles.insert({{key}}, {{table}});"
      programRow: "{{i}}{{i}}router.row({{source}}, {{event}}, {{target}}, {{trigger}}, {{guard}}, {{map}});"
      deliverOpen: ["{{i}}{{i}}Program { router }", "{{i}}}", "", "{{i}}pub fn dispatch(&mut self, trait_: &str, event: &str, payload: serde_json::Value) {", "{{i}}{{i}}_dispatch(self, trait_, event, payload)", "{{i}}}", "}", "", "impl _Program for Program {", "{{i}}fn router(&mut self) -> &mut _Router {", "{{i}}{{i}}&mut self.router", "{{i}}}", "", "{{i}}fn deliver(&mut self, target: &str, event: &str, payload: &serde_json::Value) {"]
      deliverCase: "{{i}}{{i}}if target == {{target}} && event == {{event}} { if let Some(t) = self.router.get::<{{class}}>(target) { t.{{method}}({{arg}}); } return; }"
      deliverCasePlain: "{{i}}{{i}}if target == {{target}} && event == {{event}} { if let Some(t) = self.router.get::<{{class}}>(target) { t.{{method}}(); } return; }"
      deliverClose: ["{{i}}}", "}"]
      programClose: []
      payloadDecode: "&_decode::<{{type}}>({{value}})"
      guardForm: ["", "fn {{name}}(payload_json: &serde_json::Value) -> bool {", "{{i}}let payload = {{decode}};", "{{i}}{{expr}}", "}"]
      mapForm: ["", "fn {{name}}(payload_json: &serde_json::Value) -> serde_json::Value {", "{{i}}let payload = {{decode}};", "{{i}}serde_json::to_value({{expr}}).expect(\"a mapped payload\")", "}"]
      guardName: "_guard_{{n}}"
      mapName: "_map_{{n}}"
      guardRef: "Some({{name}})"
      mapRef: "Some({{name}})"
      modelImportEach: true
      fileHeader: "#![allow(dead_code, unused_macros, unused_mut, unused_parens, unused_variables)]"
      sectionGap: "\n\n"
      classOpen: "macro_rules! _list {\n    ($($x:expr),* $(,)?) => { vec![$(($x).clone()),*] };\n}\n\npub struct {{class}} {"
      classClose: "}"
      classEmpty: ""
      constructor: ["{{i}}pub state: String,", "{{i}}pub entity: {{entity}},", "{{i}}pub config: {{configType}},", "{{i}}pub ports: Box<dyn FnMut(&str, serde_json::Value)>,", "{{i}}pub emitted: Vec<(String, Option<serde_json::Value>)>,", "{{withStore}}{{i}}pub store: Option<std::rc::Rc<std::cell::RefCell<dyn Store>>>,", "{{withStore}}{{i}}pub completed: Vec<usize>,", "{{withUser}}{{i}}pub user: std::rc::Rc<std::cell::RefCell<Viewer>>,", "}", "", "impl {{class}} {", "{{i}}pub fn new(entity: {{entity}}) -> Self {", "{{i}}{{i}}Self {", "{{i}}{{i}}{{i}}state: {{initial}},", "{{i}}{{i}}{{i}}entity,", "{{withConfig}}{{i}}{{i}}{{i}}config: {{configType}}::default(),", "{{i}}{{i}}{{i}}ports: Box::new(|_, _| {}),", "{{i}}{{i}}{{i}}emitted: Vec::new(),", "{{withStore}}{{i}}{{i}}{{i}}store: None,", "{{withStore}}{{i}}{{i}}{{i}}completed: Vec::new(),", "{{withUser}}{{i}}{{i}}{{i}}user: Default::default(),", "{{i}}{{i}}}", "{{i}}}", "", "{{i}}pub fn with_config(mut self, config: {{configType}}) -> Self {", "{{withConfig}}{{i}}{{i}}self.config = config;", "{{withConfig}}{{i}}{{i}}self", "{{withConfig}}{{i}}}", "{{withConfig}}", "{{i}}pub fn with_ports(mut self, ports: impl FnMut(&str, serde_json::Value) + 'static) -> Self {", "{{i}}{{i}}self.ports = Box::new(ports);", "{{i}}{{i}}self", "{{i}}}"]
      emitMethod: ["{{i}}fn emit(&mut self, event: String, payload: Option<serde_json::Value>) {", "{{i}}{{i}}self.emitted.push((event, payload));", "{{i}}}"]
      completeMethod: ["", "{{i}}fn complete(&mut self, answer: (bool, serde_json::Value), success: Option<String>, failure: Option<String>) {", "{{i}}{{i}}let (ok, payload) = answer;", "{{i}}{{i}}if let Some(route) = if ok { success } else { failure } {", "{{i}}{{i}}{{i}}self.completed.push(self.emitted.len());", "{{i}}{{i}}{{i}}self.emitted.push((route, Some(payload)));", "{{i}}{{i}}}", "{{i}}}", "", "{{i}}fn use_store(&self) -> std::rc::Rc<std::cell::RefCell<dyn Store>> {", "{{i}}{{i}}self.store.clone().expect(\"no store\")", "{{i}}}"]
      routedEffects: {"persist": "self.complete(self.use_store().borrow_mut().persist(&{{0}}, &{{1}}, serde_json::to_value(&{{2}}).expect(\"a row\")), {{success}}, {{failure}})", "fetch": "{ let answer = self.use_store().borrow_mut().fetch(&{{entity}}, {{filter}}, {{offset}}, {{limit}}); self.complete(answer, {{success}}, {{failure}}) }"}
      pageArgForm: "Some(({{value}}) as f64)"
      fetchAll: "None"
      programBinds: {"user": " t{{n}}.user = viewer.clone();"}
      programViewerParam: ", viewer: std::rc::Rc<std::cell::RefCell<Viewer>>"
      routeForm: "Some({{route}})"
      filterForm: "Some(&({{lambda}}))"
      programStoreParam: ", store: std::rc::Rc<std::cell::RefCell<dyn Store>>"
      programTraitStore: "{{i}}{{i}}_routed_store!({{class}}); let mut t{{n}} = {{class}}::new(entities.{{n}}); t{{n}}.store = Some(store.clone());{{binds}} router.add({{key}}, Box::new(t{{n}}));"
      methodOpen: "{{i}}pub fn {{method}}(&mut self, payload: &{{payloadType}}) {"
      methodOpenPlain: "{{i}}pub fn {{method}}(&mut self) {"
      methodClose: "{{i}}}"
      branchFirst: "{{i}}{{i}}if {{test}} {"
      branchNext: "{{i}}{{i}}} else if {{test}} {"
      branchClose: "{{i}}{{i}}}"
      branchTest: "{{stateTest}} && {{guard}}"
      branchTestPlain: "{{stateTest}}"
      stateTest: "self.state == {{state}}"
      stateAssign: "self.state = {{state}}"
      bodyPrefix: "{{i}}{{i}}{{i}}"
      renderModels: false
    }
  }

  page boot as LoloRustStart -> LoloRust
}
