app std-lolo-rust [
  version: "2.0.0",
  description: "std-lolo-rust \u{2014} renders .lolo source as Rust text, so a learner who reads an exercise written in .lolo can see the same program as Rust that compiles against the Rust shell's generated models and gives the kernel's answers. It is std-lolo-source with the Rust vocabulary in config and nothing else: LOLO_TO_RUST { source, path } answers RUST_RENDERED { text, warnings }, or RUST_RENDER_FAILED { error } when the source cannot be read or the request carries no path (the checker's types are required). Each trait becomes a struct holding state, entity, a ports callback and the emitted events, with one on_<event>(&mut self, payload: &<Trait><EVENT>Payload) method per event: an if / else if branch per transition (the from-state and the guard), the effects, then the new state; an emit records (event, the serde_json value of the payload built as the shell's generated payload type) in self.emitted. The entity and payload types are imported from crate::generated::entities and crate::generated::events, the modules the Rust shell generates. Numbers are f64. A failable operator (division, modulo, sqrt, ln, log10, pow, acos, asin, nth, first, last, to-int, avg, max, min) answers Option<f64> and default unwraps it. A set and every payload field convert the value with clone().into(), so a defaulted entity field (Option<T> in the shell's model) and a required one are written the same way, and a read of a defaulted entity field unwraps to its declared default. Kernel answers that are null or errors come from small helper functions written once, and only the ones the output uses; string length, slicing and padding count characters, and a count or index that is not a whole number panics as the kernel errors. An operator with no Rust template is a named warning and a stub that panics when run. persist, fetch, notify, navigate and call-service are called on the injected ports callback with the effect name and their arguments as JSON, and each is listed in warnings; render-ui is a comment. Limits: a trait's config knobs are not rendered; fields the checker types int are i64 in the shell's models and are not converted from f64; a literal dotted path in object/get is read as one flat key; array/zip needs two lists of one type; object/keys, values and entries have no template because the shell's maps are ordered by key while the kernel keeps insertion order. See std-lolo-source for the config knobs and the type placeholders."
]
uses Spec from "almadar-std/lolo-rust"
uses Src from "std/behaviors/std-lolo-source"

orbital LoloRustOrbital {
  entity LoloRustRun [runtime] {
    id : string!
  }

  trait LoloRust = Src.traits.LoloSource {
    events {
      LOLO_TO_SOURCE: LOLO_TO_RUST
      SOURCE_RENDERED: RUST_RENDERED
      SOURCE_RENDER_FAILED: RUST_RENDER_FAILED
    }
    config {
      language: "Rust"
      requiresTypes: true
      typeUnknown: "_"
      operators: {"/": "_div({{0}}, {{1}})", "%": "_mod({{0}}, {{1}})", "math/mod": "_mod({{0}}, {{1}})", "str/len": "({{0}}.chars().count() as f64)", "str/upper": "{{0}}.to_uppercase()", "str/lower": "{{0}}.to_lowercase()", "str/trim": "{{0}}.trim().to_string()", "str/trimStart": "{{0}}.trim_start().to_string()", "str/trimEnd": "{{0}}.trim_end().to_string()", "str/capitalize": "_capitalize(&{{0}})", "str/split": "_split(&{{0}}, &{{1}})", "str/join": "_join(&{{0}}, &{{1}})", "str/concat": "_concat!({{*}})", "str/includes": "{{0}}.contains(&{{1}})", "str/startsWith": "{{0}}.starts_with(&{{1}})", "str/endsWith": "{{0}}.ends_with(&{{1}})", "str/replace": "{{0}}.replacen(&{{1}}, &{{2}}, 1)", "str/replaceAll": "{{0}}.replace(&{{1}}, &{{2}})", "str/repeat": "_repeat(&{{0}}, {{1}})", "str/reverse": "{{0}}.chars().rev().collect::<String>()", "str/slice#2": "_str_slice(&{{0}}, {{1}}, None)", "str/slice#3": "_str_slice(&{{0}}, {{1}}, Some({{2}}))", "str/padStart#2": "_pad_start(&{{0}}, {{1}}, \" \")", "str/padStart#3": "_pad_start(&{{0}}, {{1}}, &{{2}})", "str/padEnd#2": "_pad_end(&{{0}}, {{1}}, \" \")", "str/padEnd#3": "_pad_end(&{{0}}, {{1}}, &{{2}})", "str/truncate#2": "_truncate(&{{0}}, {{1}}, \"...\")", "str/truncate#3": "_truncate(&{{0}}, {{1}}, &{{2}})", "str/to-int": "_to_int(&{{0}})", "array/len": "({{0}}.len() as f64)", "array/avg#1": "_avg(&{{0}})", "array/max#1": "_amax(&{{0}})", "array/min#1": "_amin(&{{0}})", "array/first": "_first(&{{0}})", "array/last": "_last(&{{0}})", "array/nth": "_nth(&{{0}}, {{1}})", "array/range#2": "_range({{0}}, {{1}}, 1_f64)", "array/range#3": "_range({{0}}, {{1}}, {{2}})", "array/slice#2": "_slice(&{{0}}, {{1}}, None)", "array/slice#3": "_slice(&{{0}}, {{1}}, Some({{2}}))", "array/take": "_take(&{{0}}, {{1}})", "array/drop": "_drop(&{{0}}, {{1}})", "array/takeLast": "_take_last(&{{0}}, {{1}})", "array/dropLast": "_drop_last(&{{0}}, {{1}})", "array/append": "_append(&{{0}}, {{1}}.clone())", "array/prepend": "_prepend(&{{0}}, {{1}}.clone())", "array/includes": "{{0}}.contains(&{{1}})", "array/indexOf": "_index_of(&{{0}}, &{{1}})", "array/reverse": "{{0}}.iter().rev().cloned().collect::<Vec<_>>()", "array/unique": "_unique(&{{0}})", "array/flatten": "_flatten(&{{0}})", "array/zip": "_zip(&{{0}}, &{{1}})", "array/concat": "_vconcat!({{*}})", "array/reduce": "_reduce(&{{0}}, ({{1}}).clone(), {{2}})", "list": "_list!({{*}})", "object/get#2": "_get(&{{0}}, &{{1}})", "object/get#3": "_get(&{{0}}, &{{1}}).unwrap_or(({{2}}).clone())", "object/has": "{{0}}.contains_key(&{{1}})", "object/merge#2": "_merge(&{{0}}, &{{1}})", "object/pick": "_pick(&{{0}}, &{{1}})", "object/omit": "_omit(&{{0}}, &{{1}})", "math/abs": "({{0}}).abs()", "math/ceil": "({{0}}).ceil()", "math/floor": "({{0}}).floor()", "math/sin": "({{0}}).sin()", "math/cos": "({{0}}).cos()", "math/tan": "({{0}}).tan()", "math/atan": "({{0}}).atan()", "math/atan2": "({{0}}).atan2({{1}})", "math/hypot": "({{0}}).hypot({{1}})", "math/max": "[{{*}}].iter().cloned().fold(f64::NEG_INFINITY, f64::max)", "math/min": "[{{*}}].iter().cloned().fold(f64::INFINITY, f64::min)", "math/round#2": "_round({{0}}, {{1}})", "math/acos": "_acos({{0}})", "math/asin": "_asin({{0}})", "math/deg-rad": "({{0}}).to_radians()", "math/rad-deg": "({{0}}).to_degrees()", "math/lerp": "(({{0}}) + (({{1}}) - ({{0}})) * ({{2}}))", "math/approach": "_approach({{0}}, {{1}}, {{2}})", "math/map": "_map({{0}}, {{1}}, {{2}}, {{3}}, {{4}})", "math/wrap": "_wrap({{0}}, {{1}}, {{2}})", "array/insert": "_insert(&{{0}}, {{1}}, ({{2}}).clone())", "array/remove": "_remove(&{{0}}, {{1}})", "array/removeItem": "_remove_item(&{{0}}, &{{1}})", "math/sqrt": "_sqrt({{0}})", "math/ln": "_ln({{0}})", "math/log10": "_log10({{0}})", "math/pow": "_pow({{0}}, {{1}})", "math/sign": "_sign({{0}})", "math/clamp": "({{0}}).max({{1}}).min({{2}})", "default": "_default(({{0}}).clone(), ({{1}}).clone())", "as": "{{0}}", "validate/min": "({{0}} >= {{1}})", "validate/max": "({{0}} <= {{1}})", "validate/range": "(({{1}} <= {{0}}) && ({{0}} <= {{2}}))", "validate/oneOf": "{{1}}.contains(&{{0}})", "validate/equals": "({{0}} == {{1}})", "vec/add": "_vec_add(&{{0}}, &{{1}})", "vec/length": "_vec_length(&{{0}})", "vec/cross": "_vec_cross(&{{0}}, &{{1}})", "vec/dot": "_vec_dot(&{{0}}, &{{1}})", "vec/sub": "_vec_sub(&{{0}}, &{{1}})", "vec/scale": "_vec_scale(&{{0}}, {{1}})", "vec/length-sq": "_vec_length_sq(&{{0}})", "vec/normalize": "_vec_normalize(&{{0}})", "vec/distance": "_vec_distance(&{{0}}, &{{1}})", "vec/distance-sq": "_vec_distance_sq(&{{0}}, &{{1}})", "vec/lerp": "_vec_lerp(&{{0}}, &{{1}}, {{2}})", "vec/angle#1": "_vec_heading(&{{0}})", "vec/angle#2": "_vec_angle(&{{0}}, &{{1}})", "vec/rotate": "_vec_rotate(&{{0}}, {{1}})", "vec/clamp-length": "_vec_clamp_length(&{{0}}, {{1}})", "prob/seed": "_prob_seed({{0}})", "prob/uniform": "_prob_uniform({{0}}, {{1}})", "prob/gaussian": "_prob_gaussian({{0}}, {{1}})", "prob/beta": "_prob_beta({{0}}, {{1}})", "prob/flip": "_prob_flip({{0}})", "prob/categorical": "_prob_categorical(&{{0}}, &{{1}})", "prob/poisson": "_prob_poisson({{0}})", "prob/sample": "_prob_sample({{0}}, || {{1}})", "prob/expected-value": "_prob_mean(\"prob/expected-value\", &{{0}})", "prob/variance": "_prob_variance(&{{0}})", "prob/histogram": "_prob_histogram(&{{0}}, {{1}})", "prob/percentile": "_prob_percentile(&{{0}}, {{1}})", "prob/credible-interval": "_prob_credible_interval(&{{0}}, {{1}})", "math/random": "_prob_random()", "math/randomInt": "_prob_random_int({{0}}, {{1}})", "array/shuffle": "_prob_shuffle(&{{0}})", "noise/perlin#2": "_noise_perlin({{0}}, {{1}}, 0.0_f64)", "noise/perlin#3": "_noise_perlin({{0}}, {{1}}, {{2}})", "noise/simplex#2": "_noise_simplex({{0}}, {{1}}, 0.0_f64)", "noise/simplex#3": "_noise_simplex({{0}}, {{1}}, {{2}})", "noise/fbm#3": "_noise_fbm({{0}}, {{1}}, {{2}}, 0.0_f64)", "noise/fbm#4": "_noise_fbm({{0}}, {{1}}, {{2}}, {{3}})", "ease/apply": "_ease_apply(&{{0}}, {{1}})", "ease/smoothstep": "_ease_smoothstep({{0}}, {{1}}, {{2}})", "anim/frame-at#3": "_anim_frame_at({{0}}, {{1}}, {{2}}, true)", "anim/frame-at#4": "_anim_frame_at({{0}}, {{1}}, {{2}}, {{3}})", "anim/sheet-rect": "_anim_sheet_rect({{0}}, {{1}}, {{2}}, {{3}})", "anim/direction-from-delta#2": "_anim_direction({{0}}, {{1}}, 4.0_f64)", "anim/direction-from-delta#3": "_anim_direction({{0}}, {{1}}, {{2}})", "bit/xor": "_bit_fold!(|a: u32, b: u32| a ^ b; {{*}})", "bit/and": "_bit_fold!(|a: u32, b: u32| a & b; {{*}})", "bit/or": "_bit_fold!(|a: u32, b: u32| a | b; {{*}})", "bit/not": "_bit_not(&{{0}})", "bit/shl": "_bit_shift(&{{0}}, &{{1}}, |a: u32, n: u32| a << n)", "bit/shr": "_bit_shift(&{{0}}, &{{1}}, |a: u32, n: u32| a >> n)", "bit/rotl": "_bit_shift(&{{0}}, &{{1}}, |a: u32, n: u32| a.rotate_left(n))", "bit/rotr": "_bit_shift(&{{0}}, &{{1}}, |a: u32, n: u32| a.rotate_right(n))", "str/titleCase": "_s_title(&{{0}})", "str/camelCase": "_s_camel(&{{0}})", "str/kebabCase": "_s_case_words(&{{0}}).join(\"-\")", "str/snakeCase": "_s_case_words(&{{0}}).join(\"_\")", "str/to-number": "_s_to_number(&{{0}})", "str/encode-uri-component": "_s_uri_encode(&{{0}})", "str/decode-uri-component": "_s_uri_decode(&{{0}})", "str/uri-component-valid": "_s_uri_decode(&{{0}}).is_some()", "str/template": "_s_template(&{{0}}, &{{1}})", "base64/encode": "_b64_encode(&{{0}})", "base64/decode": "_b64_decode(&{{0}})", "base64/valid": "_b64_decode(&{{0}}).is_some()", "array/cosine": "_arr_cosine(&{{0}}, &{{1}})", "array/nearest": "_arr_nearest(&{{0}}, &{{1}})", "array/groupBy": "_arr_group_field(&{{0}}, &{{1}})", "array/preduce": "_arr_preduce(&{{0}}, ({{1}}).clone(), {{2}})", "time/add": "_time_add(&{{0}}, {{1}}, &{{2}}, false, \"time/add\")", "time/subtract": "_time_add(&{{0}}, {{1}}, &{{2}}, true, \"time/subtract\")", "time/diff#2": "_time_diff(&{{0}}, &{{1}}, None)", "time/diff#3": "_time_diff(&{{0}}, &{{1}}, Some(({{2}}).as_str()))", "time/isBefore": "_time_before(&{{0}}, &{{1}})", "time/isAfter": "_time_after(&{{0}}, &{{1}})", "time/isBetween": "_time_between(&{{0}}, &{{1}}, &{{2}})", "time/isSame#2": "_time_same(&{{0}}, &{{1}}, None)", "time/isSame#3": "_time_same(&{{0}}, &{{1}}, Some(({{2}}).as_str()))", "time/startOf": "_time_start(&{{0}}, &{{1}})", "time/endOf": "_time_end(&{{0}}, &{{1}})", "time/format": "_time_format(&{{0}}, &{{1}})", "time/parse": "_time_parse_obj(&{{0}})", "time/valid": "_time_parse(&{{0}}).is_some()", "time/year": "_time_part(&{{0}}, \"year\")", "time/month": "_time_part(&{{0}}, \"month\")", "time/day": "_time_part(&{{0}}, \"day\")", "time/weekday": "_time_part(&{{0}}, \"weekday\")", "time/hour": "_time_part(&{{0}}, \"hour\")", "time/minute": "_time_part(&{{0}}, \"minute\")", "time/second": "_time_part(&{{0}}, \"second\")", "time/duration": "_time_duration({{0}})", "time/relative": "_time_relative(&{{0}})", "time/isPast": "_time_past(&{{0}})", "time/isFuture": "_time_future(&{{0}})", "time/isToday": "_time_today(&{{0}})", "time/now": "_time_now_text()", "time/today": "_time_midnight()", "format/ordinal": "_fmt_ordinal({{0}})", "format/plural": "_fmt_plural({{0}}, &{{1}}, &{{2}})", "format/creditCard": "_fmt_credit_card(&{{0}})", "format/phone#1": "_fmt_phone(&{{0}}, \"US\")", "format/phone#2": "_fmt_phone(&{{0}}, &{{1}})", "format/list#1": "_fmt_list(&{{0}}, \"and\")", "format/list#2": "_fmt_list(&{{0}}, &{{1}})", "format/number#1": "_fmt_number({{0}}, &serde_json::Value::Null)", "format/number#2": "_fmt_number({{0}}, &_fmt_opts!({{1}}))", "format/percent#1": "_fmt_percent({{0}}, None)", "format/percent#2": "_fmt_percent({{0}}, Some({{1}}))", "format/currency#2": "_fmt_currency({{0}}, &{{1}}, \"en-US\")", "format/currency#3": "_fmt_currency({{0}}, &{{1}}, &{{2}})", "format/bytes": "_fmt_bytes({{0}})", "object/clone": "_dyn_obj_clone(&{{0}}, \"object/clone\")", "object/deepClone": "_dyn_obj_clone(&{{0}}, \"object/deepClone\")", "object/deepMerge": "_dyn_deep_merge!({{*}})", "object/equals": "_dyn_obj_equals(&{{0}}, &{{1}})", "object/set": "_dyn_obj_set(&{{0}}, &{{1}}, &{{2}})", "object/filter": "_dyn_filter(&{{0}}, {{1}})", "object/mapValues": "_dyn_map_values(&{{0}}, {{1}})", "object/mapKeys": "_dyn_map_keys(&{{0}}, {{1}})", "json/parse": "_dyn_json_parse(&{{0}})", "json/valid": "_dyn_json_valid(&{{0}})", "validate/required": "_dyn_val!(_dyn_required, {{0}})", "validate/string": "_dyn_val!(_dyn_is_string, {{0}})", "validate/number": "_dyn_val!(_dyn_is_number, {{0}})", "validate/boolean": "_dyn_val!(_dyn_is_boolean, {{0}})", "validate/array": "_dyn_val!(_dyn_is_array, {{0}})", "validate/object": "_dyn_val!(_dyn_is_object, {{0}})", "validate/date": "_dyn_val!(_dyn_is_date, {{0}})", "validate/creditCard": "_dyn_credit(&{{0}})", "validate/length": "(_dyn_len(&{{0}}) == {{1}})", "validate/minLength": "(_dyn_len(&{{0}}) >= {{1}})", "validate/maxLength": "(_dyn_len(&{{0}}) <= {{1}})", "validate/noneOf": "(!{{1}}.contains(&{{0}}))", "validate/pattern": "_dyn_pattern(&{{0}}, &{{1}})", "validate/email": "_dyn_pattern(&{{0}}, \"^[^\\\\s@]+@[^\\\\s@.]+\\\\.[^\\\\s@]+$\")", "validate/url": "_dyn_pattern(&{{0}}, \"^https?://[^\\\\s]+$\")", "validate/phone": "_dyn_pattern(&{{0}}, \"^[+]?[\\\\d\\\\s().-]{7,}$\")", "validate/uuid": "_dyn_pattern(&{{0}}, \"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$\")", "object/merge#3": "_merge(&_merge(&{{0}}, &{{1}}), &{{2}})", "object/merge#4": "_merge(&_merge(&_merge(&{{0}}, &{{1}}), &{{2}}), &{{3}})", "geo/aabb-overlap": "_geo_aabb_overlap(&{{0}}, &{{1}})", "geo/circle-overlap": "_geo_circle_overlap(&{{0}}, &{{1}})", "geo/rect-circle-overlap": "_geo_rect_circle_overlap(&{{0}}, &{{1}})", "geo/point-in-rect": "_geo_point_in_rect(&{{0}}, &{{1}})", "geo/point-in-circle": "_geo_point_in_circle(&{{0}}, &{{1}})", "geo/reflect": "_geo_reflect(&{{0}}, &{{1}})", "geo/segment-intersect": "_geo_segment_intersect(&{{0}}, &{{1}})", "grid/to-world": "_grid_to_world(&{{0}}, {{1}})", "grid/from-world": "_grid_from_world(&{{0}}, {{1}})", "grid/iso-to-screen": "_grid_iso_to_screen(&{{0}}, {{1}}, {{2}})", "grid/screen-to-iso": "_grid_screen_to_iso(&{{0}}, {{1}}, {{2}})", "grid/distance": "_grid_distance(&{{0}}, &{{1}})", "grid/manhattan-distance": "_grid_manhattan(&{{0}}, &{{1}})", "grid/cells-in-radius": "_grid_cells_in_radius(&{{0}}, {{1}})", "grid/line": "_grid_line(&{{0}}, &{{1}})", "grid/in-bounds": "_grid_in_bounds(&{{0}}, {{1}}, {{2}})", "grid/neighbors#1": "_grid_neighbors(&{{0}}, false)", "grid/neighbors#2": "_grid_neighbors(&{{0}}, {{1}})", "path/astar#5": "_path_astar(&{{0}}, &{{1}}, &{{2}}, {{3}}, {{4}}, false)", "path/astar#6": "_path_astar(&{{0}}, &{{1}}, &{{2}}, {{3}}, {{4}}, {{5}})", "path/reachable#5": "_path_reachable(&{{0}}, {{1}}, &{{2}}, {{3}}, {{4}}, false)", "path/reachable#6": "_path_reachable(&{{0}}, {{1}}, &{{2}}, {{3}}, {{4}}, {{5}})", "array/sum#2": "_sum(&_arrk_nums(&{{0}}, &{{1}}, \"array/sum\"))", "array/avg#2": "_avg(&_arrk_nums(&{{0}}, &{{1}}, \"array/avg\"))", "array/max#2": "_amax(&_arrk_nums(&{{0}}, &{{1}}, \"array/max\"))", "array/min#2": "_amin(&_arrk_nums(&{{0}}, &{{1}}, \"array/min\"))", "array/sort#2": "_arrk_sort(&{{0}}, &{{1}}, \"asc\")", "array/sort#3": "_arrk_sort(&{{0}}, &{{1}}, &{{2}})", "str/replace-pattern": "_dyn_replace_pattern(&{{0}}, &{{1}}, &{{2}})", "str/find-pattern#2": "_dyn_find_pattern(&{{0}}, &{{1}}, 0_f64)", "str/find-pattern#3": "_dyn_find_pattern(&{{0}}, &{{1}}, {{2}})"}
      unary: { "-": "(-{{0}})", "not": "(!{{0}})", "array/range": "_range(0_f64, {{0}}, 1_f64)", "array/sum": "_sum(&{{0}})", "array/count": "({{0}}.len() as f64)", "array/sort": "_sort(&{{0}})", "math/round": "_round({{0}}, 0_f64)", "array/concat": "{{0}}.clone()", "object/merge": "{{0}}.clone()" }
      infix: { "+": "+", "-": "-", "*": "*", "=": "==", "==": "==", "!=": "!=", "<": "<", "<=": "<=", ">": ">", ">=": ">=", "and": "&&", "or": "||" }
      infixForm: "({{*}})"
      lambdaOperators: {"array/map": "{{src}}.clone().into_iter().map(|{{vars}}| ({{body}}).clone()).collect::<Vec<_>>()", "array/filter": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if {{body}} { Some({{item}}) } else { None }).collect::<Vec<_>>()", "array/reject": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if !({{body}}) { Some({{item}}) } else { None }).collect::<Vec<_>>()", "array/some": "{{src}}.clone().into_iter().any(|{{vars}}| {{body}})", "array/every": "{{src}}.clone().into_iter().all(|{{vars}}| {{body}})", "array/count": "{{src}}.clone().into_iter().filter_map(|{{vars}}| if {{body}} { Some(1.0_f64) } else { None }).fold(0.0_f64, |s, x| s + x)", "array/find": "{{src}}.clone().into_iter().find_map(|{{vars}}| if {{body}} { Some({{item}}) } else { None })", "array/findIndex": "{{src}}.clone().into_iter().enumerate().find_map(|(i_, {{vars}})| if {{body}} { Some(i_ as f64) } else { None }).unwrap_or(-1.0_f64)", "array/pmap": "{{src}}.clone().into_iter().map(|{{vars}}| ({{body}}).clone()).collect::<Vec<_>>()", "array/partition": "{ let (y_, n_) = {{src}}.clone().into_iter().fold((Vec::new(), Vec::new()), |(mut y_, mut n_), {{vars}}| { if {{body}} { y_.push({{item}}); } else { n_.push({{item}}); } (y_, n_) }); vec![y_, n_] }", "array/groupBy": "{{src}}.clone().into_iter().fold(std::collections::BTreeMap::<String, Vec<_>>::new(), |mut m_, {{vars}}| { let k_: String = {{body}}; m_.entry(k_).or_insert_with(Vec::new).push({{item}}); m_ })"}
      lambdaForm: "|{{params}}| {{body}}"
      indexedSource: "{{src}}.clone().into_iter().enumerate().map(|(i_, x_)| (i_ as f64, x_))"
      indexedVars: "({{index}}, {{item}})"
      unsupportedForm: "_unsupported(&{{op}})"
      unsupportedWarn: "no {{language}} template for operator {{op}}"
      helpers: {"user": ["#[derive(Clone, Debug)]\npub struct Viewer {\n    pub id: String,\n    pub email: Option<String>,\n    pub name: Option<String>,\n    pub role: Option<String>,\n}\n\nimpl Default for Viewer {\n    fn default() -> Self {\n        Viewer { id: \"anonymous\".to_string(), email: None, name: None, role: Some(\"anonymous\".to_string()) }\n    }\n}\n\nimpl Viewer {\n    pub fn sign_in(&mut self, row: Option<&serde_json::Value>) {\n        let text = |k: &str| row.and_then(|r| r.get(k)).and_then(|v| v.as_str()).map(str::to_string);\n        *self = match row {\n            None => Viewer::default(),\n            Some(_) => Viewer { id: text(\"id\").unwrap_or_default(), email: text(\"email\"), name: text(\"name\"), role: text(\"role\") },\n        };\n    }\n}"], "store": ["pub trait Store {\n    fn persist(&mut self, op: &str, entity: &str, data: serde_json::Value) -> (bool, serde_json::Value);\n    fn fetch(&mut self, entity: &str, keep: Option<&dyn Fn(&serde_json::Map<String, serde_json::Value>) -> bool>, offset: Option<f64>, limit: Option<f64>) -> (bool, serde_json::Value);\n}\n\nfn _order(a: &serde_json::Map<String, serde_json::Value>, b: &serde_json::Map<String, serde_json::Value>) -> std::cmp::Ordering {\n    let (sa, sb) = (a.get(\"createdAt\").filter(|v| !v.is_null()), b.get(\"createdAt\").filter(|v| !v.is_null()));\n    let by_stamp = match (sa, sb) {\n        (Some(_), None) => std::cmp::Ordering::Less,\n        (None, Some(_)) => std::cmp::Ordering::Greater,\n        (Some(x), Some(y)) => match (x.as_f64(), y.as_f64(), x.as_str(), y.as_str()) {\n            (Some(p), Some(q), _, _) => p.partial_cmp(&q).unwrap_or(std::cmp::Ordering::Equal),\n            (_, _, Some(p), Some(q)) => p.cmp(q),\n            _ => std::cmp::Ordering::Equal,\n        },\n        (None, None) => std::cmp::Ordering::Equal,\n    };\n    let id = |m: &serde_json::Map<String, serde_json::Value>| m.get(\"id\").and_then(|v| v.as_str()).unwrap_or(\"\").to_string();\n    by_stamp.then_with(|| id(a).cmp(&id(b)))\n}\n\n#[derive(Default)]\npub struct MemoryStore {\n    tables: std::collections::BTreeMap<String, Vec<(String, serde_json::Map<String, serde_json::Value>)>>,\n    minted: u64,\n}\n\nimpl Store for MemoryStore {\n    fn persist(&mut self, op: &str, entity: &str, data: serde_json::Value) -> (bool, serde_json::Value) {\n        let rows = self.tables.entry(entity.to_string()).or_default();\n        if op == \"create\" {\n            let mut row = data.as_object().cloned().unwrap_or_default();\n            let id = match row.get(\"id\").and_then(|v| v.as_str()).filter(|v| !v.is_empty()) {\n                Some(v) => v.to_string(),\n                None => {\n                    self.minted += 1;\n                    format!(\"{}-{}\", entity, self.minted)\n                }\n            };\n            row.insert(\"id\".to_string(), serde_json::Value::String(id.clone()));\n            rows.push((id, row.clone()));\n            return (true, serde_json::Value::Object(row));\n        }\n        let key = match &data {\n            serde_json::Value::String(v) => v.clone(),\n            v => v.get(\"id\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        };\n        let Some(pos) = rows.iter().position(|(k, _)| *k == key) else {\n            return (false, serde_json::json!({ \"error\": format!(\"{} {} not found\", entity, key), \"code\": \"not-found\" }));\n        };\n        if op == \"delete\" {\n            rows.remove(pos);\n            return (true, serde_json::json!({ \"id\": key, \"deleted\": true }));\n        }\n        if let Some(obj) = data.as_object() {\n            for (k, v) in obj {\n                rows[pos].1.insert(k.clone(), v.clone());\n            }\n        }\n        (true, serde_json::Value::Object(rows[pos].1.clone()))\n    }\n\n    fn fetch(&mut self, entity: &str, keep: Option<&dyn Fn(&serde_json::Map<String, serde_json::Value>) -> bool>, offset: Option<f64>, limit: Option<f64>) -> (bool, serde_json::Value) {\n        let mut rows: Vec<serde_json::Map<String, serde_json::Value>> = self.tables.get(entity).map_or_else(Vec::new, |t| t.iter().map(|(_, r)| r.clone()).collect());\n        rows.retain(|r| keep.map_or(true, |k| k(r)));\n        rows.sort_by(_order);\n        let n = rows.len();\n        let start = (offset.unwrap_or(0.0).max(0.0) as usize).min(n);\n        let end = limit.map_or(n, |l| (start + l.max(0.0) as usize).min(n));\n        (true, serde_json::json!({ \"data\": rows[start..end].to_vec(), \"totalCount\": n }))\n    }\n}\n\nmacro_rules! _routed_store {\n    ($t:ty) => {\n        impl _Routed for $t {\n            fn state(&self) -> String { self.state.clone() }\n            fn entity_json(&self) -> serde_json::Value { serde_json::to_value(&self.entity).unwrap_or(serde_json::Value::Null) }\n            fn emitted_len(&self) -> usize { self.emitted.len() }\n            fn emitted_from(&self, n: usize) -> Vec<(String, serde_json::Value, bool)> {\n                self.emitted[n..].iter().enumerate().map(|(j, (e, p))| (e.clone(), p.clone().unwrap_or_else(|| serde_json::json!({})), self.completed.contains(&(n + j)))).collect()\n            }\n            fn as_any(&mut self) -> &mut dyn std::any::Any { self }\n        }\n    };\n}"], "router": ["trait _Routed {\n    fn state(&self) -> String;\n    fn entity_json(&self) -> serde_json::Value;\n    fn emitted_len(&self) -> usize;\n    fn emitted_from(&self, n: usize) -> Vec<(String, serde_json::Value, bool)>;\n    fn as_any(&mut self) -> &mut dyn std::any::Any;\n}\n\nmacro_rules! _routed {\n    ($t:ty) => {\n        impl _Routed for $t {\n            fn state(&self) -> String { self.state.clone() }\n            fn entity_json(&self) -> serde_json::Value { serde_json::to_value(&self.entity).unwrap_or(serde_json::Value::Null) }\n            fn emitted_len(&self) -> usize { self.emitted.len() }\n            fn emitted_from(&self, n: usize) -> Vec<(String, serde_json::Value, bool)> {\n                self.emitted[n..].iter().map(|(e, p)| (e.clone(), p.clone().unwrap_or_else(|| serde_json::json!({})), false)).collect()\n            }\n            fn as_any(&mut self) -> &mut dyn std::any::Any { self }\n        }\n    };\n}\n\nfn _decode<T: serde::de::DeserializeOwned>(payload: &serde_json::Value) -> T {\n    serde_json::from_value(payload.clone()).expect(\"a payload of the declared shape\")\n}\n\ntype _Guard = fn(&serde_json::Value) -> bool;\ntype _Map = fn(&serde_json::Value) -> serde_json::Value;\n\nstruct _Item {\n    target: String,\n    event: String,\n    payload: serde_json::Value,\n    source: serde_json::Value,\n    guard: Option<_Guard>,\n    fans: bool,\n    completion: bool,\n}\n\n#[derive(Default)]\npub struct _Router {\n    traits: Vec<(String, Box<dyn _Routed>)>,\n    pub handles: std::collections::HashMap<String, std::collections::BTreeMap<String, Vec<String>>>,\n    rows: Vec<(String, String, String, String, Option<_Guard>, Option<_Map>)>,\n    pub log: Vec<(String, String, serde_json::Value)>,\n}\n\nimpl _Router {\n    fn add(&mut self, key: String, trait_: Box<dyn _Routed>) {\n        self.traits.push((key, trait_));\n    }\n\n    fn row(&mut self, source: String, event: String, target: String, trigger: String, guard: Option<_Guard>, mapping: Option<_Map>) {\n        self.rows.push((source, event, target, trigger, guard, mapping));\n    }\n\n    fn find(&mut self, key: &str) -> Option<&mut Box<dyn _Routed>> {\n        self.traits.iter_mut().find(|(k, _)| k == key).map(|(_, t)| t)\n    }\n\n    pub fn entity_of(&mut self, key: &str) -> serde_json::Value {\n        self.find(key).map_or(serde_json::Value::Null, |t| t.entity_json())\n    }\n\n    fn get<T: 'static>(&mut self, key: &str) -> Option<&mut T> {\n        self.find(key).and_then(|t| t.as_any().downcast_mut::<T>())\n    }\n\n    fn targets(&self, source: &str, event: &str, payload: &serde_json::Value, completion: bool) -> Vec<_Item> {\n        self.rows\n            .iter()\n            .filter(|(s, e, ..)| s == source && e == event)\n            .map(|(_, _, target, trigger, guard, mapping)| _Item {\n                target: target.clone(),\n                event: trigger.clone(),\n                payload: mapping.map_or_else(|| payload.clone(), |m| m(payload)),\n                source: payload.clone(),\n                guard: *guard,\n                fans: false,\n                completion,\n            })\n            .collect()\n    }\n}\n\ntrait _Program {\n    fn router(&mut self) -> &mut _Router;\n    fn deliver(&mut self, target: &str, event: &str, payload: &serde_json::Value);\n}\n\nfn _dispatch<P: _Program>(program: &mut P, trait_: &str, event: &str, payload: serde_json::Value) {\n    let mut queue = std::collections::VecDeque::from(vec![_Item {\n        target: trait_.to_string(),\n        event: event.to_string(),\n        payload: payload.clone(),\n        source: payload,\n        guard: None,\n        fans: true,\n        completion: false,\n    }]);\n    let mut seen = std::collections::HashSet::new();\n    let mut steps = 0;\n    while let Some(item) = queue.pop_front() {\n        let Some((state, entity)) = program.router().find(&item.target).map(|t| (t.state(), t.entity_json())) else { continue };\n        let key = serde_json::json!([item.target, item.event, state, item.payload, entity]).to_string();\n        if !item.completion && seen.contains(&key) {\n            continue;\n        }\n        if let Some(guard) = item.guard {\n            if !guard(&item.source) {\n                continue;\n            }\n        }\n        if steps >= 2000 {\n            break;\n        }\n        steps += 1;\n        seen.insert(key);\n        let n = program.router().find(&item.target).map_or(0, |t| t.emitted_len());\n        program.deliver(&item.target, &item.event, &item.payload);\n        let router = program.router();\n        let mut fanned = if item.fans { router.targets(&item.target, &item.event, &item.payload, false) } else { Vec::new() };\n        let (new_state, emits) = router.find(&item.target).map_or((String::new(), Vec::new()), |t| (t.state(), t.emitted_from(n)));\n        let mut own = Vec::new();\n        for (ev, out, completion) in emits {\n            router.log.push((item.target.clone(), ev.clone(), out.clone()));\n            if router.handles.get(&item.target).and_then(|h| h.get(&new_state)).is_some_and(|evs| evs.contains(&ev)) {\n                own.push(_Item { target: item.target.clone(), event: ev.clone(), payload: out.clone(), source: out.clone(), guard: None, fans: false, completion });\n            }\n            fanned.extend(router.targets(&item.target, &ev, &out, completion));\n        }\n        for x in own.into_iter().rev() {\n            queue.push_front(x);\n        }\n        queue.extend(fanned);\n    }\n}"], "/": ["fn _div(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a / b) } }"], "%": ["fn _mod(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a % b) } }"], "math/mod": ["fn _mod(a: f64, b: f64) -> Option<f64> { if b == 0.0 { None } else { Some(a % b) } }"], "default": ["trait _OrDefault<T> { fn _or_default(self, d: T) -> T; }\nimpl<T> _OrDefault<T> for Option<T> { fn _or_default(self, d: T) -> T { self.unwrap_or(d) } }\nimpl<T> _OrDefault<T> for T { fn _or_default(self, _d: T) -> T { self } }\nfn _default<T, V: _OrDefault<T>>(v: V, d: T) -> T { v._or_default(d) }"], "str/concat": ["fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "trait _Text { fn _text(&self) -> String; }\nimpl _Text for String { fn _text(&self) -> String { self.clone() } }\nimpl _Text for bool { fn _text(&self) -> String { (if *self { \"true\" } else { \"false\" }).to_string() } }\nimpl _Text for f64 { fn _text(&self) -> String { _num_text(*self) } }", "macro_rules! _concat {\n    ($($x:expr),+ $(,)?) => {{\n        let mut s_ = String::new();\n        $( s_.push_str(&_Text::_text(&$x)); )+\n        s_\n    }};\n}"], "str/join": ["fn _num_text(x: f64) -> String {\n    if x.is_nan() { return \"NaN\".to_string(); }\n    if x.is_infinite() { return (if x > 0.0 { \"Infinity\" } else { \"-Infinity\" }).to_string(); }\n    if x == 0.0 { return \"0\".to_string(); }\n    let a = x.abs();\n    if a >= 1e21 || a < 1e-6 {\n        let s = format!(\"{:e}\", x);\n        return match s.split_once('e') {\n            Some((m, e)) => if e.starts_with('-') { format!(\"{}e{}\", m, e) } else { format!(\"{}e+{}\", m, e) },\n            None => s,\n        };\n    }\n    format!(\"{}\", x)\n}", "trait _Text { fn _text(&self) -> String; }\nimpl _Text for String { fn _text(&self) -> String { self.clone() } }\nimpl _Text for bool { fn _text(&self) -> String { (if *self { \"true\" } else { \"false\" }).to_string() } }\nimpl _Text for f64 { fn _text(&self) -> String { _num_text(*self) } }", "fn _join<T: _Text>(a: &[T], d: &str) -> String { a.iter().map(|x| x._text()).collect::<Vec<_>>().join(d) }"], "str/split": ["fn _split(s: &str, d: &str) -> Vec<String> {\n    if d.is_empty() { s.chars().map(|c| c.to_string()).collect() } else { s.split(d).map(|p| p.to_string()).collect() }\n}"], "str/slice": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _str_slice(s: &str, a: f64, b: Option<f64>) -> String {\n    let c: Vec<char> = s.chars().collect();\n    let n = c.len() as i64;\n    let norm = |i: i64| -> i64 { if i < 0 { (n + i).max(0) } else { i.min(n) } };\n    let st = norm(_whole(a));\n    let en = match b { Some(v) => norm(_whole(v)), None => n };\n    if en <= st { String::new() } else { c[st as usize..en as usize].iter().collect() }\n}"], "str/padStart": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _pad_start(s: &str, n: f64, p: &str) -> String {\n    if p.chars().count() != 1 { panic!(\"expected a single padding character, got {:?}\", p); }\n    let w = _whole(n);\n    let len = s.chars().count() as i64;\n    if w <= len { return s.to_string(); }\n    let pad: String = std::iter::repeat(p).take((w - len) as usize).collect();\n    format!(\"{}{}\", pad, s)\n}"], "str/padEnd": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _pad_end(s: &str, n: f64, p: &str) -> String {\n    if p.chars().count() != 1 { panic!(\"expected a single padding character, got {:?}\", p); }\n    let w = _whole(n);\n    let len = s.chars().count() as i64;\n    if w <= len { return s.to_string(); }\n    let pad: String = std::iter::repeat(p).take((w - len) as usize).collect();\n    format!(\"{}{}\", s, pad)\n}"], "str/truncate": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _truncate(s: &str, n: f64, suffix: &str) -> String {\n    let w = _whole(n);\n    if (s.chars().count() as i64) <= w { return s.to_string(); }\n    let head: String = s.chars().take(w.max(0) as usize).collect();\n    format!(\"{}{}\", head, suffix)\n}"], "str/repeat": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _repeat(s: &str, n: f64) -> String { s.repeat(_count(n)) }"], "str/capitalize": ["fn _capitalize(s: &str) -> String {\n    let mut c = s.chars();\n    match c.next() {\n        Some(f) => f.to_uppercase().collect::<String>() + &c.as_str().to_lowercase(),\n        None => String::new(),\n    }\n}"], "str/to-int": ["fn _to_int(s: &str) -> Option<f64> { s.parse::<i64>().ok().map(|v| v as f64) }"], "array/sum": ["fn _sum(a: &[f64]) -> f64 { a.iter().fold(0.0_f64, |s, x| s + x) }", "fn _arrk_nums<T: serde::Serialize>(a: &T, key: &str, op: &str) -> Vec<f64> {\n    let items = match serde_json::to_value(a).expect(\"a serializable value\") { serde_json::Value::Array(v) => v, other => panic!(\"{}: expected an array, got {}\", op, other) };\n    let mut out = Vec::new();\n    for item in items.iter() {\n        let value = match item.as_object() {\n            Some(o) => match o.get(key) { None | Some(serde_json::Value::Null) => continue, Some(f) => f },\n            None => panic!(\"{}: expected an object, got {}\", op, item),\n        };\n        out.push(value.as_f64().unwrap_or_else(|| panic!(\"{}: expected a number, got {}\", op, value)));\n    }\n    out\n}"], "array/avg": ["fn _avg(a: &[f64]) -> Option<f64> { if a.is_empty() { None } else { Some(a.iter().fold(0.0_f64, |s, x| s + x) / a.len() as f64) } }", "fn _arrk_nums<T: serde::Serialize>(a: &T, key: &str, op: &str) -> Vec<f64> {\n    let items = match serde_json::to_value(a).expect(\"a serializable value\") { serde_json::Value::Array(v) => v, other => panic!(\"{}: expected an array, got {}\", op, other) };\n    let mut out = Vec::new();\n    for item in items.iter() {\n        let value = match item.as_object() {\n            Some(o) => match o.get(key) { None | Some(serde_json::Value::Null) => continue, Some(f) => f },\n            None => panic!(\"{}: expected an object, got {}\", op, item),\n        };\n        out.push(value.as_f64().unwrap_or_else(|| panic!(\"{}: expected a number, got {}\", op, value)));\n    }\n    out\n}"], "array/max": ["fn _amax(a: &[f64]) -> Option<f64> { a.iter().cloned().fold(None, |m, x| Some(match m { Some(y) => if x > y { x } else { y }, None => x })) }", "fn _arrk_nums<T: serde::Serialize>(a: &T, key: &str, op: &str) -> Vec<f64> {\n    let items = match serde_json::to_value(a).expect(\"a serializable value\") { serde_json::Value::Array(v) => v, other => panic!(\"{}: expected an array, got {}\", op, other) };\n    let mut out = Vec::new();\n    for item in items.iter() {\n        let value = match item.as_object() {\n            Some(o) => match o.get(key) { None | Some(serde_json::Value::Null) => continue, Some(f) => f },\n            None => panic!(\"{}: expected an object, got {}\", op, item),\n        };\n        out.push(value.as_f64().unwrap_or_else(|| panic!(\"{}: expected a number, got {}\", op, value)));\n    }\n    out\n}"], "array/min": ["fn _amin(a: &[f64]) -> Option<f64> { a.iter().cloned().fold(None, |m, x| Some(match m { Some(y) => if x < y { x } else { y }, None => x })) }", "fn _arrk_nums<T: serde::Serialize>(a: &T, key: &str, op: &str) -> Vec<f64> {\n    let items = match serde_json::to_value(a).expect(\"a serializable value\") { serde_json::Value::Array(v) => v, other => panic!(\"{}: expected an array, got {}\", op, other) };\n    let mut out = Vec::new();\n    for item in items.iter() {\n        let value = match item.as_object() {\n            Some(o) => match o.get(key) { None | Some(serde_json::Value::Null) => continue, Some(f) => f },\n            None => panic!(\"{}: expected an object, got {}\", op, item),\n        };\n        out.push(value.as_f64().unwrap_or_else(|| panic!(\"{}: expected a number, got {}\", op, value)));\n    }\n    out\n}"], "array/first": ["fn _first<T: Clone>(a: &[T]) -> Option<T> { a.first().cloned() }"], "array/last": ["fn _last<T: Clone>(a: &[T]) -> Option<T> { a.last().cloned() }"], "array/nth": ["fn _nth<T: Clone>(a: &[T], i: f64) -> Option<T> {\n    if !i.is_finite() || i != i.trunc() || i < 0.0 { panic!(\"nth: index {} is not a whole number from 0\", i); }\n    a.get(i as usize).cloned()\n}"], "array/range": ["fn _range(a: f64, b: f64, step: f64) -> Vec<f64> {\n    if step == 0.0 || !step.is_finite() { panic!(\"range: step 0 must be a non-zero finite number\"); }\n    let mut out = Vec::new();\n    let mut x = a;\n    while if step > 0.0 { x < b } else { x > b } { out.push(x); x += step; }\n    out\n}"], "array/slice": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _slice<T: Clone>(a: &[T], s: f64, e: Option<f64>) -> Vec<T> {\n    let st = _whole(s);\n    let en = e.map(_whole);\n    if st < 0 || en.map_or(false, |v| v < 0) { panic!(\"slice: not a whole number from 0\"); }\n    let st = (st as usize).min(a.len());\n    let en = en.map_or(a.len(), |v| (v as usize).min(a.len()));\n    if en <= st { Vec::new() } else { a[st..en].to_vec() }\n}"], "array/take": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _take<T: Clone>(a: &[T], n: f64) -> Vec<T> { a.iter().take(_count(n)).cloned().collect() }"], "array/drop": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _drop<T: Clone>(a: &[T], n: f64) -> Vec<T> { a.iter().skip(_count(n)).cloned().collect() }"], "array/takeLast": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _take_last<T: Clone>(a: &[T], n: f64) -> Vec<T> { let k = _count(n).min(a.len()); a[a.len() - k..].to_vec() }"], "array/dropLast": ["fn _count(x: f64) -> usize {\n    if !x.is_finite() || x != x.trunc() || x < 0.0 { panic!(\"count is not a whole number from 0\"); }\n    x as usize\n}", "fn _drop_last<T: Clone>(a: &[T], n: f64) -> Vec<T> { let k = _count(n).min(a.len()); a[..a.len() - k].to_vec() }"], "array/append": ["fn _append<T: Clone>(a: &[T], x: T) -> Vec<T> { let mut v = a.to_vec(); v.push(x); v }"], "array/prepend": ["fn _prepend<T: Clone>(a: &[T], x: T) -> Vec<T> { let mut v = vec![x]; v.extend(a.iter().cloned()); v }"], "array/indexOf": ["fn _index_of<T: PartialEq>(a: &[T], x: &T) -> f64 { a.iter().position(|y| y == x).map_or(-1.0, |i| i as f64) }"], "array/unique": ["fn _unique<T: Clone + PartialEq>(a: &[T]) -> Vec<T> {\n    let mut out: Vec<T> = Vec::new();\n    for x in a { if !out.contains(x) { out.push(x.clone()); } }\n    out\n}"], "array/flatten": ["fn _flatten<T: Clone>(a: &[Vec<T>]) -> Vec<T> { a.iter().flat_map(|v| v.iter().cloned()).collect() }"], "array/zip": ["fn _zip<T: Clone>(a: &[T], b: &[T]) -> Vec<Vec<T>> { a.iter().cloned().zip(b.iter().cloned()).map(|(x, y)| vec![x, y]).collect() }"], "array/concat": ["macro_rules! _vconcat {\n    ($($x:expr),+ $(,)?) => {{\n        let mut v_ = Vec::new();\n        $( v_.extend($x.iter().cloned()); )+\n        v_\n    }};\n}"], "array/sort": ["fn _sort<T: Clone + PartialOrd>(a: &[T]) -> Vec<T> {\n    let mut v = a.to_vec();\n    v.sort_by(|x, y| x.partial_cmp(y).unwrap_or(std::cmp::Ordering::Equal));\n    v\n}", "#[derive(Clone, Debug, PartialEq)]\nstruct _Obj(serde_json::Value);\nimpl serde::Serialize for _Obj {\n    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { serde::Serialize::serialize(&self.0, s) }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Option<T> {\n    fn from(o: _Obj) -> Self { if o.0.is_null() { None } else { Some(serde_json::from_value(o.0).expect(\"a value of the declared shape\")) } }\n}\nimpl<T: serde::de::DeserializeOwned> From<_Obj> for Vec<T> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl<K: Ord + serde::de::DeserializeOwned, V: serde::de::DeserializeOwned> From<_Obj> for std::collections::BTreeMap<K, V> {\n    fn from(o: _Obj) -> Self { serde_json::from_value(o.0).expect(\"a value of the declared shape\") }\n}\nimpl From<_Obj> for serde_json::Value {\n    fn from(o: _Obj) -> Self { o.0 }\n}", "fn _j<T: serde::Serialize>(x: &T) -> serde_json::Value { serde_json::to_value(x).expect(\"a serializable value\") }", "fn _n(x: f64) -> serde_json::Value {\n    if x.is_finite() && x == x.trunc() && x.abs() < 9007199254740992.0 { serde_json::Value::from(x as i64) } else { serde_json::Number::from_f64(x).map_or(serde_json::Value::Null, serde_json::Value::Number) }\n}", "fn _arrk_rank(v: &serde_json::Value) -> u8 {\n    match v {\n        serde_json::Value::Null => 0,\n        serde_json::Value::Bool(_) => 1,\n        serde_json::Value::Number(_) => 2,\n        serde_json::Value::String(_) => 3,\n        serde_json::Value::Array(_) => 4,\n        _ => 5,\n    }\n}\nfn _arrk_order(a: &serde_json::Value, b: &serde_json::Value) -> std::cmp::Ordering {\n    let (ra, rb) = (_arrk_rank(a), _arrk_rank(b));\n    if ra != rb { return ra.cmp(&rb); }\n    match (a, b) {\n        (serde_json::Value::Bool(x), serde_json::Value::Bool(y)) => x.cmp(y),\n        (serde_json::Value::Number(x), serde_json::Value::Number(y)) => x.as_f64().partial_cmp(&y.as_f64()).unwrap_or(std::cmp::Ordering::Equal),\n        (serde_json::Value::String(x), serde_json::Value::String(y)) => x.cmp(y),\n        _ => std::cmp::Ordering::Equal,\n    }\n}\nfn _arrk_sort<T: serde::Serialize>(a: &T, key: &str, dir: &str) -> _Obj {\n    let mut items = match _j(a) { serde_json::Value::Array(v) => v, other => panic!(\"array/sort: expected an array, got {}\", other) };\n    let key = if key.is_empty() { None } else { Some(key) };\n    let ascending = match dir {\n        \"asc\" => true,\n        \"desc\" => false,\n        other => panic!(\"sort: direction \\\"{}\\\" is neither \\\"asc\\\" nor \\\"desc\\\"\", other),\n    };\n    let field = |v: &serde_json::Value| -> serde_json::Value {\n        match key {\n            Some(k) => v.as_object().and_then(|o| o.get(k)).cloned().unwrap_or(serde_json::Value::Null),\n            None => v.clone(),\n        }\n    };\n    let mut anchor: Option<serde_json::Value> = None;\n    for item in &items {\n        let sort_key = field(item);\n        if sort_key.is_null() { continue; }\n        match &anchor {\n            None => anchor = Some(sort_key),\n            Some(first) => {\n                if _arrk_rank(first) != _arrk_rank(&sort_key) { panic!(\"sort: expected {}, got {}\", first, sort_key); }\n            }\n        }\n    }\n    items.sort_by(|a, b| {\n        let ord = _arrk_order(&field(a), &field(b));\n        if ascending { ord } else { ord.reverse() }\n    });\n    _Obj(serde_json::Value::Array(items))\n}"], "array/reduce": ["fn _reduce<T: Clone, A>(a: &[T], init: A, f: impl Fn(A, T) -> A) -> A { a.iter().cloned().fold(init, f) }"], "math/round": ["fn _round(x: f64, d: f64) -> f64 {\n    let m = 10.0_f64.powf(d);\n    let r = (x.abs() * m + 0.5).floor() / m;\n    if x < 0.0 { -r } else { r }\n}"], "math/acos": ["fn _acos(x: f64) -> Option<f64> { if (-1.0..=1.0).contains(&x) { Some(x.acos()) } else { None } }"], "math/asin": ["fn _asin(x: f64) -> Option<f64> { if (-1.0..=1.0).contains(&x) { Some(x.asin()) } else { None } }"], "math/approach": ["fn _approach(c: f64, t: f64, d: f64) -> f64 { if (t - c).abs() <= d { t } else { c + (t - c).signum() * d } }"], "math/map": ["fn _map(v: f64, a: f64, b: f64, c: f64, d: f64) -> f64 { if b == a { c } else { c + (v - a) / (b - a) * (d - c) } }"], "math/wrap": ["fn _wrap(v: f64, lo: f64, hi: f64) -> f64 {\n    let r = hi - lo;\n    if r <= 0.0 { lo } else { ((v - lo) % r + r) % r + lo }\n}"], "array/insert": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _insert<T: Clone>(a: &[T], i: f64, x: T) -> Vec<T> {\n    let k = _whole(i);\n    if k < 0 || k as usize > a.len() { panic!(\"insert: index {} is not within a {}-item array\", k, a.len()); }\n    let mut v = a.to_vec();\n    v.insert(k as usize, x);\n    v\n}"], "array/remove": ["fn _whole(x: f64) -> i64 {\n    if !x.is_finite() || x != x.trunc() { panic!(\"expected a whole number, got {}\", x); }\n    x as i64\n}", "fn _remove<T: Clone>(a: &[T], i: f64) -> Vec<T> {\n    let k = _whole(i);\n    if k < 0 || k as usize >= a.len() { panic!(\"remove: index {} is outside a {}-item array\", k, a.len()); }\n    let mut v = a.to_vec();\n    v.remove(k as usize);\n    v\n}"], "array/removeItem": ["fn _remove_item<T: Clone + PartialEq>(a: &[T], x: &T) -> Vec<T> {\n    let mut v = a.to_vec();\n    if let Some(p) = v.iter().position(|y| y == x) { v.remove(p); }\n    v\n}"], "math/sqrt": ["fn _sqrt(x: f64) -> Option<f64> { if x < 0.0 { None } else { Some(x.sqrt()) } }"], "math/ln": ["fn _ln(x: f64) -> Option<f64> { if x <= 0.0 { None } else { Some(x.ln()) } }"], "math/log10": ["fn _log10(x: f64) -> Option<f64> { if x <= 0.0 { None } else { Some(x.log10()) } }"], "math/pow": ["fn _pow(a: f64, b: f64) -> Option<f64> { let r = a.powf(b); if r.is_finite() { Some(r) } else { None } }"], "math/sign": ["fn _sign(x: f64) -> f64 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }"], "object/get": ["trait _Lookup {\n    type Out;\n    fn lookup(&self, k: &str) -> Self::Out;\n}\nimpl<V: Clone> _Lookup for std::collections::BTreeMap<String, V> {\n    type Out = Option<V>;\n    fn lookup(&self, k: &str) -> Option<V> { self.get(k).cloned() }\n}\nimpl _Lookup for serde_json::Map<String, serde_json::Value> {\n    type Out = _Json;\n    fn lookup(&self, k: &str) -> _Json { _Json(self.get(k).cloned().filter(|v| !v.is_null())) }\n}\nimpl<T: _Lookup + ?Sized> _Lookup for &T {\n    type Out = T::Out;\n    fn lookup(&self, k: &str) -> T::Out { (**self).lookup(k) }\n}\n#[derive(Clone, Debug)]\nstruct _Json(Option<serde_json::Value>);\nimpl PartialEq<String> for _Json {\n    fn eq(&self, o: &String) -> bool { self.0.as_ref().and_then(|v| v.as_str()) == Some(o.as_str()) }\n}\nimpl PartialEq<f64> for _Json {\n    fn eq(&self, o: &f64) -> bool { self.0.as_ref().and_then(|v| v.as_f64()) == Some(*o) }\n}\nimpl PartialEq<bool> for _Json {\n    fn eq(&self, o: &bool) -> bool { self.0.as_ref().and_then(|v| v.as_bool()) == Some(*o) }\n}\nfn _get<M: _Lookup>(m: &M, k: &str) -> M::Out { m.lookup(k) }"], "object/merge": ["fn _merge<V: Clone>(a: &std::collections::BTreeMap<String, V>, b: &std::collections::BTreeMap<String, V>) -> std::collections::BTreeMap<String, V> {\n    let mut m = a.clone();\n    for (k, v) in b { m.insert(k.clone(), v.clone()); }\n    m\n}"], "object/pick": ["fn _pick<V: Clone>(m: &std::collections::BTreeMap<String, V>, ks: &[String]) -> std::collections::BTreeMap<String, V> {\n    m.iter().filter(|(k, _)| ks.contains(k)).map(|(k, v)| (k.clone(), v.clone())).collect()\n}"], "object/omit": ["fn _omit<V: Clone>(m: &std::collections::BTreeMap<String, V>, ks: &[String]) -> std::collections::BTreeMap<String, V> {\n    m.iter().filter(|(k, _)| !ks.contains(k)).map(|(k, v)| (k.clone(), v.clone())).collect()\n}"], "unsupported": ["#[derive(Clone)]\nstruct _U;\nfn _unsupported(op: &str) -> _U { panic!(\"no native template for operator {}\", op) }\nimpl From<_U> for f64 { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for String { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for bool { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<f64> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<String> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl From<_U> for Option<bool> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<T> From<_U> for Vec<T> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<T> From<_U> for Option<Vec<T>> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<K: Ord, V> From<_U> for std::collections::BTreeMap<K, V> { fn from(_: _U) -> Self { panic!(\"unsupported\") } }\nimpl<K: Ord, V> From<_U> for Option<std::collections::BTreeMap<K, V>> { fn from(_: _U) -> Self { pa