        (set @entity.value (let ((maxd (array/reduce @entity.doc.rows 0 (fn m r (math/max @m @r.d))))) (let ((fin (array/reduce (array/range 0 @maxd) @entity.doc.rows (fn acc s (let ((dd (- @maxd @s))) (array/map @acc (fn r (if (and (== @r.d @dd) (!= @r.kind "V")) { p: @r.p, par: @r.par, seg: @r.seg, d: @r.d, kind: @r.kind, n: @r.n, leaf: (let ((kids (array/filter @acc (fn k (== @k.par @r.p)))) (lv : TomlValue (if (or (== @r.kind "S") (== @r.kind "A")) (array/map @kids (fn k @k.leaf)) (object/fromEntries (array/map @kids (fn k [@k.seg, @k.leaf])))))) @lv) } @r)))))))) (object/fromEntries (array/map (array/filter @fin (fn r (== @r.par ""))) (fn r [@r.seg, @r.leaf]))))))
        (emit TOML_PARSED { requestId: @entity.requestId, value: @entity.value })
    }

    emits {
      TOML_LEXED -> internal { requestId : string! }
      TOML_DECODED -> internal { requestId : string! }
      TOML_STRUCTURED -> internal { requestId : string! }
      TOML_PARSED -> external {
        requestId : string!
        value : TomlValue!
      }
        @description "The document as a table."
        @tier "primary"
      TOML_REFUSED -> external {
        requestId : string!
        code : string!
        line : number!
        detail : string!
      }
        @description "Why the text was refused."
        @tier "primary"
    }

    listens {
      TOML_PARSE -> input {
        requestId : string
        text : string!
      }
        @description "Read this TOML text."
        @synonyms "parse toml, read toml"
    }
  }

  page boot as TomlOrbitalStart -> Toml
}
