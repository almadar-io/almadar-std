  (if (!= @w.err "") (object/merge @ds { err: @w.err, eline: @t.n, edet: @t.k })
  (if (not (== (if (== @t.k "hclose") @ds.hk "2") (if (== @t.k "hclose") "1" "2"))) (object/merge @ds { err: "syntax", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) })
  (if (not @is2)
    (if (== @r null) (object/merge @ds { rows: (array/append @w.rows { p: @e, par: @w.path, seg: @lseg, d: (+ @w.depth 1), kind: "H", n: 0, leaf: "" }), ph: "A", ks: (array/slice @ds.ks 0 0), cur: @e, curd: (+ @w.depth 1) })
