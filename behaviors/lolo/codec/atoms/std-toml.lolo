        (emit TOML_STRUCTURED { requestId: @entity.requestId })

      TOML_STRUCTURED -> idle when (!= @entity.doc.err "")
        (emit TOML_REFUSED { requestId: @entity.requestId, code: @entity.doc.err, line: @entity.doc.eline, detail: @entity.doc.edet })
