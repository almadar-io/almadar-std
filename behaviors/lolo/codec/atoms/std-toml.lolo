        (emit TOML_REFUSED { requestId: @entity.requestId, code: @entity.err, line: @entity.errLine, detail: "" })
      TOML_DECODED -> idle when (== @entity.err "")
        (set @entity.doc (array/reduce @entity.toks (let ((d0 : TomlDoc { rows: [], ph: "L", ks: [], hk: "", cur: "", curd: 0, fr: [], err: "", eline: 0, edet: "" })) @d0) (fn ds t (if (!= @ds.err "") @ds (let ((ph @ds.ph) (top (if (== (array/len @ds.fr) 0) { p: "", d: 0, kind: "", n: 0 } (array/last @ds.fr))))
