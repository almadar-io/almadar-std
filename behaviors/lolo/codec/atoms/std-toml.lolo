  (let ((bumped (if @isA (array/append (array/slice @ds.fr 0 (- (array/len @ds.fr) 1)) { p: @top.p, d: @top.d, kind: @top.kind, n: (+ @top.n 1) }) @ds.fr)))
   (object/merge @ds { rows: (array/append @w.rows { p: @e, par: @w.path, seg: @lseg, d: (+ @w.depth 1), kind: "@knd", n: 0, leaf: "" }), ph: (if (== @knd "S") "V0" "T0"), ks: (array/slice @ds.ks 0 0), fr: (array/append @bumped { p: @e, d: (+ @w.depth 1), kind: @knd, n: 0 }) })))))))) (object/merge @ds { err: "syntax", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) }))
