        (if (or (== @r.kind "V") (or (== @r.kind "S") (== @r.kind "T"))) (object/merge @ds { err: "duplicate-key", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) }) (object/merge @ds { err: "table-conflict", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) }))))
    (if (== @r null) (object/merge @ds { rows: (array/append (array/append @w.rows { p: @e, par: @w.path, seg: @lseg, d: (+ @w.depth 1), kind: "A", n: 1, leaf: "" }) { p: (str/concat @e ".#0"), par: @e, seg: "#0", d: (+ @w.depth 2), kind: "H", n: 0, leaf: "" }), ph: "A", ks: (array/slice @ds.ks 0 0), cur: (str/concat @e ".#0"), curd: (+ @w.depth 2) })
      (if (== @r.kind "A") (object/merge @ds { rows: (array/append (array/map @w.rows (fn q (if (== @q.p @e) { p: @q.p, par: @q.par, seg: @q.seg, d: @q.d, kind: "A", n: (+ @r.n 1), leaf: @q.leaf } @q))) { p: (str/concat @e ".#" @r.n), par: @e, seg: (str/concat "#" @r.n), d: (+ @w.depth 2), kind: "H", n: 0, leaf: "" }), ph: "A", ks: (array/slice @ds.ks 0 0), cur: (str/concat @e ".#" @r.n), curd: (+ @w.depth 2) })
        (if (or (== @r.kind "V") (or (== @r.kind "S") (== @r.kind "T"))) (object/merge @ds { err: "duplicate-key", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) }) (object/merge @ds { err: "table-conflict", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) })))))))))) (object/merge @ds { err: "syntax", eline: @t.n, edet: (if (== @t.v "") @t.k @t.v) }))
(if (or (== @t.k "aopen") (== @t.k "topen")) (if (or (== @ph "V") (== @ph "V0")) (let ((isA (== @ds.ph "V0")) (top (if (== (array/len @ds.fr) 0) { p: "", d: 0, kind: "", n: 0 } (array/last @ds.fr))) (knd (if (== @t.k "aopen") "S" "T")))
 (let ((base (if @isA @top.p (if (== (array/len @ds.fr) 0) @ds.cur @top.p))) (bd (if @isA @top.d (if (== (array/len @ds.fr) 0) @ds.curd @top.d))))
 (let ((w (if @isA { rows: @ds.rows, path: @base, depth: @bd, err: "" } (array/reduce (array/range 0 (- (array/len @ds.ks) 1)) { rows: @ds.rows, path: @base, depth: @bd, err: "" } (fn wa j (if (!= @wa.err "") @wa (let ((sg (array/nth @ds.ks @j))) (let ((e (if (== @wa.path "") (str/replaceAll (str/replaceAll (str/replaceAll @sg "%" "%25") "." "%2E") "#" "%23") (str/concat @wa.path "." (str/replaceAll (str/replaceAll (str/replaceAll @sg "%" "%25") "." "%2E") "#" "%23"))))) (let ((r (array/find @wa.rows (fn q (== @q.p @e))))) (if (== @r null) { rows: (array/append @wa.rows { p: @e, par: @wa.path, seg: @sg, d: (+ @wa.depth 1), kind: "D", n: 0, leaf: "" }), path: @e, depth: (+ @wa.depth 1), err: "" } (if (== @r.kind "D") { rows: @wa.rows, path: @e, depth: (+ @wa.depth 1), err: "" } (if (or (== @r.kind "H") (or (== @r.kind "I") (== @r.kind "A"))) { rows: @wa.rows, path: @e, depth: @wa.depth, err: "table-conflict" } { rows: @wa.rows, path: @e, depth: @wa.depth, err: "duplicate-key" }))))))))))) (lseg (if @isA (str/concat "#" @top.n) (array/last @ds.ks))))
 (let ((e (if (== @w.path "") (if @isA @lseg (str/replaceAll (str/replaceAll (str/replaceAll @lseg "%" "%25") "." "%2E") "#" "%23")) (str/concat @w.path "." (if @isA @lseg (str/replaceAll (str/replaceAll (str/replaceAll @lseg "%" "%25") "." "%2E") "#" "%23"))))))
  (if (!= @w.err "") (object/merge @ds { err: @w.err, eline: @t.n, edet: @t.k })
