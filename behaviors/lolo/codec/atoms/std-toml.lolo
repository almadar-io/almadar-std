app std-toml [
  version: "1.0.0",
  description: "std-toml — TOML 1.0 text to a value over str/*, array/*, object/*, json/parse and math/*, no new operators. TOML_PARSE { requestId?, text } answers TOML_PARSED { requestId, value } (the document as a Map) or TOML_REFUSED { requestId, code, line, detail }, staged as lex (one array/reduce over the characters), decode (basic-string escapes through json/parse), structure (one array/reduce over the tokens into path-keyed rows that enforce duplicate-key and table-redefinition rules) and collapse (rows folded bottom-up by depth). Covers tables, dotted tables, arrays of tables, bare, quoted and dotted keys, basic, literal and multi-line strings, decimal, hex, octal and binary integers with underscores, floats, booleans, arrays and inline tables. Offset date-times, local date-times, local dates and local times are returned as the string as written, because the value type has no date and a string loses nothing; integers and floats are both numbers, so 1 and 1.0 read the same. Left out and refused by code: integers beyond 2^53-1 (integer-range), inf and nan (special-float); a date is checked for its month and for the days of that month, leap years included; a date and time separated by one space is read as one date-time. Every request takes an optional requestId that every answer and internal stage event echoes. Refusal codes are closed: unexpected-char, unterminated-string, unterminated-array, inline-newline, control-char, bad-escape, syntax, bad-value, integer-range, special-float, duplicate-key, table-conflict, reserved-key."
]
uses Spec from "almadar-std/toml"

type TomlValue = string | number | boolean | [TomlValue] | Map string TomlValue
type TomlText = string
type TomlTok = { k : string!, v : string!, n : number!, f : string!, e : string! }
type TomlRow = { p : string!, par : string!, seg : string!, d : number!, kind : string!, n : number!, leaf : TomlValue! }
type TomlFrame = { p : string!, d : number!, kind : string!, n : number! }
type TomlDoc = { rows : [TomlRow]!, ph : string!, ks : [string]!, hk : string!, cur : string!, curd : number!, fr : [TomlFrame]!, err : string!, eline : number!, edet : string! }
type TomlLex = { toks : [TomlTok]!, mode : string!, buf : string!, line : number!, skip : number!, stk : string!, ctx : string!, ls : boolean!, inh : boolean!, vb : boolean!, err : string!, eline : number!, edet : string!, tline : number!, oline : number! }

orbital TomlOrbital {
  entity TomlRun [runtime] {
    id : string!
    requestId : string = ""
    lex : TomlLex = { toks: [], mode: "", buf: "", line: 1, skip: 0, stk: "", ctx: "k", ls: true, inh: false, vb: false, err: "", eline: 0, edet: "", tline: 1, oline: 1 }
    toks : [TomlTok] = []
    err : string = ""
    errLine : number = 0
    errDetail : string = ""
    doc : TomlDoc = { rows: [], ph: "L", ks: [], hk: "", cur: "", curd: 0, fr: [], err: "", eline: 0, edet: "" }
    value : TomlValue
  }

  trait Toml -> TomlRun [client] {
    initial: idle

    state idle {
      TOML_PARSE -> idle
        (set @entity.requestId (str/default ?requestId ""))
        (set @entity.lex (let ((cs (str/split (str/concat (str/replaceAll ?text "\r\n" "\n") "\n") ""))) (array/reduce (array/range 0 (array/len @cs)) { toks: [], mode: "", buf: "", line: 1, skip: 0, stk: "", ctx: "k", ls: true, inh: false, vb: false, err: "", eline: 0, edet: "", tline: 1, oline: 1 } (fn a i (if (> (str/len @a.err) 0) @a (if (> @a.skip 0) (object/merge @a { skip: (- @a.skip 1) }) (let ((c (array/nth @cs @i)) (n1 (array/nth @cs (+ @i 1))) (n2 (array/nth @cs (+ @i 2))) (n3 (array/nth @cs (+ @i 3)))) (let ((a1 (if (and (== @a.mode "cm") (== @c "\n")) (object/merge @a { mode: "" }) (if (and (== @a.mode "bare") (not (or (validate/pattern @c (if @a.vb "^[A-Za-z0-9_.:+-]$" "^[A-Za-z0-9_-]$")) (and (== @c " ") (and @a.vb (and (validate/pattern @a.buf "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") (validate/pattern @n1 "^[0-9]$"))))))) (object/merge @a { toks: (array/append @a.toks { k: "bare", v: @a.buf, n: @a.tline, f: "", e: "" }), mode: "", buf: "", ctx: "x" }) @a)))) (let ((top (if (== @a1.stk "") "" (str/slice @a1.stk (- (str/len @a1.stk) 1) (str/len @a1.stk))))) (if (or (== @a1.mode "bs") (or (== @a1.mode "ls") (or (== @a1.mode "bm") (== @a1.mode "lm")))) (let ((m @a1.mode)) (let ((multi (or (== @m "bm") (== @m "lm"))) (lit (or (== @m "ls") (== @m "lm"))) (qc (if (or (== @m "ls") (== @m "lm")) "'" "\u{22}"))) (let ((isq (== @c @qc))) (let ((fin (if @multi (and @isq (and (== @n1 @qc) (and (== @n2 @qc) (!= @n3 @qc)))) @isq)))
  (if @fin (object/merge @a1 { toks: (array/append @a1.toks { k: "str", v: @a1.buf, n: @a1.tline, f: @m, e: "" }), mode: "", buf: "", ctx: "x", ls: false, skip: (if @multi 2 0) })
  (if (and (not @lit) (== @c "\\")) (object/merge @a1 { buf: (str/concat @a1.buf @c @n1), skip: 1, line: (if (== @n1 "\n") (+ @a1.line 1) @a1.line) })
  (if (and (== @c "\n") (not @multi)) (object/merge @a1 { err: "unterminated-string", eline: @a1.line, edet: @c })
  (object/merge @a1 { buf: (str/concat @a1.buf @c), line: (if (== @c "\n") (+ @a1.line 1) @a1.line) })))))))) (if (== @a1.mode "cm") @a1 (if (== @a1.mode "bare") (object/merge @a1 { buf: (str/concat @a1.buf @c) }) (if (or (== @c " ") (== @c "\t")) @a1
(if (== @c "\n")
  (if (== @a1.stk "")
    (object/merge @a1 { toks: (array/append @a1.toks { k: "nl", v: "", n: @a1.line, f: "", e: "" }), ctx: "k", ls: true, inh: false, line: (+ @a1.line 1) })
    (if (== @top "a") (object/merge @a1 { line: (+ @a1.line 1) }) (object/merge @a1 { err: "inline-newline", eline: @a1.line, edet: @c })))
(if (== @c "#") (object/merge @a1 { mode: "cm" })
(if (== @c "\u{22}")
  (if (and (== @n1 "\u{22}") (== @n2 "\u{22}")) (object/merge @a1 { mode: "bm", buf: "", skip: 2, tline: @a1.line, ls: false }) (object/merge @a1 { mode: "bs", buf: "", tline: @a1.line, ls: false }))
(if (== @c "'")
  (if (and (== @n1 "'") (== @n2 "'")) (object/merge @a1 { mode: "lm", buf: "", skip: 2, tline: @a1.line, ls: false }) (object/merge @a1 { mode: "ls", buf: "", tline: @a1.line, ls: false }))
(if (== @c "=") (object/merge @a1 { toks: (array/append @a1.toks { k: "eq", v: "", n: @a1.line, f: "", e: "" }), ctx: "v", ls: false })
(if (== @c ".") (object/merge @a1 { toks: (array/append @a1.toks { k: "dot", v: "", n: @a1.line, f: "", e: "" }), ctx: "k", ls: false })
(if (== @c ",")
  (if (== @top "a") (object/merge @a1 { toks: (array/append @a1.toks { k: "comma", v: "", n: @a1.line, f: "", e: "" }), ctx: "v", ls: false })
    (if (== @top "t") (object/merge @a1 { toks: (array/append @a1.toks { k: "comma", v: "", n: @a1.line, f: "", e: "" }), ctx: "k", ls: false }) (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c })))
(if (== @c "[")
  (if (== @a1.ctx "v") (object/merge @a1 { toks: (array/append @a1.toks { k: "aopen", v: "", n: @a1.line, f: "", e: "" }), stk: (str/concat @a1.stk "a"), oline: (if (== @a1.stk "") @a1.line @a1.oline), ctx: "v", ls: false })
    (if (and (== @a1.ctx "k") (and (== @a1.stk "") @a1.ls))
      (if (== @n1 "[") (object/merge @a1 { toks: (array/append @a1.toks { k: "hopen2", v: "", n: @a1.line, f: "", e: "" }), skip: 1, inh: true, ls: false }) (object/merge @a1 { toks: (array/append @a1.toks { k: "hopen", v: "", n: @a1.line, f: "", e: "" }), inh: true, ls: false }))
      (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c })))
(if (== @c "]")
  (if (== @top "a") (object/merge @a1 { toks: (array/append @a1.toks { k: "aclose", v: "", n: @a1.line, f: "", e: "" }), stk: (str/slice @a1.stk 0 (- (str/len @a1.stk) 1)), ctx: "x", ls: false })
    (if @a1.inh
      (if (== @n1 "]") (object/merge @a1 { toks: (array/append @a1.toks { k: "hclose2", v: "", n: @a1.line, f: "", e: "" }), skip: 1, inh: false, ctx: "x" }) (object/merge @a1 { toks: (array/append @a1.toks { k: "hclose", v: "", n: @a1.line, f: "", e: "" }), inh: false, ctx: "x" }))
      (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c })))
(if (== @c "{")
  (if (== @a1.ctx "v") (object/merge @a1 { toks: (array/append @a1.toks { k: "topen", v: "", n: @a1.line, f: "", e: "" }), stk: (str/concat @a1.stk "t"), oline: (if (== @a1.stk "") @a1.line @a1.oline), ctx: "k", ls: false }) (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c }))
(if (== @c "}")
  (if (== @top "t") (object/merge @a1 { toks: (array/append @a1.toks { k: "tclose", v: "", n: @a1.line, f: "", e: "" }), stk: (str/slice @a1.stk 0 (- (str/len @a1.stk) 1)), ctx: "x", ls: false }) (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c }))
(if (validate/pattern @c "^[A-Za-z0-9_+-]$") (object/merge @a1 { mode: "bare", buf: @c, vb: (== @a1.ctx "v"), tline: @a1.line, ls: false })
  (object/merge @a1 { err: "unexpected-char", eline: @a1.line, edet: @c }))))))))))))))))))))))))))
        (set @entity.err (if (!= @entity.lex.err "") @entity.lex.err (if (!= @entity.lex.mode "") "unterminated-string" (if (!= @entity.lex.stk "") "unterminated-array" ""))))
        (set @entity.errLine (if (!= @entity.lex.err "") @entity.lex.eline (if (!= @entity.lex.mode "") @entity.lex.tline (if (!= @entity.lex.stk "") @entity.lex.oline (- @entity.lex.line 1)))))
        (set @entity.errDetail (if (!= @entity.lex.err "") @entity.lex.edet ""))
