        (set @entity.err (let ((bads (array/filter @entity.toks (fn t (!= @t.e ""))))) (if (== (array/len @bads) 0) "" (object/get (array/first @bads) "e"))))
        (set @entity.errLine (let ((bads (array/filter @entity.toks (fn t (!= @t.e ""))))) (if (== (array/len @bads) 0) 0 (object/get (array/first @bads) "n"))))
        (emit TOML_DECODED { requestId: @entity.requestId })

