app std-identity-binding [
  version: "3.0.0",
  description: "std-identity-binding — the one owner of a sign-in (docs/Almadar_Orbital_Core.md §11). It runs in the program session only. BEARER_PRESENT { requestId, authorization, clientId, self? } is the ask every consumer makes (the dispatch route, the ticket mint, a guest session, a persona); it answers exactly one outcome per ask: IDENTITY_BOUND { requestId }, IDENTITY_ANONYMOUS { requestId }, IDENTITY_REFUSED { requestId, reason } or IDENTITY_SESSION_ENDED { requestId }. It asks its composed std-bearer-verify once (BEARER_VERIFY), in the program session, so one key cache serves the whole program; the verdict arrives as BEARER_VERIFIED { verified } or as ANONYMOUS_SEEN, REFUSED_SEEN or KEY_SEEN (an API key makes no Verified). A verified credential is bound to the named viewer's session with (identity/sign-in verified clientId) and every other verdict signs that session out with (identity/sign-out clientId), so the session the request runs in is signed in or out again on every request (a bearer header is stateless); with self true the ask binds the session the step runs in instead (no session named). The outcome of a sign-in or sign-out is matched to its ask by the session it names. An ask naming no client session is anonymous when it carries no header and refused no-client-session when it does. A sign-in that answers no-identity with createIdentity on persists a row of identityEntity (id the subject, email and name from the claims, createRole when set) and verifies again once; a create that fails refuses every ask still waiting on a row, identity-store; any other sign-in failure is refused identity-<kind>; an API key is refused api-key-identity; an ended session answers IDENTITY_SESSION_ENDED. The role is only ever the identity row's."
]
type SignInStage = "verifying" | "signing" | "signing-out" | "creating" | "created" | "failed"
type SignInAsk = { requestId : number!, session : string!, self : boolean!, authorization : string!, stage : SignInStage!, reason : string!, subject : string!, email : string!, name : string!, created : boolean! }

orbital IdentityBindingOrbital {
  entity IdentityRow [persistent: viewer_rows] {
    @create none "A substrate atom: the composing program decides who reaches the trait that writes these rows, so this atom states no creator of its own."
    @read none "This program declares no identity entity, so it has no signed-in viewer to scope reads to: every visitor may read these rows."
    id : string! @description "The identity row's key: the verified subject."
    email : string @description "The person's email." = ""
    name : string @description "The person's display name." = ""
    role : string @description "What the person may do in the app." = ""
  }

  entity IdentityBindingState [runtime] {
    id : string!
    asks : [SignInAsk] @description "The asks whose outcome has not been answered, oldest first; a verdict takes its own by requestId, a sign-in or sign-out outcome by the session it names." = []
  }

  trait IdentityBinder -> IdentityBindingState [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.asks [])

      BEARER_PRESENT -> idle when (and (not (default @payload.self false)) (= (default @payload.clientId "") "") (= (default @payload.authorization "") ""))
        (emit IDENTITY_ANONYMOUS { requestId: (default @payload.requestId 0) })
      BEARER_PRESENT -> idle when (and (not (default @payload.self false)) (= (default @payload.clientId "") "") (!= (default @payload.authorization "") ""))
        (emit IDENTITY_REFUSED { requestId: (default @payload.requestId 0), reason: "no-client-session" })
      BEARER_PRESENT -> idle when (or (default @payload.self false) (!= (default @payload.clientId "") ""))
        (set @entity.asks (array/append @entity.asks { requestId: (default @payload.requestId 0), session: (if (default @payload.self false) "" (default @payload.clientId "")), self: (default @payload.self false), authorization: (default @payload.authorization ""), stage: "verifying", reason: "", subject: "", email: "", name: "", created: false }))
        (emit BEARER_VERIFY { requestId: (default @payload.requestId 0), authorization: (default @payload.authorization "") })

      BEARER_VERIFIED -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying") (not @a.self))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.requestId @payload.requestId) (= @x.stage "verifying")))) { requestId: 0, session: "", self: false, authorization: "", stage: "verifying", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/map @entity.asks (fn x (if (= @x.requestId @a.requestId) (object/merge @x { stage: "signing", subject: @payload.verified.subject, email: (let ((f (array/find @payload.verified.claims (fn c (= @c.name "email"))))) (if (= @f null) "" (default (as @f.value string) ""))), name: (let ((f (array/find @payload.verified.claims (fn c (= @c.name "name"))))) (if (= @f null) "" (default (as @f.value string) ""))) }) @x))))
            (identity/sign-in @payload.verified @a.session { emit: { success: IDENTITY_SIGNED_IN, failure: IDENTITY_SIGN_IN_FAILED } })))
      BEARER_VERIFIED -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying") @a.self)))
        (set @entity.asks (array/map @entity.asks (fn x (if (and (= @x.requestId @payload.requestId) (= @x.stage "verifying")) (object/merge @x { stage: "signing", subject: @payload.verified.subject, email: (let ((f (array/find @payload.verified.claims (fn c (= @c.name "email"))))) (if (= @f null) "" (default (as @f.value string) ""))), name: (let ((f (array/find @payload.verified.claims (fn c (= @c.name "name"))))) (if (= @f null) "" (default (as @f.value string) ""))) }) @x))))
        (identity/sign-in @payload.verified { emit: { success: IDENTITY_SIGNED_IN, failure: IDENTITY_SIGN_IN_FAILED } })
      BEARER_VERIFIED -> idle when (not (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying")))))

      ANONYMOUS_SEEN -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying"))))
        (emit SIGN_OUT_ASKED { requestId: @payload.requestId, reason: "" })
      ANONYMOUS_SEEN -> idle when (not (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying")))))
      REFUSED_SEEN -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying"))))
        (emit SIGN_OUT_ASKED { requestId: @payload.requestId, reason: @payload.reason })
      REFUSED_SEEN -> idle when (not (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying")))))
      KEY_SEEN -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying"))))
        (emit SIGN_OUT_ASKED { requestId: @payload.requestId, reason: "api-key-identity" })
      KEY_SEEN -> idle when (not (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (= @a.stage "verifying")))))

      SIGN_OUT_ASKED -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) (not @a.self))))
        (let ((a (default (array/find @entity.asks (fn x (= @x.requestId @payload.requestId))) { requestId: 0, session: "", self: false, authorization: "", stage: "verifying", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/map @entity.asks (fn x (if (= @x.requestId @a.requestId) (object/merge @x { stage: "signing-out", reason: @payload.reason }) @x))))
            (identity/sign-out @a.session { emit: { success: IDENTITY_SIGNED_OUT, failure: IDENTITY_SIGN_OUT_FAILED } })))
      SIGN_OUT_ASKED -> idle when (array/some @entity.asks (fn a (and (= @a.requestId @payload.requestId) @a.self)))
        (set @entity.asks (array/map @entity.asks (fn x (if (= @x.requestId @payload.requestId) (object/merge @x { stage: "signing-out", reason: @payload.reason }) @x))))
        (identity/sign-out { emit: { success: IDENTITY_SIGNED_OUT, failure: IDENTITY_SIGN_OUT_FAILED } })

      IDENTITY_SIGNED_IN -> idle when (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing"))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/filter @entity.asks (fn x (!= @x.requestId @a.requestId))))
            (emit IDENTITY_BOUND { requestId: @a.requestId, subject: (default @payload.subject "") })))
      IDENTITY_SIGNED_IN -> idle when (not (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing")))))

      IDENTITY_SIGN_IN_FAILED -> idle when (and (= (default @payload.kind "") "session-ended") (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing")))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/filter @entity.asks (fn x (!= @x.requestId @a.requestId))))
            (emit IDENTITY_SESSION_ENDED { requestId: @a.requestId })))
      IDENTITY_SIGN_IN_FAILED -> idle when (and (= (default @payload.kind "") "no-identity") @config.createIdentity (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing") (not @a.created)))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/map @entity.asks (fn x (if (= @x.requestId @a.requestId) (object/merge @x { stage: "creating" }) @x))))
            (emit CREATE_ROW { subject: @a.subject, email: @a.email, name: @a.name })))
      IDENTITY_SIGN_IN_FAILED -> idle when (and (not (= (default @payload.kind "") "session-ended")) (not (and (= (default @payload.kind "") "no-identity") @config.createIdentity (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing") (not @a.created)))))) (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing")))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing", reason: "", subject: "", email: "", name: "", created: false })))
          (emit SIGN_OUT_ASKED { requestId: @a.requestId, reason: (str/concat "identity-" (default @payload.kind "")) }))
      IDENTITY_SIGN_IN_FAILED -> idle when (not (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing")))))

      IDENTITY_SIGNED_OUT -> idle when (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing-out"))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing-out")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing-out", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/filter @entity.asks (fn x (!= @x.requestId @a.requestId))))
            (if (= @a.reason "")
              (emit IDENTITY_ANONYMOUS { requestId: @a.requestId })
              (emit IDENTITY_REFUSED { requestId: @a.requestId, reason: @a.reason }))))
      IDENTITY_SIGNED_OUT -> idle when (not (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing-out")))))
      IDENTITY_SIGN_OUT_FAILED -> idle when (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing-out"))))
        (let ((a (default (array/find @entity.asks (fn x (and (= @x.session (default @payload.session "")) (= @x.stage "signing-out")))) { requestId: 0, session: "", self: false, authorization: "", stage: "signing-out", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/filter @entity.asks (fn x (!= @x.requestId @a.requestId))))
            (if (= (default @payload.kind "") "session-ended")
              (emit IDENTITY_SESSION_ENDED { requestId: @a.requestId })
              (emit IDENTITY_REFUSED { requestId: @a.requestId, reason: (if (= @a.reason "") (str/concat "identity-" (default @payload.kind "")) @a.reason) }))))
      IDENTITY_SIGN_OUT_FAILED -> idle when (not (array/some @entity.asks (fn a (and (= @a.session (default @payload.session "")) (= @a.stage "signing-out")))))

      CREATE_ROW -> idle
        (persist create @config.identityEntity (if (= @config.createRole "") { id: @payload.subject, email: @payload.email, name: @payload.name } { id: @payload.subject, email: @payload.email, name: @payload.name, role: @config.createRole }) { emit: { success: IDENTITY_CREATED, failure: IDENTITY_CREATE_FAILED } })
      IDENTITY_CREATED -> idle
        (set @entity.asks (array/map @entity.asks (fn x (if (and (= @x.stage "creating") (= @x.subject (default @payload.id ""))) (object/merge @x { stage: "created", created: true }) @x))))
        (emit REVERIFY_DRAIN { })
      IDENTITY_CREATE_FAILED -> idle
        (set @entity.asks (array/map @entity.asks (fn x (if (= @x.stage "creating") (object/merge @x { stage: "failed" }) @x))))
        (emit REFUSE_DRAIN { })

      REVERIFY_DRAIN -> idle when (array/some @entity.asks (fn x (= @x.stage "created")))
        (let ((a (default (array/find @entity.asks (fn x (= @x.stage "created"))) { requestId: 0, session: "", self: false, authorization: "", stage: "created", reason: "", subject: "", email: "", name: "", created: true })))
          (do
            (set @entity.asks (array/map @entity.asks (fn x (if (= @x.requestId @a.requestId) (object/merge @x { stage: "verifying" }) @x))))
            (emit BEARER_VERIFY { requestId: @a.requestId, authorization: @a.authorization })
            (emit REVERIFY_NEXT { })))
      REVERIFY_DRAIN -> idle when (not (array/some @entity.asks (fn x (= @x.stage "created"))))
      REVERIFY_NEXT -> idle
        (emit REVERIFY_DRAIN { })
      REFUSE_DRAIN -> idle when (array/some @entity.asks (fn x (= @x.stage "failed")))
        (let ((a (default (array/find @entity.asks (fn x (= @x.stage "failed"))) { requestId: 0, session: "", self: false, authorization: "", stage: "failed", reason: "", subject: "", email: "", name: "", created: false })))
          (do
            (set @entity.asks (array/filter @entity.asks (fn x (!= @x.requestId @a.requestId))))
            (emit IDENTITY_REFUSED { requestId: @a.requestId, reason: "identity-store" })
            (emit REFUSE_NEXT { })))
      REFUSE_DRAIN -> idle when (not (array/some @entity.asks (fn x (= @x.stage "failed"))))
      REFUSE_NEXT -> idle
        (emit REFUSE_DRAIN { })
    }

    emits {
      IDENTITY_BOUND -> external {
        requestId : number
        subject : string
      }
        @description "The ask's credential is signed in as the identity of its session; subject is who it signed in as."
        @synonyms "identity bound, signed in"
        @tier "primary"
      IDENTITY_ANONYMOUS -> external {
        requestId : number
      }
        @description "The ask carried no credential; its session is signed out."
        @synonyms "anonymous request"
        @tier "primary"
      IDENTITY_REFUSED -> external {
        requestId : number
        reason : string!
      }
        @description "The ask's credential was refused (by the verifier, or no-client-session, identity-<kind>, identity-store, api-key-identity); its session is signed out when it has one."
        @synonyms "bearer refused, sign-in refused"
        @tier "primary"
      IDENTITY_SESSION_ENDED -> external {
        requestId : number
      }
        @description "The ask's client session has ended (EXEC-DIST-9: its live stream dropped and it went quiet), so nothing was bound; only a mount revives it."
        @synonyms "session ended, reconnect"
        @tier "primary"
      BEARER_VERIFY -> external {
        requestId : number
        authorization : string
      }
        @description "Ask the composed bearer verifier, in the program session, about the ask's header."
        @tier "secondary"
      IDENTITY_SIGNED_IN {
        subject : string
        session : string
      }
        @description "Internal: identity/sign-in bound the subject to the session it names."
        @tier "internal"
      IDENTITY_SIGN_IN_FAILED {
        error : string
        kind : string
        session : string
      }
        @description "Internal: identity/sign-in refused (unsealed, no-identity, store, session-ended, invalid, not-program-session)."
        @tier "internal"
      IDENTITY_SIGNED_OUT {
        subject : string
        session : string
      }
        @description "Internal: identity/sign-out returned the named session to the anonymous viewer."
        @tier "internal"
      IDENTITY_SIGN_OUT_FAILED {
        error : string
        kind : string
        session : string
      }
        @description "Internal: identity/sign-out refused (session-ended, invalid, not-program-session)."
        @tier "internal"
      SIGN_OUT_ASKED {
        requestId : number!
        reason : string!
      }
        @description "Internal: sign the ask's session out; an empty reason answers anonymous, any other refuses with it."
        @tier "internal"
      CREATE_ROW {
        subject : string!
        email : string!
        name : string!
      }
        @description "Internal: write the first identity row of a verified subject (createIdentity)."
        @tier "internal"
      IDENTITY_CREATED {
        id : string
      }
        @description "Internal: the first identity row of the subject is written (createIdentity)."
        @tier "internal"
      IDENTITY_CREATE_FAILED {
        error : string
      }
        @description "Internal: the first identity row could not be written."
        @tier "internal"
      REVERIFY_DRAIN { }
        @description "Internal: verify again, one at a time, every ask whose subject's first row was just written."
        @tier "internal"
      REFUSE_DRAIN { }
        @description "Internal: refuse, one at a time, every ask whose identity row could not be written."
        @tier "internal"
      REVERIFY_NEXT { }
        @description "Internal: the next turn of REVERIFY_DRAIN."
        @tier "internal"
      REFUSE_NEXT { }
        @description "Internal: the next turn of REFUSE_DRAIN."
        @tier "internal"
    }

    listens {
      BEARER_PRESENT {
        requestId : number
        authorization : string
        clientId : string
        self : boolean?
      }
        @description "Internal: a consumer asks for the request's credential to be signed in to its client session (or, with self, to the session the step runs in)."
      BEARER_VERIFIED {
        requestId : number
        verified : Verified!
      }
        @description "Internal: the verifier accepted the bearer; the sealed credential to sign in."
      KEY_SEEN {
        requestId : number
      }
        @description "Internal: an API key verified; it makes no Verified, so it binds no identity."
      ANONYMOUS_SEEN {
        requestId : number
      }
        @description "Internal: the presented header was absent."
      REFUSED_SEEN {
        requestId : number
        reason : string!
      }
        @description "Internal: the verifier refused the bearer."
    }

    config {
      identityEntity : entity = IdentityRow
        @label "Identity entity"
        @description "The program's [identity] entity: createIdentity writes the first row of a verified subject here (the row's id is the subject); the signed-in session reads its role from it."
        @tier "policy"
      createIdentity : boolean = false
        @label "Create the first identity row"
        @description "A verified subject with no row in identityEntity gets one (id the subject, email and name from the claims, and the role createRole names when it names one; no other field is written), then the ask is verified again. Off, such an ask is refused identity-no-identity."
        @synonyms "auto-register, first sign-in row"
        @tier "policy"
      createRole : string = ""
        @label "Role of a first identity row"
        @description "The role written on the row createIdentity makes. Empty writes no role, so the new person holds none until someone gives them one; a role named here is held by everyone who signs in for the first time."
        @synonyms "default role, first role"
        @tier "policy"
    }
  }

  page boot as IdentityBindingStart -> IdentityBinder
}
