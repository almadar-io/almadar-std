app std-credential-admin [
  version: "1.0.0",
  description: "std-credential-admin — the policy of credential administration, as pure answers over the facts the host hands in; the host owns the store and the environment, the atom owns every rule. CRED_ADMIN_GATE: a list is open; set, remove, test, mode and rotate need a role among the admin roles (the list the caller parsed from its environment, admin and owner when it names none), failing closed on a missing, empty or differently cased role with AUTH_ERROR and the message forbidden: \"<verb>\" requires one of roles: <a, b>. CRED_ADMIN_SETTABLE: only a credential the named service declares may be written or removed. CRED_ADMIN_MASK and CRED_ADMIN_SAVE: only the last four UTF-16 units of a value ever leave. CRED_ADMIN_CATALOG: the registry services, a status row for those whose backend is production, simulated or stub and that are not credentials or workspace, then the program's own credential groups, each credential once. CRED_ADMIN_LIST: the masked inventory (store over environment over none, the environment hidden when the store alone decides, stored rows no group declares listed as stored connection references) and each service's status (real, mocked, not configured). CRED_ADMIN_TEST: credential presence only, never a live probe. CRED_ADMIN_MODE and CRED_ADMIN_ENV_MODE: the exact mock or real request, and the mock flag the environment names. CRED_ADMIN_SOURCE: the source word is store only when exactly \"store\", and the four host-setting names stay on the environment. CRED_ADMIN_SEED: the boot seed plan, each declared name once that the store lacks and the environment sets, names only. CRED_ADMIN_BOOT_CHECK: the required credentials of the called services that are not held. CRED_ADMIN_REQUIRE_STORE: set, remove and rotate need a store, and set adds the refusal tail. Encrypted storage, the store port and the boot execution stay with the host."
]
uses Spec from "almadar-std/credential-admin"

type CredDeclared = { envVar : string!, required : boolean!, description : string!, oneOf : string! }
type CredGroup = { service : string!, backend : string!, listed : boolean!, credentials : [CredDeclared]! }
type CredRegistryService = { name : string!, backend : string!, credentials : [CredDeclared]! }
type CredProgramCred = { group : string!, envVar : string!, description : string! }
type CredStored = { service : string!, envVar : string!, last4 : string! }
type CredSeedRow = { service : string!, envVar : string! }
type CredEnv = { name : string!, value : string! }
type CredEntry = { id : string!, service : string!, envVar : string!, required : boolean!, description : string!, configured : boolean!, source : string!, last4 : string! }
type CredServiceStatus = { id : string!, service : string!, configured : boolean!, mocked : boolean!, status : string!, backend : string!, needs : string! }

orbital CredentialAdminOrbital {
  type CRED_ADMIN_GATE = Event { verb : string!, role : string, allowedRoles : [string] } "Ask whether a caller's role may run a credential verb; allowedRoles is the list of admin roles, absent or empty for the default."

  type CRED_ADMIN_SETTABLE = Event { catalog : [CredGroup]!, service : string!, envVar : string! } "Ask whether envVar is a declared credential of service."

  type CRED_ADMIN_MASK = Event { value : string! } "Mask a value to its last four UTF-16 units."

  type CRED_ADMIN_SAVE = Event { service : string!, envVar : string!, value : string! } "Report a saved credential: the masked tail only."

  type CRED_ADMIN_CATALOG = Event { services : [CredRegistryService]!, program : [CredProgramCred]! } "Build the catalog from the registry services and the program's own credential groups."

  type CRED_ADMIN_LIST = Event { catalog : [CredGroup]!, stored : [CredStored]!, env : [CredEnv]!, filter : string, storeEnabled : boolean!, storeFirst : boolean!, mock : boolean! } "Build the masked inventory and the service statuses; env carries the non-empty environment values for the names the store is silent on."

  type CRED_ADMIN_TEST = Event { catalog : [CredGroup]!, service : string!, held : [string]! } "Check credential presence for a service; held names the declared credentials that resolve to a non-empty value."

  type CRED_ADMIN_MODE = Event { mode : string! } "Request mock or real mode."

  type CRED_ADMIN_ENV_MODE = Event { integrationsMode : string, useMockData : string } "Read the mock flag the environment names."

  type CRED_ADMIN_SOURCE = Event { source : string, name : string! } "Ask whether the credentials source word selects the store, and whether the credential name is answered from the store alone."

  type CRED_ADMIN_SEED = Event { catalog : [CredGroup]!, held : [string]!, present : [string]! } "Plan the boot seed: held names the store holds, present the declared names the host environment sets to a non-empty value."

  type CRED_ADMIN_BOOT_CHECK = Event { catalog : [CredGroup]!, services : [string]!, held : [string]! } "Ask which required credentials of the services the program calls are not held."

  type CRED_ADMIN_REQUIRE_STORE = Event { verb : string!, hasStore : boolean! } "Ask whether a verb can run on a host with or without a credential store."

  type CRED_ADMIN_ALLOWED = Event { verb : string! } "The gate admits the verb, or the credential is settable."

  type CRED_ADMIN_REFUSED = Event { code : string!, message : string! } "The request is refused; code is AUTH_ERROR for the gate and empty for a plain refusal."

  type CRED_ADMIN_MASKED = Event { last4 : string! } "The masked tail."

  type CRED_ADMIN_SAVED = Event { service : string!, envVar : string!, last4 : string! } "A credential was saved; only its last four units are reported."

  type CRED_ADMIN_CATALOGED = Event { groups : [CredGroup]! } "The catalog."

  type CRED_ADMIN_LISTED = Event { enabled : boolean!, mode : string!, services : [CredServiceStatus]!, entries : [CredEntry]! } "The masked inventory with each service's status."

  type CRED_ADMIN_TESTED = Event { service : string!, configured : boolean!, missing : [string]!, probed : boolean!, ok : boolean!, message : string! } "The presence check."

  type CRED_ADMIN_MODE_SET = Event { mock : boolean!, mode : string! } "The mode a request or the environment names."

  type CRED_ADMIN_SOURCED = Event { store : boolean!, storeOnly : boolean! } "The source word's verdict."

  type CRED_ADMIN_SEED_PLAN = Event { rows : [CredSeedRow]! } "The declared credentials to copy from the environment into the store; names only, no value."

  type CRED_ADMIN_OWED = Event { owed : [string]! } "The required credentials still owed, one line each."

  entity CredentialAdminRun [runtime] {
    id : string!
    group : [CredGroup] @description "The catalog last built." = []
    roles : [string] @description "The admin roles last resolved." = []
    last4 : string @description "The masked tail last produced." = ""
    mock : boolean @description "The mock flag last resolved." = false
  }

  trait CredentialAdmin -> CredentialAdminRun [client] {
    initial: idle

    state idle {
      INIT -> idle

      CRED_ADMIN_GATE -> idle
        (let (
            (roles (if (and (!= @payload.allowedRoles null) (> (array/len @payload.allowedRoles) 0)) @payload.allowedRoles ["admin" "owner"])))
          (do
            (set @entity.roles @roles)
            (if (or (== @payload.verb "list") (and (!= @payload.role null) (!= @payload.role "") (array/includes @roles @payload.role)))
              (emit CRED_ADMIN_ALLOWED { verb: @payload.verb })
              (emit CRED_ADMIN_REFUSED { code: "AUTH_ERROR", message: (str/concat "forbidden: \"" @payload.verb "\" requires one of roles: " (str/join @roles ", ")) }))))

      CRED_ADMIN_SETTABLE -> idle
        (let (
            (group (array/find @payload.catalog (fn (g) (== (object/get @g service) @payload.service))))
            (declared (if (== @group null) [] (object/get @group credentials))))
          (if (== (array/len @declared) 0)
            (emit CRED_ADMIN_REFUSED { code: "", message: (str/concat "Service \"" @payload.service "\" declares no credentials") })
            (if (array/some @declared (fn (d) (== (object/get @d envVar) @payload.envVar)))
              (emit CRED_ADMIN_ALLOWED { verb: "settable" })
              (emit CRED_ADMIN_REFUSED { code: "", message: (str/concat "\"" @payload.envVar "\" is not a declared credential of \"" @payload.service "\" (declared: " (str/join (array/map @declared (fn (d) (object/get @d envVar))) ", ") ")") }))))

      CRED_ADMIN_MASK -> idle
        (set @entity.last4 (str/slice @payload.value (math/max 0 (- (str/len @payload.value) 4)) (str/len @payload.value)))
        (emit CRED_ADMIN_MASKED { last4: @entity.last4 })

      CRED_ADMIN_SAVE -> idle
        (set @entity.last4 (str/slice @payload.value (math/max 0 (- (str/len @payload.value) 4)) (str/len @payload.value)))
        (emit CRED_ADMIN_SAVED { service: @payload.service, envVar: @payload.envVar, last4: @entity.last4 })

      CRED_ADMIN_CATALOG -> idle
        (let (
            (base (array/map @payload.services (fn (s) { service: (object/get @s name), backend: (object/get @s backend), listed: (and (array/includes ["production" "simulated" "stub"] (object/get @s backend)) (not (array/includes ["credentials" "workspace"] (object/get @s name)))), credentials: (object/get @s credentials) })))
            (groups (array/reduce @payload.program @base (fn (acc c)
                (if (array/some @acc (fn (g) (== (object/get @g service) (object/get @c group))))
                  (array/map @acc (fn (g) (if (and (== (object/get @g service) (object/get @c group)) (not (array/some (object/get @g credentials) (fn (d) (== (object/get @d envVar) (object/get @c envVar))))))
                    (object/merge @g { credentials: (array/append (object/get @g credentials) { envVar: (object/get @c envVar), required: false, description: (object/get @c description), oneOf: "" }) })
                    @g)))
                  (array/append @acc { service: (object/get @c group), backend: "", listed: false, credentials: [{ envVar: (object/get @c envVar), required: false, description: (object/get @c description), oneOf: "" }] }))))))
          (do
            (set @entity.group @groups)
            (emit CRED_ADMIN_CATALOGED { groups: @groups })))

      CRED_ADMIN_LIST -> idle
        (let (
            (filter (str/default @payload.filter ""))
            (groups (array/filter @payload.catalog (fn (g) (or (== @filter "") (== (object/get @g service) @filter)))))
            (declaredEntries (array/flatten (array/map @groups (fn (g) (array/map (object/get @g credentials) (fn (d)
                (let (
                    (stored (array/find @payload.stored (fn (s) (and (== (object/get @s service) (object/get @g service)) (== (object/get @s envVar) (object/get @d envVar))))))
                    (envRow (if (or @payload.storeFirst (!= @stored null)) null (array/find @payload.env (fn (e) (and (== (object/get @e name) (object/get @d envVar)) (!= (object/get @e value) ""))))))
                    (source (if (!= @stored null) "store" (if (!= @envRow null) "env" "none"))))
                  { id: (str/concat (object/get @g service) "/" (object/get @d envVar)), service: (object/get @g service), envVar: (object/get @d envVar), required: (object/get @d required), description: (object/get @d description), configured: (!= @source "none"), source: @source, last4: (if (!= @stored null) (object/get @stored last4) (if (!= @envRow null) (str/slice (object/get @envRow value) (math/max 0 (- (str/len (object/get @envRow value)) 4)) (str/len (object/get @envRow value))) "")) })))))))
            (storedOnly (array/map (array/filter @payload.stored (fn (s) (and (or (== @filter "") (== (object/get @s service) @filter)) (not (array/some @payload.catalog (fn (g) (and (== (object/get @g service) (object/get @s service)) (array/some (object/get @g credentials) (fn (d) (== (object/get @d envVar) (object/get @s envVar)))))))))))
                (fn (s) { id: (str/concat (object/get @s service) "/" (object/get @s envVar)), service: (object/get @s service), envVar: (object/get @s envVar), required: false, description: "Stored connection reference", configured: true, source: "store", last4: (object/get @s last4) })))
            (entries (array/concat @declaredEntries @storedOnly))
            (statuses (array/map (array/filter @groups (fn (g) (object/get @g listed))) (fn (g)
                (let (
                    (declared (object/get @g credentials))
                    (isOn (fn (d) (array/some @declaredEntries (fn (e) (and (== (object/get @e id) (str/concat (object/get @g service) "/" (object/get @d envVar))) (object/get @e configured))))))
                    (oneOfs (array/unique (array/map (array/filter @declared (fn (d) (!= (object/get @d oneOf) ""))) (fn (d) (object/get @d oneOf)))))
                    (groupMet (fn (name) (array/some (array/filter @declared (fn (d) (== (object/get @d oneOf) @name))) @isOn)))
                    (requires (or (array/some @declared (fn (d) (object/get @d required))) (> (array/len @oneOfs) 0)))
                    (ready (and @requires (array/every (array/filter @declared (fn (d) (object/get @d required))) @isOn) (array/every @oneOfs @groupMet)))
                    (mocked (and @payload.mock @ready))
                    (needs (str/join (array/concat (array/map (array/filter @declared (fn (d) (object/get @d required))) (fn (d) (object/get @d envVar))) (array/map @oneOfs (fn (name) (str/concat "one of " (str/join (array/map (array/filter @declared (fn (d) (== (object/get @d oneOf) @name))) (fn (d) (object/get @d envVar))) " / "))))) ", ")))
                  { id: (object/get @g service), service: (object/get @g service), configured: @ready, mocked: @mocked, status: (if @mocked "mocked" (if @ready "real" "not configured")), backend: (object/get @g backend), needs: (if @ready "" @needs) })))))
          (emit CRED_ADMIN_LISTED { enabled: @payload.storeEnabled, mode: (if @payload.mock "mock" "real"), services: @statuses, entries: @entries }))

      CRED_ADMIN_TEST -> idle
        (let (
            (group (array/find @payload.catalog (fn (g) (== (object/get @g service) @payload.service))))
            (declared (if (== @group null) [] (object/get @group credentials)))
            (anyRequired (array/some @declared (fn (d) (object/get @d required))))
            (subjects (let ((req (array/map (array/filter @declared (fn (d) (object/get @d required))) (fn (d) (object/get @d envVar))))) (if (> (array/len @req) 0) @req (array/map @declared (fn (d) (object/get @d envVar))))))
            (held (array/filter @subjects (fn (n) (array/includes @payload.held @n))))
            (missing (if @anyRequired (array/reject @subjects (fn (n) (array/includes @payload.held @n))) (if (or (== (array/len @subjects) 0) (> (array/len @held) 0)) [] @subjects)))
            (configured (== (array/len @missing) 0)))
          (emit CRED_ADMIN_TESTED { service: @payload.service, configured: @configured, missing: @missing, probed: false, ok: @configured, message: (if @configured "Credentials present (no live probe declared for this service)" (if @anyRequired (str/concat "Missing required credentials: " (str/join @missing ", ")) (str/concat "None of the declared credentials is set: " (str/join @missing ", ")))) }))

      CRED_ADMIN_MODE -> idle
        (if (or (== @payload.mode "mock") (== @payload.mode "real"))
          (do
            (set @entity.mock (== @payload.mode "mock"))
            (emit CRED_ADMIN_MODE_SET { mock: (== @payload.mode "mock"), mode: @payload.mode }))
          (emit CRED_ADMIN_REFUSED { code: "", message: "mode must be \"mock\" or \"real\"" }))

      CRED_ADMIN_ENV_MODE -> idle
        (set @entity.mock (or (== @payload.integrationsMode "mock") (== @payload.useMockData "true")))
        (emit CRED_ADMIN_MODE_SET { mock: @entity.mock, mode: (if @entity.mock "mock" "real") })

      CRED_ADMIN_SOURCE -> idle
        (emit CRED_ADMIN_SOURCED { store: (== @payload.source "store"), storeOnly: (not (array/includes ["ALMADAR_CREDENTIAL_ADMIN_ROLES" "ALMADAR_CREDENTIALS_SOURCE" "ALMADAR_INTEGRATIONS_MODE" "USE_MOCK_DATA"] @payload.name)) })

      CRED_ADMIN_SEED -> idle
        (let (
            (rows (array/reduce @payload.catalog [] (fn (acc g)
                (array/reduce (object/get @g credentials) @acc (fn (a d)
                  (if (or (array/some @a (fn (r) (== (object/get @r envVar) (object/get @d envVar)))) (array/includes @payload.held (object/get @d envVar)) (not (array/includes @payload.present (object/get @d envVar))))
                    @a
                    (array/append @a { service: (object/get @g service), envVar: (object/get @d envVar) }))))))))
          (emit CRED_ADMIN_SEED_PLAN { rows: @rows }))

      CRED_ADMIN_BOOT_CHECK -> idle
        (emit CRED_ADMIN_OWED { owed: (array/flatten (array/map @payload.services (fn (name)
            (let ((group (array/find @payload.catalog (fn (g) (== (object/get @g service) @name)))))
              (if (== @group null)
                []
                (array/map (array/filter (object/get @group credentials) (fn (d) (and (object/get @d required) (not (array/includes @payload.held (object/get @d envVar))))))
                  (fn (d) (str/concat @name ": " (object/get @d envVar) " (" (object/get @d description) ")")))))))) })

      CRED_ADMIN_REQUIRE_STORE -> idle
        (if (and (or (== @payload.verb "set") (== @payload.verb "remove") (== @payload.verb "rotate")) (not @payload.hasStore))
          (emit CRED_ADMIN_REFUSED { code: "", message: (str/concat "No credential store is installed on this host" (if (== @payload.verb "set") " \u{2014} set credentials via the environment" "")) })
          (emit CRED_ADMIN_ALLOWED { verb: @payload.verb }))
    }

    emits {
      CRED_ADMIN_ALLOWED -> external { verb : string! }
        @description "The gate admits the verb, or the credential is settable."
        @synonyms "credential allowed, gate passed"
        @tier "domain"
      CRED_ADMIN_REFUSED -> external { code : string!  message : string! }
        @description "The request is refused: AUTH_ERROR for the role gate, an empty code for an undeclared credential or a bad mode."
        @synonyms "credential refused, forbidden"
        @tier "domain"
      CRED_ADMIN_MASKED -> external { last4 : string! }
        @description "The last four UTF-16 units of a value."
        @tier "domain"
      CRED_ADMIN_SAVED -> external { service : string!  envVar : string!  last4 : string! }
        @description "A credential was saved; only the masked tail is reported."
        @tier "domain"
      CRED_ADMIN_CATALOGED -> external { groups : [CredGroup]! }
        @description "The catalog: registry services then the program's credential groups."
        @tier "domain"
      CRED_ADMIN_LISTED -> external { enabled : boolean!  mode : string!  services : [CredServiceStatus]!  entries : [CredEntry]! }
        @description "The masked inventory with each listed service's status."
        @tier "domain"
      CRED_ADMIN_TESTED -> external { service : string!  configured : boolean!  missing : [string]!  probed : boolean!  ok : boolean!  message : string! }
        @description "The presence-only check of a service's credentials."
        @tier "domain"
      CRED_ADMIN_MODE_SET -> external { mock : boolean!  mode : string! }
        @description "The mock or real mode a request or the environment names."
        @tier "domain"
      CRED_ADMIN_SOURCED -> external { store : boolean!  storeOnly : boolean! }
        @description "Whether the source word selects the store, and whether the credential is answered from the store alone."
        @tier "domain"
      CRED_ADMIN_SEED_PLAN -> external { rows : [CredSeedRow]! }
        @description "The declared credentials the store lacks and the environment sets, once per name; names only."
        @tier "domain"
      CRED_ADMIN_OWED -> external { owed : [string]! }
        @description "The required credentials of the called services that are not held."
        @tier "domain"
    }

    listens {
      CRED_ADMIN_GATE { verb : string!  role : string  allowedRoles : [string] }
      CRED_ADMIN_SETTABLE { catalog : [CredGroup]!  service : string!  envVar : string! }
      CRED_ADMIN_MASK { value : string! }
      CRED_ADMIN_SAVE { service : string!  envVar : string!  value : string! }
      CRED_ADMIN_CATALOG { services : [CredRegistryService]!  program : [CredProgramCred]! }
      CRED_ADMIN_LIST { catalog : [CredGroup]!  stored : [CredStored]!  env : [CredEnv]!  filter : string  storeEnabled : boolean!  storeFirst : boolean!  mock : boolean! }
      CRED_ADMIN_TEST { catalog : [CredGroup]!  service : string!  held : [string]! }
      CRED_ADMIN_MODE { mode : string! }
      CRED_ADMIN_ENV_MODE { integrationsMode : string  useMockData : string }
      CRED_ADMIN_SOURCE { source : string  name : string! }
      CRED_ADMIN_SEED { catalog : [CredGroup]!  held : [string]!  present : [string]! }
      CRED_ADMIN_BOOT_CHECK { catalog : [CredGroup]!  services : [string]!  held : [string]! }
      CRED_ADMIN_REQUIRE_STORE { verb : string!  hasStore : boolean! }
    }
  }

  page boot as CredentialAdminOrbitalStart -> CredentialAdmin
}
