app std-row-access-control [
  version: "1.0.0",
  description: "std-row-access-control — row-level access control gate / ownership filter / role-based row visibility. Use when a user voices that only certain users should see or edit certain records (only the owner can edit, private to owner, owner-only visibility, only see your own records, role-based visibility, admin-only access, visible to admins only, restricted to role, permission gate, ownership scoping, hide from other users, only show mine). Listens for `RowsLoaded` (rename via traitOverrides.events to the consumer's load event), filters `@payload.data` by `@user.id` (when `ownerField` is set) and/or `@user.role` (when `visibleRoles` is non-empty), re-emits `RowsFiltered` for downstream consumers (rename to wire into the UI atom's listen). Composable via `extraTraits` to interpose between a data fetch and a list/grid UI."
]
orbital RowAccessControlOrbital {
    type RowsLoaded = Event { data : [@entity @config.rowEntity]! } "Rename via traitOverrides.events to the upstream fetch-success event (e.g. ContactLoaded)."

    type RowsFiltered = Event { data : [@entity @config.rowEntity], filteredCount : number } "Re-emitted with the access-gated row set; rename to wire the downstream consumer (e.g. ContactGated)."

  entity RowAccessRow [runtime] {
    id : string!
    ownerId : string
  }

  entity RowAccessGateView [runtime] {
    id : string!
    inputCount : number @description "The number of records processed by the access control." @synonyms "record count, item count, total records" = 0
    outputCount : number @description "The number of records that passed the access control filter." @synonyms "count, size, length" = 0
    accessDenied : boolean @description "Indicates whether access is denied based on configured rules." @synonyms "denied, restricted, unauthorized, access-denied" = false
  }

  trait RowAccessGate -> @rebindable RowAccessGateView [client] {
    initial: idle

    state idle {
      RowsLoaded -> idle when @config.enabled
        (set @entity.inputCount (array/len ?data))
        (set @entity.accessDenied (and (not (= (array/len @config.visibleRoles) 0)) (not (array/includes @config.visibleRoles @user.role))))
        (set @entity.outputCount (array/len (if @entity.accessDenied [] (if (!= @config.ownerField null) (array/filter ?data (fn row (= (object/get @row @config.ownerField) @user.id))) ?data))))
        (emit RowsFiltered { data: (if @entity.accessDenied [] (if (!= @config.ownerField null) (array/filter ?data (fn row (= (object/get @row @config.ownerField) @user.id))) ?data)), filteredCount: @entity.outputCount })
    }

    emits {
      RowsFiltered -> external {
        data : [@entity @config.rowEntity]
        filteredCount : number
      }
    }

    listens {
      RowsLoaded {
        data : [@entity @config.rowEntity]!
      }
    }

    config {
      enabled : boolean = false
        @label "Restrict who sees records"
        @description "Only let people see records they own, or that match an allowed role. Off by default."
        @synonyms "enable, turn on, enforce, require, activate, apply, switch on, only owner can edit, owner-only, private to owner, only see your own, restrict to role, role-based visibility, permission gate, admin-only access, hide from other users, only show mine, ownership scoping"
        @tier "policy"
      rowEntity : entity = RowAccessRow
        @label "Row entity"
        @description "The entity whose rows RowsLoaded delivers and RowsFiltered re-emits; ownerField names a column of it."
        @tier "internal"
      ownerField : (field (@entity @config.rowEntity))?
        @label "Owner field"
        @description "Row field holding the owning user id (unset disables the owner filter)"
        @tier "internal"
      visibleRoles : [string] = []
        @label "Allowed roles"
        @description "Roles permitted to see any row (empty = no role gate)"
        @tier "policy"
    }
  }

  page boot as RowAccessControlOrbitalStart -> RowAccessGate
}