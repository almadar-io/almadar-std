app std-dev-personas [
  version: "1.0.0",
  inbound: ["personas", "persona-sign-in"],
  env: ["FIREBASE_AUTH_EMULATOR_HOST"],
  description: "std-dev-personas — sign in as a development persona against the local Firebase Auth emulator. Compose it with linkedEntity set to the app's identity entity: its rows are the personas. POST /api/hooks/personas answers 200 { success, personas, source } (every row with a non-empty id; source identity-entity, or none when there are no rows). POST /api/hooks/persona-sign-in with { id } makes that row an emulator user (uid = id, display name = name, every other non-null field but email a custom claim) and answers 200 { success, customToken, authEmulatorHost, projectId }, the token unsigned (alg none), which only the emulator accepts. A composed client may also ask by event (PERSONAS_REQUESTED, PERSONA_SIGN_IN_REQUESTED { id }) and read the same answers (PERSONAS_ANSWERED, PERSONA_SIGN_IN_ANSWERED); the sign-in token it carries is the emulator's unsigned alg-none token, accepted only by the local emulator, and this dev-only path is the one exception to tokens-never-in-payloads. Both answer 404 unless FIREBASE_AUTH_EMULATOR_HOST is 127.0.0.1:9099, so a deployment lists and signs in nobody; a body without an id is 400, an unknown id 404, a field named like a reserved token claim or an emulator refusal 500. The emulator calls go through the composed std-http-client trait PersonaHttp (127.0.0.1:9099 over plain TCP, net grant); its authorization header is the declared credential FIREBASE_AUTH_EMULATOR_OWNER (Bearer prefix), filled by the host at the send, so no token is written in the program. A persona sign-in (PERSONA_ACT_AS { persona, clientId? }, TOKEN_SIGN_IN_REQUESTED { token, clientId? }, autoSignIn) is one ask to the composed std-identity-binding trait PersonaBinding (docs/Almadar_Orbital_Core.md §11): the binder signs the clientId's session in, or with no clientId the session the step runs in; this atom only answers the binder's verify ask, reading FIREBASE_AUTH_EMULATOR_HOST before it accepts the unsigned token."
]
uses Spec from "almadar-std/dev-personas"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Binding from "std/behaviors/std-identity-binding"
type HttpHeader = { name : string!, value : string! }
type PersonaSignInBody = { id : string }
type EmulatorError = { message : string }
type EmulatorReply = { error : EmulatorError }
type PersonaVerifyFailure = { error : string!, kind : string! }

orbital DevPersonasOrbital {
  entity DevPersona [persistent: dev_personas] {
    @create none "A substrate atom: the composing program decides who reaches the trait that writes these rows, so this atom states no creator of its own."
    @read none "This program declares no identity entity, so it has no signed-in viewer to scope reads to: every visitor may read these rows."
    id : string!
    name : string @description "Shown on the persona switcher and set as the emulator user's display name."
    email : email @description "Kept off the token claims."
    role : string @description "What a guard on the viewer's role reads; travels as a custom claim so the persona is the same viewer after sign-in."
  }

  trait PersonaHttpFrame = Frame.traits.HttpFrame {
    listens {
      PersonaHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait PersonaHttp = Http.traits.HttpClient {
    config {
      host: "127.0.0.1"
      port: 9099
      tls: false
      serverName: "127.0.0.1"
      credential: "FIREBASE_AUTH_EMULATOR_OWNER"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      DevPersonas.DP_POST -> HTTP_SEND
      PersonaHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      PersonaHttpFrame.FRAME_DRAINED -> HC_DRAINED
      PersonaHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait PersonaBinding = Binding.traits.IdentityBinder {
    config {
      identityEntity: DevPersona
    }
    listens {
      DevPersonas.PERSONA_BEARER -> BEARER_PRESENT
      DevPersonas.PERSONA_VERIFIED -> BEARER_VERIFIED
      DevPersonas.PERSONA_REFUSED -> REFUSED_SEEN
    }
  }

  trait DevPersonas -> @rebindable DevPersona {
    initial: ready

    state ready {
      INIT -> ready when (= @config.autoSignIn "")
      INIT -> ready when (!= @config.autoSignIn "")
        (os/getenv "FIREBASE_AUTH_EMULATOR_HOST" { key: "auto" emit: { success: AUTO_HOST failure: AUTO_FAILED } })
      AUTO_HOST -> ready when (= (default @payload.value "") @config.authEmulatorHost)
        (fetch DevPersona { limit: @config.maxRows emit: { success: AUTO_ROWS failure: AUTO_ROWS_FAILED } })
      AUTO_HOST -> ready when (!= (default @payload.value "") @config.authEmulatorHost)
      AUTO_FAILED -> ready
      AUTO_ROWS -> ready
        (emit AUTO_RESOLVED { id: (let ((byId (array/find @payload.data (fn r (= (default @r.id "") @config.autoSignIn)))) (byRole (array/find @payload.data (fn r (= (default @r.role "") @config.autoSignIn))))) (default (object/get (default @byId (default @byRole {})) "id") "")) })
      AUTO_RESOLVED -> ready when (!= @payload.id "")
        (emit TOKEN_MINT { key: @payload.id, purpose: "sign-in", clientId: "" })
      AUTO_RESOLVED -> ready when (= @payload.id "")
        (emit PERSONA_SIGN_IN_REFUSED { error: (str/concat "persona sign-in refused: no identity row has the id or the role " @config.autoSignIn), kind: "no-persona" })
      AUTO_ROWS_FAILED -> ready
        (emit PERSONA_SIGN_IN_REFUSED { error: (str/concat "persona sign-in refused: the identity rows could not be read to resolve " @config.autoSignIn ": " (default @payload.error "")), kind: "no-persona" })
      TOKEN_MINT -> ready
        (emit TOKEN_MINTED { key: @payload.key, purpose: @payload.purpose, clientId: @payload.clientId, token: (str/concat (str/replace-pattern (str/replace-pattern (str/replace-pattern (base64/encode (json/stringify { alg: "none", typ: "JWT" })) "\\+" "-") "/" "_") "=+$" "") "." (str/replace-pattern (str/replace-pattern (str/replace-pattern (base64/encode (json/stringify { aud: (if (!= @config.emulatorAudience "") @config.emulatorAudience @config.projectId), iat: (time/diff @now @config.epoch "s"), exp: (+ (time/diff @now @config.epoch "s") 3600), iss: (if (!= @config.emulatorIssuer "") @config.emulatorIssuer (str/concat "https://securetoken.google.com/" @config.projectId)), sub: @payload.key, uid: @payload.key })) "\\+" "-") "/" "_") "=+$" "") ".") })
      ANSWER_TOKEN_MINT -> ready
        (emit ANSWER_TOKEN_MINTED { key: @payload.key, token: (str/concat (str/replace-pattern (str/replace-pattern (str/replace-pattern (base64/encode (json/stringify { alg: "none", typ: "JWT" })) "\\+" "-") "/" "_") "=+$" "") "." (str/replace-pattern (str/replace-pattern (str/replace-pattern (base64/encode (json/stringify { aud: (if (!= @config.emulatorAudience "") @config.emulatorAudience @config.projectId), iat: (time/diff @now @config.epoch "s"), exp: (+ (time/diff @now @config.epoch "s") 3600), iss: (if (!= @config.emulatorIssuer "") @config.emulatorIssuer (str/concat "https://securetoken.google.com/" @config.projectId)), sub: @payload.key, uid: @payload.key })) "\\+" "-") "/" "_") "=+$" "") ".") })
      ANSWER_TOKEN_MINTED -> ready
        (emit PERSONA_SIGN_IN_ANSWERED { status: 200, body: (json/stringify { success: true, customToken: @payload.token, authEmulatorHost: @config.authEmulatorHost, projectId: @config.projectId }) })
      TOKEN_MINTED -> ready when (= @payload.purpose "sign-in")
        (emit PERSONA_BEARER { requestId: 0, authorization: (str/concat "Bearer " @payload.token), clientId: @payload.clientId, self: (= @payload.clientId "") })
      PERSONA_ACT_AS -> ready
        (emit TOKEN_MINT { key: @payload.persona, purpose: "sign-in", clientId: (default @payload.clientId "") })
      TOKEN_SIGN_IN_REQUESTED -> ready
        (emit PERSONA_BEARER { requestId: 0, authorization: (str/concat "Bearer " @payload.token), clientId: (default @payload.clientId ""), self: (= (default @payload.clientId "") "") })
      ;; jws/verify allowUnsigned accepts an alg:none token, so the verify ask reads the emulator host first
      PERSONA_VERIFY -> ready
        (os/getenv "FIREBASE_AUTH_EMULATOR_HOST" { key: (default @payload.authorization "") emit: { success: VERIFY_HOST failure: VERIFY_HOST_FAILED } })
      VERIFY_HOST -> ready when (= (default @payload.value "") @config.authEmulatorHost)
        (let ((r (jws/verify (str/slice (default @payload.key "") 7 (str/len (default @payload.key ""))) [] { issuer: (if (!= @config.emulatorIssuer "") @config.emulatorIssuer (str/concat "https://securetoken.google.com/" @config.projectId)), audience: (if (!= @config.emulatorAudience "") @config.emulatorAudience @config.projectId), allowUnsigned: true })))
          (if (object/has @r "kind")
            (emit PERSONA_REFUSED { requestId: 0, reason: (object/get (default (as @r PersonaVerifyFailure) { error: "", kind: "" }) "kind") })
            (emit PERSONA_VERIFIED { requestId: 0, verified: @r })))
      VERIFY_HOST -> ready when (!= (default @payload.value "") @config.authEmulatorHost)
        (emit PERSONA_REFUSED { requestId: 0, reason: "no-emulator" })
      VERIFY_HOST_FAILED -> ready
        (emit PERSONA_REFUSED { requestId: 0, reason: "no-emulator" })
      PERSONA_BOUND -> ready
        (emit PERSONA_SIGNED_IN { subject: (default @payload.subject "") })
      PERSONA_UNBOUND -> ready
        (emit PERSONA_SIGN_IN_REFUSED { error: (str/concat "persona sign-in refused: " @payload.reason), kind: @payload.reason })
      PERSONA_SIGNED_IN -> ready
      PERSONA_SIGN_IN_REFUSED -> ready
      PERSONAS_REQUESTED -> ready
        (emit PERSONAS_CALLED { rawBody: "" })
      PERSONAS_CALLED -> ready
        (os/getenv "FIREBASE_AUTH_EMULATOR_HOST" { key: "list" emit: { success: PERSONAS_HOST failure: PERSONAS_FAILED } })
      PERSONAS_HOST -> ready when (!= (default @payload.value "") @config.authEmulatorHost)
        (emit PERSONAS_ANSWERED { status: 404, body: (json/stringify { success: false, error: "no dev personas: the Auth emulator is not configured" }) })
      PERSONAS_HOST -> ready when (= (default @payload.value "") @config.authEmulatorHost)
        (fetch DevPersona { limit: @config.maxRows emit: { success: PERSONAS_ROWS failure: PERSONAS_FAILED } })
      PERSONAS_ROWS -> ready when (> @payload.totalCount (array/len @payload.data))
        (emit PERSONAS_FAILED { error: (str/concat "DevPersona has " @payload.totalCount " rows, over the maxRows cap of " @config.maxRows) })
      PERSONAS_ROWS -> ready
        (let ((rows (array/filter @payload.data (fn r (!= (default @r.id "") "")))))
          (emit PERSONAS_ANSWERED { status: 200, body: (json/stringify { success: true, personas: @rows, source: (if (> (array/len @rows) 0) "identity-entity" "none") }) }))
      PERSONAS_FAILED -> ready
        (emit PERSONAS_ANSWERED { status: 500, body: (json/stringify { success: false, error: (default @payload.error "") }) })

      PERSONA_SIGN_IN_REQUESTED -> ready
        (emit SIGN_IN_CALLED { rawBody: (json/stringify { id: @payload.id }) })
      SIGN_IN_CALLED -> ready when (= (default (object/get (default (json/parse (default @payload.rawBody "{}") PersonaSignInBody) {}) "id") "") "")
        (emit PERSONA_SIGN_IN_ANSWERED { status: 400, body: (json/stringify { success: false, error: "expected { id }" }) })
      SIGN_IN_CALLED -> ready when (!= (default (object/get (default (json/parse (default @payload.rawBody "{}") PersonaSignInBody) {}) "id") "") "")
        (os/getenv "FIREBASE_AUTH_EMULATOR_HOST" { key: (object/get (default (json/parse (default @payload.rawBody "{}") PersonaSignInBody) {}) "id") emit: { success: SIGN_IN_HOST failure: SIGN_IN_FAILED } })
      SIGN_IN_HOST -> ready when (!= (default @payload.value "") @config.authEmulatorHost)
        (emit PERSONA_SIGN_IN_ANSWERED { status: 404, body: (json/stringify { success: false, error: "no dev personas: the Auth emulator is not configured" }) })
      SIGN_IN_HOST -> ready when (= (default @payload.value "") @config.authEmulatorHost)
        (fetch DevPersona { id: @payload.key emit: { success: SIGN_IN_ROW failure: SIGN_IN_ROW_MISSED } })
      SIGN_IN_ROW -> ready when (> (array/len (array/filter (object/keys @payload.data) (fn k (array/includes @config.reservedClaims @k)))) 0)
        (emit PERSONA_SIGN_IN_ANSWERED { status: 500, body: (json/stringify { success: false, error: (str/concat "persona " @payload.data.id " has fields named like reserved token claims: " (str/join (array/filter (object/keys @payload.data) (fn k (array/includes @config.reservedClaims @k))) ", ")) }) })
      SIGN_IN_ROW -> ready when (= (array/len (array/filter (object/keys @payload.data) (fn k (array/includes @config.reservedClaims @k)))) 0)
        (emit DP_POST { key: (str/concat "create:" @payload.data.id), method: "POST", target: (str/concat "/identitytoolkit.googleapis.com/v1/projects/" @config.projectId "/accounts"), headers: [{ name: "Content-Type", value: "application/json" }], body: (bytes/from-string (json/stringify (if (!= (default @payload.data.name "") "") { localId: @payload.data.id, displayName: @payload.data.name } { localId: @payload.data.id }))), stream: "none" })
      PERSONA_REPLIED -> ready when (str/startsWith @payload.key "create:")
        (emit SIGN_IN_CREATED { key: (str/slice @payload.key 7), status: @payload.status, body: (default (bytes/to-string @payload.body) "") })
      PERSONA_REPLIED -> ready when (str/startsWith @payload.key "update:")
        (emit SIGN_IN_UPDATED { key: (str/slice @payload.key 7), status: @payload.status, body: (default (bytes/to-string @payload.body) "") })
      SIGN_IN_CREATED -> ready when (and (or (< @payload.status 200) (>= @payload.status 300)) (not (and (!= (json/parse @payload.body EmulatorReply) null) (str/startsWith (object/get (json/parse @payload.body EmulatorReply) "error.message" "") "DUPLICATE_LOCAL_ID"))))
        (emit PERSONA_SIGN_IN_ANSWERED { status: 500, body: (json/stringify { success: false, error: (str/concat "the Auth emulator refused to create " @payload.key ": " (str/concat @payload.status) " " @payload.body) }) })
      SIGN_IN_CREATED -> ready when (or (and (>= @payload.status 200) (< @payload.status 300)) (and (!= (json/parse @payload.body EmulatorReply) null) (str/startsWith (object/get (json/parse @payload.body EmulatorReply) "error.message" "") "DUPLICATE_LOCAL_ID")))
        (fetch DevPersona { id: @payload.key emit: { success: SIGN_IN_CLAIMS failure: SIGN_IN_ROW_MISSED } })
      SIGN_IN_CLAIMS -> ready
        (emit DP_POST { key: (str/concat "update:" @payload.data.id), method: "POST", target: (str/concat "/identitytoolkit.googleapis.com/v1/projects/" @config.projectId "/accounts:update"), headers: [{ name: "Content-Type", value: "application/json" }], body: (bytes/from-string (json/stringify (object/merge (if (!= (default @payload.data.name "") "") { localId: @payload.data.id, displayName: @payload.data.name } { localId: @payload.data.id }) { customAttributes: (json/stringify (object/omit @payload.data ["id", "email", "name"])) }))), stream: "none" })
      SIGN_IN_UPDATED -> ready when (or (< @payload.status 200) (>= @payload.status 300))
        (emit PERSONA_SIGN_IN_ANSWERED { status: 500, body: (json/stringify { success: false, error: (str/concat "the Auth emulator refused to update " @payload.key ": " (str/concat @payload.status) " " @payload.body) }) })
      SIGN_IN_UPDATED -> ready when (and (>= @payload.status 200) (< @payload.status 300))
        (emit ANSWER_TOKEN_MINT { key: @payload.key })
      SIGN_IN_ROW_MISSED -> ready when (= @payload.code "not-found")
        (emit PERSONA_SIGN_IN_ANSWERED { status: 404, body: (json/stringify { success: false, error: "no persona with that id" }) })
      SIGN_IN_ROW_MISSED -> ready when (!= @payload.code "not-found")
        (emit PERSONA_SIGN_IN_ANSWERED { status: 500, body: (json/stringify { success: false, error: @payload.error }) })
      SIGN_IN_FAILED -> ready
        (emit PERSONA_SIGN_IN_ANSWERED { status: 500, body: (json/stringify { success: false, error: (default @payload.error "") }) })
    }

    emits {
      PERSONAS_CALLED -> internal {
        rawBody : string
      }
        @description "Internal: a list by request, handed to the same arms the personas hook runs."
        @tier "internal"
      SIGN_IN_CALLED -> internal {
        rawBody : string
      }
        @description "Internal: a sign-in by id, handed to the same arms the persona-sign-in hook runs."
        @tier "internal"
      PERSONAS_ANSWERED -> external {
        status : number!
        body : string!
      }
        @description "The answer of the personas hook, an HTTP-shaped answer (status, JSON text body) a composed client trait may read."
        @tier "essential"
      PERSONA_SIGN_IN_ANSWERED -> external {
        status : number!
        body : string!
      }
        @description "The answer of the persona-sign-in hook, an HTTP-shaped answer (status, JSON text body) a composed client trait may read."
        @tier "essential"
      PERSONAS_HOST -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for FIREBASE_AUTH_EMULATOR_HOST on a list."
        @tier "internal"
      PERSONAS_ROWS -> internal {
        data : [DevPersona]!
        totalCount : number!
      }
        @description "Internal: the identity rows."
        @tier "internal"
      PERSONAS_FAILED -> internal {
        error : string
      }
        @description "Internal: reading the environment or the rows failed."
        @tier "internal"
      SIGN_IN_HOST -> internal {
        value : string
        key : string!
      }
        @description "Internal: the os/getenv answer for FIREBASE_AUTH_EMULATOR_HOST on a sign-in, keyed by the persona id."
        @tier "internal"
      DP_POST -> external {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one call to the Auth emulator, for the HTTP client."
        @tier "internal"
      SIGN_IN_ROW -> internal {
        data : DevPersona!
      }
        @description "Internal: the persona row to sign in as."
        @tier "internal"
      SIGN_IN_CLAIMS -> internal {
        data : DevPersona!
      }
        @description "Internal: the persona row read again for its claims."
        @tier "internal"
      SIGN_IN_CREATED -> internal {
        status : number!
        body : string!
        key : string!
      }
        @description "Internal: the Auth emulator's answer to creating the user."
        @tier "internal"
      SIGN_IN_UPDATED -> internal {
        status : number!
        body : string!
        key : string!
      }
        @description "Internal: the Auth emulator's answer to setting the display name and claims."
        @tier "internal"
      SIGN_IN_ROW_MISSED -> internal {
        error : string!
        code : string
      }
        @description "Internal: the persona row could not be read; code not-found when no row has that id."
        @tier "internal"
      AUTO_HOST -> internal {
        value : string
        key : string
      }
        @description "Internal: the os/getenv answer for FIREBASE_AUTH_EMULATOR_HOST at a session's start (autoSignIn)."
        @tier "internal"
      AUTO_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: the environment could not be read at a session's start; the session stays as it is."
        @tier "internal"
      AUTO_ROWS -> internal {
        data : [DevPersona]!
        totalCount : number!
      }
        @description "Internal: the identity rows read to resolve autoSignIn at a session's start."
        @tier "internal"
      AUTO_ROWS_FAILED -> internal {
        error : string
        code : string
      }
        @description "Internal: the identity rows could not be read to resolve autoSignIn."
        @tier "internal"
      AUTO_RESOLVED -> internal {
        id : string!
      }
        @description "Internal: the id of the identity row autoSignIn resolved to (an id match, else the first row of that role), or empty when none matched."
        @tier "internal"
      TOKEN_MINT -> internal {
        key : string!
        purpose : string!
        clientId : string!
      }
        @description "Internal: build the emulator's unsigned custom token for the persona key, to sign in the clientId's session (empty: the session the step runs in)."
        @tier "internal"
      ANSWER_TOKEN_MINT -> internal {
        key : string!
      }
        @description "Internal: build the emulator's unsigned custom token for the persona key a sign-in update answered; the answer carries it back to the caller and never signs a session in."
        @tier "internal"
      ANSWER_TOKEN_MINTED -> internal {
        key : string!
        token : string!
      }
        @description "Internal: the unsigned custom token a sign-in update answered, on its way back to the caller."
        @tier "internal"
      TOKEN_MINTED -> internal {
        key : string!
        purpose : string!
        clientId : string!
        token : string!
      }
        @description "Internal: the unsigned custom token of one persona, on its way to the binder as an ask."
      PERSONA_BEARER -> external {
        requestId : number
        authorization : string
        clientId : string
        self : boolean
      }
        @description "Internal: the persona's ask to PersonaBinding, the one owner of a sign-in: sign the clientId's session in (self: the session the step runs in) with this bearer."
        @tier "internal"
      PERSONA_VERIFIED -> external {
        requestId : number
        verified : Verified!
      }
        @description "Internal: the emulator token verified (jws/verify, allowUnsigned, the emulator issuer); the binder signs it in."
        @tier "internal"
      PERSONA_REFUSED -> external {
        requestId : number
        reason : string!
      }
        @description "Internal: the emulator token was refused: no-emulator when FIREBASE_AUTH_EMULATOR_HOST does not name the Auth emulator, else the jws/verify failure kind."
        @tier "internal"
      VERIFY_HOST -> internal {
        value : string
        key : string
      }
        @description "Internal: the os/getenv answer for FIREBASE_AUTH_EMULATOR_HOST on the binder's verify ask, keyed by the authorization header."
        @tier "internal"
      VERIFY_HOST_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: the environment could not be read for the verify ask; the token is refused no-emulator."
        @tier "internal"
        @tier "internal"
      PERSONA_SIGNED_IN -> external {
        subject : string
      }
        @description "The session is signed in as the persona: PersonaBinding bound the subject its emulator token verified as."
        @synonyms "persona signed in"
        @tier "primary"
      PERSONA_SIGN_IN_REFUSED -> external {
        error : string
        kind : string
      }
        @description "The sign-in was refused; kind is the binder's reason: no-emulator when FIREBASE_AUTH_EMULATOR_HOST does not name the Auth emulator (or cannot be read), a jws/verify failure kind, identity-<kind> when the kernel refused the sign-in (identity-no-identity: the persona has no identity row), no-client-session, anonymous or session-ended."
        @synonyms "persona sign-in refused"
        @tier "primary"
      SIGN_IN_FAILED -> internal {
        error : string
      }
        @description "Internal: the environment, the row or the Auth emulator could not be reached."
        @tier "internal"
    }

    config {
      maxRows : number = 200
        @label "Personas listed"
        @description "Most persona rows the personas hook may read. The hook answers the whole list for the switcher, so a partial list would hide personas; an identity entity with more rows is refused with a 500 instead of listing part of it."
        @synonyms "persona limit, list cap"
        @tier "policy"
      authEmulatorHost : string = "127.0.0.1:9099"
        @label "Auth emulator host"
        @description "The host:port FIREBASE_AUTH_EMULATOR_HOST must name for the hooks to answer; anything else, or unset, answers 404."
        @synonyms "auth emulator, emulator host"
        @tier "infra"
      projectId : string = "demo-almadar"
        @label "Project"
        @description "The demo project the Auth emulator runs under, the same one std-firebase-emulators starts."
        @synonyms "firebase project"
        @tier "infra"
      epoch : instant = "1970-01-01T00:00:00.000Z"
        @label "Epoch"
        @description "The instant token times (iat, exp) count seconds from."
        @tier "infra"
      autoSignIn : string = ""
        @label "Auto sign-in persona"
        @description "The ALMADAR_PERSONA spec of the persona to sign in as: an identity row id, else the first row whose role is this value; empty signs nobody in. A new session of an app running against the Auth emulator (FIREBASE_AUTH_EMULATOR_HOST equal to authEmulatorHost) reads the identity rows at its start, resolves the spec and signs in as that row: its unsigned emulator token is one ask to PersonaBinding, the same path as the persona picker. A spec no row matches answers PERSONA_SIGN_IN_REFUSED naming it and leaves the session signed out. Never signs in anywhere else."
        @synonyms "default persona, dev user, emulator user"
        @tier "policy"
      emulatorIssuer : string = ""
        @label "Emulator issuer"
        @description "The iss of the emulator custom tokens this atom mints and verifies; empty uses https://securetoken.google.com/<projectId>, the issuer of the emulator's ID tokens, so the same tokens verify in std-bearer-verify when its issuer is that. jws/verify accepts an unsigned token only when its iss equals the call's issuer."
        @tier "infra"
      emulatorAudience : string = ""
        @label "Emulator audience"
        @description "The aud of the emulator custom tokens; empty uses the projectId."
        @tier "infra"
      reservedClaims : [string] = ["acr", "amr", "at_hash", "aud", "auth_time", "azp", "cnf", "c_hash", "exp", "firebase", "iat", "iss", "jti", "nbf", "nonce", "sub"]
        @label "Reserved claims"
        @description "Token claim names Firebase reserves; a persona field named like one refuses the sign-in."
        @synonyms "reserved token claims"
        @tier "infra"
    }

    listens {
      PERSONA_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
        @description "Internal: the HTTP client's reply from the Auth emulator, before its body is read as text."
      PERSONA_ACT_AS -> input {
        persona : string!
        clientId : string?
      }
        @description "Sign a session in as the persona with this id: the clientId's session, or with none the session the step runs in (the seeder dispatches it into each per-owner session). Its unsigned emulator token is one ask to PersonaBinding; answers PERSONA_SIGNED_IN { subject } or PERSONA_SIGN_IN_REFUSED { error, kind }."
        @synonyms "act as persona, seed as persona"
      TOKEN_SIGN_IN_REQUESTED {
        token : string!
        clientId : string?
      }
        @description "Sign a session in (the clientId's, or the one the step runs in) with an emulator custom token a persona sign-in answered, as one ask to PersonaBinding; answers PERSONA_SIGNED_IN or PERSONA_SIGN_IN_REFUSED."
      PersonaBinding.BEARER_VERIFY -> PERSONA_VERIFY
      PersonaBinding.IDENTITY_BOUND -> PERSONA_BOUND
      PersonaBinding.IDENTITY_REFUSED -> PERSONA_UNBOUND
      PersonaBinding.IDENTITY_ANONYMOUS -> PERSONA_UNBOUND with { requestId: ?requestId, reason: "anonymous" }
      PersonaBinding.IDENTITY_SESSION_ENDED -> PERSONA_UNBOUND with { requestId: ?requestId, reason: "session-ended" }
      PERSONA_VERIFY {
        requestId : number
        authorization : string
      }
        @description "Internal: the binder asks this atom to verify a persona's bearer."
      PERSONA_BOUND {
        requestId : number
        subject : string
      }
        @description "Internal: the binder signed the persona in."
      PERSONA_UNBOUND {
        requestId : number
        reason : string!
      }
        @description "Internal: the binder refused the persona's ask, with its reason."
        @synonyms "sign in with persona token"
      PersonaHttp.HTTP_REPLIED -> PERSONA_REPLIED
      PersonaHttp.HTTP_FAILED -> SIGN_IN_FAILED
      PERSONAS_REQUESTED {
      }
        @description "A client asks for the persona list; answered by PERSONAS_ANSWERED, as the hook is."
      PERSONA_SIGN_IN_REQUESTED {
        id : string!
      }
        @description "A client asks to sign in as the persona with this id; answered by PERSONA_SIGN_IN_ANSWERED, as the hook is."
      PERSONAS_CALLED -> inbound "personas" answers PERSONAS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "List the identity rows a developer can sign in as."
        @synonyms "dev personas, persona list"
      SIGN_IN_CALLED -> inbound "persona-sign-in" answers PERSONA_SIGN_IN_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Sign in as one persona on the Auth emulator and answer its custom token."
        @synonyms "sign in as persona, impersonate"
    }
  }

  page boot as DevPersonasOrbitalStart -> DevPersonas, PersonaBinding, PersonaHttp, PersonaHttpFrame
}
