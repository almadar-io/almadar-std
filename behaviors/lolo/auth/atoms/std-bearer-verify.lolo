app std-bearer-verify [
  version: "1.0.0",
  description: "std-bearer-verify — turns a raw Authorization header (the exact-case Bearer prefix, as Rust) into a Viewer over std-jws. BEARER_VERIFY { authorization? }: no header answers BEARER_ANONYMOUS; a header that is not Bearer <three-segment token> refuses malformed. Keys are fetched from the jwksOrigin and jwksPath knobs with an http GET, kept until now plus the response max-age, and refetched on expiry or when the token kid is absent from the cache. The kid picks the key; without a kid each key is tried in order, one JWS_VERIFY per key. The atom emits JWS_VERIFY { token, jwk } and listens for JWS_VERIFIED and JWS_REFUSED from std-jws. Claim policy (knobs issuer, audience, clockSkewSeconds, requireAuthTime, allowedTenants): malformed, expired, not-yet-valid, issued-in-future, issuer, audience, subject, auth-time, tenant. A bearer starting with the keyPrefix knob goes only to std-api-key-verifier (VERIFY_KEY, answers API_KEY_VERIFIED/API_KEY_REFUSED, correlated by requestId) when ALMADAR_API_KEY_SALT is set (read at boot), else is refused keys-disabled; it never falls back to the JWT path, and a non-key bearer never reaches the key path. A verified key is BEARER_VERIFIED with the owner as viewer id and the key claims. Success is BEARER_VERIFIED { viewer } with role and permissions mapped into the viewer (a non-string role or non-string-list permissions is refused claims) and every other claim as { name, value } carrying the claim JSON as is. Declare the JWKS origin in the app egress list.",
  egress: ["https://www.googleapis.com"],
  env: ["ALMADAR_API_KEY_SALT", "FIREBASE_AUTH_EMULATOR_HOST", "AUTH_PROVIDER", "FIREBASE_PROJECT_ID", "OIDC_ISSUER_URL", "OIDC_AUDIENCE"]
]
uses Spec from "almadar-std/bearer-verify"
type BearerKeyClaim = { name : string!, value : string! }
type BearerJob = { requestId : number, authorization : string }
type BearerHeader = { kid : string, alg : string }
type BearerJwk = { kty : string!, n : string, e : string, crv : string, x : string, y : string, alg : string, kid : string, use : string }
type BearerJwks = { keys : [BearerJwk] }
type BearerFirebase = { tenant : string }
type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type BearerExtra = Map string JsonValue
type BearerClaims = { iss : string, sub : string, aud : (string | [string]), exp : number, nbf : number, iat : number, auth_time : number, email : string, name : string, firebase : BearerFirebase, extra : BearerExtra }
type BearerCerts = Map string string
type BearerCert = { kid : string!, pem : string! }
type BearerAudList = [string]
type BearerRolePerms = { role : string, permissions : [string] }
type BearerJwsHeader = { alg : string, typ : string, kid : string }
orbital BearerVerifyOrbital {
  entity BearerCheck [runtime] {
    id : string!
    queue : [BearerJob] @description "Requests that arrived while one was in flight, oldest first; each starts when the one before it is answered." = []
    requestId : number @description "The request whose bearer is being verified; overlapping requests queue." = 0
    token : string @description "The token being verified." = ""
    kid : string @description "The kid in the token header, empty when absent." = ""
    keys : [BearerJwk] @description "The cached key set." = []
    expiresAt : number @description "When the cached key set stops being fresh, epoch milliseconds." = 0
    candidates : [BearerJwk] @description "The keys to try for the token in hand, in order." = []
    keysEnabled : boolean @description "Whether ALMADAR_API_KEY_SALT is set, read at boot; keys are accepted only then." = false
    emulator : boolean @description "Whether FIREBASE_AUTH_EMULATOR_HOST is set, read at boot; an unsigned (alg none) token is accepted only then." = false
    issuer : string @description "The iss every token must carry: the issuer knob, or with issuerFromEnv the one the environment names." = ""
    audience : string @description "The aud every token must carry: the audience knob, or with issuerFromEnv the one the environment names." = ""
    certQueue : [BearerCert] @description "Certificates of the fetched document still to be read for their keys, in document order." = []
    certKeys : [BearerJwk] @description "Keys read so far from the fetched certificates." = []
    attempt : number @description "Index of the candidate last asked of std-jws." = 0
    @invariant (>= @entity.attempt 0)
  }

  trait BearerVerifier -> BearerCheck [optimistic] {
    initial: idle

    state idle {
      KEY_SALT_READ -> idle
        (set @entity.keysEnabled (!= (or @payload.value "") ""))
      KEY_SALT_UNREAD -> idle
        (set @entity.keysEnabled false)
      EMULATOR_READ -> idle
        (set @entity.emulator (!= (or @payload.value "") ""))
      EMULATOR_UNREAD -> idle
        (set @entity.emulator false)
      INIT -> idle
        (set @entity.issuer @config.issuer)
        (set @entity.audience @config.audience)
        (os/getenv "ALMADAR_API_KEY_SALT" { emit: { success: KEY_SALT_READ failure: KEY_SALT_UNREAD } })
        (os/getenv "FIREBASE_AUTH_EMULATOR_HOST" { emit: { success: EMULATOR_READ failure: EMULATOR_UNREAD } })
        (when @config.issuerFromEnv (os/getenv "AUTH_PROVIDER" { emit: { success: PROVIDER_READ failure: ISSUER_UNREAD } }))
      PROVIDER_READ -> idle when (= (or @payload.value "") "firebase")
        (os/getenv "FIREBASE_PROJECT_ID" { emit: { success: PROJECT_READ failure: ISSUER_UNREAD } })
      PROVIDER_READ -> idle when (= (or @payload.value "") "oidc")
        (os/getenv "OIDC_ISSUER_URL" { emit: { success: OIDC_ISSUER_READ failure: ISSUER_UNREAD } })
      PROVIDER_READ -> idle when (and (!= (or @payload.value "") "firebase") (!= (or @payload.value "") "oidc"))
      PROJECT_READ -> idle when (!= (or @payload.value "") "")
        (set @entity.issuer (str/concat "https://securetoken.google.com/" @payload.value))
        (set @entity.audience @payload.value)
      PROJECT_READ -> idle when (= (or @payload.value "") "")
      OIDC_ISSUER_READ -> idle when (!= (or @payload.value "") "")
        (set @entity.issuer @payload.value)
        (os/getenv "OIDC_AUDIENCE" { emit: { success: OIDC_AUDIENCE_READ failure: ISSUER_UNREAD } })
      OIDC_ISSUER_READ -> idle when (= (or @payload.value "") "")
      OIDC_AUDIENCE_READ -> idle when (!= (or @payload.value "") "")
        (set @entity.audience @payload.value)
      OIDC_AUDIENCE_READ -> idle when (= (or @payload.value "") "")
      ISSUER_UNREAD -> idle

      BEARER_VERIFY -> idle when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) @entity.keysEnabled)
        (emit VERIFY_KEY { requestId: (or @payload.requestId 0), token: (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) })
      BEARER_VERIFY -> idle when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) (not @entity.keysEnabled))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "keys-disabled" })
      API_KEY_VERIFIED -> idle
        (emit BEARER_VERIFIED { requestId: (or @payload.requestId 0), viewer: { id: @payload.owner, claims: @payload.claims } })
      API_KEY_REFUSED -> idle
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: (str/concat "api-key-" @payload.reason) })
      BEARER_VERIFY -> idle when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (< (array/len @entity.queue) @config.maxQueue))
        (set @entity.queue (array/append @entity.queue { requestId: (or @payload.requestId 0), authorization: (or @payload.authorization "") }))
        (emit BEARER_PUMP {})
      BEARER_VERIFY -> idle when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (>= (array/len @entity.queue) @config.maxQueue))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "busy" })
      BEARER_PUMP -> idle when (= (array/len @entity.queue) 0)
      BEARER_PUMP -> idle when (and (> (array/len @entity.queue) 0) (= (or (object/get (array/first @entity.queue) "authorization") "") ""))
        (emit BEARER_ANONYMOUS { requestId: (or (or (object/get (array/first @entity.queue) "requestId") 0) 0) })
        (set @entity.queue (array/slice @entity.queue 1))
        (emit BEARER_NEXT {})
      BEARER_PUMP -> idle when (and (> (array/len @entity.queue) 0) (and (!= (or (object/get (array/first @entity.queue) "authorization") "") "") (or (not (str/startsWith (object/get (array/first @entity.queue) "authorization") "Bearer ")) (!= (array/len (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".")) 3))))
        (emit BEARER_REFUSED { requestId: (or (or (object/get (array/first @entity.queue) "requestId") 0) 0), reason: "malformed" })
        (set @entity.queue (array/slice @entity.queue 1))
        (emit BEARER_NEXT {})
      BEARER_PUMP -> idle when (and (> (array/len @entity.queue) 0) (!= (or (object/get (array/first @entity.queue) "authorization") "") "") (and (str/startsWith (object/get (array/first @entity.queue) "authorization") "Bearer ") (= (array/len (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".")) 3)) (or (not (base64/valid (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4)))))) (let ((d (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (or (= @d null) (not (json/valid @d)))) (not (base64/valid (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 1) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4)))))) (let ((d (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 1) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (or (= @d null) (not (json/valid @d))))))
        (emit BEARER_REFUSED { requestId: (or (or (object/get (array/first @entity.queue) "requestId") 0) 0), reason: "malformed" })
        (set @entity.queue (array/slice @entity.queue 1))
        (emit BEARER_NEXT {})
      BEARER_PUMP -> verifying when (and @entity.emulator (> (array/len @entity.queue) 0) (str/startsWith (or (object/get (array/first @entity.queue) "authorization") "") "Bearer ") (= (array/len (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".")) 3) (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (and (!= @hd null) (= (object/get (json/parse @hd BearerJwsHeader) "alg" "") "none"))))
        (let ((token (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization")))))
          (let ((pj (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 1) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4)))))))
            (let ((header (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (if (= @hd null) null (json/parse @hd BearerJwsHeader)))) (claims (if (= @pj null) null (json/parse @pj BearerClaims))) (xtra (if (= @pj null) null (json/parse @pj BearerExtra))))
              (do
                (set @entity.token @token)
                (set @entity.requestId (or (or (object/get (array/first @entity.queue) "requestId") 0) 0))
                (set @entity.queue (array/slice @entity.queue 1))
                (if (or (= @header null) (= @claims null) (= @xtra null))
                  (emit JWS_REFUSED { reason: "malformed" })
                  (emit JWS_VERIFIED { header: @header, payload: (object/set @claims extra @xtra) }))))))
      BEARER_PUMP -> verifying when (and (> (array/len @entity.queue) 0) (and (!= (or (object/get (array/first @entity.queue) "authorization") "") "") (str/startsWith (object/get (array/first @entity.queue) "authorization") "Bearer ") (= (array/len (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".")) 3) (> @entity.expiresAt @now) (> (array/len @entity.keys) 0) (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (and (!= @hd null) (let ((kid (object/get (json/parse @hd BearerHeader) "kid" ""))) (or (= @kid "") (array/some @entity.keys (fn k (= (object/get @k "kid" "") @kid)))))))))
        (let ((token (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization")))))
          (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split @token ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (if (= @hd null) (emit BEARER_REFUSED { requestId: (or (or (object/get (array/first @entity.queue) "requestId") 0) 0), reason: "malformed" }) (let ((kid (object/get (json/parse @hd BearerHeader) "kid" "")))
            (let ((cands (array/filter @entity.keys (fn k (and (or (= @kid "") (= (object/get @k "kid" "") @kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig")))))))
              (do
                (set @entity.token @token)
                (set @entity.requestId (or (or (object/get (array/first @entity.queue) "requestId") 0) 0))
                (set @entity.kid @kid)
                (set @entity.candidates @cands)
                (set @entity.attempt 0)
                (emit JWS_VERIFY { token: @token, jwk: (array/nth @cands 0) })))))))
        (set @entity.queue (array/slice @entity.queue 1))
      BEARER_PUMP -> fetching when (and (> (array/len @entity.queue) 0) (!= (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))) null) (and (!= (or (object/get (array/first @entity.queue) "authorization") "") "") (str/startsWith (object/get (array/first @entity.queue) "authorization") "Bearer ") (= (array/len (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".")) 3) (not (and (> @entity.expiresAt @now) (> (array/len @entity.keys) 0) (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization"))) ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (and (!= @hd null) (let ((kid (object/get (json/parse @hd BearerHeader) "kid" ""))) (or (= @kid "") (array/some @entity.keys (fn k (= (object/get @k "kid" "") @kid)))))))))))
        (let ((token (str/slice (object/get (array/first @entity.queue) "authorization") 7 (str/len (object/get (array/first @entity.queue) "authorization")))))
          (do
            (set @entity.token @token)
                (set @entity.requestId (or (or (object/get (array/first @entity.queue) "requestId") 0) 0))
            (let ((hd (base64/decode (let ((x (str/replaceAll (str/replaceAll (array/nth (str/split @token ".") 0) "-" "+") "_" "/"))) (str/concat @x (str/repeat "=" (math/mod (- 4 (math/mod (str/len @x) 4)) 4))))))) (if (= @hd null) (emit BEARER_REFUSED { requestId: (or (or (object/get (array/first @entity.queue) "requestId") 0) 0), reason: "malformed" }) (do (set @entity.kid (object/get (json/parse @hd BearerHeader) "kid" "")) (http GET @config.jwksOrigin @config.jwksPath {
              headers: { Accept: "application/json" },
              timeoutMs: @config.timeoutMs
            } { emit: { success: JWKS_REPLIED, failure: JWKS_UNREACHABLE } }))))))
        (set @entity.queue (array/slice @entity.queue 1))
      BEARER_NEXT -> idle
        (emit BEARER_PUMP {})
    }

    state fetching {
      KEY_SALT_READ -> fetching
        (set @entity.keysEnabled (!= (or @payload.value "") ""))
      KEY_SALT_UNREAD -> fetching
        (set @entity.keysEnabled false)
      EMULATOR_READ -> fetching
        (set @entity.emulator (!= (or @payload.value "") ""))
      EMULATOR_UNREAD -> fetching
        (set @entity.emulator false)
      BEARER_VERIFY -> fetching when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) @entity.keysEnabled)
        (emit VERIFY_KEY { requestId: (or @payload.requestId 0), token: (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) })
      BEARER_VERIFY -> fetching when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) (not @entity.keysEnabled))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "keys-disabled" })
      API_KEY_VERIFIED -> fetching
        (emit BEARER_VERIFIED { requestId: (or @payload.requestId 0), viewer: { id: @payload.owner, claims: @payload.claims } })
      API_KEY_REFUSED -> fetching
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: (str/concat "api-key-" @payload.reason) })
      BEARER_VERIFY -> fetching when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (< (array/len @entity.queue) @config.maxQueue))
        (set @entity.queue (array/append @entity.queue { requestId: (or @payload.requestId 0), authorization: (or @payload.authorization "") }))
      BEARER_VERIFY -> fetching when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (>= (array/len @entity.queue) @config.maxQueue))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "busy" })
      INIT -> idle
      JWKS_REPLIED -> idle when (or (!= @payload.status 200) (not (json/valid @payload.body)))
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: "keys-unavailable" })
        (emit BEARER_PUMP {})
      JWKS_REPLIED -> idle when (and (= @payload.status 200) (json/valid @payload.body) (= @config.keysFormat "jwks") (= (array/len (array/filter (object/get (json/parse @payload.body BearerJwks) "keys" []) (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig")))))) 0))
        (let ((keys (object/get (json/parse @payload.body BearerJwks) "keys" [])))
          (do
            (set @entity.keys @keys)
            (set @entity.expiresAt (+ @now (* 1000 (let ((cc (array/find (object/keys @payload.headers) (fn h (= (str/lower @h) "cache-control"))))) (if (= @cc null) 0 (let ((parts (str/split (object/get @payload.headers @cc) "max-age="))) (if (< (array/len @parts) 2) 0 (str/to-number (array/nth (str/split (array/nth @parts 1) ",") 0)))))))))
            (emit BEARER_REFUSED { requestId: @entity.requestId, reason: (if (> (array/len @keys) 0) "unknown-key" "keys-unavailable") })))
        (emit BEARER_PUMP {})
      JWKS_REPLIED -> verifying when (and (= @payload.status 200) (json/valid @payload.body) (= @config.keysFormat "jwks") (> (array/len (array/filter (object/get (json/parse @payload.body BearerJwks) "keys" []) (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig")))))) 0))
        (let ((keys (object/get (json/parse @payload.body BearerJwks) "keys" [])))
          (let ((cands (array/filter @keys (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig")))))))
            (do
              (set @entity.keys @keys)
              (set @entity.expiresAt (+ @now (* 1000 (let ((cc (array/find (object/keys @payload.headers) (fn h (= (str/lower @h) "cache-control"))))) (if (= @cc null) 0 (let ((parts (str/split (object/get @payload.headers @cc) "max-age="))) (if (< (array/len @parts) 2) 0 (str/to-number (array/nth (str/split (array/nth @parts 1) ",") 0)))))))))
              (set @entity.candidates @cands)
              (set @entity.attempt 0)
              (emit JWS_VERIFY { token: @entity.token, jwk: (array/nth @cands 0) }))))
      JWKS_REPLIED -> idle when (and (= @payload.status 200) (json/valid @payload.body) (= @config.keysFormat "x509") (let ((none : BearerCerts {})) (= (array/len (object/keys (or (json/parse @payload.body BearerCerts) @none))) 0)))
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: "keys-unavailable" })
        (emit BEARER_PUMP {})
      JWKS_REPLIED -> certifying when (and (= @payload.status 200) (json/valid @payload.body) (= @config.keysFormat "x509") (let ((none : BearerCerts {})) (> (array/len (object/keys (or (json/parse @payload.body BearerCerts) @none))) 0)))
        (let ((none : BearerCerts {}) (certs (or (json/parse @payload.body BearerCerts) @none)))
          (do
            (set @entity.expiresAt (+ @now (* 1000 (let ((cc (array/find (object/keys @payload.headers) (fn h (= (str/lower @h) "cache-control"))))) (if (= @cc null) 0 (let ((parts (str/split (object/get @payload.headers @cc) "max-age="))) (if (< (array/len @parts) 2) 0 (str/to-number (array/nth (str/split (array/nth @parts 1) ",") 0)))))))))
            (set @entity.certKeys [])
            (set @entity.certQueue (array/map (object/entries @certs) (fn t { kid: (array/nth @t 0), pem: (array/nth @t 1) })))
            (emit X509_PARSE { pem: (array/nth (array/first (object/entries @certs)) 1) })))
      JWKS_UNREACHABLE -> idle
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: "keys-unavailable" })
        (emit BEARER_PUMP {})
    }

    state certifying {
      KEY_SALT_READ -> certifying
        (set @entity.keysEnabled (!= (or @payload.value "") ""))
      KEY_SALT_UNREAD -> certifying
        (set @entity.keysEnabled false)
      EMULATOR_READ -> certifying
        (set @entity.emulator (!= (or @payload.value "") ""))
      EMULATOR_UNREAD -> certifying
        (set @entity.emulator false)
      BEARER_VERIFY -> certifying when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) @entity.keysEnabled)
        (emit VERIFY_KEY { requestId: (or @payload.requestId 0), token: (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) })
      BEARER_VERIFY -> certifying when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) (not @entity.keysEnabled))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "keys-disabled" })
      API_KEY_VERIFIED -> certifying
        (emit BEARER_VERIFIED { requestId: (or @payload.requestId 0), viewer: { id: @payload.owner, claims: @payload.claims } })
      API_KEY_REFUSED -> certifying
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: (str/concat "api-key-" @payload.reason) })
      BEARER_VERIFY -> certifying when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (< (array/len @entity.queue) @config.maxQueue))
        (set @entity.queue (array/append @entity.queue { requestId: (or @payload.requestId 0), authorization: (or @payload.authorization "") }))
      BEARER_VERIFY -> certifying when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (>= (array/len @entity.queue) @config.maxQueue))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "busy" })
      INIT -> idle
      X509_PARSED -> certifying when (> (array/len @entity.certQueue) 1)
        (set @entity.certKeys (array/append @entity.certKeys { kty: "RSA", n: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.n }) "+" "-") "/" "_") "=" ""), e: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.e }) "+" "-") "/" "_") "=" ""), kid: (object/get (array/first @entity.certQueue) "kid"), alg: "RS256", use: "sig" }))
        (set @entity.certQueue (array/slice @entity.certQueue 1))
        (emit X509_PARSE { pem: (object/get (array/nth @entity.certQueue 1) "pem") })
      X509_PARSED -> verifying when (and (= (array/len @entity.certQueue) 1) (> (array/len (let ((all (array/append @entity.certKeys { kty: "RSA", n: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.n }) "+" "-") "/" "_") "=" ""), e: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.e }) "+" "-") "/" "_") "=" ""), kid: (object/get (array/first @entity.certQueue) "kid"), alg: "RS256", use: "sig" }))) (array/filter @all (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig"))))))) 0))
        (let ((all (array/append @entity.certKeys { kty: "RSA", n: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.n }) "+" "-") "/" "_") "=" ""), e: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.e }) "+" "-") "/" "_") "=" ""), kid: (object/get (array/first @entity.certQueue) "kid"), alg: "RS256", use: "sig" })))
          (let ((cands (array/filter @all (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig")))))))
            (do
              (set @entity.keys @all)
              (set @entity.certKeys [])
              (set @entity.certQueue [])
              (set @entity.candidates @cands)
              (set @entity.attempt 0)
              (emit JWS_VERIFY { token: @entity.token, jwk: (array/nth @cands 0) }))))
      X509_PARSED -> idle when (and (= (array/len @entity.certQueue) 1) (= (array/len (let ((all (array/append @entity.certKeys { kty: "RSA", n: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.n }) "+" "-") "/" "_") "=" ""), e: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.e }) "+" "-") "/" "_") "=" ""), kid: (object/get (array/first @entity.certQueue) "kid"), alg: "RS256", use: "sig" }))) (array/filter @all (fn k (and (or (= @entity.kid "") (= (object/get @k "kid" "") @entity.kid)) (or (= (object/get @k "use" "") "") (= (object/get @k "use" "") "sig"))))))) 0))
        (set @entity.keys (array/append @entity.certKeys { kty: "RSA", n: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.n }) "+" "-") "/" "_") "=" ""), e: (str/replaceAll (str/replaceAll (str/replaceAll (str/template "{{value}}" { value: @payload.e }) "+" "-") "/" "_") "=" ""), kid: (object/get (array/first @entity.certQueue) "kid"), alg: "RS256", use: "sig" }))
        (set @entity.certKeys [])
        (set @entity.certQueue [])
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: "unknown-key" })
        (emit BEARER_PUMP {})
      X509_REFUSED -> idle
        (set @entity.certKeys [])
        (set @entity.certQueue [])
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: "keys-unavailable" })
        (emit BEARER_PUMP {})
    }

    state verifying {
      KEY_SALT_READ -> verifying
        (set @entity.keysEnabled (!= (or @payload.value "") ""))
      KEY_SALT_UNREAD -> verifying
        (set @entity.keysEnabled false)
      EMULATOR_READ -> verifying
        (set @entity.emulator (!= (or @payload.value "") ""))
      EMULATOR_UNREAD -> verifying
        (set @entity.emulator false)
      BEARER_VERIFY -> verifying when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) @entity.keysEnabled)
        (emit VERIFY_KEY { requestId: (or @payload.requestId 0), token: (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) })
      BEARER_VERIFY -> verifying when (and (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix)) (not @entity.keysEnabled))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "keys-disabled" })
      API_KEY_VERIFIED -> verifying
        (emit BEARER_VERIFIED { requestId: (or @payload.requestId 0), viewer: { id: @payload.owner, claims: @payload.claims } })
      API_KEY_REFUSED -> verifying
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: (str/concat "api-key-" @payload.reason) })
      BEARER_VERIFY -> verifying when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (< (array/len @entity.queue) @config.maxQueue))
        (set @entity.queue (array/append @entity.queue { requestId: (or @payload.requestId 0), authorization: (or @payload.authorization "") }))
      BEARER_VERIFY -> verifying when (and (not (and (str/startsWith (or @payload.authorization "") "Bearer ") (str/startsWith (str/slice (or @payload.authorization "") 7 (str/len (or @payload.authorization ""))) @config.keyPrefix))) (>= (array/len @entity.queue) @config.maxQueue))
        (emit BEARER_REFUSED { requestId: (or @payload.requestId 0), reason: "busy" })
      INIT -> idle
      JWS_REFUSED -> verifying when (and (= @entity.kid "") (array/includes ["signature", "key-type", "alg-mismatch", "curve", "key-missing"] @payload.reason) (< (+ @entity.attempt 1) (array/len @entity.candidates)))
        (emit JWS_VERIFY { token: @entity.token, jwk: (array/nth @entity.candidates (+ @entity.attempt 1)) })
        (set @entity.attempt (+ @entity.attempt 1))
      JWS_REFUSED -> idle when (not (and (= @entity.kid "") (array/includes ["signature", "key-type", "alg-mismatch", "curve", "key-missing"] @payload.reason) (< (+ @entity.attempt 1) (array/len @entity.candidates))))
        (emit BEARER_REFUSED { requestId: @entity.requestId, reason: (if (= @payload.reason "alg-not-allowed") "algorithm" @payload.reason) })
        (emit BEARER_PUMP {})
      JWS_VERIFIED -> idle
        (let ((nowS (math/floor (/ @now 1000))) (skew @config.clockSkewSeconds) (c @payload.payload))
          (let ((why (if (or (= @c.exp null) (<= @c.exp 0)) "malformed"
                       (if (<= @c.exp (- @nowS @skew)) "expired"
                         (if (and (!= @c.nbf null) (> @c.nbf 0) (> @c.nbf (+ @nowS @skew))) "not-yet-valid"
                           (if (and (!= @c.iat null) (> @c.iat 0) (> @c.iat (+ @nowS @skew))) "issued-in-future"
                             (if (!= (or @c.iss "") @entity.issuer) "issuer"
                               (if (not (if (str/startsWith (json/stringify @c.aud) "[") (let ((auds (json/parse (json/stringify @c.aud) BearerAudList))) (if (= @auds null) false (array/includes @auds @entity.audience))) (= (json/stringify @c.aud) (json/stringify @entity.audience)))) "audience"
                                 (if (= (or @c.sub "") "") "subject"
                                   (if (and @config.requireAuthTime (or (<= (or @c.auth_time 0) 0) (> @c.auth_time @nowS))) "auth-time"
                                     (if (and (> (array/len @config.allowedTenants) 0) (not (array/includes @config.allowedTenants (or (object/get (or @c.firebase {}) "tenant" "") "")))) "tenant" (if (and (array/includes (object/keys @c.extra) "role") (not (str/startsWith (json/stringify (object/get @c.extra "role")) "\""))) "claims" (if (and (array/includes (object/keys @c.extra) "permissions") (not (validate/pattern (json/stringify (object/get @c.extra "permissions")) "^\\[(?:\"(?:[^\"\\\\]|\\\\.)*\"(?:,\"(?:[^\"\\\\]|\\\\.)*\")*)?\\]$"))) "claims" "")))))))))))))
            (if (= @why "")
              (emit BEARER_VERIFIED { requestId: @entity.requestId, viewer: { id: @c.sub, email: @c.email, name: @c.name, role: (if (array/includes (object/keys @c.extra) "role") (object/get (json/parse (json/stringify @c.extra) BearerRolePerms) "role" "") null), permissions: (if (array/includes (object/keys @c.extra) "permissions") (object/get (json/parse (json/stringify @c.extra) BearerRolePerms) "permissions" []) null), claims: (array/map (object/entries (object/omit (or @c.extra {}) ["iss", "aud", "exp", "nbf", "iat", "auth_time", "sub", "email", "name", "role", "permissions"])) (fn t { name: (array/nth @t 0), value: (array/nth @t 1) })) } })
              (emit BEARER_REFUSED { requestId: @entity.requestId, reason: @why }))))
        (emit BEARER_PUMP {})
    }

    emits {
      BEARER_VERIFIED -> external {
        requestId : number
        viewer : Viewer!
      }
        @description "The bearer verified and passed the claim policy; the viewer it identifies."
        @synonyms "bearer ok, token accepted, signed in"
        @tier "primary"
      BEARER_ANONYMOUS -> external {
        requestId : number
      }
        @description "The request carried no Authorization header."
        @synonyms "no bearer, anonymous request"
        @tier "primary"
      BEARER_REFUSED -> external {
        requestId : number
        reason : string!
      }
        @description "The bearer was refused: malformed, keys-unavailable, unknown-key, algorithm, a std-jws reason, or a policy reason (expired, not-yet-valid, issued-in-future, issuer, audience, subject, auth-time, tenant)."
        @synonyms "bearer refused, token rejected"
        @tier "primary"
      JWS_VERIFY -> external {
        token : string!
        jwk : BearerJwk!
      }
        @description "Internal: ask std-jws to verify the token against one key."
        @tier "internal"
      JWS_VERIFIED {
        header : BearerJwsHeader!
        payload : BearerClaims!
      }
        @description "Internal: an unsigned token from the Auth emulator is handed to the claim policy as if std-jws had verified it."
        @tier "internal"
      JWS_REFUSED {
        reason : string!
      }
        @description "Internal: an unsigned token from the Auth emulator whose header or claims do not read is refused as malformed, as if std-jws had refused it."
        @tier "internal"
      X509_PARSE -> external {
        pem : string!
      }
        @description "Internal: ask std-x509 for the RSA key of one fetched certificate."
        @tier "internal"
      EMULATOR_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for FIREBASE_AUTH_EMULATOR_HOST."
        @tier "internal"
      PROVIDER_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for AUTH_PROVIDER."
        @tier "internal"
      PROJECT_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for FIREBASE_PROJECT_ID."
        @tier "internal"
      OIDC_ISSUER_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for OIDC_ISSUER_URL."
        @tier "internal"
      OIDC_AUDIENCE_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for OIDC_AUDIENCE."
        @tier "internal"
      ISSUER_UNREAD {
        error : string
        kind : string
      }
        @description "Internal: an os/getenv of the issuer environment failed; the knobs stand."
        @tier "internal"
      EMULATOR_UNREAD {
        error : string
        kind : string
      }
        @description "Internal: FIREBASE_AUTH_EMULATOR_HOST is not set."
        @tier "internal"
      VERIFY_KEY -> external {
        requestId : number
        token : string!
      }
        @description "Internal: a bearer carrying the API key prefix goes only to std-api-key-verifier."
        @tier "internal"
      KEY_SALT_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for ALMADAR_API_KEY_SALT."
        @tier "internal"
      KEY_SALT_UNREAD {
        error : string
        kind : string
      }
        @description "Internal: the os/getenv for ALMADAR_API_KEY_SALT failed."
        @tier "internal"
      BEARER_NEXT {}
        @description "Internal: an answer that needed no key work is done; start the next queued request."
        @tier "secondary"
      BEARER_PUMP {}
        @description "Internal: start the oldest queued request."
        @tier "secondary"
      JWKS_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the key document reply."
        @tier "secondary"
      JWKS_UNREACHABLE {
        error : string!
        kind : string!
      }
        @description "Internal: the key document fetch produced no reply."
        @tier "secondary"
    }

    listens {
      BEARER_VERIFY -> input {
        requestId : number
        authorization : string
      }
        @description "Verify the raw Authorization header of one request."
        @synonyms "verify bearer, check authorization header"
      API_KEY_VERIFIED {
        requestId : number
        owner : string!
        claims : [BearerKeyClaim]!
      }
        @description "Internal: std-api-key-verifier accepted the key; its owner is the viewer id and its claims the viewer claims."
      API_KEY_REFUSED {
        requestId : number
        reason : string!
        message : string!
      }
        @description "Internal: std-api-key-verifier refused the key."
      JWS_VERIFIED {
        header : BearerJwsHeader!
        payload : BearerClaims!
      }
        @description "Internal: std-jws verified the signature."
      JWS_REFUSED {
        reason : string!
      }
        @description "Internal: std-jws refused the token."
      X509_PARSED {
        n : bytes!
        e : bytes!
      }
        @description "Internal: std-x509 read the key of a certificate."
      X509_REFUSED {
        reason : string!
      }
        @description "Internal: std-jws refused the token."
    }

    config {
      jwksOrigin : url = "https://www.googleapis.com"
        @label "JWKS origin"
        @description "The origin (scheme://host, no path) the signing keys are published at; it must be in the app egress list."
        @synonyms "key set origin, jwks host"
        @tier "infra"
      keysFormat : string = "jwks"
        @label "Key document format"
        @description "jwks reads a JWK Set (OIDC jwks_uri; Firebase securetoken JWK endpoint); x509 reads a document of kid to PEM certificate (Firebase /robot/v1/metadata/x509/securetoken@system.gserviceaccount.com), each certificate read through std-x509."
        @synonyms "key source, certificate keys"
        @tier "domain"
      jwksPath : string = "/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
        @label "JWKS path"
        @description "The path of the key set on jwksOrigin (OIDC jwks_uri path)."
        @synonyms "key set path"
        @tier "infra"
      issuerFromEnv : boolean = false
        @label "Issuer from environment"
        @description "At INIT, read AUTH_PROVIDER: firebase sets the issuer to https://securetoken.google.com/<FIREBASE_PROJECT_ID> and the audience to that project id; oidc sets them to OIDC_ISSUER_URL and OIDC_AUDIENCE; anything else, or a blank variable, leaves the issuer and audience knobs."
        @synonyms "issuer env, auth provider env"
        @tier "infra"
      issuer : string = ""
        @label "Issuer"
        @description "The iss every token must carry."
        @synonyms "token issuer"
        @tier "domain"
      audience : string = ""
        @label "Audience"
        @description "The aud every token must carry, as the string or a list entry."
        @synonyms "token audience, client id"
        @tier "domain"
      clockSkewSeconds : number = 0
        @label "Clock skew (s)"
        @description "Seconds of tolerance on exp, nbf and iat."
        @synonyms "leeway"
        @tier "domain"
      requireAuthTime : boolean = false
        @label "Require auth_time"
        @description "Refuse a token whose auth_time is absent or in the future."
        @synonyms "firebase auth time"
        @tier "domain"
      allowedTenants : [string] = []
        @label "Allowed tenants"
        @description "When not empty, the token firebase.tenant must be one of these."
        @synonyms "tenant allow list"
        @tier "domain"
      keyPrefix : string = "sk_live_"
        @label "API key prefix"
        @description "A bearer starting with this goes only to the API key path; anything else goes only to the JWT path. Neither falls back to the other."
        @synonyms "key prefix"
        @tier "infra"
      maxQueue : number = 256
        @label "Queue bound"
        @description "How many requests may wait behind the one in flight; one beyond it is refused with busy."
        @synonyms "queue limit, backlog"
        @tier "domain"
      timeoutMs : number = 10000
        @label "Fetch timeout (ms)"
        @description "Milliseconds the key fetch may take."
        @synonyms "timeout"
        @tier "infra"
    }
  }

  page boot as BearerVerifyStart -> BearerVerifier
}
