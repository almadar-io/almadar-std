app std-rsa [
  version: "1.0.0",
  description: "std-rsa — verify an RSASSA-PKCS1-v1_5 signature with SHA-256 (RFC 8017 section 8.2.2, what JWS RS256 needs) over std-bigint and the hash/sha256 operator. RSA_VERIFY { n, e, message, signature } takes the modulus and exponent as big-endian padded base64 bytes, the message as text (hashed as its UTF-8 bytes) and the signature as bytes. It decodes n, e and the signature through std-bigint FROM_BYTES, refuses a signature not below n, computes s^e mod n with MODPOW, encodes it to the modulus length with TO_BYTES, and answers RSA_VERIFIED { valid } when the whole block equals 00 01 FF..FF 00 DigestInfo(SHA-256) hash byte for byte (no parse). RSA_REFUSED { reason } is invalid (not canonical base64), key-size (modulus under minModulusBytes or with a leading zero byte, or an exponent empty or not shorter than the modulus), signature-length, signature-range or bigint. Verify only: signing and PSS are not here."
]
uses Spec from "almadar-std/rsa"
orbital RsaOrbital {
  uses Big from "std/behaviors/std-bigint"

  entity RsaRun [runtime] {
    id : string!
    k : number @description "Modulus length in bytes." = 0
    msg : string @description "The message being verified." = ""
    eB : bytes @description "The exponent bytes awaiting decode." = ""
    sB : bytes @description "The signature bytes awaiting decode." = ""
    nL : [number] @description "Modulus limbs." = []
    eL : [number] @description "Exponent limbs." = []
    sL : [number] @description "Signature limbs." = []
  }

  trait RsaBigInt = Big.traits.BigIntCodec {
    listens {
      RsaVerifier.RSA_FROM_BYTES -> FROM_BYTES
      RsaVerifier.RSA_COMPARE -> COMPARE
      RsaVerifier.RSA_MODPOW -> MODPOW
      RsaVerifier.RSA_TO_BYTES -> TO_BYTES
    }
  }

  trait RsaVerifier -> RsaRun [client] {
    initial: idle

    config {
      base64Pattern : string = "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
        @label "Canonical padded base64"
        @description "The pattern every bytes input must match."
        @synonyms "base64 rule"
        @tier "domain"
      minModulusBytes : number = 256
        @label "Minimum modulus bytes"
        @description "Smallest accepted modulus, 256 bytes (2048 bits) for RS256."
        @synonyms "minimum key size"
        @tier "domain"
      digestInfo : string = "ADAxMA0GCWCGSAFlAwQCAQUABCA="
        @label "SHA-256 DigestInfo"
        @description "The 00 byte then the 19-byte DER DigestInfo prefix of SHA-256 (RFC 8017 note 1), as base64."
        @synonyms "digest info prefix"
        @tier "domain"
    }

    state idle {
      INIT -> idle
      RSA_VERIFY -> idle when (not (and (and (validate/pattern (bytes/to-base64 @payload.n) @config.base64Pattern) (validate/pattern (bytes/to-base64 @payload.e) @config.base64Pattern)) (validate/pattern (bytes/to-base64 @payload.signature) @config.base64Pattern)))
        (emit RSA_REFUSED { reason: "invalid" })
      RSA_VERIFY -> idle when (and (and (and (validate/pattern (bytes/to-base64 @payload.n) @config.base64Pattern) (validate/pattern (bytes/to-base64 @payload.e) @config.base64Pattern)) (validate/pattern (bytes/to-base64 @payload.signature) @config.base64Pattern)) (or (or (< (bytes/length @payload.n) @config.minModulusBytes) (== (bytes/at @payload.n 0) 0)) (or (== (bytes/length @payload.e) 0) (>= (bytes/length @payload.e) (bytes/length @payload.n)))))
        (emit RSA_REFUSED { reason: "key-size" })
      RSA_VERIFY -> idle when (and (and (and (and (validate/pattern (bytes/to-base64 @payload.n) @config.base64Pattern) (validate/pattern (bytes/to-base64 @payload.e) @config.base64Pattern)) (validate/pattern (bytes/to-base64 @payload.signature) @config.base64Pattern)) (not (or (or (< (bytes/length @payload.n) @config.minModulusBytes) (== (bytes/at @payload.n 0) 0)) (or (== (bytes/length @payload.e) 0) (>= (bytes/length @payload.e) (bytes/length @payload.n)))))) (!= (bytes/length @payload.signature) (bytes/length @payload.n)))
        (emit RSA_REFUSED { reason: "signature-length" })
      RSA_VERIFY -> idle when (and (and (and (and (and (validate/pattern (bytes/to-base64 @payload.n) @config.base64Pattern) (validate/pattern (bytes/to-base64 @payload.e) @config.base64Pattern)) (validate/pattern (bytes/to-base64 @payload.signature) @config.base64Pattern)) (not (or (or (< (bytes/length @payload.n) @config.minModulusBytes) (== (bytes/at @payload.n 0) 0)) (or (== (bytes/length @payload.e) 0) (>= (bytes/length @payload.e) (bytes/length @payload.n)))))) (not (!= (bytes/length @payload.signature) (bytes/length @payload.n)))) (bytes/equals @payload.signature @payload.n))
        (emit RSA_REFUSED { reason: "signature-range" })
      RSA_VERIFY -> decN when (and (and (and (and (and (validate/pattern (bytes/to-base64 @payload.n) @config.base64Pattern) (validate/pattern (bytes/to-base64 @payload.e) @config.base64Pattern)) (validate/pattern (bytes/to-base64 @payload.signature) @config.base64Pattern)) (not (or (or (< (bytes/length @payload.n) @config.minModulusBytes) (== (bytes/at @payload.n 0) 0)) (or (== (bytes/length @payload.e) 0) (>= (bytes/length @payload.e) (bytes/length @payload.n)))))) (not (!= (bytes/length @payload.signature) (bytes/length @payload.n)))) (not (bytes/equals @payload.signature @payload.n)))
        (set @entity.k (bytes/length @payload.n))
        (set @entity.msg @payload.message)
        (set @entity.eB @payload.e)
        (set @entity.sB @payload.signature)
        (emit RSA_FROM_BYTES { data: @payload.n })
    }

    state decN {
      INIT -> idle
      BIG_DECODED -> decE
        (set @entity.nL @payload.value)
        (emit RSA_FROM_BYTES { data: @entity.eB })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    state decE {
      INIT -> idle
      BIG_DECODED -> decS
        (set @entity.eL @payload.value)
        (emit RSA_FROM_BYTES { data: @entity.sB })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    state decS {
      INIT -> idle
      BIG_DECODED -> cmp
        (set @entity.sL @payload.value)
        (emit RSA_COMPARE { a: @payload.value, b: @entity.nL })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    state cmp {
      INIT -> idle
      BIG_COMPARED -> pow when (== @payload.value -1)
        (emit RSA_MODPOW { a: @entity.sL, e: @entity.eL, m: @entity.nL })
      BIG_COMPARED -> idle when (!= @payload.value -1)
        (emit RSA_REFUSED { reason: "signature-range" })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    state pow {
      INIT -> idle
      BIG_POWERED -> enc
        (emit RSA_TO_BYTES { value: @payload.value, size: @entity.k })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    state enc {
      INIT -> idle
      BIG_ENCODED -> idle
        (emit RSA_VERIFIED { valid: (bytes/equals @payload.value
          (bytes/concat
          (array/concat
            (array/concat
              [(bytes/write-uint 1 2 "be")]
              (array/map (array/range 0 (- @entity.k 54)) (fn i (bytes/write-uint 255 1 "be"))))
            [@config.digestInfo (hash/sha256 @entity.msg "base64")]))) })
      BIG_REFUSED -> idle
        (emit RSA_REFUSED { reason: "bigint" })
    }

    emits {
      RSA_VERIFIED -> external {
        valid : boolean!
      }
        @description "The signature verdict: true only when the recovered block equals the expected encoded message exactly."
        @synonyms "signature valid, rs256 verdict"
        @tier "primary"
      RSA_REFUSED -> external {
        reason : string!
      }
        @description "The verification could not run: invalid, key-size, signature-length, signature-range or bigint."
        @synonyms "signature refused, bad key"
        @tier "primary"
      RSA_FROM_BYTES -> external {
        data : bytes!
      }
        @description "Internal: decode bytes to limbs."
        @tier "internal"
      RSA_COMPARE -> external {
        a : [number]!
        b : [number]!
      }
        @description "Internal: compare two limb numbers."
        @tier "internal"
      RSA_MODPOW -> external {
        a : [number]!
        e : [number]!
        m : [number]!
      }
        @description "Internal: modular exponentiation."
        @tier "internal"
      RSA_TO_BYTES -> external {
        value : [number]!
        size : number
      }
        @description "Internal: encode limbs to modulus-length bytes."
        @tier "internal"
    }

    listens {
      RSA_VERIFY {
        n : bytes!
        e : bytes!
        message : string!
        signature : bytes!
      }
        @description "Verify an RS256 signature: modulus, exponent and signature as base64 bytes, message as text."
        @synonyms "verify rsa, check rs256"
      BIG_DECODED { value : [number]! }
        @description "Internal: std-bigint answered."
      RsaBigInt.FROM_BYTES_ANSWERED -> BIG_DECODED
      BIG_COMPARED { value : number! }
        @description "Internal: std-bigint answered."
      RsaBigInt.COMPARE_ANSWERED -> BIG_COMPARED
      BIG_POWERED { value : [number]! }
        @description "Internal: std-bigint answered."
      RsaBigInt.MODPOW_ANSWERED -> BIG_POWERED
      BIG_ENCODED { value : bytes! }
        @description "Internal: std-bigint answered."
      RsaBigInt.TO_BYTES_ANSWERED -> BIG_ENCODED
      RsaBigInt.BIGINT_REFUSED -> BIG_REFUSED
    }
  }

  page boot as RsaOrbitalStart -> RsaVerifier, RsaBigInt
}
