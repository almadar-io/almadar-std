app std-http-dispatch [
  version: "1.0.0",
  description: "std-http-dispatch — the dispatch routes of the HTTP server program that replace orbital-server's events, inputs and hooks routes, bound to spec/net/server-dispatch.lolo. It listens to REQUEST_RECEIVED from std-http1 for paths under dispatchPrefix and hooksPrefix and answers RESPOND { requestId, status, headers, body }; set std-http-router's externalPrefix to dispatchPrefix so the router counts such a request and leaves it here. Routes: POST orbitals/:orbital/events and POST orbitals/:orbital/traits/:trait/entities/:id/events dispatch an EventRequest { event, targetTrait?, entityId?, payload?, clientId?, locale?, traits?, mount?, delivery?, dispatchLog? } through program/dispatch with the option wire: true, which asks the host for the EventResponse itself (success, transitioned, states, emittedEvents, clientEffects, rejections, guardFailed, ...) instead of the model outcome; the body of the answer IS that wire, 200, except a rejection not-an-external-input or inbound-only-event, which is 403 with the same body. A failed dispatch answers { error, code } with 404 ORBITAL_NOT_FOUND, 400 LOCALE_NOT_DECLARED or NO_TRAIT, else 500 EVENT_PROCESSING_ERROR. A request naming no trait (discovery), a traits list (declared) or a mount list is the host's to resolve: the atom passes targetTrait, entityId, traits, mount, clientId and locale as options and does not guess. POST orbitals/:orbital/inputs dispatches only a declared external input (the host refuses the rest as not-an-external-input, 403) and GET orbitals/inputs answers 200 { success: true, inputs } from program/inputs. ?stream=true or an Accept of text/event-stream answers the same dispatch as server-sent events through std-sse: one frame { type: event, data, timestamp } per emitted event, one { type: effect, data, timestamp } per client effect, then { type: complete, data: the response, timestamp }, and { type: error, data: { message } } on failure. With requireSignIn on, every dispatch route needs a verified bearer (BEARER_VERIFY, answered by std-bearer-verify): a refused or anonymous one is 401 { error: Unauthorized, code: UNAUTHORIZED }; the verified viewer is passed to the dispatch as the viewer option. POST hooks/:name emits HOOK_DELIVERED { name, headers, body } outside the guard; no operator delivers an inbound hook yet, so it answers 501 NOT_IMPLEMENTED. POST orbitals/resolve-rows emits RESOLVE_ROWS_REQUESTED and answers 501 NOT_IMPLEMENTED until a rows-resolve operator exists. Any other path under dispatchPrefix is 404 { error, code: NOT_FOUND }. Requests are told apart by requestId, so any number are in flight at once."
]
uses Spec from "almadar-std/server-dispatch"
type DispatchHeader = { name : string!, value : string! }
type DispatchJson = string | number | boolean | [DispatchJson] | Map string DispatchJson
type DispatchBody = { event : string, targetTrait : string, entityId : string, payload : DispatchJson, clientId : string, locale : string, traits : [DispatchJson], mount : [DispatchJson], delivery : DispatchJson, dispatchLog : DispatchJson }
type DispatchRejection = { code : string, trait : string, event : string, error : string }
type DispatchWire = { success : boolean, transitioned : boolean, states : Map string string, emittedEvents : [DispatchJson], clientEffects : [DispatchJson], rejections : [DispatchRejection], guardFailed : string, error : string }
type DispatchInputs = { inputs : [DispatchJson] }
type DispatchOptions = { wire : boolean!, input : boolean!, orbital : string!, targetTrait : string!, entityId : string!, event : string!, traits : [DispatchJson], mount : [DispatchJson], clientId : string, locale : string, delivery : DispatchJson, dispatchLog : DispatchJson, viewer : Viewer }
type DispatchPending = { requestId : number!, kind : string!, orbital : string!, traitName : string!, entityId : string!, stream : boolean!, authorization : string!, body : bytes!, hookName : string!, responseHeaders : [DispatchHeader]!, viewer : Viewer }
type ServerErrorBody = { error : string!, code : string! }
type DispatchFrames = { requestId : number!, frames : [string]! }

orbital HttpDispatchOrbital {
  entity HttpServerProgram [runtime] {
    id : string!
  }

  entity DispatchRun [runtime] {
    id : string!
    pending : [DispatchPending] @description "Dispatch requests received and not yet answered, each with its route and the viewer it runs as." = []
    inflight : number @description "The request id whose program/dispatch or program/inputs is in flight; 0 when none. The host answers carry no key, so one runs at a time." = 0
    waiting : [number] @description "Request ids admitted while one was in flight, oldest first." = []
    frames : [DispatchFrames] @description "Server-sent frames still to write, per streamed request, oldest first." = []
  }

  trait ServerDispatch -> DispatchRun [integration, instance] {
    initial: serving

    config {
      apiPrefix : string = "/api"
        @label "API prefix"
        @description "The prefix every route path starts with."
        @tier "infra"
      dispatchPrefix : string = "/api/orbitals"
        @label "Dispatch prefix"
        @description "A path starting with this is a dispatch route, guarded by requireSignIn; the router's externalPrefix names the same prefix."
        @tier "infra"
      hooksPrefix : string = "/api/hooks/"
        @label "Hooks prefix"
        @description "A path starting with this is an inbound hook, outside the bearer guard."
        @tier "infra"
      traceSteps : number = 200
        @label "Trace steps"
        @description "How many of the host's most recent dispatch steps GET /api/trace answers; the host keeps 200."
        @tier "infra"
      requireSignIn : boolean = false
        @label "Require sign-in"
        @description "When on, a dispatch route needs a verified bearer (401 UNAUTHORIZED otherwise); hooks are outside the guard."
        @tier "infra"
    }

    state serving {
      INIT -> serving

      REQUEST_RECEIVED -> serving when (or (str/startsWith @payload.path @config.dispatchPrefix) (str/startsWith @payload.path @config.hooksPrefix) (= @payload.path (str/concat @config.apiPrefix "/trace")))
        (let ((parts (str/split (str/slice @payload.path (str/len @config.apiPrefix)) "/")))
          (let ((n (array/len @parts)) (m (str/upper @payload.method)))
            (let ((kind (if (and (= @m "POST") (= @n 4) (= (array/nth @parts 1) "orbitals") (= (array/nth @parts 3) "events")) "events" (if (and (= @m "POST") (= @n 8) (= (array/nth @parts 1) "orbitals") (= (array/nth @parts 3) "traits") (= (array/nth @parts 5) "entities") (= (array/nth @parts 7) "events")) "entity-events" (if (and (= @m "POST") (= @n 4) (= (array/nth @parts 1) "orbitals") (= (array/nth @parts 3) "inputs")) "inputs" (if (and (= @m "GET") (= @n 3) (= (array/nth @parts 1) "orbitals") (= (array/nth @parts 2) "inputs")) "inputs-list" (if (and (= @m "POST") (= @n 3) (= (array/nth @parts 1) "orbitals") (= (array/nth @parts 2) "resolve-rows")) "resolve-rows" (if (and (= @m "POST") (= @n 3) (= (array/nth @parts 1) "hooks")) "hook" (if (and (= @m "GET") (= @n 2) (= (array/nth @parts 1) "trace")) "trace" "none"))))))))  )
              (do
                (set @entity.pending (array/append @entity.pending { requestId: @payload.requestId, kind: @kind, orbital: (if (and (>= @n 3) (or (= @kind "events") (= @kind "entity-events") (= @kind "inputs"))) (array/nth @parts 2) ""), traitName: (if (= @kind "entity-events") (array/nth @parts 4) ""), entityId: (if (= @kind "entity-events") (array/nth @parts 6) ""), stream: (or (str/includes (or @payload.query "") "stream=true") (str/includes (or (object/get @payload.headers "accept") "") "text/event-stream")), authorization: (or (object/get @payload.headers "authorization") ""), body: (or @payload.body (bytes/from-string "")), hookName: (if (= @kind "hook") (array/nth @parts 2) ""), responseHeaders: [] }))
))))
      ROUTE_EXTERNAL -> serving when (array/some @entity.pending (fn p (= @p.requestId @payload.requestId)))
        (set @entity.pending (array/map @entity.pending (fn p (if (= @p.requestId @payload.requestId) (object/merge @p { responseHeaders: @payload.responseHeaders }) @p))))
        (emit ROUTE_DISPATCH { requestId: @payload.requestId, kind: (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind") })

      REQUEST_ANSWERED -> serving when (array/some @entity.pending (fn p (= @p.requestId @payload.requestId)))
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      ROUTE_DISPATCH -> serving when (= @payload.kind "none")
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      ROUTE_DISPATCH -> serving when (= @payload.kind "hook")
        (let ((p (array/find @entity.pending (fn q (= @q.requestId @payload.requestId)))))
          (emit HOOK_DELIVERED { requestId: @payload.requestId, name: (object/get @p "hookName"), headers: [], body: (object/get @p "body") }))
        (emit RESPOND { requestId: @payload.requestId, status: 501, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "No operator delivers an inbound hook yet", code: "NOT_IMPLEMENTED" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      ROUTE_DISPATCH -> serving when (and (!= @payload.kind "none") (!= @payload.kind "hook") @config.requireSignIn)
        (emit BEARER_VERIFY { requestId: @payload.requestId, authorization: (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "authorization") })

      ROUTE_DISPATCH -> serving when (and (!= @payload.kind "none") (!= @payload.kind "hook") (not @config.requireSignIn))
        (emit DISPATCH_ADMITTED { requestId: @payload.requestId })

      BEARER_VERIFIED -> serving when (array/some @entity.pending (fn p (= @p.requestId (or @payload.requestId 0))))
        (set @entity.pending (array/map @entity.pending (fn p (if (= @p.requestId @payload.requestId) (object/merge @p { viewer: @payload.viewer }) @p))))
        (emit DISPATCH_ADMITTED { requestId: @payload.requestId })

      BEARER_ANONYMOUS -> serving when (array/some @entity.pending (fn p (= @p.requestId (or @payload.requestId 0))))
        (emit REQUEST_UNAUTHORIZED { requestId: @payload.requestId, error: { error: "Unauthorized", code: "UNAUTHORIZED" } })
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      BEARER_REFUSED -> serving when (array/some @entity.pending (fn p (= @p.requestId (or @payload.requestId 0))))
        (emit REQUEST_UNAUTHORIZED { requestId: @payload.requestId, error: { error: "Unauthorized", code: "UNAUTHORIZED" } })
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      DISPATCH_ADMITTED -> serving when (let ((p (array/find @entity.pending (fn q (= @q.requestId @payload.requestId))))) (and (or (= (object/get @p "kind") "events") (= (object/get @p "kind") "entity-events") (= (object/get @p "kind") "inputs")) (not (json/valid (bytes/to-string (object/get @p "body"))))))
        (emit RESPOND { requestId: @payload.requestId, status: 400, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "text/plain; charset=utf-8" }), body: (bytes/from-string "Failed to parse the request body as JSON") })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      DISPATCH_ADMITTED -> serving when (let ((p (array/find @entity.pending (fn q (= @q.requestId @payload.requestId))))) (or (= (object/get @p "kind") "inputs-list") (= (object/get @p "kind") "trace") (and (or (= (object/get @p "kind") "events") (= (object/get @p "kind") "entity-events") (= (object/get @p "kind") "inputs")) (json/valid (bytes/to-string (object/get @p "body"))))))
        (emit DISPATCH_QUEUED { requestId: @payload.requestId })

      DISPATCH_QUEUED -> serving when (and (!= @entity.inflight 0) (let ((k (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind"))) (or (= @k "events") (= @k "entity-events") (= @k "inputs") (= @k "inputs-list") (= @k "trace"))))
        (set @entity.waiting (array/append @entity.waiting @payload.requestId))
      DISPATCH_QUEUED -> serving when (and (= @entity.inflight 0) (let ((k (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind"))) (or (= @k "events") (= @k "entity-events") (= @k "inputs") (= @k "inputs-list") (= @k "trace"))))
        (set @entity.inflight @payload.requestId)
        (emit DISPATCH_RUN { requestId: @payload.requestId })

      DISPATCH_RUN -> serving when (let ((k (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind"))) (or (= @k "events") (= @k "entity-events") (= @k "inputs")))
        (let ((p (array/find @entity.pending (fn q (= @q.requestId @payload.requestId)))))
          (let ((b (json/parse (bytes/to-string (object/get @p "body")) DispatchBody)))
            (let ((tr (if (= (object/get @p "kind") "entity-events") (object/get @p "traitName") (object/get @b "targetTrait" "")))
                  (eid (if (= (object/get @p "kind") "entity-events") (object/get @p "entityId") (object/get @b "entityId" ""))))
              (emit DISPATCH_PREPARED {
                requestId: @payload.requestId,
                address: (str/concat (object/get @p "orbital") "." @tr "." (object/get @b "event" "")),
                arguments: (object/get @b "payload" {}),
                options: {
                  wire: true,
                  input: (= (object/get @p "kind") "inputs"),
                  orbital: (object/get @p "orbital"),
                  targetTrait: @tr,
                  entityId: @eid,
                  event: (object/get @b "event" ""),
                  traits: (object/get @b "traits" []),
                  mount: (object/get @b "mount" []),
                  clientId: (object/get @b "clientId" ""),
                  locale: (object/get @b "locale" ""),
                  delivery: (object/get @b "delivery" {}),
                  dispatchLog: (object/get @b "dispatchLog" {}),
                  viewer: (object/get @p "viewer" {})
                }
              }))))

      DISPATCH_PREPARED -> serving when (not @payload.options.input)
        (emit DISPATCH_REQUESTED { requestId: @payload.requestId, orbital: @payload.options.orbital, traitName: @payload.options.targetTrait, entityId: @payload.options.entityId, event: @payload.options.event, clientId: @payload.options.clientId, locale: @payload.options.locale, stream: (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "stream"), viewer: @payload.options.viewer })
        (program/dispatch @payload.address @payload.arguments @payload.options { emit: { success: DISPATCH_ANSWERED, failure: DISPATCH_FAILED } })
      DISPATCH_PREPARED -> serving when @payload.options.input
        (emit INPUT_REQUESTED { requestId: @payload.requestId, orbital: @payload.options.orbital, traitName: @payload.options.targetTrait, entityId: @payload.options.entityId, event: @payload.options.event, stream: (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "stream"), viewer: @payload.options.viewer })
        (program/dispatch @payload.address @payload.arguments @payload.options { emit: { success: DISPATCH_ANSWERED, failure: DISPATCH_FAILED } })

      DISPATCH_RUN -> serving when (= (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind") "inputs-list")
        (program/inputs {} { emit: { success: INPUTS_ANSWERED, failure: DISPATCH_FAILED } })

      DISPATCH_RUN -> serving when (= (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind") "trace")
        (program/inputs { trace: @config.traceSteps } { emit: { success: TRACE_ANSWERED, failure: DISPATCH_FAILED } })

      DISPATCH_ADMITTED -> serving when (= (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "kind") "resolve-rows")
        (emit RESOLVE_ROWS_REQUESTED { requestId: @payload.requestId, reference: "" })
        (emit RESPOND { requestId: @payload.requestId, status: 501, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "No operator resolves a row set yet", code: "NOT_IMPLEMENTED" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))

      TRACE_ANSWERED -> serving
        (emit RESPOND { requestId: @entity.inflight, status: 200, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @entity.inflight))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify @payload.result)) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})

      INPUTS_ANSWERED -> serving
        (emit RESPOND { requestId: @entity.inflight, status: 200, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @entity.inflight))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { success: true, inputs: @payload.result.inputs })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})

      DISPATCH_ANSWERED -> serving when (not (object/get (array/find @entity.pending (fn q (= @q.requestId @entity.inflight))) "stream"))
        (emit RESPOND { requestId: @entity.inflight, status: (if (array/some @payload.result.rejections (fn r (or (= @r.code "not-an-external-input") (= @r.code "inbound-only-event")))) 403 200), headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @entity.inflight))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify @payload.result)) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})

      DISPATCH_ANSWERED -> serving when (object/get (array/find @entity.pending (fn q (= @q.requestId @entity.inflight))) "stream")
        (set @entity.frames (array/append @entity.frames { requestId: @entity.inflight, frames: (array/concat (array/map @payload.result.emittedEvents (fn e (json/stringify { type: "event", data: @e, timestamp: @now }))) (array/map @payload.result.clientEffects (fn e (json/stringify { type: "effect", data: @e, timestamp: @now }))) [(json/stringify { type: "complete", data: @payload.result, timestamp: @now })]) }))
        (emit SSE_OPEN { requestId: @entity.inflight })
        (emit FRAME_NEXT { requestId: @entity.inflight })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})

      FRAME_NEXT -> serving when (let ((f (array/find @entity.frames (fn q (= @q.requestId @payload.requestId))))) (and (!= @f null) (> (array/len (object/get @f "frames")) 0)))
        (emit SSE_SEND { requestId: @payload.requestId, data: (array/first (object/get (array/find @entity.frames (fn q (= @q.requestId @payload.requestId))) "frames")) })
        (set @entity.frames (array/map @entity.frames (fn q (if (= @q.requestId @payload.requestId) { requestId: @q.requestId, frames: (array/drop @q.frames 1) } @q))))
        (emit FRAME_NEXT { requestId: @payload.requestId })
      FRAME_NEXT -> serving when (let ((f (array/find @entity.frames (fn q (= @q.requestId @payload.requestId))))) (and (!= @f null) (= (array/len (object/get @f "frames")) 0)))
        (emit SSE_CLOSE { requestId: @payload.requestId })
        (set @entity.frames (array/filter @entity.frames (fn q (!= @q.requestId @payload.requestId))))

      DISPATCH_FAILED -> serving when (not (object/get (array/find @entity.pending (fn q (= @q.requestId @entity.inflight))) "stream"))
        (emit RESPOND { requestId: @entity.inflight, status: 500, headers: (array/append (object/get (array/find @entity.pending (fn p (= @p.requestId @entity.inflight))) "responseHeaders") { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: @payload.error, code: "EVENT_PROCESSING_ERROR" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})
      DISPATCH_FAILED -> serving when (object/get (array/find @entity.pending (fn q (= @q.requestId @entity.inflight))) "stream")
        (set @entity.frames (array/append @entity.frames { requestId: @entity.inflight, frames: [(json/stringify { type: "error", data: { message: @payload.error }, timestamp: @now })] }))
        (emit SSE_OPEN { requestId: @entity.inflight })
        (emit FRAME_NEXT { requestId: @entity.inflight })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @entity.inflight))))
        (emit DISPATCH_DONE {})

      DISPATCH_DONE -> serving when (= (array/len @entity.waiting) 0)
        (set @entity.inflight 0)
      DISPATCH_DONE -> serving when (> (array/len @entity.waiting) 0)
        (set @entity.inflight 0)
        (emit DISPATCH_QUEUED { requestId: (array/first @entity.waiting) })
        (set @entity.waiting (array/drop @entity.waiting 1))
    }

    emits {
      RESPOND -> external {
        requestId : number!
        status : number!
        headers : [DispatchHeader]!
        body : bytes!
      }
      SSE_OPEN -> external {
        requestId : number!
      }
      SSE_SEND -> external {
        requestId : number!
        data : string!
      }
      SSE_CLOSE -> external {
        requestId : number!
      }
      BEARER_VERIFY -> external {
        requestId : number!
        authorization : string
      }
      REQUEST_UNAUTHORIZED -> external {
        requestId : number!
        error : ServerErrorBody!
      }
      HOOK_DELIVERED -> external {
        requestId : number!
        name : string!
        headers : [DispatchHeader]
        body : bytes!
      }
      RESOLVE_ROWS_REQUESTED -> external {
        requestId : number!
        reference : string!
        viewer : Viewer
      }
      ROUTE_DISPATCH -> internal {
        requestId : number!
        kind : string!
      }
      DISPATCH_ADMITTED -> internal {
        requestId : number!
      }
      DISPATCH_QUEUED -> internal {
        requestId : number!
      }
      FRAME_NEXT -> internal {
        requestId : number!
      }
      DISPATCH_PREPARED -> internal {
        requestId : number!
        address : string!
        arguments : DispatchJson!
        options : DispatchOptions!
      }
      DISPATCH_ANSWERED -> internal {
        result : DispatchWire!
      }
      INPUTS_ANSWERED -> internal {
        result : DispatchInputs!
      }
      TRACE_ANSWERED -> internal {
        result : [DispatchJson]!
      }
      DISPATCH_FAILED -> internal {
        error : string!
      }
      DISPATCH_RUN -> internal {
        requestId : number!
      }
      DISPATCH_DONE -> internal {
      }
      DISPATCH_REQUESTED -> external {
        requestId : number!
        orbital : string!
        traitName : string
        entityId : string
        event : string!
        payload : string
        clientId : string
        locale : string
        stream : boolean!
        viewer : Viewer
      }
      INPUT_REQUESTED -> external {
        requestId : number!
        orbital : string!
        traitName : string!
        entityId : string
        event : string!
        payload : string
        stream : boolean!
        viewer : Viewer
      }
    }

    listens {
      ROUTE_EXTERNAL {
        requestId : number!
        responseHeaders : [DispatchHeader]!
      }
      REQUEST_ANSWERED {
        requestId : number!
        status : number!
        headers : [DispatchHeader]
        body : string!
      }
      REQUEST_RECEIVED {
        requestId : number!
        method : string!
        path : string!
        query : string
        headers : Map string string
        body : bytes
        peer : string
      }
      BEARER_VERIFIED {
        requestId : number
        viewer : Viewer!
      }
      BEARER_ANONYMOUS {
        requestId : number
      }
      BEARER_REFUSED {
        requestId : number
        reason : string!
      }
    }
  }

  page "/server" as HttpDispatchPage -> ServerDispatch
}
