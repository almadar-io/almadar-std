app std-stream-ticket [
  version: "2.0.0",
  description: "std-stream-ticket — single-use tickets for a live-event stream, whose client (an EventSource) sends no Authorization header. MINT_TICKET { clientId } mints a std-opaque-token: 32 bytes from the host CSPRNG in base64url is the ticket, and only its SHA-256 is stored, as the row id, with the issuing client and an expiry ttlMs from now (60000 by default); it answers TICKET_MINTED { ticket, expiresAt }. TAKE_TICKET { ticket } spends it (single use): the issuing client is answered once in TICKET_TAKEN { ticket, clientId }. A forged, expired or already spent ticket answers TICKET_REFUSED (unknown, expired or used); a failed draw or write answers seed or store. Requests that arrive while one is in flight wait in arrival order, up to maxQueue; one beyond it is refused busy. The viewer is a typed Viewer record: the @user fields id, email, name, role and permissions."
]
uses Spec from "almadar-std/stream-ticket"
uses Opaque from "std/behaviors/std-opaque-token"
type StreamTicketJob = { kind : "mint" | "take", requestId : number, ticket : string, clientId : string }
type StreamTicketField = { name : string!, value : string! }
orbital StreamTicketOrbital {
  type MINT_TICKET = Event { clientId : string!, requestId : number } "Mint one ticket for the client of the issuing request."
  type TAKE_TICKET = Event { ticket : string! } "Spend one ticket."

  entity StreamTicket [persistent: stream_tickets] {
    @read server "A ticket is found only by the hash of the ticket its holder presents, on the server."
    id : string! @description "SHA-256 (hex) of the ticket; the ticket itself is never stored."
    clientId : string! @description "The client session of the request that minted the ticket."
    expiresAt : instant! @description "When the ticket stops working."
  }

  entity StreamTicketRun [runtime] {
    id : string!
    ticket : string @description "The ticket being spent." = ""
    mintRequest : number @description "The caller's request id of the mint in flight, echoed on its answer; 0 when none." = 0
    queue : [StreamTicketJob] @description "Requests that arrived while one was in flight, oldest first; each is started when the one before it is answered." = []
  }

  trait StreamTicketer -> StreamTicketRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      TICKET_PUMP -> idle when (= (array/len @entity.queue) 0)
      TICKET_PUMP -> minting when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "kind") "mint"))
        (set @entity.mintRequest (object/get (array/first @entity.queue) "requestId" 0))
        (emit TICKET_TOKEN_MINT { key: "stream-ticket", fields: [{ name: "clientId", value: (object/get (array/first @entity.queue) "clientId" "") }], ttlMs: @config.ttlMs })
        (set @entity.queue (array/slice @entity.queue 1))
      TICKET_PUMP -> taking when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "kind") "take"))
        (set @entity.ticket (object/get (array/first @entity.queue) "ticket" ""))
        (emit TICKET_TOKEN_TAKE { key: "stream-ticket", token: (object/get (array/first @entity.queue) "ticket" "") })
        (set @entity.queue (array/slice @entity.queue 1))
      MINT_TICKET -> idle when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "mint", requestId: (default @payload.requestId 0), ticket: "", clientId: @payload.clientId }))
        (emit TICKET_PUMP {})
      MINT_TICKET -> idle when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", requestId: (default @payload.requestId 0) })
      TAKE_TICKET -> idle when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "take", requestId: 0, ticket: @payload.ticket, clientId: "" }))
        (emit TICKET_PUMP {})
      TAKE_TICKET -> idle when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", ticket: @payload.ticket })
    }

    state minting {
      INIT -> idle
      MINT_TICKET -> minting when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "mint", requestId: (default @payload.requestId 0), ticket: "", clientId: @payload.clientId }))
      MINT_TICKET -> minting when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", requestId: (default @payload.requestId 0) })
      TAKE_TICKET -> minting when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "take", requestId: 0, ticket: @payload.ticket, clientId: "" }))
      TAKE_TICKET -> minting when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", ticket: @payload.ticket })

      ;; Every ticket is minted with a lifetime; an answer with no expiry is refused, never defaulted.
      TOKEN_MINTED -> idle when (= ?expiresAt null)
        (emit TICKET_REFUSED { code: "store", message: "the minted ticket has no expiry", requestId: @entity.mintRequest })
        (emit TICKET_PUMP {})
      TOKEN_MINTED -> idle
        (emit TICKET_MINTED { ticket: ?token, expiresAt: ?expiresAt, requestId: @entity.mintRequest })
        (emit TICKET_PUMP {})
      TOKEN_REFUSED -> idle
        (emit TICKET_REFUSED { code: ?code, message: ?message, requestId: @entity.mintRequest })
        (emit TICKET_PUMP {})
    }

    state taking {
      INIT -> idle
      MINT_TICKET -> taking when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "mint", requestId: (default @payload.requestId 0), ticket: "", clientId: @payload.clientId }))
      MINT_TICKET -> taking when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", requestId: (default @payload.requestId 0) })
      TAKE_TICKET -> taking when (< (array/len @entity.queue) @config.maxQueue)
        (set @entity.queue (array/append @entity.queue { kind: "take", requestId: 0, ticket: @payload.ticket, clientId: "" }))
      TAKE_TICKET -> taking when (>= (array/len @entity.queue) @config.maxQueue)
        (emit TICKET_REFUSED { code: "busy", message: "the stream ticket queue is full", ticket: @payload.ticket })

      ;; The holder is read off the spent ticket's row; an absent one is refused, never defaulted.
      TOKEN_RESOLVED -> idle when (= (default ?row.clientId "") "")
        (emit TICKET_REFUSED { code: "unknown", message: "the stream ticket names no client", ticket: @entity.ticket })
        (emit TICKET_PUMP {})
      TOKEN_RESOLVED -> idle
        (emit TICKET_TAKEN { ticket: @entity.ticket, clientId: ?row.clientId })
        (emit TICKET_PUMP {})
      TOKEN_REFUSED -> idle
        (emit TICKET_REFUSED { code: ?code, message: ?message, ticket: @entity.ticket })
        (emit TICKET_PUMP {})
    }

    emits {
      TICKET_MINTED -> external {
        ticket : string!
        expiresAt : instant!
        requestId : number
      }
        @description "A ticket was minted and stored; hand it to the stream client once."
        @synonyms "stream ticket minted, ticket created"
        @tier "primary"
      TICKET_TAKEN -> external {
        ticket : string!
        clientId : string!
      }
        @description "The ticket named the client that issued it, and is now spent."
        @synonyms "stream ticket spent, ticket redeemed"
        @tier "primary"
      TICKET_REFUSED -> external {
        code : "seed" | "store" | "unknown" | "expired" | "used" | "busy"
        message : string!
        ticket : string
        requestId : number
      }
        @description "No ticket was minted, or the one presented names nobody: forged or never minted (unknown), past its expiry (expired), already spent (used), or the draw or store failed. A refused spend carries the presented ticket, so the caller can tell which presentation was refused."
        @synonyms "stream ticket refused, ticket rejected"
        @tier "primary"
      TICKET_TOKEN_MINT -> external {
        key : string!
        fields : [StreamTicketField]!
        ttlMs : number!
      }
        @description "Internal: asks the ticket store to mint one ticket."
        @tier "secondary"
      TICKET_TOKEN_TAKE -> external {
        key : string!
        token : string!
      }
        @description "Internal: asks the ticket store to spend one ticket."
        @tier "secondary"
      TICKET_PUMP {}
        @description "Internal: start the oldest queued request."
        @tier "secondary"
    }

    listens {
      MINT_TICKET {
        clientId : string!
        requestId : number
      }
        @description "Mint one stream ticket for the issuing request's client."
        @synonyms "mint ticket, create stream ticket"
      TAKE_TICKET {
        ticket : string!
      }
        @description "Spend one stream ticket and learn the client that issued it."
        @synonyms "take ticket, redeem ticket"
      TOKEN_MINTED {
        key : string!
        token : string!
        id : string!
        expiresAt : instant
      }
        @tier "secondary"
      TOKEN_RESOLVED {
        key : string!
        id : string!
        row : StreamTicket
      }
        @tier "secondary"
      TOKEN_REFUSED {
        key : string!
        code : "seed" | "store" | "unknown" | "expired" | "used" | "busy"
        message : string!
        token : string
      }
        @tier "secondary"
      TicketMint.TOKEN_MINTED -> TOKEN_MINTED
      TicketMint.TOKEN_REFUSED -> TOKEN_REFUSED
      TicketTake.TOKEN_RESOLVED -> TOKEN_RESOLVED
      TicketTake.TOKEN_REFUSED -> TOKEN_REFUSED
    }

    config {
      maxQueue : number = 256
        @label "Queue bound"
        @description "How many requests may wait behind the one in flight; one beyond it is refused with `busy`."
        @synonyms "queue limit, backlog"
        @tier "domain"
      ttlMs : number = 60000
        @label "Ticket lifetime"
        @description "How long a minted ticket stays valid, in milliseconds."
        @synonyms "ticket ttl, expiry"
        @tier "domain"
    }
  }

  trait TicketMint = Opaque.traits.OpaqueTokenMint {
    config {
      tokenEntity: StreamTicket
      expiresAtField: expiresAt
    }
    listens {
      MINT_TOKEN {
        key : string
        fields : [StreamTicketField]!
        ttlMs : number
      }
      StreamTicketer.TICKET_TOKEN_MINT -> MINT_TOKEN
      TOKEN_DRAWN {
        value : string!
      }
      TOKEN_DRAW_FAILED {
        error : string!
      }
      TOKEN_SAVED {
        id : string!
      }
      TOKEN_NOT_SAVED {
        error : string!
        code : string
      }
    }
  }

  trait TicketTake = Opaque.traits.OpaqueTokenResolve {
    config {
      tokenEntity: StreamTicket
      expiresAtField: expiresAt
      singleUse: true
    }
    listens {
      RESOLVE_TOKEN {
        key : string
        token : string!
      }
      StreamTicketer.TICKET_TOKEN_TAKE -> RESOLVE_TOKEN
      TOKEN_ROW_FOUND {
        data : StreamTicket!
      }
      TOKEN_ROW_ABSENT {
        error : string
        code : string
      }
      TOKEN_SPENT {
        id : string!
        expiresAt : instant
      }
      TOKEN_ROW_CLAIMED {
        data : StreamTicket!
      }
      TOKEN_NOT_SPENT {
        error : string
        code : string
      }
    }
  }

  page boot as StreamTicketStart -> StreamTicketer, TicketMint, TicketTake
}
