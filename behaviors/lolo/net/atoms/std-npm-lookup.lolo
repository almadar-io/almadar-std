app std-npm-lookup [
  version: "1.0.0",
  description: "std-npm-lookup — a read-only client of an npm-protocol registry (public npm or GitHub Packages; the origin is the registry knob and the bearer token is the token credential, both from config). GET only, never a write. One ask at a time; an ask during another answers NPM_LOOKUP_REFUSED npm_busy. NPM_LOOKUP { requestId, name, tag } reads the packument and answers NPM_LOOKED { requestId, name, versions (semver ascending), distTags, version } where version is the dist-tag tag points to (latest when tag is empty), empty when the package has no such tag, and tarballs maps each version to its tarball url, empty when the packument gives none or the url sits outside the registry origin; whether a version exists is its membership in versions. A reply is classified in NPM_LOOKUP_REFUSED.code: 401 and 403 are auth, 404 absent, 5xx unreachable, any other status unexpected; a transport failure is unreachable, an unset credential unconfigured.",
  egress: ["https://registry.npmjs.org", "https://npm.pkg.github.com"]
]
uses Spec from "almadar-std/npm-lookup"
type LookupDist = { tarball : string? }
type LookupVersionDoc = { dist : LookupDist? }
type LookupPackument = { versions : Map string LookupVersionDoc?, dist-tags : Map string string? }

orbital NpmLookupOrbital {
  entity NpmLookupAsk [runtime] {
    id : string!
    requestId : string @description "The caller's name for the ask in flight." = ""
    name : string @description "The package the ask in flight is about." = ""
    tag : string @description "The dist-tag whose version the ask wants; latest when empty." = ""
  }

  trait NpmLookup -> NpmLookupAsk {
    initial: idle

    state idle {
      INIT -> idle
      NPM_LOOKUP -> looking
        (set @entity.requestId @payload.requestId)
        (set @entity.name @payload.name)
        (set @entity.tag (str/default @payload.tag "latest"))
        (emit NPM_LOOKUP_GET { requestId: @payload.requestId })
    }

    state looking {
      INIT -> idle
      NPM_LOOKUP -> looking
        (emit NPM_LOOKUP_REFUSED { requestId: @payload.requestId, name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })
      NPM_LOOKUP_GET -> looking when (not @config.authenticated)
        (http GET @config.registry (str/concat "/" (str/slice @entity.name 0 1) (str/encode-uri-component (str/slice @entity.name 1 (str/len @entity.name)))) {
          headers: { Accept: "application/json" },
          timeoutMs: @config.timeoutMs
        } { key: "lookup", emit: { success: NPM_LOOKUP_PACKUMENT, failure: NPM_LOOKUP_UNREACHABLE } })
      NPM_LOOKUP_GET -> looking when @config.authenticated
        (http GET @config.registry (str/concat "/" (str/slice @entity.name 0 1) (str/encode-uri-component (str/slice @entity.name 1 (str/len @entity.name)))) {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.token },
          timeoutMs: @config.timeoutMs
        } { key: "lookup", emit: { success: NPM_LOOKUP_PACKUMENT, failure: NPM_LOOKUP_UNREACHABLE } })
      NPM_LOOKUP_PACKUMENT -> idle when (= @payload.status 200)
        (emit NPM_LOOKED { requestId: @entity.requestId, name: @entity.name, versions: (array/map (array/sort (array/map (object/keys (object/get (json/parse @payload.body LookupPackument) "versions" {})) (fn v { version: @v, key: (+ (* 1000000000000 (str/to-number (array/nth (str/split @v ".") 0))) (* 1000000 (str/to-number (array/nth (str/split @v ".") 1))) (str/to-number (array/nth (str/split (str/replace-pattern @v "-.*$" "") ".") 2))) })) "key" "asc") (fn r @r.version)), distTags: (object/get (json/parse @payload.body LookupPackument) "dist-tags" {}), tarballs: (object/mapValues (object/get (json/parse @payload.body LookupPackument) "versions" {}) (fn d (let ((u (object/get (object/get @d "dist" {}) "tarball" ""))) (if (str/startsWith @u @config.registry) @u "")))), version: (object/get (object/get (json/parse @payload.body LookupPackument) "dist-tags" {}) @entity.tag "") })
      NPM_LOOKUP_PACKUMENT -> idle when (!= @payload.status 200)
        (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: (if (or (= @payload.status 401) (= @payload.status 403)) "auth" (if (= @payload.status 404) "absent" (if (>= @payload.status 500) "unreachable" "unexpected"))), status: @payload.status, error: (str/concat "the registry answered " @payload.status " for " @entity.name) })
      NPM_LOOKUP_UNREACHABLE -> idle
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "The registry could not be reached: " @payload.error) })
        (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: (if (= @payload.kind "unconfigured") "unconfigured" "unreachable"), status: 0, error: @payload.error })
    }

    emits {
      NPM_LOOKED -> external { requestId : string!  name : string!  versions : [string]!  distTags : Map string string  version : string!  tarballs : Map string string }
        @description "The package's published versions, semver ascending, its dist-tags, the version the asked tag points to, and each version's tarball url."
        @synonyms "versions list, published versions, dist-tags, latest version, version exists"
        @tier "primary"
      NPM_LOOKUP_REFUSED -> external { requestId : string!  name : string  code : string!  status : number!  error : string! }
        @description "The lookup failed: code is auth, absent, unreachable, unexpected, unconfigured or npm_busy."
        @synonyms "registry failed, 401, unauthorized, not found"
        @tier "primary"
      NPM_LOOKUP_GET { requestId : string! }
        @description "Internal: read the packument of the package in flight."
        @tier "internal"
      NPM_LOOKUP_PACKUMENT { status : number!  headers : Map string string  body : string!  key : string }
        @description "Internal: a packument reply."
        @tier "internal"
      NPM_LOOKUP_UNREACHABLE { error : string!  kind : string! }
        @description "Internal: a packument call never produced a reply."
        @tier "internal"
    }

    listens {
      NPM_LOOKUP { requestId : string!  name : string!  tag : string }
        @description "Read the package's published versions and dist-tags."
        @synonyms "npm view, list versions, dist-tags, latest version, version exists"
    }

    config {
      registry : url = "https://registry.npmjs.org"
        @label "Registry origin"
        @description "The registry origin (scheme://host, no trailing slash); declared in egress. https://npm.pkg.github.com for GitHub Packages."
        @synonyms "npm registry, github packages"
        @tier "infra"
      authenticated : boolean = false
        @label "Send the token"
        @description "Send the token credential as a bearer on every read; off for public npm."
        @synonyms "private registry, auth"
        @tier "infra"
      token : secret = "NPM_REGISTRY_TOKEN"
        @label "Registry token"
        @description "Name of the credential holding the registry's bearer token (a GitHub token with read:packages for GitHub Packages)."
        @synonyms "npm token, github token"
        @tier "infra"
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports a registry read that failed to reach the registry; a page running it in the background keeps it in `system`."
        @synonyms "status area, slot"
        @tier "presentation"
      timeoutMs : number = 20000
        @label "Request timeout (ms)"
        @description "Milliseconds one registry read may take."
        @synonyms "timeout"
        @tier "infra"
    }
  }

  page "/npm-lookup" as NpmLookupPage -> NpmLookup
}
