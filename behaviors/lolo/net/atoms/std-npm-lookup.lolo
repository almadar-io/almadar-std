app std-npm-lookup [
  version: "1.0.0",
  description: "std-npm-lookup — a read-only client of an npm-protocol registry (public npm or GitHub Packages; the origin is the registry knob and the bearer token is the token credential, both from config). GET only, never a write. One ask at a time; an ask during another answers NPM_LOOKUP_REFUSED npm_busy. NPM_LOOKUP { requestId, name, tag } reads the packument and answers NPM_LOOKED { requestId, name, versions (semver ascending), distTags, version } where version is the dist-tag tag points to (latest when tag is empty), empty when the package has no such tag, and tarballs maps each version to its tarball url, empty when the packument gives none or the url sits outside the registry origin; whether a version exists is its membership in versions. A reply is classified in NPM_LOOKUP_REFUSED.code: 401 and 403 are auth, 404 absent, 5xx unreachable, any other status unexpected; a transport failure is unreachable, an unset credential unconfigured.",
  net: { "registry.npmjs.org:443": [tcp], "npm.pkg.github.com:443": [tcp], "*.npmjs.org:443": [tcp], "*.pkg.github.com:443": [tcp] }
]
uses Spec from "almadar-std/npm-lookup"
uses Http from "std/behaviors/std-http-client"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
type LookupDist = { tarball : string? }
type LookupVersionDoc = { dist : LookupDist? }
type LookupPackument = { versions : Map string LookupVersionDoc?, dist-tags : Map string string }

orbital NpmLookupOrbital {
  entity NpmLookupAsk [runtime] {
    id : string!
    requestId : string @description "The caller's name for the ask in flight." = ""
    name : string @description "The package the ask in flight is about." = ""
    tag : string @description "The dist-tag whose version the ask wants; latest when empty." = ""
  }

  trait LookupHttp = Http.traits.HttpClient {
    config {
      host: "registry.npmjs.org"
      port: 443
      tls: true
      serverName: "registry.npmjs.org"
      dynamicHost: true
      credential: "NPM_REGISTRY_TOKEN"
    }
    listens {
      NpmLookup.NPM_LOOKUP_HTTP_SEND -> HTTP_SEND
      LookupTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
    }
  }

  trait LookupTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 20000
      cancelOnDeadline: false
    }
    listens {
      NpmLookup.NPM_LOOKUP_HTTP_SEND -> START with { key: (as ?key CallKey) }
      LookupHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      LookupHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait NpmLookup -> NpmLookupAsk {
    initial: idle

    state idle {
      INIT -> idle
      NPM_LOOKUP -> looking
        (set @entity.requestId @payload.requestId)
        (set @entity.name @payload.name)
        (set @entity.tag (default @payload.tag "latest"))
        (emit NPM_LOOKUP_GET { requestId: @payload.requestId })
    }

    state looking {
      INIT -> idle
      NPM_LOOKUP -> looking
        (emit NPM_LOOKUP_REFUSED { requestId: @payload.requestId, name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })
      NPM_LOOKUP_GET -> idle when (not (str/startsWith @config.registry "https://"))
        (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: "unconfigured", status: 0, error: "the registry knob must be an https:// origin" })
      NPM_LOOKUP_GET -> looking when (str/startsWith @config.registry "https://")
        (emit NPM_LOOKUP_HTTP_SEND {
          key: "lookup",
          method: "GET",
          target: (str/concat "/" (str/slice @entity.name 0 1) (str/encode-uri-component (str/slice @entity.name 1 (str/len @entity.name)))),
          headers: [{ name: "accept", value: "application/json" }],
          body: (bytes/from-string ""),
          stream: "none",
          host: (str/slice @config.registry 8 (str/len @config.registry))
        })
      NPM_LOOKUP_PACKUMENT -> idle when (= @payload.status 200)
        (let ((doc (json/parse @payload.body LookupPackument)))
          (if (= @doc null)
            (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: "unexpected", status: @payload.status, error: (str/concat "the registry answered " @entity.name " with a packument that is not JSON") })
            (let ((rows (array/map (object/keys (object/get @doc "versions" {})) (fn v { version: @v, key: (let ((parts (str/split (str/replace-pattern @v "-.*$" "") "."))) (if (!= (array/len @parts) 3) null (let ((p0 (array/nth @parts 0)) (p1 (array/nth @parts 1)) (p2 (array/nth @parts 2))) (if (and (validate/required @p0) (and (validate/required @p1) (validate/required @p2))) (let ((major (str/to-number @p0)) (minor (str/to-number @p1)) (patch (str/to-number @p2))) (if (or (= @major null) (= @minor null) (= @patch null)) null (+ (* 1000000000000 @major) (* 1000000 @minor) @patch))) null)))) }))))
              (if (array/some @rows (fn r (= @r.key null)))
                (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: "unexpected", status: @payload.status, error: (str/concat "the registry listed a version of " @entity.name " that is not semver") })
                (emit NPM_LOOKED { requestId: @entity.requestId, name: @entity.name, versions: (array/map (array/sort @rows "key" "asc") (fn r @r.version)), distTags: (object/get @doc "dist-tags" {}), tarballs: (object/mapValues (object/get @doc "versions" {}) (fn d (if (validate/required @d) (let ((u (object/get (object/get @d "dist" {}) "tarball" ""))) (if (str/startsWith @u @config.registry) @u "")) ""))), version: (object/get (object/get @doc "dist-tags" {}) @entity.tag "") })))))
      NPM_LOOKUP_PACKUMENT -> idle when (!= @payload.status 200)
        (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: (if (or (= @payload.status 401) (= @payload.status 403)) "auth" (if (= @payload.status 404) "absent" (if (>= @payload.status 500) "unreachable" "unexpected"))), status: @payload.status, error: (str/concat "the registry answered " @payload.status " for " @entity.name) })
      NPM_LOOKUP_UNREACHABLE -> idle
        (emit NPM_LOOKUP_REFUSED { requestId: @entity.requestId, name: @entity.name, code: (if (= @payload.kind "denied") "unconfigured" "unreachable"), status: 0, error: @payload.error })
    }

    emits {
      NPM_LOOKED -> external { requestId : string!  name : string!  versions : [string]!  distTags : Map string string  version : string!  tarballs : Map string string }
        @description "The package's published versions, semver ascending, its dist-tags, the version the asked tag points to, and each version's tarball url."
        @synonyms "versions list, published versions, dist-tags, latest version, version exists"
        @tier "primary"
      NPM_LOOKUP_REFUSED -> external { requestId : string!  name : string  code : string!  status : number!  error : string! }
        @description "The lookup failed: code is auth, absent, unreachable, unexpected, unconfigured or npm_busy."
        @synonyms "registry failed, 401, unauthorized, not found"
        @tier "primary"
      NPM_LOOKUP_GET { requestId : string! }
        @description "Internal: read the packument of the package in flight."
        @tier "internal"
      NPM_LOOKUP_HTTP_SEND { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string!  host : string }
        @description "Internal: the registry read, for the HTTP client."
        @tier "internal"
    }

    listens {
      NPM_LOOKUP { requestId : string!  name : string!  tag : string }
        @description "Read the package's published versions and dist-tags."
        @synonyms "npm view, list versions, dist-tags, latest version, version exists"
      NPM_LOOKUP_PACKUMENT { status : number!  headers : Map string string  body : string! }
      NPM_LOOKUP_UNREACHABLE { error : string!  kind : string! }
      LookupHttp.HTTP_REPLIED -> NPM_LOOKUP_PACKUMENT with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "lookup")
      LookupHttp.HTTP_FAILED -> NPM_LOOKUP_UNREACHABLE with { error: ?error, kind: ?kind } when (= ?key "lookup")
      LookupTimeout.TIMED_OUT -> NPM_LOOKUP_UNREACHABLE with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "lookup")
    }

    config {
      registry : url = "https://registry.npmjs.org"
        @label "Registry origin"
        @description "The registry origin (https://host, no trailing slash); the host must be granted in net. https://npm.pkg.github.com for GitHub Packages, whose composer sets the LookupHttp credential."
        @synonyms "npm registry, github packages"
        @tier "infra"
    }
  }

  page boot as NpmLookupPage -> NpmLookup, LookupHttp, LookupTimeout
}
