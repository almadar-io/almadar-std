app std-npm-registry [
  version: "1.0.0",
  description: "std-npm-registry — a client of an npm-protocol registry (public npm or GitHub Packages; the origin is the registry knob and the bearer token is the token credential, both from config). One ask at a time; an ask during another answers NPM_FAILED npm_busy. NPM_VERSIONS { name } answers NPM_VERSIONS_LISTED { name, versions (semver ascending), tags (dist-tags) } from the packument. NPM_NEXT_VERSION { name, current, bump, major } answers NPM_NEXT { name, current, next, skipped }: current bumped by patch, minor or major (a minor on a 0.x version is demoted to patch unless major is true, which cuts a major), then incremented by patch past every version already published; a package the registry does not know has none published. NPM_WAIT { name, version } polls the packument under std-retry backoff (every pollIntervalMs, up to 80 attempts) until the version is listed and its tarball downloads (one ranged byte, 200 or 206), then answers NPM_VISIBLE { name, version, attempts }; the attempts spent answer NPM_WAIT_TIMEOUT. NPM_AUTH_PROBE { name } reads one package and answers NPM_AUTH_OK. A reply is classified in NPM_FAILED.code: 401 and 403 are auth (never retried, the poll is cancelled), 404 absent, 5xx unreachable, any other status unexpected; a transport failure is unreachable, an unset credential unconfigured. The tarball url must sit under the registry origin. The poll cadence is std-retry's constant schedule: a changed pollIntervalMs needs the composing realization to restate WaitRetry's config.",
  egress: ["https://registry.npmjs.org", "https://npm.pkg.github.com"]
]
uses Spec from "almadar-std/npm-registry"
type NpmStrMap = Map string string

orbital NpmRegistryOrbital {
  config {
    registry : url = "https://registry.npmjs.org"
      @label "Registry origin"
      @description "The registry origin (scheme://host, no trailing slash); declared in egress. https://npm.pkg.github.com for GitHub Packages."
      @synonyms "npm registry, github packages"
      @tier "infra"
    authenticated : boolean = false
      @label "Send the token"
      @description "Send the token credential as a bearer on every read; off for public npm."
      @synonyms "private registry, auth"
      @tier "infra"
    token : secret = "NPM_REGISTRY_TOKEN"
      @label "Registry token"
      @description "Name of the credential holding the registry's bearer token (a GitHub PAT with read:packages for GitHub Packages)."
      @synonyms "npm token, github token"
      @tier "infra"
    timeoutMs : number = 20000
      @label "Request timeout (ms)"
      @description "Milliseconds one registry read may take."
      @synonyms "timeout"
      @tier "infra"
  }

  uses Retry from "std/behaviors/std-retry"
  uses Lookup from "std/behaviors/std-npm-lookup"

  entity NpmRegistryAsk [runtime] {
    id : string!
    name : string @description "The package the ask in flight is about." = ""
    version : string @description "The version being waited for; empty otherwise." = ""
    bump : string @description "The bump a next-version ask applies: patch, minor or major." = ""
    major : boolean @description "Whether a next-version ask cuts a major regardless of bump." = false
    current : string @description "The version a next-version ask bumps from." = ""
    seq : number @description "Waits accepted so far; makes each retry key unique." = 0
  }

  trait WaitRetry = Retry.traits.Retry {
    listens {
      NpmRegistry.NPM_WAIT_RETRY_START -> START
      NpmRegistry.NPM_WAIT_RETRY_SUCCEEDED -> SUCCEEDED
      NpmRegistry.NPM_WAIT_RETRY_FAILED -> FAILED
      NpmRegistry.NPM_WAIT_RETRY_CANCEL -> CANCEL
    }
    config {
      maxAttempts: 80
      baseDelayMs: 15000
      multiplier: 1
      maxDelayMs: 15000
    }
  }

  trait PackumentLookup = Lookup.traits.NpmLookup {
    listens {
      NpmRegistry.NPM_LOOKUP_ASK -> NPM_LOOKUP
    }
    config {
      registry: @config.registry
      authenticated: @config.authenticated
      token: @config.token
      timeoutMs: @config.timeoutMs
    }
  }

  trait NpmRegistry -> NpmRegistryAsk {
    initial: idle

    state idle {
      INIT -> idle

      NPM_VERSIONS -> listing
        (set @entity.name @payload.name)
        (emit NPM_GET { kind: "versions" })
      NPM_AUTH_PROBE -> listing
        (set @entity.name @payload.name)
        (emit NPM_GET { kind: "probe" })
      NPM_NEXT_VERSION -> listing when (and (= (str/replace-pattern @payload.current "^[0-9]+\\.[0-9]+\\.[0-9]+$" "") "") (or (= @payload.bump "patch") (= @payload.bump "minor") (= @payload.bump "major")))
        (set @entity.name @payload.name)
        (set @entity.current @payload.current)
        (set @entity.bump @payload.bump)
        (set @entity.major (if @payload.major true false))
        (emit NPM_GET { kind: "next" })
      NPM_NEXT_VERSION -> idle when (not (and (= (str/replace-pattern @payload.current "^[0-9]+\\.[0-9]+\\.[0-9]+$" "") "") (or (= @payload.bump "patch") (= @payload.bump "minor") (= @payload.bump "major"))))
        (emit NPM_FAILED { name: @payload.name, code: "invalid_version", status: 0, error: (str/concat "cannot bump " @payload.current " by " @payload.bump) })
      NPM_WAIT -> waiting
                (set @entity.name @payload.name)
        (set @entity.version @payload.version)
        (set @entity.seq (+ @entity.seq 1))
        (emit NPM_WAIT_RETRY_START { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey) })
    }

    state listing {
      INIT -> idle
      NPM_VERSIONS -> listing
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })
      NPM_NEXT_VERSION -> listing
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })
      NPM_AUTH_PROBE -> listing
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })
      NPM_WAIT -> listing
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being asked about " @entity.name) })

      NPM_GET -> listing
        (emit NPM_LOOKUP_ASK { requestId: @payload.kind, name: @entity.name, tag: "latest" })

      NPM_PACKUMENT_READ -> idle when (= @payload.requestId "versions")
        (emit NPM_VERSIONS_LISTED { name: @entity.name, versions: @payload.versions, tags: @payload.distTags })
      NPM_PACKUMENT_READ -> idle when (= @payload.requestId "probe")
        (emit NPM_AUTH_OK { name: @entity.name })
      NPM_PACKUMENT_READ -> idle when (= @payload.requestId "next")
        (let ((published @payload.versions))
          (let ((cm (str/to-number (array/nth (str/split @entity.current ".") 0))) (cn (str/to-number (array/nth (str/split @entity.current ".") 1))) (cp (str/to-number (array/nth (str/split @entity.current ".") 2))))
            (let ((cut (if (or (= @entity.bump "major") @entity.major) "major" (if (and (= @entity.bump "minor") (= @cm 0)) "patch" @entity.bump))))
              (let ((bm (if (= @cut "major") (+ @cm 1) @cm)) (bn (if (= @cut "major") 0 (if (= @cut "minor") (+ @cn 1) @cn))) (bp (if (or (= @cut "major") (= @cut "minor")) 0 (+ @cp 1))))
                (let ((n (array/find (array/range 0 1000) (fn i (not (array/includes @published (str/concat @bm "." @bn "." (+ @bp @i))))))))
                  (emit NPM_NEXT { name: @entity.name, current: @entity.current, next: (str/concat @bm "." @bn "." (+ @bp @n)), skipped: (array/map (array/range 0 @n) (fn i (str/concat @bm "." @bn "." (+ @bp @i)))) }))))))
      NPM_PACKUMENT_REFUSED -> listing when (and (= @payload.requestId "next") (= @payload.code "absent"))
        (emit NPM_PACKUMENT_READ { requestId: "next", name: @entity.name, versions: [], distTags: (json/parse "{}" NpmStrMap), version: "", tarballs: (json/parse "{}" NpmStrMap) })
      NPM_PACKUMENT_REFUSED -> idle when (not (and (= @payload.requestId "next") (= @payload.code "absent")))
        (emit NPM_FAILED { name: @entity.name, code: @payload.code, status: @payload.status, error: @payload.error })
    }

    state waiting {
      INIT -> idle
      NPM_VERSIONS -> waiting
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being waited on for " @entity.name) })
      NPM_NEXT_VERSION -> waiting
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being waited on for " @entity.name) })
      NPM_AUTH_PROBE -> waiting
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being waited on for " @entity.name) })
      NPM_WAIT -> waiting
        (emit NPM_FAILED { name: @payload.name, code: "npm_busy", status: 0, error: (str/concat "the registry is being waited on for " @entity.name) })

      NPM_WAIT_ATTEMPT -> waiting
        (emit NPM_LOOKUP_ASK { requestId: "wait", name: @entity.name, tag: "latest" })

      NPM_PACKUMENT_READ -> waiting when (and (array/includes @payload.versions @entity.version) (!= (str/default (array/nth (object/values (object/pick @payload.tarballs [@entity.version])) 0) "") ""))
        (emit NPM_WAIT_TARBALL { url: (str/default (array/nth (object/values (object/pick @payload.tarballs [@entity.version])) 0) "") })
      NPM_PACKUMENT_READ -> waiting when (not (and (array/includes @payload.versions @entity.version) (!= (str/default (array/nth (object/values (object/pick @payload.tarballs [@entity.version])) 0) "") "")))
        (emit NPM_WAIT_RETRY_FAILED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey), error: (str/concat "not yet visible: " @entity.name (quote "@") @entity.version " (200)") })
      NPM_PACKUMENT_REFUSED -> idle when (= @payload.code "auth")
        (emit NPM_WAIT_RETRY_CANCEL { })
        (emit NPM_FAILED { name: @entity.name, code: "auth", status: @payload.status, error: (str/concat "the registry refused the token (" @payload.status ") for " @entity.name) })
      NPM_PACKUMENT_REFUSED -> idle when (= @payload.code "unconfigured")
        (emit NPM_WAIT_RETRY_CANCEL { })
        (emit NPM_FAILED { name: @entity.name, code: "unconfigured", status: 0, error: @payload.error })
      NPM_PACKUMENT_REFUSED -> waiting when (and (!= @payload.code "auth") (!= @payload.code "unconfigured") (= @payload.status 0))
        (emit NPM_WAIT_RETRY_FAILED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey), error: @payload.error })
      NPM_PACKUMENT_REFUSED -> waiting when (and (!= @payload.code "auth") (!= @payload.code "unconfigured") (!= @payload.status 0))
        (emit NPM_WAIT_RETRY_FAILED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey), error: (str/concat "not yet visible: " @entity.name (quote "@") @entity.version " (" @payload.status ")") })

      NPM_WAIT_TARBALL -> waiting when (not @config.bearer)
        (http GET @config.origin (str/slice @payload.url (str/len @config.origin) (str/len @payload.url)) {
          headers: { Range: "bytes=0-0" },
          responseAs: "bytes",
          timeoutMs: @config.timeout
        } { emit: { success: NPM_WAIT_TARBALL_REPLIED, failure: NPM_WAIT_UNREACHABLE } })
      NPM_WAIT_TARBALL -> waiting when @config.bearer
        (http GET @config.origin (str/slice @payload.url (str/len @config.origin) (str/len @payload.url)) {
          headers: { Range: "bytes=0-0" },
          auth: { scheme: bearer, credential: @config.credential },
          responseAs: "bytes",
          timeoutMs: @config.timeout
        } { emit: { success: NPM_WAIT_TARBALL_REPLIED, failure: NPM_WAIT_UNREACHABLE } })
      NPM_WAIT_TARBALL_REPLIED -> waiting when (or (= @payload.status 200) (= @payload.status 206))
        (emit NPM_WAIT_RETRY_SUCCEEDED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey) })
      NPM_WAIT_TARBALL_REPLIED -> idle when (or (= @payload.status 401) (= @payload.status 403))
        (emit NPM_WAIT_RETRY_CANCEL { })
        (emit NPM_FAILED { name: @entity.name, code: "auth", status: @payload.status, error: (str/concat "the registry refused the token (" @payload.status ") for the tarball of " @entity.name (quote "@") @entity.version) })
      NPM_WAIT_TARBALL_REPLIED -> waiting when (not (or (= @payload.status 200) (= @payload.status 206) (= @payload.status 401) (= @payload.status 403)))
        (emit NPM_WAIT_RETRY_FAILED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey), error: (str/concat "version listed but its tarball is not downloadable yet (" @payload.status ")") })
      NPM_WAIT_UNREACHABLE -> idle when (= @payload.kind "unconfigured")
        (emit NPM_WAIT_RETRY_CANCEL { })
        (emit NPM_FAILED { name: @entity.name, code: "unconfigured", status: 0, error: @payload.error })
      NPM_WAIT_UNREACHABLE -> waiting when (!= @payload.kind "unconfigured")
        (emit NPM_WAIT_RETRY_FAILED { key: (as (str/concat "npm-wait:" (+ @entity.seq 1)) CallKey), error: @payload.error })

      NPM_WAIT_DONE -> idle
        (emit NPM_VISIBLE { name: @entity.name, version: @entity.version, attempts: @payload.attempts })
      NPM_WAIT_GAVE_UP -> idle
        (emit NPM_WAIT_TIMEOUT { name: @entity.name, version: @entity.version, attempts: @payload.attempts, error: @payload.error })
    }

    emits {
      NPM_VERSIONS_LISTED -> external { name : string!  versions : [string]!  tags : Map string string }
        @description "The package's published versions, semver ascending, and its dist-tags."
        @synonyms "versions list, published versions, dist-tags"
        @tier "primary"
      NPM_NEXT -> external { name : string!  current : string!  next : string!  skipped : [string]! }
        @description "The next version to publish: current bumped, then past every already published version; skipped lists the published candidates passed over."
        @synonyms "next version, bump version"
        @tier "primary"
      NPM_VISIBLE -> external { name : string!  version : string!  attempts : number! }
        @description "The version is listed and its tarball downloads."
        @synonyms "version visible, published, installable"
        @tier "primary"
      NPM_WAIT_TIMEOUT -> external { name : string!  version : string!  attempts : number!  error : string }
        @description "The attempts were spent before the version became visible."
        @synonyms "wait timed out, registry lag"
        @tier "primary"
      NPM_AUTH_OK -> external { name : string! }
        @description "The token can read the probed package."
        @synonyms "token ok, registry readable"
        @tier "primary"
      NPM_FAILED -> external { name : string  code : string!  status : number!  error : string! }
        @description "The ask failed: code is auth, absent, unreachable, unexpected, unconfigured, invalid_version or npm_busy."
        @synonyms "registry failed, 401, unauthorized"
        @tier "primary"
      NPM_LOOKUP_ASK -> external { requestId : string!  name : string!  tag : string }
        @description "Internal: ask the composed std-npm-lookup for the package in flight."
        @tier "internal"
      NPM_PACKUMENT_READ { requestId : string!  name : string!  versions : [string]!  distTags : Map string string  version : string!  tarballs : Map string string! }
        @description "Internal: the lookup's answer."
        @tier "internal"
      NPM_WAIT_UNREACHABLE { error : string!  kind : string! }
        @description "Internal: a wait attempt's tarball call never produced a reply."
        @tier "internal"
      NPM_GET { kind : string! }
        @description "Internal: read the packument of the package in flight."
        @tier "internal"
      NPM_WAIT_TARBALL { url : string! }
        @description "Internal: read one byte of the version's tarball."
        @tier "internal"
      NPM_WAIT_RETRY_START -> external { key : CallKey! }
        @description "Internal: hand a wait to std-retry."
        @tier "internal"
      NPM_WAIT_RETRY_SUCCEEDED -> external { key : CallKey! }
        @description "Internal: tell std-retry the attempt succeeded."
        @tier "internal"
      NPM_WAIT_RETRY_FAILED -> external { key : CallKey!  error : string }
        @description "Internal: tell std-retry the attempt failed."
        @tier "internal"
      NPM_WAIT_RETRY_CANCEL -> external { }
        @description "Internal: stop std-retry."
        @tier "internal"
      NPM_WAIT_TARBALL_REPLIED { status : number!  headers : Map string string  body : string!  key : string }
        @description "Internal: a wait attempt's tarball reply."
        @tier "internal"
    }

    listens {
      NPM_PACKUMENT_REFUSED { requestId : string!  name : string  code : string!  status : number!  error : string! }
        @description "Internal: the lookup's refusal."
      NPM_VERSIONS { name : string! }
        @description "List the package's published versions and dist-tags."
        @synonyms "list versions, dist-tags, npm view"
      NPM_NEXT_VERSION { name : string!  current : string!  bump : string!  major : boolean }
        @description "Compute the next version to publish (bump patch, minor or major), skipping published versions."
        @synonyms "next version, bump"
      NPM_WAIT { name : string!  version : string! }
        @description "Poll until the version is listed and its tarball downloads."
        @synonyms "wait for version, registry lag"
      NPM_AUTH_PROBE { name : string! }
        @description "Read one package the token must be able to read."
        @synonyms "preflight, token check"
      NPM_WAIT_ATTEMPT { key : CallKey!  attempt : number! }
        @description "Internal: std-retry's ATTEMPT."
      NPM_WAIT_DONE { key : CallKey!  attempts : number! }
        @description "Internal: std-retry's COMPLETED."
      NPM_WAIT_GAVE_UP { key : CallKey!  attempts : number!  error : string }
        @description "Internal: std-retry's GAVE_UP."
      PackumentLookup.NPM_LOOKED -> NPM_PACKUMENT_READ
      PackumentLookup.NPM_LOOKUP_REFUSED -> NPM_PACKUMENT_REFUSED
      WaitRetry.ATTEMPT -> NPM_WAIT_ATTEMPT
      WaitRetry.COMPLETED -> NPM_WAIT_DONE
      WaitRetry.GAVE_UP -> NPM_WAIT_GAVE_UP
    }
    config {
      origin : url = @config.registry
      bearer : boolean = @config.authenticated
      credential : secret = @config.token
      timeout : number = @config.timeoutMs
    }
  }

  page boot as NpmRegistryPage -> NpmRegistry, WaitRetry, PackumentLookup
}
