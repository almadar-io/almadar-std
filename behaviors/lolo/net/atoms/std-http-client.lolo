app std-http-client [
  version: "1.0.0",
  net: { "api.example.test:80": [tcp] },
  description: "std-http-client — an HTTP/1.1 client in .lolo over os/tcp-connect, os/send, os/recv and os/close, bytes/* and str/*: one call per frame, the wire of the retired runtime drivers/http_request loop. HTTP_SEND { key, host, port, tls, serverName, method, target, headers, body, stream } opens a socket (tls true: the kernel runs the TLS handshake and offers http/1.1), writes the request with connection: close, reads the head (an interim 1xx head is skipped), then the body by the head (none, content-length, chunked with trailers skipped, or until the peer closes), and answers HTTP_REPLIED { key, status, headers, body } for any status. stream sse or jsonl answers each complete frame as HTTP_STREAM_EVENT { key, data, event, id } while the body is still arriving. The framing is std-http-frame, composed in this atom as the sibling trait ClientFrame: a program that asks for a stream composes ClientFrame beside this trait. A request the atom will not write answers HTTP_FAILED kind refused before any socket opens; a transport failure keeps kind denied, timeout or tls (a handshake or certificate failure), else io. HTTP_CANCEL { key } aborts the call in flight: its socket is closed, a connect that answers late is closed, a send or read that answers late is dropped, and nothing is answered. A credential header (the credential, credentialHeader, credentialPrefix and credentialOptional knobs) is written after the host header as an os/send credential segment, so the value never enters program data; a credential that is not held fails the send as denied, or is skipped when credentialOptional. The credentialIn knob moves the credential to the query string (credentialName, uri-encoded by the host) or the last field of a form body (credentialName, form-encoded, content-length counting the encoded value); credentialEncode base64 with the prefix Basic writes a basic-auth header from one user:pass credential. A placement the atom cannot write answers HTTP_FAILED kind refused. Nothing follows a redirect. One call is in flight per frame; the store seam gives every ask its own frame (EXEC-STORE-4)."
]
uses Spec from "almadar-std/http-client"
uses Frame from "std/behaviors/std-http-frame"
type HttpHeader = { name : string!, value : string! }
type HttpEnvPart = { anchor : { env : string! }! }
type HttpHostText = string
type HttpHostPart = string | HttpEnvPart

orbital HttpClientOrbital {
  entity HttpFlight [runtime] {
    id : string!
    key : string @description "The key of the call in flight." = ""
    sock : number @description "The open socket, -1 when none." = -1
    stage : string @description "head, length, chunk-size, chunk-data, trailer, close, done." = "head"
    stream : string @description "none, sse or jsonl." = "none"
    request : bytes @description "The request as written; with a credential, the part after the credential value (empty for a body credential, which is the last thing written)." = ""
    head : bytes @description "With a credential, the request up to the credential value, which the host fills into the send; empty otherwise." = ""
    credUse : boolean @description "The request carries the credential." = false
    credEnc : string @description "The encode the host applies to the credential value: none, base64, uri or form." = "none"
    buf : bytes @description "Bytes read and not yet consumed." = ""
    dec : bytes @description "Decoded body bytes not yet framed (a stream) or the whole body." = ""
    status : number @description "The status of the final head." = 0
    headers : [HttpHeader] @description "The headers of the final head, names lower-cased." = []
    left : number @description "Body bytes still to come: the content-length remainder or the chunk remainder." = 0
    eof : boolean @description "The peer closed." = false
    total : number @description "Decoded body bytes so far." = 0
    idle : number @description "A kept-alive socket the server left open, -1 when none." = -1
    reused : boolean @description "The socket in flight was an idle one; a failure before any response byte retries on a fresh connection." = false
    hostText : string @description "With an env-anchored host, the host field of the call in flight (the host header and the TLS server name); empty with a literal host." = ""
    keep : boolean @description "The final head allows the socket to be kept for the next call." = false
    headOnly : boolean @description "The reply to this request has no body whatever the head says." = false
    @invariant (>= @entity.total 0)
  }

  trait ClientFrame = Frame.traits.HttpFrame {
    listens {
      HttpClient.HC_FRAME -> FRAME_RUN
    }
  }

  trait HttpClient -> HttpFlight [optimistic] {
    initial: ready

    config {
      host : HttpHostPart = "api.example.test"
        @label "Host"
        @description "The server os/tcp-connect opens, and the host header: a literal host, because the net grant is checked against it, or { anchor: { env: NAME } }, the host that environment variable NAME holds at boot, granted by an env-anchored net entry such as net: { env NAME, 443: [tcp] }. With an anchored host the caller names that same text in the host field of HTTP_SEND (an HTTP_SEND without one is refused): it is the host header and the TLS server name, and the serverName knob is not used."
        @tier "infra"
      port : number = 80
        @label "Port"
        @description "The server port os/tcp-connect opens; a literal knob because the net grant is checked against it."
        @tier "infra"
      tls : boolean = false
        @label "TLS"
        @description "Whether the kernel runs the TLS client handshake over the socket os/tcp-connect opens (EXEC-HTTP-7) before a request is written."
        @tier "infra"
      serverName : string = "api.example.test"
        @label "Server name"
        @description "The name the server certificate is verified against; a host the net grant names. Read only when tls is true."
        @tier "infra"
      alpn : [string] = ["http/1.1"]
        @label "ALPN"
        @description "The application protocols offered to the peer, in order. Read only when tls is true."
        @tier "infra"
      recvBytes : number = 16384
        @label "Read size"
        @description "The most bytes one os/recv takes."
        @tier "infra"
      maxHead : number = 65536
        @label "Largest head"
        @description "A head with no end after this many bytes fails."
        @tier "infra"
      maxBody : number = 67108864
        @label "Largest body"
        @description "A body, decoded, past this many bytes fails."
        @tier "infra"
      tokenPattern : string = "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        @label "Token"
        @description "What a method or header name must match."
        @tier "domain"
      valuePattern : string = "^[^\\x00-\\x08\\x0a-\\x1f\\x7f]*$"
        @label "Header value"
        @description "What a header value may hold: no control character other than a tab."
        @tier "domain"
      targetPattern : string = "^/[^ \\x00-\\x20\\x7f]*$"
        @label "Target"
        @description "A request target: a slash and no space or control character."
        @tier "domain"
      statusLinePattern : string = "^HTTP/1\\.[01] [0-9]{3}( .*)?$"
        @label "Status line"
        @description "The version and a three digit status, the reason optional."
        @tier "domain"
      lengthPattern : string = "^[0-9]{1,15}$"
        @label "Content length"
        @description "What a content-length value must match."
        @tier "domain"
      chunkSizePattern : string = "^[0-9a-f]{1,8}$"
        @label "Chunk size"
        @description "What a lower-cased chunk size must match."
        @tier "domain"
      hexDigits : string = "0123456789abcdef"
        @label "Hex digits"
        @description "The digits a chunk size is written in."
        @tier "domain"
      streams : [string] = ["none", "sse", "jsonl"]
        @label "Streams"
        @description "The stream framings a call may ask for."
        @tier "domain"
      bodyMethods : [string] = ["POST", "PUT", "PATCH"]
        @label "Body methods"
        @description "Methods that always carry a content-length, even for an empty body."
        @tier "domain"
      noBodyStatuses : [number] = [204, 304]
        @label "Statuses with no body"
        @description "A reply with one of these statuses has no body."
        @tier "domain"
      credential : secret = ""
        @label "Credential"
        @description "The credential the request header carries: the host fills its value into the send at the boundary, so the program, the journal and the answer never hold it. Read only when credentialHeader names a header."
        @tier "infra"
      credentialHeader : string = ""
        @label "Credential header"
        @description "The header that carries the credential on every request, for example authorization or x-api-key; empty sends none."
        @tier "infra"
      credentialPrefix : string = ""
        @label "Credential prefix"
        @description "The text written before the credential value, for example Bearer followed by a space."
        @tier "infra"
      credentialOptional : boolean = false
        @label "Credential optional"
        @description "True sends the request without the header when the credential is not held; false fails the send as denied before a byte is written."
        @tier "infra"
      credentialIn : "header" | "query" | "body" = "header"
        @label "Credential placement"
        @description "Where the credential rides the request: header (credentialHeader), query (a query parameter named credentialName, spliced into the target after a ? or &) or body (a form field named credentialName appended last to the body, which must be application/x-www-form-urlencoded and carries a content-length that counts the encoded credential). The host encodes the value at the boundary; a query credential is uri-encoded and a body credential form-encoded."
        @tier "infra"
      credentialName : string = ""
        @label "Credential name"
        @description "The query parameter or form field that carries the credential; required for query and body, empty for header."
        @tier "infra"
      credentialEncode : "none" | "base64" | "uri" | "form" = "none"
        @label "Credential encode"
        @description "The encoding the host applies to a header credential value at the boundary, for example base64 with the prefix Basic followed by a space for one user:pass credential; none writes it as held. Query and body fix their own encoding, so they take none."
        @tier "infra"
      credentialScope : "app" | "user" = "app"
        @label "Credential scope"
        @description "Whose credential the secret slot resolves: app is the app-wide credential, user is the credential of the signed-in viewer of the dispatch (a call with nobody signed in fails the send as denied before a byte is written)."
        @tier "infra"
      credentialHeaders : [string] = ["authorization", "proxy-authorization", "cookie", "x-api-key"]
        @label "Credential headers"
        @description "Header names that carry a credential. A payload never carries one: credentials ride a secret slot (the request builder), so a call that sets one here is refused."
        @tier "domain"
      signatureHeaders : [string] = []
        @label "Signature headers"
        @description "Header names, lower case, a payload may set although credentialHeaders lists them, because the value is a computed signature (for example the SigV4 authorization header) and not a held secret. Empty allows none; leave the credential header out of this list."
        @tier "domain"
      framingHeaders : [string] = ["host", "content-length", "transfer-encoding", "connection"]
        @label "Framing headers"
        @description "Header names the atom writes itself; a call that sets one is refused."
        @tier "domain"
    }

    state ready {
      INIT -> ready
      HC_CLOSED -> ready
      HTTP_CANCEL -> ready
      HC_CONNECTED -> ready
        (os/close @payload.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
      HC_SENT -> ready
      HC_READ -> ready
      HC_IO_FAILED -> ready

      HTTP_SEND -> ready when (not (and (and (or (validate/string @config.host) (!= (default @payload.host "") "")) (validate/pattern @payload.method @config.tokenPattern) (validate/pattern @payload.target @config.targetPattern) (array/includes @config.streams @payload.stream) (array/every @payload.headers (fn h (and (validate/pattern @h.name @config.tokenPattern) (validate/pattern @h.value @config.valuePattern) (not (array/includes @config.framingHeaders (str/lower @h.name))) (or (not (array/includes @config.credentialHeaders (str/lower @h.name))) (array/includes @config.signatureHeaders (str/lower @h.name))))))) (or (and (= @config.credentialIn "header") (= @config.credentialName "") (or (!= @config.credentialHeader "") (= @config.credentialEncode "none"))) (and (!= @config.credentialIn "header") (!= @config.credentialName "") (= @config.credentialEncode "none") (= @config.credentialHeader "") (or (= @config.credentialIn "query") (array/some @payload.headers (fn h (and (= (str/lower @h.name) "content-type") (= (str/lower (str/trim @h.value)) "application/x-www-form-urlencoded")))))))))
        (emit HTTP_FAILED { key: @payload.key, error: "the request cannot be written: a method, header, target, port, host or stream is not allowed, or a header names framing the atom writes or carries a credential, or the credential placement is not allowed (a query or body credential needs credentialName, no credentialHeader, credentialEncode none, and for a body a form content-type header; a header credential takes no credentialName and an encode only with a credentialHeader)", kind: "refused" })

      HTTP_SEND -> sending when (and (>= @entity.idle 0) (and (and (or (validate/string @config.host) (!= (default @payload.host "") "")) (validate/pattern @payload.method @config.tokenPattern) (validate/pattern @payload.target @config.targetPattern) (array/includes @config.streams @payload.stream) (array/every @payload.headers (fn h (and (validate/pattern @h.name @config.tokenPattern) (validate/pattern @h.value @config.valuePattern) (not (array/includes @config.framingHeaders (str/lower @h.name))) (or (not (array/includes @config.credentialHeaders (str/lower @h.name))) (array/includes @config.signatureHeaders (str/lower @h.name))))))) (or (and (= @config.credentialIn "header") (= @config.credentialName "") (or (!= @config.credentialHeader "") (= @config.credentialEncode "none"))) (and (!= @config.credentialIn "header") (!= @config.credentialName "") (= @config.credentialEncode "none") (= @config.credentialHeader "") (or (= @config.credentialIn "query") (array/some @payload.headers (fn h (and (= (str/lower @h.name) "content-type") (= (str/lower (str/trim @h.value)) "application/x-www-form-urlencoded")))))))))
        (set @entity.key @payload.key)
        (set @entity.stream @payload.stream)
        (set @entity.stage "head")
        (set @entity.buf (bytes/from-string ""))
        (set @entity.dec (bytes/from-string ""))
        (set @entity.status 0)
        (set @entity.headers [])
        (set @entity.left 0)
        (set @entity.eof false)
        (set @entity.total 0)
        (set @entity.keep false)
        (set @entity.headOnly (= @payload.method "HEAD"))
        (set @entity.hostText (default @payload.host ""))
        (set @entity.credUse (and (or (!= @config.credentialIn "header") (!= @config.credentialHeader "")) (or (not @config.credentialOptional) (>= (default (credential/byte-length @config.credential) -1) 0))))
        (set @entity.credEnc (if (= @config.credentialIn "query") "uri" (if (= @config.credentialIn "body") "form" @config.credentialEncode)))
        (let ((hostLine (str/concat " HTTP/1.1\r\nhost: " (default (as @config.host HttpHostText) @entity.hostText) (if (= @config.port (if @config.tls 443 80)) "" (str/concat ":" @config.port)) "\r\n"))
              (fields (str/join (array/map @payload.headers (fn h (str/concat (str/lower @h.name) ": " @h.value "\r\n"))) ""))
              (bodyCred (and @entity.credUse (= @config.credentialIn "body")))
              (queryCred (and @entity.credUse (= @config.credentialIn "query")))
              (bodySep (if (> (bytes/length @payload.body) 0) "&" "")))
          (let ((contentLength (if @bodyCred (str/concat "content-length: " (+ (+ (bytes/length @payload.body) (bytes/length (bytes/from-string (str/concat @bodySep @config.credentialName "=")))) (default (credential/byte-length @config.credential "form") 0)) "\r\n") (if (or (> (bytes/length @payload.body) 0) (array/includes @config.bodyMethods @payload.method)) (str/concat "content-length: " (bytes/length @payload.body) "\r\n") ""))))
            (emit HC_BUILT {
              head: (bytes/concat [
                (bytes/from-string (if @entity.credUse
                  (if @queryCred
                    (str/concat @payload.method " " @payload.target (if (str/includes @payload.target "?") "&" "?") @config.credentialName "=")
                    (str/concat @payload.method " " @payload.target @hostLine (if @bodyCred (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n") (str/concat @config.credentialHeader ": " @config.credentialPrefix))))
                  "")),
                (if @bodyCred @payload.body (bytes/from-string "")),
                (bytes/from-string (if @bodyCred (str/concat @bodySep @config.credentialName "=") ""))
              ]),
              request: (bytes/concat [
                (bytes/from-string (str/concat (if @entity.credUse (if @queryCred @hostLine (if @bodyCred "" "\r\n")) (str/concat @payload.method " " @payload.target @hostLine))
                  (if @bodyCred "" (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n")))),
                (if @bodyCred (bytes/from-string "") @payload.body)
              ])
            })))
        (set @entity.sock @entity.idle)
        (set @entity.idle -1)
        (set @entity.reused true)
      HTTP_SEND -> connecting when (and (not @config.tls) (and (< @entity.idle 0) (and (and (or (validate/string @config.host) (!= (default @payload.host "") "")) (validate/pattern @payload.method @config.tokenPattern) (validate/pattern @payload.target @config.targetPattern) (array/includes @config.streams @payload.stream) (array/every @payload.headers (fn h (and (validate/pattern @h.name @config.tokenPattern) (validate/pattern @h.value @config.valuePattern) (not (array/includes @config.framingHeaders (str/lower @h.name))) (or (not (array/includes @config.credentialHeaders (str/lower @h.name))) (array/includes @config.signatureHeaders (str/lower @h.name))))))) (or (and (= @config.credentialIn "header") (= @config.credentialName "") (or (!= @config.credentialHeader "") (= @config.credentialEncode "none"))) (and (!= @config.credentialIn "header") (!= @config.credentialName "") (= @config.credentialEncode "none") (= @config.credentialHeader "") (or (= @config.credentialIn "query") (array/some @payload.headers (fn h (and (= (str/lower @h.name) "content-type") (= (str/lower (str/trim @h.value)) "application/x-www-form-urlencoded"))))))))))
        (set @entity.key @payload.key)
        (set @entity.stream @payload.stream)
        (set @entity.stage "head")
        (set @entity.buf (bytes/from-string ""))
        (set @entity.dec (bytes/from-string ""))
        (set @entity.status 0)
        (set @entity.headers [])
        (set @entity.left 0)
        (set @entity.eof false)
        (set @entity.total 0)
        (set @entity.keep false)
        (set @entity.headOnly (= @payload.method "HEAD"))
        (set @entity.hostText (default @payload.host ""))
        (set @entity.credUse (and (or (!= @config.credentialIn "header") (!= @config.credentialHeader "")) (or (not @config.credentialOptional) (>= (default (credential/byte-length @config.credential) -1) 0))))
        (set @entity.credEnc (if (= @config.credentialIn "query") "uri" (if (= @config.credentialIn "body") "form" @config.credentialEncode)))
        (let ((hostLine (str/concat " HTTP/1.1\r\nhost: " (default (as @config.host HttpHostText) @entity.hostText) (if (= @config.port (if @config.tls 443 80)) "" (str/concat ":" @config.port)) "\r\n"))
              (fields (str/join (array/map @payload.headers (fn h (str/concat (str/lower @h.name) ": " @h.value "\r\n"))) ""))
              (bodyCred (and @entity.credUse (= @config.credentialIn "body")))
              (queryCred (and @entity.credUse (= @config.credentialIn "query")))
              (bodySep (if (> (bytes/length @payload.body) 0) "&" "")))
          (let ((contentLength (if @bodyCred (str/concat "content-length: " (+ (+ (bytes/length @payload.body) (bytes/length (bytes/from-string (str/concat @bodySep @config.credentialName "=")))) (default (credential/byte-length @config.credential "form") 0)) "\r\n") (if (or (> (bytes/length @payload.body) 0) (array/includes @config.bodyMethods @payload.method)) (str/concat "content-length: " (bytes/length @payload.body) "\r\n") ""))))
            (emit HC_BUILT {
              head: (bytes/concat [
                (bytes/from-string (if @entity.credUse
                  (if @queryCred
                    (str/concat @payload.method " " @payload.target (if (str/includes @payload.target "?") "&" "?") @config.credentialName "=")
                    (str/concat @payload.method " " @payload.target @hostLine (if @bodyCred (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n") (str/concat @config.credentialHeader ": " @config.credentialPrefix))))
                  "")),
                (if @bodyCred @payload.body (bytes/from-string "")),
                (bytes/from-string (if @bodyCred (str/concat @bodySep @config.credentialName "=") ""))
              ]),
              request: (bytes/concat [
                (bytes/from-string (str/concat (if @entity.credUse (if @queryCred @hostLine (if @bodyCred "" "\r\n")) (str/concat @payload.method " " @payload.target @hostLine))
                  (if @bodyCred "" (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n")))),
                (if @bodyCred (bytes/from-string "") @payload.body)
              ])
            })))
        (set @entity.reused false)
        (os/tcp-connect @config.host @config.port { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HTTP_SEND -> connecting when (and @config.tls (and (< @entity.idle 0) (and (and (or (validate/string @config.host) (!= (default @payload.host "") "")) (validate/pattern @payload.method @config.tokenPattern) (validate/pattern @payload.target @config.targetPattern) (array/includes @config.streams @payload.stream) (array/every @payload.headers (fn h (and (validate/pattern @h.name @config.tokenPattern) (validate/pattern @h.value @config.valuePattern) (not (array/includes @config.framingHeaders (str/lower @h.name))) (or (not (array/includes @config.credentialHeaders (str/lower @h.name))) (array/includes @config.signatureHeaders (str/lower @h.name))))))) (or (and (= @config.credentialIn "header") (= @config.credentialName "") (or (!= @config.credentialHeader "") (= @config.credentialEncode "none"))) (and (!= @config.credentialIn "header") (!= @config.credentialName "") (= @config.credentialEncode "none") (= @config.credentialHeader "") (or (= @config.credentialIn "query") (array/some @payload.headers (fn h (and (= (str/lower @h.name) "content-type") (= (str/lower (str/trim @h.value)) "application/x-www-form-urlencoded"))))))))))
        (set @entity.key @payload.key)
        (set @entity.stream @payload.stream)
        (set @entity.stage "head")
        (set @entity.buf (bytes/from-string ""))
        (set @entity.dec (bytes/from-string ""))
        (set @entity.status 0)
        (set @entity.headers [])
        (set @entity.left 0)
        (set @entity.eof false)
        (set @entity.total 0)
        (set @entity.keep false)
        (set @entity.headOnly (= @payload.method "HEAD"))
        (set @entity.hostText (default @payload.host ""))
        (set @entity.credUse (and (or (!= @config.credentialIn "header") (!= @config.credentialHeader "")) (or (not @config.credentialOptional) (>= (default (credential/byte-length @config.credential) -1) 0))))
        (set @entity.credEnc (if (= @config.credentialIn "query") "uri" (if (= @config.credentialIn "body") "form" @config.credentialEncode)))
        (let ((hostLine (str/concat " HTTP/1.1\r\nhost: " (default (as @config.host HttpHostText) @entity.hostText) (if (= @config.port (if @config.tls 443 80)) "" (str/concat ":" @config.port)) "\r\n"))
              (fields (str/join (array/map @payload.headers (fn h (str/concat (str/lower @h.name) ": " @h.value "\r\n"))) ""))
              (bodyCred (and @entity.credUse (= @config.credentialIn "body")))
              (queryCred (and @entity.credUse (= @config.credentialIn "query")))
              (bodySep (if (> (bytes/length @payload.body) 0) "&" "")))
          (let ((contentLength (if @bodyCred (str/concat "content-length: " (+ (+ (bytes/length @payload.body) (bytes/length (bytes/from-string (str/concat @bodySep @config.credentialName "=")))) (default (credential/byte-length @config.credential "form") 0)) "\r\n") (if (or (> (bytes/length @payload.body) 0) (array/includes @config.bodyMethods @payload.method)) (str/concat "content-length: " (bytes/length @payload.body) "\r\n") ""))))
            (emit HC_BUILT {
              head: (bytes/concat [
                (bytes/from-string (if @entity.credUse
                  (if @queryCred
                    (str/concat @payload.method " " @payload.target (if (str/includes @payload.target "?") "&" "?") @config.credentialName "=")
                    (str/concat @payload.method " " @payload.target @hostLine (if @bodyCred (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n") (str/concat @config.credentialHeader ": " @config.credentialPrefix))))
                  "")),
                (if @bodyCred @payload.body (bytes/from-string "")),
                (bytes/from-string (if @bodyCred (str/concat @bodySep @config.credentialName "=") ""))
              ]),
              request: (bytes/concat [
                (bytes/from-string (str/concat (if @entity.credUse (if @queryCred @hostLine (if @bodyCred "" "\r\n")) (str/concat @payload.method " " @payload.target @hostLine))
                  (if @bodyCred "" (str/concat @fields @contentLength (if (= @payload.stream "none") "" "connection: close\r\n") "\r\n")))),
                (if @bodyCred (bytes/from-string "") @payload.body)
              ])
            })))
        (set @entity.reused false)
        (os/tcp-connect @config.host @config.port { serverName: (if (validate/string @config.host) @config.serverName @entity.hostText), alpn: @config.alpn } { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })

      HTTP_CLOSE -> ready when (>= @entity.idle 0)
        (os/close @entity.idle { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.idle -1)
      HTTP_CLOSE -> ready when (< @entity.idle 0)
    }

    state connecting {
      INIT -> connecting
      HC_BUILT -> connecting
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
      HTTP_SEND -> connecting
        (emit HTTP_FAILED { key: @payload.key, error: "a call is in flight on this frame", kind: "refused" })
      HTTP_CANCEL -> ready when (= @payload.key @entity.key)
        (set @entity.sock -1)
      HTTP_CANCEL -> connecting when (!= @payload.key @entity.key)
      HC_CONNECTED -> sending when (not @entity.credUse)
        (set @entity.sock @payload.sock)
        (os/send @payload.sock @entity.request { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "none") (= @config.credentialScope "app"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "none") (= @config.credentialScope "user"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, scope: "user" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "base64") (= @config.credentialScope "app"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, encode: "base64" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "base64") (= @config.credentialScope "user"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, scope: "user", encode: "base64" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "uri") (= @config.credentialScope "app"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, encode: "uri" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "uri") (= @config.credentialScope "user"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, scope: "user", encode: "uri" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "form") (= @config.credentialScope "app"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, encode: "form" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_CONNECTED -> sending when (and @entity.credUse (= @entity.credEnc "form") (= @config.credentialScope "user"))
        (set @entity.sock @payload.sock)
        (os/send @payload.sock [{ bytes: @entity.head, credential: @config.credential, scope: "user", encode: "form" }, { bytes: @entity.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> ready
        (emit HTTP_FAILED { key: @entity.key, error: @payload.error, kind: (if (array/includes ["denied", "timeout", "tls"] @payload.kind) @payload.kind "io") })
    }

    state sending {
      INIT -> sending
      HC_BUILT -> sending when (not @entity.credUse)
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock @payload.request { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "none") (= @config.credentialScope "app"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "none") (= @config.credentialScope "user"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, scope: "user" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "base64") (= @config.credentialScope "app"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, encode: "base64" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "base64") (= @config.credentialScope "user"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, scope: "user", encode: "base64" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "uri") (= @config.credentialScope "app"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, encode: "uri" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "uri") (= @config.credentialScope "user"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, scope: "user", encode: "uri" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "form") (= @config.credentialScope "app"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, encode: "form" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HC_BUILT -> sending when (and @entity.credUse (= @entity.credEnc "form") (= @config.credentialScope "user"))
        (set @entity.head @payload.head)
        (set @entity.request @payload.request)
        (os/send @entity.sock [{ bytes: @payload.head, credential: @config.credential, scope: "user", encode: "form" }, { bytes: @payload.request, credential: "" }] { key: "send" emit: { success: HC_SENT, failure: HC_IO_FAILED } })
      HTTP_SEND -> sending
        (emit HTTP_FAILED { key: @payload.key, error: "a call is in flight on this frame", kind: "refused" })
      HTTP_CANCEL -> ready when (= @payload.key @entity.key)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
      HTTP_CANCEL -> sending when (!= @payload.key @entity.key)
      HC_SENT -> reading
        (os/recv @entity.sock @config.recvBytes { key: "read" emit: { success: HC_READ, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> connecting when (and (not @config.tls) @entity.reused)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> connecting when (and @config.tls @entity.reused)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { serverName: (if (validate/string @config.host) @config.serverName @entity.hostText), alpn: @config.alpn } { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> ready when (not @entity.reused)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: @payload.error, kind: (if (array/includes ["denied", "timeout", "tls"] @payload.kind) @payload.kind "io") })
