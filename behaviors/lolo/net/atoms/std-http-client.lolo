    state reading {
      INIT -> reading
      HC_CLOSED -> reading
      HTTP_SEND -> reading
        (emit HTTP_FAILED { key: @payload.key, error: "a call is in flight on this frame", kind: "refused" })
      HTTP_CANCEL -> ready when (= @payload.key @entity.key)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
      HTTP_CANCEL -> reading when (!= @payload.key @entity.key)

      HC_IO_FAILED -> connecting when (and (not @config.tls) (and @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0)))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> connecting when (and @config.tls (and @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0)))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { serverName: (if (validate/string @config.host) @config.serverName @entity.hostText), alpn: @config.alpn } { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_IO_FAILED -> ready when (not (and @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0)))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: @payload.error, kind: (if (array/includes ["denied", "timeout", "tls"] @payload.kind) @payload.kind "io") })

      HC_READ -> reading
        (set @entity.buf (bytes/concat [@entity.buf, @payload.data]))
        (set @entity.eof @payload.eof)
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })

      HC_WANT -> reading when (not @entity.eof)
        (os/recv @entity.sock @config.recvBytes { key: "read" emit: { success: HC_READ, failure: HC_IO_FAILED } })
      HC_WANT -> connecting when (and (not @config.tls) (and @entity.eof @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0)))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_WANT -> connecting when (and @config.tls (and @entity.eof @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0)))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.reused false)
        (set @entity.sock -1)
        (set @entity.buf (bytes/from-string ""))
        (os/tcp-connect @config.host @config.port { serverName: (if (validate/string @config.host) @config.serverName @entity.hostText), alpn: @config.alpn } { key: "connect" emit: { success: HC_CONNECTED, failure: HC_IO_FAILED } })
      HC_WANT -> ready when (and @entity.eof (!= @entity.stage "close") (not (and @entity.reused (= @entity.stage "head") (= (bytes/length @entity.buf) 0))))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "the peer closed before the response was whole", kind: "io" })

      HC_ADVANCE -> reading when (and (= @entity.stage "head") (< (bytes/index-of @entity.buf (bytes/from-string "\r\n\r\n") 0) 0) (> (bytes/length @entity.buf) @config.maxHead))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "the response head is past the largest head", kind: "io" })
      HC_ADVANCE -> reading when (and (= @entity.stage "head") (< (bytes/index-of @entity.buf (bytes/from-string "\r\n\r\n") 0) 0) (<= (bytes/length @entity.buf) @config.maxHead))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "head") (>= (bytes/index-of @entity.buf (bytes/from-string "\r\n\r\n") 0) 0))
        (emit HC_HEAD { end: (bytes/index-of @entity.buf (bytes/from-string "\r\n\r\n") 0) })

      HC_HEAD -> reading when (not (let ((text (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)))) (and (!= @text null) (validate/pattern (default (array/first (str/split @text "\r\n")) "") @config.statusLinePattern))))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "the response head is malformed", kind: "io" })
      HC_HEAD -> reading when (let ((text (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)))) (and (!= @text null) (validate/pattern (default (array/first (str/split @text "\r\n")) "") @config.statusLinePattern) (< (default (str/to-int (str/slice (default (array/first (str/split @text "\r\n")) "") 9 12)) 0) 200)))
        (set @entity.buf (bytes/slice @entity.buf (+ @payload.end 4)))
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_HEAD -> reading when (let ((text (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)))) (and (!= @text null) (validate/pattern (default (array/first (str/split @text "\r\n")) "") @config.statusLinePattern) (>= (default (str/to-int (str/slice (default (array/first (str/split @text "\r\n")) "") 9 12)) 0) 200)))
        (let ((lines (str/split (default (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)) "") "\r\n")))
          (let ((fields (array/map (array/drop @lines 1) (fn l { name: (str/lower (str/trim (default (array/first (str/split @l ":")) ""))), value: (str/trim (str/join (array/drop (str/split @l ":") 1) ":")) }))))
            (let ((status (default (str/to-int (str/slice (default (array/first @lines) "") 9 12)) 0))
                  (chunked (array/some @fields (fn h (and (= @h.name "transfer-encoding") (str/includes (str/lower @h.value) "chunked")))))
                  (lengths (array/map (array/filter @fields (fn h (= @h.name "content-length"))) (fn h @h.value))))
              (do
                (set @entity.status @status)
                (set @entity.headers @fields)
                (set @entity.buf (bytes/slice @entity.buf (+ @payload.end 4)))
                (set @entity.keep (and (str/startsWith (default (array/first @lines) "") "HTTP/1.1") (= @entity.stream "none") (not (array/some @fields (fn h (and (= @h.name "connection") (str/includes (str/lower @h.value) "close"))))) (or @entity.headOnly (array/includes @config.noBodyStatuses @status) @chunked (and (> (array/len @lengths) 0) (validate/pattern (default (array/first @lengths) "") @config.lengthPattern)))))
                (set @entity.left (if (and (not @chunked) (> (array/len @lengths) 0) (validate/pattern (default (array/first @lengths) "") @config.lengthPattern)) (default (str/to-int (default (array/first @lengths) "0")) 0) 0))
                (set @entity.stage (if (or @entity.headOnly (array/includes @config.noBodyStatuses @status)) "done" (if @chunked "chunk-size" (if (and (> (array/len @lengths) 0) (validate/pattern (default (array/first @lengths) "") @config.lengthPattern)) "length" "close"))))
                (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })))))

      HC_ADVANCE -> reading when (and (= @entity.stage "length") (>= (bytes/length @entity.buf) @entity.left))
        (set @entity.dec (bytes/concat [@entity.dec, (bytes/slice @entity.buf 0 @entity.left)]))
        (set @entity.total (+ @entity.total @entity.left))
        (set @entity.buf (bytes/slice @entity.buf @entity.left))
        (set @entity.left 0)
        (set @entity.stage "done")
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_ADVANCE -> reading when (and (= @entity.stage "length") (= (bytes/length @entity.buf) 0) (> @entity.left 0))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "length") (> (bytes/length @entity.buf) 0) (< (bytes/length @entity.buf) @entity.left))
        (set @entity.dec (bytes/concat [@entity.dec, @entity.buf]))
        (set @entity.total (+ @entity.total (bytes/length @entity.buf)))
        (set @entity.left (- @entity.left (bytes/length @entity.buf)))
        (set @entity.buf (bytes/from-string ""))
        (emit HC_FRAMED { n: (+ @entity.total (bytes/length @entity.dec)) })

      HC_ADVANCE -> reading when (and (= @entity.stage "close") (not @entity.eof) (= (bytes/length @entity.buf) 0))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "close") (not @entity.eof) (> (bytes/length @entity.buf) 0))
        (set @entity.dec (bytes/concat [@entity.dec, @entity.buf]))
        (set @entity.total (+ @entity.total (bytes/length @entity.buf)))
        (set @entity.buf (bytes/from-string ""))
        (emit HC_FRAMED { n: (+ @entity.total (bytes/length @entity.dec)) })
      HC_ADVANCE -> reading when (and (= @entity.stage "close") @entity.eof)
        (set @entity.dec (bytes/concat [@entity.dec, @entity.buf]))
        (set @entity.total (+ @entity.total (bytes/length @entity.buf)))
        (set @entity.buf (bytes/from-string ""))
        (set @entity.stage "done")
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })

      HC_ADVANCE -> reading when (and (= @entity.stage "chunk-size") (< (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 0))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "chunk-size") (>= (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 0))
        (emit HC_SIZE { end: (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) })
      HC_SIZE -> reading when (not (let ((line (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)))) (and (!= @line null) (validate/pattern (str/lower (str/trim (default (array/first (str/split @line ";")) ""))) @config.chunkSizePattern))))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "a chunk size is not hexadecimal", kind: "io" })
      HC_SIZE -> reading when (let ((line (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)))) (and (!= @line null) (validate/pattern (str/lower (str/trim (default (array/first (str/split @line ";")) ""))) @config.chunkSizePattern)))
        (let ((size (array/reduce (str/split (str/lower (str/trim (default (array/first (str/split (default (bytes/to-string (bytes/slice @entity.buf 0 @payload.end)) "") ";")) ""))) "") 0 (fn acc ch (+ (* @acc 16) (array/indexOf (str/split @config.hexDigits "") @ch))))))
          (do
            (set @entity.buf (bytes/slice @entity.buf (+ @payload.end 2)))
            (set @entity.left @size)
            (set @entity.stage (if (= @size 0) "trailer" "chunk-data"))
            (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })))

      HC_ADVANCE -> reading when (and (= @entity.stage "chunk-data") (< (bytes/length @entity.buf) (+ @entity.left 2)))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "chunk-data") (>= (bytes/length @entity.buf) (+ @entity.left 2)) (not (bytes/equals (bytes/slice @entity.buf @entity.left (+ @entity.left 2)) (bytes/from-string "\r\n"))))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "a chunk is not followed by CRLF", kind: "io" })
      HC_ADVANCE -> reading when (and (= @entity.stage "chunk-data") (>= (bytes/length @entity.buf) (+ @entity.left 2)) (bytes/equals (bytes/slice @entity.buf @entity.left (+ @entity.left 2)) (bytes/from-string "\r\n")))
        (set @entity.dec (bytes/concat [@entity.dec, (bytes/slice @entity.buf 0 @entity.left)]))
        (set @entity.total (+ @entity.total @entity.left))
        (set @entity.buf (bytes/slice @entity.buf (+ @entity.left 2)))
        (set @entity.left 0)
        (set @entity.stage "chunk-size")
        (emit HC_FRAMED { n: (+ @entity.total (bytes/length @entity.dec)) })

      HC_ADVANCE -> reading when (and (= @entity.stage "trailer") (< (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 0))
        (emit HC_WANT {})
      HC_ADVANCE -> reading when (and (= @entity.stage "trailer") (= (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 0))
        (set @entity.buf (bytes/slice @entity.buf 2))
        (set @entity.stage "done")
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_ADVANCE -> reading when (and (= @entity.stage "trailer") (> (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 0))
        (set @entity.buf (bytes/slice @entity.buf (+ (bytes/index-of @entity.buf (bytes/from-string "\r\n") 0) 2)))
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })

      HC_FRAMED -> reading when (> @entity.total @config.maxBody)
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @entity.key, error: "the body is past the largest body", kind: "io" })
      HC_FRAMED -> reading when (and (<= @entity.total @config.maxBody) (= @entity.stream "none"))
        (emit HC_AFTER { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_FRAMED -> reading when (and (<= @entity.total @config.maxBody) (!= @entity.stream "none"))
        (emit HC_FRAME { key: @entity.key, stream: @entity.stream, data: @entity.dec, final: false })
      HC_DRAINED -> reading
        (set @entity.dec @payload.rest)
        (emit HC_AFTER { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_FRAME_EVENT -> reading
        (emit HTTP_STREAM_EVENT { key: @payload.key, data: @payload.data, event: @payload.event, id: @payload.id })
      HC_FRAME_FAILED -> reading
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_FAILED { key: @payload.key, error: @payload.error, kind: @payload.kind })

      HC_ADVANCE -> reading when (and (= @entity.stage "done") (!= @entity.stream "none") (> (bytes/length @entity.dec) 0))
        (set @entity.stage "flush")
        (emit HC_FRAME { key: @entity.key, stream: @entity.stream, data: @entity.dec, final: true })
      HC_AFTER -> reading when (= @entity.stage "flush")
        (set @entity.stage "final")
        (set @entity.dec (bytes/from-string ""))
        (emit HC_ADVANCE { n: @entity.total })
      HC_AFTER -> reading when (array/includes ["length", "close"] @entity.stage)
        (emit HC_WANT {})
      HC_AFTER -> reading when (not (array/includes ["flush", "length", "close"] @entity.stage))
        (emit HC_ADVANCE { n: (+ @entity.total (bytes/length @entity.buf)) })
      HC_ADVANCE -> ready when (and (or (= @entity.stage "final") (and (= @entity.stage "done") (or (= @entity.stream "none") (= (bytes/length @entity.dec) 0)))) @entity.keep (not @entity.eof) (= (bytes/length @entity.buf) 0))
        (set @entity.idle @entity.sock)
        (set @entity.sock -1)
        (emit HTTP_REPLIED { key: @entity.key, status: @entity.status, headers: (default (object/fromEntries (array/map @entity.headers (fn h [@h.name, (str/join (array/map (array/filter @entity.headers (fn g (= @g.name @h.name))) (fn g @g.value)) ", ")]))) {}), body: @entity.dec })
      HC_ADVANCE -> ready when (and (or (= @entity.stage "final") (and (= @entity.stage "done") (or (= @entity.stream "none") (= (bytes/length @entity.dec) 0)))) (not (and @entity.keep (not @entity.eof) (= (bytes/length @entity.buf) 0))))
        (os/close @entity.sock { key: "close" emit: { success: HC_CLOSED, failure: HC_CLOSED } })
        (set @entity.sock -1)
        (emit HTTP_REPLIED { key: @entity.key, status: @entity.status, headers: (default (object/fromEntries (array/map @entity.headers (fn h [@h.name, (str/join (array/map (array/filter @entity.headers (fn g (= @g.name @h.name))) (fn g @g.value)) ", ")]))) {}), body: (if (= @entity.stream "none") @entity.dec (bytes/from-string "")) })
    }

    emits {
      HTTP_REPLIED -> external {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
        @description "The response, of any status, whole; the body is empty when the call streamed."
        @tier "primary"
      HTTP_STREAM_EVENT -> external {
        key : string!
        data : string!
        event : string?
        id : string?
      }
        @description "One complete frame of a streamed response (sse or jsonl)."
        @tier "primary"
      HTTP_FAILED -> external {
        key : string!
        error : string!
        kind : string!
      }
        @description "The call produced no response: kind refused (nothing opened), denied, timeout, tls or io."
        @tier "primary"
      HC_BUILT -> internal {
        head : bytes!
        request : bytes!
      }
        @description "Internal: the request as it goes on the wire."
        @tier "internal"
      HC_AFTER -> internal {
        n : number!
      }
        @description "Internal: no frame is complete; read more or go on by the stage."
        @tier "internal"
      HC_ADVANCE -> internal {
        n : number!
      }
        @description "Internal: decide what the bytes read so far allow."
        @tier "internal"
      HC_WANT -> internal {
      }
        @description "Internal: read more."
        @tier "internal"
      HC_HEAD -> internal {
        end : number!
      }
        @description "Internal: the head ends at this offset."
        @tier "internal"
      HC_SIZE -> internal {
        end : number!
      }
        @description "Internal: the chunk size line ends at this offset."
        @tier "internal"
      HC_FRAMED -> internal {
        n : number!
      }
        @description "Internal: body bytes were decoded; frame a stream or go on."
        @tier "internal"
      HC_FRAME {
        key : string!
        stream : string!
        data : bytes!
        final : boolean!
      }
        @description "Internal: the unframed stream bytes, for the framer."
        @tier "internal"
      HC_CONNECTED {
        sock : number!
        alpn : string
      }
        @description "Internal: the os/tcp-connect answer."
        @tier "internal"
      HC_SENT {
        bytes : number!
      }
        @description "Internal: the request was written."
        @tier "internal"
      HC_READ {
        data : bytes!
        eof : boolean!
      }
        @description "Internal: one os/recv answer."
        @tier "internal"
      HC_IO_FAILED {
        error : string
        kind : string
      }
        @description "Internal: a socket operation failed."
        @tier "internal"
      HC_CLOSED {
      }
        @description "Internal: the socket was closed."
        @tier "internal"
    }

    listens {
      HTTP_CLOSE {
      }
      HTTP_CANCEL {
        key : string!
      }
        @description "Abort the call with this key: its socket is closed (a connect that answers late is closed too; a send or read that answers late is dropped) and no HTTP_REPLIED, HTTP_STREAM_EVENT or HTTP_FAILED follows. A key that is not the call in flight, or no call, is a no-op."
      HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
        host : string
      }
      HC_CONNECTED {
        sock : number!
        alpn : string
      }
      HC_SENT {
        bytes : number!
      }
      HC_READ {
        data : bytes!
        eof : boolean!
      }
      HC_IO_FAILED {
        error : string
        kind : string
      }
      HC_CLOSED {
      }
      HC_FRAME_EVENT {
        key : string!
        data : string!
        event : string?
        id : string?
      }
      HC_DRAINED {
        rest : bytes!
      }
      HC_FRAME_FAILED {
        key : string!
        error : string!
        kind : string!
      }
      ClientFrame.FRAME_EVENT -> HC_FRAME_EVENT
      ClientFrame.FRAME_DRAINED -> HC_DRAINED
      ClientFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  page boot as HttpClientPage -> HttpClient, ClientFrame
}
