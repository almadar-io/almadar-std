app std-http-router [
  version: "1.0.0",
  env: ["VAPID_PUBLIC_KEY", "ORB_TICK_INVOKER"],
  description: "std-http-router — the request pipeline of an HTTP server program, between std-http1 and the policy and rate-limiter atoms. REQUEST_RECEIVED { requestId, method, path, query, headers, body, peer } starts one request; requests are told apart by requestId so any number are in flight at once. The router asks HTTP_DECIDE of std-http-policy and hears HTTP_DECIDED: a preflight is answered at once with the policy status and headers and an empty body, payload-too-large is answered 413 { error, code } as application/json, and an ok request whose path starts with apiPrefix is counted first (RATE_REQUEST, answered ADMITTED or THROTTLED by std-rate-limiter) while any other goes straight to routing. A throttled request is answered 429 as text/plain with the plain body Too many requests, please try again later. and ratelimit-* headers built from the verdict; an admitted one carries the same headers onto its answer. Routing is by method and path: GET healthPath answers 200 { status, version } as application/json, GET vapidPath answers 200 { publicKey } from env VAPID_PUBLIC_KEY or 404 { error } when unset; POST tickPath answers 404 when ORB_TICK_INVOKER is unset, otherwise verifies the bearer (email equals the invoker and email_verified true, else 401), runs program/tick for the authorized invoker and answers 200 { ran } or 500 { error, code TICK_ERROR }; every other request answers 404 { error, code }. Every answer is RESPOND { requestId, status, headers, body } for std-http1 to write and REQUEST_ANSWERED for the program; the request then leaves the pending list. Bound to spec/net/http-router.lolo; the other routes, the bearer guard, hooks, SSE and static files are not in this slice."
]
uses Spec from "almadar-std/http-router"
type RouterHeader = { name : string!, value : string! }
type RouterPending = { requestId : number!, method : string!, path : string!, query : string!, authorization : string!, ip : string!, ifNoneMatch : string!, responseHeaders : [RouterHeader]! }
type RouterTick = { trait : string!, tick : string! }
type RouterTickAnswer = { ran : [RouterTick]! }
type RouterStream = { requestId : number!, ticket : string! }
orbital HttpRouterOrbital {
  entity RouteRequest [runtime] {
    id : string!
    status : number @description "The status of the request last answered." = 0
    pending : [RouterPending] @description "Requests received and not yet answered, each with the policy headers to carry onto its answer." = []
    guards : [number] @description "Request ids waiting for a bearer verdict on a route that needs a verified viewer." = []
    mints : [number] @description "Request ids of ticket mints waiting for std-stream-ticket." = []
    streams : [RouterStream] @description "Stream requests waiting for their ticket to be spent." = []
    vapidKey : string @description "The public VAPID key read from VAPID_PUBLIC_KEY at INIT; empty when unset." = ""
    tickInvoker : string @description "The invoker identity read from ORB_TICK_INVOKER at INIT; empty when no invoker is named." = ""
    ticks : [number] @description "Request ids of tick calls waiting for a bearer verdict or a tick pass." = []
    @invariant (>= @entity.status 0)
  }

  trait HttpRouter -> RouteRequest [optimistic] {
    initial: routing

    config {
      requireSignIn : boolean = false
        @label "Require sign-in"
        @description "When on, a request under dispatchPrefix needs a verified bearer (401 UNAUTHORIZED otherwise); the ticket route always admits the anonymous viewer, and hooks, tick, push and health are outside the guard."
        @tier "infra"
      dispatchPrefix : string = "/api/orbitals"
        @label "Dispatch prefix"
        @description "A path starting with this is a dispatch route guarded by requireSignIn."
        @tier "infra"
      apiPrefix : string = "/api"
        @label "API prefix"
        @description "A path starting with this is counted by the rate limiter before it is routed."
        @tier "infra"
      ticketPath : string = "/api/events/ticket"
        @label "Ticket path"
        @description "The path a POST mints a stream ticket on for the anonymous viewer."
        @tier "infra"
      streamPath : string = "/api/events"
        @label "Stream path"
        @description "The path a GET opens the live stream on, with ?ticket=<t> in the query."
        @tier "infra"
      externalPrefixes : [string] = ["/api/trace"]
        @label "External prefixes"
        @description "A request whose path starts with any of these is left to another atom listening to the same REQUEST_RECEIVED: the router counts it, tells that atom ROUTE_EXTERNAL { requestId, responseHeaders } (the policy's CORS headers and the rate-limit headers, to carry onto its answer) and then drops it without answering or a 404."
        @tier "infra"
      healthPath : string = "/api/health"
        @label "Health path"
        @description "The path a GET answers 200 with the status and version."
        @tier "infra"
      vapidPath : string = "/api/push/vapid-public-key"
        @label "VAPID key path"
        @description "The path a GET answers 200 { publicKey } from VAPID_PUBLIC_KEY, or 404 when it is unset."
        @tier "infra"
      tickPath : string = "/api/tick"
        @label "Tick path"
        @description "The path a POST runs one tick pass on: 404 when ORB_TICK_INVOKER is unset, 401 unless the bearer is that verified invoker (email equal, email_verified true), then runs the host scheduler pass and answers 200 { ran }."
        @tier "infra"
      trustedProxyHops : number = 0
        @label "Trusted proxy hops"
        @description "How many proxies in front of this server append to X-Forwarded-For. 0 (the default) keys every request, the rate limit included, by the connection's peer address and ignores X-Forwarded-For. N > 0 takes the client address as the Nth entry from the right of X-Forwarded-For, the one the outermost trusted proxy appended; a header with fewer than N entries did not pass through the declared proxies and the peer address is used. Entries left of it are client-supplied and never read."
        @synonyms "proxy hops, x-forwarded-for, client ip, trust proxy"
        @tier "policy"
      clientFallback : boolean = false
        @label "Client fallback"
        @description "When on, a request no route owns is handed to std-static-files as ROUTE_CLIENT instead of answering 404."
        @tier "infra"
      version : string = "0.0.0"
        @label "Version"
        @description "The version GET healthPath reports."
        @tier "infra"
    }

    state routing {
      INIT -> routing
        (os/getenv "VAPID_PUBLIC_KEY" { emit: { success: VAPID_READ failure: VAPID_UNREAD } })
        (os/getenv "ORB_TICK_INVOKER" { emit: { success: INVOKER_READ failure: INVOKER_UNREAD } })
      VAPID_READ -> routing
        (set @entity.vapidKey (default @payload.value ""))
      VAPID_UNREAD -> routing
        (set @entity.vapidKey "")
      INVOKER_READ -> routing
        (set @entity.tickInvoker (default @payload.value ""))
      INVOKER_UNREAD -> routing
        (set @entity.tickInvoker "")
      REQUEST_RECEIVED -> routing when (= (str/to-number (default (object/get (default @payload.headers {}) "content-length") "0")) null)
        (emit RESPOND { requestId: @payload.requestId, status: 400, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Invalid Content-Length", code: "BAD_CONTENT_LENGTH" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 400, headers: [{ name: "content-type", value: "application/json" }], body: (json/stringify { error: "Invalid Content-Length", code: "BAD_CONTENT_LENGTH" }) })
      REQUEST_RECEIVED -> routing when (!= (str/to-number (default (object/get (default @payload.headers {}) "content-length") "0")) null)
        (set @entity.pending (array/append @entity.pending { requestId: @payload.requestId, method: @payload.method, path: @payload.path, query: (default @payload.query ""), authorization: (default (object/get (default @payload.headers {}) "authorization") ""), ifNoneMatch: (default (object/get (default @payload.headers {}) "if-none-match") ""), ip: (let ((peerIp (str/join (array/slice (str/split (default @payload.peer "") ":") 0 (- (array/len (str/split (default @payload.peer "") ":")) 1)) ":")) (forwarded (array/map (array/filter (str/split (default (object/get (default @payload.headers {}) "x-forwarded-for") "") ",") (fn h (!= (str/trim @h) ""))) (fn h (str/trim @h))))) (if (and (> @config.trustedProxyHops 0) (>= (array/len @forwarded) @config.trustedProxyHops)) (default (array/nth @forwarded (- (array/len @forwarded) @config.trustedProxyHops)) @peerIp) @peerIp)), responseHeaders: [] }))
        (emit HTTP_DECIDE {
          requestId: @payload.requestId,
          method: @payload.method,
          path: @payload.path,
          headers: (array/map (object/entries (default @payload.headers {})) (fn e { name: (default (array/first @e) ""), value: (default (array/nth @e 1) "") })),
          contentLength: (str/to-number (default (object/get (default @payload.headers {}) "content-length") "0"))
        })
      HTTP_DECIDED -> routing when (= @payload.verdict "preflight")
        (set @entity.status @payload.status)
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (emit RESPOND { requestId: @payload.requestId, status: @payload.status, headers: @payload.responseHeaders, body: (bytes/from-string "") })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: @payload.status, headers: @payload.responseHeaders, body: "" })
      HTTP_DECIDED -> routing when (= @payload.verdict "payload-too-large")
        (set @entity.status 413)
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (emit RESPOND { requestId: @payload.requestId, status: 413, headers: (array/append @payload.responseHeaders { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Payload too large", code: "PAYLOAD_TOO_LARGE" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 413, headers: (array/append @payload.responseHeaders { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Payload too large", code: "PAYLOAD_TOO_LARGE" }) })
      HTTP_DECIDED -> routing when (and (= @payload.verdict "ok") (str/startsWith (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) null (object/get @found "path"))) "") @config.apiPrefix))
        (set @entity.pending (array/map @entity.pending (fn p (if (= @p.requestId @payload.requestId) { requestId: @p.requestId, method: @p.method, path: @p.path, query: @p.query, authorization: @p.authorization, ip: @p.ip, ifNoneMatch: @p.ifNoneMatch, responseHeaders: @payload.responseHeaders } @p))))
        (emit RATE_REQUEST { requestId: @payload.requestId, ip: (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "ip"))) })
      HTTP_DECIDED -> routing when (and (= @payload.verdict "ok") (not (str/startsWith (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) null (object/get @found "path"))) "") @config.apiPrefix)))
        (set @entity.pending (array/map @entity.pending (fn p (if (= @p.requestId @payload.requestId) { requestId: @p.requestId, method: @p.method, path: @p.path, query: @p.query, authorization: @p.authorization, ip: @p.ip, ifNoneMatch: @p.ifNoneMatch, responseHeaders: @payload.responseHeaders } @p))))
        (emit ROUTE_REQUEST { requestId: @payload.requestId, rateHeaders: [] })
      ADMITTED -> routing when (= @payload.counted false)
        (emit ROUTE_REQUEST { requestId: @payload.requestId, rateHeaders: [] })
      ADMITTED -> routing when (not (= @payload.counted false))
        (emit ROUTE_REQUEST {
          requestId: @payload.requestId,
          rateHeaders: [
            { name: "ratelimit-policy", value: (str/concat "" @payload.limit ";w=" @payload.window) },
            { name: "ratelimit-limit", value: (str/concat "" @payload.limit) },
            { name: "ratelimit-remaining", value: (str/concat "" @payload.remaining) },
            { name: "ratelimit-reset", value: (str/concat "" @payload.resetIn) }
          ]
        })
      THROTTLED -> routing
        (set @entity.status 429)
        (emit RESPOND { requestId: @payload.requestId, status: 429, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) [
            { name: "ratelimit-policy", value: (str/concat "" @payload.limit ";w=" @payload.window) },
            { name: "ratelimit-limit", value: (str/concat "" @payload.limit) },
            { name: "ratelimit-remaining", value: "0" },
            { name: "ratelimit-reset", value: (str/concat "" @payload.resetIn) }
          ]) { name: "content-type", value: "text/plain; charset=utf-8" }), body: (bytes/from-string "Too many requests, please try again later.") })
        (emit REQUEST_RATE_LIMITED { requestId: @payload.requestId, resetSeconds: @payload.resetIn })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 429, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) [
            { name: "ratelimit-policy", value: (str/concat "" @payload.limit ";w=" @payload.window) },
            { name: "ratelimit-limit", value: (str/concat "" @payload.limit) },
            { name: "ratelimit-remaining", value: "0" },
            { name: "ratelimit-reset", value: (str/concat "" @payload.resetIn) }
          ]) { name: "content-type", value: "text/plain; charset=utf-8" }), body: "Too many requests, please try again later." })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.ticketPath))))
        (set @entity.mints (array/append @entity.mints @payload.requestId))
        (emit BEARER_VERIFY { requestId: @payload.requestId, authorization: (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) null (object/get @found "authorization"))) "") })
      BEARER_VERIFIED -> routing when (array/includes @entity.mints (default @payload.requestId 0))
        (emit MINT_REQUESTED { requestId: @payload.requestId, viewer: @payload.viewer })
      BEARER_ANONYMOUS -> routing when (array/includes @entity.mints (default @payload.requestId 0))
        (emit MINT_REQUESTED { requestId: @payload.requestId, viewer: { id: "anonymous", role: "anonymous", permissions: [], claims: [] } })
      BEARER_REFUSED -> routing when (array/includes @entity.mints (default @payload.requestId 0))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.mints (array/filter @entity.mints (fn m (!= @m @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and @config.requireSignIn (str/startsWith (object/get @req "path") @config.dispatchPrefix))))
        (set @entity.guards (array/append @entity.guards @payload.requestId))
        (emit BEARER_VERIFY { requestId: @payload.requestId, authorization: (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) null (object/get @found "authorization"))) "") })
      BEARER_VERIFIED -> routing when (array/includes @entity.guards (default @payload.requestId 0))
        (set @entity.status 404)
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (emit ROUTE_REFUSED { requestId: @payload.requestId })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 404, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Not found", code: "NOT_FOUND" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.guards (array/filter @entity.guards (fn m (!= @m @payload.requestId))))
      BEARER_ANONYMOUS -> routing when (array/includes @entity.guards (default @payload.requestId 0))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.guards (array/filter @entity.guards (fn m (!= @m @payload.requestId))))
      BEARER_REFUSED -> routing when (array/includes @entity.guards (default @payload.requestId 0))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.guards (array/filter @entity.guards (fn m (!= @m @payload.requestId))))
      TICKET_MINTED -> routing when (array/includes @entity.mints (default @payload.requestId 0))
        (set @entity.status 200)
        (emit RESPOND { requestId: @payload.requestId, status: 200, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { ticket: @payload.ticket })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.mints (array/filter @entity.mints (fn m (!= @m @payload.requestId))))
      TICKET_REFUSED -> routing when (and (= (default @payload.ticket "") "") (array/includes @entity.mints (default @payload.requestId 0)))
        (set @entity.status 503)
        (emit RESPOND { requestId: @payload.requestId, status: 503, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Stream ticket unavailable", code: "TICKET_UNAVAILABLE" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.mints (array/filter @entity.mints (fn m (!= @m @payload.requestId))))
      STREAM_CLOSED -> routing
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.streams (array/filter @entity.streams (fn s (!= @s.requestId @payload.requestId))))
        (set @entity.mints (array/filter @entity.mints (fn m (!= @m @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.streamPath)) (= (str/replace (default (array/find (str/split (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "query"))) "") "&") (fn s (str/startsWith @s "ticket="))) "") "ticket=" "") ""))))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.streamPath)) (!= (str/replace (default (array/find (str/split (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "query"))) "") "&") (fn s (str/startsWith @s "ticket="))) "") "ticket=" "") ""))))
        (set @entity.streams (array/append @entity.streams { requestId: @payload.requestId, ticket: (str/replace (default (array/find (str/split (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "query"))) "") "&") (fn s (str/startsWith @s "ticket="))) "") "ticket=" "") }))
        (emit STREAM_OPEN_REQUESTED { requestId: @payload.requestId, ticket: (str/replace (default (array/find (str/split (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "query"))) "") "&") (fn s (str/startsWith @s "ticket="))) "") "ticket=" ""), clientId: (str/replace (default (array/find (str/split (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "query"))) "") "&") (fn s (str/startsWith @s "clientId="))) "") "clientId=" "") })
      TICKET_TAKEN -> routing when (!= (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))) null)
        (emit SSE_OPEN { requestId: (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) -1 (object/get @found "requestId"))) })
        (emit STREAM_AUTHORIZED { requestId: (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) -1 (object/get @found "requestId"))), viewer: @payload.viewer, clientId: (str/replace (default (array/find (str/split (let ((found (array/find @entity.pending (fn p (= @p.requestId (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) null (object/get @found "requestId")))))))) (if (= @found null) "" (object/get @found "query"))) "&") (fn s (str/startsWith @s "clientId="))) "") "clientId=" "") })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) null (object/get @found "requestId")))))))
        (set @entity.streams (array/filter @entity.streams (fn s (!= @s.ticket @payload.ticket))))
      TICKET_REFUSED -> routing when (!= (array/find @entity.streams (fn s (= @s.ticket (default @payload.ticket "")))) null)
        (set @entity.status 401)
        (emit RESPOND { requestId: (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) -1 (object/get @found "requestId"))), status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) null (object/get @found "requestId")))))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId (let ((found (array/find @entity.streams (fn s (= @s.ticket @payload.ticket))))) (if (= @found null) null (object/get @found "requestId")))))))
        (set @entity.streams (array/filter @entity.streams (fn s (!= @s.ticket @payload.ticket))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (array/some @config.externalPrefixes (fn x (str/startsWith (object/get @req "path") @x)))))
        (emit ROUTE_EXTERNAL { requestId: @payload.requestId, responseHeaders: (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.healthPath))))
        (set @entity.status 200)
        (emit RESPOND { requestId: @payload.requestId, status: 200, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { status: "healthy", version: @config.version })) })
        (emit ROUTE_HEALTH { requestId: @payload.requestId })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 200, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (json/stringify { status: "healthy", version: @config.version }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.vapidPath) (!= @entity.vapidKey ""))))
        (set @entity.status 200)
        (emit RESPOND { requestId: @payload.requestId, status: 200, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { publicKey: @entity.vapidKey })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 200, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (json/stringify { publicKey: @entity.vapidKey }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.vapidPath) (= @entity.vapidKey ""))))
        (set @entity.status 404)
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Push is not configured (VAPID_PUBLIC_KEY unset)" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Push is not configured (VAPID_PUBLIC_KEY unset)" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.tickPath) (= @entity.tickInvoker ""))))
        (set @entity.status 404)
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "no tick invoker is configured (ORB_TICK_INVOKER)", code: "NOT_FOUND" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "no tick invoker is configured (ORB_TICK_INVOKER)", code: "NOT_FOUND" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.tickPath) (!= @entity.tickInvoker ""))))
        (set @entity.pending (array/map @entity.pending (fn p (if (= @p.requestId @payload.requestId) (object/merge @p { responseHeaders: (array/concat @p.responseHeaders @payload.rateHeaders) }) @p))))
        (set @entity.ticks (array/append @entity.ticks @payload.requestId))
        (emit BEARER_VERIFY { requestId: @payload.requestId, authorization: (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) null (object/get @found "authorization"))) "") })
      BEARER_VERIFIED -> routing when (and (array/includes @entity.ticks (default @payload.requestId 0)) (= (default (object/get @payload.viewer "email") "") @entity.tickInvoker) (= (object/get (default (array/find (default @payload.viewer.claims []) (fn c (= @c.name "email_verified"))) { value: false }) "value") true))
        (program/tick { key: (str/concat "tick-" @payload.requestId), emit: { success: TICK_ANSWERED, failure: TICK_FAILED } })
      TICK_ANSWERED -> routing when (array/some @entity.ticks (fn id (= (str/concat "tick-" @id) @payload.key)))
        (let ((id (default (array/find @entity.ticks (fn id (= (str/concat "tick-" @id) @payload.key))) 0)))
          (do
            (set @entity.status 200)
            (emit RESPOND { requestId: @id, status: 200, headers: (array/append (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @id))))) (if (= @found null) null (object/get @found "responseHeaders"))) []) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify @payload.result)) })
            (emit REQUEST_ANSWERED { requestId: @id, status: 200, headers: (array/append (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @id))))) (if (= @found null) null (object/get @found "responseHeaders"))) []) { name: "content-type", value: "application/json" }), body: (json/stringify @payload.result) })
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @id))))
            (set @entity.ticks (array/filter @entity.ticks (fn t (!= @t @id))))))
      TICK_FAILED -> routing when (array/some @entity.ticks (fn id (= (str/concat "tick-" @id) @payload.key)))
        (let ((id (default (array/find @entity.ticks (fn id (= (str/concat "tick-" @id) @payload.key))) 0)))
          (do
            (set @entity.status 500)
            (emit RESPOND { requestId: @id, status: 500, headers: (array/append (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @id))))) (if (= @found null) null (object/get @found "responseHeaders"))) []) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: @payload.error, code: "TICK_ERROR" })) })
            (emit REQUEST_ANSWERED { requestId: @id, status: 500, headers: (array/append (default (let ((found (array/find @entity.pending (fn p (= @p.requestId @id))))) (if (= @found null) null (object/get @found "responseHeaders"))) []) { name: "content-type", value: "application/json" }), body: (json/stringify { error: @payload.error, code: "TICK_ERROR" }) })
            (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @id))))
            (set @entity.ticks (array/filter @entity.ticks (fn t (!= @t @id))))))
      BEARER_VERIFIED -> routing when (and (array/includes @entity.ticks (default @payload.requestId 0)) (not (and (= (default (object/get @payload.viewer "email") "") @entity.tickInvoker) (= (object/get (default (array/find (default @payload.viewer.claims []) (fn c (= @c.name "email_verified"))) { value: false }) "value") true))))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.ticks (array/filter @entity.ticks (fn m (!= @m @payload.requestId))))
      BEARER_ANONYMOUS -> routing when (array/includes @entity.ticks (default @payload.requestId 0))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.ticks (array/filter @entity.ticks (fn m (!= @m @payload.requestId))))
      BEARER_REFUSED -> routing when (array/includes @entity.ticks (default @payload.requestId 0))
        (set @entity.status 401)
        (emit RESPOND { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 401, headers: (array/append (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
        (set @entity.ticks (array/filter @entity.ticks (fn m (!= @m @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and (not @config.clientFallback) (not (and @config.requireSignIn (str/startsWith (object/get @req "path") @config.dispatchPrefix))) (not (array/some @config.externalPrefixes (fn x (str/startsWith (object/get @req "path") @x)))) (not (or (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.healthPath)) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.streamPath)) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.ticketPath)) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.vapidPath)) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.tickPath)))))))
        (set @entity.status 404)
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (emit ROUTE_REFUSED { requestId: @payload.requestId })
        (emit REQUEST_ANSWERED { requestId: @payload.requestId, status: 404, headers: (array/append (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) { name: "content-type", value: "application/json" }), body: (json/stringify { error: "Not found", code: "NOT_FOUND" }) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
      ROUTE_REQUEST -> routing when (let ((req (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (and (!= @req null) (and @config.clientFallback (not (and @config.requireSignIn (str/startsWith (object/get @req "path") @config.dispatchPrefix))) (not (array/some @config.externalPrefixes (fn x (str/startsWith (object/get @req "path") @x)))) (not (or (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.healthPath)) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.streamPath)) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.ticketPath)) (and (= (str/upper (object/get @req "method")) "GET") (= (object/get @req "path") @config.vapidPath)) (and (= (str/upper (object/get @req "method")) "POST") (= (object/get @req "path") @config.tickPath)))))))
        (emit ROUTE_CLIENT { requestId: @payload.requestId, method: (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "method"))), path: (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "path"))), ifNoneMatch: (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) "" (object/get @found "ifNoneMatch"))), responseHeaders: (array/concat (let ((found (array/find @entity.pending (fn p (= @p.requestId @payload.requestId))))) (if (= @found null) [] (object/get @found "responseHeaders"))) @payload.rateHeaders) })
        (set @entity.pending (array/filter @entity.pending (fn p (!= @p.requestId @payload.requestId))))
    }

    emits {
      TICK_ANSWERED -> internal {
        key : string!
        result : RouterTickAnswer!
      }
      TICK_FAILED -> internal {
        key : string!
        error : string!
      }
      RESPOND -> external {
        requestId : number!
        status : number!
        headers : [RouterHeader]!
        body : bytes!
      }
        @description "Answer this request: status, headers and body for std-http1 to write."
        @tier "primary"
      REQUEST_ANSWERED -> external {
        requestId : number!
        status : number!
        headers : [RouterHeader]
        body : string!
      }
        @description "One request was answered with this status."
        @tier "primary"
      REQUEST_RATE_LIMITED -> external {
        requestId : number!
        resetSeconds : number!
      }
        @description "One request was throttled and answered 429."
        @tier "primary"
      ROUTE_CLIENT -> external {
        requestId : number!
        method : string!
        path : string!
        ifNoneMatch : string!
        responseHeaders : [RouterHeader]!
      }
        @description "A request no route owns, handed to std-static-files when clientFallback is on."
        @tier "secondary"
      ROUTE_EXTERNAL -> external {
        requestId : number!
        responseHeaders : [RouterHeader]!
      }
        @description "A request under an external prefix was admitted and left to another atom, with the headers its answer should carry."
        @tier "secondary"
      ROUTE_HEALTH -> external {
        requestId : number!
      }
        @description "GET healthPath was answered."
        @tier "secondary"
      ROUTE_REFUSED -> external {
        requestId : number!
      }
        @description "A path no route owns was answered 404."
        @tier "secondary"
      HTTP_DECIDE -> external {
        requestId : number!
        method : string!
        path : string!
        headers : [RouterHeader]!
        contentLength : number
      }
        @description "Ask std-http-policy about this request."
        @tier "secondary"
      RATE_REQUEST -> external {
        requestId : number!
        ip : string
      }
        @description "Count this request in std-rate-limiter."
        @tier "secondary"
      STREAM_OPEN_REQUESTED -> external {
        requestId : number!
        ticket : string!
        clientId : string!
      }
        @description "A GET on streamPath carries this ticket; std-stream-ticket is asked to spend it."
        @tier "secondary"
      BEARER_VERIFY -> external {
        requestId : number!
        authorization : string
      }
        @description "Ask std-bearer-verify to turn this request's Authorization header into a verdict."
        @tier "secondary"
      MINT_REQUESTED -> external {
        requestId : number!
        viewer : Viewer!
      }
        @description "A POST on ticketPath asks std-stream-ticket to mint a ticket for the viewer its bearer verdict gave: the verified viewer, or the anonymous one when it carried no Authorization header."
        @tier "secondary"
      SSE_OPEN -> external {
        requestId : number!
      }
        @description "The ticket was spent; open the stream for this request."
        @tier "secondary"
      STREAM_AUTHORIZED -> external {
        requestId : number!
        viewer : Viewer!
        clientId : string!
      }
        @description "A stream was opened for this viewer and client; the event fan-out subscribes it."
        @tier "primary"
      VAPID_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for VAPID_PUBLIC_KEY."
        @tier "internal"
      VAPID_UNREAD {
        error : string
        kind : string
      }
        @description "Internal: the os/getenv for VAPID_PUBLIC_KEY failed."
        @tier "internal"
      INVOKER_READ {
        value : string
      }
        @description "Internal: the os/getenv answer for ORB_TICK_INVOKER."
        @tier "internal"
      INVOKER_UNREAD {
        error : string
        kind : string
      }
        @description "Internal: the os/getenv for ORB_TICK_INVOKER failed."
        @tier "internal"
      ROUTE_REQUEST -> internal {
        requestId : number!
        rateHeaders : [RouterHeader]!
      }
        @description "Internal: this request passed the policy and the rate window and is ready to route."
        @tier "secondary"
    }

    listens {
      REQUEST_RECEIVED {
        requestId : number!
        method : string!
        path : string!
        query : string
        headers : Map string string
        body : bytes
        peer : string
      }
      HTTP_DECIDED {
        requestId : number!
        verdict : ("ok" | "preflight" | "payload-too-large")!
        status : number!
        responseHeaders : [RouterHeader]!
        compress : ("br" | "gzip" | "none")!
      }
      ADMITTED {
        requestId : number!
        remaining : number!
        resetIn : number!
        limit : number!
        window : number!
        counted : boolean
      }
      THROTTLED {
        requestId : number!
        resetIn : number!
        limit : number!
        window : number!
      }
      BEARER_VERIFIED {
        requestId : number
        viewer : Viewer!
      }
      BEARER_ANONYMOUS {
        requestId : number
      }
      BEARER_REFUSED {
        requestId : number
        reason : string!
      }
      TICKET_MINTED {
        ticket : string!
        expiresAt : instant!
        requestId : number
      }
      STREAM_CLOSED {
        requestId : number!
        reason : string!
      }
      TICKET_TAKEN {
        ticket : string!
        viewer : Viewer!
      }
      TICKET_REFUSED {
        code : string
        message : string!
        ticket : string
        requestId : number
      }
    }
  }

  page boot as HttpRouterOrbitalStart -> HttpRouter
}
