app std-http-server [
  version: "1.0.0",
  env: ["CORS_ORIGIN", "PORT", "VAPID_PUBLIC_KEY", "ORB_TICK_INVOKER", "ALMADAR_API_KEY_SALT", "NODE_ENV", "AUTH_PROVIDER", "OIDC_ISSUER_URL", "OIDC_AUDIENCE", "FIREBASE_PROJECT_ID", "FIREBASE_SERVICE_ACCOUNT_PATH", "FIREBASE_AUTH_EMULATOR_HOST", "FIRESTORE_EMULATOR_HOST", "ALMADAR_INTEGRATIONS_MODE"],
  egress: ["https://www.googleapis.com"],
  fs: { cwd: "dist/client/**": [read] },
  net: { "127.0.0.1:3000": [listen], "127.0.0.1", env PORT: [listen] },
  description: "std-http-server — the HTTP server program that replaces orbital-server, first slice, composed from atoms and owning no topology of its own. std-http-boot-gate reads the declared environment at boot and asks std-boot-env-check what keeps it from working in production: under NODE_ENV=production a problem refuses the boot (BOOT_REFUSED, the listener never starts), elsewhere it only warns (BOOT_WARNED); the missing-credential lines of the host's boot check are not asked yet, no operator hands the credential catalog or store to a program. std-http-policy reads CORS_ORIGIN at boot (a comma list, trimmed, blanks dropped) and answers CORS_CONFIGURED; once the gate has heard that and a cleared check it answers BOOT_CLEARED, which tells std-http1 to bind the host and port knobs. std-http1 reads each connection and delivers one typed request; std-http-router asks std-http-policy to decide it (a preflight and a 413 are answered at once), counts an /api request in std-rate-limiter unless the rateLimit knob is false (ADMITTED or THROTTLED, a throttled one is 429 with ratelimit-* headers), routes it by method and path (GET /api/health answers 200 { status, version }, every other path 404 { error, code }) and hands the answer back to std-http1 as RESPOND. Requests are correlated by requestId, so any number are in flight at once. Bound to spec/net/server.lolo. GET /api/events?ticket=<t> is the live stream: the router asks std-stream-ticket to spend the ticket, TICKET_TAKEN opens the stream through std-sse and std-http1 (RESPOND_HEAD/RESPOND_CHUNK/RESPOND_END, heartbeats, close on client disconnect), a missing or bad ticket is 401 { error, code }. POST /api/events/ticket mints a ticket for the anonymous viewer and answers 200 { ticket } (503 if the mint fails). std-live-feed then subscribes the opened stream to the host's live broadcast (a keyed program/live for the ticket's viewer and the ?clientId= tab) and writes each item as a { type: bus, event, payload?, source, timestamp } frame, so a change made in one tab reaches the others; the stream's close cancels the subscription. A bearer starting with the API key prefix goes only to std-api-key-verifier (prefix-exclusive, as the Rust WithApiKeys), anything else only to the JWT path; neither falls back. POST/GET under /api/orbitals (events, entity events, inputs, resolve-rows 501) are left by the router (externalPrefix) to std-http-dispatch, which dispatches through program/dispatch and answers the EventResponse wire; POST /api/hooks/:name delivers the body and headers to the program's inbound handler of that name through program/dispatch { inbound } and answers the handler's { status, body }."
]
uses Spec from "almadar-std/server"
uses H1 from "std/behaviors/std-http1"
uses Policy from "std/behaviors/std-http-policy"
uses Gate from "std/behaviors/std-http-boot-gate"
uses CredAdmin from "std/behaviors/std-credential-admin"
uses EnvCheck from "std/behaviors/std-boot-env-check"
uses Rate from "std/behaviors/std-rate-limiter-ip"
uses Router from "std/behaviors/std-http-router"
uses Dispatch from "std/behaviors/std-http-dispatch"
uses Static from "std/behaviors/std-static-files"
uses Sse from "std/behaviors/std-sse"
uses Feed from "std/behaviors/std-live-feed"
uses Compress from "std/behaviors/std-http-compress"
uses Gzip from "std/behaviors/std-gzip"
uses Brotli from "std/behaviors/std-brotli"
uses Ticket from "std/behaviors/std-stream-ticket"
uses Bearer from "std/behaviors/std-bearer-verify"
uses KeyVerifier from "std/behaviors/std-api-key-verifier"
uses Jws from "std/behaviors/std-jws"
uses Rsa from "std/behaviors/std-rsa"
uses Big from "std/behaviors/std-bigint"
uses Ecdsa from "std/behaviors/std-ecdsa"
uses X509 from "std/behaviors/std-x509"
orbital HttpServerOrbital {
  entity HttpServerProgram [runtime] {
    id : string!
  }

  entity StreamTicket [persistent: stream_tickets] {
    id : string! @description "The ticket: 32 CSPRNG bytes, base64url."
    viewer : Viewer! @description "The viewer the ticket was minted for."
    expiresAt : number @description "When the ticket stops working, in epoch milliseconds." = 0
  }

  entity ApiKeyRecord [persistent: api_keys] {
    id : string! @description "The key's scrypt hash: what a presented bearer is looked up by."
    lastFour : string @description "The key's last four characters." = ""
    label : string @description "A name the owner gave the key." = ""
    owner : string @description "Who the key acts as." = ""
    revoked : boolean @description "Whether the key has been revoked and no longer works." = false
    expiresAt : number @description "When the key stops working, in epoch milliseconds; 0 means never." = 0
  }

  config {
    host : string = "127.0.0.1"
      @label "Host"
      @description "The address the HTTP endpoint binds."
      @synonyms "bind address, listen host"
      @tier "policy"
    port : number = 3000
      @label "Port"
      @description "The port the HTTP endpoint binds; the PORT environment variable replaces it at LISTEN while portFromEnv is on."
      @synonyms "listen port"
      @tier "policy"
    portFromEnv : boolean = true
      @label "Port from environment"
      @description "At LISTEN the PORT environment variable replaces port (granted by the env PORT listen grant)."
      @tier "domain"
    clientDir : string = "dist/client"
      @label "Client directory"
      @description "The built web client the server serves, relative to the working directory."
      @tier "domain"
    rateLimit : boolean = true
      @label "Rate limit"
      @description "Whether /api requests are counted against the per-client window and throttled; off takes the limiter out of the request path (replaces ORB_DISABLE_RATE_LIMIT)."
      @synonyms "throttle, disable rate limit, request cap"
      @tier "policy"
    trustedProxyHops : number = 0
      @label "Trusted proxy hops"
      @description "How many proxies in front of the server append to X-Forwarded-For; the client address that keys the rate limit is the Nth entry from the right. 0 (the default) uses the connection's peer address and ignores X-Forwarded-For. Set it to exactly the proxies the deployment controls: a larger number lets a client choose its own address."
      @synonyms "proxy hops, x-forwarded-for, client ip, trust proxy"
      @tier "policy"
    calledServices : [string] = []
      @label "Called services"
      @description "The services the hosted program calls; the boot check asks for each one's required credentials unless integrations are mocked. Empty asks for none."
      @tier "domain"
    mock : boolean = false
      @label "Mock integrations"
      @description "Whether integrations are mocked regardless of the environment (the --mock flag); a mocked deployment is not asked for its integration credentials."
      @tier "policy"
  }

  trait Http1 = H1.traits.Http1 {
    config {
      host: @config.host
      port: @config.port
      portFromEnv: @config.portFromEnv
    }
    listens {
      BootGuard.BOOT_CLEARED -> LISTEN
      ServerCompress.RESPOND -> SEND_RESPONSE
      ServerSse.RESPOND_HEAD -> RESPOND_HEAD
      ServerSse.RESPOND_CHUNK -> RESPOND_CHUNK
      ServerSse.RESPOND_END -> RESPOND_END
    }
  }

  trait ServerCompress = Compress.traits.HttpCompress {
    listens {
      Http1.REQUEST_RECEIVED -> REQUEST_RECEIVED
      Http1.STREAM_CLOSED -> STREAM_CLOSED
      ServerRouter.RESPOND -> ANSWER
      ServerStatic.RESPOND -> ANSWER
      ServerDispatch.RESPOND -> ANSWER
      CompressPolicy.HTTP_DECIDED -> HTTP_DECIDED
      CompressGzip.GZIP_ANSWERED -> GZIP_ANSWERED
      CompressGzip.GZIP_REFUSED -> GZIP_REFUSED
      CompressBrotli.BROTLI_ANSWERED -> BROTLI_ANSWERED
    }
  }

  trait CompressPolicy = Policy.traits.HttpPolicy {
    config {
      originsFromEnv: false
    }
    listens {
      ServerCompress.HTTP_DECIDE -> HTTP_DECIDE
    }
  }

  trait CompressGzip = Gzip.traits.Gunzip {
    listens {
      ServerCompress.GZIP -> GZIP
    }
  }

  trait CompressBrotli = Brotli.traits.Brotli {
    config {
      quality: 4
    }
    listens {
      ServerCompress.BROTLI -> BROTLI
    }
  }

  trait BootGuard = Gate.traits.BootGate {
    config {
      mock: @config.mock
      calledServices: @config.calledServices
    }
    listens {
      BootCheck.ENV_CHECKED -> ENV_CHECKED
      BootCreds.CRED_ADMIN_OWED -> CRED_ADMIN_OWED
      ServerPolicy.CORS_CONFIGURED -> CORS_CONFIGURED
      CompressPolicy.CORS_CONFIGURED -> CORS_CONFIGURED
    }
  }

  trait BootCreds = CredAdmin.traits.CredentialAdmin {
    listens {
      BootGuard.CRED_ADMIN_BOOT_CHECK -> CRED_ADMIN_BOOT_CHECK
    }
  }

  trait BootCheck = EnvCheck.traits.BootEnvCheck {
    listens {
      BootGuard.ENV_CHECK -> ENV_CHECK
    }
  }

  trait ServerPolicy = Policy.traits.HttpPolicy {
    listens {
      ServerRouter.HTTP_DECIDE -> HTTP_DECIDE
    }
  }

  trait ServerRateLimiter = Rate.traits.RateKeyRateLimiter {
    config {
      enabled: @config.rateLimit
      requestsPerMinute: 300
      windowSeconds: 900
    }
    listens {
      ServerRouter.RATE_REQUEST -> REQUEST
    }
  }

  trait ServerRouter = Router.traits.HttpRouter {
    config {
      clientFallback: true
      externalPrefixes: ["/api/orbitals", "/api/hooks/"]
      trustedProxyHops: @config.trustedProxyHops
    }
    listens {
      Http1.REQUEST_RECEIVED -> REQUEST_RECEIVED
      ServerPolicy.HTTP_DECIDED -> HTTP_DECIDED
      ServerRateLimiter.ADMITTED -> ADMITTED
      ServerRateLimiter.THROTTLED -> THROTTLED
      StreamTicketer.TICKET_MINTED -> TICKET_MINTED
      Http1.STREAM_CLOSED -> STREAM_CLOSED
      StreamTicketer.TICKET_TAKEN -> TICKET_TAKEN
      StreamTicketer.TICKET_REFUSED -> TICKET_REFUSED
      ServerBearer.BEARER_VERIFIED -> BEARER_VERIFIED
      ServerBearer.BEARER_ANONYMOUS -> BEARER_ANONYMOUS
      ServerBearer.BEARER_REFUSED -> BEARER_REFUSED
    }
  }

  trait ServerDispatch = Dispatch.traits.ServerDispatch {
    listens {
      Http1.REQUEST_RECEIVED -> REQUEST_RECEIVED
      ServerRouter.ROUTE_EXTERNAL -> ROUTE_EXTERNAL
      ServerRouter.REQUEST_ANSWERED -> REQUEST_ANSWERED
      ServerStatic.REQUEST_ANSWERED -> REQUEST_ANSWERED
      ServerBearer.BEARER_VERIFIED -> BEARER_VERIFIED
      ServerBearer.BEARER_ANONYMOUS -> BEARER_ANONYMOUS
      ServerBearer.BEARER_REFUSED -> BEARER_REFUSED
    }
  }

  trait ServerStatic = Static.traits.StaticFiles {
    config {
      clientDir: @config.clientDir
    }
    listens {
      ServerRouter.ROUTE_CLIENT -> ROUTE_CLIENT
    }
  }

  trait ServerBearer = Bearer.traits.BearerVerifier {
    config {
      issuerFromEnv: true
    }
    listens {
      ApiKeys.API_KEY_VERIFIED -> API_KEY_VERIFIED
      ApiKeys.API_KEY_REFUSED -> API_KEY_REFUSED
      ServerRouter.BEARER_VERIFY -> BEARER_VERIFY
      ServerDispatch.BEARER_VERIFY -> BEARER_VERIFY
      BearerJws.JWS_VERIFIED -> JWS_VERIFIED
      BearerJws.JWS_REFUSED -> JWS_REFUSED
      BearerX509.X509_PARSED -> X509_PARSED
      BearerX509.X509_REFUSED -> X509_REFUSED
    }
  }

  trait BearerX509 = X509.traits.X509Parse {
    listens {
      ServerBearer.X509_PARSE -> X509_PARSE
    }
  }

  trait ApiKeys = KeyVerifier.traits.ApiKeyVerifier {
    listens {
      ServerBearer.VERIFY_KEY -> VERIFY_KEY
    }
  }

  trait BearerBig = Big.traits.BigIntCodec {
    listens {
      BearerRsa.RSA_FROM_BYTES -> FROM_BYTES
      BearerRsa.RSA_COMPARE -> COMPARE
      BearerRsa.RSA_MODPOW -> MODPOW
      BearerRsa.RSA_TO_BYTES -> TO_BYTES
    }
  }

  trait BearerRsa = Rsa.traits.RsaVerifier {
    listens {
      BearerJws.JWS_RSA_VERIFY -> RSA_VERIFY
      BearerBig.FROM_BYTES_ANSWERED -> BIG_DECODED
      BearerBig.COMPARE_ANSWERED -> BIG_COMPARED
      BearerBig.MODPOW_ANSWERED -> BIG_POWERED
      BearerBig.TO_BYTES_ANSWERED -> BIG_ENCODED
      BearerBig.BIGINT_REFUSED -> BIG_REFUSED
    }
  }

  trait BearerEcBig = Big.traits.BigIntCodec {
    listens {
      BearerEc.EC_FROM_BYTES -> FROM_BYTES
      BearerEc.EC_COMPARE -> COMPARE
      BearerEc.EC_MODINV -> MODINV
      BearerEc.EC_MUL -> MUL
      BearerEc.EC_MOD -> MOD
    }
  }

  trait BearerEc = Ecdsa.traits.EcdsaVerifier {
    listens {
      BearerJws.JWS_EC_VERIFY -> ECDSA_VERIFY
      BearerEcBig.FROM_BYTES_ANSWERED -> BIG_DECODED
      BearerEcBig.COMPARE_ANSWERED -> BIG_COMPARED
      BearerEcBig.MODINV_ANSWERED -> BIG_INVERTED
      BearerEcBig.MUL_ANSWERED -> BIG_MULTIPLIED
      BearerEcBig.MOD_ANSWERED -> BIG_REMAINDER
      BearerEcBig.BIGINT_REFUSED -> BIG_REFUSED
    }
  }

  trait BearerJws = Jws.traits.JwsVerifier {
    listens {
      ServerBearer.JWS_VERIFY -> JWS_VERIFY
      BearerRsa.RSA_VERIFIED -> RSA_OK
      BearerRsa.RSA_REFUSED -> RSA_NO
      BearerEc.ECDSA_VERIFIED -> EC_OK
      BearerEc.ECDSA_REFUSED -> EC_NO
    }
  }

  trait StreamTicketer = Ticket.traits.StreamTicketer {
    listens {
      ServerRouter.STREAM_OPEN_REQUESTED -> TAKE_TICKET
      ServerRouter.MINT_REQUESTED -> MINT_TICKET
    }
  }

  trait ServerSse = Sse.traits.Sse {
    listens {
      ServerRouter.SSE_OPEN -> SSE_OPEN
      ServerDispatch.SSE_OPEN -> SSE_OPEN
      ServerDispatch.SSE_SEND -> SSE_SEND
      ServerDispatch.SSE_CLOSE -> SSE_CLOSE
      ServerLiveFeed.SSE_SEND -> SSE_SEND
      ServerLiveFeed.SSE_CLOSE -> SSE_CLOSE
      Http1.STREAM_IDLE -> STREAM_IDLE
      Http1.STREAM_CLOSED -> STREAM_CLOSED
    }
  }

  trait ServerLiveFeed = Feed.traits.LiveFeed {
    listens {
      ServerRouter.STREAM_AUTHORIZED -> STREAM_AUTHORIZED
      ServerSse.SSE_CLOSED -> SSE_CLOSED
    }
  }

  page http { host: @config.host, port: @config.port, path: "/" } as Api -> BootGuard, BootCreds, BootCheck, Http1, ServerPolicy, ServerRateLimiter, ServerRouter, ServerDispatch, ServerStatic, ServerCompress, CompressPolicy, CompressGzip, CompressBrotli, StreamTicketer, ServerSse, ServerLiveFeed, ServerBearer, ApiKeys, BearerJws, BearerX509, BearerRsa, BearerBig, BearerEc, BearerEcBig
}
