{
  "description": "std-page-search — runs one search on a site in a background tab: opens `searchUrl` with the query as the `queryParam` parameter, reads up to `maxResults` elements matching `resultSelector` (waiting up to `waitMs` for the results to appear), closes the tab, and reports RESULTS with the fields read from each. One search at a time: SEARCH is accepted again once RESULTS or SEARCH_FAILED is reported. It never clicks anything. Needs a host with the `page` service (a browser extension with access to the search pages).",
  "ledger": {
    "entries": {
      "ent_01M431PMYFFV3AXQCTDF8PDBSK": {
        "bakedName": "PageSearchRecord",
        "curName": "PageSearchRecord",
        "id": "ent_01M431PMYFFV3AXQCTDF8PDBSK",
        "kind": "entity",
        "owner": "workspace",
        "renames": []
      },
      "evt_01M431PMYF0GMPGSCESN3GPAVD": {
        "bakedName": "TAB_OPENED",
        "curName": "TAB_OPENED",
        "id": "evt_01M431PMYF0GMPGSCESN3GPAVD",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYF3XJS2JVHD73VS0NB": {
        "bakedName": "RESULTS_READ",
        "curName": "RESULTS_READ",
        "id": "evt_01M431PMYF3XJS2JVHD73VS0NB",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYF43RSRVDHQVS7T6ZS": {
        "bakedName": "SEARCH",
        "curName": "SEARCH",
        "id": "evt_01M431PMYF43RSRVDHQVS7T6ZS",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYF7T08MQPSJ2EHXT1V": {
        "bakedName": "SEARCH_FAILED",
        "curName": "SEARCH_FAILED",
        "id": "evt_01M431PMYF7T08MQPSJ2EHXT1V",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYFFDAVS6XHWBM6PMK7": {
        "bakedName": "SEARCH_CALL_FAILED",
        "curName": "SEARCH_CALL_FAILED",
        "id": "evt_01M431PMYFFDAVS6XHWBM6PMK7",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYFGR7XGF0Q8JMF1QK9": {
        "bakedName": "RESULTS",
        "curName": "RESULTS",
        "id": "evt_01M431PMYFGR7XGF0Q8JMF1QK9",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "evt_01M431PMYFM6PAHXRH26X3ABMC": {
        "bakedName": "INIT",
        "curName": "INIT",
        "id": "evt_01M431PMYFM6PAHXRH26X3ABMC",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M431PMYFCQ3KGNQ8M6PR63XH",
        "renames": []
      },
      "orb_01M431PMYFFWS5D4TGQ03C461C": {
        "bakedName": "PageSearchOrbital",
        "curName": "PageSearchOrbital",
        "id": "orb_01M431PMYFFWS5D4TGQ03C461C",
        "kind": "orbital",
        "owner": "workspace",
        "renames": []
      },
      "pag_01M431PMYFKQD11Q93ASZHEM7A": {
        "bakedName": "PageSearchPage",
        "curName": "PageSearchPage",
        "id": "pag_01M431PMYFKQD11Q93ASZHEM7A",
        "kind": "page",
        "owner": "workspace",
        "renames": []
      },
      "trt_01M431PMYFCQ3KGNQ8M6PR63XH": {
        "bakedName": "PageSearch",
        "curName": "PageSearch",
