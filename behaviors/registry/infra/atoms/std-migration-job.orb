            "name": "target",
            "type": "string"
          },
          {
            "default": "idle",
            "description": "Lifecycle position of the run.",
            "name": "status",
            "type": "string",
            "values": [
              "idle",
              "fetching",
              "mapping",
              "reviewing",
              "committing",
              "done",
