                "tier": "secondary"
              },
              {
                "description": "Source documents are listed and the run is ready for staging (deterministic pipeline or agent)",
                "id": "evt_01KYEH1JHZ108ZC0A25A791JJG",
                "key": "MIGRATION_FETCHED",
                "name": "Migration Fetched",
                "payloadSchema": [
                  {
                    "name": "documents",
                    "required": true,
                    "type": "[opaque]"
                  }
                ],
                "synonyms": "import fetched, source listed, documents ready",
                "tier": "domain"
              },
              {
                "description": "A single fetched document's content, for the host staging layer to map into target units",
                "id": "evt_01KYEH1JHZYBNE7SNEH4YSB3AJ",
                "key": "MIGRATION_DOCUMENT",
                "name": "Migration Document",
                "payloadSchema": [
                  {
                    "name": "document",
                    "required": true,
                    "type": "opaque"
                  }
                ],
                "synonyms": "document loaded, content fetched",
                "tier": "domain"
              },
              {
                "description": "migration service call failure signal — lands the run in failed, never a silent swallow",
                "id": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "key": "MIGRATION_CALL_FAILED",
                "name": "Migration Call Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Fetch one document's full content from the source during staging",
                "id": "evt_01KYEH1JHZCM65W3K5JPH22W1Y",
                "key": "FETCH_DOCUMENT",
                "name": "Fetch Document",
                "payloadSchema": [
                  {
                    "name": "documentId",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "internal"
              },
              {
                "description": "migration.fetchDocument service result, flattened onto the payload by the call-service effect executor",
                "id": "evt_01KYEH1JHZYH9ESEMWYAGG5V20",
                "key": "DOCUMENT_FETCHED",
                "name": "Document Fetched",
                "payloadSchema": [
                  {
                    "name": "document",
                    "required": true,
                    "type": "opaque"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Host staging finished — units are staged and validated; stats summarize staged/skipped counts for the preview. units/skipped/validationErrors optionally carry the full staged rows (server ImportPreview shape) so reviewing can render an ImportPreviewTree instead of staying headless.",
                "id": "evt_01KYEH1JHZTCZZE53EY6264JTY",
                "key": "MIGRATION_STAGED",
                "name": "Migration Staged",
                "payloadSchema": [
                  {
                    "name": "stats",
                    "required": true,
                    "type": "opaque"
                  },
                  {
                    "name": "units",
                    "properties": [
                      {
                        "name": "ref",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "targetEntity",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "fields",
                        "type": "Map<string,scalar>"
                      },
                      {
                        "name": "parentRef",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  },
                  {
                    "name": "skipped",
                    "properties": [
                      {
                        "name": "ref",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "reason",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  },
                  {
                    "name": "validationErrors",
                    "type": "[opaque]"
                  }
                ],
                "tier": "internal"
              },
              {
                "description": "The run was discarded before commit",
                "id": "evt_01KYEH1JHZXK69X09ZRB3JFTX8",
                "key": "MIGRATION_DISCARDED",
                "name": "Migration Discarded",
                "tier": "internal"
              },
              {
                "description": "The user approved the preview; units are the staged ImportUnits to commit through the host sink. Optional — the ImportPreviewTree's onConfirm fires with no payload, so commit falls back to the units already staged on the entity via MIGRATION_STAGED.",
                "id": "evt_01KYEH1JHZANEQQJWVAQWKE7T8",
                "key": "MIGRATION_APPROVED",
                "name": "Migration Approved",
                "payloadSchema": [
                  {
                    "name": "units",
                    "properties": [
                      {
                        "name": "ref",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "targetEntity",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "fields",
                        "type": "Map<string,scalar>"
                      },
                      {
                        "name": "parentRef",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "approve import, confirm migration",
                "tier": "domain"
              },
              {
                "description": "The user sent the preview back for more staging",
                "id": "evt_01KYEH1JHZ67GY1VYWWG8FJN5M",
                "key": "MIGRATION_REJECTED",
                "name": "Migration Rejected",
                "tier": "internal"
              },
              {
                "description": "Staging is complete; the preview is ready for the approval gate. units/skipped/validationErrors forward the full staged rows when the host staged them, for a review-before-commit UI; stats-only hosts leave them empty.",
                "id": "evt_01KYEH1JHZQQGPZ8285ZJA0W2Z",
                "key": "MIGRATION_REVIEW_READY",
                "name": "Migration Review Ready",
                "payloadSchema": [
                  {
                    "name": "stats",
                    "required": true,
                    "type": "opaque"
                  },
                  {
                    "name": "units",
                    "type": "[ImportUnit]"
                  },
                  {
                    "name": "skipped",
                    "type": "[ImportSkip]"
                  },
                  {
                    "name": "validationErrors",
                    "type": "[opaque]"
                  }
                ],
                "synonyms": "preview ready, staging complete, review import",
                "tier": "domain"
              },
              {
                "description": "migration.commit service result — committed count plus per-unit failures",
                "id": "evt_01KYEH1JHZMFZQV6JQ7BF49TGJ",
                "key": "COMMITTED",
                "name": "Committed",
                "payloadSchema": [
                  {
                    "name": "committed",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "failed",
                    "required": true,
                    "type": "[opaque]"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Returns the job to idle from a terminal state",
                "id": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "key": "RESET",
                "name": "Reset",
                "tier": "internal"
              },
              {
                "description": "The commit drained through the host sink; stats carry committed and per-unit failed counts",
                "id": "evt_01KYEH1JHZKCD8JKV9CAHZG2JC",
                "key": "MIGRATION_COMPLETED",
                "name": "Migration Completed",
                "payloadSchema": [
                  {
                    "name": "stats",
                    "required": true,
                    "type": "opaque"
                  }
                ],
                "synonyms": "import done, migration complete, data imported",
                "tier": "domain"
              },
              {
                "description": "Re-runs the fetch after a failure, with the same source",
                "id": "evt_01KYEH1JHZ4P70WNXP5KD40DQD",
                "key": "MIGRATION_RETRY",
                "name": "Migration Retry",
                "tier": "internal"
              },
              {
                "description": "The run failed; error carries the service-reported detail and the terminal job row was persisted",
                "id": "evt_01KYEH1JHZFMZPRSAAAW5SNS5H",
                "key": "MIGRATION_FAILED",
                "name": "Migration Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "import failed, migration error",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "fetching"
              },
              {
                "name": "mapping"
              },
              {
                "name": "reviewing"
              },
              {
                "name": "committing"
              },
              {
                "name": "done"
              },
              {
                "name": "failed"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ],
                  [
                    "set",
                    "@entity.units",
                    []
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    []
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    []
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYEH1JHZS686HZ1PSX9E41SN",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.source",
                    "@payload.source"
                  ],
                  [
                    "set",
                    "@entity.files",
                    "@payload.files"
                  ],
                  [
                    "set",
                    "@entity.target",
                    "@config.target"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "fetching"
                  ],
                  [
                    "set",
                    "@entity.createdAt",
                    [
                      "time/now"
                    ]
                  ],
                  [
                    "call-service",
                    "migration",
                    "listDocuments",
                    {
                      "connectionRef": "@config.connectionRef",
                      "files": "@entity.files",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENTS_LISTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_START",
                "eventId": "evt_01KYEH1JHZVA84NGHKV4DNKKZ8",
                "from": "idle",
                "to": "fetching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.documents",
                    "@payload.documents"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "mapping"
                  ],
                  [
                    "emit",
                    "MIGRATION_FETCHED",
                    {
                      "documents": "@entity.documents"
                    }
                  ]
                ],
                "event": "DOCUMENTS_LISTED",
                "eventId": "evt_01KYEH1JHZE908KJFCWPSJ231V",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_FETCHED",
                "eventId": "evt_01KYEH1JHZ108ZC0A25A791JJG",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_DOCUMENT",
                "eventId": "evt_01KYEH1JHZYBNE7SNEH4YSB3AJ",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "fetching",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "call-service",
                    "migration",
                    "fetchDocument",
                    {
                      "connectionRef": "@config.connectionRef",
                      "documentId": "@payload.documentId",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENT_FETCHED"
                      }
                    }
                  ]
                ],
                "event": "FETCH_DOCUMENT",
                "eventId": "evt_01KYEH1JHZCM65W3K5JPH22W1Y",
                "from": "mapping",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.document",
                    "@payload.document"
                  ],
                  [
                    "emit",
                    "MIGRATION_DOCUMENT",
                    {
                      "document": "@entity.document"
                    }
                  ]
                ],
                "event": "DOCUMENT_FETCHED",
                "eventId": "evt_01KYEH1JHZYH9ESEMWYAGG5V20",
                "from": "mapping",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.stats",
                    "@payload.stats"
                  ],
                  [
                    "set",
                    "@entity.units",
                    [
                      "or",
                      "@payload.units",
                      []
                    ]
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    [
                      "or",
                      "@payload.skipped",
                      []
                    ]
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    [
                      "or",
                      "@payload.validationErrors",
                      []
                    ]
                  ],
                  [
                    "set",
                    "@entity.status",
                    "reviewing"
                  ],
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    {
                      "cancelLabel": "Discard",
                      "confirmLabel": "Approve import",
                      "entityDisplay": {},
                      "onCancel": "MIGRATION_DISCARDED",
                      "onConfirm": "MIGRATION_APPROVED",
                      "skipped": "@entity.skipped",
                      "type": "import-preview-tree",
                      "units": "@entity.units"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_REVIEW_READY",
                    {
                      "skipped": "@entity.skipped",
                      "stats": "@entity.stats",
                      "units": "@entity.units",
                      "validationErrors": "@entity.validationErrors"
                    }
                  ]
                ],
                "event": "MIGRATION_STAGED",
                "eventId": "evt_01KYEH1JHZTCZZE53EY6264JTY",
                "from": "mapping",
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ],
                  [
                    "set",
                    "@entity.units",
                    []
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    []
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    []
                  ]
                ],
                "event": "MIGRATION_DISCARDED",
                "eventId": "evt_01KYEH1JHZXK69X09ZRB3JFTX8",
                "from": "mapping",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "mapping",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "committing"
                  ],
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    null
                  ],
                  [
                    "call-service",
                    "migration",
                    "commit",
                    {
                      "jobId": "@entity.id",
                      "units": [
                        "or",
                        "@payload.units",
                        "@entity.units"
                      ]
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "COMMITTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_APPROVED",
                "eventId": "evt_01KYEH1JHZANEQQJWVAQWKE7T8",
                "from": "reviewing",
                "to": "committing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "mapping"
                  ],
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    null
                  ]
                ],
                "event": "MIGRATION_REJECTED",
                "eventId": "evt_01KYEH1JHZ67GY1VYWWG8FJN5M",
                "from": "reviewing",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_REVIEW_READY",
                "eventId": "evt_01KYEH1JHZQQGPZ8285ZJA0W2Z",
                "from": "reviewing",
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ],
                  [
                    "set",
                    "@entity.units",
                    []
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    []
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    []
                  ],
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    null
                  ]
                ],
                "event": "MIGRATION_DISCARDED",
                "eventId": "evt_01KYEH1JHZXK69X09ZRB3JFTX8",
                "from": "reviewing",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.stats",
                    [
                      "object/merge",
                      "@entity.stats",
                      {
                        "committed": "@payload.committed",
                        "failed": "@payload.failed"
                      }
                    ]
                  ],
                  [
                    "set",
                    "@entity.status",
                    "done"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_COMPLETED",
                    {
                      "stats": "@entity.stats"
                    }
                  ]
                ],
                "event": "COMMITTED",
                "eventId": "evt_01KYEH1JHZMFZQV6JQ7BF49TGJ",
                "from": "committing",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "committing",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ],
                  [
                    "set",
                    "@entity.units",
                    []
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    []
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    []
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "from": "done",
                "to": "idle"
              },
              {
                "event": "MIGRATION_COMPLETED",
                "eventId": "evt_01KYEH1JHZKCD8JKV9CAHZG2JC",
                "from": "done",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "fetching"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "call-service",
                    "migration",
                    "listDocuments",
                    {
                      "connectionRef": "@config.connectionRef",
                      "files": "@entity.files",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENTS_LISTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_RETRY",
                "eventId": "evt_01KYEH1JHZ4P70WNXP5KD40DQD",
                "from": "failed",
                "to": "fetching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ],
                  [
                    "set",
                    "@entity.units",
                    []
                  ],
                  [
                    "set",
                    "@entity.skipped",
                    []
                  ],
                  [
                    "set",
                    "@entity.validationErrors",
                    []
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "from": "failed",
                "to": "idle"
              },
              {
                "event": "MIGRATION_FAILED",
                "eventId": "evt_01KYEH1JHZFMZPRSAAAW5SNS5H",
                "from": "failed",
                "to": "failed"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}