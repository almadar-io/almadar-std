                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Returns the job to idle from a terminal state",
                "id": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "key": "RESET",
                "name": "Reset",
                "tier": "internal"
              },
              {
                "description": "The commit drained through the host sink; stats carry committed and per-unit failed counts",
                "id": "evt_01KYEH1JHZKCD8JKV9CAHZG2JC",
                "key": "MIGRATION_COMPLETED",
                "name": "Migration Completed",
                "payloadSchema": [
                  {
                    "name": "stats",
                    "required": true,
                    "type": "object"
                  }
                ],
                "synonyms": "import done, migration complete, data imported",
                "tier": "domain"
              },
              {
                "description": "Re-runs the fetch after a failure, with the same source",
                "id": "evt_01KYEH1JHZ4P70WNXP5KD40DQD",
                "key": "MIGRATION_RETRY",
                "name": "Migration Retry",
                "tier": "internal"
              },
              {
                "description": "The run failed; error carries the service-reported detail and the terminal job row was persisted",
                "id": "evt_01KYEH1JHZFMZPRSAAAW5SNS5H",
                "key": "MIGRATION_FAILED",
                "name": "Migration Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "import failed, migration error",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "fetching"
              },
              {
                "name": "mapping"
              },
              {
                "name": "reviewing"
              },
              {
                "name": "committing"
              },
              {
                "name": "done"
              },
              {
                "name": "failed"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYEH1JHZS686HZ1PSX9E41SN",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.source",
                    "@payload.source"
                  ],
                  [
                    "set",
                    "@entity.files",
                    "@payload.files"
                  ],
                  [
                    "set",
                    "@entity.target",
                    "@config.target"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "fetching"
                  ],
                  [
                    "set",
                    "@entity.createdAt",
                    [
                      "time/now"
                    ]
                  ],
                  [
                    "call-service",
                    "migration",
                    "listDocuments",
                    {
                      "connectionRef": "@config.connectionRef",
                      "files": "@entity.files",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENTS_LISTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_START",
                "eventId": "evt_01KYEH1JHZVA84NGHKV4DNKKZ8",
                "from": "idle",
                "to": "fetching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.documents",
                    "@payload.documents"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "mapping"
                  ],
                  [
                    "emit",
                    "MIGRATION_FETCHED",
                    {
                      "documents": "@entity.documents"
                    }
                  ]
                ],
                "event": "DOCUMENTS_LISTED",
                "eventId": "evt_01KYEH1JHZE908KJFCWPSJ231V",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_FETCHED",
                "eventId": "evt_01KYEH1JHZ108ZC0A25A791JJG",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_DOCUMENT",
                "eventId": "evt_01KYEH1JHZYBNE7SNEH4YSB3AJ",
                "from": "fetching",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "fetching",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "call-service",
                    "migration",
                    "fetchDocument",
                    {
                      "connectionRef": "@config.connectionRef",
                      "documentId": "@payload.documentId",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENT_FETCHED"
                      }
                    }
                  ]
                ],
                "event": "FETCH_DOCUMENT",
                "eventId": "evt_01KYEH1JHZCM65W3K5JPH22W1Y",
                "from": "mapping",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.document",
                    "@payload.document"
                  ],
                  [
                    "emit",
                    "MIGRATION_DOCUMENT",
                    {
                      "document": "@entity.document"
                    }
                  ]
                ],
                "event": "DOCUMENT_FETCHED",
                "eventId": "evt_01KYEH1JHZYH9ESEMWYAGG5V20",
                "from": "mapping",
                "to": "mapping"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.stats",
                    "@payload.stats"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "reviewing"
                  ],
                  [
                    "emit",
                    "MIGRATION_REVIEW_READY",
                    {
                      "stats": "@entity.stats"
                    }
                  ]
                ],
                "event": "MIGRATION_STAGED",
                "eventId": "evt_01KYEH1JHZTCZZE53EY6264JTY",
                "from": "mapping",
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ]
                ],
                "event": "MIGRATION_DISCARDED",
                "eventId": "evt_01KYEH1JHZXK69X09ZRB3JFTX8",
                "from": "mapping",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "mapping",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "committing"
                  ],
                  [
                    "call-service",
                    "migration",
                    "commit",
                    {
                      "jobId": "@entity.id",
                      "units": "@payload.units"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "COMMITTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_APPROVED",
                "eventId": "evt_01KYEH1JHZANEQQJWVAQWKE7T8",
                "from": "reviewing",
                "to": "committing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "mapping"
                  ]
                ],
                "event": "MIGRATION_REJECTED",
                "eventId": "evt_01KYEH1JHZ67GY1VYWWG8FJN5M",
                "from": "reviewing",
                "to": "mapping"
              },
              {
                "event": "MIGRATION_REVIEW_READY",
                "eventId": "evt_01KYEH1JHZQQGPZ8285ZJA0W2Z",
                "from": "reviewing",
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ]
                ],
                "event": "MIGRATION_DISCARDED",
                "eventId": "evt_01KYEH1JHZXK69X09ZRB3JFTX8",
                "from": "reviewing",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.stats",
                    [
                      "object/merge",
                      "@entity.stats",
                      {
                        "committed": "@payload.committed",
                        "failed": "@payload.failed"
                      }
                    ]
                  ],
                  [
                    "set",
                    "@entity.status",
                    "done"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_COMPLETED",
                    {
                      "stats": "@entity.stats"
                    }
                  ]
                ],
                "event": "COMMITTED",
                "eventId": "evt_01KYEH1JHZMFZQV6JQ7BF49TGJ",
                "from": "committing",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "persist",
                    "create",
                    "MigrationJob",
                    {
                      "createdAt": "@entity.createdAt",
                      "error": "@entity.error",
                      "source": "@entity.source",
                      "stats": "@entity.stats",
                      "status": "@entity.status",
                      "target": "@entity.target"
                    }
                  ],
                  [
                    "emit",
                    "MIGRATION_FAILED",
                    {
                      "error": "@entity.error"
                    }
                  ]
                ],
                "event": "MIGRATION_CALL_FAILED",
                "eventId": "evt_01KYEH1JHZ46HRGQWBVH62VTWB",
                "from": "committing",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "from": "done",
                "to": "idle"
              },
              {
                "event": "MIGRATION_COMPLETED",
                "eventId": "evt_01KYEH1JHZKCD8JKV9CAHZG2JC",
                "from": "done",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "fetching"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "call-service",
                    "migration",
                    "listDocuments",
                    {
                      "connectionRef": "@config.connectionRef",
                      "files": "@entity.files",
                      "source": "@entity.source"
                    },
                    {
                      "emit": {
                        "failure": "MIGRATION_CALL_FAILED",
                        "success": "DOCUMENTS_LISTED"
                      }
                    }
                  ]
                ],
                "event": "MIGRATION_RETRY",
                "eventId": "evt_01KYEH1JHZ4P70WNXP5KD40DQD",
                "from": "failed",
                "to": "fetching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.error",
                    ""
                  ],
                  [
                    "set",
                    "@entity.documents",
                    []
                  ],
                  [
                    "set",
                    "@entity.document",
                    {}
                  ],
                  [
                    "set",
                    "@entity.stats",
                    {}
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYEH1JHZ6TVR2PR9DCX7M0JW",
                "from": "failed",
                "to": "idle"
              },
              {
                "event": "MIGRATION_FAILED",
                "eventId": "evt_01KYEH1JHZFMZPRSAAAW5SNS5H",
                "from": "failed",
                "to": "failed"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}