  "name": "std-record-store",
  "orbitals": [
    {
      "entity": {
        "collection": "stored_records",
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "default": "",
            "description": "A user-facing name for the record.",
            "name": "name",
            "synonyms": "title, label",
            "type": "string"
          },
          {
            "default": "",
            "description": "Free text about the record.",
            "name": "description",
            "synonyms": "details, notes",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "string"
          }
        ],
        "id": "ent_01M4GP6Q83PN35WQDPERMPVTTS",
        "name": "StoredRecord",
        "persistence": "persistent"
      },
      "id": "orb_01M4GP6Q839W4D8P5RFQ20NH8V",
      "name": "RecordStoreOrbital",
      "pages": [
        {
          "id": "pag_01M4GP6Q836MFRK6167RXHBETM",
          "name": "RecordStorePage",
          "path": "/record-store",
          "traits": [
            {
              "ref": "RecordStore",
              "refId": "trt_01M4GP6Q83CKQG5SMVWPK6DAQ5"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "ownerField": {
              "default": "",
              "description": "Field set to the signed-in user's id when a record is created. Empty means records carry no owner.",
              "label": "Which field records who created it?",
              "synonyms": "owner, created by, author, holder, belongs to",
              "tier": "domain",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "persist",
              "resource": "StoredRecord"
            },
            {
              "kind": "render-ui",
              "resource": "toast"
            }
          ],
          "emits": [
            {
              "description": "A new record was saved.",
              "event": "RECORD_CREATED",
              "eventId": "evt_01M4GP6Q83DRZC97EXS6WADR4R",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "created, added, saved",
              "tier": "domain"
            },
            {
              "description": "A record's changes were saved.",
              "event": "RECORD_UPDATED",
              "eventId": "evt_01M4GP6Q837E7J4SARNP9RJET0",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "updated, edited, changed",
              "tier": "domain"
            },
            {
              "description": "A record was removed.",
              "event": "RECORD_DELETED",
              "eventId": "evt_01M4GP6Q8332ZFACAY10884W3S",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "deleted, removed",
              "tier": "domain"
            },
            {
              "event": "RecordSaveFailed",
              "eventId": "evt_01M4GP6Q83JW006CKBMWH8HZJM",
              "payloadSchema": [
                {
                  "name": "error",
                  "type": "string"
                },
                {
                  "name": "code",
                  "type": "string"
                }
              ],
              "tier": "internal"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "StoredRecord": "ent_01M4GP6Q83PN35WQDPERMPVTTS"
          },
          "id": "trt_01M4GP6Q83CKQG5SMVWPK6DAQ5",
          "linkedEntity": "StoredRecord",
          "linkedEntityId": "ent_01M4GP6Q83PN35WQDPERMPVTTS",
          "name": "RecordStore",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M4GP6Q83K7ZB0GBZA6YDAZF2",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Save a new record from a submitted form.",
                "external": true,
                "id": "evt_01M4GP6Q83YPTWYHGDZX5HNXJR",
                "key": "DO_CREATE",
                "name": "Do Create",
                "payloadSchema": [
                  {
                    "name": "data",
                    "required": true,
                    "type": "@entity"
                  }
                ],
                "synonyms": "create, add, save new, submit",
                "tier": "domain"
              },
              {
                "description": "Save the changes to an existing record.",
                "external": true,
                "id": "evt_01M4GP6Q83KQT6HPN8KRBT309K",
                "key": "DO_UPDATE",
                "name": "Do Update",
                "payloadSchema": [
                  {
                    "name": "data",
                    "required": true,
                    "type": "@entity"
                  }
                ],
                "synonyms": "update, edit, save changes",
                "tier": "domain"
              },
              {
                "description": "Remove a record.",
                "external": true,
                "id": "evt_01M4GP6Q83JSRFBM2KCHGHYRBR",
                "key": "DO_DELETE",
                "name": "Do Delete",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "synonyms": "delete, remove",
                "tier": "domain"
              },
              {
                "description": "A new record was saved.",
                "id": "evt_01M4GP6Q83DRZC97EXS6WADR4R",
                "key": "RECORD_CREATED",
                "name": "Record Created",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "synonyms": "created, added, saved",
                "tier": "domain"
              },
              {
                "description": "A record's changes were saved.",
                "id": "evt_01M4GP6Q837E7J4SARNP9RJET0",
                "key": "RECORD_UPDATED",
                "name": "Record Updated",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "synonyms": "updated, edited, changed",
                "tier": "domain"
              },
              {
                "description": "A record was removed.",
                "id": "evt_01M4GP6Q8332ZFACAY10884W3S",
                "key": "RECORD_DELETED",
                "name": "Record Deleted",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "synonyms": "deleted, removed",
                "tier": "domain"
              },
              {
                "id": "evt_01M4GP6Q83JW006CKBMWH8HZJM",
                "key": "RecordSaveFailed",
                "name": "Record save failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "tier": "internal"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "ready"
              },
              {
                "name": "saving"
              }
            ],
            "transitions": [
              {
                "event": "INIT",
                "eventId": "evt_01M4GP6Q83K7ZB0GBZA6YDAZF2",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "StoredRecord",
                    [
                      "if",
                      [
                        "=",
                        "@config.ownerField",
                        ""
                      ],
                      "@payload.data",
                      [
                        "object/set",
                        "@payload.data",
                        "@config.ownerField",
                        "@user.id"
                      ]
                    ],
                    {
                      "emit": {
                        "failure": "RecordSaveFailed",
                        "success": "RECORD_CREATED"
                      }
                    }
                  ]
                ],
                "event": "DO_CREATE",
                "eventId": "evt_01M4GP6Q83YPTWYHGDZX5HNXJR",
                "from": "ready",
                "to": "saving"
              },
              {
                "effects": [
                  [
                    "persist",
                    "update",
                    "StoredRecord",
                    "@payload.data",
                    {
                      "emit": {
                        "failure": "RecordSaveFailed",
                        "success": "RECORD_UPDATED"
                      }
                    }
                  ]
                ],
                "event": "DO_UPDATE",
                "eventId": "evt_01M4GP6Q83KQT6HPN8KRBT309K",
                "from": "ready",
                "to": "saving"
              },
              {
                "effects": [
                  [
                    "persist",
                    "delete",
                    "StoredRecord",
                    "@payload.id",
                    {
                      "emit": {
                        "failure": "RecordSaveFailed",
                        "success": "RECORD_DELETED"
                      }
                    }
                  ]
                ],
                "event": "DO_DELETE",
                "eventId": "evt_01M4GP6Q83JSRFBM2KCHGHYRBR",
                "from": "ready",
                "to": "saving"
              },
              {
                "event": "INIT",
                "eventId": "evt_01M4GP6Q83K7ZB0GBZA6YDAZF2",
                "from": "saving",
                "to": "ready"
              },
              {
                "event": "RECORD_CREATED",
                "eventId": "evt_01M4GP6Q83DRZC97EXS6WADR4R",
                "from": "saving",
                "to": "ready"
              },
              {
                "event": "RECORD_UPDATED",
                "eventId": "evt_01M4GP6Q837E7J4SARNP9RJET0",
                "from": "saving",
                "to": "ready"
              },
              {
                "event": "RECORD_DELETED",
                "eventId": "evt_01M4GP6Q8332ZFACAY10884W3S",
                "from": "saving",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "toast",
                    {
                      "dismissible": true,
                      "message": [
                        "str/concat",
                        "Couldn't save the record — ",
                        "@payload.error"
                      ],
                      "type": "alert",
                      "variant": "error"
                    }
                  ]
                ],
                "event": "RecordSaveFailed",
                "eventId": "evt_01M4GP6Q83JW006CKBMWH8HZJM",
                "from": "saving",
                "to": "ready"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}