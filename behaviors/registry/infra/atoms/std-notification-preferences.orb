            "type": "string",
            "values": [
              "instant",
              "digest"
            ]
          },
          {
            "default": "",
            "description": "Quiet-hours window as \"HH:MM-HH:MM\" (e.g. 22:00-07:00); blank or equal start/end = disabled.",
