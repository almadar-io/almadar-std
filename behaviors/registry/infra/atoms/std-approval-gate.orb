                            {
                              "event": "OPEN_SUBJECT",
                              "icon": "eye",
                              "label": "View",
                              "variant": "ghost"
                            },
                            {
                              "event": "APPROVE",
                              "icon": "check",
                              "label": "Approve",
                              "variant": "primary"
                            },
                            {
                              "event": "DENY",
                              "icon": "x",
                              "label": "Deny",
                              "variant": "danger"
                            }
                          ],
                          "look": "@config.tableLook",
                          "type": "data-grid"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "ApprovalRequestLoaded",
                "eventId": "evt_01KXG04EZ0BNTY7ZWPWS7Z1AFH",
                "from": "loading",
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "render-ui",
