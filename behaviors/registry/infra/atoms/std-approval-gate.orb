                    {
                      "children": [
                        "@trait.ErrorAlert"
                      ],
                      "type": "stack"
                    }
                  ]
                ],
                "event": "ApprovalRequestLoadFailed",
                "eventId": "evt_01KXG04EZ0ZFHMHXT4NN21VK6N",
                "from": "loading",
                "to": "error"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    null
                  ]
                ],
                "event": "CLOSE",
                "eventId": "evt_01KXG04EZ0MS01J775W2VPESMJ",
                "from": "loading",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "approved"
                  ],
                  [
                    "set",
                    "@entity.reviewer",
                    "@user.id"
                  ],
                  [
                    "set",
                    "@entity.decidedAt",
                    [
                      "time/now"
                    ]
                  ],
                  [
                    "persist",
                    "update",
                    "ApprovalRequest",
                    "@entity",
                    {
                      "emit": {
                        "failure": "ApprovalRequestReviewFailed",
                        "success": "ApprovalRequestReviewed"
                      }
                    }
                  ],
                  [
                    "emit",
                    "ApprovalGranted",
                    {
                      "payload": "@payload.row.payload",
                      "requestId": "@payload.id"
                    }
                  ]
                ],
                "event": "APPROVE",
                "eventId": "evt_01KXG04EZ0H0D5WC8FJKBRGBQE",
                "from": "reviewing",
                "guard": [
                  "and",
                  [
                    "or",
                    [
                      "=",
                      [
                        "array/len",
                        "@config.approverRoles"
                      ],
                      0.0
                    ],
                    [
                      "array/includes",
                      "@config.approverRoles",
                      "@user.role"
                    ]
                  ],
                  [
                    "or",
                    [
                      "=",
                      "@config.blockSelfApproval",
                      false
                    ],
                    [
                      "!=",
                      [
                        "object/get",
                        "@payload.row",
                        "requestedBy"
                      ],
                      "@user.id"
                    ]
                  ]
                ],
                "to": "reviewing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
                  ],
                  [
                    "set",
                    "@entity.subjectLabel",
                    [
                      "str/default",
                      [
                        "object/get",
                        "@payload.row",
                        "subjectLabel"
                      ],
                      ""
                    ]
                  ],
                  [
                    "render-ui",
                    "@config.reviewSlot",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            "@trait.DenyReasonTitle",
                            "@trait.CloseButton"
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "justify": "between",
                          "type": "stack"
                        },
                        "@trait.DenyReasonHint",
                        "@trait.ApprovalDivider",
                        {
                          "cancelEvent": "CANCEL_DENY",
                          "entity": {
                            "id": "@entity.id"
                          },
                          "fields": [
                            "notes"
                          ],
                          "mode": "edit",
                          "submitEvent": "CONFIRM_DENY",
                          "type": "form-section"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "DENY",
                "eventId": "evt_01KXG04EZ0ZFMGKFBB34B7PMEE",
                "from": "reviewing",
                "guard": [
                  "or",
                  [
                    "=",
                    [
                      "array/len",
                      "@config.approverRoles"
                    ],
