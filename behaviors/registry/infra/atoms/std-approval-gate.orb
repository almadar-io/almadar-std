                          "direction": "horizontal",
                          "gap": "sm",
                          "justify": "between",
                          "type": "stack"
                        },
                        "@trait.ApprovalDivider",
                        {
                          "cols": 1.0,
                          "entity": "@payload.data",
                          "fields": [
                            {
                              "label": "What",
                              "name": "subjectLabel",
                              "variant": "h4"
                            },
                            {
                              "label": "Action",
                              "name": "gatedEvent",
                              "variant": "badge"
                            },
                            {
                              "label": "Requested by",
                              "name": "requestedByName",
                              "variant": "caption"
                            },
                            {
                              "label": "Requested",
                              "name": "requestedAt",
                              "variant": "caption"
                            }
                          ],
                          "gap": "sm",
