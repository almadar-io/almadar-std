                "eventId": "evt_01M0M9E89QVRM9F7VRMWJ8NT71",
                "from": "idle",
                "guard": [
                  "and",
                  "@config.enabled",
                  [
                    ">",
                    [
                      "array/len",
                      "@payload.data"
                    ],
                    0.0
                  ]
                ],
                "to": "pushing"
              },
              {
                "effects": [
                  [
                    "call-service",
                    "calendar",
                    "listEvents",
                    {
                      "calendarId": "@config.calendarId",
                      "syncToken": "@entity.syncToken"
                    },
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "CAL_REMOTE_LISTED"
                      }
                    }
                  ]
                ],
                "event": "PUSH_ROWS_LOADED",
                "eventId": "evt_01M0M9E89QVRM9F7VRMWJ8NT71",
                "from": "idle",
                "guard": [
                  "=",
                  [
                    "array/len",
                    "@payload.data"
                  ],
                  0.0
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.pending",
                    "@payload.events"
                  ],
                  [
                    "set",
                    "@entity.syncToken",
                    [
                      "str/default",
                      "@payload.nextSyncToken",
                      ""
                    ]
                  ],
                  [
