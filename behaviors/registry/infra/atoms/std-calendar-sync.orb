                  ],
                  [
                    "set",
                    "@entity.lastSyncedAt",
                    "@now"
                  ],
                  [
                    "emit",
                    "CAL_SYNCED",
                    {
                      "syncedAt": "@entity.lastSyncedAt"
                    }
                  ]
                ],
                "event": "CAL_REMOTE_LISTED",
                "eventId": "evt_01M0M9E89Q006H33RM6WGB8QRJ",
                "from": "idle",
                "guard": [
                  "=",
                  [
                    "array/len",
                    "@payload.events"
                  ],
                  0.0
                ],
                "to": "idle"
