              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.headId",
                    [
                      "object/get",
                      [
                        "array/first",
                        "@payload.data"
                      ],
                      "id"
                    ]
                  ],
                  [
                    "call-service",
                    "calendar",
                    "createEvent",
                    {
                      "calendarId": "@config.calendarId",
                      "description": [
                        "if",
                        [
                          "=",
                          "@config.descriptionField",
                          ""
                        ],
                        "",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.descriptionField"
                        ]
                      ],
                      "durationMinutes": [
                        "if",
                        [
                          "=",
                          "@config.durationField",
                          ""
                        ],
                        "@config.durationMinutes",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.durationField"
                        ]
                      ],
                      "end": [
                        "if",
                        [
                          "=",
                          "@config.endField",
                          ""
                        ],
                        "",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.endField"
                        ]
                      ],
                      "location": [
                        "if",
                        [
                          "=",
                          "@config.locationField",
                          ""
                        ],
                        "",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.locationField"
                        ]
                      ],
                      "start": [
                        "object/get",
                        [
                          "array/first",
                          "@payload.data"
                        ],
                        "@config.startField"
                      ],
                      "summary": [
                        "object/get",
                        [
                          "array/first",
                          "@payload.data"
                        ],
                        "@config.titleField"
                      ]
                    },
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "CAL_EVENT_CREATED"
                      }
                    }
                  ]
                ],
                "event": "PUSH_ROWS_LOADED",
                "eventId": "evt_01M0M9E89QVRM9F7VRMWJ8NT71",
                "from": "pushing",
                "guard": [
                  ">",
                  [
                    "array/len",
                    "@payload.data"
                  ],
                  0.0
                ],
                "to": "pushing"
              },
              {
                "effects": [
                  [
                    "call-service",
                    "calendar",
                    "listEvents",
                    {
                      "calendarId": "@config.calendarId",
                      "syncToken": "@entity.syncToken"
                    },
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "CAL_REMOTE_LISTED"
                      }
                    }
                  ]
                ],
                "event": "PUSH_ROWS_LOADED",
                "eventId": "evt_01M0M9E89QVRM9F7VRMWJ8NT71",
                "from": "pushing",
                "guard": [
                  "=",
                  [
                    "array/len",
                    "@payload.data"
                  ],
                  0.0
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.lastError",
                    "@payload.error"
                  ]
                ],
                "event": "CAL_SYNC_FAILED",
                "eventId": "evt_01M0M9E89QMRE2B1QZPM8HPXS5",
                "from": "pushing",
                "to": "idle"
              },
              {
                "effects": [
                  [
