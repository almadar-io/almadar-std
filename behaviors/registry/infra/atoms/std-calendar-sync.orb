                        "failure": "CAL_SYNC_FAILED",
                        "success": "PUSH_ROWS_LOADED"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "externalEventId"
                        ],
                        ""
                      ]
                    }
                  ]
                ],
                "event": "PUSH_STEPPED",
                "eventId": "evt_01M0M9E89QRFQJNXPGD4C8XFP0",
                "from": "pushing",
