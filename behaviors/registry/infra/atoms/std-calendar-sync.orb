                      [
                        "array/first",
                        "@entity.pending"
                      ],
                      "id"
                    ]
                  ],
                  [
                    "if",
                    [
                      "=",
                      [
                        "array/len",
                        [
                          "array/filter",
                          "@payload.data",
                          [
                            "fn",
                            "r",
                            [
                              "=",
                              [
                                "object/get",
                                "@r",
                                "externalEventId"
                              ],
                              "@entity.headId"
                            ]
                          ]
                        ]
                      ],
                      0.0
                    ],
                    [
                      "persist",
                      "create",
                      "CalendarEvent",
                      {
                        "description": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "description"
                        ],
                        "endsAt": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "end"
                        ],
                        "externalEventId": "@entity.headId",
                        "location": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "location"
                        ],
                        "startsAt": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "start"
                        ],
                        "status": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "status"
                        ],
                        "syncedAt": "@now",
                        "title": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "summary"
                        ]
                      },
                      {
                        "emit": {
                          "failure": "CAL_SYNC_FAILED",
                          "success": "PULL_STEPPED"
                        }
                      }
                    ],
                    [
                      "persist",
                      "update",
                      "CalendarEvent",
                      {
                        "description": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "description"
                        ],
                        "endsAt": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "end"
                        ],
                        "id": [
                          "object/get",
                          [
                            "array/first",
                            [
                              "array/filter",
                              "@payload.data",
                              [
                                "fn",
                                "r",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@r",
                                    "externalEventId"
                                  ],
                                  "@entity.headId"
                                ]
                              ]
                            ]
                          ],
                          "id"
                        ],
                        "location": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "location"
                        ],
                        "startsAt": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "start"
                        ],
                        "status": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "status"
                        ],
                        "syncedAt": "@now",
                        "title": [
                          "object/get",
                          [
                            "array/first",
                            "@entity.pending"
                          ],
                          "summary"
                        ]
                      },
                      {
                        "emit": {
                          "failure": "CAL_SYNC_FAILED",
                          "success": "PULL_STEPPED"
                        }
                      }
                    ]
                  ]
                ],
                "event": "PULL_TARGET_LOADED",
                "eventId": "evt_01M0M9E89QZS3J82D8V4N7GNTX",
                "from": "pulling",
                "to": "pulling"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.pending",
                    [
                      "array/drop",
                      "@entity.pending",
                      1.0
                    ]
                  ],
                  [
                    "emit",
                    "PULL_NEXT",
                    {
                      "remaining": [
                        "array/len",
                        "@entity.pending"
                      ]
                    }
                  ]
                ],
                "event": "PULL_STEPPED",
                "eventId": "evt_01M0M9E89QR7NR9G2343SA8BPM",
                "from": "pulling",
                "to": "pulling"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "CalendarEvent",
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "PULL_TARGET_LOADED"
                      }
                    }
                  ]
                ],
                "event": "PULL_NEXT",
                "eventId": "evt_01M0M9E89QV7Q7Z4KV2FHA4QZC",
                "from": "pulling",
                "guard": [
                  ">",
                  "@payload.remaining",
                  0.0
                ],
                "to": "pulling"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.lastSyncedAt",
                    "@now"
                  ],
                  [
                    "emit",
                    "CAL_SYNCED",
                    {
                      "syncedAt": "@entity.lastSyncedAt"
                    }
                  ]
                ],
                "event": "PULL_NEXT",
