                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.endField"
                        ]
                      ],
                      "location": [
                        "if",
                        [
                          "=",
                          "@config.locationField",
                          ""
                        ],
                        "",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.locationField"
                        ]
                      ],
                      "start": [
                        "object/get",
                        [
                          "array/first",
                          "@payload.data"
                        ],
                        "@config.startField"
                      ],
                      "summary": [
                        "object/get",
                        [
                          "array/first",
                          "@payload.data"
                        ],
                        "@config.titleField"
                      ]
                    },
