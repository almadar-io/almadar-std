                      "object/get",
                      [
                        "array/first",
                        "@payload.data"
                      ],
                      "id"
                    ]
                  ],
                  [
                    "call-service",
                    "calendar",
                    "createEvent",
                    {
                      "calendarId": "@config.calendarId",
                      "description": [
                        "if",
                        [
                          "=",
                          "@config.descriptionField",
                          ""
                        ],
                        "",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
                          "@config.descriptionField"
                        ]
                      ],
                      "durationMinutes": [
                        "if",
                        [
                          "=",
                          "@config.durationField",
                          ""
                        ],
                        "@config.durationMinutes",
                        [
                          "object/get",
                          [
                            "array/first",
                            "@payload.data"
                          ],
