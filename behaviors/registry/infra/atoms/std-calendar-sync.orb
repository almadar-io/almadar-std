                  {
                    "name": "status",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "htmlLink",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Target row stamped with its new externalEventId; drives the next push pass.",
                "id": "evt_01M0M9E89QRFQJNXPGD4C8XFP0",
