                "from": "pulling",
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "fetch",
                  "@config.targetEntity",
                  {
                    "emit": {
                      "failure": "CAL_SYNC_FAILED",
                      "success": "PUSH_ROWS_LOADED"
                    },
                    "filter": [
                      "=",
                      [
                        "object/get",
                        "@entity",
                        "externalEventId"
                      ],
                      ""
                    ]
                  }
                ]
              ],
              "interval": "*/15 * * * *",
              "name": "syncCycle"
            }
          ]
        }
      ],
      "types": {
        "RemoteEvent": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "summary",
            "type": "string"
          },
          {
            "name": "description",
