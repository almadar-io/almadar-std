                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "PUSH_STEPPED"
                      }
                    }
                  ]
                ],
                "event": "CAL_EVENT_CREATED",
                "eventId": "evt_01M0M9E89Q9N7X13XMTK58JYY9",
                "from": "pushing",
