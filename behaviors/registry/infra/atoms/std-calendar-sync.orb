                "name": "Cal Synced",
                "payloadSchema": [
                  {
                    "name": "syncedAt",
                    "type": "number"
                  }
                ]
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "pushing"
              },
              {
                "name": "pulling"
              }
            ],
            "transitions": [
              {
                "event": "INIT",
                "eventId": "evt_01M0M9E89QYTZJDGBZVC1BVZDY",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "@config.targetEntity",
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "PUSH_ROWS_LOADED"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "externalEventId"
                        ],
                        ""
                      ]
                    }
                  ]
                ],
                "event": "SYNC_NOW",
                "eventId": "evt_01M0M9E89Q7PTP9ZRG3M5VD1SY",
                "from": "idle",
                "guard": "@config.enabled",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "call-service",
                    "calendar",
                    "listEvents",
                    {
                      "calendarId": "@config.calendarId",
                      "syncToken": "@entity.syncToken"
                    },
                    {
                      "emit": {
                        "failure": "CAL_SYNC_FAILED",
                        "success": "CAL_REMOTE_LISTED"
