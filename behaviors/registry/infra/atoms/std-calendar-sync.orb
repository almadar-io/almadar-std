                        "type": "string"
                      },
                      {
                        "name": "externalEventId",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "One remote event upserted into the CalendarEvent store; drives the next pull pass.",
                "id": "evt_01M0M9E89QR7NR9G2343SA8BPM",
