                "id": "evt_01M2ZQVNTF9SVF3HKSCSW5HH74",
                "key": "CalibrationRequested",
                "name": "Calibration requested",
                "payloadSchema": [
                  {
                    "name": "title",
                    "type": "string"
                  },
                  {
