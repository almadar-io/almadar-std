              {
                "id": "evt_01M2ZQ92PZ28JZEDAJ1Y43DDW9",
                "key": "COMBINE_WITH_TRUSTED",
                "name": "Combine With Trusted"
              },
              {
                "description": "The reliability-score form committed.",
                "id": "evt_01M2ZQ92PZV0KSC1T6PHW6H7TZ",
                "key": "CONFIRM_SCORE",
