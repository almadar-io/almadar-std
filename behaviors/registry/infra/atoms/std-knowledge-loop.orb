              },
              {
                "description": "A claim cleared calibration; a composing host can act on the validated result.",
                "id": "evt_01M2ZQ92PZ92W02Q03YF18AXRT",
                "key": "LoopConcluded",
                "name": "Loop concluded",
                "payloadSchema": [
                  {
                    "name": "title",
                    "type": "string"
                  },
                  {
                    "name": "reliabilityScore",
                    "type": "number"
                  }
                ],
                "synonyms": "validated, calibrated, concluded, ready to ship",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "varying"
              },
              {
                "name": "comparing"
              },
              {
                "name": "hypothesizing"
              },
              {
                "name": "predicting"
              },
              {
                "name": "falsifying"
              },
              {
                "name": "verifying"
              },
              {
                "name": "generalizing"
              },
              {
                "name": "isolating"
              },
              {
                "name": "composing"
              },
              {
                "name": "calibrating"
              },
              {
                "name": "selecting"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "KnowledgeClaim"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@trait.LoopTitle",
                        "@trait.LoopDivider",
                        {
                          "entity": "@entity",
                          "fields": [
                            "title",
                            "candidateStructure",
                            "survivedFalsification",
                            "independentChecksAgree",
                            "reliabilityScore",
                            "nextTarget"
                          ],
                          "title": "Current claim",
                          "type": "detail-panel"
                        },
                        {
                          "entity": {},
                          "fields": [
                            "title",
                            "candidateStructure"
                          ],
                          "mode": "create",
                          "submitEvent": "CHANGE_CONDITION",
                          "type": "form-section"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M2ZQ92PZAF3Y9QJQ93HW1FTW",
                "from": "varying",
                "to": "varying"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.title",
                    [
                      "object/get",
                      "@payload.data",
                      "title"
                    ]
                  ],
                  [
                    "set",
                    "@entity.candidateStructure",
                    [
                      "object/get",
                      "@payload.data",
                      "candidateStructure"
                    ]
                  ]
                ],
                "event": "CHANGE_CONDITION",
                "eventId": "evt_01M2ZQ92PZXK12WF5BRGJA2EC9",
                "from": "varying",
                "to": "comparing"
              },
              {
                "event": "MEASURE_DIFFERENCE",
                "eventId": "evt_01M2ZQ92PZWV89QKNPVE4YK1VY",
                "from": "comparing",
                "to": "hypothesizing"
              },
              {
                "event": "FORM_GUESS",
                "eventId": "evt_01M2ZQ92PZA06VT2KBHG9VCN14",
                "from": "hypothesizing",
                "to": "predicting"
              },
              {
                "effects": [
                  [
                    "emit",
                    "FalsificationRequested",
                    {
                      "candidateStructure": "@entity.candidateStructure",
                      "title": "@entity.title"
                    }
                  ],
                  [
                    "if",
                    "@config.manualFalsification",
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.SurvivedButton",
                          "@trait.FailedButton"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.AwaitingFalsificationText"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ]
                  ]
                ],
                "event": "EXTRAPOLATE",
                "eventId": "evt_01M2ZQ92PZFT3WAQ12HCMJZ1X2",
                "from": "predicting",
                "to": "falsifying"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.survivedFalsification",
                    true
                  ],
                  [
                    "set",
                    "@entity.independentChecksAgree",
                    true
                  ]
                ],
                "event": "SURVIVED",
                "eventId": "evt_01M2ZQ92PZ12JQB821TTV5H2VF",
                "from": "falsifying",
                "guard": [
                  "not",
                  "@config.requireIndependentVerification"
                ],
                "to": "generalizing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.survivedFalsification",
                    true
                  ],
                  [
                    "emit",
                    "VerificationRequested",
                    {
                      "candidateStructure": "@entity.candidateStructure",
                      "title": "@entity.title"
                    }
                  ],
                  [
                    "if",
                    "@config.manualVerification",
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.ChecksAgreeButton",
                          "@trait.ChecksDisagreeButton"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.AwaitingVerificationText"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ]
                  ]
                ],
                "event": "SURVIVED",
                "eventId": "evt_01M2ZQ92PZ12JQB821TTV5H2VF",
                "from": "falsifying",
                "guard": "@config.requireIndependentVerification",
                "to": "verifying"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.survivedFalsification",
                    false
                  ]
                ],
                "event": "FAILED",
                "eventId": "evt_01M2ZQ92PZHVV5XQH33875VFZW",
                "from": "falsifying",
                "to": "hypothesizing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.independentChecksAgree",
                    true
                  ]
                ],
                "event": "CHECKS_AGREE",
                "eventId": "evt_01M2ZQ92PZHVA4XQZ651A241EH",
                "from": "verifying",
                "to": "generalizing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.independentChecksAgree",
                    false
                  ]
                ],
                "event": "CHECKS_DISAGREE",
                "eventId": "evt_01M2ZQ92PZEGZ40SRSAMR97HF0",
                "from": "verifying",
                "to": "hypothesizing"
              },
              {
                "event": "STRIP_TO_ESSENTIALS",
                "eventId": "evt_01M2ZQ92PZQZB00Z4J36QZ09ZR",
                "from": "generalizing",
                "to": "isolating"
              },
              {
                "event": "FIND_AND_CONTROL_CAUSE",
                "eventId": "evt_01M2ZQ92PZY9FHKZPK6D2V16M0",
                "from": "isolating",
                "to": "composing"
              },
              {
                "effects": [
                  [
                    "emit",
                    "CalibrationRequested",
                    {
                      "candidateStructure": "@entity.candidateStructure",
                      "title": "@entity.title"
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@trait.LoopTitle",
                        "@trait.LoopDivider",
                        {
                          "cancelEvent": "CANCEL_SCORE",
                          "entity": {},
                          "fields": [
                            "reliabilityScore"
                          ],
                          "mode": "create",
                          "submitEvent": "CONFIRM_SCORE",
                          "type": "form-section"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "COMBINE_WITH_TRUSTED",
                "eventId": "evt_01M2ZQ92PZ28JZEDAJ1Y43DDW9",
                "from": "composing",
                "to": "calibrating"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.reliabilityScore",
                    [
                      "object/get",
                      "@payload.data",
                      "score"
                    ]
                  ],
                  [
                    "emit",
                    "LoopConcluded",
                    {
                      "reliabilityScore": [
                        "object/get",
                        "@payload.data",
                        "score"
                      ],
                      "title": "@entity.title"
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@trait.LoopTitle",
                        "@trait.LoopDivider",
                        "@trait.ChooseNextTargetButton"
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "CONFIRM_SCORE",
                "eventId": "evt_01M2ZQ92PZV0KSC1T6PHW6H7TZ",
                "from": "calibrating",
                "guard": [
                  ">=",
                  [
                    "object/get",
                    "@payload.data",
                    "score"
                  ],
                  "@config.reliabilityThreshold"
                ],
                "to": "selecting"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.reliabilityScore",
                    [
                      "object/get",
                      "@payload.data",
                      "score"
                    ]
                  ],
                  [
                    "emit",
                    "FalsificationRequested",
                    {
                      "candidateStructure": "@entity.candidateStructure",
                      "title": "@entity.title"
                    }
                  ],
                  [
                    "if",
                    "@config.manualFalsification",
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.SurvivedButton",
                          "@trait.FailedButton"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          "@trait.LoopTitle",
                          "@trait.LoopDivider",
                          "@trait.AwaitingFalsificationText"
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ]
                  ]
                ],
                "event": "CONFIRM_SCORE",
                "eventId": "evt_01M2ZQ92PZV0KSC1T6PHW6H7TZ",
                "from": "calibrating",
                "guard": [
                  "<",
                  [
                    "object/get",
                    "@payload.data",
                    "score"
                  ],
                  "@config.reliabilityThreshold"
                ],
                "to": "falsifying"
              },
              {
                "event": "CANCEL_SCORE",
                "eventId": "evt_01M2ZQ92PZ7NYYQKS84PWZTMVZ",
                "from": "calibrating",
                "to": "calibrating"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "KnowledgeClaim"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@trait.LoopTitle",
                        "@trait.LoopDivider",
                        {
                          "entity": "@entity",
                          "fields": [
                            "title",
                            "candidateStructure",
                            "survivedFalsification",
                            "independentChecksAgree",
                            "reliabilityScore",
                            "nextTarget"
                          ],
                          "title": "Current claim",
                          "type": "detail-panel"
                        },
                        {
                          "entity": {},
                          "fields": [
                            "title",
                            "candidateStructure"
                          ],
                          "mode": "create",
                          "submitEvent": "CHANGE_CONDITION",
                          "type": "form-section"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "CHOOSE_NEXT_TARGET",
                "eventId": "evt_01M2ZQ92PZP010YXNSHVVBCMYS",
                "from": "selecting",
                "to": "varying"
              }
            ]
          },
          "traitEmbedIds": {
            "AwaitingFalsificationText": "trt_01M2ZQVNTFWWY65FPMZMT1J48C",
            "AwaitingVerificationText": "trt_01M2ZQVNTFFXW66BQK3G6KGX6W",
            "ChecksAgreeButton": "trt_01M2ZQ92PZB3E4VZ30YBV9H52Z",
