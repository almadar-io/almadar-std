              {
                "id": "evt_01KXG04FE9R85M0QY4RN3YHY2G",
                "key": "NotificationDispatched",
                "name": "Notification dispatched",
                "payloadSchema": [
                  {
                    "name": "recipient",
                    "type": "string"
                  },
                  {
