            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.recipient",
                    [
                      "if",
                      [
                        "=",
                        [
                          "array/len",
                          "@config.recipients"
                        ],
                        0.0
                      ],
                      [
                        "if",
                        [
                          "not",
                          [
                            "=",
                            "@config.fallbackRecipient",
                            ""
                          ]
                        ],
                        "@config.fallbackRecipient",
                        "@user.id"
                      ],
                      [
                        "array/first",
                        "@config.recipients"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.channel",
                    "@config.notifyChannel"
                  ],
                  [
                    "set",
                    "@entity.message",
                    "@config.template"
                  ],
                  [
                    "set",
                    "@entity.severity",
                    "@config.severity"
                  ],
                  [
                    "set",
                    "@entity.dispatched",
                    false
                  ],
                  [
                    "set",
                    "@entity.recordedAt",
                    "@now"
                  ],
                  [
                    "when",
                    [
                      "not",
                      [
                        "array/includes",
                        "@config.suppressionList",
                        "@entity.recipient"
                      ]
                    ],
                    [
                      "if",
                      [
                        "and",
                        [
                          "not",
                          [
                            "=",
                            "@config.quietStartHour",
                            "@config.quietEndHour"
                          ]
                        ],
                        [
                          "if",
                          [
                            "<",
                            "@config.quietStartHour",
                            "@config.quietEndHour"
                          ],
                          [
                            "and",
                            [
                              ">=",
                              [
                                "time/hour",
                                "@now"
                              ],
                              "@config.quietStartHour"
                            ],
                            [
                              "<",
                              [
                                "time/hour",
                                "@now"
                              ],
                              "@config.quietEndHour"
                            ]
                          ],
                          [
                            "or",
                            [
                              ">=",
                              [
                                "time/hour",
                                "@now"
                              ],
                              "@config.quietStartHour"
                            ],
                            [
                              "<",
                              [
                                "time/hour",
                                "@now"
                              ],
                              "@config.quietEndHour"
                            ]
                          ]
                        ]
                      ],
                      [
                        "persist",
                        "create",
                        "NotificationRecord",
                        {
                          "channel": "@entity.channel",
                          "dispatched": false,
                          "error": "quiet-hours",
                          "message": "@entity.message",
                          "recipient": "@entity.recipient",
                          "recordedAt": "@now",
                          "severity": "@entity.severity"
                        }
                      ],
                      [
                        "fetch",
                        "NotificationPreference",
                        {
                          "emit": {
                            "failure": "NOTIFY_LOOKUP_FAILED",
                            "success": "NOTIFY_PREFS_LOADED"
                          }
                        }
                      ]
                    ]
                  ],
                  [
                    "emit",
                    "NotificationDispatched",
                    {
                      "channel": "@entity.channel",
                      "message": "@entity.message",
                      "recipient": "@entity.recipient",
                      "severity": "@entity.severity"
                    }
                  ]
                ],
                "event": "EventOccurred",
                "eventId": "evt_01KXG04FE9FBG7H2NH6HKT4ZAR",
                "from": "idle",
                "guard": [
                  "if",
                  [
                    "=",
                    "@config.guardOp",
                    "eq"
                  ],
                  [
                    "or",
                    [
                      "=",
                      "@config.triggerStatus",
                      ""
                    ],
                    [
                      "=",
                      "@payload.status",
                      "@config.triggerStatus"
                    ]
                  ],
                  [
                    "if",
                    [
                      "=",
                      "@config.guardOp",
                      "gt"
                    ],
                    [
                      ">",
                      [
                        "object/get",
                        "@payload.data",
                        "@config.guardField"
                      ],
                      "@config.guardValue"
                    ],
                    [
                      "if",
                      [
                        "=",
                        "@config.guardOp",
                        "lt"
                      ],
                      [
                        "<",
                        [
                          "object/get",
                          "@payload.data",
                          "@config.guardField"
                        ],
                        "@config.guardValue"
                      ],
                      [
                        "if",
                        [
                          "=",
                          "@config.guardOp",
                          "gte"
                        ],
                        [
                          ">=",
                          [
                            "object/get",
                            "@payload.data",
                            "@config.guardField"
                          ],
                          "@config.guardValue"
                        ],
                        [
                          "<=",
                          [
                            "object/get",
                            "@payload.data",
                            "@config.guardField"
                          ],
                          "@config.guardValue"
                        ]
                      ]
                    ]
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.prefMode",
                    [
                      "if",
                      [
                        "=",
                        [
                          "array/len",
                          [
                            "array/filter",
                            "@payload.data",
                            [
                              "fn",
                              "p",
                              [
                                "and",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@p",
                                    "userId"
                                  ],
                                  "@entity.recipient"
                                ],
                                [
                                  "or",
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    ""
                                  ],
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    "@config.eventKey"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        0.0
                      ],
                      "instant",
                      [
                        "object/get",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@payload.data",
                            [
                              "fn",
                              "p",
                              [
                                "and",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@p",
                                    "userId"
                                  ],
                                  "@entity.recipient"
                                ],
                                [
                                  "or",
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    ""
                                  ],
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    "@config.eventKey"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        "mode"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.prefChannel",
                    [
                      "if",
                      [
                        "=",
                        [
                          "array/len",
                          [
                            "array/filter",
                            "@payload.data",
                            [
                              "fn",
                              "p",
                              [
                                "and",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@p",
                                    "userId"
                                  ],
                                  "@entity.recipient"
                                ],
                                [
                                  "or",
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    ""
                                  ],
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@p",
                                      "eventType"
                                    ],
                                    "@config.eventKey"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        0.0
                      ],
