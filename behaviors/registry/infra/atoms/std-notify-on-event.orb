            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.recipient",
                    [
                      "if",
                      [
                        "=",
                        [
                          "array/len",
                          "@config.recipients"
                        ],
                        0.0
                      ],
                      [
                        "if",
                        [
                          "not",
                          [
                            "=",
