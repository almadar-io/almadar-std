  "name": "std-status-lifecycle-control",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "id": "ent_01KZD9YRHB5BWR3DX8D3W5FWYJ",
        "name": "StatusControlItem",
        "persistence": "runtime"
      },
      "id": "orb_01KZD9YRHB5S5FYYZSQ8VTN2J1",
      "name": "StatusLifecycleControlOrbital",
      "pages": [
        {
          "id": "pag_01KZD9YRHF03B1GV4D9A0VQPZ2",
          "name": "StatusLifecycleControlPage",
          "path": "/status-lifecycle-control",
          "traits": [
            {
              "ref": "StatusLifecycleControl",
              "refId": "trt_01KZD9YRHB2F5R9S5JWR44YNA6"
            },
            {
              "ref": "InlineBadgeRender1",
              "refId": "trt_01KZDA2P23KTT9P8XN8BM8RX5Y"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "currentStatus": {
              "default": "",
              "description": "The record's current status, shown as a badge and used to compute which transitions are legal. Forward the host entity's status field at the embed site (e.g. currentStatus={@entity.status}).",
              "label": "Current status",
              "tier": "internal",
              "type": "string"
            },
            "recordId": {
              "default": "",
              "description": "id of the record whose status this control changes. Forward the host entity's id at the embed site (e.g. recordId={@entity.id}).",
              "label": "Record id",
              "tier": "internal",
              "type": "string"
            },
            "transitions": {
              "default": [],
              "description": "Legal transitions as { from, to, event, label } — pass the SAME table given to the paired StatusMachine trait's config.transitions so the rendered buttons never offer a move the atom would reject.",
              "items": {
                "properties": {
                  "event": {
                    "name": "event",
                    "required": false,
                    "type": "string"
                  },
                  "from": {
                    "name": "from",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "to": {
                    "name": "to",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Which status moves are allowed?",
              "synonyms": "edges, allowed moves, status flow, workflow transitions",
              "tier": "domain",
              "type": "[TransitionSpec]"
            }
          },
          "emits": [
            {
              "description": "Fired when the viewer picks a legal next status from the control.",
              "event": "ChangeStatusRequested",
              "eventId": "evt_01KZD9YRHFSXTSQYZGGJ4SVSVV",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                },
                {
                  "name": "from",
                  "type": "string"
                },
                {
                  "name": "to",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "status change, workflow transition, stage change",
              "tier": "primary"
            },
            {
              "description": "A legal-transition button was clicked.",
              "event": "TRANSITION_REQUESTED",
              "eventId": "evt_01KZD9YRHF06QG3Q7NNXVV3E9N",
              "payloadSchema": [
                {
                  "name": "to",
                  "type": "string"
                }
              ],
              "synonyms": "transition clicked, move selected",
              "tier": "internal"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "StatusControlItem": "ent_01KZD9YRHB5BWR3DX8D3W5FWYJ"
          },
          "id": "trt_01KZD9YRHB2F5R9S5JWR44YNA6",
          "linkedEntity": "StatusControlItem",
          "linkedEntityId": "ent_01KZD9YRHB5BWR3DX8D3W5FWYJ",
          "name": "StatusLifecycleControl",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZD9YRHB4GMDJEP1F22168MG",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "A legal-transition button was clicked.",
                "id": "evt_01KZD9YRHF06QG3Q7NNXVV3E9N",
                "key": "TRANSITION_REQUESTED",
                "name": "Transition Requested",
                "payloadSchema": [
                  {
                    "name": "to",
                    "type": "string"
                  }
                ],
                "synonyms": "transition clicked, move selected",
                "tier": "internal"
              },
              {
                "description": "Fired when the viewer picks a legal next status from the control.",
                "id": "evt_01KZD9YRHFSXTSQYZGGJ4SVSVV",
                "key": "ChangeStatusRequested",
                "name": "Change status requested",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  },
                  {
                    "name": "from",
                    "type": "string"
                  },
                  {
                    "name": "to",
                    "type": "string"
                  }
                ],
                "synonyms": "status change, workflow transition, stage change",
                "tier": "primary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "align": "center",
                      "children": [
                        "@trait.InlineBadgeRender1",
                        {
                          "children": [
                            "array/map",
                            [
                              "array/filter",
                              "@config.transitions",
                              [
                                "fn",
                                "t",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@t",
                                    "from"
                                  ],
                                  "@config.currentStatus"
                                ]
                              ]
                            ],
                            [
                              "fn",
                              "t",
                              {
                                "action": "TRANSITION_REQUESTED",
                                "actionPayload": {
                                  "to": [
                                    "object/get",
                                    "@t",
                                    "to"
                                  ]
                                },
                                "label": [
                                  "object/get",
                                  "@t",
                                  "label"
                                ],
                                "type": "button",
                                "variant": "secondary"
                              }
                            ]
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        }
                      ],
                      "direction": "horizontal",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZD9YRHB4GMDJEP1F22168MG",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "emit",
                    "ChangeStatusRequested",
                    {
                      "from": "@config.currentStatus",
                      "id": "@config.recordId",
                      "to": "@payload.to"
                    }
                  ]
                ],
                "event": "TRANSITION_REQUESTED",
                "eventId": "evt_01KZD9YRHF06QG3Q7NNXVV3E9N",
                "from": "idle",
                "to": "idle"
              }
            ]
          },
          "traitEmbedIds": {
            "InlineBadgeRender1": "trt_01KZDA2P23KTT9P8XN8BM8RX5Y"
          }
        },
        {
          "config": {
            "label": {
              "default": "@config.currentStatus",
              "type": "unknown"
            },
            "variant": {
              "default": "neutral",
              "type": "unknown"
            }
          },
          "id": "trt_01KZDA2P23KTT9P8XN8BM8RX5Y",
          "linkedEntity": "StatusControlItem",
          "linkedEntityId": "ent_01KZD9YRHB5BWR3DX8D3W5FWYJ",
          "name": "InlineBadgeRender1",
          "ref": "Badge.traits.BadgeRender"
        }
      ],
      "uses": [
        {
          "as": "Badge",
          "from": "std/behaviors/ui-badge"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}