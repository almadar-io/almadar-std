          },
          "id": "trt_01M055GH36448S92G88KVCHG8W",
          "linkedEntity": "FixLoop",
          "linkedEntityId": "ent_01M055GH36GR0CV0VXM4J3HCZT",
          "name": "FixLoopExecution",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GH363PDMC8GMXCF1K368",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "external": true,
                "id": "evt_01M4DN9X1FQKH94WM7XPADHGHB",
                "key": "VALIDATE_PROGRAM",
                "name": "Validate Program",
                "payloadSchema": [
                  {
                    "name": "program",
                    "required": true,
                    "type": "SExpr"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9X1FJMWBTXSWNP51KJH4",
                "key": "PROGRAM_EVALUATED",
                "name": "Program Evaluated",
                "payloadSchema": [
                  {
                    "name": "result",
                    "properties": [
                      {
                        "name": "behavior",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "object"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9X1F36A48QFZJB2TPK6P",
                "key": "PROGRAM_INVALID",
                "name": "Program Invalid",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "entity": "FixIssue",
                    "name": "errors",
                    "properties": [
                      {
                        "name": "code",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9X1FKBA31YD644QHGNKK",
                "key": "FIX_GENERATED",
                "name": "Fix Generated",
                "payloadSchema": [
                  {
                    "name": "content",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9X1FXCFGBEY4V69VDGM3",
                "key": "FIX_FAILED",
                "name": "Fix Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "id": "evt_01M055GH36DK3W13WQESSSGNSJ",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "id": "evt_01M4DN9X1F63VD9K0J69TV4GEJ",
                "key": "PROGRAM_VALID",
                "name": "Program Valid",
                "payloadSchema": [
                  {
                    "name": "behavior",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9X1FMYVS1C0RK2ASAJP9",
                "key": "FIX_PROPOSED",
                "name": "Fix Proposed",
                "payloadSchema": [
                  {
                    "entity": "FixIssue",
                    "name": "issues",
                    "properties": [
                      {
                        "name": "code",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "fix",
                    "required": true,
                    "type": "string"
                  }
                ]
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "validating"
              },
              {
                "name": "fixing"
              },
              {
                "name": "valid"
              },
              {
                "name": "fixed"
              },
              {
                "name": "failed"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "validating"
                  ],
                  [
                    "program/eval",
                    "@payload.program",
                    {
                      "emit": {
                        "failure": "PROGRAM_INVALID",
                        "success": "PROGRAM_EVALUATED"
                      }
                    }
                  ]
                ],
                "event": "VALIDATE_PROGRAM",
                "eventId": "evt_01M4DN9X1FQKH94WM7XPADHGHB",
                "from": "idle",
                "to": "validating"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "validating",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "valid"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "Valid: ",
                        [
                          "object/get",
                          "@payload.result",
                          "behavior"
                        ]
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "emit",
                    "PROGRAM_VALID",
                    {
                      "behavior": [
                        "object/get",
                        "@payload.result",
                        "behavior"
                      ]
                    }
                  ]
                ],
                "event": "PROGRAM_EVALUATED",
                "eventId": "evt_01M4DN9X1FJMWBTXSWNP51KJH4",
                "from": "validating",
                "to": "valid"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.issues",
                    "@payload.errors"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "fixing"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "Does not validate: ",
                        "@payload.error"
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "call-service",
                    "llm",
                    "generate",
                    {
                      "userPrompt": [
                        "str/concat",
                        "This program does not validate. Explain, step by step, how to fix it. Issues:\n",
                        [
                          "str/join",
                          [
                            "array/map",
                            "@payload.errors",
                            [
                              "fn",
                              "issue",
                              [
                                "str/concat",
                                [
                                  "object/get",
                                  "@issue",
                                  "code"
                                ],
                                ": ",
                                [
                                  "object/get",
                                  "@issue",
                                  "message"
                                ]
                              ]
                            ]
                          ],
                          "\n"
                        ]
                      ]
                    },
                    {
                      "emit": {
                        "failure": "FIX_FAILED",
                        "success": "FIX_GENERATED"
                      }
                    }
                  ]
                ],
                "event": "PROGRAM_INVALID",
                "eventId": "evt_01M4DN9X1F36A48QFZJB2TPK6P",
                "from": "validating",
                "to": "fixing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "fixing",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.fix",
                    "@payload.content"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "fixed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Repair proposed.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "emit",
                    "FIX_PROPOSED",
                    {
                      "fix": "@payload.content",
                      "issues": "@entity.issues"
                    }
                  ]
                ],
                "event": "FIX_GENERATED",
                "eventId": "evt_01M4DN9X1FKBA31YD644QHGNKK",
                "from": "fixing",
                "to": "fixed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "No repair: ",
                        "@payload.error"
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "FIX_FAILED",
                "eventId": "evt_01M4DN9X1FXCFGBEY4V69VDGM3",
                "from": "fixing",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "valid"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "valid",
                "to": "valid"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M055GH36DK3W13WQESSSGNSJ",
                "from": "valid",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "fixed"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "fixed",
                "to": "fixed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M055GH36DK3W13WQESSSGNSJ",
                "from": "fixed",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH363PDMC8GMXCF1K368",
                "from": "failed",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Waiting for a program.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M055GH36DK3W13WQESSSGNSJ",
                "from": "failed",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "Evaluated": [
          {
            "name": "behavior",
            "required": true,
            "type": "string"
          }
        ],
        "FixIssue": [
          {
            "name": "code",
            "required": true,
            "type": "string"
          },
          {
            "name": "message",
