                "event": "AgentChatsLoaded",
                "eventId": "evt_01M429JRCV4F0AQB34G2D8T0Q7",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
