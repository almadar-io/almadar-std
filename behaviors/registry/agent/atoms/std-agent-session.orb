                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  }
                ],
                "synonyms": "ask, converse, request",
                "tier": "domain"
              },
              {
                "description": "The current conversation's messages finished loading (empty for a new conversation).",
                "id": "evt_01M3TYMQH87K7NK4H6DHKPYPM6",
                "key": "AgentMessagesLoaded",
                "name": "AgentMessage s loaded",
                "payloadSchema": [
                  {
                    "entity": "AgentMessage",
                    "name": "data",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "ownerId",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "role",
                        "type": "string"
                      },
                      {
                        "name": "content",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "createdAt",
                        "type": "number"
                      },
                      {
                        "name": "chatId",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
