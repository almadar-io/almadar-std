                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "AgentChat",
                    {
                      "emit": {
                        "failure": "AgentChatsLoadFailed",
                        "success": "ChatsForHistory"
