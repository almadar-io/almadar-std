                "event": "LOAD_HISTORY",
                "eventId": "evt_01M42AXGB62E9GKHP71YD7WB7X",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "ASSISTANT_CHAT_OPENED",
