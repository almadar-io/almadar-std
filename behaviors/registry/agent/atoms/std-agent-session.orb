            "states": [
              {
                "isInitial": true,
                "name": "ready"
              }
            ],
            "transitions": [
              {
                "event": "INIT",
                "eventId": "evt_01M3TYMQH81AV51TX8HBD3BVVY",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "AgentMessagesLoaded",
                    {
                      "data": []
                    }
                  ]
                ],
                "event": "OPEN_CHAT",
                "eventId": "evt_01M42AXGB6HCW17E0H3PY7HEAG",
                "from": "ready",
                "guard": [
                  "=",
                  [
                    "str/default",
                    "@payload.chatId",
                    ""
                  ],
                  ""
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "AgentMessage",
                    {
                      "emit": {
                        "failure": "AgentMessagesLoadFailed",
                        "success": "AgentMessagesLoaded"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "chatId"
                        ],
                        "@payload.chatId"
                      ]
                    }
                  ]
                ],
                "event": "OPEN_CHAT",
                "eventId": "evt_01M42AXGB6HCW17E0H3PY7HEAG",
                "from": "ready",
                "guard": [
                  "not",
                  [
                    "=",
                    [
                      "str/default",
                      "@payload.chatId",
                      ""
                    ],
                    ""
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "AgentMessage",
                    {
                      "chatId": "@payload.chatId",
                      "content": "@payload.message",
                      "createdAt": "@now",
                      "ownerId": "@user.id",
                      "role": "user"
                    },
                    {
                      "emit": {
                        "failure": "AgentMessageSaveFailed",
                        "success": "AgentMessageSaved"
                      }
                    }
                  ]
                ],
                "event": "SEND_IN_CHAT",
                "eventId": "evt_01M42AXGB64E8N3RM9SEXGH1K1",
                "from": "ready",
                "guard": [
                  "not",
                  [
                    "=",
                    [
                      "str/default",
                      "@payload.message",
                      ""
                    ],
                    ""
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "AgentMessage",
                    {
                      "emit": {
                        "failure": "AgentMessagesLoadFailed",
                        "success": "AgentConversationLoaded"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "chatId"
                        ],
                        "@payload.chatId"
                      ]
                    }
                  ]
                ],
                "event": "AgentMessageSaved",
                "eventId": "evt_01M3TYMQH8ACSRY02P4HWBHJWV",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "CONVERSE",
                    {
                      "messages": [
                        "array/map",
                        [
                          "array/sort",
                          "@payload.data",
                          "createdAt",
                          "asc"
                        ],
                        [
                          "fn",
                          "item",
                          {
                            "content": "@item.content",
                            "role": "@item.role"
                          }
                        ]
                      ]
                    }
                  ]
                ],
                "event": "AgentConversationLoaded",
                "eventId": "evt_01M3TYMQH8H65NTWP1KYX7WM6C",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "AgentMessage",
                    {
                      "chatId": "@payload.chatId",
                      "content": "@payload.reply",
                      "createdAt": "@now",
                      "ownerId": "@user.id",
                      "role": "assistant"
                    }
                  ]
                ],
                "event": "REPLY_IN_CHAT",
                "eventId": "evt_01M42AXGB6NDHJ20NTQB18YN8F",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "ASSISTANT_THREAD_FAILED",
                    {
                      "error": "@payload.error"
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "error"
                    }
                  ]
                ],
                "event": "AgentMessagesLoadFailed",
                "eventId": "evt_01M3TYMQH8BHTWREJV617WFH68",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "ASSISTANT_THREAD_FAILED",
                    {
                      "error": "@payload.error"
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "error"
                    }
                  ]
                ],
                "event": "AgentMessageSaveFailed",
                "eventId": "evt_01M3TYMQH8CEE16439Z6N25V08",
                "from": "ready",
                "to": "ready"
              }
            ]
          }
