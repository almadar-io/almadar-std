    {
      "entity": {
        "collection": "agentChats",
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Whose conversation this is (the real @user). The binding organism scopes @read to it.",
            "name": "ownerId",
            "required": true,
            "synonyms": "user, owner, account",
            "type": "string"
          },
          {
            "default": "",
            "description": "The conversation's first request, shown in the conversation list; empty until the first message.",
            "name": "title",
            "synonyms": "name, subject, topic",
            "type": "string"
          },
          {
            "default": 0.0,
            "description": "When the conversation started (ms).",
            "name": "startedAt",
            "synonyms": "created, opened",
            "type": "number"
          },
          {
            "default": 0.0,
            "description": "When the conversation was last used (ms). The most recent one is the current conversation.",
            "name": "lastActiveAt",
            "synonyms": "last used, updated, recent",
            "type": "number"
          },
          {
            "default": "",
            "intrinsic": true,
            "name": "pendingMessage",
            "type": "string"
          },
          {
            "default": "",
            "intrinsic": true,
            "name": "pendingReply",
            "type": "string"
          }
        ],
        "id": "ent_01M429JRCV2YV1V4KFNT8ASWTV",
        "name": "AgentChat",
        "persistence": "persistent"
      },
      "id": "orb_01M42BPQV808JRWSBJ1QD3EX7J",
      "name": "AgentChatsOrbital",
      "pages": [
        {
          "id": "pag_01M42BPQV8G845Q028D3JXY4TH",
          "name": "AgentChatsPage",
          "path": "/agent-session/chats",
          "traits": [
            {
              "ref": "AgentChatList",
              "refId": "trt_01M429JRCV6EG32JMMXDQM2BKJ"
            },
            {
              "ref": "AgentChatKeeper",
              "refId": "trt_01M42AXGB6BAV5Z8KRHFCDQMQQ"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "effectRow": [
            {
              "kind": "emit",
              "resource": "ASSISTANT_CHATS_CHANGED"
            },
            {
              "kind": "emit",
              "resource": "ASSISTANT_CHATS_LOADED"
            },
            {
              "kind": "emit",
              "resource": "ASSISTANT_CHAT_OPENED"
            },
            {
              "kind": "emit",
              "resource": "ASSISTANT_REPLY_IN_CHAT"
            },
            {
              "kind": "emit",
              "resource": "ASSISTANT_SEND_IN_CHAT"
            },
            {
              "kind": "emit",
              "resource": "ASSISTANT_THREAD_FAILED"
            },
            {
              "kind": "fetch",
              "resource": "AgentChat"
            },
            {
              "kind": "persist",
              "resource": "AgentChat"
            },
            {
              "kind": "render-ui",
              "resource": "toast"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingMessage"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingReply"
            }
          ],
          "emits": [
            {
              "description": "This conversation is now the current one (empty for none yet); AgentThread loads its messages.",
              "event": "ASSISTANT_CHAT_OPENED",
              "eventId": "evt_01M42AXGB6QG79WCGD4G200TND",
              "payloadSchema": [
                {
                  "name": "chatId",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "internal"
            },
            {
              "description": "The user's message, placed in the current conversation.",
              "event": "ASSISTANT_SEND_IN_CHAT",
              "eventId": "evt_01M42AXGB6AGV2HHXHY8B3AHW5",
              "payloadSchema": [
                {
                  "name": "chatId",
                  "required": true,
                  "type": "string"
                },
                {
                  "name": "message",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "internal"
            },
            {
              "description": "The assistant's answer, placed in the current conversation.",
              "event": "ASSISTANT_REPLY_IN_CHAT",
              "eventId": "evt_01M42AXGB6KR7AS28C2HQ4R9PZ",
              "payloadSchema": [
                {
                  "name": "chatId",
                  "type": "string"
                },
                {
                  "name": "reply",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "internal"
            },
            {
              "description": "A conversation was started, used or reopened; the conversation list refreshes.",
              "event": "ASSISTANT_CHATS_CHANGED",
              "eventId": "evt_01M42AXGB6WJACSA76BBADRBXE",
              "scope": "external",
              "synonyms": "conversations changed, history changed",
              "tier": "domain"
            },
            {
              "description": "A conversation could not be loaded or stored.",
              "event": "ASSISTANT_THREAD_FAILED",
              "eventId": "evt_01M42AXGB6SPYM11W6MTCY0SQW",
              "payloadSchema": [
                {
                  "name": "error",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            },
            {
              "description": "The person's conversations, most recently used first.",
              "event": "ASSISTANT_CHATS_LOADED",
              "eventId": "evt_01M42F8KA6T30Z2R0J9DGDB1Q2",
              "payloadSchema": [
                {
                  "entity": "AgentChatRow",
                  "name": "data",
                  "properties": [
                    {
                      "name": "id",
                      "required": true,
                      "type": "string"
                    },
                    {
                      "name": "title",
                      "type": "string"
                    },
                    {
                      "name": "lastActiveAt",
                      "type": "number"
                    }
                  ],
                  "required": true,
                  "type": "[object]"
                }
              ],
              "scope": "external",
              "synonyms": "conversations, history",
              "tier": "domain"
            },
            {
              "event": "ChatsForList",
              "eventId": "evt_01M42F8KA6SMX0FDVA2VS1NPJQ",
              "payloadSchema": [
                {
                  "entity": "AgentChat",
                  "name": "data",
                  "properties": [
                    {
                      "name": "id",
                      "required": true,
                      "type": "string"
                    },
                    {
                      "name": "ownerId",
                      "required": true,
                      "type": "string"
                    },
                    {
                      "name": "title",
