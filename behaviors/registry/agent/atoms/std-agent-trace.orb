          "linkedEntity": "AgentRun",
          "linkedEntityId": "ent_01M3TYMQNB6WGTST5HMRSNMPX3",
          "name": "AgentTraceRecorder",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3TYMQNBCWVTFD4ZKMBZRG24",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Record an answered run.",
                "id": "evt_01M3TYMQNBE8P4F8RDEYJREP59",
                "key": "REPLIED",
                "name": "Replied",
                "payloadSchema": [
                  {
                    "name": "reply",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "steps",
                    "properties": [
                      {
                        "name": "kind",
                        "type": "string"
                      },
                      {
                        "name": "target",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "args",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "ok",
                        "required": true,
                        "type": "boolean"
                      },
                      {
                        "name": "detail",
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "usage",
                    "properties": [
                      {
                        "name": "promptTokens",
                        "required": true,
                        "type": "number"
                      },
                      {
                        "name": "completionTokens",
                        "required": true,
                        "type": "number"
                      },
                      {
                        "name": "totalTokens",
                        "required": true,
                        "type": "number"
                      },
                      {
                        "name": "modelCalls",
                        "required": true,
                        "type": "number"
                      }
                    ],
                    "required": true,
                    "type": "object"
                  }
                ]
              },
              {
                "description": "Record a failed run.",
                "id": "evt_01M3TYMQNBEDMKDA8BTG5MSM2Q",
                "key": "REPLY_FAILED",
                "name": "Reply Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "description": "A run was recorded — payload is the created AgentRun row itself.",
                "id": "evt_01M3V04FAZYCB1SNYNNXWBXHWT",
                "key": "RUN_RECORDED",
                "name": "Run Recorded",
                "synonyms": "recorded, logged, traced",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "recording"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.outcome",
                    "answered"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3TYMQNBCWVTFD4ZKMBZRG24",
                "from": "recording",
                "to": "recording"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "AgentRun",
                    {
                      "completionTokens": "@payload.usage.completionTokens",
                      "modelCalls": "@payload.usage.modelCalls",
                      "outcome": "answered",
                      "ownerId": "@user.id",
                      "promptTokens": "@payload.usage.promptTokens",
                      "recordedAt": "@now",
                      "reply": "@payload.reply",
                      "steps": "@payload.steps",
                      "totalTokens": "@payload.usage.totalTokens"
                    },
                    {
                      "emit": {
                        "success": "RUN_RECORDED"
                      }
                    }
                  ]
                ],
                "event": "REPLIED",
                "eventId": "evt_01M3TYMQNBE8P4F8RDEYJREP59",
                "from": "recording",
                "to": "recording"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "AgentRun",
                    {
                      "error": "@payload.error",
                      "outcome": "failed",
                      "ownerId": "@user.id",
                      "recordedAt": "@now"
                    },
                    {
                      "emit": {
                        "success": "RUN_RECORDED"
                      }
                    }
                  ]
                ],
                "event": "REPLY_FAILED",
                "eventId": "evt_01M3TYMQNBEDMKDA8BTG5MSM2Q",
                "from": "recording",
                "to": "recording"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.outcome",
                    "answered"
                  ]
                ],
                "event": "RUN_RECORDED",
                "eventId": "evt_01M3V04FAZYCB1SNYNNXWBXHWT",
                "from": "recording",
                "to": "recording"
              }
            ]
          }
        },
