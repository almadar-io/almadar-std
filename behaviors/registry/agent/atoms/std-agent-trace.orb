  "name": "std-agent-trace",
  "orbitals": [
    {
      "entity": {
        "collection": "agentRuns",
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Whose request this run answered (the real @user). The binding organism scopes @read to it.",
            "name": "ownerId",
            "required": true,
            "synonyms": "user, owner, account",
            "type": "string"
          },
          {
            "default": "answered",
            "description": "Whether the assistant answered.",
            "name": "outcome",
            "synonyms": "result, status",
            "type": "string",
            "values": [
              "answered",
              "failed"
            ]
          },
          {
            "default": "",
            "description": "What the assistant said.",
            "name": "reply",
            "synonyms": "answer, response",
            "type": "string"
          },
          {
            "default": "",
            "description": "Why the run failed.",
            "name": "error",
            "type": "string"
          },
          {
            "default": [],
            "description": "Every tool use, in order.",
            "items": {
              "properties": {
                "args": {
                  "name": "args",
                  "required": true,
                  "type": "string"
                },
                "detail": {
                  "name": "detail",
                  "required": false,
                  "type": "string"
                },
                "kind": {
                  "name": "kind",
                  "required": false,
                  "type": "string",
                  "values": [
                    "input",
                    "read",
                    "invalid"
                  ]
                },
                "ok": {
                  "name": "ok",
                  "required": true,
                  "type": "boolean"
                },
                "target": {
                  "name": "target",
                  "required": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "name": "steps",
            "synonyms": "actions, tool calls, trace",
            "type": "array"
          },
          {
            "default": 0.0,
            "description": "Tokens sent to the model.",
            "name": "promptTokens",
            "type": "number"
          },
          {
            "default": 0.0,
            "description": "Tokens the model produced.",
            "name": "completionTokens",
            "type": "number"
          },
          {
            "default": 0.0,
            "description": "All tokens for the run.",
            "name": "totalTokens",
            "type": "number"
          },
          {
            "default": 0.0,
            "description": "Model round-trips.",
            "name": "modelCalls",
            "synonyms": "turns, calls",
            "type": "number"
          },
          {
            "default": 0.0,
            "description": "When the run finished (ms).",
            "name": "recordedAt",
            "synonyms": "time, timestamp",
            "type": "number"
          }
        ],
