      }
    },
    "schemaVersion": 1
  },
  "name": "std-agent-context",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "default": [],
            "description": "The conversation being compacted.",
            "items": {
              "properties": {
                "content": {
                  "name": "content",
                  "required": true,
                  "type": "string"
                },
                "role": {
                  "name": "role",
                  "required": false,
                  "type": "string",
                  "values": [
                    "user",
                    "assistant"
                  ]
                }
              },
              "type": "object"
            },
            "name": "pendingMessages",
            "type": "array"
          },
          {
            "default": 0.0,
            "description": "Turns in the last conversation compacted.",
            "name": "lastSize",
            "synonyms": "size, length",
            "type": "number"
          },
          {
            "default": "",
            "description": "The ephemeral conversation's own instructions, carried through a summarizing.",
            "name": "pendingInstructions",
            "type": "string"
          },
          {
            "default": [],
            "description": "The ephemeral conversation's own tools, carried through a summarizing.",
            "items": {
              "properties": {
                "AgentToolInput": {
                  "name": "AgentToolInput",
                  "properties": {
                    "event": {
                      "name": "event",
                      "required": true,
                      "type": "EventAddress"
                    }
                  },
                  "type": "object"
                },
                "AgentToolRead": {
                  "name": "AgentToolRead",
                  "properties": {
                    "read": {
                      "name": "read",
                      "required": true,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "AgentToolScope": {
                  "name": "AgentToolScope",
                  "properties": {
                    "scope": {
                      "name": "scope",
                      "required": true,
                      "type": "string",
                      "values": [
                        "declared"
                      ]
                    }
                  },
                  "type": "object"
                }
              },
              "type": "union",
              "values": [
                "AgentToolScope",
                "AgentToolInput",
                "AgentToolRead"
              ]
            },
            "name": "pendingTools",
            "type": "array"
          },
          {
            "default": false,
            "description": "The conversation being compacted is ephemeral.",
            "name": "pendingEphemeral",
            "type": "boolean"
          }
        ],
        "id": "ent_01M3TYMQJMGY8DD73YX22WEW07",
        "name": "AgentContextWindow",
        "persistence": "runtime"
      },
      "id": "orb_01KXG04EJ6F1D9RV8QYMR1QHR3",
      "name": "AgentContextOrbital",
      "pages": [
        {
          "id": "pag_01KXG04EJ62CMMJ76JEYM9DSF9",
          "name": "AgentContextPage",
          "path": "/agent-context",
          "traits": [
            {
              "ref": "AgentContextCompactor",
              "refId": "trt_01M3TYMQJMC4BF9VHSEYHSTK7T"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "keepMessages": {
              "default": 12.0,
              "description": "The most recent turns sent to the model word for word; older turns are summarized.",
              "label": "Turns kept verbatim",
              "synonyms": "window, history length, context size",
              "tier": "policy",
              "type": "number"
            }
          },
          "effectRow": [
            {
              "kind": "call-service",
              "resource": "llm.summarize"
            },
            {
              "kind": "emit",
              "resource": "COMPACTED"
            },
            {
              "kind": "render-ui",
              "resource": "toast"
            },
            {
              "kind": "set",
              "resource": "@entity.lastSize"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingEphemeral"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingInstructions"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingMessages"
            },
            {
              "kind": "set",
              "resource": "@entity.pendingTools"
            }
          ],
          "emits": [
            {
              "description": "The conversation, bounded: recent turns verbatim, older turns as one summary note. An ephemeral conversation's own `instructions`, `tools` and `ephemeral` flag pass through untouched.",
              "event": "COMPACTED",
              "eventId": "evt_01M3TYMQJM2ZA1HG90KARCHVXQ",
              "payloadSchema": [
                {
                  "entity": "AgentChatMessage",
                  "name": "messages",
                  "properties": [
                    {
                      "name": "role",
                      "type": "string"
                    },
                    {
                      "name": "content",
                      "required": true,
                      "type": "string"
                    }
                  ],
                  "required": true,
                  "type": "[object]"
                },
                {
                  "name": "instructions",
                  "type": "string"
                },
                {
                  "name": "tools",
                  "type": "[AgentTool]"
                },
                {
                  "name": "ephemeral",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "compacted, trimmed, bounded",
              "tier": "domain"
            },
            {
              "event": "ContextSummarized",
              "eventId": "evt_01M3TYMQJMRZ7YJPCJWBHGQX9B",
              "payloadSchema": [
                {
                  "name": "summary",
                  "type": "string"
                },
                {
                  "name": "keyPoints",
                  "type": "[string]"
                }
              ],
              "scope": "internal",
              "tier": "internal"
            },
            {
              "event": "ContextSummarizeFailed",
              "eventId": "evt_01M3TYMQJMZQCGCNED97HQS2TE",
              "payloadSchema": [
                {
                  "name": "error",
                  "type": "string"
                }
              ],
              "scope": "internal",
              "tier": "internal"
            }
          ],
          "entityRefIds": {
            "AgentContextWindow": "ent_01M3TYMQJMGY8DD73YX22WEW07"
          },
          "id": "trt_01M3TYMQJMC4BF9VHSEYHSTK7T",
          "linkedEntity": "AgentContextWindow",
          "linkedEntityId": "ent_01M3TYMQJMGY8DD73YX22WEW07",
          "name": "AgentContextCompactor",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3TYMQJMHE4K52TH9CXAWQDV",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Bound this conversation for the model. An ephemeral conversation's own `instructions`, `tools` and `ephemeral` flag ride along.",
                "id": "evt_01M3TYMQJMSZDFZ983H5ZFRA80",
                "key": "COMPACT",
                "name": "Compact",
                "payloadSchema": [
                  {
                    "name": "messages",
                    "properties": [
                      {
                        "name": "role",
                        "type": "string"
                      },
                      {
                        "name": "content",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "instructions",
                    "type": "string"
                  },
                  {
                    "name": "tools",
                    "type": "[AgentTool]"
                  },
                  {
                    "name": "ephemeral",
                    "type": "boolean"
                  }
                ]
              },
              {
                "id": "evt_01M3TYMQJMRZ7YJPCJWBHGQX9B",
                "key": "ContextSummarized",
                "name": "Context summarized",
                "payloadSchema": [
                  {
                    "name": "summary",
                    "type": "string"
                  },
                  {
                    "name": "keyPoints",
                    "type": "[string]"
                  }
                ],
                "tier": "internal"
              },
              {
                "id": "evt_01M3TYMQJMZQCGCNED97HQS2TE",
                "key": "ContextSummarizeFailed",
                "name": "Context summarize failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  }
                ],
                "tier": "internal"
              },
              {
                "description": "The conversation, bounded: recent turns verbatim, older turns as one summary note. An ephemeral conversation's own `instructions`, `tools` and `ephemeral` flag pass through untouched.",
                "id": "evt_01M3TYMQJM2ZA1HG90KARCHVXQ",
                "key": "COMPACTED",
                "name": "Compacted",
                "payloadSchema": [
                  {
                    "entity": "AgentChatMessage",
                    "name": "messages",
                    "properties": [
                      {
                        "name": "role",
                        "type": "string"
                      },
                      {
                        "name": "content",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "instructions",
                    "type": "string"
                  },
                  {
                    "name": "tools",
                    "type": "[AgentTool]"
                  },
                  {
                    "name": "ephemeral",
                    "type": "boolean"
                  }
                ],
                "synonyms": "compacted, trimmed, bounded",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "ready"
              },
              {
                "name": "summarizing"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.lastSize",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3TYMQJMHE4K52TH9CXAWQDV",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.lastSize",
                    [
                      "array/len",
                      "@payload.messages"
                    ]
                  ],
                  [
                    "emit",
                    "COMPACTED",
                    {
                      "ephemeral": [
                        "if",
                        "@payload.ephemeral",
                        true,
                        false
                      ],
                      "instructions": [
                        "str/default",
                        "@payload.instructions",
                        ""
                      ],
                      "messages": "@payload.messages",
                      "tools": [
                        "object/get",
                        "@payload",
                        "tools",
                        []
                      ]
                    }
                  ]
                ],
                "event": "COMPACT",
                "eventId": "evt_01M3TYMQJMSZDFZ983H5ZFRA80",
                "from": "ready",
                "guard": [
                  "<=",
                  [
                    "array/len",
                    "@payload.messages"
                  ],
                  "@config.keepMessages"
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.lastSize",
                    [
                      "array/len",
                      "@payload.messages"
                    ]
                  ],
                  [
                    "set",
                    "@entity.pendingMessages",
                    "@payload.messages"
                  ],
                  [
                    "set",
                    "@entity.pendingInstructions",
                    [
                      "str/default",
                      "@payload.instructions",
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.pendingTools",
                    [
                      "object/get",
                      "@payload",
                      "tools",
                      []
                    ]
                  ],
                  [
                    "set",
                    "@entity.pendingEphemeral",
                    [
                      "if",
                      "@payload.ephemeral",
                      true,
                      false
                    ]
                  ],
                  [
                    "call-service",
                    "llm",
                    "summarize",
                    {
                      "text": [
                        "str/join",
                        [
                          "array/map",
                          [
                            "array/dropLast",
                            "@payload.messages",
                            "@config.keepMessages"
                          ],
                          [
                            "fn",
                            "item",
                            [
                              "str/concat",
                              "@item.role",
                              ": ",
                              "@item.content"
                            ]
                          ]
                        ],
                        "\n"
                      ]
                    },
                    {
                      "emit": {
                        "failure": "ContextSummarizeFailed",
                        "success": "ContextSummarized"
                      }
                    }
                  ]
                ],
                "event": "COMPACT",
                "eventId": "evt_01M3TYMQJMSZDFZ983H5ZFRA80",
                "from": "ready",
                "guard": [
                  ">",
                  [
                    "array/len",
                    "@payload.messages"
                  ],
                  "@config.keepMessages"
                ],
                "to": "summarizing"
              },
              {
                "effects": [
                  [
                    "emit",
                    "COMPACTED",
                    {
                      "ephemeral": "@entity.pendingEphemeral",
                      "instructions": "@entity.pendingInstructions",
                      "messages": [
                        "array/prepend",
                        [
                          "array/takeLast",
                          "@entity.pendingMessages",
                          "@config.keepMessages"
                        ],
                        {
                          "content": [
                            "str/concat",
                            "Earlier in this conversation: ",
                            "@payload.summary"
                          ],
                          "role": "assistant"
                        }
                      ],
                      "tools": "@entity.pendingTools"
                    }
                  ]
                ],
                "event": "ContextSummarized",
                "eventId": "evt_01M3TYMQJMRZ7YJPCJWBHGQX9B",
                "from": "summarizing",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "COMPACTED",
                    {
                      "ephemeral": "@entity.pendingEphemeral",
                      "instructions": "@entity.pendingInstructions",
                      "messages": [
                        "array/takeLast",
                        "@entity.pendingMessages",
                        "@config.keepMessages"
                      ],
                      "tools": "@entity.pendingTools"
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "warning"
                    }
                  ]
                ],
                "event": "ContextSummarizeFailed",
                "eventId": "evt_01M3TYMQJMZQCGCNED97HQS2TE",
                "from": "summarizing",
                "to": "ready"
              }
            ]
          }
        }
      ],
      "types": {
        "AgentChatMessage": [
          {
            "name": "role",
            "type": "string"
          },
          {
            "name": "content",
            "required": true,
            "type": "string"
          }
        ],
        "AgentToolInput": [
          {
            "name": "event",
            "required": true,
            "type": "EventAddress"
          }
        ],
        "AgentToolRead": [
          {
            "name": "read",
            "required": true,
            "type": "string"
          }
        ],
        "AgentToolScope": [
          {
            "name": "scope",
            "required": true,
            "type": "string"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "2.0.0"
}