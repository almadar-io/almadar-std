        "id": "orb_01KXG04EJ6F1D9RV8QYMR1QHR3",
        "kind": "orbital",
        "owner": "workspace",
        "renames": []
      },
      "pag_01KXG04EJ62CMMJ76JEYM9DSF9": {
        "bakedName": "AgentContextPage",
        "curName": "AgentContextPage",
        "id": "pag_01KXG04EJ62CMMJ76JEYM9DSF9",
        "kind": "page",
        "owner": "workspace",
        "renames": []
      },
      "trt_01M3TYMQJMC4BF9VHSEYHSTK7T": {
        "bakedName": "AgentContextCompactor",
        "curName": "AgentContextCompactor",
        "id": "trt_01M3TYMQJMC4BF9VHSEYHSTK7T",
