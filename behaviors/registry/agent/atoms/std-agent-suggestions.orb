                "key": "SuggestionSaveFailed",
                "name": "Suggestion save failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "tier": "internal"
              },
              {
                "description": "A suggestion was stored for the person — payload is the created AgentSuggestion row itself.",
                "id": "evt_01M45A3ZSM1JEE7G11HPVY4D22",
                "key": "SUGGESTION_ADDED",
                "name": "Suggestion Added",
                "synonyms": "proposed, suggested, new suggestion",
                "tier": "domain"
              },
              {
                "description": "This signature was already proposed to the person (pending, accepted or dismissed), so nothing was stored.",
                "id": "evt_01M45A3ZSMSB0SE1BRAJQZ0G3V",
                "key": "SUGGESTION_DUPLICATE",
                "name": "Suggestion Duplicate",
                "payloadSchema": [
                  {
                    "name": "signature",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "already proposed, repeat, seen before",
                "tier": "domain"
              },
              {
                "description": "The person already has the most pending suggestions allowed, so nothing was stored.",
                "id": "evt_01M45A3ZSMKN83W8F28Z8RNT40",
                "key": "SUGGESTION_LIMIT_REACHED",
                "name": "Suggestion Limit Reached",
                "payloadSchema": [
                  {
                    "name": "maxPending",
                    "required": true,
                    "type": "number"
                  }
                ],
                "synonyms": "too many, queue full, cap",
                "tier": "domain"
              },
              {
                "description": "The proposal was refused (a kind or action not allowed, or it could not be checked or stored); the reason says why.",
                "id": "evt_01M45A3ZSMV9HQJH2HW0XGHN3K",
                "key": "SUGGESTION_REJECTED",
                "name": "Suggestion Rejected",
                "payloadSchema": [
                  {
                    "name": "reason",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "refused, invalid, not allowed",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "ready"
              }
            ],
            "transitions": [
              {
                "event": "INIT",
                "eventId": "evt_01M45A3ZSMXJKQ1KB8564MHABV",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_REJECTED",
                    {
                      "reason": [
                        "str/concat",
                        "Unknown kind \"",
                        "@payload.kind",
                        "\". Allowed kinds: ",
                        [
                          "str/join",
                          "@config.allowedKinds",
                          ", "
                        ]
                      ]
                    }
                  ]
                ],
                "event": "PROPOSE_SUGGESTION",
                "eventId": "evt_01M45A3ZSM95RHXS6FT8WT65S2",
                "from": "ready",
                "guard": [
                  "and",
                  [
                    ">",
                    [
                      "array/len",
                      "@config.allowedKinds"
                    ],
                    0.0
                  ],
                  [
                    "not",
                    [
                      "array/includes",
                      "@config.allowedKinds",
                      "@payload.kind"
                    ]
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_REJECTED",
                    {
                      "reason": [
                        "str/concat",
                        "Unknown action \"",
                        [
                          "str/default",
                          "@payload.action",
                          ""
                        ],
                        "\". Allowed actions: ",
                        [
                          "str/join",
                          "@config.allowedActions",
                          ", "
                        ]
                      ]
                    }
                  ]
                ],
                "event": "PROPOSE_SUGGESTION",
                "eventId": "evt_01M45A3ZSM95RHXS6FT8WT65S2",
                "from": "ready",
                "guard": [
                  "and",
                  [
                    "or",
                    [
                      "=",
                      [
                        "array/len",
                        "@config.allowedKinds"
                      ],
                      0.0
                    ],
                    [
                      "array/includes",
                      "@config.allowedKinds",
                      "@payload.kind"
                    ]
                  ],
                  [
                    ">",
                    [
                      "array/len",
                      "@config.allowedActions"
                    ],
                    0.0
                  ],
                  [
                    "not",
                    [
                      "array/includes",
                      "@config.allowedActions",
                      [
                        "str/default",
                        "@payload.action",
                        ""
                      ]
                    ]
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.pendingProposal",
                    {
                      "action": [
                        "str/default",
                        "@payload.action",
                        ""
                      ],
                      "body": [
                        "str/default",
                        "@payload.body",
                        ""
                      ],
                      "href": [
                        "str/default",
                        "@payload.href",
                        ""
                      ],
                      "kind": "@payload.kind",
                      "payload": [
                        "if",
                        "@payload.payload",
                        "@payload.payload",
                        {}
                      ],
                      "signature": [
                        "str/concat",
                        "@payload.kind",
                        ":",
                        [
                          "str/default",
                          "@payload.action",
                          ""
                        ],
                        ":",
                        "@payload.subject"
                      ],
                      "subject": "@payload.subject",
                      "title": "@payload.title"
                    }
                  ],
                  [
                    "fetch",
                    "AgentSuggestion",
                    {
                      "emit": {
                        "failure": "SuggestionCheckFailed",
                        "success": "SuggestionsForPropose"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "ownerId"
                        ],
                        "@user.id"
                      ]
                    }
                  ]
                ],
                "event": "PROPOSE_SUGGESTION",
                "eventId": "evt_01M45A3ZSM95RHXS6FT8WT65S2",
                "from": "ready",
                "guard": [
                  "and",
                  [
                    "or",
                    [
                      "=",
                      [
                        "array/len",
                        "@config.allowedKinds"
                      ],
                      0.0
                    ],
                    [
                      "array/includes",
                      "@config.allowedKinds",
                      "@payload.kind"
                    ]
                  ],
                  [
                    "or",
                    [
                      "=",
                      [
                        "array/len",
                        "@config.allowedActions"
                      ],
                      0.0
                    ],
                    [
                      "array/includes",
                      "@config.allowedActions",
                      [
                        "str/default",
                        "@payload.action",
                        ""
                      ]
                    ]
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_DUPLICATE",
                    {
                      "signature": "@entity.pendingProposal.signature"
                    }
                  ]
                ],
                "event": "SuggestionsForPropose",
                "eventId": "evt_01M45A3ZSMWKKZVA1APWSCE3EM",
                "from": "ready",
                "guard": [
                  "array/some",
                  "@payload.data",
                  [
                    "fn",
                    "item",
                    [
                      "=",
                      "@item.signature",
                      "@entity.pendingProposal.signature"
                    ]
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_LIMIT_REACHED",
                    {
                      "maxPending": "@config.pendingLimit"
                    }
                  ]
                ],
                "event": "SuggestionsForPropose",
                "eventId": "evt_01M45A3ZSMWKKZVA1APWSCE3EM",
                "from": "ready",
                "guard": [
                  "and",
                  [
                    "not",
                    [
                      "array/some",
                      "@payload.data",
                      [
                        "fn",
                        "item",
                        [
                          "=",
                          "@item.signature",
                          "@entity.pendingProposal.signature"
                        ]
                      ]
                    ]
                  ],
                  [
                    ">=",
                    [
                      "array/count",
                      "@payload.data",
                      [
                        "fn",
                        "item",
                        [
                          "=",
                          "@item.status",
                          "pending"
                        ]
                      ]
                    ],
                    "@config.pendingLimit"
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "persist",
                    "create",
                    "AgentSuggestion",
                    {
                      "action": "@entity.pendingProposal.action",
                      "body": "@entity.pendingProposal.body",
                      "createdAt": "@now",
                      "href": "@entity.pendingProposal.href",
                      "kind": "@entity.pendingProposal.kind",
                      "ownerId": "@user.id",
                      "payload": "@entity.pendingProposal.payload",
                      "signature": "@entity.pendingProposal.signature",
                      "status": "pending",
                      "subject": "@entity.pendingProposal.subject",
                      "title": "@entity.pendingProposal.title"
                    },
                    {
                      "emit": {
                        "failure": "SuggestionSaveFailed",
                        "success": "SUGGESTION_ADDED"
                      }
                    }
                  ]
                ],
                "event": "SuggestionsForPropose",
                "eventId": "evt_01M45A3ZSMWKKZVA1APWSCE3EM",
                "from": "ready",
                "guard": [
                  "and",
                  [
                    "not",
                    [
                      "array/some",
                      "@payload.data",
                      [
                        "fn",
                        "item",
                        [
                          "=",
                          "@item.signature",
                          "@entity.pendingProposal.signature"
                        ]
                      ]
                    ]
                  ],
                  [
                    "<",
                    [
                      "array/count",
                      "@payload.data",
                      [
                        "fn",
                        "item",
                        [
                          "=",
                          "@item.status",
                          "pending"
                        ]
                      ]
                    ],
                    "@config.pendingLimit"
                  ]
                ],
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_REJECTED",
                    {
                      "reason": [
                        "str/concat",
                        "Could not check earlier suggestions: ",
                        "@payload.error"
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "warning"
                    }
                  ]
                ],
                "event": "SuggestionCheckFailed",
                "eventId": "evt_01M45A3ZSMNMG55P7QX0ACKQ5F",
                "from": "ready",
                "to": "ready"
              },
              {
                "effects": [
                  [
                    "emit",
                    "SUGGESTION_REJECTED",
                    {
                      "reason": [
                        "str/concat",
                        "Could not store the suggestion: ",
                        "@payload.error"
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "warning"
                    }
                  ]
                ],
                "event": "SuggestionSaveFailed",
                "eventId": "evt_01M45A3ZSME98W1RQ8V9J8ZQXT",
                "from": "ready",
                "to": "ready"
              }
            ]
          }
