                "effects": [
                  [
                    "fetch",
                    "AgentSuggestion",
                    {
                      "emit": {
                        "failure": "SuggestionsLoadFailed",
                        "success": "SuggestionsLoaded"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "ownerId"
                        ],
                        "@user.id"
                      ]
                    }
                  ]
                ],
                "event": "OPEN",
                "eventId": "evt_01M45A3ZSMQWCD6DKPHAM78TEK",
                "from": "closed",
                "to": "open"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "@config.inboxSlot",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            {
                              "align": "center",
                              "children": [
                                {
                                  "name": "@config.headingIcon",
                                  "size": "lg",
                                  "type": "icon"
                                },
                                {
                                  "content": "@config.heading",
                                  "type": "typography",
                                  "variant": "h3"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            [
                              "if",
                              [
                                "not",
                                [
                                  "=",
                                  "@config.inboxSlot",
                                  "main"
                                ]
                              ],
                              {
                                "action": "CLOSE",
                                "icon": "x",
                                "label": "@config.closeButtonLabel",
                                "type": "button",
                                "variant": "ghost"
                              },
                              null
                            ]
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "justify": "between",
                          "type": "stack"
                        },
                        {
                          "type": "divider"
                        },
                        {
                          "emptyAction": {
                            "event": "ANALYZE",
                            "label": "@config.lookAgainLabel"
                          },
                          "emptyDescription": "@config.emptyHint",
                          "emptyTitle": "@config.emptyHeading",
                          "entity": [
                            "array/sort",
                            [
                              "array/filter",
                              "@payload.data",
                              [
                                "fn",
                                "item",
                                [
                                  "=",
                                  "@item.status",
                                  "pending"
                                ]
                              ]
                            ],
                            "createdAt",
                            "desc"
                          ],
                          "fields": [
                            {
                              "label": "Kind",
                              "name": "kind",
                              "variant": "badge"
                            },
                            {
                              "label": "Suggestion",
                              "name": "title",
                              "variant": "h4"
                            },
                            {
                              "label": "Why",
                              "name": "body",
                              "variant": "body"
                            }
                          ],
                          "gap": "sm",
                          "itemActions": [
                            {
                              "event": "ACCEPT",
                              "icon": "check",
                              "label": "@config.approveLabel",
                              "variant": "primary"
                            },
                            {
                              "event": "DISMISS",
                              "icon": "x",
                              "label": "@config.declineLabel",
                              "variant": "ghost"
                            }
                          ],
                          "type": "data-list",
                          "variant": "card"
                        },
                        [
                          "if",
                          [
                            "not",
                            [
                              "=",
                              "@config.historyLink",
                              ""
