            ],
            "states": [
              {
                "isInitial": true,
                "name": "closed"
              },
              {
                "name": "open"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "AgentSuggestion",
                    {
                      "emit": {
                        "failure": "SuggestionsLoadFailed",
                        "success": "SuggestionsLoaded"
                      },
                      "filter": [
                        "=",
                        [
                          "object/get",
                          "@entity",
                          "ownerId"
                        ],
                        "@user.id"
                      ]
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M45A3ZSMQM2WAFRRJXB0K2C9",
                "from": "closed",
                "guard": "@config.showOnMount",
                "to": "open"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "@config.inboxSlot",
                    null
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M45A3ZSMQM2WAFRRJXB0K2C9",
                "from": "closed",
                "guard": [
                  "not",
                  "@config.showOnMount"
                ],
                "to": "closed"
              },
