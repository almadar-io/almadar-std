                  ],
                  [
                    "call-service",
                    "llm",
                    "call-tools",
                    {
                      "instructions": [
                        "if",
                        [
                          "=",
                          [
                            "str/default",
                            "@payload.context",
                            ""
                          ],
                          ""
                        ],
                        "@config.instructions",
                        [
                          "str/concat",
                          "@config.instructions",
                          "\n\nWhat you remember that may be relevant:\n",
                          "@payload.context"
                        ]
                      ],
                      "maxSteps": "@config.maxSteps",
                      "messages": "@payload.messages",
                      "tools": "@config.tools"
                    },
                    {
                      "emit": {
                        "failure": "ASK_FAILED",
                        "onMessage": "STEP",
                        "success": "ANSWERED"
                      }
                    }
                  ]
                ],
                "event": "CONVERSE",
                "eventId": "evt_01M3TYMQFVAN072R0C2Z5X5NPQ",
                "from": "idle",
                "to": "thinking"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "answered"
                  ],
                  [
                    "set",
                    "@entity.reply",
                    "@payload.reply"
                  ],
                  [
                    "emit",
                    "REPLIED",
                    {
                      "reply": "@payload.reply",
                      "steps": "@payload.steps",
                      "usage": "@payload.usage"
                    }
                  ]
                ],
                "event": "ANSWERED",
                "eventId": "evt_01M3TYMQFVCJWHGK649HS8W7NA",
                "from": "thinking",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "emit",
                    "REPLY_FAILED",
                    {
                      "error": "@payload.error"
                    }
                  ],
                  [
                    "render-ui",
                    "toast",
                    {
                      "message": "@payload.error",
                      "type": "alert",
                      "variant": "error"
                    }
                  ]
                ],
                "event": "ASK_FAILED",
                "eventId": "evt_01M3TYMQFVB6QA7HQ3KR6GGHHX",
                "from": "thinking",
                "to": "idle"
              }
            ]
          }
        }
      ],
