          },
          "id": "trt_01KXG04ERRSH2Z6RSJRJ297BQJ",
          "linkedEntity": "BuilderProcess",
          "linkedEntityId": "ent_01KXG04ERRVA2AHCJ4BR9BBY0H",
          "name": "BuilderPipeline",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "external": true,
                "id": "evt_01KXG04ERRMQ9SX7E111QF65W4",
                "key": "START",
                "name": "Start",
                "payloadSchema": [
                  {
                    "name": "request",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "orbitalName",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9WY3FWZWCANHWPFY4T6X",
                "key": "REQUEST_EMBEDDED",
                "name": "Request Embedded",
                "payloadSchema": [
                  {
                    "name": "embeddings",
                    "required": true,
                    "type": "[[number]]"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9WY3J9WJN3RAW4K6W9DJ",
                "key": "CATALOG_LISTED",
                "name": "Catalog Listed",
                "payloadSchema": [
                  {
                    "entity": "CatalogHit",
                    "name": "result",
                    "properties": [
                      {
                        "name": "behavior",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "traits",
                        "required": true,
                        "type": "[trait]"
                      },
                      {
                        "name": "vectors",
                        "type": "Map<string,[number]>"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9WY3W7GQTTA2YC312036",
                "key": "BUILD_FAILED",
                "name": "Build Failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "entity": "BuildIssue",
                    "name": "errors",
                    "properties": [
                      {
                        "name": "code",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9WY30QWSXD9FHXCWZA4H",
                "key": "BUILT",
                "name": "Built",
                "payloadSchema": [
                  {
                    "name": "result",
                    "properties": [
                      {
                        "name": "behavior",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "object"
                  }
                ]
              },
              {
                "id": "evt_01KXG04ERRJ7DFJBZY3F9R42PZ",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "id": "evt_01KXG04ERRHFSTKHKQK2KVQHWQ",
                "key": "BUILD_COMPLETE",
                "name": "Build Complete",
                "payloadSchema": [
                  {
                    "name": "orbitalName",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "behavior",
                    "required": true,
                    "type": "string"
                  }
                ]
              },
              {
                "id": "evt_01M4DN9WY3V2Z6Z6R3WEZR5T0N",
                "key": "BUILD_REJECTED",
                "name": "Build Rejected",
                "payloadSchema": [
                  {
                    "name": "error",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "entity": "BuildIssue",
                    "name": "errors",
                    "properties": [
                      {
                        "name": "code",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ]
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "searching"
              },
              {
                "name": "building"
              },
              {
                "name": "done"
              },
              {
                "name": "failed"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Ready to build.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.request",
                    "@payload.request"
                  ],
                  [
                    "set",
                    "@entity.orbitalName",
                    "@payload.orbitalName"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "searching"
                  ],
                  [
                    "call-service",
                    "llm",
                    "embed",
                    {
                      "texts": [
                        "@payload.request"
                      ]
                    },
                    {
                      "emit": {
                        "failure": "BUILD_FAILED",
                        "success": "REQUEST_EMBEDDED"
                      }
                    }
                  ]
                ],
                "event": "START",
                "eventId": "evt_01KXG04ERRMQ9SX7E111QF65W4",
                "from": "idle",
                "to": "searching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "searching"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "from": "searching",
                "to": "searching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.queryVector",
                    [
                      "array/first",
                      "@payload.embeddings"
                    ]
                  ],
                  [
                    "behavior/catalog",
                    {
                      "paths": "@config.scope"
                    },
                    {
                      "emit": {
                        "failure": "BUILD_FAILED",
                        "success": "CATALOG_LISTED"
                      }
                    }
                  ]
                ],
                "event": "REQUEST_EMBEDDED",
                "eventId": "evt_01M4DN9WY3FWZWCANHWPFY4T6X",
                "from": "searching",
                "guard": [
                  ">",
                  [
                    "array/len",
                    "@payload.embeddings"
                  ],
                  0.0
                ],
                "to": "searching"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "The model returned no embedding"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Build failed: the model returned no embedding.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "emit",
                    "BUILD_REJECTED",
                    {
                      "error": "The model returned no embedding",
                      "errors": []
                    }
                  ]
                ],
                "event": "REQUEST_EMBEDDED",
                "eventId": "evt_01M4DN9WY3FWZWCANHWPFY4T6X",
                "from": "searching",
                "guard": [
                  "=",
                  [
                    "array/len",
                    "@payload.embeddings"
                  ],
                  0.0
                ],
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.pick",
                    [
                      "object/get",
                      [
                        "array/first",
                        [
                          "array/sort",
                          [
                            "array/map",
                            "@payload.result",
                            [
                              "fn",
                              "entry",
                              {
                                "score": [
                                  "array/cosine",
                                  [
                                    "object/get",
                                    "@entry.vectors",
                                    "description"
                                  ],
                                  "@entity.queryVector"
                                ],
                                "trait": [
                                  "array/first",
                                  "@entry.traits"
                                ]
                              }
                            ]
                          ],
                          "score",
                          "desc"
                        ]
                      ],
                      "trait"
                    ]
                  ],
                  [
                    "set",
                    "@entity.status",
                    "building"
                  ],
                  [
                    "program/eval",
                    [
                      "quasiquote",
                      "{\"name\":[\"unquote\",0],\"orbitals\":[{\"entity\":{\"fields\":[{\"name\":\"id\",\"type\":\"string\"}],\"name\":\"BuiltView\",\"persistence\":\"runtime\"},\"name\":[\"unquote\",1],\"pages\":[{\"name\":\"Built\",\"path\":\"/\",\"traits\":[{\"ref\":\"BuiltFrame\"}]}],\"traits\":[{\"linkedEntity\":\"BuiltView\",\"name\":\"BuiltFrame\",\"scope\":\"instance\",\"stateMachine\":{\"events\":[{\"key\":\"INIT\",\"name\":\"Init\"}],\"states\":[{\"isInitial\":true,\"name\":\"idle\"}],\"transitions\":[{\"effects\":[[\"render-ui\",\"main\",{\"children\":[[\"unquote\",2]],\"type\":\"stack\"}]],\"event\":\"INIT\",\"from\":\"idle\",\"to\":\"idle\"}]}}]}]}",
                      "@entity.orbitalName",
                      "@entity.orbitalName",
                      "@entity.pick"
                    ],
                    {
                      "emit": {
                        "failure": "BUILD_FAILED",
                        "success": "BUILT"
                      }
                    }
                  ]
                ],
                "event": "CATALOG_LISTED",
                "eventId": "evt_01M4DN9WY3J9WJN3RAW4K6W9DJ",
                "from": "searching",
                "guard": [
                  ">",
                  [
                    "array/len",
                    "@payload.result"
                  ],
                  0.0
                ],
                "to": "building"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "No building block in scope"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "No building block in scope.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "CATALOG_LISTED",
                "eventId": "evt_01M4DN9WY3J9WJN3RAW4K6W9DJ",
                "from": "searching",
                "guard": [
                  "=",
                  [
                    "array/len",
                    "@payload.result"
                  ],
                  0.0
                ],
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "Build failed: ",
                        "@payload.error"
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "BUILD_FAILED",
                "eventId": "evt_01M4DN9WY3W7GQTTA2YC312036",
                "from": "searching",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "building"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "from": "building",
                "to": "building"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.behavior",
                    [
                      "object/get",
                      "@payload.result",
                      "behavior"
                    ]
                  ],
                  [
                    "set",
                    "@entity.status",
                    "done"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "Built ",
                        [
                          "object/get",
                          "@payload.result",
                          "behavior"
                        ]
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "emit",
                    "BUILD_COMPLETE",
                    {
                      "behavior": [
                        "object/get",
                        "@payload.result",
                        "behavior"
                      ],
                      "orbitalName": "@entity.orbitalName"
                    }
                  ]
                ],
                "event": "BUILT",
                "eventId": "evt_01M4DN9WY30QWSXD9FHXCWZA4H",
                "from": "building",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.error",
                    "@payload.error"
                  ],
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": [
                        "str/concat",
                        "Build failed: ",
                        "@payload.error"
                      ],
                      "type": "typography",
                      "variant": "caption"
                    }
                  ],
                  [
                    "emit",
                    "BUILD_REJECTED",
                    {
                      "error": "@payload.error",
                      "errors": "@payload.errors"
                    }
                  ]
                ],
                "event": "BUILD_FAILED",
                "eventId": "evt_01M4DN9WY3W7GQTTA2YC312036",
                "from": "building",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "done"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "from": "done",
                "to": "done"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.pick",
                    null
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Ready to build.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KXG04ERRJ7DFJBZY3F9R42PZ",
                "from": "done",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "failed"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04ERRH3TM9ZVJYPDS7QE8",
                "from": "failed",
                "to": "failed"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ],
                  [
                    "set",
                    "@entity.pick",
                    null
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "content": "Ready to build.",
                      "type": "typography",
                      "variant": "caption"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KXG04ERRJ7DFJBZY3F9R42PZ",
                "from": "failed",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "BuildIssue": [
          {
            "name": "code",
            "required": true,
            "type": "string"
          },
          {
            "name": "message",
            "required": true,
            "type": "string"
          }
        ],
        "Built": [
          {
            "name": "behavior",
            "required": true,
            "type": "string"
          }
        ],
        "CatalogHit": [
          {
            "name": "behavior",
            "required": true,
            "type": "string"
          },
          {
            "name": "traits",
            "required": true,
            "type": "[trait]"
          },
          {
            "name": "vectors",
            "type": "Map<string,[number]>"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "2.0.0"
}