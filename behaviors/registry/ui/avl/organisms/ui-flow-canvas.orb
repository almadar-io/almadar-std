                "unitMetric": {
                  "name": "unitMetric",
                  "required": false,
                  "type": "string"
                },
                "unitStatus": {
                  "name": "unitStatus",
                  "required": false,
                  "type": "string",
                  "values": [
                    "ok",
                    "degraded",
                    "down",
                    "idle"
                  ]
                },
                "wireEvents": {
                  "items": {
                    "type": "string"
                  },
                  "name": "wireEvents",
                  "required": false,
