  "name": "ui-split-pane",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "name": "ratio",
            "type": "number"
          }
        ],
        "id": "ent_01KXG04SZQ7G8R7PH46DZWE8P9",
        "name": "SplitPaneItem",
        "persistence": "runtime"
      },
      "id": "orb_01KXG04SZQ0QSZT2WW4D62B2AK",
      "name": "SplitPaneOrbital",
      "pages": [
        {
          "id": "pag_01KXG04SZSKHYVCJ4N9ZTGHV1R",
          "name": "SplitPanePage",
          "path": "/split-pane",
          "traits": [
            {
              "ref": "SplitPaneRender",
              "refId": "trt_01KXG04SZQZQTYV05GPN6HEPVA"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "className": {
              "description": "Additional CSS classes",
              "label": "Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "direction": {
              "default": "horizontal",
              "description": "Direction of the split",
              "label": "Direction",
              "tier": "presentation",
              "type": "string",
              "values": [
                "horizontal",
                "vertical"
              ]
            },
            "left": {
              "default": [],
              "description": "Content for the left/top pane",
              "label": "Left",
              "tier": "presentation",
              "type": "node"
            },
            "leftClassName": {
              "description": "Class for left/top pane",
              "label": "Left Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "minSize": {
              "default": 100.0,
              "description": "Minimum size of either pane in pixels",
              "label": "Min Size",
              "tier": "presentation",
              "type": "number"
            },
            "onRatioChange": {
              "default": "RATIO_CHANGE",
              "description": "Called with the new ratio while dragging. Providing this makes `ratio` controlled — the rendered split always tracks the prop instead of internal state, mirroring a controlled input. Omit for uncontrolled (self-tracked) behavior.",
              "label": "On Ratio Change",
              "tier": "presentation",
              "type": "event"
            },
            "ratio": {
              "description": "Initial ratio (0-100, percentage of first pane)",
              "label": "Ratio",
              "tier": "presentation",
              "type": "number"
            },
            "resizable": {
              "default": true,
              "description": "Allow user resizing",
              "label": "Resizable",
              "tier": "presentation",
              "type": "boolean"
            },
            "right": {
              "default": [],
              "description": "Content for the right/bottom pane",
              "label": "Right",
              "tier": "presentation",
              "type": "node"
            },
            "rightClassName": {
              "description": "Class for right/bottom pane",
              "label": "Right Class Name",
              "tier": "presentation",
              "type": "string"
            }
          },
          "emits": [
            {
              "definerKnob": "onRatioChange",
              "description": "Called with the new ratio while dragging. Providing this makes `ratio` controlled — the rendered split always tracks the prop instead of internal state, mirroring a controlled input. Omit for uncontrolled (self-tracked) behavior.",
              "event": "@config.onRatioChange",
              "eventId": "evt_01M1JMH852AWVKHSRQDJYCBMBR",
              "payloadSchema": [
                {
                  "name": "ratio",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "essential"
            }
          ],
          "entityContract": {
            "provides": [
              "ratio"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SplitPaneItem": "ent_01KXG04SZQ7G8R7PH46DZWE8P9"
          },
          "id": "trt_01KXG04SZQZQTYV05GPN6HEPVA",
          "linkedEntity": "SplitPaneItem",
          "linkedEntityId": "ent_01KXG04SZQ7G8R7PH46DZWE8P9",
          "name": "SplitPaneRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04SZQHBYQ7QDGS6TKJTVZ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M1JMH852A3KDZRKMEBY5RZ23",
                "key": "RATIO_CHANGE",
                "name": "Ratio Change",
                "payloadSchema": [
                  {
                    "name": "ratio",
                    "type": "number"
                  }
                ]
              },
              {
                "description": "Called with the new ratio while dragging. Providing this makes `ratio` controlled — the rendered split always tracks the prop instead of internal state, mirroring a controlled input. Omit for uncontrolled (self-tracked) behavior.",
                "id": "evt_01M1JMH852AWVKHSRQDJYCBMBR",
                "key": "@config.onRatioChange",
                "name": "@config.on ratio change",
                "payloadSchema": [
                  {
                    "name": "ratio",
                    "type": "number"
                  }
                ],
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.ratio",
                    "@config.ratio"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "className": "@config.className",
                      "direction": "@config.direction",
                      "left": "@config.left",
                      "leftClassName": "@config.leftClassName",
                      "minSize": "@config.minSize",
                      "onRatioChange": "@config.onRatioChange",
                      "ratio": "@entity.ratio",
                      "resizable": "@config.resizable",
                      "right": "@config.right",
                      "rightClassName": "@config.rightClassName",
                      "type": "split-pane"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04SZQHBYQ7QDGS6TKJTVZ",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.ratio",
                    "@payload.ratio"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "className": "@config.className",
                      "direction": "@config.direction",
                      "left": "@config.left",
                      "leftClassName": "@config.leftClassName",
                      "minSize": "@config.minSize",
                      "onRatioChange": "@config.onRatioChange",
                      "ratio": "@entity.ratio",
                      "resizable": "@config.resizable",
                      "right": "@config.right",
                      "rightClassName": "@config.rightClassName",
                      "type": "split-pane"
                    }
                  ]
                ],
                "event": "RATIO_CHANGE",
                "eventId": "evt_01M1JMH852A3KDZRKMEBY5RZ23",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}