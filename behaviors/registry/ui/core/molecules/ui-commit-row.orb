              "label": "Message",
              "tier": "presentation",
              "type": "string"
            },
            "restoreEvent": {
              "default": "RESTORE",
              "description": "Emitted by the Restore button. Payload: { sha }.",
              "label": "Restore Event",
              "tier": "presentation",
              "type": "event"
            },
            "selectEvent": {
              "default": "SELECT",
              "description": "Emitted when the row is picked. Payload: { sha }.",
              "label": "Select Event",
              "tier": "presentation",
              "type": "event"
            },
            "selected": {
              "default": false,
              "description": "The row the user picked (shows its detail).",
              "label": "Selected",
              "tier": "presentation",
              "type": "boolean"
            },
            "sha": {
              "default": "",
              "description": "Commit id; the first 7 characters are shown, the whole id on hover.",
              "label": "Sha",
              "tier": "presentation",
              "type": "string"
            },
            "timestamp": {
              "description": "Display time (already formatted, e.g. '2 min ago').",
              "label": "Timestamp",
              "tier": "presentation",
              "type": "string"
