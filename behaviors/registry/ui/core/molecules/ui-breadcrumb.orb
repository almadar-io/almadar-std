          "name": "BreadcrumbRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04MX61JX4AMH0MQK0YQ6W",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly.",
                "id": "evt_01M0HZ7JXZT1B3WE2JVP75FDGK",
                "key": "@config.itemEvent",
                "name": "@config.item event",
                "payloadSchema": [
                  {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "href",
                    "type": "string"
                  },
                  {
                    "name": "index",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "aria-busy": "@config.ariaBusy",
                      "aria-current": "@config.ariaCurrent",
                      "aria-describedby": "@config.ariaDescribedby",
                      "aria-expanded": "@config.ariaExpanded",
                      "aria-hidden": "@config.ariaHidden",
                      "aria-label": "@config.ariaLabel",
                      "aria-labelledby": "@config.ariaLabelledby",
                      "aria-live": "@config.ariaLive",
                      "aria-pressed": "@config.ariaPressed",
                      "aria-selected": "@config.ariaSelected",
                      "className": "@config.className",
                      "dir": "@config.dir",
                      "enter": "@config.enter",
                      "enterDelay": "@config.enterDelay",
                      "fromNavStack": "@config.fromNavStack",
                      "itemEvent": "@config.itemEvent",
                      "items": [
                        "array/filter",
                        "@config.items",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "lang": "@config.lang",
                      "maxItems": "@config.maxItems",
                      "role": "@config.role",
                      "separator": "@config.separator",
                      "skeleton": "@config.skeleton",
                      "tabIndex": "@config.tabIndex",
                      "type": "breadcrumb"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04MX61JX4AMH0MQK0YQ6W",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
