      },
      "id": "orb_01KXG04QHN73J68Z4BJMKERHWN",
      "name": "PopoverOrbital",
      "pages": [
        {
          "id": "pag_01KXG04QHRYVHNV072JQBYGC14",
          "name": "PopoverPage",
          "path": "/popover",
          "traits": [
            {
              "ref": "PopoverRender",
              "refId": "trt_01KXG04QHPHB07PFRVRXWCZZZ3"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "children": {
              "description": "Popover trigger element (ReactElement or ReactNode that will be wrapped in span)",
              "label": "Children",
              "tier": "presentation",
              "type": "node"
            },
            "className": {
              "description": "Additional CSS classes",
              "label": "Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "content": {
              "description": "Popover content",
              "label": "Content",
              "tier": "presentation",
              "type": "node"
            },
            "onOpenChange": {
              "default": "OPEN_CHANGE",
              "description": "Fired when the popover wants to change visibility (trigger click, outside click)",
              "label": "On Open Change",
              "tier": "presentation",
              "type": "string"
            },
            "open": {
              "description": "Controlled open state. When set, the host owns visibility and the popover reports intent through onOpenChange instead of toggling itself.",
              "label": "Open",
              "tier": "presentation",
              "type": "boolean"
            },
            "position": {
              "default": "bottom",
              "description": "Popover position",
              "label": "Position",
              "tier": "presentation",
              "type": "string",
              "values": [
                "top",
                "bottom",
                "left",
                "right"
              ]
            },
            "showArrow": {
              "default": true,
              "description": "Show arrow",
              "label": "Show Arrow",
              "tier": "presentation",
              "type": "boolean"
            },
            "trigger": {
              "default": "click",
              "description": "Trigger type",
              "label": "Trigger",
              "tier": "presentation",
              "type": "string",
              "values": [
                "click",
                "hover"
              ]
            }
          },
          "emits": [
            {
              "description": "Fired when the popover wants to change visibility (trigger click, outside click)",
              "event": "@config.onOpenChange",
              "eventId": "evt_01KYQH4C8TH1DGZ4141EYBQ2JG",
              "payloadSchema": [
                {
                  "name": "open",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "tier": "essential"
            }
          ],
          "entityContract": {
            "provides": [
              "open"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "PopoverItem": "ent_01KXG04QHPFXYX2GXK0M1509YJ"
          },
          "id": "trt_01KXG04QHPHB07PFRVRXWCZZZ3",
          "linkedEntity": "PopoverItem",
          "linkedEntityId": "ent_01KXG04QHPFXYX2GXK0M1509YJ",
          "name": "PopoverRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04QHPR5WWNS2YTHXGN3V7",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYQH4C8T000A3RVFDAXSCAXR",
                "key": "OPEN_CHANGE",
                "name": "Open Change",
                "payloadSchema": [
                  {
                    "name": "open",
                    "type": "boolean"
                  }
                ]
              },
              {
                "description": "Fired when the popover wants to change visibility (trigger click, outside click)",
                "id": "evt_01KYQH4C8TH1DGZ4141EYBQ2JG",
                "key": "@config.onOpenChange",
                "name": "@config.on open change",
                "payloadSchema": [
                  {
                    "name": "open",
                    "type": "boolean"
                  }
                ],
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.open",
                    "@config.open"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": "@config.children",
                      "className": "@config.className",
                      "content": "@config.content",
                      "onOpenChange": "@config.onOpenChange",
                      "open": "@entity.open",
                      "position": "@config.position",
                      "showArrow": "@config.showArrow",
                      "trigger": "@config.trigger",
                      "type": "popover"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04QHPR5WWNS2YTHXGN3V7",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.open",
                    "@payload.open"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": "@config.children",
                      "className": "@config.className",
                      "content": "@config.content",
                      "onOpenChange": "@config.onOpenChange",
                      "open": "@entity.open",
                      "position": "@config.position",
                      "showArrow": "@config.showArrow",
                      "trigger": "@config.trigger",
                      "type": "popover"
                    }
                  ]
                ],
                "event": "OPEN_CHANGE",
                "eventId": "evt_01KYQH4C8T000A3RVFDAXSCAXR",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
