                    "name": "type",
                    "required": false,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Fields",
              "tier": "presentation",
              "type": "[DocumentDetailsFieldsItem]"
            },
            "metaCommitEvent": {
              "default": "META_COMMIT",
              "description": "Emitted when a property commits: { id, patch } — patch carries the id plus the one changed field, ready for a partial persist update.",
              "label": "Meta Commit Event",
              "tier": "presentation",
              "type": "event"
            },
            "relationEvent": {
              "default": "RELATION",
              "description": "Makes relation chips clickable: emitted with { field, id, name } when a hydrated relation value (or one row of a many-relation) is clicked — the host routes it to the linked record's own surface.",
              "label": "Relation Event",
              "tier": "presentation",
              "type": "event"
            },
            "selfFetch": {
              "default": true,
              "description": "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.",
              "label": "Fetch its own rows on mount?",
              "tier": "internal",
              "type": "boolean"
            },
            "title": {
              "description": "Card heading (defaults to the localized 'Details')",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            }
          },
          "emits": [
            {
              "definerKnob": "metaCommitEvent",
              "description": "Emitted when a property commits: { id, patch } — patch carries the id plus the one changed field, ready for a partial persist update.",
              "event": "@config.metaCommitEvent",
              "eventId": "evt_01M13ZXC59R4VP1T1DHD262B08",
              "payloadSchema": [
                {
                  "name": "id",
                  "required": true,
                  "type": "string"
                },
                {
                  "name": "patch",
                  "required": true,
                  "type": "Map<string,opaque>"
                }
              ],
              "scope": "external",
