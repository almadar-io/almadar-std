                "id": "evt_01M13ZXC59XKCDATMN4TVFVMZ7",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "DocumentDetails rows finished loading; payload.data holds the collection.",
                "id": "evt_01M13ZXC59HB41Z83ZYJR50JQP",
                "key": "DocumentDetailsLoaded",
                "name": "Document details loaded",
                "payloadSchema": [
                  {
                    "name": "data",
                    "type": "[DocumentDetailsItem]"
                  }
                ],
                "synonyms": "loaded, fetched, retrieved",
                "tier": "essential"
              },
              {
                "description": "Emitted when a property commits: { id, patch } — patch carries the id plus the one changed field, ready for a partial persist update.",
                "id": "evt_01M13ZXC59R4VP1T1DHD262B08",
                "key": "@config.metaCommitEvent",
                "name": "@config.meta commit event",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "patch",
                    "required": true,
                    "type": "Map<string,opaque>"
                  }
                ],
                "tier": "essential"
              },
              {
                "description": "Makes relation chips clickable: emitted with { field, id, name } when a hydrated relation value (or one row of a many-relation) is clicked — the host routes it to the linked record's own surface.",
                "id": "evt_01M1694617Q04F1T085TTM4F8C",
                "key": "@config.relationEvent",
                "name": "@config.relation event",
                "payloadSchema": [
                  {
                    "name": "field",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "name",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "DocumentDetailsItem",
                    {
                      "emit": {
                        "success": "DocumentDetailsLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "className": "@config.className",
                      "entity": "@entity",
                      "fields": "@config.fields",
                      "metaCommitEvent": "@config.metaCommitEvent",
                      "relationEvent": "@config.relationEvent",
                      "title": "@config.title",
                      "type": "document-details"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M13ZXC59XKCDATMN4TVFVMZ7",
                "from": "idle",
                "guard": "@config.selfFetch",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "className": "@config.className",
                      "entity": "@entity",
                      "fields": "@config.fields",
                      "metaCommitEvent": "@config.metaCommitEvent",
                      "relationEvent": "@config.relationEvent",
                      "title": "@config.title",
                      "type": "document-details"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M13ZXC59XKCDATMN4TVFVMZ7",
                "from": "idle",
                "guard": [
                  "not",
                  "@config.selfFetch"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "className": "@config.className",
                      "entity": "@payload.data",
                      "fields": "@config.fields",
                      "metaCommitEvent": "@config.metaCommitEvent",
                      "relationEvent": "@config.relationEvent",
                      "title": "@config.title",
                      "type": "document-details"
                    }
                  ]
                ],
                "event": "DocumentDetailsLoaded",
                "eventId": "evt_01M13ZXC59HB41Z83ZYJR50JQP",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
