                      "entity": "FormActionsItem",
                      "filters": "@config.filters",
                      "lang": "@config.lang",
                      "look": "@config.look",
                      "orientation": "@config.orientation",
                      "primary": "@config.primary",
                      "role": "@config.role",
                      "secondary": [
                        "array/filter",
                        "@config.secondary",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "skeleton": "@config.skeleton",
                      "tabIndex": "@config.tabIndex",
                      "type": "form-actions",
                      "variant": "@config.variant"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04P39S9DA609EBV042JPG",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
