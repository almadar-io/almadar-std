          "id": "trt_01KXG04NMDDG5HDA5VXD835X8P",
          "linkedEntity": "DocumentViewerItem",
          "linkedEntityId": "ent_01KXG04NMDC90W8CBA3SYSDSHW",
          "name": "DocumentViewerRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04NMDMPGRX61HW69DKJRA",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "actions": [
                        "array/filter",
                        "@config.actions",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "aria-busy": "@config.ariaBusy",
                      "aria-current": "@config.ariaCurrent",
                      "aria-describedby": "@config.ariaDescribedby",
                      "aria-expanded": "@config.ariaExpanded",
                      "aria-hidden": "@config.ariaHidden",
                      "aria-label": "@config.ariaLabel",
                      "aria-labelledby": "@config.ariaLabelledby",
                      "aria-live": "@config.ariaLive",
                      "aria-pressed": "@config.ariaPressed",
                      "aria-selected": "@config.ariaSelected",
                      "className": "@config.className",
                      "content": "@config.content",
                      "currentPage": "@config.currentPage",
                      "dir": "@config.dir",
                      "documentType": "@config.documentType",
                      "documents": "@config.documents",
                      "enter": "@config.enter",
                      "enterDelay": "@config.enterDelay",
                      "error": "@config.error",
                      "height": "@config.height",
                      "isLoading": "@config.isLoading",
                      "lang": "@config.lang",
                      "role": "@config.role",
                      "showDownload": "@config.showDownload",
                      "showPrint": "@config.showPrint",
                      "showToolbar": "@config.showToolbar",
                      "src": "@config.src",
                      "tabIndex": "@config.tabIndex",
                      "title": "@config.title",
                      "totalPages": "@config.totalPages",
                      "type": "document-viewer"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04NMDMPGRX61HW69DKJRA",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
