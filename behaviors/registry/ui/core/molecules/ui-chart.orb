          "id": "trt_01KXG04N1NP3H0JKQ558WKRPGB",
          "linkedEntity": "ChartItem",
          "linkedEntityId": "ent_01KXG04N1NAMT9TGKEWSYAS5B6",
          "name": "ChartRender",
