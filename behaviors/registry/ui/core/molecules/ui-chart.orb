          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04N1N2ZGA3AD9A62CPD4Y",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "actions": [
                        "array/filter",
                        "@config.actions",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "aria-busy": "@config.ariaBusy",
                      "aria-current": "@config.ariaCurrent",
                      "aria-describedby": "@config.ariaDescribedby",
                      "aria-expanded": "@config.ariaExpanded",
                      "aria-hidden": "@config.ariaHidden",
                      "aria-label": "@config.ariaLabel",
                      "aria-labelledby": "@config.ariaLabelledby",
                      "aria-live": "@config.ariaLive",
                      "aria-pressed": "@config.ariaPressed",
                      "aria-selected": "@config.ariaSelected",
                      "chartType": "@config.chartType",
                      "className": "@config.className",
                      "data": "@config.data",
                      "dir": "@config.dir",
                      "drillEvent": "@config.drillEvent",
                      "enter": "@config.enter",
                      "enterDelay": "@config.enterDelay",
                      "error": "@config.error",
                      "height": "@config.height",
                      "isLoading": "@config.isLoading",
                      "lang": "@config.lang",
                      "look": "@config.look",
                      "period": "@config.period",
                      "role": "@config.role",
                      "scatterData": "@config.scatterData",
                      "series": "@config.series",
                      "showLegend": "@config.showLegend",
                      "showValues": "@config.showValues",
                      "skeleton": "@config.skeleton",
                      "stack": "@config.stack",
                      "subtitle": "@config.subtitle",
                      "surface": "@config.surface",
                      "tabIndex": "@config.tabIndex",
                      "timeAxis": "@config.timeAxis",
                      "title": "@config.title",
                      "type": "chart"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04N1N2ZGA3AD9A62CPD4Y",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
