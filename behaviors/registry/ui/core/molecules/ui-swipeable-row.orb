          "id": "trt_01KXG04RR2H3KMQGZ10VB5VQ6D",
          "linkedEntity": "SwipeableRowItem",
          "linkedEntityId": "ent_01KXG04RR21BXNRYS8WQB2CD48",
          "name": "SwipeableRowRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04RR2SB60JTQCVEN867B6",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "SwipeableRow rows finished loading; payload.data holds the collection.",
                "id": "evt_01M1WZ4WX4KTRXEMYZG2C6QQNP",
                "key": "SwipeableRowLoaded",
                "name": "Swipeable row loaded",
                "payloadSchema": [
                  {
                    "entity": "SwipeableRowItem",
                    "name": "data",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "loaded, fetched, retrieved",
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "SwipeableRowItem",
                    {
                      "emit": {
                        "success": "SwipeableRowLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": "@config.children",
                      "className": "@config.className",
                      "itemData": "@entity",
                      "leftActions": "@config.leftActions",
                      "rightActions": "@config.rightActions",
                      "threshold": "@config.threshold",
                      "type": "swipeable-row"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04RR2SB60JTQCVEN867B6",
                "from": "idle",
                "guard": "@config.selfFetch",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": "@config.children",
                      "className": "@config.className",
                      "itemData": "@entity",
                      "leftActions": "@config.leftActions",
                      "rightActions": "@config.rightActions",
                      "threshold": "@config.threshold",
                      "type": "swipeable-row"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04RR2SB60JTQCVEN867B6",
                "from": "idle",
                "guard": [
                  "not",
                  "@config.selfFetch"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": "@config.children",
                      "className": "@config.className",
                      "itemData": "@payload.data",
                      "leftActions": "@config.leftActions",
                      "rightActions": "@config.rightActions",
                      "threshold": "@config.threshold",
                      "type": "swipeable-row"
                    }
                  ]
                ],
                "event": "SwipeableRowLoaded",
                "eventId": "evt_01M1WZ4WX4KTRXEMYZG2C6QQNP",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ],
