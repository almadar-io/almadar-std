{
  "description": "Gantt — view-only task schedule rendering rows as bars on a day axis. — UI factory (1:1 with the @almadar/ui gantt pattern).",
  "ledger": {
    "entries": {
      "ent_01M2M53R3YYSDKM5249ABXQ7T4": {
        "bakedName": "GanttItem",
        "curName": "GanttItem",
        "id": "ent_01M2M53R3YYSDKM5249ABXQ7T4",
        "kind": "entity",
        "owner": "workspace",
        "renames": []
      },
      "evt_01M2M53R3YDVJNHTNMWVQHD6DM": {
        "bakedName": "INIT",
        "curName": "INIT",
        "id": "evt_01M2M53R3YDVJNHTNMWVQHD6DM",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY",
