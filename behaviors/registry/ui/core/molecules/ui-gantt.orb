      },
      "evt_01M2M53R3YKHR780KWWS352SKC": {
        "bakedName": "GanttLoaded",
        "curName": "GanttLoaded",
        "id": "evt_01M2M53R3YKHR780KWWS352SKC",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY",
        "renames": []
      },
      "evt_01M2M53R3YYF5SRSR2HQHT3FGZ": {
        "bakedName": "@config.barClickEvent",
        "curName": "@config.barClickEvent",
        "id": "evt_01M2M53R3YYF5SRSR2HQHT3FGZ",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY",
        "renames": []
      },
      "orb_01M2M53R3YY6NQ5PQMXCT1MSFW": {
        "bakedName": "GanttOrbital",
        "curName": "GanttOrbital",
        "id": "orb_01M2M53R3YY6NQ5PQMXCT1MSFW",
        "kind": "orbital",
        "owner": "workspace",
        "renames": []
      },
      "pag_01M2M53R3Y5K89GCKEWQDK6YXK": {
        "bakedName": "GanttPage",
        "curName": "GanttPage",
        "id": "pag_01M2M53R3Y5K89GCKEWQDK6YXK",
        "kind": "page",
        "owner": "workspace",
        "renames": []
      },
      "trt_01M2M53R3YSVDN4KJ5FZM8AYXY": {
        "bakedName": "GanttRender",
        "curName": "GanttRender",
        "id": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY",
        "kind": "trait",
        "owner": "workspace",
        "renames": []
      }
    },
    "schemaVersion": 1
  },
  "name": "ui-gantt",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "id": "ent_01M2M53R3YYSDKM5249ABXQ7T4",
        "name": "GanttItem",
        "persistence": "runtime"
      },
      "id": "orb_01M2M53R3YY6NQ5PQMXCT1MSFW",
      "name": "GanttOrbital",
      "pages": [
        {
          "id": "pag_01M2M53R3Y5K89GCKEWQDK6YXK",
          "name": "GanttPage",
          "path": "/gantt",
          "traits": [
            {
              "ref": "GanttRender",
              "refId": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "barClickEvent": {
              "default": "BAR_CLICK",
              "description": "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }",
              "label": "Bar Click Event",
              "tier": "presentation",
              "type": "event"
            },
            "className": {
              "description": "Additional CSS classes",
              "label": "Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "dayWidth": {
              "default": 28.0,
              "description": "Pixels per day on the axis (default 28)",
              "label": "Day Width",
              "tier": "presentation",
              "type": "number"
            },
            "durationField": {
              "description": "Row field holding the task length in days, used when the row has no end.",
              "label": "Duration Field",
              "tier": "presentation",
              "type": "string"
            },
            "endField": {
              "default": "end",
              "description": "Row field holding the end timestamp (ISO or epoch). Defaults to `end`. When absent, `durationField` (days) is used instead.",
              "label": "End Field",
              "tier": "presentation",
              "type": "string"
            },
            "error": {
              "description": "Error state",
              "label": "Error",
              "properties": {
                "code": {
                  "name": "code",
                  "required": false,
                  "type": "string"
                },
                "message": {
                  "name": "message",
                  "required": true,
                  "type": "string"
                },
                "name": {
                  "name": "name",
                  "required": false,
                  "type": "string"
                },
                "stack": {
                  "name": "stack",
                  "required": false,
                  "type": "string"
                }
              },
              "tier": "presentation",
              "type": "GanttError"
            },
            "groupField": {
              "description": "Row field rows are grouped under header rows by. Empty (default) = flat list.",
              "label": "Group Field",
              "tier": "presentation",
              "type": "string"
            },
            "isLoading": {
              "default": false,
              "description": "Loading state",
              "label": "Is Loading",
              "tier": "presentation",
              "type": "boolean"
            },
            "links": {
              "default": [],
              "description": "Dependency arrows between task ids",
              "items": {
                "properties": {
                  "from": {
                    "name": "from",
                    "required": true,
                    "type": "string"
                  },
                  "to": {
                    "name": "to",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Links",
              "tier": "presentation",
              "type": "[GanttLinksItem]"
            },
            "rangeEnd": {
              "default": "2024-01-01",
              "description": "Last visible day (ISO or Date). Defaults to 2 days after the latest task end.",
              "label": "Range End",
              "tier": "presentation",
              "type": "date"
            },
            "rangeStart": {
              "default": "2024-01-01",
              "description": "First visible day (ISO or Date). Defaults to 2 days before the earliest task.",
              "label": "Range Start",
              "tier": "presentation",
              "type": "date"
            },
            "selfFetch": {
              "default": true,
              "description": "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.",
              "label": "Fetch its own rows on mount?",
              "tier": "internal",
              "type": "boolean"
            },
            "showToday": {
              "default": true,
              "description": "Paint the today marker line when today falls inside the range (default true).",
              "label": "Show Today",
              "tier": "presentation",
              "type": "boolean"
            },
            "startField": {
              "default": "start",
              "description": "Row field holding the start timestamp (ISO or epoch). Defaults to `start`.",
              "label": "Start Field",
              "tier": "presentation",
              "type": "string"
            },
            "statusField": {
              "default": "status",
              "description": "Row field holding the bar status (drives bar colour). Defaults to `status`.",
              "label": "Status Field",
              "tier": "presentation",
              "type": "string"
            },
            "titleField": {
              "default": "title",
              "description": "Row field holding the bar label. Defaults to `title`.",
              "label": "Title Field",
              "tier": "presentation",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "fetch",
              "resource": "GanttItem"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            }
          ],
          "emits": [
            {
              "definerKnob": "barClickEvent",
              "description": "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }",
              "event": "@config.barClickEvent",
              "eventId": "evt_01M2M53R3YYF5SRSR2HQHT3FGZ",
              "payloadSchema": [
                {
                  "name": "id",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Gantt rows finished loading; payload.data holds the collection.",
              "event": "GanttLoaded",
              "eventId": "evt_01M2M53R3YKHR780KWWS352SKC",
              "payloadSchema": [
                {
                  "entity": "GanttItem",
                  "name": "data",
                  "properties": [
                    {
                      "name": "id",
                      "required": true,
                      "type": "string"
                    }
                  ],
                  "type": "[object]"
                }
              ],
              "scope": "internal",
              "synonyms": "loaded, fetched, retrieved",
              "tier": "essential"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "GanttItem": "ent_01M2M53R3YYSDKM5249ABXQ7T4"
          },
          "id": "trt_01M2M53R3YSVDN4KJ5FZM8AYXY",
          "linkedEntity": "GanttItem",
          "linkedEntityId": "ent_01M2M53R3YYSDKM5249ABXQ7T4",
          "name": "GanttRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M2M53R3YDVJNHTNMWVQHD6DM",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Gantt rows finished loading; payload.data holds the collection.",
                "id": "evt_01M2M53R3YKHR780KWWS352SKC",
                "key": "GanttLoaded",
                "name": "Gantt loaded",
                "payloadSchema": [
                  {
                    "entity": "GanttItem",
                    "name": "data",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "loaded, fetched, retrieved",
                "tier": "essential"
              },
              {
                "description": "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }",
                "id": "evt_01M2M53R3YYF5SRSR2HQHT3FGZ",
                "key": "@config.barClickEvent",
                "name": "@config.bar click event",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "essential"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "GanttItem",
                    {
                      "emit": {
                        "success": "GanttLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "barClickEvent": "@config.barClickEvent",
                      "className": "@config.className",
                      "dayWidth": "@config.dayWidth",
                      "durationField": "@config.durationField",
                      "endField": "@config.endField",
                      "error": "@config.error",
                      "groupField": "@config.groupField",
                      "isLoading": "@config.isLoading",
                      "links": "@config.links",
                      "rangeEnd": "@config.rangeEnd",
                      "rangeStart": "@config.rangeStart",
                      "showToday": "@config.showToday",
                      "startField": "@config.startField",
                      "statusField": "@config.statusField",
                      "tasks": "@entity",
                      "titleField": "@config.titleField",
                      "type": "gantt"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M2M53R3YDVJNHTNMWVQHD6DM",
                "from": "idle",
                "guard": "@config.selfFetch",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "barClickEvent": "@config.barClickEvent",
                      "className": "@config.className",
                      "dayWidth": "@config.dayWidth",
                      "durationField": "@config.durationField",
                      "endField": "@config.endField",
                      "error": "@config.error",
                      "groupField": "@config.groupField",
                      "isLoading": "@config.isLoading",
                      "links": "@config.links",
                      "rangeEnd": "@config.rangeEnd",
                      "rangeStart": "@config.rangeStart",
                      "showToday": "@config.showToday",
                      "startField": "@config.startField",
                      "statusField": "@config.statusField",
                      "tasks": "@entity",
                      "titleField": "@config.titleField",
                      "type": "gantt"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M2M53R3YDVJNHTNMWVQHD6DM",
                "from": "idle",
                "guard": [
                  "not",
                  "@config.selfFetch"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "barClickEvent": "@config.barClickEvent",
                      "className": "@config.className",
                      "dayWidth": "@config.dayWidth",
                      "durationField": "@config.durationField",
                      "endField": "@config.endField",
                      "error": "@config.error",
                      "groupField": "@config.groupField",
                      "isLoading": "@config.isLoading",
                      "links": "@config.links",
                      "rangeEnd": "@config.rangeEnd",
                      "rangeStart": "@config.rangeStart",
                      "showToday": "@config.showToday",
                      "startField": "@config.startField",
                      "statusField": "@config.statusField",
                      "tasks": "@payload.data",
                      "titleField": "@config.titleField",
                      "type": "gantt"
                    }
                  ]
                ],
                "event": "GanttLoaded",
                "eventId": "evt_01M2M53R3YKHR780KWWS352SKC",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "GanttError": [
          {
            "name": "message",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "code",
            "type": "string"
          },
          {
            "name": "stack",
            "type": "string"
          }
        ],
        "GanttLinksItem": [
          {
            "name": "from",
            "required": true,
            "type": "string"
          },
          {
            "name": "to",
            "required": true,
            "type": "string"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}