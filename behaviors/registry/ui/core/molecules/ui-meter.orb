                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "actions": [
                        "array/filter",
                        "@config.actions",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "aria-busy": "@config.ariaBusy",
                      "aria-current": "@config.ariaCurrent",
                      "aria-describedby": "@config.ariaDescribedby",
                      "aria-expanded": "@config.ariaExpanded",
                      "aria-hidden": "@config.ariaHidden",
                      "aria-label": "@config.ariaLabel",
                      "aria-labelledby": "@config.ariaLabelledby",
                      "aria-live": "@config.ariaLive",
                      "aria-pressed": "@config.ariaPressed",
                      "aria-selected": "@config.ariaSelected",
                      "className": "@config.className",
                      "dir": "@config.dir",
                      "enter": "@config.enter",
                      "enterDelay": "@config.enterDelay",
                      "error": "@config.error",
                      "isLoading": "@config.isLoading",
                      "label": "@config.label",
                      "lang": "@config.lang",
                      "max": "@config.max",
                      "min": "@config.min",
                      "role": "@config.role",
                      "segments": "@config.segments",
                      "showValue": "@config.showValue",
                      "size": "@config.size",
                      "skeleton": "@config.skeleton",
                      "tabIndex": "@config.tabIndex",
                      "thresholds": "@config.thresholds",
                      "type": "meter",
                      "unit": "@config.unit",
                      "value": "@config.value",
                      "variant": "@config.variant"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04Q3948VS5H26Q80N8XKD",
                "from": "idle",
                "to": "idle"
              }
            ]
