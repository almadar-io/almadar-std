                      "defaultActiveTab": "@config.defaultActiveTab",
                      "dir": "@config.dir",
                      "enter": "@config.enter",
                      "enterDelay": "@config.enterDelay",
                      "items": [
                        "array/filter",
                        "@config.items",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "lang": "@config.lang",
                      "onTabChange": "@config.onTabChange",
                      "orientation": "@config.orientation",
                      "role": "@config.role",
                      "skeleton": "@config.skeleton",
                      "tabChangeEvent": "@config.tabChangeEvent",
                      "tabIndex": "@config.tabIndex",
                      "tabs": [
                        "array/filter",
                        "@config.tabs",
                        [
                          "fn",
                          "action",
                          [
                            "or",
                            [
                              "=",
                              [
                                "array/len",
                                [
                                  "object/get",
                                  "@action",
                                  "roles",
                                  []
                                ]
                              ],
                              0.0
                            ],
                            [
                              "array/includes",
                              [
                                "object/get",
                                "@action",
                                "roles",
                                []
                              ],
                              "@config.viewerRole"
                            ]
                          ]
                        ]
                      ],
                      "type": "tabs",
                      "variant": "@config.variant"
