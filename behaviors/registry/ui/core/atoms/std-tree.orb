                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            "=",
                            "@config.look",
                            "rail"
                          ],
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          },
                          {
                            "type": "divider"
