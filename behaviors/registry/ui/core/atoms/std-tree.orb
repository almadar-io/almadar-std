                      "gap": "sm",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "TreeNodeLoadFailed",
                "eventId": "evt_01M0RYHNM526XMK2P3K7YYZYAT",
                "from": "loading",
                "to": "error"
              },
              {
                "effects": [
