                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "from": "browsing",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      },
                      "filter": [
                        "or",
                        [
                          "=",
                          "@payload.searchTerm",
                          ""
                        ],
                        [
                          "str/includes",
                          [
                            "object/get",
                            "@entity",
                            "name"
                          ],
                          "@payload.searchTerm"
                        ]
                      ]
                    }
                  ]
                ],
                "event": "REFETCH_QUERY",
                "eventId": "evt_01M11H00X42VFQ0VXEXV7ES6F9",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
