          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Indicates the tree node collection has been successfully retrieved.",
                "id": "evt_01M0RYHNM5058FKQ52DVA4S9HP",
                "key": "TreeNodeLoaded",
                "name": "TreeNode loaded",
                "payloadSchema": [
                  {
                    "name": "data",
                    "type": "[TreeNode]"
                  }
                ],
                "synonyms": "loaded, fetched, retrieved, ready",
                "tier": "domain"
              },
              {
                "description": "Indicates a failure to load the tree node collection.",
                "id": "evt_01M0RYHNM526XMK2P3K7YYZYAT",
                "key": "TreeNodeLoadFailed",
                "name": "TreeNode load failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "synonyms": "error, failed, problem, unsuccessful",
                "tier": "internal"
              },
              {
                "description": "Triggers a tree refresh based on the current search query.",
                "id": "evt_01M11H00X42VFQ0VXEXV7ES6F9",
                "key": "REFETCH_QUERY",
                "name": "Refetch Query",
                "payloadSchema": [
                  {
                    "name": "searchTerm",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "refresh, reload, update, re-query",
                "tier": "domain"
              },
              {
                "description": "Triggers a tree refresh based on current filter criteria.",
                "id": "evt_01M11H00X4BMW519Q3CSP735Z8",
                "key": "REFETCH_FILTER",
                "name": "Refetch Filter",
                "payloadSchema": [
                  {
                    "name": "field",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "refresh, filter, update, reload",
                "tier": "domain"
              },
              {
                "description": "Signals a tree node has been selected for external handoff.",
                "id": "evt_01M0RYHNM50RK3ZYBW4S0JVZ2N",
                "key": "OPEN_NODE",
                "name": "Open Node",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "select, choose, open, activate",
                "tier": "domain"
              },
              {
                "id": "evt_01M0RYHNM5HX05GFM20W62NCPC",
                "key": "RETRY",
                "name": "Retry"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "loading"
              },
              {
                "name": "browsing"
              },
              {
                "name": "error"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "align": "center",
                      "children": [
                        {
                          "type": "spinner"
                        },
                        {
                          "color": "muted",
                          "content": "Loading tree…",
                          "type": "typography",
                          "variant": "caption"
                        }
                      ],
                      "className": "py-12",
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            {
                              "name": "list-tree",
                              "type": "icon"
                            },
                            {
                              "content": "@config.title",
                              "type": "typography",
                              "variant": "h3"
                            },
                            {
                              "label": [
                                "array/len",
                                "@payload.data"
                              ],
                              "size": "sm",
                              "type": "badge",
                              "variant": "neutral"
                            }
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        },
                        {
                          "type": "divider"
                        },
                        [
                          "if",
                          "@config.bodySearch",
                          {
                            "children": [
                              {
                                "className": "w-full max-w-md",
                                "clearable": true,
                                "event": "REFETCH_QUERY",
                                "placeholder": "@config.searchPlaceholder",
                                "type": "search-input"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            ">",
                            [
                              "array/len",
                              "@config.filters"
                            ],
                            0.0
                          ],
                          {
                            "children": [
                              {
                                "entity": "TreeNode",
                                "event": "REFETCH_FILTER",
                                "filters": "@config.filters",
                                "look": "@config.filterBarLook",
                                "type": "filter-group"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        {
                          "items": [
                            "array/map",
                            "@payload.data",
                            [
                              "fn",
                              "row",
                              {
                                "icon": "@row.icon",
                                "id": "@row.id",
                                "label": "@row.name",
                                "parentId": "@row.parentId"
                              }
                            ]
                          ],
                          "onNodeSelect": "OPEN_NODE",
                          "type": "file-tree"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "TreeNodeLoaded",
                "eventId": "evt_01M0RYHNM5058FKQ52DVA4S9HP",
                "from": "loading",
                "to": "browsing"
