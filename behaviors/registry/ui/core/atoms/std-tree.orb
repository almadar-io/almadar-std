                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      },
                      "filter": [
                        "or",
                        [
                          "=",
                          "@payload.searchTerm",
                          ""
                        ],
                        [
                          "str/includes",
                          [
                            "str/default",
