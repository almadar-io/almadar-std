  "name": "std-tree",
  "orbitals": [
    {
      "entity": {
        "collection": "treenodes",
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "The descriptive label for this node.",
            "name": "name",
            "required": true,
            "synonyms": "label, title, text",
            "type": "string"
          },
          {
            "default": "",
            "description": "Reference to the parent node in the hierarchy; empty marks a root.",
            "name": "parentId",
            "synonyms": "parent, superior, ancestor",
            "type": "string"
          },
          {
            "default": "",
            "description": "Icon name shown beside the node.",
            "name": "icon",
            "synonyms": "glyph, symbol, pictogram",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "string"
          }
        ],
        "id": "ent_01M0RYHNM1NXR2J5S0HK2WFDS3",
        "name": "TreeNode",
        "persistence": "persistent"
      },
      "id": "orb_01M0RYHNM15ZXYERAB9GSZFAZE",
      "name": "TreeNodeOrbital",
      "pages": [
        {
          "id": "pag_01M0RYHNM62AVVZYX5T9Y27DW2",
          "name": "TreePage",
          "path": "/tree",
          "traits": [
            {
              "ref": "TreeBrowse",
              "refId": "trt_01M0RYHNM11N15TSY0QWVC2GH5"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "bodySearch": {
              "default": false,
              "description": "Embeds a search box above the tree that re-fetches the flat node set server-side. Set false (the default) when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two.",
              "label": "Show the tree's own search box?",
              "synonyms": "inline search, list search, built-in search, show search, duplicate search",
              "tier": "presentation",
              "type": "boolean"
            },
            "childAction": {
              "default": false,
              "description": "Render a hover + on every row that emits CHILD_REQUESTED { parentId } — wire it to the host's create-draft writer so new records are born inside the node.",
              "label": "Row + affordance?",
              "synonyms": "add inside, new subpage button, plus on rows",
              "tier": "domain",
              "type": "boolean"
            },
            "childActionLabel": {
              "default": "Add inside",
              "description": "Accessible label on the row's + affordance (e.g. New subpage).",
              "label": "Row + tooltip",
              "tier": "presentation",
              "type": "string"
            },
            "filterBarLook": {
              "default": "toolbar",
              "description": "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty.",
              "label": "Filter bar look",
              "synonyms": "filter bar style, facet style, chips, pills",
              "tier": "presentation",
              "type": "string",
              "values": [
                "toolbar",
                "chips",
                "pills",
                "popover-trigger",
                "inline-column-header"
              ]
            },
            "filters": {
              "default": [],
              "description": "Dropdown filter facets by field, rendered as an embedded filter bar above the tree; each selection fires REFETCH_FILTER on this trait, re-fetching the flat node set. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this tree and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path.",
              "items": {
                "properties": {
                  "field": {
                    "name": "field",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "options": {
                    "items": {
                      "type": "string"
                    },
                    "name": "options",
                    "required": false,
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "label": "Which filters should appear above the tree?",
              "synonyms": "filter bar, faceted filters, field filters, dropdowns",
              "tier": "presentation",
              "type": "[FilterSpec]"
            },
            "iconField": {
              "default": "icon",
              "description": "Entity field holding each node's icon name; point it at a nonexistent field (or empty) to suppress per-node icons.",
              "label": "Icon column",
              "synonyms": "glyph field, icon column",
              "tier": "presentation",
              "type": "string"
            },
            "labelField": {
              "default": "name",
              "description": "Entity field rendered as each node's label. Config-driven on purpose: the trait-level `fields {}` remap is compiled-path-only (the JS runtime never applies it), so a rebind names its columns here and both execution paths agree.",
              "label": "Label column",
              "synonyms": "title field, name column, display field",
              "tier": "domain",
              "type": "string"
            },
            "look": {
              "default": "full",
              "description": "full = standalone section (heading, count, divider); rail = compact sidebar navigation (slim caption, nav-styled rows) for an app layout's sidebarTrait slot.",
              "label": "Tree look",
              "synonyms": "sidebar tree, rail look, nav tree, compact",
              "tier": "presentation",
              "type": "string",
              "values": [
                "full",
                "rail"
              ]
            },
            "parentField": {
              "default": "parentId",
              "description": "Entity field holding the parent reference the hierarchy nests by.",
              "label": "Parent column",
              "synonyms": "parent id field, hierarchy column",
              "tier": "domain",
              "type": "string"
            },
            "searchPlaceholder": {
              "default": "Search…",
              "description": "Hint text inside the tree search box (e.g. 'Search nodes…').",
              "label": "Search box placeholder text",
              "synonyms": "search hint, placeholder, search box text, search label",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Tree",
              "description": "Heading shown above the tree",
              "label": "Section title",
              "tier": "presentation",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "CHILD_REQUESTED"
            },
            {
              "kind": "fetch",
              "resource": "TreeNode"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            },
            {
              "kind": "set",
              "resource": "@entity.id"
            }
          ],
          "emits": [
            {
              "description": "Signals a tree node has been selected for external handoff.",
              "event": "OPEN_NODE",
              "eventId": "evt_01M0RYHNM50RK3ZYBW4S0JVZ2N",
              "payloadSchema": [
                {
                  "name": "id",
                  "required": true,
                  "type": "string"
                }
              ],
              "synonyms": "select, choose, open, activate",
              "tier": "domain"
            },
            {
              "description": "Create a new record under this node — the host routes it into its create-draft writer with parentId stamped.",
              "event": "CHILD_REQUESTED",
              "eventId": "evt_01M17BX0J67VGXTSW2C3Y4TREX",
              "payloadSchema": [
                {
                  "name": "parentId",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "new subpage, add child page, create under",
              "tier": "domain"
            },
            {
              "description": "Indicates the tree node collection has been successfully retrieved.",
              "event": "TreeNodeLoaded",
              "eventId": "evt_01M0RYHNM5058FKQ52DVA4S9HP",
              "payloadSchema": [
                {
                  "name": "data",
                  "type": "[TreeNode]"
                }
              ],
              "synonyms": "loaded, fetched, retrieved, ready",
              "tier": "domain"
            },
            {
              "description": "Indicates a failure to load the tree node collection.",
              "event": "TreeNodeLoadFailed",
              "eventId": "evt_01M0RYHNM526XMK2P3K7YYZYAT",
              "payloadSchema": [
                {
                  "name": "error",
                  "type": "string"
                },
                {
                  "name": "code",
                  "type": "string"
                }
              ],
              "synonyms": "error, failed, problem, unsuccessful",
              "tier": "internal"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "TreeNode": "ent_01M0RYHNM1NXR2J5S0HK2WFDS3"
          },
          "id": "trt_01M0RYHNM11N15TSY0QWVC2GH5",
          "linkedEntity": "TreeNode",
          "linkedEntityId": "ent_01M0RYHNM1NXR2J5S0HK2WFDS3",
          "name": "TreeBrowse",
          "scope": "collection",
          "stateMachine": {
            "events": [
              {
                "description": "Mark this record as the open one (routed from the host document's load events); its row highlights and its ancestors auto-expand.",
                "id": "evt_01M17BX0J64EZJWZX8502Q7135",
                "key": "SET_CURRENT",
                "name": "Set Current",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "highlight current, select node, you are here",
                "tier": "domain"
              },
              {
                "id": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Indicates the tree node collection has been successfully retrieved.",
                "id": "evt_01M0RYHNM5058FKQ52DVA4S9HP",
                "key": "TreeNodeLoaded",
                "name": "TreeNode loaded",
                "payloadSchema": [
                  {
                    "name": "data",
                    "type": "[TreeNode]"
                  }
                ],
                "synonyms": "loaded, fetched, retrieved, ready",
                "tier": "domain"
              },
              {
                "description": "Indicates a failure to load the tree node collection.",
                "id": "evt_01M0RYHNM526XMK2P3K7YYZYAT",
                "key": "TreeNodeLoadFailed",
                "name": "TreeNode load failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "synonyms": "error, failed, problem, unsuccessful",
                "tier": "internal"
              },
              {
                "description": "Triggers a tree refresh based on the current search query.",
                "id": "evt_01M11H00X42VFQ0VXEXV7ES6F9",
                "key": "REFETCH_QUERY",
                "name": "Refetch Query",
                "payloadSchema": [
                  {
                    "name": "searchTerm",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "refresh, reload, update, re-query",
                "tier": "domain"
              },
              {
                "description": "Triggers a tree refresh based on current filter criteria.",
                "id": "evt_01M11H00X4BMW519Q3CSP735Z8",
                "key": "REFETCH_FILTER",
                "name": "Refetch Filter",
                "payloadSchema": [
                  {
                    "name": "entity",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "field",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "query",
                    "type": "string"
                  }
                ],
                "synonyms": "refresh, filter, update, reload",
                "tier": "domain"
              },
              {
                "description": "Signals a tree node has been selected for external handoff.",
                "id": "evt_01M0RYHNM50RK3ZYBW4S0JVZ2N",
                "key": "OPEN_NODE",
                "name": "Open Node",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "select, choose, open, activate",
                "tier": "domain"
              },
              {
                "description": "The row's hover + affordance was clicked.",
                "id": "evt_01M17BX0J6VTTJYK99BC6RNMVY",
                "key": "ADD_CHILD",
                "name": "Add Child",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "add inside, new child",
                "tier": "presentation"
              },
              {
                "id": "evt_01M0RYHNM5HX05GFM20W62NCPC",
                "key": "RETRY",
                "name": "Retry"
              },
              {
                "description": "Create a new record under this node — the host routes it into its create-draft writer with parentId stamped.",
                "id": "evt_01M17BX0J67VGXTSW2C3Y4TREX",
                "key": "CHILD_REQUESTED",
                "name": "Child Requested",
                "payloadSchema": [
                  {
                    "name": "parentId",
                    "required": true,
                    "type": "string"
                  }
                ],
                "synonyms": "new subpage, add child page, create under",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "loading"
              },
              {
                "name": "browsing"
              },
              {
                "name": "error"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
                  ],
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      }
                    }
                  ]
                ],
                "event": "SET_CURRENT",
                "eventId": "evt_01M17BX0J64EZJWZX8502Q7135",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "align": "center",
                      "children": [
                        {
                          "type": "spinner"
                        },
                        {
                          "color": "muted",
                          "content": "Loading tree…",
                          "type": "typography",
                          "variant": "caption"
                        }
                      ],
                      "className": "py-12",
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        [
                          "if",
                          [
                            "=",
                            "@config.look",
                            "rail"
                          ],
                          {
                            "className": "px-2 pb-1 uppercase tracking-wide",
                            "color": "muted",
                            "content": "@config.title",
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "align": "center",
                            "children": [
                              {
                                "name": "list-tree",
                                "type": "icon"
                              },
                              {
                                "content": "@config.title",
                                "type": "typography",
                                "variant": "h3"
                              },
                              {
                                "label": [
                                  "array/len",
                                  "@payload.data"
                                ],
                                "size": "sm",
                                "type": "badge",
                                "variant": "neutral"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            "=",
                            "@config.look",
                            "rail"
                          ],
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          },
                          {
                            "type": "divider"
                          }
                        ],
                        [
                          "if",
                          "@config.bodySearch",
                          {
                            "children": [
                              {
                                "className": "w-full max-w-md",
                                "clearable": true,
                                "event": "REFETCH_QUERY",
                                "placeholder": "@config.searchPlaceholder",
                                "type": "search-input"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            ">",
                            [
                              "array/len",
                              "@config.filters"
                            ],
                            0.0
                          ],
                          {
                            "children": [
                              {
                                "entity": "TreeNode",
                                "event": "REFETCH_FILTER",
                                "filters": "@config.filters",
                                "look": "@config.filterBarLook",
                                "type": "filter-group"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        {
                          "items": [
                            "array/map",
                            "@payload.data",
                            [
                              "fn",
                              "row",
                              {
                                "icon": [
                                  "str/default",
                                  [
                                    "object/get",
                                    "@row",
                                    "@config.iconField"
                                  ],
                                  ""
                                ],
                                "id": "@row.id",
                                "label": [
                                  "str/default",
                                  [
                                    "object/get",
                                    "@row",
                                    "@config.labelField"
                                  ],
                                  ""
                                ],
