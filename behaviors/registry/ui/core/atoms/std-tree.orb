                          "name": "alert-triangle",
                          "type": "icon"
                        },
                        {
                          "content": "Failed to load tree",
                          "type": "typography",
                          "variant": "body"
                        },
                        {
                          "color": "muted",
                          "content": "@payload.error",
                          "type": "typography",
                          "variant": "caption"
                        },
                        {
                          "action": "RETRY",
                          "icon": "rotate-ccw",
                          "label": "Retry",
                          "type": "button",
                          "variant": "ghost"
                        }
