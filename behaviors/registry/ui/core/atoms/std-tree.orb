                "key": "RETRY",
                "name": "Retry"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "loading"
              },
              {
                "name": "browsing"
              },
              {
                "name": "error"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "TreeNode",
                    {
                      "emit": {
                        "failure": "TreeNodeLoadFailed",
                        "success": "TreeNodeLoaded"
                      }
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "align": "center",
                      "children": [
                        {
                          "type": "spinner"
                        },
                        {
                          "color": "muted",
                          "content": "Loading tree…",
                          "type": "typography",
                          "variant": "caption"
                        }
                      ],
                      "className": "py-12",
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0RYHNM178W08KQ2SQ8BBXTK",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            {
                              "name": "list-tree",
                              "type": "icon"
                            },
                            {
                              "content": "@config.title",
                              "type": "typography",
                              "variant": "h3"
                            },
                            {
                              "label": [
                                "array/len",
                                "@payload.data"
                              ],
                              "size": "sm",
                              "type": "badge",
                              "variant": "neutral"
                            }
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        },
                        {
                          "type": "divider"
                        },
                        {
                          "items": [
                            "array/map",
                            "@payload.data",
                            [
                              "fn",
                              "row",
                              {
                                "icon": "@row.icon",
                                "id": "@row.id",
                                "label": "@row.name",
                                "parentId": "@row.parentId"
                              }
                            ]
                          ],
                          "onNodeSelect": "OPEN_NODE",
                          "type": "file-tree"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "TreeNodeLoaded",
                "eventId": "evt_01M0RYHNM5058FKQ52DVA4S9HP",
                "from": "loading",
                "to": "browsing"
