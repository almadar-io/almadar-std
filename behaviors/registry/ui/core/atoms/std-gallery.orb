                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        "@trait.MediaGalleryGrid"
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
