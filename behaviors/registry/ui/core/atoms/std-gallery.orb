                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@trait.ErrorAlert"
                      ],
                      "type": "box"
                    }
                  ]
                ],
                "event": "GalleryItemLoadFailed",
                "eventId": "evt_01KXG04GJ9RSHKRPV86G1T79DS",
                "from": "loading",
                "to": "error"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "GalleryItem",
                    {
                      "emit": {
                        "failure": "GalleryItemLoadFailed",
                        "success": "GalleryItemLoaded"
                      }
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04GJ9Z66Y7BREMV82AANS",
                "from": "browsing",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "GalleryItem",
                    {
                      "emit": {
                        "failure": "GalleryItemLoadFailed",
                        "success": "GalleryItemLoaded"
                      },
                      "filter": [
                        "or",
                        [
                          "=",
                          "@payload.searchTerm",
                          ""
                        ],
                        [
                          "str/includes",
                          [
                            "object/get",
                            "@entity",
                            "name"
                          ],
                          "@payload.searchTerm"
                        ]
                      ],
                      "limit": "@config.pageSize",
                      "offset": 0.0
                    }
                  ]
                ],
                "event": "REFETCH_QUERY",
                "eventId": "evt_01M11GXG2SJ7ECYZZ40S72N47Q",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "GalleryItem",
                    {
                      "emit": {
                        "failure": "GalleryItemLoadFailed",
                        "success": "GalleryItemLoaded"
                      },
                      "filter": [
                        "or",
                        [
                          "=",
                          "@payload.value",
                          ""
                        ],
                        [
                          "=",
                          [
                            "object/get",
                            "@entity",
                            "@payload.field"
                          ],
                          "@payload.value"
                        ]
                      ],
                      "limit": "@config.pageSize",
                      "offset": 0.0
                    }
                  ]
                ],
                "event": "REFETCH_FILTER",
                "eventId": "evt_01M11GXG2S4ZRV6ED7REMY7MGE",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "fetch",
                    "GalleryItem",
                    {
                      "emit": {
                        "failure": "GalleryItemLoadFailed",
                        "success": "GalleryItemLoaded"
                      },
                      "limit": "@config.pageSize",
                      "offset": [
                        "*",
                        [
                          "-",
                          "@payload.page",
                          1.0
                        ],
                        "@config.pageSize"
                      ]
                    }
                  ]
                ],
                "event": "REFETCH_PAGE",
                "eventId": "evt_01M11GXG2STP7HH2WXTZH2V08X",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "align": "center",
