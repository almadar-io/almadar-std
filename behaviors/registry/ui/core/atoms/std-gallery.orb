                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            ">",
                            [
                              "array/len",
                              "@config.filters"
                            ],
                            0.0
                          ],
                          {
                            "children": [
                              {
                                "entity": "GalleryItem",
                                "event": "REFETCH_FILTER",
                                "filters": "@config.filters",
                                "look": "@config.filterBarLook",
                                "type": "filter-group"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        "@trait.MediaGalleryGrid"
                      ],
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "GalleryItemLoaded",
                "eventId": "evt_01KXG04GJ96GWXWMB99T91CGKE",
                "from": "browsing",
                "to": "browsing"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
