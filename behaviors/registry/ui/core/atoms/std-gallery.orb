                                "type": "search-input"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [],
                            "gap": "none",
                            "type": "stack"
                          }
                        ],
                        [
                          "if",
                          [
                            ">",
                            [
                              "array/len",
                              "@config.filters"
                            ],
                            0.0
                          ],
                          {
                            "children": [
                              {
                                "entity": "GalleryItem",
                                "event": "REFETCH_FILTER",
                                "filters": "@config.filters",
                                "look": "@config.filterBarLook",
                                "type": "filter-group"
