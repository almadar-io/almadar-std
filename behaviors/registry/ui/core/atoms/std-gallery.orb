                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04GJ9Z66Y7BREMV82AANS",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            "@trait.GalleryIcon",
