              "tier": "presentation",
              "type": "[ItemAction]"
            },
            "userMenuItems": {
              "default": [],
              "description": "Entries listed above Sign out in the signed-in viewer's account menu (e.g. Settings, Profile); each navigates (navigatesTo) or emits its event.",
              "items": {
                "properties": {
                  "event": {
                    "name": "event",
