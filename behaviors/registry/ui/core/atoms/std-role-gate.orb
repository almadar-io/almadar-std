          "traits": [
            {
              "ref": "RoleGate",
              "refId": "trt_01M3SD4DFQVBEVVR5G583YHJAF"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "content": {
              "description": "The trait rendered when the viewer's role is allowed, e.g. a button or panel trait ref.",
              "label": "Gated content",
              "synonyms": "wrapped content, guarded element, protected button",
              "tier": "presentation",
              "type": "trait"
            },
            "roles": {
              "default": [],
              "description": "Roles (matched against viewerRole) that see the content. Empty = everyone; any other viewer sees nothing.",
              "items": {
                "type": "string"
              },
              "label": "Visible to roles",
              "synonyms": "allowed roles, only for, who can see, permitted roles",
              "tier": "policy",
              "type": "[string]"
            },
            "viewerRole": {
              "default": "",
              "description": "The signed-in viewer's role that `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`); left empty, only an ungated (empty `roles`) gate renders.",
              "label": "Viewer's role",
              "tier": "policy",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "render-ui",
              "resource": "main"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
