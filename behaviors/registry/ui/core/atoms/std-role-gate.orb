          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3SD4DFQQYBWZDDP7GVPFB45",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        "@config.content"
                      ],
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3SD4DFQQYBWZDDP7GVPFB45",
                "from": "idle",
                "guard": [
                  "or",
                  [
                    "=",
                    [
                      "array/len",
                      "@config.roles"
                    ],
                    0.0
                  ],
                  [
                    "array/includes",
                    "@config.roles",
                    "@config.viewerRole"
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    null
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3SD4DFQQYBWZDDP7GVPFB45",
                "from": "idle",
                "guard": [
                  "not",
                  [
                    "or",
                    [
                      "=",
                      [
                        "array/len",
                        "@config.roles"
                      ],
                      0.0
                    ],
                    [
                      "array/includes",
                      "@config.roles",
                      "@config.viewerRole"
                    ]
                  ]
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
