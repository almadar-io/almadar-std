                                  "align": "center",
                                  "className": [
                                    "if",
                                    [
                                      "==",
                                      "@config.heading",
                                      ""
                                    ],
                                    "hidden",
                                    "tracking-tight"
                                  ],
                                  "content": "@config.heading",
                                  "type": "typography",
                                  "variant": "h3",
                                  "weight": "bold"
                                },
                                {
