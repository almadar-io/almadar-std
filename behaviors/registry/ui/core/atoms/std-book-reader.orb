                                          1.0
                                        ],
                                        ". ",
                                        [
                                          "object/get",
                                          "@chapter",
                                          "title",
                                          ""
                                        ]
                                      ],
                                      "type": "button",
                                      "variant": "link"
                                    }
                                  ]
                                ],
                                "direction": "vertical",
                                "gap": "none",
                                "type": "stack"
                              }
                            ],
                            "className": [
                              "if",
                              [
                                "==",
                                [
                                  "array/len",
                                  "@config.chapters"
                                ],
                                0.0
                              ],
                              "hidden",
                              ""
                            ],
                            "direction": "vertical",
                            "gap": "xs",
                            "type": "stack"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "xl",
                        "type": "stack"
                      }
                    ],
                    "maxWidth": "md",
                    "padding": "lg",
                    "size": "md",
                    "type": "container"
                  }
                ],
                "dir": "@config.direction",
                "fullWidth": true,
                "paddingY": "2xl",
                "type": "box"
              },
              "label": "Cover body",
              "tier": "internal",
              "type": "render-ui"
            },
            "coverImage": {
              "default": "",
              "description": "Cover image URL; empty hides it",
              "label": "Cover image",
              "tier": "presentation",
              "type": "string"
            },
            "coverLabel": {
              "default": "Cover",
              "label": "Back-to-cover label",
              "tier": "presentation",
              "type": "string"
            },
            "direction": {
              "default": "ltr",
              "description": "rtl for Arabic, Hebrew and other right-to-left books",
              "label": "Text direction",
              "synonyms": "right to left, arabic book",
              "tier": "presentation",
              "type": "string",
              "values": [
                "ltr",
                "rtl"
              ]
            },
            "nextLabel": {
              "default": "Next",
              "label": "Next button label",
              "tier": "presentation",
              "type": "string"
            },
            "previousLabel": {
              "default": "Previous",
              "label": "Previous button label",
              "tier": "presentation",
              "type": "string"
            },
            "readingContent": {
              "default": {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "align": "start",
                            "children": [
                              {
                                "action": "BACK_TO_COVER",
                                "label": "@config.coverLabel",
                                "leftIcon": "book-open",
                                "type": "button",
                                "variant": "link"
                              },
                              {
                                "className": "pt-2",
                                "content": "@config.contentsLabel",
                                "type": "typography",
                                "variant": "label",
                                "weight": "semibold"
                              },
                              {
                                "align": "start",
                                "children": [
                                  "array/map",
                                  "@config.chapters",
                                  [
                                    "fn",
                                    "chapter",
                                    {
                                      "action": "OPEN_CHAPTER",
                                      "actionPayload": {
                                        "index": "@index"
                                      },
                                      "className": [
                                        "if",
                                        [
                                          "==",
                                          "@index",
                                          "@entity.chapterIndex"
                                        ],
                                        "text-foreground font-semibold",
                                        ""
                                      ],
                                      "label": [
                                        "object/get",
                                        "@chapter",
                                        "title",
                                        ""
                                      ],
                                      "type": "button",
                                      "variant": "link"
                                    }
                                  ]
                                ],
                                "direction": "vertical",
                                "gap": "none",
                                "type": "stack"
                              }
                            ],
                            "className": "lg:sticky lg:top-6 self-start",
                            "direction": "vertical",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "color": "muted",
                                "content": "@entity.progressLabel",
                                "type": "typography",
                                "variant": "caption"
                              },
                              {
                                "className": "tracking-tight",
                                "content": "@entity.chapterTitle",
                                "type": "typography",
                                "variant": "h2",
                                "weight": "bold"
                              },
                              {
                                "content": "@entity.chapterContent",
                                "direction": "@config.direction",
                                "type": "markdown-content"
                              },
                              {
                                "type": "divider"
                              },
                              {
                                "children": [
                                  {
                                    "action": "PREV_CHAPTER",
                                    "disabled": "@entity.isFirst",
                                    "label": "@config.previousLabel",
                                    "leftIcon": [
                                      "if",
                                      [
                                        "==",
                                        "@config.direction",
                                        "rtl"
                                      ],
                                      "chevron-right",
                                      "chevron-left"
                                    ],
                                    "type": "button",
                                    "variant": "secondary"
                                  },
                                  {
                                    "action": "NEXT_CHAPTER",
                                    "disabled": "@entity.isLast",
                                    "label": "@config.nextLabel",
                                    "rightIcon": [
                                      "if",
                                      [
                                        "==",
                                        "@config.direction",
                                        "rtl"
                                      ],
                                      "chevron-left",
                                      "chevron-right"
                                    ],
                                    "type": "button",
                                    "variant": "primary"
                                  }
                                ],
                                "direction": "horizontal",
                                "gap": "md",
                                "justify": "between",
                                "type": "stack"
                              }
                            ],
                            "direction": "vertical",
                            "gap": "lg",
                            "type": "stack"
                          }
                        ],
                        "gap": "xl",
                        "ratio": "1:3",
                        "type": "split"
                      }
                    ],
                    "maxWidth": "xl",
                    "padding": "lg",
                    "size": "xl",
                    "type": "container"
                  }
                ],
                "dir": "@config.direction",
                "fullWidth": true,
                "paddingY": "xl",
                "type": "box"
              },
              "label": "Reading body",
              "tier": "internal",
              "type": "render-ui"
            },
            "startLabel": {
              "default": "Start reading",
              "label": "Start button label",
              "tier": "presentation",
              "type": "string"
            },
            "subtitle": {
              "default": "",
              "label": "Subtitle",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Untitled book",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "CHAPTER_OPENED"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            },
            {
              "kind": "set",
              "resource": "@entity.chapterContent"
            },
            {
              "kind": "set",
              "resource": "@entity.chapterIndex"
            },
            {
              "kind": "set",
              "resource": "@entity.chapterTitle"
            },
            {
              "kind": "set",
              "resource": "@entity.isFirst"
            },
            {
              "kind": "set",
              "resource": "@entity.isLast"
            },
            {
              "kind": "set",
              "resource": "@entity.progressLabel"
            }
          ],
          "emits": [
            {
              "description": "The reader moved to a chapter; carries its index and title.",
              "event": "CHAPTER_OPENED",
              "eventId": "evt_01M3B9EHG2AHYVJ47RZW3B40HK",
              "payloadSchema": [
                {
                  "name": "index",
                  "type": "number"
                },
                {
                  "name": "title",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "page turned, chapter changed, reading progress",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "chapterContent",
              "chapterIndex",
              "chapterTitle",
              "isFirst",
              "isLast",
              "progressLabel"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "BookReaderView": "ent_01M3B9EHG2VZZ5YT90M5M37VQC"
          },
          "id": "trt_01M3B9EHG2NGP2RVNXSB2ZYXQH",
          "linkedEntity": "BookReaderView",
          "linkedEntityId": "ent_01M3B9EHG2VZZ5YT90M5M37VQC",
          "name": "BookReaderRead",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3B9EHG2JYGWZ0NEKDDJ06CR",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M3B9EHG27GQBR87HFQDZQMYJ",
                "key": "START_READING",
                "name": "Start Reading"
              },
              {
                "description": "Jump to a chapter from the table of contents.",
                "id": "evt_01M3B9EHG2Y1XCZAT8KX11T5PQ",
                "key": "OPEN_CHAPTER",
                "name": "Open Chapter",
                "payloadSchema": [
                  {
                    "name": "index",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "internal"
              },
              {
                "id": "evt_01M3B9EHG2AFZ6QJRB2GTYAZ2H",
                "key": "NEXT_CHAPTER",
                "name": "Next Chapter"
              },
              {
                "id": "evt_01M3B9EHG2YR3VPKGM882TA46D",
                "key": "PREV_CHAPTER",
                "name": "Prev Chapter"
              },
              {
                "id": "evt_01M3B9EHG28V4GG799SEAJCVFJ",
                "key": "BACK_TO_COVER",
                "name": "Back To Cover"
              },
              {
                "description": "The reader moved to a chapter; carries its index and title.",
                "id": "evt_01M3B9EHG2AHYVJ47RZW3B40HK",
                "key": "CHAPTER_OPENED",
                "name": "Chapter Opened",
                "payloadSchema": [
                  {
                    "name": "index",
                    "type": "number"
                  },
                  {
                    "name": "title",
                    "type": "string"
                  }
                ],
                "synonyms": "page turned, chapter changed, reading progress",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "cover"
              },
              {
                "name": "reading"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    "@config.coverContent"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3B9EHG2JYGWZ0NEKDDJ06CR",
                "from": "cover",
                "to": "cover"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.chapterIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.chapterTitle",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.chapters",
                        0.0
                      ],
                      "title",
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.chapterContent",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.chapters",
                        0.0
                      ],
                      "content",
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.isFirst",
                    true
                  ],
                  [
                    "set",
                    "@entity.isLast",
                    [
                      "<=",
                      [
                        "array/len",
                        "@config.chapters"
                      ],
                      1.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.progressLabel",
                    [
                      "str/concat",
                      "1 / ",
                      [
                        "array/len",
                        "@config.chapters"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.readingContent"
                  ],
                  [
                    "emit",
                    "CHAPTER_OPENED",
                    {
                      "index": 0.0,
                      "title": "@entity.chapterTitle"
                    }
                  ]
                ],
                "event": "START_READING",
                "eventId": "evt_01M3B9EHG27GQBR87HFQDZQMYJ",
                "from": "cover",
                "to": "reading"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.chapterIndex",
                    "@payload.index"
                  ],
                  [
                    "set",
                    "@entity.chapterTitle",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.chapters",
                        "@payload.index"
                      ],
                      "title",
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.chapterContent",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.chapters",
                        "@payload.index"
                      ],
                      "content",
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.isFirst",
                    [
                      "==",
                      "@payload.index",
                      0.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.isLast",
                    [
                      ">=",
                      "@payload.index",
                      [
                        "-",
                        [
                          "array/len",
                          "@config.chapters"
                        ],
                        1.0
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.progressLabel",
                    [
                      "str/concat",
                      [
                        "+",
                        "@payload.index",
                        1.0
                      ],
                      " / ",
                      [
                        "array/len",
                        "@config.chapters"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.readingContent"
                  ],
                  [
                    "emit",
                    "CHAPTER_OPENED",
                    {
                      "index": "@payload.index",
                      "title": "@entity.chapterTitle"
                    }
                  ]
                ],
