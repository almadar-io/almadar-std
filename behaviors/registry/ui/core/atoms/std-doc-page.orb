      "traits": [
        {
          "category": "interaction",
          "config": {
            "content": {
              "default": {
                "children": [],
                "direction": "vertical",
                "gap": "lg",
                "type": "stack"
              },
              "description": "The page body: markdown, code and live behaviors (trait references) in reading order",
              "label": "Content",
              "tier": "presentation",
              "type": "render-ui"
            },
            "crumbs": {
              "default": [],
              "description": "Ancestors first, the current page last without a link; empty hides it",
              "items": {
                "properties": {
                  "href": {
                    "name": "href",
                    "required": false,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Breadcrumb",
              "tier": "presentation",
              "type": "[DocCrumb]"
            },
            "direction": {
              "default": "ltr",
              "label": "Direction",
              "tier": "presentation",
              "type": "string",
              "values": [
