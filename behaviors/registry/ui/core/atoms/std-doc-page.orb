                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "children": [
                                {
                                  "children": [
                                    {
                                      "className": [
                                        "if",
                                        [
                                          "==",
                                          "@config.sidebarLabel",
                                          ""
                                        ],
                                        "hidden",
                                        "px-3"
                                      ],
                                      "content": "@config.sidebarLabel",
                                      "type": "typography",
                                      "variant": "label",
                                      "weight": "semibold"
                                    },
                                    {
                                      "aria-label": "@config.sidebarLabel",
                                      "items": "@config.navItems",
                                      "type": "doc-sidebar"
                                    }
                                  ],
                                  "className": "lg:sticky lg:top-6 self-start",
                                  "direction": "vertical",
                                  "gap": "sm",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "className": [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "array/len",
                                            "@config.crumbs"
                                          ],
                                          0.0
                                        ],
                                        "hidden",
                                        ""
                                      ],
                                      "items": "@config.crumbs",
                                      "type": "doc-breadcrumb"
                                    },
                                    {
                                      "children": [
                                        {
                                          "className": "tracking-tight text-balance",
                                          "content": "@config.title",
                                          "type": "typography",
                                          "variant": "h1",
                                          "weight": "bold"
                                        },
                                        {
                                          "className": [
                                            "if",
                                            [
                                              "==",
                                              "@config.lede",
                                              ""
                                            ],
                                            "hidden",
                                            "max-w-3xl text-pretty"
                                          ],
                                          "color": "muted",
                                          "content": "@config.lede",
                                          "type": "typography",
                                          "variant": "large"
                                        }
                                      ],
                                      "direction": "vertical",
                                      "gap": "sm",
                                      "type": "stack"
                                    },
                                    {
                                      "bg": "muted",
                                      "children": [
                                        {
                                          "children": [
                                            {
                                              "content": "@config.tocLabel",
                                              "type": "typography",
                                              "variant": "label",
                                              "weight": "semibold"
                                            },
                                            {
                                              "aria-label": "@config.tocLabel",
                                              "items": "@config.toc",
                                              "type": "doc-toc"
                                            }
                                          ],
                                          "direction": "vertical",
                                          "gap": "xs",
                                          "type": "stack"
                                        }
                                      ],
                                      "className": [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "array/len",
                                            "@config.toc"
                                          ],
                                          0.0
                                        ],
                                        "hidden",
                                        ""
                                      ],
                                      "padding": "md",
                                      "rounded": "lg",
                                      "type": "box"
                                    },
                                    "@config.content",
                                    {
                                      "type": "divider"
                                    },
                                    {
                                      "next": [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@config.next",
                                            "href",
                                            ""
                                          ],
                                          ""
                                        ],
                                        null,
                                        "@config.next"
                                      ],
                                      "prev": [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@config.prev",
                                            "href",
                                            ""
                                          ],
                                          ""
                                        ],
                                        null,
                                        "@config.prev"
                                      ],
                                      "type": "doc-pagination"
                                    }
                                  ],
                                  "className": "min-w-0",
                                  "direction": "vertical",
                                  "gap": "lg",
                                  "type": "stack"
                                }
                              ],
                              "gap": "xl",
                              "ratio": "1:4",
                              "type": "split"
                            }
                          ],
                          "maxWidth": "xl",
                          "padding": "lg",
                          "size": "xl",
                          "type": "container"
                        }
                      ],
                      "dir": "@config.direction",
                      "fullWidth": true,
                      "paddingY": "lg",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M43K1FHR92JR8S2DM4A21077",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
