          "linkedEntityId": "ent_01KYEH1JJPJH06F07Q6CNTHTR8",
          "name": "Button1",
          "ref": "Button.traits.ButtonRender",
          "refId": "trt_01KXG04JBQPWD7RW8X33NXPXG9"
        },
        {
          "config": {
            "items": {
