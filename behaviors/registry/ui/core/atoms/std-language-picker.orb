{
  "description": "std-language-picker — the language switcher of a multilingual site or app: a globe button showing the current language code that opens a menu listing every language in its own name, with the current one ticked. Each entry links to the same page in that language. Routing convention: the default language lives at the root and every other language under a `/<code>/` prefix (`/pricing`, `/ar/pricing`, `/sl/pricing`), so each language has its own stable URL that can be linked from outside and indexed by search engines. Pick for public websites and app chrome that serve more than one language; std-site-header embeds it.",
  "ledger": {
    "entries": {
      "ent_01M3EP9GR5HJNV57FWRFGAFE0R": {
        "bakedName": "LanguagePickerView",
        "curName": "LanguagePickerView",
        "id": "ent_01M3EP9GR5HJNV57FWRFGAFE0R",
        "kind": "entity",
        "owner": "workspace",
        "renames": []
      },
      "evt_01M3EP9GR53ERPM7R74BNRZ4CE": {
        "bakedName": "INIT",
        "curName": "INIT",
        "id": "evt_01M3EP9GR53ERPM7R74BNRZ4CE",
        "kind": "event",
        "owner": "workspace",
        "parent": "trt_01M3EP9GR59SKY3S07NFKS55QB",
        "renames": []
      },
      "orb_01M3EP9GR5AKQHSX1C0BHSTXC9": {
        "bakedName": "LanguagePickerOrbital",
        "curName": "LanguagePickerOrbital",
        "id": "orb_01M3EP9GR5AKQHSX1C0BHSTXC9",
        "kind": "orbital",
        "owner": "workspace",
        "renames": []
      },
      "pag_01M3EP9GR536BBQXM9PHZ928FW": {
        "bakedName": "LanguagePickerPage",
        "curName": "LanguagePickerPage",
        "id": "pag_01M3EP9GR536BBQXM9PHZ928FW",
        "kind": "page",
        "owner": "workspace",
        "renames": []
      },
      "trt_01M3EP9GR59SKY3S07NFKS55QB": {
        "bakedName": "LanguagePickerRender",
        "curName": "LanguagePickerRender",
        "id": "trt_01M3EP9GR59SKY3S07NFKS55QB",
        "kind": "trait",
        "owner": "workspace",
        "renames": []
      }
    },
    "schemaVersion": 1
  },
  "name": "std-language-picker",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "id": "ent_01M3EP9GR5HJNV57FWRFGAFE0R",
        "name": "LanguagePickerView",
        "persistence": "runtime"
      },
      "id": "orb_01M3EP9GR5AKQHSX1C0BHSTXC9",
      "name": "LanguagePickerOrbital",
      "pages": [
        {
          "id": "pag_01M3EP9GR536BBQXM9PHZ928FW",
          "name": "LanguagePickerPage",
          "path": "/language-picker",
          "traits": [
            {
              "ref": "LanguagePickerRender",
              "refId": "trt_01M3EP9GR59SKY3S07NFKS55QB"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "currentLanguage": {
              "default": "en",
              "description": "The code of the language this page is in; shown on the button and ticked in the menu",
              "label": "Current language",
              "synonyms": "locale, active language, page language",
              "tier": "presentation",
              "type": "string"
            },
            "languages": {
              "default": [
                {
                  "code": "en",
                  "href": "/",
                  "label": "English"
                },
                {
                  "code": "ar",
                  "href": "/ar/",
                  "label": "العربية"
                },
                {
                  "code": "sl",
                  "href": "/sl/",
                  "label": "Slovenščina"
                }
              ],
              "description": "Every language this page exists in, each named in its own language, with the href of THIS page in that language. The default language's href has no prefix; the others start with /<code>/.",
              "items": {
                "properties": {
                  "code": {
                    "name": "code",
                    "required": true,
                    "type": "string"
                  },
                  "href": {
                    "name": "href",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Languages",
              "synonyms": "locales, translations, language list, language switcher, i18n",
              "tier": "presentation",
              "type": "[SiteLanguage]"
            },
            "pickerContent": {
              "default": {
                "className": [
                  "if",
                  [
                    "==",
                    [
                      "array/len",
                      "@config.languages"
                    ],
                    0.0
                  ],
                  "hidden",
                  ""
                ],
                "items": [
                  "array/map",
                  "@config.languages",
                  [
                    "fn",
                    "entry",
                    {
                      "href": [
                        "object/get",
                        "@entry",
                        "href",
                        ""
                      ],
                      "icon": [
                        "if",
                        [
                          "==",
                          [
                            "object/get",
                            "@entry",
                            "code",
                            ""
                          ],
                          "@config.currentLanguage"
                        ],
                        "check",
                        ""
                      ],
                      "id": [
                        "object/get",
                        "@entry",
                        "code",
                        ""
                      ],
                      "label": [
                        "object/get",
                        "@entry",
                        "label",
                        ""
                      ]
                    }
                  ]
                ],
                "position": "bottom-end",
                "trigger": {
                  "icon": "globe",
                  "label": [
                    "str/upper",
                    "@config.currentLanguage"
                  ],
                  "size": "sm",
                  "type": "button",
                  "variant": "ghost"
                },
                "type": "menu"
              },
              "label": "Picker body",
              "tier": "internal",
              "type": "render-ui"
            }
          },
          "effectRow": [
            {
              "kind": "render-ui",
              "resource": "main"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "LanguagePickerView": "ent_01M3EP9GR5HJNV57FWRFGAFE0R"
          },
          "id": "trt_01M3EP9GR59SKY3S07NFKS55QB",
          "linkedEntity": "LanguagePickerView",
          "linkedEntityId": "ent_01M3EP9GR5HJNV57FWRFGAFE0R",
          "name": "LanguagePickerRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3EP9GR53ERPM7R74BNRZ4CE",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    "@config.pickerContent"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3EP9GR53ERPM7R74BNRZ4CE",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "SiteLanguage": [
          {
            "name": "code",
            "required": true,
            "type": "string"
          },
          {
            "name": "label",
            "required": true,
            "type": "string"
          },
          {
            "name": "href",
            "required": true,
            "type": "string"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}