  "name": "std-site-header",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "default": false,
            "name": "menuOpen",
            "type": "boolean"
          }
        ],
        "id": "ent_01M3B9EHRNR3JQPJSD36PH5QV8",
        "name": "SiteHeaderView",
