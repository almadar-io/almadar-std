                "name": "Menu Toggle"
              },
              {
                "description": "Navigation link click.",
                "id": "evt_01M3B9EHRNW2S9ZFCCVXC2TK2K",
                "key": "NAV_LINK",
                "name": "Nav Link",
                "payloadSchema": [
                  {
                    "name": "href",
                    "type": "string"
                  },
                  {
                    "name": "label",
                    "type": "string"
                  }
                ],
                "tier": "internal"
              },
              {
                "description": "A navigation link or the header action was clicked; carries its href and label.",
                "id": "evt_01M3B9EHRN59ANSWM8VVE2BPDM",
                "key": "NAV_CLICKED",
                "name": "Nav Clicked",
                "payloadSchema": [
                  {
                    "name": "href",
                    "type": "string"
                  },
                  {
                    "name": "label",
                    "type": "string"
                  }
                ],
                "synonyms": "menu click, nav click, header link",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.menuOpen",
                    false
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.headerContent"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3B9EHRN2FS91GX1P63Y9HRV",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.menuOpen",
                    [
                      "not",
                      "@entity.menuOpen"
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.headerContent"
                  ]
                ],
                "event": "MENU_TOGGLE",
                "eventId": "evt_01M3B9EHRNS7CQG2J4SRCQPJNV",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.menuOpen",
                    false
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.headerContent"
                  ],
                  [
                    "emit",
                    "NAV_CLICKED",
                    {
                      "href": "@payload.href",
                      "label": "@payload.label"
                    }
                  ]
                ],
                "event": "NAV_LINK",
                "eventId": "evt_01M3B9EHRNW2S9ZFCCVXC2TK2K",
                "from": "idle",
                "to": "idle"
              }
            ]
          },
          "traitEmbedIds": {
            "SiteHeaderLanguages": "trt_01M3EPAAKX1EXPTSJ0M1WTZFTB"
          }
        },
        {
          "config": {
            "currentLanguage": {
              "default": "@config.currentLanguage",
              "type": "unknown"
            },
            "languages": {
