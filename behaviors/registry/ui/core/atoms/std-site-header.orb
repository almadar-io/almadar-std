      },
      "id": "orb_01M3B9EHRNA3ZZE0AQPDDH12RF",
      "name": "SiteHeaderOrbital",
      "pages": [
        {
          "id": "pag_01M3B9EHRNH24TA5C22SN781S4",
          "name": "SiteHeaderPage",
          "path": "/site-header",
          "traits": [
            {
              "ref": "SiteHeaderRender",
              "refId": "trt_01M3B9EHRNJ40F0K1EDRJN2X0H"
            },
            {
              "ref": "SiteHeaderLanguages",
              "refId": "trt_01M3EPAAKX1EXPTSJ0M1WTZFTB"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "actionHref": {
              "default": "",
              "label": "Header action link",
              "tier": "presentation",
              "type": "string"
            },
            "actionLabel": {
              "default": "",
              "description": "Call-to-action button at the right; empty hides it",
              "label": "Header action label",
              "synonyms": "cta, sign up button, get started",
              "tier": "presentation",
              "type": "string"
            },
            "brandName": {
              "default": "Almadar",
              "label": "Brand name",
              "synonyms": "site name, company, logo text",
              "tier": "presentation",
              "type": "string"
            },
            "currentLanguage": {
              "default": "en",
              "description": "The code of the language this page is in",
              "label": "Current language",
              "synonyms": "locale, active language, page language",
              "tier": "presentation",
              "type": "string"
            },
            "currentPath": {
              "default": "/",
              "description": "Marks the matching link as active",
              "label": "Current page path",
              "tier": "presentation",
              "type": "string"
            },
            "headerContent": {
              "default": {
                "children": [
                  {
                    "actions": [
                      "@trait.SiteHeaderLanguages",
                      {
                        "action": "NAV_LINK",
                        "actionPayload": {
                          "href": "@config.actionHref",
                          "label": "@config.actionLabel"
                        },
                        "className": [
                          "if",
                          [
                            "==",
                            "@config.actionLabel",
                            ""
                          ],
                          "hidden",
                          ""
                        ],
                        "href": "@config.actionHref",
                        "label": "@config.actionLabel",
                        "size": "sm",
                        "type": "button",
                        "variant": "primary"
                      }
                    ],
                    "brandName": "@config.brandName",
                    "className": "hidden lg:flex",
                    "logoSrc": "@config.logoSrc",
                    "navigationItems": [
                      "array/map",
                      "@config.links",
                      [
                        "fn",
                        "entry",
                        {
                          "active": [
                            "==",
                            [
                              "object/get",
                              "@entry",
                              "href",
                              ""
                            ],
                            "@config.currentPath"
                          ],
                          "children": [
                            "array/map",
                            [
                              "object/get",
                              "@entry",
                              "children",
                              []
                            ],
                            [
                              "fn",
                              "child",
                              {
                                "active": [
                                  "==",
                                  [
                                    "object/get",
                                    "@child",
                                    "href",
                                    ""
                                  ],
                                  "@config.currentPath"
                                ],
                                "href": [
                                  "object/get",
                                  "@child",
                                  "href",
                                  ""
                                ],
                                "label": [
                                  "object/get",
                                  "@child",
                                  "label",
                                  ""
                                ]
                              }
                            ]
                          ],
                          "href": [
                            "object/get",
                            "@entry",
                            "href",
                            ""
                          ],
                          "label": [
                            "object/get",
                            "@entry",
                            "label",
                            ""
                          ]
                        }
                      ]
                    ],
                    "showMenuToggle": false,
                    "sticky": false,
                    "type": "header",
                    "variant": "desktop"
                  },
                  {
                    "actions": [
                      "@trait.SiteHeaderLanguages"
                    ],
                    "brandName": "@config.brandName",
                    "className": "lg:hidden",
                    "isMenuOpen": "@entity.menuOpen",
                    "logoSrc": "@config.logoSrc",
                    "onMenuToggle": "MENU_TOGGLE",
                    "showMenuToggle": true,
                    "sticky": false,
                    "type": "header",
                    "variant": "mobile"
                  },
                  {
                    "align": "stretch",
                    "children": [
                      {
                        "align": "stretch",
                        "children": [
                          "array/map",
                          "@config.links",
                          [
                            "fn",
                            [
                              "entry"
                            ],
                            {
                              "align": "stretch",
                              "children": [
                                {
                                  "action": "NAV_LINK",
                                  "actionPayload": {
                                    "href": [
                                      "object/get",
                                      "@entry",
                                      "href",
                                      ""
                                    ],
                                    "label": [
                                      "object/get",
                                      "@entry",
                                      "label",
                                      ""
                                    ]
                                  },
                                  "className": "justify-start",
                                  "href": [
                                    "object/get",
                                    "@entry",
                                    "href",
                                    ""
                                  ],
                                  "label": [
                                    "object/get",
                                    "@entry",
                                    "label",
                                    ""
                                  ],
                                  "type": "button",
                                  "variant": [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@entry",
                                        "href",
                                        ""
                                      ],
                                      "@config.currentPath"
                                    ],
                                    "secondary",
                                    "ghost"
                                  ]
                                },
                                {
                                  "align": "stretch",
                                  "children": [
                                    "array/map",
                                    [
                                      "object/get",
                                      "@entry",
                                      "children",
                                      []
                                    ],
                                    [
                                      "fn",
                                      [
                                        "child"
                                      ],
                                      {
                                        "action": "NAV_LINK",
                                        "actionPayload": {
                                          "href": [
                                            "object/get",
                                            "@child",
                                            "href",
                                            ""
                                          ],
                                          "label": [
                                            "object/get",
                                            "@child",
                                            "label",
                                            ""
                                          ]
                                        },
                                        "className": "justify-start",
                                        "href": [
                                          "object/get",
                                          "@child",
                                          "href",
                                          ""
                                        ],
                                        "label": [
                                          "object/get",
                                          "@child",
                                          "label",
                                          ""
                                        ],
                                        "type": "button",
                                        "variant": [
                                          "if",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@child",
                                              "href",
                                              ""
                                            ],
                                            "@config.currentPath"
                                          ],
                                          "secondary",
                                          "ghost"
                                        ]
                                      }
                                    ]
                                  ],
                                  "className": "ps-6",
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            }
                          ]
                        ],
                        "direction": "vertical",
                        "gap": "xs",
                        "type": "stack"
                      },
                      {
                        "action": "NAV_LINK",
                        "actionPayload": {
                          "href": "@config.actionHref",
                          "label": "@config.actionLabel"
                        },
                        "className": [
                          "if",
                          [
                            "==",
                            "@config.actionLabel",
                            ""
                          ],
                          "hidden",
                          "mt-2 w-full"
                        ],
                        "href": "@config.actionHref",
                        "label": "@config.actionLabel",
                        "size": "md",
                        "type": "button",
                        "variant": "primary"
                      }
                    ],
                    "className": [
                      "if",
                      "@entity.menuOpen",
                      "lg:hidden border-b border-border bg-card px-4 py-3",
                      "hidden"
                    ],
                    "direction": "vertical",
                    "gap": "xs",
                    "type": "stack"
                  }
                ],
                "className": "sticky top-0 z-50",
                "direction": "vertical",
                "gap": "none",
                "type": "stack"
              },
              "label": "Header body",
              "tier": "internal",
              "type": "render-ui"
            },
            "languages": {
              "default": [],
              "description": "Every language this page exists in, each named in its own language, with the href of THIS page in that language (default language at the root, others under /<code>/). Empty hides the language picker.",
              "items": {
                "properties": {
                  "code": {
                    "name": "code",
                    "required": true,
                    "type": "string"
                  },
                  "href": {
                    "name": "href",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Languages",
              "synonyms": "locales, translations, language switcher, i18n",
              "tier": "presentation",
              "type": "[SiteLanguage]"
            },
            "links": {
              "default": [
                {
                  "href": "/features",
                  "label": "Features"
                },
                {
                  "href": "/pricing",
                  "label": "Pricing"
                },
                {
                  "href": "/about",
                  "label": "About"
                }
              ],
              "items": {
                "properties": {
                  "children": {
                    "items": {
                      "type": "union",
                      "values": [
                        "SiteNavLink"
                      ]
                    },
                    "name": "children",
                    "required": false,
                    "type": "array"
                  },
                  "href": {
                    "name": "href",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Navigation links",
              "synonyms": "menu, nav items, top navigation",
              "tier": "presentation",
              "type": "[SiteNavLink]"
            },
            "logoSrc": {
              "default": "",
              "description": "Logo URL; empty shows the name only",
              "label": "Logo image",
              "tier": "presentation",
              "type": "string"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "NAV_CLICKED"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            },
            {
              "kind": "set",
              "resource": "@entity.menuOpen"
            }
          ],
          "emits": [
            {
              "description": "A navigation link or the header action was clicked; carries its href and label.",
              "event": "NAV_CLICKED",
              "eventId": "evt_01M3B9EHRN59ANSWM8VVE2BPDM",
              "payloadSchema": [
                {
                  "name": "href",
                  "type": "string"
                },
                {
                  "name": "label",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "menu click, nav click, header link",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "menuOpen"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SiteHeaderView": "ent_01M3B9EHRNR3JQPJSD36PH5QV8"
          },
          "id": "trt_01M3B9EHRNJ40F0K1EDRJN2X0H",
          "linkedEntity": "SiteHeaderView",
          "linkedEntityId": "ent_01M3B9EHRNR3JQPJSD36PH5QV8",
          "name": "SiteHeaderRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3B9EHRN2FS91GX1P63Y9HRV",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M3B9EHRNS7CQG2J4SRCQPJNV",
