                                "id": "@payload.id"
                              },
                              "icon": "check",
                              "label": "Confirm",
                              "type": "button",
                              "variant": "primary"
                            }
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        }
                      ],
                      "direction": "vertical",
                      "gap": "lg",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "SELECT",
                "eventId": "evt_01KXG04HJXZE6B9HHPC6JT0FEW",
                "from": "idle",
                "to": "selecting"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "align": "center",
                          "children": [
                            {
                              "align": "center",
                              "children": [
                                {
                                  "name": "check-circle",
