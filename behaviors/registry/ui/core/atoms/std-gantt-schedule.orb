  "name": "std-gantt-schedule",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "default": "",
            "description": "task label shown on the bar",
            "name": "title",
            "synonyms": "name, label, summary, subject",
            "type": "string"
          },
          {
            "description": "task start timestamp the bar is placed from",
            "name": "start",
            "synonyms": "starts, begins, start date, from",
            "type": "datetime"
          },
          {
            "description": "task end timestamp the bar is placed to; when absent, duration days are used",
            "name": "end",
            "synonyms": "finish, due, end date, until",
            "type": "datetime"
          },
          {
            "default": "pending",
            "description": "task lifecycle status, drives bar colour",
            "name": "status",
            "synonyms": "state, stage, phase",
            "type": "string",
            "values": [
              "pending",
              "active",
              "complete",
              "blocked"
            ]
          },
          {
            "default": "",
            "description": "group/section the task renders under a header row for",
            "name": "group",
            "synonyms": "team, swimlane, section, project",
            "type": "string"
          }
        ],
        "id": "ent_01M2M5G80ZEXM0SP6SA5JV6G45",
