              "type": "icon"
            },
            "bottomPanelLabel": {
              "default": "Panel",
              "description": "On a narrow screen, the top-bar button that opens the bottom panel.",
              "label": "Bottom panel button",
              "tier": "presentation",
              "type": "string"
            },
            "bottomPanelTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the bottom panel when showBottomPanel is on.",
              "label": "Bottom panel",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "floatingTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the floating strip when showFloating is on.",
              "label": "Floating strip",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "mainTrait": {
              "description": "Trait rendered in the centre of the workspace (the editor, canvas or preview).",
              "label": "Main area",
              "synonyms": "editor area, canvas, centre panel, main panel",
              "tier": "presentation",
              "type": "trait"
            },
            "railTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the far-left rail when showRail is on.",
              "label": "Rail",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "secondarySidebarIcon": {
              "default": "panel-right-open",
              "label": "Right sidebar icon",
              "tier": "presentation",
              "type": "icon"
            },
            "secondarySidebarLabel": {
              "default": "Inspector",
              "description": "On a narrow screen, the top-bar button that opens the right sidebar.",
              "label": "Right sidebar button",
              "tier": "presentation",
              "type": "string"
            },
            "secondarySidebarTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the right sidebar when showSecondarySidebar is on.",
              "label": "Right sidebar",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "secondarySidebarWidth": {
              "default": 280.0,
              "description": "Width of the right sidebar in pixels.",
              "label": "Right sidebar width",
              "tier": "presentation",
              "type": "number"
            },
            "showBottomPanel": {
              "default": false,
              "description": "A collapsible panel under the main area (problems, output, terminal).",
              "label": "Show a bottom panel?",
              "synonyms": "bottom drawer, output panel, problems panel, terminal",
              "tier": "presentation",
              "type": "boolean"
            },
            "showFloating": {
              "default": false,
              "description": "A strip centred at the top of the main area, over its content (a toolbar or a status pill).",
              "label": "Show a floating strip over the main area?",
              "synonyms": "floating toolbar, top bar over canvas, overlay strip",
              "tier": "presentation",
              "type": "boolean"
            },
            "showRail": {
              "default": false,
              "description": "A narrow far-left strip, usually an icon bar that switches the sidebar's view.",
              "label": "Show an activity rail?",
              "synonyms": "activity bar, icon rail, nav rail",
              "tier": "presentation",
              "type": "boolean"
            },
            "showSecondarySidebar": {
              "default": false,
              "description": "A collapsible right sidebar (an inspector or a chat).",
              "label": "Show a right sidebar?",
              "synonyms": "right panel, inspector, right dock",
              "tier": "presentation",
              "type": "boolean"
            },
            "showSidebar": {
              "default": true,
              "description": "The collapsible, resizable left sidebar (an explorer, page list or chat).",
              "label": "Show the left sidebar?",
              "synonyms": "left panel, explorer, side panel",
              "tier": "presentation",
              "type": "boolean"
            },
            "showStatusBar": {
              "default": false,
              "description": "A slim strip pinned to the bottom of the frame.",
              "label": "Show a status bar?",
              "synonyms": "status line, footer strip",
              "tier": "presentation",
              "type": "boolean"
            },
            "showTopBar": {
              "default": false,
              "description": "A full-width strip above every region (the project name, view toggles and actions).",
              "label": "Show a top bar above the workspace?",
              "synonyms": "workspace header, toolbar strip, top strip",
              "tier": "presentation",
              "type": "boolean"
            },
            "sidebarMinSize": {
              "default": 240.0,
              "description": "Minimum width of the left sidebar in pixels.",
              "label": "Narrowest left sidebar",
              "tier": "presentation",
              "type": "number"
            },
            "sidebarTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the left sidebar when showSidebar is on.",
              "label": "Left sidebar",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "statusBarTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the status bar when showStatusBar is on.",
              "label": "Status bar",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            },
            "topBarTrait": {
              "default": "@trait.EmptyRegion",
              "description": "Trait rendered in the top bar when showTopBar is on.",
              "label": "Top bar",
              "refId": "trt_01M4GT9VY4SME969P428HZ9X6K",
              "tier": "presentation",
              "type": "trait"
            }
