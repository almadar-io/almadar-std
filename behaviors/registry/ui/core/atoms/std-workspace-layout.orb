          "effectRow": [
            {
              "kind": "render-ui",
              "resource": "main"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "WorkspaceLayoutData": "ent_01M4GT9VY4X247TSC6FSKY4QHY"
          },
          "id": "trt_01M4GT9VY4PA7PFRZPQ6NMBYGV",
          "linkedEntity": "WorkspaceLayoutData",
          "linkedEntityId": "ent_01M4GT9VY4X247TSC6FSKY4QHY",
          "name": "WorkspaceLayout",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M4GT9VY4QY9FYX4TCX5F544R",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "composing"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        [
                          "if",
                          "@config.showTopBar",
                          "@config.topBarTrait",
                          null
                        ],
                        {
                          "bottomPanel": [
                            "if",
                            "@config.showBottomPanel",
                            "@config.bottomPanelTrait",
                            null
                          ],
                          "bottomPanelIcon": "@config.bottomPanelIcon",
                          "bottomPanelLabel": "@config.bottomPanelLabel",
                          "className": "flex-1 min-h-0",
                          "main": {
                            "children": [
                              "@config.mainTrait",
                              [
                                "if",
                                "@config.showFloating",
                                {
                                  "children": [
                                    {
                                      "children": [
                                        "@config.floatingTrait"
                                      ],
                                      "className": "pointer-events-auto",
                                      "type": "box"
                                    }
                                  ],
                                  "className": "pointer-events-none absolute inset-x-0 top-2 z-30 flex justify-center",
                                  "type": "box"
                                },
                                null
                              ]
                            ],
                            "className": "relative h-full",
                            "type": "box"
                          },
                          "rail": [
                            "if",
                            "@config.showRail",
                            "@config.railTrait",
                            null
                          ],
                          "secondarySidebar": [
                            "if",
                            "@config.showSecondarySidebar",
                            "@config.secondarySidebarTrait",
                            null
                          ],
                          "secondarySidebarIcon": "@config.secondarySidebarIcon",
                          "secondarySidebarLabel": "@config.secondarySidebarLabel",
                          "secondarySidebarWidth": "@config.secondarySidebarWidth",
                          "sidebar": [
                            "if",
                            "@config.showSidebar",
                            "@config.sidebarTrait",
                            null
                          ],
                          "sidebarMinSize": "@config.sidebarMinSize",
                          "statusBar": [
                            "if",
                            "@config.showStatusBar",
                            "@config.statusBarTrait",
                            null
                          ],
                          "type": "dock-layout"
                        }
                      ],
                      "className": "h-full min-h-0",
                      "direction": "vertical",
                      "gap": "none",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M4GT9VY4QY9FYX4TCX5F544R",
                "from": "composing",
                "to": "composing"
              }
            ]
          },
          "traitEmbedIds": {
            "EmptyRegion": "trt_01M4GT9VY4SME969P428HZ9X6K"
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}