          "emits": [
            {
              "description": "Mode + caret instruction for the editor surface (bar | block). Also the fact a realization reads to drive a mode indicator.",
              "event": "SET_MODE",
              "eventId": "evt_01M1N9RFGVZNP12BFQMJPA2SWD",
              "payloadSchema": [
                {
                  "name": "editorId",
                  "type": "string"
                },
                {
                  "name": "mode",
                  "type": "string"
                },
                {
                  "name": "caret",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "primary"
            },
            {
              "description": "Move the caret (or extend the selection in VISUAL) by a closed motion name, `count` times.",
              "event": "MOTION",
              "eventId": "evt_01M1N9RFGV1D58J57GNQA2X8Z9",
              "payloadSchema": [
                {
                  "name": "editorId",
                  "type": "string"
                },
                {
                  "name": "motion",
                  "type": "string"
                },
                {
                  "name": "count",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "primary"
            },
            {
              "description": "Apply a config-declared operator (delete | yank | change | put | put-before | undo | redo | join | toggle-case | indent | dedent | replace) over the range a motion describes; `line` for doubled operators, `selection` in VISUAL, and a fixed `right` placeholder for the point operators (put | put-before | undo | redo) which the editor ignores.",
              "event": "OPERATE",
              "eventId": "evt_01M1N9RFGVV28SH1SVXFJ7X9XY",
              "payloadSchema": [
                {
                  "name": "editorId",
                  "type": "string"
                },
                {
                  "name": "operator",
                  "type": "string"
                },
                {
                  "name": "motion",
                  "type": "string"
                },
                {
                  "name": "count",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "primary"
            },
            {
              "description": "Insert literal text at the caret (e.g. the newline `o`/`O` insert before entering INSERT, or the replacement char `r` inserts).",
              "event": "INSERT_TEXT",
              "eventId": "evt_01M1N9RFGVR67GHR554ZYYYN7F",
              "payloadSchema": [
                {
                  "name": "editorId",
                  "type": "string"
                },
                {
                  "name": "text",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "secondary"
            },
            {
              "description": "A buffered ':' line resolved through config.exCommands. `name` is a neutral config-declared string; a realization maps it onto its host's command vocabulary.",
              "event": "EX_COMMAND",
              "eventId": "evt_01M1N9RFGVVTJX76Y9V7M6TWFT",
              "payloadSchema": [
                {
                  "name": "editorId",
                  "type": "string"
                },
                {
                  "name": "name",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "secondary"
            }
          ],
          "entityContract": {
            "provides": [
              "cmdline",
              "count",
              "editorId",
              "lastCount",
              "lastMotion",
              "lastOperator",
              "operator",
              "operatorKey"
