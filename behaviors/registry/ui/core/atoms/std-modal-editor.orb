          "linkedEntityId": "ent_01M1N9RFGVPGR86MHTEQC9T0HK",
          "name": "Modes",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M1N9S6G5JM3N66C9QE54J32Y",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "One physical keydown, delivered by the host's keyboard router. The host decides preventDefault from config.keymap; this trait only reads key + editorId.",
                "id": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "key": "KEY",
                "name": "Key",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "key",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "ctrl",
                    "type": "boolean"
                  },
                  {
                    "name": "alt",
                    "type": "boolean"
                  },
                  {
                    "name": "shift",
                    "type": "boolean"
                  },
                  {
                    "name": "meta",
                    "type": "boolean"
                  },
                  {
                    "name": "repeat",
                    "type": "boolean"
                  }
                ]
              },
              {
                "description": "Mode + caret instruction for the editor surface (bar | block). Also the fact a realization reads to drive a mode indicator.",
                "id": "evt_01M1N9RFGVZNP12BFQMJPA2SWD",
                "key": "SET_MODE",
                "name": "Set Mode",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "mode",
                    "type": "string"
                  },
                  {
                    "name": "caret",
                    "type": "string"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "Move the caret (or extend the selection in VISUAL) by a closed motion name, `count` times.",
                "id": "evt_01M1N9RFGV1D58J57GNQA2X8Z9",
                "key": "MOTION",
                "name": "Motion",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "motion",
                    "type": "string"
                  },
                  {
                    "name": "count",
                    "type": "number"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "Apply a config-declared operator (delete | yank | change) over the range a motion describes; `line` for doubled operators, `selection` in VISUAL.",
                "id": "evt_01M1N9RFGVV28SH1SVXFJ7X9XY",
                "key": "OPERATE",
                "name": "Operate",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "operator",
                    "type": "string"
                  },
                  {
                    "name": "motion",
                    "type": "string"
                  },
                  {
                    "name": "count",
                    "type": "number"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "Insert literal text at the caret (e.g. the newline `o` opens before entering INSERT).",
                "id": "evt_01M1N9RFGVR67GHR554ZYYYN7F",
                "key": "INSERT_TEXT",
                "name": "Insert Text",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "text",
                    "type": "string"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "A buffered ':' line resolved through config.exCommands. `name` is a neutral config-declared string; a realization maps it onto its host's command vocabulary.",
                "id": "evt_01M1N9RFGVVTJX76Y9V7M6TWFT",
                "key": "EX_COMMAND",
                "name": "Ex Command",
                "payloadSchema": [
                  {
                    "name": "editorId",
                    "type": "string"
                  },
                  {
                    "name": "name",
                    "type": "string"
                  }
                ],
                "tier": "secondary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "NORMAL"
              },
              {
                "name": "INSERT"
              },
              {
                "name": "VISUAL"
              },
              {
                "name": "OPERATOR_PENDING"
              },
              {
                "name": "COMMAND"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.count",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M1N9S6G5JM3N66C9QE54J32Y",
                "from": "NORMAL",
                "to": "NORMAL"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
                    "@payload.editorId"
                  ],
                  [
                    "set",
                    "@entity.count",
                    0.0
                  ],
                  [
                    "emit",
                    "SET_MODE",
                    {
                      "caret": "bar",
                      "editorId": "@payload.editorId",
                      "mode": "INSERT"
                    }
                  ]
                ],
                "event": "KEY",
                "eventId": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "from": "NORMAL",
                "guard": [
                  "=",
                  "@payload.key",
                  "@config.insertKey"
                ],
                "to": "INSERT"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
                    "@payload.editorId"
                  ],
                  [
                    "set",
                    "@entity.count",
                    0.0
                  ],
                  [
                    "emit",
                    "MOTION",
                    {
                      "count": 1.0,
                      "editorId": "@payload.editorId",
                      "motion": "right"
                    }
                  ],
                  [
                    "emit",
                    "SET_MODE",
                    {
                      "caret": "bar",
                      "editorId": "@payload.editorId",
                      "mode": "INSERT"
                    }
                  ]
                ],
                "event": "KEY",
                "eventId": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "from": "NORMAL",
                "guard": [
                  "=",
                  "@payload.key",
                  "@config.appendKey"
                ],
                "to": "INSERT"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
                    "@payload.editorId"
                  ],
                  [
                    "set",
                    "@entity.count",
                    0.0
                  ],
                  [
                    "emit",
                    "MOTION",
                    {
                      "count": 1.0,
                      "editorId": "@payload.editorId",
                      "motion": "line-end"
                    }
                  ],
                  [
                    "emit",
                    "INSERT_TEXT",
                    {
                      "editorId": "@payload.editorId",
                      "text": "\n"
                    }
                  ],
                  [
                    "emit",
                    "SET_MODE",
                    {
                      "caret": "bar",
                      "editorId": "@payload.editorId",
                      "mode": "INSERT"
                    }
                  ]
                ],
                "event": "KEY",
                "eventId": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "from": "NORMAL",
                "guard": [
                  "=",
                  "@payload.key",
                  "@config.openLineKey"
                ],
                "to": "INSERT"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
                    "@payload.editorId"
                  ],
                  [
                    "emit",
                    "SET_MODE",
                    {
                      "caret": "block",
                      "editorId": "@payload.editorId",
                      "mode": "VISUAL"
                    }
                  ]
                ],
                "event": "KEY",
                "eventId": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "from": "NORMAL",
                "guard": [
                  "=",
                  "@payload.key",
                  "@config.visualKey"
                ],
                "to": "VISUAL"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
                    "@payload.editorId"
                  ],
                  [
                    "set",
                    "@entity.cmdline",
                    ""
                  ],
                  [
                    "emit",
                    "SET_MODE",
                    {
                      "caret": "block",
                      "editorId": "@payload.editorId",
                      "mode": "COMMAND"
                    }
                  ]
                ],
                "event": "KEY",
                "eventId": "evt_01M1N9RFGVK31M3ZE4N9FBHBWM",
                "from": "NORMAL",
                "guard": [
                  "=",
                  "@payload.key",
                  "@config.commandKey"
                ],
                "to": "COMMAND"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.editorId",
