                        "name": "type",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "content",
                        "type": "string"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "show, launch, reveal, edit",
                "tier": "domain"
              },
              {
                "description": "Hands the editor a row that was just created as a blank draft: same payload as OPEN, but the body opens straight in the authoring editor instead of the read-only render, so a document-first 'New page' lands the author on a cursor rather than an empty state.",
                "id": "evt_01M0V8PKKCFSDSHTNFP08BMS5M",
                "key": "OPEN_DRAFT",
                "name": "Open Draft",
                "payloadSchema": [
