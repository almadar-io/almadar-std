          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0RYEW8QVYV5E4942Q3VFZZK",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Hands the editor the row whose body it renders — the caller supplies the row's id and current blocks, since this trait never fetches them itself. Re-firing it repaints the body (e.g. after the host refetches a saved row).",
                "id": "evt_01M0RYEW8Q7JPMVH9BJQ274WXR",
                "key": "OPEN",
                "name": "Open",
                "payloadSchema": [
                  {
                    "name": "id",
