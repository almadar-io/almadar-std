                        "name": "content",
                        "type": "string"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ],
                    "type": "[object]"
                  }
                ],
                "synonyms": "new document, start writing, blank draft, compose",
                "tier": "domain"
              },
