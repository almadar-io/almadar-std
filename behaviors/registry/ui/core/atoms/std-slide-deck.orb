  },
  "name": "std-slide-deck",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "default": 0.0,
            "description": "Zero-based index of the slide currently shown.",
            "name": "slideIndex",
            "synonyms": "current slide, cursor, position",
            "type": "number"
          }
        ],
        "id": "ent_01M39MPG8EZJMEW9YAGD6SNM0W",
        "name": "SlideDeck",
        "persistence": "runtime"
      },
      "id": "orb_01M39MPG8E8DBNC6ZS0E5S2YBZ",
      "name": "SlideDeckOrbital",
      "pages": [
        {
          "id": "pag_01M39MPG8E6BFGAGMXQDWVEWFH",
          "name": "SlideDeckPage",
          "path": "/slide-deck",
          "traits": [
            {
              "ref": "SlideDeckPresenter",
              "refId": "trt_01M39MPG8EP9R7YFMP1RDHRZ23"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "bodyContent": {
              "default": {
                "children": [
                  {
                    "align": "center",
                    "children": [
                      [
                        "array/map",
                        [
                          [
                            "array/len",
                            "@config.slides"
                          ]
                        ],
                        [
                          "fn",
                          "n",
                          [
                            "if",
                            "@config.showArrows",
                            {
                              "action": "GO_TO",
                              "actionPayload": {
                                "index": [
                                  "if",
                                  "@config.loop",
                                  [
                                    "math/wrap",
                                    [
                                      "-",
                                      "@entity.slideIndex",
                                      1.0
                                    ],
                                    0.0,
                                    "@n"
                                  ],
                                  [
                                    "math/max",
                                    0.0,
                                    [
                                      "-",
                                      "@entity.slideIndex",
                                      1.0
                                    ]
                                  ]
                                ]
                              },
                              "disabled": [
                                "and",
                                [
                                  "==",
                                  "@config.loop",
                                  false
                                ],
                                [
                                  "<=",
                                  "@entity.slideIndex",
                                  0.0
                                ]
                              ],
                              "icon": "@config.prevIcon",
                              "size": "lg",
                              "type": "button",
                              "variant": "ghost"
                            },
                            null
                          ]
                        ]
                      ],
                      {
                        "children": [
                          "array/map",
                          [
                            "@entity.slideIndex"
                          ],
                          [
                            "fn",
                            "i",
                            {
                              "children": [
                                [
                                  "array/nth",
                                  "@config.slides",
                                  "@i"
                                ]
                              ],
                              "className": "w-full",
                              "type": "box"
                            }
                          ]
                        ],
                        "className": "flex-1 min-w-0",
                        "minHeight": "@config.stageMinHeight",
                        "type": "center"
                      },
                      [
                        "array/map",
                        [
                          [
                            "array/len",
                            "@config.slides"
                          ]
                        ],
                        [
                          "fn",
                          "n",
                          [
                            "if",
                            "@config.showArrows",
                            {
                              "action": "GO_TO",
                              "actionPayload": {
                                "index": [
                                  "if",
                                  "@config.loop",
                                  [
                                    "math/wrap",
                                    [
                                      "+",
                                      "@entity.slideIndex",
                                      1.0
                                    ],
                                    0.0,
                                    "@n"
                                  ],
                                  [
                                    "math/min",
                                    [
                                      "-",
                                      "@n",
                                      1.0
                                    ],
                                    [
                                      "+",
                                      "@entity.slideIndex",
                                      1.0
                                    ]
                                  ]
                                ]
                              },
                              "disabled": [
                                "and",
                                [
                                  "==",
                                  "@config.loop",
                                  false
                                ],
                                [
                                  ">=",
                                  "@entity.slideIndex",
                                  [
                                    "-",
                                    "@n",
                                    1.0
                                  ]
                                ]
                              ],
                              "icon": "@config.nextIcon",
                              "size": "lg",
                              "type": "button",
                              "variant": "ghost"
                            },
                            null
                          ]
                        ]
                      ]
                    ],
                    "direction": "horizontal",
                    "gap": "md",
                    "type": "stack"
                  },
                  [
                    "if",
                    "@config.showProgress",
                    {
                      "align": "center",
                      "children": [
                        "array/map",
                        [
                          [
                            "array/len",
                            "@config.slides"
                          ]
                        ],
                        [
                          "fn",
                          "n",
                          {
                            "align": "center",
                            "children": [
                              {
                                "count": "@n",
                                "currentIndex": "@entity.slideIndex",
                                "onDotClick": "GO_TO",
                                "size": "sm",
                                "type": "progress-dots"
                              },
                              {
                                "color": "muted",
                                "content": [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.slideIndex",
                                    1.0
                                  ],
                                  " / ",
                                  "@n"
                                ],
                                "type": "typography",
                                "variant": "caption"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "md",
                            "type": "stack"
                          }
                        ]
                      ],
                      "direction": "horizontal",
                      "gap": "md",
                      "justify": "center",
                      "type": "stack"
                    },
                    null
                  ]
                ],
                "className": "w-full",
                "direction": "vertical",
                "gap": "md",
                "type": "stack"
              },
              "description": "Render-ui tree for the deck. Default: slide centred between previous/next arrows, dot strip and counter below. A realization overrides this to restyle (full-bleed, bottom bar, no chrome) while keeping the same cursor, keys and emits.",
              "label": "Body content tree",
              "tier": "internal",
              "type": "render-ui"
            },
            "loop": {
              "default": false,
              "description": "Wrap from the last slide to the first (and back) instead of stopping at either end.",
              "label": "Loop",
              "tier": "presentation",
              "type": "boolean"
            },
            "nextIcon": {
              "default": "chevron-right",
              "label": "Next icon",
              "tier": "presentation",
              "type": "icon"
            },
            "prevIcon": {
              "default": "chevron-left",
              "label": "Previous icon",
              "tier": "presentation",
              "type": "icon"
            },
            "showArrows": {
              "default": true,
              "description": "Previous/next buttons on the left and right of the slide.",
              "label": "Show arrows",
              "tier": "presentation",
              "type": "boolean"
            },
            "showProgress": {
              "default": true,
              "description": "Dot strip and k / n counter under the slide; dots jump to their slide.",
              "label": "Show progress",
              "tier": "presentation",
              "type": "boolean"
            },
            "slides": {
              "default": [],
              "description": "Ordered slide nodes; each entry is a render tree or a @trait reference and is shown one at a time.",
              "items": {
                "type": "trait"
              },
              "label": "Slides",
              "tier": "domain",
              "type": "[trait]"
            },
            "stageMinHeight": {
              "default": "70vh",
              "description": "Minimum height of the slide stage (any CSS length, e.g. 70vh or 640px); the slide is centred vertically inside it so short and tall slides share one frame.",
              "label": "Stage height",
              "tier": "presentation",
              "type": "string"
            },
            "startIndex": {
              "default": 0.0,
              "description": "Zero-based slide shown on first render; clamped to the deck.",
              "label": "Start slide",
              "tier": "presentation",
              "type": "number"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "SLIDE_CHANGED"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            },
            {
              "kind": "set",
              "resource": "@entity.slideIndex"
            }
          ],
          "emits": [
            {
              "description": "The deck moved to a new slide (zero-based index).",
              "event": "SLIDE_CHANGED",
              "eventId": "evt_01M39MPG8EDQH4W0H47M0BDFY3",
              "payloadSchema": [
                {
                  "name": "index",
                  "required": true,
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "slide shown, advanced, went back",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "slideIndex"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SlideDeck": "ent_01M39MPG8EZJMEW9YAGD6SNM0W"
          },
          "id": "trt_01M39MPG8EP9R7YFMP1RDHRZ23",
          "linkedEntity": "SlideDeck",
          "linkedEntityId": "ent_01M39MPG8EZJMEW9YAGD6SNM0W",
          "name": "SlideDeckPresenter",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M39MPG8ER5ADZA6BZSQZ3GC3",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Show a zero-based slide index. The arrows and dots send the already-bounded target; a remote or table of contents can send any index.",
                "id": "evt_01M39MPG8EJYM25W3QY1BGRDRF",
                "key": "GO_TO",
                "name": "Go To",
                "payloadSchema": [
                  {
                    "name": "index",
                    "required": true,
                    "type": "number"
                  }
                ],
                "synonyms": "jump, seek, next slide, previous slide, select slide",
                "tier": "domain"
              },
              {
                "description": "The deck moved to a new slide (zero-based index).",
                "id": "evt_01M39MPG8EDQH4W0H47M0BDFY3",
                "key": "SLIDE_CHANGED",
                "name": "Slide Changed",
                "payloadSchema": [
                  {
                    "name": "index",
                    "required": true,
                    "type": "number"
                  }
                ],
                "synonyms": "slide shown, advanced, went back",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "presenting"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.slideIndex",
                    "@config.startIndex"
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.bodyContent"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M39MPG8ER5ADZA6BZSQZ3GC3",
                "from": "presenting",
                "to": "presenting"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.slideIndex",
                    "@payload.index"
                  ],
                  [
                    "emit",
                    "SLIDE_CHANGED",
                    {
                      "index": "@entity.slideIndex"
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    "@config.bodyContent"
                  ]
                ],
                "event": "GO_TO",
                "eventId": "evt_01M39MPG8EJYM25W3QY1BGRDRF",
                "from": "presenting",
                "to": "presenting"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}