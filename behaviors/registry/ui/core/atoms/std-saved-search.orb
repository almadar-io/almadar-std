                              [
                                "or",
                                [
                                  "=",
                                  [
                                    "array/len",
                                    [
                                      "object/get",
                                      "@action",
                                      "roles",
                                      []
                                    ]
                                  ],
                                  0.0
                                ],
                                [
                                  "array/includes",
                                  [
                                    "object/get",
                                    "@action",
                                    "roles",
                                    []
                                  ],
                                  "@config.viewerRole"
                                ]
                              ]
                            ]
                          ],
                          "itemClickEvent": "@config.itemClickEvent",
                          "look": "@config.tableLook",
