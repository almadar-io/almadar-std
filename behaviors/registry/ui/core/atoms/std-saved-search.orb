                      ],
                      [
                        "object/omit",
                        "@entity.filters",
                        [
                          "@payload.field"
                        ]
                      ],
                      [
                        "object/set",
                        "@entity.filters",
                        "@payload.field",
                        "@payload.value"
                      ]
                    ]
