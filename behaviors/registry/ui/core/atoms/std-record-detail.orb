          },
          "id": "trt_01M11G7GKT47CAAQ530NWE10AQ",
          "linkedEntity": "RecordItem",
          "linkedEntityId": "ent_01M11G7GKTBPP8VHM2QHYFXK9A",
          "name": "RecordItemDetail",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "description": "Opens the detail surface for the record with this id.",
                "id": "evt_01M11G7GKTQS53CSYF3WN812EB",
                "key": "INIT",
                "name": "Initialize",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "synonyms": "open record, view record, show details, drill in",
                "tier": "domain"
              },
              {
                "description": "A row was opened from a list; shows that record in this surface.",
                "id": "evt_01M11JRVVZSRPRJG40FASZ2Q9H",
                "key": "OPEN_VIEW",
                "name": "Open View",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "row",
                    "type": "RecordItem"
                  }
                ],
                "synonyms": "open record, view row, show details, drill in, expand",
                "tier": "domain"
              },
              {
                "description": "Signals that the record has been successfully loaded.",
                "id": "evt_01M11G7GKTPSHKRVR2KJCCXH83",
                "key": "RecordItemLoaded",
                "name": "RecordItem loaded",
                "payloadSchema": [
                  {
                    "name": "data",
                    "type": "RecordItem"
                  },
                  {
                    "name": "totalCount",
                    "type": "number"
                  }
                ],
                "synonyms": "loaded, received, ready, fetched",
                "tier": "domain"
              },
              {
                "description": "Indicates a failure to load the record.",
                "id": "evt_01M11G7GKTW27F8E4B51MZXT3J",
                "key": "RecordItemLoadFailed",
                "name": "RecordItem load failed",
                "payloadSchema": [
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "code",
                    "type": "string"
                  }
                ],
                "synonyms": "error, failed, problem, unsuccessful",
                "tier": "internal"
              },
              {
                "description": "Closes the record surface and returns it to blank.",
                "id": "evt_01M11JRVVZ5NTTZVC714X45YET",
                "key": "CLOSE_VIEW",
                "name": "Close View",
                "synonyms": "close, dismiss, back to list",
                "tier": "domain"
              },
              {
                "description": "Re-runs the fetch after a failed load.",
                "id": "evt_01M11G7GKT3BDT1MGPXJQ3AZPK",
                "key": "RETRY",
                "name": "Retry",
                "synonyms": "try again, reload, refresh",
                "tier": "domain"
              },
              {
                "description": "Signals a request to edit the record being viewed.",
                "id": "evt_01M11G7GKT2W4J3T30YBM3SFZV",
                "key": "EDIT",
                "name": "Edit",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "row",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "name",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "description",
                        "type": "string"
                      },
                      {
                        "name": "status",
                        "type": "string"
                      },
                      {
                        "name": "createdAt",
                        "type": "string"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "synonyms": "modify, update, change",
                "tier": "domain"
              },
              {
                "description": "Signals a request to remove the record being viewed.",
                "id": "evt_01M11G7GKTCPVY3J7BKGBCXK3T",
                "key": "DELETE",
                "name": "Delete",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "row",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "name",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "description",
                        "type": "string"
                      },
                      {
                        "name": "status",
                        "type": "string"
                      },
                      {
                        "name": "createdAt",
                        "type": "string"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "synonyms": "remove, discard, delete, archive",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "loading"
              },
              {
                "name": "viewing"
              },
              {
                "name": "error"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    "@payload.id"
                  ],
                  [
                    "fetch",
                    "RecordItem",
                    {
                      "emit": {
                        "failure": "RecordItemLoadFailed",
                        "success": "RecordItemLoaded"
                      },
                      "id": "@payload.id",
                      "include": "@config.include"
                    }
                  ],
                  [
                    "render-ui",
