          "name": "ImagePage",
          "path": "/image",
          "traits": [
            {
              "ref": "ImageRender",
              "refId": "trt_01M3B9EJRVJ3PV030R5JEMFZHF"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "alt": {
              "default": "",
              "description": "Alternative text; empty string marks the image decorative",
              "label": "Alt",
              "tier": "presentation",
              "type": "string"
            },
            "aspect": {
              "default": "auto",
              "description": "Fixed aspect ratio of the box; 'auto' keeps the image's own",
              "label": "Aspect",
              "tier": "presentation",
              "type": "string",
              "values": [
                "auto",
                "1/1",
                "4/3",
                "3/2",
                "16/9",
                "21/9"
              ]
            },
            "bordered": {
              "default": false,
              "description": "Draw a subtle border around the image",
              "label": "Bordered",
              "tier": "presentation",
              "type": "boolean"
            },
            "className": {
              "description": "Additional class names",
              "label": "Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "fit": {
              "default": "cover",
              "description": "How the image fills its box",
              "label": "Fit",
              "tier": "presentation",
              "type": "string",
              "values": [
                "cover",
                "contain",
                "fill",
                "none"
              ]
            },
            "loading": {
              "default": "lazy",
              "description": "'lazy' defers off-screen images; 'eager' for above-the-fold media",
              "label": "Loading",
              "tier": "presentation",
              "type": "string",
              "values": [
                "lazy",
                "eager"
              ]
            },
            "rounded": {
              "default": "md",
              "description": "Corner rounding",
              "label": "Rounded",
              "tier": "presentation",
              "type": "string",
              "values": [
                "none",
                "sm",
                "md",
                "lg",
                "xl",
                "2xl",
                "full"
              ]
            },
            "src": {
              "default": "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png",
              "description": "Image source URL",
              "label": "Src",
              "tier": "presentation",
              "type": "asset"
            }
          },
          "effectRow": [
            {
              "kind": "render-ui",
              "resource": "main"
            }
          ],
          "entityContract": {
            "provides": [],
            "requires": []
          },
          "entityRebindable": true,
