  "name": "ui-image",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "id": "ent_01M3B9EJRVD1GE04YQ01DXEZ64",
        "name": "ImageItem",
