          "id": "trt_01M3B9EJRVJ3PV030R5JEMFZHF",
          "linkedEntity": "ImageItem",
          "linkedEntityId": "ent_01M3B9EJRVD1GE04YQ01DXEZ64",
          "name": "ImageRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3B9EJRVRA3GVZW73V05MC7V",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "alt": "@config.alt",
                      "aspect": "@config.aspect",
                      "bordered": "@config.bordered",
                      "className": "@config.className",
                      "fit": "@config.fit",
                      "loading": "@config.loading",
                      "rounded": "@config.rounded",
                      "src": "@config.src",
                      "type": "image"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3B9EJRVRA3GVZW73V05MC7V",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
