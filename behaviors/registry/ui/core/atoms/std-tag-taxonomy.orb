                      ],
                      "className": "py-12",
                      "direction": "vertical",
                      "gap": "md",
                      "type": "stack"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG04HRHZ7R8AVV6NCG6FC0S",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "action": "SHOW_ROOT",
                          "disabled": [
                            "if",
                            [
                              "!=",
                              "@entity.id",
