                "to": "loading"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.id",
                    ""
                  ],
                  [
                    "set",
                    "@entity.parentId",
                    ""
                  ],
                  [
                    "fetch",
                    "Tag",
                    {
                      "emit": {
