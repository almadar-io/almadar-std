                  "name": "tagId",
                  "required": true,
                  "type": "string"
                }
              ],
              "synonyms": "chosen, picked, activated, highlighted",
              "tier": "domain"
            },
            {
              "description": "Opens the create-tag form (rendered only when allowEdit is on); the creation lands at the level currently open.",
              "event": "NEW_TAG",
