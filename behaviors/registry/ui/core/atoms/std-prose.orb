              "tier": "presentation",
              "type": "string"
            },
            "direction": {
              "default": "ltr",
              "label": "Text direction",
              "tier": "presentation",
              "type": "string",
              "values": [
                "ltr",
                "rtl"
              ]
            },
            "eyebrow": {
              "default": "",
              "description": "Small badge above the heading; empty hides it",
              "label": "Eyebrow",
              "tier": "presentation",
              "type": "string"
            },
            "heading": {
              "default": "",
              "description": "Empty hides it",
              "label": "Heading",
              "synonyms": "title",
              "tier": "presentation",
              "type": "string"
            },
            "meta": {
              "default": "",
              "description": "Date, author or reading time under the heading; empty hides it",
              "label": "Meta line",
              "synonyms": "byline, date, author",
              "tier": "presentation",
              "type": "string"
            },
