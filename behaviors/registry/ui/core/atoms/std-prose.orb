          "stateMachine": {
            "events": [
              {
                "id": "evt_01M3B9EHP8VM4CPFKCBQEMWVH8",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "bg": [
                        "if",
                        [
                          "==",
                          "@config.surface",
                          "muted"
                        ],
                        "muted",
                        "transparent"
                      ],
                      "children": [
                        {
                          "children": [
                            {
                              "children": [
                                {
                                  "label": "@config.eyebrow",
                                  "type": "badge",
                                  "variant": "primary"
                                },
                                {
                                  "className": [
                                    "if",
                                    [
                                      "==",
                                      "@config.heading",
                                      ""
                                    ],
                                    "hidden",
                                    "tracking-tight text-balance"
                                  ],
                                  "content": "@config.heading",
                                  "type": "typography",
                                  "variant": "h2",
                                  "weight": "bold"
                                },
                                {
                                  "className": [
                                    "if",
                                    [
                                      "==",
                                      "@config.meta",
                                      ""
                                    ],
                                    "hidden",
                                    ""
                                  ],
                                  "color": "muted",
                                  "content": "@config.meta",
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "content": "@config.body",
                                  "direction": "@config.direction",
                                  "type": "markdown-content"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            }
                          ],
                          "maxWidth": "md",
                          "padding": "lg",
                          "size": "md",
                          "type": "container"
                        }
                      ],
                      "dir": "@config.direction",
                      "fullWidth": true,
                      "paddingY": "xl",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M3B9EHP8VM4CPFKCBQEMWVH8",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
