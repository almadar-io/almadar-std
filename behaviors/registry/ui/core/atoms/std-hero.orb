              "tier": "presentation",
              "type": "string"
            },
            "headline": {
              "default": "Build what you mean",
              "description": "Main headline",
              "label": "Headline",
              "synonyms": "title, heading",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": "auto",
              "description": "auto fits the copy; tall fills most of the screen with the copy centred, for a hero over a backdrop scene",
              "label": "Height",
              "tier": "presentation",
              "type": "string",
              "values": [
                "auto",
                "tall"
              ]
            },
            "illustration": {
              "default": "",
              "description": "Inline SVG shown beside or below the copy instead of the media image; empty uses the media image",
              "label": "Illustration",
              "synonyms": "artwork, graphic, drawing, svg",
              "tier": "presentation",
              "type": "string"
            },
            "illustrationContent": {
              "default": {
                "alt": "",
                "animate": true,
                "animation": "draw",
                "height": [
                  "if",
                  [
                    "==",
                    "@config.look",
                    "header"
