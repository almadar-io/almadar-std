      "traits": [
        {
          "category": "interaction",
          "config": {
            "alignment": {
              "default": "center",
              "description": "Center the copy, or align it to the start edge",
              "label": "Alignment",
              "tier": "presentation",
              "type": "string",
              "values": [
                "center",
                "start"
              ]
            },
            "backdropContent": {
              "default": {
                "className": "hidden",
                "type": "box"
              },
              "description": "A scene behind the whole block, such as an animated canvas; it fills the block, never takes clicks, and the copy stays on top. Empty by default.",
              "label": "Backdrop",
              "tier": "presentation",
              "type": "render-ui"
            },
            "backgroundPosition": {
              "default": "center",
              "description": "Which part of the photo stays visible when it is cropped",
              "label": "Background photo focus",
              "tier": "presentation",
              "type": "string",
              "values": [
                "center",
                "top",
                "bottom",
                "left",
                "right"
              ]
            },
            "backgroundSrc": {
              "default": "",
              "description": "Photo URL filling the block behind the copy when the surface is image",
              "label": "Background photo",
              "synonyms": "background image, hero photo, cover photo",
              "tier": "presentation",
              "type": "string"
            },
            "command": {
              "default": "",
              "description": "A shell command shown in a copyable code box under the actions, e.g. an install one-liner; empty hides it",
              "label": "Command",
              "synonyms": "install command, cli, terminal snippet",
              "tier": "presentation",
              "type": "string"
            },
            "copyContent": {
              "default": {
                "align": [
                  "if",
                  [
                    "==",
                    "@config.alignment",
                    "center"
                  ],
                  "center",
                  "start"
                ],
                "children": [
                  {
                    "label": "@config.eyebrow",
                    "size": "md",
                    "type": "badge",
                    "variant": "primary"
                  },
                  {
                    "align": [
                      "if",
                      [
                        "==",
                        "@config.alignment",
                        "center"
                      ],
                      "center",
                      "left"
                    ],
                    "className": "tracking-tight text-balance",
                    "content": "@config.headline",
                    "type": "typography",
                    "variant": [
                      "if",
                      [
                        "==",
                        "@config.look",
                        "hero"
                      ],
                      "h1",
                      "h2"
                    ],
                    "weight": "bold"
                  },
                  {
                    "align": [
                      "if",
                      [
                        "==",
                        "@config.alignment",
                        "center"
                      ],
                      "center",
                      "left"
                    ],
                    "className": [
                      "if",
                      [
                        "==",
                        "@config.lede",
                        ""
                      ],
                      "hidden",
                      "max-w-2xl text-pretty"
                    ],
                    "color": [
                      "if",
                      [
                        "==",
                        "@config.look",
                        "header"
                      ],
                      "primary",
                      "muted"
                    ],
                    "content": "@config.lede",
                    "type": "typography",
                    "variant": "large"
                  },
                  {
                    "children": [
                      {
                        "action": "HERO_PRIMARY",
                        "actionPayload": {
                          "href": "@config.primaryHref"
                        },
                        "className": [
                          "if",
                          [
                            "==",
                            "@config.primaryLabel",
                            ""
                          ],
                          "hidden",
                          ""
                        ],
                        "href": "@config.primaryHref",
                        "label": "@config.primaryLabel",
                        "size": "lg",
                        "type": "button",
                        "variant": "primary"
                      },
                      {
                        "action": "HERO_SECONDARY",
                        "actionPayload": {
                          "href": "@config.secondaryHref"
                        },
                        "className": [
                          "if",
                          [
                            "==",
                            "@config.secondaryLabel",
                            ""
                          ],
                          "hidden",
                          ""
                        ],
                        "href": "@config.secondaryHref",
                        "label": "@config.secondaryLabel",
                        "size": "lg",
                        "type": "button",
                        "variant": "secondary"
                      }
                    ],
                    "className": [
                      "if",
                      [
                        "==",
                        "@config.primaryLabel",
                        ""
                      ],
                      [
                        "if",
                        [
                          "==",
                          "@config.secondaryLabel",
                          ""
                        ],
                        "hidden",
                        "pt-2"
                      ],
                      "pt-2"
                    ],
                    "direction": "horizontal",
                    "gap": "md",
                    "justify": [
                      "if",
                      [
                        "==",
                        "@config.alignment",
                        "center"
                      ],
                      "center",
                      "start"
                    ],
                    "type": "stack",
                    "wrap": true
                  },
                  {
                    "children": [
                      {
                        "code": "@config.command",
                        "language": "bash",
                        "showCopyButton": true,
                        "showLanguageBadge": false,
                        "type": "code-block"
                      }
                    ],
                    "className": [
                      "if",
                      [
                        "==",
                        "@config.command",
                        ""
                      ],
                      "hidden",
                      "max-w-xl"
                    ],
                    "fullWidth": true,
                    "type": "box"
                  }
                ],
                "direction": "vertical",
                "gap": "lg",
                "type": "stack"
              },
              "label": "Copy block",
              "tier": "internal",
              "type": "render-ui"
            },
            "edgeBottom": {
              "default": "none",
              "description": "Shape cut into the bottom of the block; curve uses the theme's shape",
