              "label": "Supporting text",
              "synonyms": "subtitle, subheading, description, tagline",
              "tier": "presentation",
              "type": "string"
            },
            "look": {
              "default": "hero",
              "description": "hero = full-width page opener with an h1; banner = contained call-to-action card with an h2; header = compact opener at the top of an app page",
              "label": "Look",
              "synonyms": "cta banner, call to action, callout, page header, masthead",
              "tier": "presentation",
