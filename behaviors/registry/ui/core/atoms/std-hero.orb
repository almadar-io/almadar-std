                ],
                "direction": "vertical",
                "gap": "lg",
                "type": "stack"
              },
              "label": "Copy block",
              "tier": "internal",
              "type": "render-ui"
            },
            "eyebrow": {
              "default": "",
              "description": "Small badge above the headline; empty hides it",
