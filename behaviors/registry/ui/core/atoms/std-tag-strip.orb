              {
                "description": "The record's tag set changed (chip added or removed); the host routes this into its persistor's update so the write and the refetch stay the organism's.",
                "id": "evt_01M1780JG2YCC9VE2N8D4D2KG1",
                "key": "TAGS_CHANGED",
