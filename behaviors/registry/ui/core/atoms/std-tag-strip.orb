              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "loading"
              },
              {
                "name": "ready"
              },
              {
                "name": "adding"
              },
              {
                "name": "creating"
              },
              {
                "name": "removing"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "fetch",
                    "StripTag",
                    {
                      "emit": {
                        "failure": "TagStripLoadFailed",
                        "success": "TagStripOptions"
                      }
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M1780JG2Y18SGMQG35H6DZQD",
                "from": "idle",
                "to": "idle"
              },
              {
                "event": "TagStripOptions",
                "eventId": "evt_01M1780JG23PP1ZZCKDT50N36S",
                "from": "idle",
                "to": "idle"
              },
              {
                "event": "TagStripLoadFailed",
                "eventId": "evt_01M1780JG2V44SG4PT280FRXM5",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.docId",
                    "@payload.id"
                  ],
                  [
                    "set",
                    "@entity.docTagIds",
                    [
                      "array/map",
                      "@payload.tagIds",
                      [
                        "fn",
                        "t",
                        [
                          "str/default",
                          [
                            "object/get",
                            "@t",
                            "id"
                          ],
                          "@t"
                        ]
                      ]
                    ]
                  ],
                  [
                    "fetch",
                    "StripTag",
                    {
                      "emit": {
                        "failure": "TagStripLoadFailed",
                        "success": "TagStripOptions"
                      }
                    }
                  ]
                ],
                "event": "SHOW_TAG_STRIP",
                "eventId": "evt_01M1780JG2FY7B6BJ5DBV4GZB1",
                "from": "idle",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.docId",
                    "@payload.id"
                  ],
                  [
                    "set",
                    "@entity.docTagIds",
                    [
                      "array/map",
                      "@payload.tagIds",
                      [
                        "fn",
                        "t",
                        [
                          "str/default",
                          [
                            "object/get",
                            "@t",
                            "id"
                          ],
                          "@t"
                        ]
                      ]
                    ]
                  ],
                  [
                    "fetch",
                    "StripTag",
                    {
                      "emit": {
                        "failure": "TagStripLoadFailed",
                        "success": "TagStripOptions"
                      }
                    }
                  ]
                ],
                "event": "SHOW_TAG_STRIP",
                "eventId": "evt_01M1780JG2FY7B6BJ5DBV4GZB1",
                "from": "loading",
                "to": "loading"
              },
              {
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        [
                          "if",
                          [
                            "or",
                            "@config.readOnly",
                            [
                              "=",
                              "@config.title",
