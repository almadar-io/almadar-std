                2.7,
                3.0,
                3.3,
                3.6,
                3.9,
                4.2,
                4.5,
                4.8,
                5.1,
                5.4,
                5.7,
                6.0
              ],
              "description": "X coordinates the function and its derivative are sampled at to draw their curves.",
              "items": {
                "type": "number"
              },
              "label": "Sample Xs",
              "tier": "domain",
              "type": "[number]"
            },
            "secantColor": {
              "default": "#16a34a",
              "label": "Secant Color",
              "tier": "presentation",
              "type": "string"
            },
            "showAxes": {
              "default": true,
              "label": "Show Axes",
              "tier": "presentation",
              "type": "boolean"
            },
            "showDerivativeCurve": {
              "default": false,
              "description": "Also plot the derivative f′ as its own curve under the function.",
              "label": "Show Derivative Curve",
              "synonyms": "derivative curve, f prime, derived function",
              "tier": "presentation",
              "type": "boolean"
            },
            "showGrid": {
              "default": true,
              "label": "Show Grid",
              "tier": "presentation",
              "type": "boolean"
            },
            "showSecant": {
              "default": true,
              "description": "Draw the secant line through x and x + h alongside the tangent.",
              "label": "Show Secant",
              "synonyms": "secant line, average rate of change",
              "tier": "presentation",
              "type": "boolean"
            },
            "tangentColor": {
              "default": "#dc2626",
              "label": "Tangent Color",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Derivative — Slope Viewer",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            },
            "xMax": {
              "default": 6.0,
              "description": "Maximum x value on the canvas.",
              "label": "X Max",
              "tier": "presentation",
              "type": "number"
            },
            "xMin": {
              "default": -6.0,
              "description": "Minimum x value on the canvas.",
              "label": "X Min",
              "tier": "presentation",
              "type": "number"
            },
            "yMax": {
              "default": 10.0,
              "description": "Maximum y value on the canvas.",
              "label": "Y Max",
              "tier": "presentation",
              "type": "number"
            },
            "yMin": {
              "default": -10.0,
              "description": "Minimum y value on the canvas.",
              "label": "Y Min",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The point, tangent slope and secant state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "DERIVATIVE_UPDATED",
              "eventId": "evt_01KZNG49ZA0SQAVZ4EF1NTSMQC",
              "payloadSchema": [
                {
                  "name": "x",
                  "type": "number"
                },
                {
                  "name": "fx",
                  "type": "number"
                },
                {
                  "name": "slope",
                  "type": "number"
                },
                {
                  "name": "h",
                  "type": "number"
                },
                {
                  "name": "secantSlope",
                  "type": "number"
                },
                {
                  "name": "functionPreset",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "derivative, tangent slope, secant, rate of change, differentiation",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "curves",
              "functionPreset",
              "fx",
              "h",
              "points",
              "px",
              "secantSlope",
              "showSecant",
              "slope",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "MathDerivativeState": "ent_01KZNG49Z9Y4CQPPF4KMDGXT34"
          },
          "id": "trt_01KZNG49Z9PN5G71KD9252P98Y",
          "linkedEntity": "MathDerivativeState",
          "linkedEntityId": "ent_01KZNG49Z9Y4CQPPF4KMDGXT34",
          "name": "MathDerivativeSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNG49Z95MG97X2BQ7XPPFF6",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNG49ZA1QYE64NRMFJ6Z6WG",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the x slider to move the point of tangency along the curve.",
                "id": "evt_01KZNG49ZANDWC6HVS0PXYYFDN",
                "key": "MOVE_POINT",
                "name": "Move Point",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNG49ZAZ824J0YRH49EQZ4Z",
                "key": "SHRINK_H",
                "name": "Shrink H"
              },
              {
                "description": "Learner picked a different function preset; the secant resets to the initial h.",
                "id": "evt_01KZNG49ZA7XCKK2CSRN2JP77S",
                "key": "SET_FUNCTION",
                "name": "Set Function",
                "payloadSchema": [
                  {
                    "name": "preset",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNG49ZA2X36CBXJZR08JJ76",
                "key": "TOGGLE_SECANT",
                "name": "Toggle Secant"
              },
              {
                "description": "The point, tangent slope and secant state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNG49ZA0SQAVZ4EF1NTSMQC",
                "key": "DERIVATIVE_UPDATED",
                "name": "Derivative Updated",
                "payloadSchema": [
                  {
                    "name": "x",
                    "type": "number"
                  },
                  {
                    "name": "fx",
                    "type": "number"
                  },
                  {
                    "name": "slope",
                    "type": "number"
                  },
                  {
                    "name": "h",
                    "type": "number"
                  },
                  {
                    "name": "secantSlope",
                    "type": "number"
                  },
                  {
                    "name": "functionPreset",
                    "type": "string"
                  }
                ],
                "synonyms": "derivative, tangent slope, secant, rate of change, differentiation",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.functionPreset",
                    "@config.functionPreset"
                  ],
                  [
                    "set",
                    "@entity.px",
                    "@config.initialX"
                  ],
                  [
                    "set",
                    "@entity.h",
                    "@config.initialH"
                  ],
                  [
                    "set",
                    "@entity.showSecant",
                    "@config.showSecant"
                  ],
                  [
                    "let",
                    [
                      [
                        "fx",
                        [
                          "if",
                          [
                            "==",
                            "@entity.functionPreset",
                            "sine"
                          ],
                          [
                            "*",
                            3.0,
                            [
                              "math/sin",
                              "@entity.px"
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@entity.functionPreset",
                              "cubic"
                            ],
                            [
                              "*",
                              0.1,
                              [
                                "*",
                                "@entity.px",
                                [
                                  "*",
                                  "@entity.px",
                                  "@entity.px"
                                ]
                              ]
                            ],
                            [
                              "*",
                              0.5,
                              [
                                "*",
                                "@entity.px",
                                "@entity.px"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "slope",
                        [
                          "if",
                          [
                            "==",
                            "@entity.functionPreset",
                            "sine"
                          ],
                          [
                            "*",
                            3.0,
                            [
                              "math/cos",
                              "@entity.px"
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@entity.functionPreset",
                              "cubic"
                            ],
                            [
                              "*",
                              0.3,
                              [
                                "*",
                                "@entity.px",
                                "@entity.px"
                              ]
                            ],
                            "@entity.px"
                          ]
                        ]
                      ],
                      [
                        "fxh",
                        [
                          "if",
                          [
                            "==",
                            "@entity.functionPreset",
                            "sine"
                          ],
                          [
                            "*",
                            3.0,
                            [
                              "math/sin",
                              [
                                "+",
                                "@entity.px",
                                "@entity.h"
                              ]
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@entity.functionPreset",
                              "cubic"
                            ],
                            [
                              "*",
                              0.1,
                              [
                                "*",
                                [
                                  "+",
                                  "@entity.px",
                                  "@entity.h"
                                ],
                                [
                                  "*",
                                  [
                                    "+",
                                    "@entity.px",
                                    "@entity.h"
                                  ],
                                  [
                                    "+",
                                    "@entity.px",
                                    "@entity.h"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "*",
                              0.5,
                              [
                                "*",
                                [
                                  "+",
                                  "@entity.px",
                                  "@entity.h"
                                ],
                                [
                                  "+",
                                  "@entity.px",
                                  "@entity.h"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "secSlope",
                        [
                          "/",
                          [
                            "-",
                            "@fxh",
                            "@fx"
                          ],
                          "@entity.h"
                        ]
                      ],
                      [
                        "fCurve",
                        {
                          "color": "@config.curveColor",
                          "label": "f",
                          "samples": [
                            "array/map",
                            "@config.sampleXs",
                            [
                              "fn",
                              "x",
                              {
                                "x": "@x",
                                "y": [
                                  "if",
                                  [
                                    "==",
                                    "@entity.functionPreset",
                                    "sine"
                                  ],
                                  [
                                    "*",
                                    3.0,
                                    [
                                      "math/sin",
                                      "@x"
                                    ]
                                  ],
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@entity.functionPreset",
                                      "cubic"
                                    ],
                                    [
                                      "*",
                                      0.1,
                                      [
                                        "*",
                                        "@x",
                                        [
                                          "*",
                                          "@x",
                                          "@x"
                                        ]
                                      ]
                                    ],
                                    [
                                      "*",
                                      0.5,
                                      [
                                        "*",
                                        "@x",
                                        "@x"
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        }
                      ],
                      [
                        "tangent",
                        {
                          "color": "@config.tangentColor",
                          "label": "tangent",
                          "samples": [
                            {
                              "x": "@config.xMin",
                              "y": [
                                "+",
                                "@fx",
                                [
                                  "*",
                                  "@slope",
                                  [
                                    "-",
                                    "@config.xMin",
                                    "@entity.px"
                                  ]
                                ]
                              ]
                            },
                            {
                              "x": "@config.xMax",
                              "y": [
                                "+",
                                "@fx",
                                [
                                  "*",
                                  "@slope",
                                  [
                                    "-",
                                    "@config.xMax",
                                    "@entity.px"
                                  ]
                                ]
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        "secant",
                        {
                          "color": "@config.secantColor",
                          "label": "secant",
