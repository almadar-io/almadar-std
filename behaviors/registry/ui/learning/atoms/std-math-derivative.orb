      "traits": [
        {
          "category": "interaction",
          "config": {
            "curveColor": {
              "default": "#2563eb",
              "label": "Function Color",
              "tier": "presentation",
              "type": "string"
            },
            "derivativeColor": {
              "default": "#9333ea",
              "label": "Derivative Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "functionPreset": {
              "default": "parabola",
              "description": "Which function the point rides: ½x², 0.1x³, or 3·sin(x). The tangent uses its analytic derivative.",
              "label": "Function Preset",
              "synonyms": "function, curve, preset, parabola, cubic, sine",
              "tier": "domain",
              "type": "string",
              "values": [
                "parabola",
                "cubic",
                "sine"
              ]
            },
            "gridStep": {
              "default": 1.0,
              "label": "Grid Step",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 400.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "initialH": {
              "default": 2.0,
              "description": "Starting offset between the secant's two intersection points; halving h converges the secant onto the tangent.",
              "label": "Initial h",
              "synonyms": "h, delta x, secant offset, step size",
              "tier": "domain",
              "type": "number"
            },
            "initialX": {
              "default": 1.0,
              "description": "Starting x coordinate of the point of tangency.",
              "label": "Initial x",
              "synonyms": "point of tangency, x coordinate",
              "tier": "domain",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "pointColor": {
              "default": "#dc2626",
              "label": "Point Color",
              "tier": "presentation",
              "type": "string"
            },
            "sampleXs": {
              "default": [
                -6.0,
                -5.7,
                -5.4,
                -5.1,
                -4.8,
                -4.5,
                -4.2,
                -3.9,
                -3.6,
                -3.3,
                -3.0,
                -2.7,
                -2.4,
                -2.1,
                -1.8,
                -1.5,
                -1.2,
                -0.9,
                -0.6,
                -0.3,
                0.0,
                0.3,
                0.6,
                0.9,
                1.2,
                1.5,
                1.8,
                2.1,
