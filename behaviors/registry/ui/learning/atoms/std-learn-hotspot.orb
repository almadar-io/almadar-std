                        "array/len",
                        "@config.prompts"
                      ]
                    ],
                    [
                      "emit",
                      "LEARN_ROUND_COMPLETE",
                      {
                        "score": "@entity.score",
                        "total": [
                          "array/len",
                          "@config.prompts"
                        ]
                      }
                    ],
