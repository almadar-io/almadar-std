          "name": "HotspotSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M075812D7NCEX7G3TP34MXBS",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M075812JWBR49NJTVRXS2MWY",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner tapped a shape on the canvas — the canvas callback wraps its click info as payload { id, type, index }; the id names the hotspot (or its label) and the tap is judged against the current prompt's target.",
                "id": "evt_01M075812JEJR3YKZ3EVCXYZ6W",
                "key": "TAP_SHAPE",
                "name": "Tap Shape",
                "payloadSchema": [
                  {
                    "name": "payload",
                    "properties": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "type",
                        "type": "string"
                      },
                      {
                        "name": "index",
                        "required": true,
                        "type": "number"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next prompt after finding the current target; past the last prompt this completes the round.",
                "id": "evt_01M075812JZ16GNXVCQ09WRT43",
                "key": "NEXT",
                "name": "Next",
                "tier": "domain"
              },
              {
                "description": "Learner restarted the round from the first prompt with a cleared score.",
                "id": "evt_01M075812J4KYMXGSBR18KZAQ2",
                "key": "RETRY",
                "name": "Retry",
                "tier": "domain"
              },
              {
                "description": "The verdict of a canvas tap: whether the right part was hit, which prompt it was, and how many misses preceded it — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M075812JS07BQ7EX9X3ATZGW",
                "key": "TAP_JUDGED",
                "name": "Tap Judged",
                "payloadSchema": [
                  {
                    "name": "correct",
                    "type": "boolean"
                  },
                  {
                    "name": "promptIndex",
                    "type": "number"
                  },
                  {
                    "name": "tries",
                    "type": "number"
                  }
                ],
                "synonyms": "hotspot, tap the part, spatial identification, point at, label the diagram",
                "tier": "domain"
              },
              {
                "description": "The learner moved to the next prompt (or completed the round) with the running first-try score.",
                "id": "evt_01M075812JEVQN24SR66H3H7R8",
                "key": "PROMPT_ADVANCED",
                "name": "Prompt Advanced",
                "payloadSchema": [
                  {
                    "name": "promptIndex",
                    "type": "number"
                  },
                  {
                    "name": "done",
                    "type": "boolean"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The learner restarted the round from scratch.",
                "id": "evt_01M075812J4681FR82RCJGH1GD",
                "key": "ROUND_RESTARTED",
                "name": "Round Restarted",
                "payloadSchema": [
                  {
                    "name": "totalPrompts",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Fired once when the round finishes (advancing past the final prompt) — the standard learning completion broadcast a celebration/progression sibling (fx cues, badges) rides.",
                "id": "evt_01M0GTSZD52FWAWR04FCNHKFEW",
                "key": "LEARN_ROUND_COMPLETE",
                "name": "Learn Round Complete",
                "payloadSchema": [
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "total",
                    "type": "number"
                  }
                ],
                "synonyms": "round complete, finished, done, completion",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "first",
                        [
                          "array/nth",
                          "@config.prompts",
                          0.0
                        ]
                      ],
                      [
                        "circles",
                        [
                          "array/map",
                          "@config.shapes",
                          [
                            "fn",
                            "s",
                            {
                              "color": [
                                "object/get",
                                "@s",
                                "color",
                                "#3b82f6"
                              ],
                              "fill": [
                                "object/get",
                                "@s",
                                "color",
                                "#3b82f6"
                              ],
                              "id": [
                                "object/get",
                                "@s",
                                "id"
                              ],
                              "radius": [
                                "object/get",
                                "@s",
                                "radius",
                                22.0
                              ],
                              "type": "circle",
                              "x": [
                                "object/get",
                                "@s",
                                "x"
                              ],
                              "y": [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "labels",
                        [
                          "array/map",
                          "@config.shapes",
                          [
                            "fn",
                            "s",
                            {
                              "align": "center",
                              "color": "#0f172a",
                              "fontSize": 12.0,
                              "id": [
                                "str/concat",
                                "label-",
                                [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              ],
                              "text": [
                                "object/get",
                                "@s",
                                "label"
                              ],
                              "type": "text",
                              "x": [
                                "object/get",
                                "@s",
                                "x"
                              ],
                              "y": [
                                "+",
                                [
                                  "object/get",
                                  "@s",
                                  "y"
                                ],
                                [
                                  "object/get",
                                  "@s",
                                  "radius",
                                  22.0
                                ],
                                14.0
                              ]
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.promptIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.totalPrompts",
                        [
                          "array/len",
                          "@config.prompts"
                        ]
                      ],
                      [
                        "set",
                        "@entity.score",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.tries",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.found",
