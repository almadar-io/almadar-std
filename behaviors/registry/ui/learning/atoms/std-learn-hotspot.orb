                        [
                          ">=",
                          "@nextIndex",
                          [
                            "array/len",
                            "@config.prompts"
                          ]
                        ]
                      ],
                      [
                        "next",
                        [
                          "array/nth",
                          "@config.prompts",
                          [
                            "math/min",
                            "@nextIndex",
                            [
                              "-",
                              [
                                "array/len",
                                "@config.prompts"
                              ],
