                                  ],
                                  "label": "@config.retryLabel",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "label": "Correct predictions",
                              "max": "@entity.totalScenarios",
                              "type": "stat-display",
                              "value": "@entity.score"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "SCENARIO_ADVANCED",
                    {
                      "done": "@entity.done",
                      "scenarioIndex": "@entity.scenarioIndex",
                      "score": "@entity.score"
                    }
                  ]
                ],
                "event": "NEXT",
                "eventId": "evt_01M07581DKAWQ3CMSKKE9EDM3W",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "and",
                    [
                      "==",
                      "@entity.phase",
                      "judged"
                    ],
                    [
                      "==",
                      "@entity.done",
                      false
                    ]
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "first",
                        [
                          "array/nth",
                          "@config.scenarios",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.scenarioIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.phase",
                        "commit"
                      ],
                      [
                        "set",
                        "@entity.chosenIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.frames",
                        [
                          "object/get",
                          "@first",
                          "frames"
                        ]
                      ],
                      [
                        "set",
                        "@entity.frameIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.frameCaption",
                        ""
                      ],
                      [
                        "set",
                        "@entity.frameValue",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.revealSamples",
                        []
                      ],
                      [
                        "set",
                        "@entity.revealCurves",
                        []
                      ],
                      [
                        "set",
                        "@entity.score",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.done",
                        false
                      ],
                      [
                        "set",
                        "@entity.setupText",
                        [
                          "object/get",
                          "@first",
                          "setup"
                        ]
                      ],
                      [
                        "set",
                        "@entity.question",
                        [
                          "object/get",
                          "@first",
                          "question"
                        ]
                      ],
                      [
                        "set",
                        "@entity.options",
                        [
                          "object/get",
                          "@first",
                          "options"
                        ]
                      ],
                      [
                        "set",
                        "@entity.correctIndex",
                        [
                          "object/get",
                          "@first",
                          "correctIndex"
                        ]
                      ],
                      [
                        "set",
                        "@entity.explanation",
                        [
                          "object/get",
                          "@first",
                          "explanation",
                          ""
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        ""
                      ],
                      [
                        "set",
                        "@entity.view",
                        [
                          {
                            "children": [
                              {
                                "content": "@entity.setupText",
                                "type": "typography",
                                "variant": "body"
                              },
                              {
                                "content": "@entity.question",
                                "type": "typography",
                                "variant": "h4"
                              }
                            ],
                            "padding": "md",
                            "type": "card",
                            "variant": "bordered"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Scenario ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.scenarioIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.totalScenarios"
                                ]
                              ],
                              "max": "@entity.totalScenarios",
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.scenarioIndex",
                                1.0
                              ]
                            },
                            {
                              "children": "@entity.view",
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "array/range",
                                  0.0,
                                  [
                                    "array/len",
                                    "@entity.options"
                                  ]
                                ],
                                [
                                  "fn",
                                  [
                                    "i"
                                  ],
                                  {
                                    "action": "PREDICT",
                                    "actionPayload": {
                                      "index": "@i"
                                    },
                                    "disabled": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.phase",
                                        "commit"
                                      ],
                                      false,
                                      true
                                    ],
                                    "label": [
                                      "array/nth",
                                      "@entity.options",
                                      "@i"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "and",
                                        [
                                          "!=",
                                          "@entity.phase",
                                          "commit"
                                        ],
                                        [
                                          "==",
                                          "@entity.chosenIndex",
                                          "@i"
                                        ]
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "animate": false,
                              "curves": "@entity.revealCurves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": [],
                              "showAxes": true,
                              "showGrid": true,
                              "title": "",
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": [
                                "math/max",
                                1.0,
                                [
                                  "-",
                                  [
                                    "array/len",
                                    "@entity.frames"
                                  ],
                                  1.0
                                ]
                              ],
                              "xMin": 0.0,
                              "yMax": "@config.valueMax",
                              "yMin": "@config.valueMin"
                            },
                            {
                              "content": "@entity.frameCaption",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                {
                                  "action": "NEXT",
                                  "disabled": [
                                    "if",
                                    [
                                      "and",
                                      [
                                        "==",
                                        "@entity.phase",
                                        "judged"
                                      ],
                                      [
                                        "==",
                                        "@entity.done",
                                        false
                                      ]
                                    ],
                                    false,
                                    true
                                  ],
                                  "label": "@config.nextLabel",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RETRY",
                                  "disabled": [
                                    "if",
                                    "@entity.done",
                                    false,
                                    true
                                  ],
                                  "label": "@config.retryLabel",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "label": "Correct predictions",
                              "max": "@entity.totalScenarios",
                              "type": "stat-display",
                              "value": "@entity.score"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "ROUND_RESTARTED",
                    {
                      "totalScenarios": "@entity.totalScenarios"
                    }
                  ]
                ],
                "event": "RETRY",
                "eventId": "evt_01M07581DK3DHDF4K5T5R30B5M",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "==",
                    "@entity.done",
                    true
                  ]
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.frameIndex",
                  [
                    "math/min",
                    [
                      "+",
                      "@entity.frameIndex",
                      1.0
                    ],
                    [
                      "-",
                      [
                        "array/len",
                        "@entity.frames"
                      ],
                      1.0
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.frameCaption",
                  [
                    "object/get",
                    [
                      "array/nth",
                      "@entity.frames",
                      "@entity.frameIndex"
                    ],
                    "caption"
                  ]
                ],
                [
                  "set",
                  "@entity.frameValue",
                  [
                    "object/get",
                    [
                      "array/nth",
                      "@entity.frames",
                      "@entity.frameIndex"
                    ],
                    "value"
                  ]
                ],
                [
                  "set",
                  "@entity.revealSamples",
                  [
                    "array/append",
                    "@entity.revealSamples",
                    {
                      "x": "@entity.frameIndex",
                      "y": "@entity.frameValue"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.revealCurves",
                  [
                    {
                      "color": "@config.revealColor",
                      "label": "@config.revealLabel",
                      "samples": "@entity.revealSamples"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.phase",
                  [
                    "if",
                    [
                      ">=",
                      "@entity.frameIndex",
                      [
                        "-",
                        [
                          "array/len",
                          "@entity.frames"
                        ],
                        1.0
                      ]
                    ],
                    "judged",
                    "@entity.phase"
                  ]
                ],
                [
                  "set",
                  "@entity.score",
                  [
                    "if",
                    [
                      "and",
                      [
                        "==",
                        "@entity.phase",
                        "judged"
                      ],
                      [
                        "==",
                        "@entity.chosenIndex",
                        "@entity.correctIndex"
                      ]
                    ],
                    [
                      "+",
                      "@entity.score",
                      1.0
                    ],
                    "@entity.score"
                  ]
                ],
                [
                  "set",
                  "@entity.feedback",
                  [
                    "if",
                    [
                      "==",
                      "@entity.phase",
                      "judged"
                    ],
                    [
                      "if",
                      [
                        "==",
                        "@entity.chosenIndex",
                        "@entity.correctIndex"
                      ],
                      [
                        "str/concat",
                        "Your prediction was right. ",
                        "@entity.explanation"
                      ],
                      [
                        "str/concat",
                        "Not this time — the outcome was: ",
                        [
                          "array/nth",
                          "@entity.options",
                          "@entity.correctIndex"
                        ],
                        ". ",
                        "@entity.explanation"
                      ]
                    ],
                    "@entity.feedback"
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "==",
                  "@entity.phase",
                  "reveal"
                ]
              ],
              "interval": 600.0,
              "name": "revealTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}