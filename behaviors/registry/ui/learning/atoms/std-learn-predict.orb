                "tier": "domain"
              },
              {
                "description": "The learner moved to the next scenario (or completed the round) with the running score.",
                "id": "evt_01M07581DK8Z46NF7E08ERAV8D",
                "key": "SCENARIO_ADVANCED",
                "name": "Scenario Advanced",
                "payloadSchema": [
