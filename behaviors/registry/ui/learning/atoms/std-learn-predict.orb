                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Scenario ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.scenarioIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
