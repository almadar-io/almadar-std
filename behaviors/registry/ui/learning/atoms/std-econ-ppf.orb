                "event": "INIT",
                "eventId": "evt_01KZEEZFY8SS464HF8ZSS7P0ZS",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.goodALabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        0.0
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodBLabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        1.0
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodAMax",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        0.0
                      ],
                      "maxOutput"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodBMax",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        1.0
                      ],
                      "maxOutput"
                    ]
                  ],
                  [
                    "set",
                    "@entity.allocationShare",
                    "@config.initialShare"
                  ],
                  [
                    "set",
                    "@entity.wasteActive",
                    false
                  ],
                  [
                    "let",
                    [
                      [
                        "shareFrac",
                        [
                          "/",
                          "@entity.allocationShare",
                          100.0
                        ]
                      ],
                      [
                        "outA",
                        [
                          "*",
                          "@entity.goodAMax",
                          "@shareFrac"
                        ]
                      ],
                      [
                        "outB",
                        [
                          "*",
                          "@entity.goodBMax",
                          [
                            "math/sqrt",
                            [
                              "math/max",
                              0.0,
                              [
                                "-",
                                1.0,
                                [
                                  "*",
                                  "@shareFrac",
                                  "@shareFrac"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "mrt",
                        [
                          "if",
                          [
                            "<=",
                            "@outB",
                            0.0
                          ],
                          999999.0,
                          [
                            "/",
                            [
                              "*",
                              "@outA",
                              [
                                "*",
                                "@entity.goodBMax",
                                "@entity.goodBMax"
                              ]
                            ],
                            [
                              "*",
                              [
                                "*",
                                "@entity.goodAMax",
                                "@entity.goodAMax"
                              ],
                              "@outB"
                            ]
                          ]
                        ]
                      ],
                      [
                        "mrtLabel",
