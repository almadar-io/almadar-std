      },
      "pag_01KZEEZFY96VJYT93FSD40J0C7": {
        "bakedName": "EconPpfPage",
        "curName": "EconPpfPage",
        "id": "pag_01KZEEZFY96VJYT93FSD40J0C7",
        "kind": "page",
        "owner": "workspace",
