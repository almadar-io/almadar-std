                                  " / ",
                                  [
                                    "math/round",
                                    "@entity.actualOutputB",
                                    1.0
                                  ],
                                  " ",
                                  "@entity.goodBLabel"
                                ],
                                "@entity.allocationStatusLabel"
                              ],
                              "type": "alert",
                              "variant": [
