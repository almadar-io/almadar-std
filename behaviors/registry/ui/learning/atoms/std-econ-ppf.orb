                    {
                      "marginalOppCost": "@entity.marginalOppCost",
                      "outputA": "@entity.outputA",
                      "outputB": "@entity.outputB",
                      "wasteActive": "@entity.wasteActive"
                    }
                  ]
                ],
                "event": "TOGGLE_WASTE",
                "eventId": "evt_01KZEEZFY90SW9QSVAF5YK8E3C",
                "from": "idle",
