                          [
                            "str/concat",
                            [
                              "math/round",
                              "@mrt",
                              2.0
                            ],
                            " ",
                            "@entity.goodBLabel",
                            " per additional ",
                            "@entity.goodALabel"
                          ]
                        ]
                      ],
                      [
                        "frontierSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            41.0
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "s",
                                  [
                                    "/",
                                    "@i",
                                    40.0
                                  ]
                                ]
                              ],
                              {
                                "x": [
                                  "*",
                                  "@entity.goodAMax",
                                  "@s"
                                ],
                                "y": [
                                  "*",
                                  "@entity.goodBMax",
                                  [
                                    "math/sqrt",
                                    [
                                      "math/max",
                                      0.0,
                                      [
                                        "-",
                                        1.0,
                                        [
                                          "*",
                                          "@s",
                                          "@s"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
