        "id": "ent_01KZEEZFY8CMGFGK9Y7MFFN46F",
        "name": "EconPpfScene",
        "persistence": "runtime"
      },
      "id": "orb_01KZEEZFY8D3TSCGZJ9M0C7QZP",
      "name": "EconPpfOrbital",
      "pages": [
        {
          "id": "pag_01KZEEZFY96VJYT93FSD40J0C7",
          "name": "EconPpfPage",
          "path": "/econ-ppf",
          "traits": [
            {
              "ref": "EconPpfSim",
              "refId": "trt_01KZEEZFY8B1ZMTC62Q2VKHHYS"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "actualPointColor": {
              "default": "#dc2626",
              "label": "Actual Output Point Color",
              "tier": "presentation",
              "type": "string"
            },
            "allocationStep": {
              "default": 1.0,
              "description": "Slider increment for the resource-allocation share.",
              "label": "Allocation Step",
              "tier": "presentation",
              "type": "number"
            },
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "frontierColor": {
              "default": "#2563eb",
              "label": "Frontier Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "frontierPointColor": {
              "default": "#16a34a",
              "label": "Frontier Point Color",
              "tier": "presentation",
              "type": "string"
            },
            "goods": {
              "default": [
                {
                  "key": "A",
                  "label": "Robots",
                  "maxOutput": 100.0
                },
                {
                  "key": "B",
                  "label": "Wheat",
                  "maxOutput": 100.0
                }
              ],
              "description": "The two goods on the production-possibilities frontier — good A (x-axis) and good B (y-axis) — each with a label and the maximum output attainable if all resources went to it.",
              "items": {
                "properties": {
                  "key": {
                    "name": "key",
                    "required": true,
                    "type": "string",
                    "values": [
                      "A",
                      "B"
                    ]
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "maxOutput": {
                    "name": "maxOutput",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Goods",
              "synonyms": "goods roster, production possibilities frontier, PPF, guns and butter, two goods, resource allocation",
              "tier": "domain",
              "type": "[EconPpfGood]"
            },
            "gridStep": {
              "default": 10.0,
              "description": "Spacing between gridlines on the canvas, in output units.",
              "label": "Grid Step",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 440.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "initialShare": {
              "default": 50.0,
              "description": "Starting share (0-100) of resources devoted to good A, before the learner adjusts the slider.",
              "label": "Initial Allocation Share",
              "tier": "domain",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Production Possibilities Frontier",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "wasteFactor": {
              "default": 0.7,
              "description": "Fraction of frontier output retained at the inefficient point when idle resources are shown — models unemployment / underused resources leaving the economy inside its frontier.",
              "label": "Waste Factor",
              "synonyms": "unemployment, idle resources, underutilization, production inefficiency, inefficiency",
              "tier": "domain",
              "type": "number"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The allocation state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "PPF_UPDATED",
              "eventId": "evt_01KZEEZFY9W5XA5DKNTCDAKTDV",
              "payloadSchema": [
                {
                  "name": "outputA",
                  "type": "number"
                },
                {
                  "name": "outputB",
                  "type": "number"
                },
                {
                  "name": "marginalOppCost",
                  "type": "number"
                },
                {
                  "name": "wasteActive",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "allocation update, opportunity cost, frontier point, efficiency",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "actualOutputA",
              "actualOutputB",
              "allocationShare",
              "allocationStatusLabel",
              "curves",
              "goodALabel",
              "goodAMax",
              "goodBLabel",
              "goodBMax",
              "marginalOppCost",
              "marginalOppCostLabel",
              "outputA",
              "outputB",
              "points",
              "title",
              "wasteActive"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "EconPpfScene": "ent_01KZEEZFY8CMGFGK9Y7MFFN46F"
          },
          "id": "trt_01KZEEZFY8B1ZMTC62Q2VKHHYS",
          "linkedEntity": "EconPpfScene",
          "linkedEntityId": "ent_01KZEEZFY8CMGFGK9Y7MFFN46F",
          "name": "EconPpfSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEEZFY8SS464HF8ZSS7P0ZS",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEEZFY98MH8HQ86MDW7HJG0",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the allocation slider to set the share of resources devoted to good A.",
                "id": "evt_01KZEEZFY9C2H8SAN64ZA4EZDS",
                "key": "ALLOCATE",
                "name": "Allocate",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner toggled the idle-resources demo, dropping actual output inside the frontier.",
                "id": "evt_01KZEEZFY90SW9QSVAF5YK8E3C",
                "key": "TOGGLE_WASTE",
                "name": "Toggle Waste",
                "tier": "domain"
              },
              {
                "description": "The allocation state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEEZFY9W5XA5DKNTCDAKTDV",
                "key": "PPF_UPDATED",
                "name": "Ppf Updated",
                "payloadSchema": [
                  {
                    "name": "outputA",
                    "type": "number"
                  },
                  {
                    "name": "outputB",
                    "type": "number"
                  },
                  {
                    "name": "marginalOppCost",
                    "type": "number"
                  },
                  {
                    "name": "wasteActive",
                    "type": "boolean"
                  }
                ],
                "synonyms": "allocation update, opportunity cost, frontier point, efficiency",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.goodALabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        0.0
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodBLabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        1.0
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodAMax",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        0.0
                      ],
                      "maxOutput"
                    ]
                  ],
                  [
                    "set",
                    "@entity.goodBMax",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.goods",
                        1.0
                      ],
                      "maxOutput"
                    ]
                  ],
                  [
                    "set",
                    "@entity.allocationShare",
                    "@config.initialShare"
                  ],
                  [
                    "set",
                    "@entity.wasteActive",
                    false
                  ],
                  [
                    "let",
                    [
                      [
                        "shareFrac",
                        [
                          "/",
                          "@entity.allocationShare",
                          100.0
                        ]
                      ],
                      [
                        "outA",
                        [
                          "*",
                          "@entity.goodAMax",
                          "@shareFrac"
                        ]
                      ],
                      [
                        "outB",
                        [
                          "*",
                          "@entity.goodBMax",
                          [
                            "math/sqrt",
                            [
                              "math/max",
                              0.0,
                              [
                                "-",
                                1.0,
                                [
                                  "*",
                                  "@shareFrac",
                                  "@shareFrac"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "mrt",
                        [
                          "if",
                          [
                            "<=",
                            "@outB",
                            0.0
                          ],
                          999999.0,
                          [
                            "/",
                            [
                              "*",
                              "@outA",
                              [
                                "*",
                                "@entity.goodBMax",
                                "@entity.goodBMax"
                              ]
                            ],
                            [
                              "*",
                              [
                                "*",
                                "@entity.goodAMax",
                                "@entity.goodAMax"
                              ],
                              "@outB"
                            ]
                          ]
                        ]
                      ],
                      [
                        "mrtLabel",
                        [
                          "if",
                          [
                            "<=",
                            "@outB",
                            0.0
                          ],
                          [
                            "str/concat",
                            "Fully specialized in ",
                            "@entity.goodALabel",
                            " — no more ",
                            "@entity.goodBLabel",
                            " to give up"
                          ],
                          [
                            "str/concat",
                            [
                              "math/round",
                              "@mrt",
                              2.0
                            ],
                            " ",
                            "@entity.goodBLabel",
                            " per additional ",
                            "@entity.goodALabel"
                          ]
                        ]
                      ],
                      [
                        "frontierSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            41.0
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "s",
                                  [
                                    "/",
                                    "@i",
                                    40.0
                                  ]
                                ]
                              ],
                              {
                                "x": [
                                  "*",
                                  "@entity.goodAMax",
                                  "@s"
                                ],
                                "y": [
                                  "*",
                                  "@entity.goodBMax",
                                  [
                                    "math/sqrt",
                                    [
                                      "math/max",
                                      0.0,
                                      [
                                        "-",
                                        1.0,
                                        [
                                          "*",
                                          "@s",
                                          "@s"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "allocationCurves",
                        [
                          {
                            "color": "@config.frontierColor",
                            "label": "Production Possibilities Frontier",
                            "samples": "@frontierSamples"
                          }
                        ]
                      ],
                      [
                        "allocationPoints",
                        [
                          {
                            "color": "@config.frontierPointColor",
                            "label": "Frontier Point",
                            "radius": 6.0,
                            "x": "@outA",
                            "y": "@outB"
                          },
                          {
                            "color": "@config.actualPointColor",
                            "label": "Actual Output",
                            "radius": 6.0,
                            "x": "@outA",
                            "y": "@outB"
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.outputA",
                        "@outA"
                      ],
                      [
                        "set",
                        "@entity.outputB",
                        "@outB"
                      ],
                      [
                        "set",
                        "@entity.marginalOppCost",
                        "@mrt"
                      ],
                      [
                        "set",
                        "@entity.marginalOppCostLabel",
                        "@mrtLabel"
                      ],
                      [
                        "set",
                        "@entity.actualOutputA",
                        "@outA"
                      ],
                      [
                        "set",
                        "@entity.actualOutputB",
                        "@outB"
                      ],
                      [
                        "set",
                        "@entity.allocationStatusLabel",
                        "Efficient — on the frontier"
                      ],
                      [
                        "set",
                        "@entity.curves",
                        "@allocationCurves"
                      ],
                      [
                        "set",
                        "@entity.points",
                        "@allocationPoints"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": "@entity.points",
                              "shapes": [],
                              "showAxes": true,
                              "showGrid": true,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@entity.goodAMax",
                              "xMin": 0.0,
                              "yMax": "@entity.goodBMax",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Share of resources to ",
                                    "@entity.goodALabel",
                                    ": ",
                                    "@entity.allocationShare",
                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 100.0,
                                  "min": 0.0,
                                  "onChange": "ALLOCATE",
                                  "showTooltip": true,
                                  "step": "@config.allocationStep",
                                  "type": "range-slider",
                                  "value": "@entity.allocationShare"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "TOGGLE_WASTE",
                                  "label": [
                                    "if",
                                    "@entity.wasteActive",
                                    "Remove Idle Resources",
                                    "Show Idle Resources (Waste)"
                                  ],
                                  "type": "button",
                                  "variant": [
                                    "if",
                                    "@entity.wasteActive",
                                    "danger",
                                    "ghost"
                                  ]
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "type": "divider"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.goodALabel",
                                ": ",
                                [
                                  "math/round",
                                  "@entity.outputA",
                                  1.0
                                ],
                                " — ",
                                "@entity.goodBLabel",
                                ": ",
                                [
                                  "math/round",
                                  "@entity.outputB",
                                  1.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
