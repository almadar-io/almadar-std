                                  "type": "button",
                                  "variant": [
                                    "if",
                                    "@entity.wasteActive",
                                    "danger",
                                    "ghost"
                                  ]
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "type": "divider"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.goodALabel",
                                ": ",
                                [
                                  "math/round",
                                  "@entity.outputA",
                                  1.0
                                ],
                                " — ",
                                "@entity.goodBLabel",
                                ": ",
                                [
