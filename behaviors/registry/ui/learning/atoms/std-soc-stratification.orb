              "label": "Bar Height",
              "tier": "presentation",
              "type": "number"
            },
            "barMargin": {
              "default": 40.0,
              "description": "Horizontal margin, in pixels, on each side of the stacked bar.",
              "label": "Bar Margin",
              "tier": "presentation",
              "type": "number"
            },
            "concentrationRate": {
              "default": 0.4,
              "description": "Fraction of an inner stratum's (upper-middle/working) share pulled outward to the adjacent extreme stratum per generation, scaled by (1 - mobility/100) — the low-mobility 'rich stay rich, poor stay poor' term. Keep this and Mobility Rate each ≤ 1.0 so shares always stay non-negative.",
              "label": "Concentration Rate",
              "synonyms": "social mobility, intergenerational mobility, mobility index, class mobility, income inequality",
              "tier": "domain",
              "type": "number"
            },
            "height": {
              "default": 460.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "incomeWeights": {
              "default": [
                9.0,
                3.0,
                1.5,
                0.7,
                0.3
              ],
              "description": "Relative income multiplier for each of the five strata, index-aligned with Strata (same order: richest to poorest). Used with the current shares to compute the Gini-style inequality index: income_i = share_i × weight_i, normalized into income shares, then the discrete Gini formula over cumulative population vs. cumulative income (poorest to richest).",
              "items": {
                "type": "number"
              },
              "label": "Income Weights",
              "synonyms": "income distribution, income inequality, Gini index, Gini coefficient, wealth gap, economic inequality",
              "tier": "domain",
              "type": "[number]"
            },
            "initialMobility": {
              "default": 50.0,
              "description": "Starting value (0-100) of the mobility index.",
              "label": "Initial Mobility Index",
              "synonyms": "social mobility, intergenerational mobility, mobility index, class mobility",
              "tier": "domain",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "mobilityRate": {
              "default": 0.4,
              "description": "Fraction of a non-middle stratum's share that migrates one step toward the middle class per generation, scaled by the mobility index (mobilityFrac = mobility/100). Keep this and Concentration Rate each ≤ 1.0 so shares always stay non-negative.",
              "label": "Mobility Rate",
              "synonyms": "social mobility, intergenerational mobility, mobility index, class mobility",
              "tier": "domain",
              "type": "number"
            },
            "strata": {
              "default": [
                {
                  "color": "#1e3a8a",
                  "name": "Upper Class",
                  "share": 10.0
                },
                {
                  "color": "#2563eb",
                  "name": "Upper-Middle Class",
