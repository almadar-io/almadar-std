                      [
                        "array/nth",
                        "@config.phases",
                        "@entity.currentPhase"
                      ],
                      "shapes"
                    ]
                  ],
                  [
                    "set",
                    "@entity.predictedPhase",
                    ""
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    ""
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": "@entity.shapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                {
                                  "content": "@entity.phaseLabel",
                                  "type": "typography",
                                  "variant": "h4"
                                },
                                {
                                  "content": "@entity.phaseDescription",
                                  "type": "typography",
                                  "variant": "body"
                                },
                                {
                                  "children": [
                                    {
                                      "content": "Predict what happens next",
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "children": [
                                        "array/map",
                                        "@config.phases",
                                        [
                                          "fn",
                                          "p",
                                          {
                                            "action": "PREDICT",
                                            "actionPayload": {
                                              "choice": [
                                                "object/get",
                                                "@p",
                                                "label"
                                              ]
                                            },
                                            "disabled": [
                                              "if",
                                              "@config.predictMode",
                                              false,
                                              true
                                            ],
                                            "label": [
                                              "object/get",
                                              "@p",
                                              "label"
                                            ],
                                            "size": "sm",
                                            "type": "button",
                                            "variant": [
                                              "if",
                                              [
                                                "==",
                                                "@entity.predictedPhase",
                                                [
                                                  "object/get",
                                                  "@p",
                                                  "label"
                                                ]
                                              ],
                                              "primary",
                                              "ghost"
                                            ]
                                          }
                                        ]
                                      ],
                                      "direction": "horizontal",
                                      "gap": "xs",
                                      "type": "stack"
                                    },
                                    {
                                      "content": "@entity.feedback",
                                      "type": "typography",
                                      "variant": "caption"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "action": "PREV",
                                      "label": "◀ Prev",
                                      "type": "button",
                                      "variant": "ghost"
                                    },
                                    {
                                      "action": "NEXT",
                                      "label": "Next ▶",
                                      "type": "button",
                                      "variant": "primary"
                                    }
                                  ],
                                  "direction": "horizontal",
                                  "gap": "sm",
                                  "type": "stack"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "PHASE_CYCLE_UPDATED",
                    {
                      "currentPhase": "@entity.currentPhase",
                      "feedback": "@entity.feedback",
                      "phaseLabel": "@entity.phaseLabel",
                      "predictedPhase": "@entity.predictedPhase"
                    }
                  ]
                ],
                "event": "PREV",
                "eventId": "evt_01KZEJ4KEYVEF412TJ4REC1451",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.predictedPhase",
                    "@payload.choice"
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    [
                      "if",
                      [
                        "<",
                        "@entity.currentPhase",
                        [
                          "-",
                          [
                            "array/len",
                            "@config.phases"
                          ],
                          1.0
                        ]
                      ],
                      [
                        "if",
                        [
                          "==",
                          "@payload.choice",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@config.phases",
                              [
                                "+",
                                "@entity.currentPhase",
                                1.0
                              ]
                            ],
                            "label"
                          ]
                        ],
                        "Correct — click Next to see it happen.",
                        [
                          "str/concat",
                          "Not quite — click Next to see what actually follows ",
                          "@entity.phaseLabel",
                          "."
                        ]
                      ],
                      "This is the last phase — there is nothing further to predict."
                    ]
                  ],
                  [
