                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "children": [
                                        "array/map",
                                        "@config.phases",
                                        [
                                          "fn",
                                          "p",
                                          {
                                            "action": "PREDICT",
                                            "actionPayload": {
                                              "choice": [
                                                "object/get",
                                                "@p",
                                                "label"
                                              ]
                                            },
                                            "disabled": [
                                              "if",
                                              "@config.predictMode",
                                              false,
                                              true
                                            ],
                                            "label": [
                                              "object/get",
                                              "@p",
                                              "label"
                                            ],
                                            "size": "sm",
                                            "type": "button",
                                            "variant": [
                                              "if",
                                              [
                                                "==",
                                                "@entity.predictedPhase",
                                                [
                                                  "object/get",
                                                  "@p",
                                                  "label"
                                                ]
                                              ],
                                              "primary",
                                              "ghost"
                                            ]
                                          }
                                        ]
                                      ],
                                      "direction": "horizontal",
                                      "gap": "xs",
                                      "type": "stack"
                                    },
                                    {
                                      "content": "@entity.feedback",
                                      "type": "typography",
                                      "variant": "caption"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
