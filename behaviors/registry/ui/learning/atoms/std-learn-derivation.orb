            "required": true,
            "type": "string"
          },
          {
            "name": "resultBadgeLabel",
            "type": "string"
          },
          {
            "name": "resultBadgeVariant",
            "type": "string"
          },
          {
            "name": "noMatchFeedback",
            "type": "string"
          }
