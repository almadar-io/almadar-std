                "event": "MODE_SELECTED",
                "eventId": "evt_01M0CGJFW96K8FBC6WV4D341YQ",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "candidate",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.candidates",
                            [
                              "fn",
                              "c",
                              [
                                "==",
                                "@c.key",
                                "@payload.candidateKey"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "links",
                        [
                          "array/filter",
                          "@entity.lines",
                          [
                            "fn",
                            "l",
                            [
                              "==",
                              "@l.kind",
                              "link"
                            ]
                          ]
                        ]
                      ],
                      [
                        "facts",
                        [
                          "array/filter",
                          "@entity.lines",
                          [
                            "fn",
                            "l",
                            [
                              "==",
                              "@l.kind",
                              "fact"
                            ]
                          ]
                        ]
                      ],
                      [
                        "wantLeft",
                        [
                          "==",
                          "@candidate.matchSide",
                          "left"
                        ]
                      ],
                      [
                        "matchSense",
                        [
                          "==",
                          "@candidate.matchNegationMode",
                          "same"
                        ]
                      ],
                      [
                        "activeLink",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@links",
                            [
                              "fn",
                              "l",
                              [
                                "let",
                                [
                                  [
                                    "linkSubject",
                                    [
                                      "if",
                                      "@wantLeft",
                                      "@l.leftSubject",
                                      "@l.rightSubject"
                                    ]
                                  ],
                                  [
                                    "linkNegated",
                                    [
                                      "if",
                                      "@wantLeft",
                                      "@l.leftNegated",
                                      "@l.rightNegated"
                                    ]
                                  ],
                                  [
                                    "requiredNegated",
                                    [
                                      "if",
                                      "@matchSense",
                                      "@linkNegated",
                                      [
                                        "not",
                                        "@linkNegated"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "array/some",
                                  "@facts",
                                  [
                                    "fn",
                                    "f",
                                    [
                                      "and",
                                      [
                                        "==",
                                        "@f.subject",
                                        "@linkSubject"
                                      ],
                                      [
                                        "==",
                                        "@f.negated",
                                        "@requiredNegated"
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "deriveLeft",
                        [
                          "==",
                          "@candidate.deriveSide",
                          "left"
                        ]
                      ],
                      [
                        "deriveSense",
                        [
                          "==",
                          "@candidate.deriveNegationMode",
                          "same"
                        ]
                      ],
                      [
                        "derivedSubject",
                        [
                          "if",
                          [
                            "!=",
                            "@activeLink",
                            null
                          ],
                          [
                            "if",
                            "@deriveLeft",
                            "@activeLink.leftSubject",
                            "@activeLink.rightSubject"
                          ],
                          ""
                        ]
                      ],
                      [
                        "derivedSideNegated",
                        [
                          "if",
                          [
                            "!=",
                            "@activeLink",
                            null
                          ],
                          [
                            "if",
                            "@deriveLeft",
                            "@activeLink.leftNegated",
                            "@activeLink.rightNegated"
                          ],
                          false
                        ]
                      ],
                      [
                        "derivedNegated",
                        [
                          "if",
                          "@deriveSense",
                          "@derivedSideNegated",
                          [
                            "not",
                            "@derivedSideNegated"
                          ]
                        ]
                      ],
                      [
                        "derivedLabel",
                        [
                          "if",
                          [
                            "!=",
                            "@activeLink",
                            null
                          ],
                          [
                            "if",
                            "@derivedNegated",
                            [
                              "str/concat",
                              "@config.negationSymbol",
                              "@derivedSubject"
                            ],
                            "@derivedSubject"
                          ],
                          ""
                        ]
                      ],
                      [
                        "alreadyPresent",
                        [
                          "array/some",
                          "@entity.lines",
                          [
                            "fn",
                            "l",
                            [
                              "==",
                              "@l.label",
                              "@derivedLabel"
                            ]
                          ]
                        ]
                      ],
                      [
                        "canDerive",
                        [
                          "and",
                          [
                            "!=",
                            "@activeLink",
                            null
                          ],
                          [
                            "not",
                            "@alreadyPresent"
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.lines",
                        [
                          "if",
                          "@canDerive",
                          [
                            "array/concat",
                            "@entity.lines",
                            [
                              {
                                "badgeLabel": "@candidate.resultBadgeLabel",
                                "badgeVariant": "@candidate.resultBadgeVariant",
                                "id": [
                                  "str/concat",
                                  "line-",
                                  [
                                    "array/len",
                                    "@entity.lines"
                                  ]
                                ],
                                "kind": "fact",
                                "label": "@derivedLabel",
                                "negated": "@derivedNegated",
                                "subject": "@derivedSubject"
                              }
                            ]
                          ],
                          "@entity.lines"
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        [
                          "if",
                          "@canDerive",
                          [
                            "str/concat",
                            "Derived ",
                            "@derivedLabel",
                            " via ",
                            "@candidate.label",
                            "."
                          ],
                          [
                            "if",
                            "@alreadyPresent",
                            [
                              "str/concat",
                              "@derivedLabel",
                              " is already in the derivation."
                            ],
                            "@candidate.noMatchFeedback"
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.goalReached",
                        [
                          "if",
                          "@canDerive",
                          [
                            "==",
                            "@derivedLabel",
                            "@config.goalLabel"
                          ],
                          "@entity.goalReached"
                        ]
                      ],
                      [
                        "set",
                        "@entity.narration",
                        "@entity.feedback"
                      ],
                      [
                        "if",
                        [
                          "and",
                          "@canDerive",
                          [
                            "==",
                            "@derivedLabel",
                            "@config.goalLabel"
                          ]
                        ],
                        [
                          "emit",
                          "LEARN_ROUND_COMPLETE",
                          {
                            "score": 1.0,
                            "total": 1.0
                          }
                        ],
                        null
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.renderChildren",
                    [
                      {
                        "content": "@entity.title",
                        "type": "typography",
                        "variant": "h4"
                      },
                      {
                        "content": [
                          "str/concat",
