                          "@config.goalPrefix",
                          "@config.goalLabel"
                        ],
                        "type": "typography",
                        "variant": "body"
                      },
                      {
                        "children": [
                          "array/map",
                          "@entity.lines",
                          [
                            "fn",
                            "line",
                            {
                              "children": [
                                {
                                  "label": "@line.badgeLabel",
                                  "type": "badge",
                                  "variant": "@line.badgeVariant"
                                },
                                {
                                  "content": "@line.label",
                                  "type": "typography",
                                  "variant": "body"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ]
                        ],
                        "direction": "vertical",
                        "gap": "xs",
                        "style": {
                          "maxHeight": [
                            "str/concat",
                            "@config.height",
                            "px"
                          ],
                          "overflowY": "auto"
                        },
                        "type": "stack"
                      },
                      {
                        "children": [
                          "array/map",
                          "@config.candidates",
                          [
                            "fn",
                            "c",
                            {
                              "action": "APPLY_STEP",
                              "actionPayload": {
                                "candidateKey": "@c.key"
                              },
                              "label": "@c.label",
                              "type": "button",
                              "variant": "primary"
                            }
                          ]
                        ],
                        "direction": "horizontal",
                        "gap": "sm",
                        "type": "stack"
                      },
                      {
                        "children": [
                          {
                            "action": "TOGGLE_RUN",
                            "label": [
                              "if",
                              "@entity.running",
                              "Pause",
                              "Run"
                            ],
                            "type": "button",
                            "variant": "secondary"
                          },
                          {
                            "action": "RESET",
                            "label": "@config.resetLabel",
                            "type": "button",
                            "variant": "ghost"
                          }
                        ],
                        "direction": "horizontal",
                        "gap": "sm",
                        "type": "stack"
                      },
                      {
                        "content": "@entity.narration",
                        "type": "typography",
                        "variant": "caption"
                      },
                      {
                        "content": [
                          "if",
                          "@entity.goalReached",
                          "@config.goalReachedMessage",
                          ""
                        ],
                        "type": "typography",
                        "variant": "caption"
                      }
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "maxWidth": [
                        "str/concat",
                        "@config.width",
                        "px"
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "DERIVATION_UPDATED",
                    {
                      "feedback": "@entity.feedback",
                      "goalReached": "@entity.goalReached",
                      "lineCount": [
                        "array/len",
                        "@entity.lines"
                      ],
                      "narration": "@entity.narration"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M0CGJFW98W2XTBPXCK1DWBHW",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.elapsedMs",
                  [
                    "+",
                    "@entity.elapsedMs",
                    32.0
                  ]
                ],
                [
                  "when",
                  [
                    ">=",
                    "@entity.elapsedMs",
                    "@config.autoApplyIntervalMs"
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.elapsedMs",
                      0.0
                    ],
                    [
                      "let",
                      [
                        [
                          "links",
                          [
                            "array/filter",
                            "@entity.lines",
                            [
                              "fn",
                              "l",
                              [
                                "==",
                                "@l.kind",
                                "link"
                              ]
                            ]
                          ]
                        ],
                        [
                          "facts",
                          [
                            "array/filter",
                            "@entity.lines",
                            [
                              "fn",
                              "l",
                              [
                                "==",
                                "@l.kind",
                                "fact"
                              ]
                            ]
                          ]
                        ],
                        [
                          "evaluated",
                          [
                            "array/map",
                            "@config.candidates",
                            [
                              "fn",
                              "c",
                              [
                                "let",
                                [
                                  [
                                    "wantLeft",
                                    [
                                      "==",
                                      "@c.matchSide",
                                      "left"
                                    ]
                                  ],
                                  [
                                    "matchSense",
                                    [
                                      "==",
                                      "@c.matchNegationMode",
                                      "same"
                                    ]
                                  ],
                                  [
                                    "activeLink",
                                    [
                                      "array/first",
                                      [
                                        "array/filter",
                                        "@links",
                                        [
                                          "fn",
                                          "l",
                                          [
                                            "let",
                                            [
                                              [
                                                "linkSubject",
                                                [
                                                  "if",
                                                  "@wantLeft",
                                                  "@l.leftSubject",
                                                  "@l.rightSubject"
                                                ]
                                              ],
                                              [
                                                "linkNegated",
                                                [
                                                  "if",
                                                  "@wantLeft",
                                                  "@l.leftNegated",
                                                  "@l.rightNegated"
                                                ]
                                              ],
                                              [
                                                "requiredNegated",
                                                [
                                                  "if",
                                                  "@matchSense",
                                                  "@linkNegated",
                                                  [
                                                    "not",
                                                    "@linkNegated"
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              "array/some",
                                              "@facts",
                                              [
                                                "fn",
                                                "f",
                                                [
                                                  "and",
                                                  [
                                                    "==",
                                                    "@f.subject",
                                                    "@linkSubject"
                                                  ],
                                                  [
                                                    "==",
                                                    "@f.negated",
                                                    "@requiredNegated"
                                                  ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "deriveLeft",
                                    [
                                      "==",
                                      "@c.deriveSide",
                                      "left"
                                    ]
                                  ],
                                  [
                                    "deriveSense",
                                    [
                                      "==",
                                      "@c.deriveNegationMode",
                                      "same"
                                    ]
                                  ],
                                  [
                                    "derivedSubject",
                                    [
                                      "if",
                                      [
                                        "!=",
                                        "@activeLink",
                                        null
                                      ],
                                      [
                                        "if",
                                        "@deriveLeft",
                                        "@activeLink.leftSubject",
                                        "@activeLink.rightSubject"
                                      ],
                                      ""
                                    ]
                                  ],
                                  [
                                    "derivedSideNegated",
                                    [
                                      "if",
                                      [
                                        "!=",
                                        "@activeLink",
                                        null
                                      ],
                                      [
                                        "if",
                                        "@deriveLeft",
                                        "@activeLink.leftNegated",
                                        "@activeLink.rightNegated"
                                      ],
                                      false
                                    ]
                                  ],
                                  [
                                    "derivedNegated",
                                    [
                                      "if",
                                      "@deriveSense",
                                      "@derivedSideNegated",
                                      [
                                        "not",
                                        "@derivedSideNegated"
                                      ]
                                    ]
                                  ],
                                  [
                                    "derivedLabel",
                                    [
                                      "if",
                                      [
                                        "!=",
                                        "@activeLink",
                                        null
                                      ],
                                      [
                                        "if",
                                        "@derivedNegated",
                                        [
                                          "str/concat",
                                          "@config.negationSymbol",
                                          "@derivedSubject"
                                        ],
                                        "@derivedSubject"
                                      ],
                                      ""
                                    ]
                                  ],
                                  [
                                    "alreadyPresent",
                                    [
                                      "array/some",
                                      "@entity.lines",
                                      [
                                        "fn",
                                        "l",
                                        [
                                          "==",
                                          "@l.label",
                                          "@derivedLabel"
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "applicable",
                                    [
                                      "and",
                                      [
                                        "!=",
                                        "@activeLink",
                                        null
                                      ],
                                      [
                                        "not",
                                        "@alreadyPresent"
                                      ]
                                    ]
                                  ]
                                ],
                                {
                                  "applicable": "@applicable",
                                  "derivedLabel": "@derivedLabel",
                                  "derivedNegated": "@derivedNegated",
                                  "derivedSubject": "@derivedSubject",
                                  "label": "@c.label",
                                  "resultBadgeLabel": "@c.resultBadgeLabel",
                                  "resultBadgeVariant": "@c.resultBadgeVariant"
                                }
                              ]
                            ]
                          ]
                        ],
                        [
                          "match",
                          [
                            "array/first",
                            [
                              "array/filter",
                              "@evaluated",
                              [
                                "fn",
                                "e",
                                [
                                  "==",
                                  "@e.applicable",
                                  true
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "found",
                          [
                            "!=",
                            "@match",
                            null
                          ]
                        ]
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.lines",
                          [
                            "if",
                            "@found",
                            [
                              "array/concat",
                              "@entity.lines",
                              [
                                {
                                  "badgeLabel": "@match.resultBadgeLabel",
                                  "badgeVariant": "@match.resultBadgeVariant",
                                  "id": [
                                    "str/concat",
                                    "line-",
                                    [
                                      "array/len",
                                      "@entity.lines"
                                    ]
                                  ],
                                  "kind": "fact",
                                  "label": "@match.derivedLabel",
                                  "negated": "@match.derivedNegated",
                                  "subject": "@match.derivedSubject"
                                }
                              ]
                            ],
                            "@entity.lines"
                          ]
                        ],
                        [
                          "set",
                          "@entity.feedback",
                          [
                            "if",
                            "@found",
                            [
                              "str/concat",
                              "Derived ",
                              "@match.derivedLabel",
                              " via ",
                              "@match.label",
                              "."
                            ],
                            "@config.noStepAvailableMessage"
                          ]
                        ],
                        [
                          "set",
                          "@entity.goalReached",
                          [
                            "if",
                            "@found",
                            [
                              "==",
                              "@match.derivedLabel",
                              "@config.goalLabel"
                            ],
                            "@entity.goalReached"
                          ]
                        ],
                        [
                          "set",
                          "@entity.narration",
                          "@entity.feedback"
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.renderChildren",
                      [
                        {
                          "content": "@entity.title",
                          "type": "typography",
                          "variant": "h4"
                        },
                        {
                          "content": [
                            "str/concat",
                            "@config.goalPrefix",
                            "@config.goalLabel"
                          ],
                          "type": "typography",
                          "variant": "body"
                        },
                        {
                          "children": [
                            "array/map",
                            "@entity.lines",
                            [
                              "fn",
                              "line",
                              {
                                "children": [
                                  {
                                    "label": "@line.badgeLabel",
                                    "type": "badge",
                                    "variant": "@line.badgeVariant"
                                  },
                                  {
                                    "content": "@line.label",
                                    "type": "typography",
                                    "variant": "body"
                                  }
                                ],
                                "direction": "horizontal",
                                "gap": "sm",
                                "type": "stack"
                              }
                            ]
                          ],
                          "direction": "vertical",
                          "gap": "xs",
                          "style": {
                            "maxHeight": [
                              "str/concat",
                              "@config.height",
                              "px"
                            ],
                            "overflowY": "auto"
                          },
                          "type": "stack"
                        },
                        {
                          "children": [
                            "array/map",
                            "@config.candidates",
                            [
                              "fn",
                              "c",
                              {
                                "action": "APPLY_STEP",
                                "actionPayload": {
                                  "candidateKey": "@c.key"
                                },
                                "label": "@c.label",
                                "type": "button",
                                "variant": "primary"
                              }
                            ]
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        },
                        {
                          "children": [
                            {
                              "action": "TOGGLE_RUN",
                              "label": [
                                "if",
                                "@entity.running",
                                "Pause",
                                "Run"
                              ],
                              "type": "button",
                              "variant": "secondary"
                            },
                            {
                              "action": "RESET",
                              "label": "@config.resetLabel",
                              "type": "button",
                              "variant": "ghost"
                            }
                          ],
                          "direction": "horizontal",
                          "gap": "sm",
                          "type": "stack"
                        },
                        {
                          "content": "@entity.narration",
                          "type": "typography",
                          "variant": "caption"
                        },
                        {
                          "content": [
                            "if",
                            "@entity.goalReached",
                            "@config.goalReachedMessage",
                            ""
                          ],
                          "type": "typography",
                          "variant": "caption"
                        }
                      ]
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "children": [
                          {
                            "children": "@entity.renderChildren",
                            "direction": "vertical",
                            "gap": "md",
                            "type": "stack"
                          }
                        ],
                        "maxWidth": [
                          "str/concat",
                          "@config.width",
                          "px"
                        ],
                        "padding": "md",
                        "type": "box"
                      }
                    ],
                    [
                      "emit",
                      "DERIVATION_UPDATED",
                      {
                        "feedback": "@entity.feedback",
                        "goalReached": "@entity.goalReached",
                        "lineCount": [
                          "array/len",
                          "@entity.lines"
                        ],
                        "narration": "@entity.narration"
                      }
                    ]
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "not",
                    [
                      "==",
                      "@entity.goalReached",
                      true
                    ]
                  ]
                ]
              ],
              "interval": 32.0,
              "name": "derivationTick"
            }
          ]
        }
      ],
      "types": {
        "LearnDerivationCandidate": [
          {
            "name": "key",
            "required": true,
            "type": "string"
