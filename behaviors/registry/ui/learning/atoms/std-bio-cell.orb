          "id": "trt_01KXG051CYK5P0PQAWJMZ2GWD7",
          "linkedEntity": "BioCellState",
          "linkedEntityId": "ent_01KXG051CYPV2T3P7HNF8Q4VPW",
          "name": "BioCellSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG051CY6QPVRXPJ4X9ZSJHM",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEKSM17VR06M3E9HT80R2EK",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01M04B0Y6V1D3KME12MPRJ0H1D",
                "key": "NEXT",
                "name": "Next"
              },
              {
                "id": "evt_01M04B0Y6VSWES5RFV5CCWY99X",
                "key": "PREV",
                "name": "Prev"
              },
              {
                "id": "evt_01M04B0Y6VA8DK3WZZDDPA6G5B",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "Fires on INIT/MODE_SELECTED/Prev/Next/Reset with the currently selected organelle's id, label, and function text, plus whether every organelle has now been visited — a composed listener (readout, quiz) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04B0Y6VPJAGBG68SFTAXZ35",
                "key": "CELL_SELECTED",
                "name": "Cell Selected",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  },
                  {
                    "name": "label",
                    "type": "string"
                  },
                  {
                    "name": "role",
                    "type": "string"
                  },
                  {
                    "name": "tourComplete",
                    "type": "boolean"
                  }
                ],
                "synonyms": "select, choose, organelle, explore, tour, pick",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.organelles",
                    [
                      "if",
                      "@config.plantMode",
                      [
                        "array/concat",
                        "@config.plantOrganelles",
                        "@config.coreOrganelles"
                      ],
                      "@config.coreOrganelles"
                    ]
                  ],
                  [
                    "set",
                    "@entity.edges",
                    [
                      "if",
                      "@config.plantMode",
                      [
                        "array/concat",
                        "@config.plantEdges",
                        "@config.coreEdges"
                      ],
                      "@config.coreEdges"
                    ]
                  ],
                  [
                    "set",
                    "@entity.selectedIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.selectedId",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@entity.organelles",
                        0.0
                      ],
                      "id"
                    ]
                  ],
                  [
                    "set",
                    "@entity.visitedIds",
                    [
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.organelles",
                          0.0
                        ],
                        "id"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.tourComplete",
                    false
                  ],
                  [
                    "set",
                    "@entity.narration",
                    [
                      "str/concat",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.organelles",
                          0.0
                        ],
                        "label"
                      ],
                      " — ",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.organelles",
                          0.0
                        ],
                        "role"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "PREV",
                                  "label": "Prev",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "NEXT",
                                  "label": "Next",
                                  "type": "button",
                                  "variant": "primary"
