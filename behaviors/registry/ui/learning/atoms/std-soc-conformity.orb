              "ref": "SocConfSim",
              "refId": "trt_01M04DG943AN50MP31R4N712VE"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "agentCount": {
              "default": 24.0,
              "description": "Number of agents in the population. At seeding, all hold opinion 0 except one lone deviant in the middle.",
              "label": "Agent Count",
              "synonyms": "agents, population, actors, conformity, social influence",
              "tier": "domain",
              "type": "number"
            },
            "agentRadius": {
              "default": 11.0,
              "label": "Agent Radius",
              "tier": "presentation",
              "type": "number"
            },
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f1f5f9",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "devianceRate": {
              "default": 0.05,
              "description": "Probability (0-0.5) that an agent deliberately adopts the opposite of its local majority in a step — Merton's nonconformist. Zero drives fast convergence; high values fragment the population.",
              "label": "Deviance Rate",
              "synonyms": "deviance, nonconformity, Merton, innovation, rebellion, social deviance",
              "tier": "domain",
              "type": "number"
            },
            "deviantColor": {
              "default": "#dc2626",
              "description": "Color of agents holding opinion 1 (the initial deviance).",
              "label": "Deviant Color",
              "tier": "presentation",
              "type": "string"
            },
            "gridCols": {
              "default": 8.0,
              "description": "How many agents per row when the population is laid out on the canvas grid.",
              "label": "Grid Columns",
              "tier": "presentation",
              "type": "number"
            },
            "gridMargin": {
              "default": 40.0,
              "description": "Margin in pixels between the grid of agents and the canvas edge.",
              "label": "Grid Margin",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 320.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "neighborhoodSize": {
              "default": 1.0,
              "description": "How many agents on each side (in row order) count as an agent's neighborhood when computing the local majority it conforms to.",
              "label": "Neighborhood Size",
              "synonyms": "neighborhood, reference group, peer influence, local majority",
              "tier": "domain",
              "type": "number"
            },
            "normColor": {
              "default": "#2563eb",
              "description": "Color of agents holding opinion 0 (the initial norm).",
              "label": "Norm Color",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Conformity & Deviance",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The conformity state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "CONFORMITY_UPDATED",
              "eventId": "evt_01M04DG94467BQ03TNNYQAGMPG",
              "payloadSchema": [
                {
                  "name": "stepCount",
                  "type": "number"
                },
                {
                  "name": "majorityPct",
                  "type": "number"
                },
                {
                  "name": "devianceRate",
                  "type": "number"
                },
                {
                  "name": "opinions",
                  "type": "[number]"
                }
              ],
              "scope": "external",
              "synonyms": "conformity update, step, local majority, deviance rate, convergence",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "devianceRate",
              "majorityPct",
              "nodes",
              "opinions",
              "stepCount",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SocConfScene": "ent_01M04DG9430Y0KXJDJ3PDJKV76"
          },
          "id": "trt_01M04DG943AN50MP31R4N712VE",
          "linkedEntity": "SocConfScene",
          "linkedEntityId": "ent_01M04DG9430Y0KXJDJ3PDJKV76",
          "name": "SocConfSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M04DG9431YNY5PVX7VPTX4J7",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M04DG94428KESGPRJWK2MSBK",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Step to advance the conformity simulation by one round of local-majority adoption.",
                "id": "evt_01M04DG9441YF9TGJBBJAJ3N9H",
                "key": "STEP",
                "name": "Step",
                "tier": "domain"
              },
              {
                "description": "Learner dragged the deviance-rate slider.",
                "id": "evt_01M04DG9441EGRCNF4FRGX90DD",
                "key": "SET_DEVIANCE",
                "name": "Set Deviance",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset to restore the initial population (a lone deviant in a conforming majority).",
                "id": "evt_01M04DG944SA8RQSHAZQZ47GVC",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The conformity state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04DG94467BQ03TNNYQAGMPG",
                "key": "CONFORMITY_UPDATED",
                "name": "Conformity Updated",
                "payloadSchema": [
                  {
                    "name": "stepCount",
                    "type": "number"
                  },
                  {
                    "name": "majorityPct",
                    "type": "number"
                  },
                  {
                    "name": "devianceRate",
                    "type": "number"
                  },
                  {
                    "name": "opinions",
                    "type": "[number]"
                  }
                ],
                "synonyms": "conformity update, step, local majority, deviance rate, convergence",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.devianceRate",
                    "@config.devianceRate"
                  ],
                  [
                    "set",
                    "@entity.stepCount",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "n",
                        "@config.agentCount"
                      ],
                      [
                        "opinionsInit",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "if",
                              [
                                "==",
                                "@i",
                                [
                                  "math/floor",
                                  [
                                    "/",
                                    "@n",
                                    2.0
                                  ]
                                ]
                              ],
                              1.0,
                              0.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "gridCols",
                        "@config.gridCols"
                      ],
                      [
                        "dx",
                        [
                          "/",
                          [
                            "-",
                            "@config.width",
                            [
                              "*",
                              2.0,
                              "@config.gridMargin"
                            ]
                          ],
                          [
                            "-",
                            "@gridCols",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "rowCount",
                        [
                          "+",
                          [
                            "math/floor",
                            [
                              "/",
                              [
                                "-",
                                "@n",
                                1.0
                              ],
                              "@gridCols"
                            ]
                          ],
                          1.0
                        ]
                      ],
                      [
                        "dy",
                        [
                          "/",
                          [
                            "-",
                            "@config.height",
                            [
                              "*",
                              2.0,
                              "@config.gridMargin"
                            ]
                          ],
                          [
                            "-",
                            "@rowCount",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "renderNodes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            {
                              "color": [
                                "if",
                                [
                                  "==",
                                  [
                                    "array/nth",
                                    "@opinionsInit",
                                    "@i"
                                  ],
                                  1.0
                                ],
                                "@config.deviantColor",
                                "@config.normColor"
                              ],
                              "id": [
                                "str/concat",
                                "a",
                                "@i"
                              ],
                              "label": "",
                              "radius": "@config.agentRadius",
                              "x": [
                                "+",
                                "@config.gridMargin",
                                [
                                  "*",
                                  [
                                    "math/mod",
                                    "@i",
                                    "@gridCols"
                                  ],
                                  "@dx"
                                ]
                              ],
                              "y": [
                                "+",
                                "@config.gridMargin",
                                [
                                  "*",
                                  [
                                    "math/floor",
                                    [
                                      "/",
                                      "@i",
                                      "@gridCols"
                                    ]
                                  ],
                                  "@dy"
                                ]
                              ]
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.opinions",
                        "@opinionsInit"
                      ],
                      [
                        "set",
                        "@entity.majorityPct",
                        [
                          "*",
                          100.0,
                          [
                            "/",
                            [
                              "-",
                              "@n",
                              1.0
                            ],
                            "@n"
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.nodes",
                        "@renderNodes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "STEP",
                                  "label": "Step",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": [],
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": [],
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Step ",
                                "@entity.stepCount",
                                " — majority share: ",
                                [
                                  "math/round",
                                  "@entity.majorityPct",
                                  1.0
                                ],
                                "%"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Deviance rate: ",
                                    "@entity.devianceRate",
                                    " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it."
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 0.5,
                                  "min": 0.0,
                                  "onChange": "SET_DEVIANCE",
                                  "showTooltip": true,
                                  "step": 0.01,
                                  "type": "range-slider",
                                  "value": "@entity.devianceRate"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M04DG9431YNY5PVX7VPTX4J7",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
