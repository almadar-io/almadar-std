          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNFCPZFE32QGT4Y8JVVT1FR",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNFCPZFN5PZYKP72C4MW738",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner toggled shading on one region of the three-circle diagram (universal-premise step of the Venn test).",
                "id": "evt_01KZNFCPZFVWGBTSHJAP3K6385",
                "key": "SHADE_REGION",
                "name": "Shade Region",
                "payloadSchema": [
                  {
                    "name": "region",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner toggled an ✕ mark on one region of the diagram (particular-premise step of the Venn test).",
                "id": "evt_01KZNFCPZF3K7N450Y53BAEB37",
                "key": "MARK_X",
                "name": "Mark X",
                "payloadSchema": [
                  {
                    "name": "region",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner asked whether the shaded and marked diagram makes the conclusion follow — the Venn validity test.",
                "id": "evt_01KZNFCPZFE092ME65CXFDXQMN",
                "key": "TEST_VALIDITY",
                "name": "Test Validity",
                "tier": "domain"
              },
              {
                "description": "Learner cleared all shading and ✕ marks to start the diagram over.",
                "id": "evt_01KZNFCPZFKZN3P3CSJW03F3X3",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The diagram state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNFCPZFYKQZ4VP59N8EY1WR",
                "key": "VENN_UPDATED",
                "name": "Venn Updated",
                "payloadSchema": [
                  {
                    "name": "shadedRegions",
                    "type": "[string]"
                  },
                  {
                    "name": "markedRegions",
                    "type": "[string]"
                  },
                  {
                    "name": "verdict",
                    "type": "string"
                  }
                ],
                "synonyms": "venn update, syllogism test, region shaded, existential mark, validity check",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.shadedRegions",
                    []
                  ],
                  [
                    "set",
                    "@entity.markedRegions",
                    []
                  ],
                  [
                    "set",
                    "@entity.verdict",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "circleShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.circles",
                            [
                              "fn",
                              "c",
                              [
                                {
                                  "color": [
                                    "object/get",
                                    "@c",
                                    "color"
                                  ],
                                  "fill": "transparent",
                                  "id": [
                                    "object/get",
                                    "@c",
                                    "id"
                                  ],
                                  "lineWidth": 2.0,
                                  "opacity": 1.0,
                                  "radius": [
                                    "object/get",
                                    "@c",
                                    "radius"
                                  ],
                                  "type": "circle",
                                  "x": [
                                    "object/get",
                                    "@c",
                                    "x"
                                  ],
                                  "y": [
                                    "object/get",
                                    "@c",
                                    "y"
                                  ]
                                },
                                {
                                  "align": "center",
                                  "color": [
                                    "object/get",
                                    "@c",
                                    "color"
                                  ],
                                  "fontSize": 15.0,
                                  "id": [
                                    "str/concat",
                                    "label-",
                                    [
                                      "object/get",
                                      "@c",
                                      "id"
                                    ]
                                  ],
                                  "text": [
                                    "object/get",
                                    [
                                      "array/find",
                                      "@config.propositionLabels",
                                      [
                                        "fn",
                                        "t",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@t",
                                            "key"
                                          ],
                                          [
                                            "object/get",
                                            "@c",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ],
                                    "label"
                                  ],
                                  "type": "text",
                                  "x": [
                                    "object/get",
                                    "@c",
                                    "x"
                                  ],
                                  "y": [
                                    "-",
                                    [
                                      "object/get",
                                      "@c",
                                      "y"
                                    ],
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@c",
                                        "radius"
                                      ],
                                      12.0
                                    ]
                                  ]
                                }
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "regionShapes",
                        [
                          "array/map",
                          "@config.regions",
                          [
                            "fn",
                            "r",
                            {
                              "color": "#94a3b8",
                              "fill": "transparent",
                              "id": [
                                "object/get",
                                "@r",
                                "id"
                              ],
                              "lineWidth": 1.0,
                              "opacity": 0.7,
                              "radius": 7.0,
                              "type": "circle",
                              "x": [
                                "object/get",
                                "@r",
                                "x"
                              ],
                              "y": [
                                "object/get",
                                "@r",
                                "y"
                              ]
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.shapes",
                        [
                          "array/concat",
                          "@circleShapes",
                          "@regionShapes"
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Premises: ",
                                [
                                  "str/join",
                                  "@config.premiseTypes",
                                  ". "
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Mood ",
                                "@config.mood",
                                " · Figure ",
                                "@config.figure"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.regions",
                                [
                                  "fn",
                                  "r",
                                  {
                                    "action": "SHADE_REGION",
                                    "actionPayload": {
                                      "region": [
                                        "object/get",
                                        "@r",
                                        "id"
                                      ]
                                    },
                                    "label": [
                                      "str/concat",
                                      "Shade ",
                                      [
                                        "object/get",
                                        "@r",
                                        "label"
                                      ]
