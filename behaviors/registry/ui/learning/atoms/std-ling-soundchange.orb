                ],
                "event": "INIT",
                "eventId": "evt_01KZEFXX38DCZC6AGE19B1CB2B",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.ruleIndex",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "wordCount",
                        [
                          "array/len",
                          "@config.soundWords"
                        ]
                      ],
                      [
                        "totalRules",
                        [
                          "array/len",
                          "@config.rules"
                        ]
                      ],
                      [
                        "soundRows",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@wordCount"
                          ],
                          [
                            "fn",
                            "idx",
                            [
                              "let",
                              [
                                [
                                  "w0",
                                  [
                                    "array/nth",
                                    "@config.soundWords",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "pronNow",
                                  [
                                    "str/replace",
                                    [
                                      "object/get",
                                      "@w0",
                                      "template"
                                    ],
                                    "{V}",
                                    [
                                      "object/get",
                                      "@w0",
                                      "vowel"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "changed": false,
                                "id": [
                                  "object/get",
                                  "@w0",
                                  "id"
                                ],
                                "orthography": [
                                  "object/get",
                                  "@w0",
                                  "orthography"
                                ],
                                "pronBefore": "@pronNow",
                                "pronNow": "@pronNow",
                                "vowel": [
                                  "object/get",
                                  "@w0",
                                  "vowel"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "soundShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@wordCount"
                            ],
                            [
                              "fn",
                              "idx",
                              [
                                "let",
                                [
                                  [
                                    "row",
                                    [
                                      "array/nth",
                                      "@soundRows",
                                      "@idx"
                                    ]
                                  ],
                                  [
                                    "rowY",
                                    [
                                      "+",
                                      "@config.topMargin",
                                      [
                                        "*",
                                        "@idx",
                                        "@config.rowHeight"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "align": "left",
                                    "color": "@config.orthographyColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "orth",
                                      "@idx"
                                    ],
                                    "text": [
                                      "object/get",
                                      "@row",
                                      "orthography"
                                    ],
                                    "type": "text",
                                    "x": "@config.orthColumnX",
                                    "y": "@rowY"
                                  },
                                  {
                                    "align": "left",
                                    "color": "@config.pronunciationColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "cur",
                                      "@idx"
                                    ],
                                    "text": [
                                      "str/concat",
                                      "/",
                                      [
                                        "object/get",
                                        "@row",
                                        "pronNow"
                                      ],
                                      "/"
                                    ],
                                    "type": "text",
                                    "x": "@config.pronColumnX",
                                    "y": "@rowY"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "nextRuleName",
                        [
                          "if",
                          [
                            ">",
                            "@totalRules",
                            0.0
                          ],
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@config.rules",
                              0.0
                            ],
                            "name"
                          ],
                          ""
                        ]
                      ],
                      [
                        "isDone",
                        [
                          "<=",
                          "@totalRules",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.shapes",
                        "@soundShapes"
                      ],
                      [
                        "set",
                        "@entity.changedSummary",
                        "none"
                      ],
                      [
                        "set",
                        "@entity.done",
                        "@isDone"
                      ],
                      [
                        "set",
                        "@entity.renderChildren",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "animate": false,
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@entity.shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": [
                              "str/concat",
                              "Next rule: ",
                              "@nextRuleName"
                            ],
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "children": [
                              {
                                "action": "APPLY_CHANGE",
                                "disabled": [
                                  "if",
                                  [
                                    "<=",
                                    "@totalRules",
                                    0.0
                                  ],
                                  true,
                                  false
                                ],
                                "label": "Apply Rule",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "RESET_CHANGES",
                                "label": "Reset Changes",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "content": "No rules applied yet — press Apply Rule to begin the Great Vowel Shift.",
                            "type": "typography",
                            "variant": "body"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEFXX39G19SRHPZ847BX5S2",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "totalRules",
                        [
                          "array/len",
                          "@config.rules"
                        ]
                      ],
                      [
                        "nextRuleIndex",
                        [
                          "math/min",
                          [
                            "+",
                            "@entity.ruleIndex",
                            1.0
                          ],
                          "@totalRules"
                        ]
                      ],
                      [
                        "appliedRules",
                        [
                          "array/take",
                          "@config.rules",
                          "@nextRuleIndex"
                        ]
                      ],
                      [
                        "priorRules",
                        [
                          "array/take",
                          "@config.rules",
                          "@entity.ruleIndex"
                        ]
                      ],
                      [
                        "wordCount",
                        [
                          "array/len",
                          "@config.soundWords"
                        ]
                      ],
                      [
                        "wordsNow",
                        [
                          "array/map",
                          "@config.soundWords",
                          [
                            "fn",
                            "w",
                            [
                              "array/reduce",
                              "@appliedRules",
                              "@w",
                              [
                                "fn",
                                [
                                  "acc",
                                  "r"
                                ],
                                [
                                  "if",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@acc",
                                      "vowel"
                                    ],
                                    [
                                      "object/get",
                                      "@r",
                                      "from"
                                    ]
                                  ],
                                  [
                                    "object/merge",
                                    "@acc",
                                    {
                                      "vowel": [
                                        "object/get",
                                        "@r",
                                        "to"
                                      ]
                                    }
                                  ],
                                  "@acc"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "wordsBefore",
                        [
                          "array/map",
                          "@config.soundWords",
                          [
                            "fn",
                            "w",
                            [
                              "array/reduce",
                              "@priorRules",
                              "@w",
                              [
                                "fn",
                                [
                                  "acc",
                                  "r"
                                ],
                                [
                                  "if",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@acc",
                                      "vowel"
                                    ],
                                    [
                                      "object/get",
                                      "@r",
                                      "from"
                                    ]
                                  ],
                                  [
                                    "object/merge",
                                    "@acc",
                                    {
                                      "vowel": [
                                        "object/get",
                                        "@r",
                                        "to"
                                      ]
                                    }
                                  ],
                                  "@acc"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "lastRule",
                        [
                          "array/nth",
                          "@config.rules",
                          "@entity.ruleIndex"
                        ]
                      ],
                      [
                        "soundRows",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@wordCount"
                          ],
                          [
                            "fn",
                            "idx",
                            [
                              "let",
                              [
                                [
                                  "w0",
                                  [
                                    "array/nth",
                                    "@config.soundWords",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "wNow",
                                  [
                                    "array/nth",
                                    "@wordsNow",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "wBefore",
                                  [
                                    "array/nth",
                                    "@wordsBefore",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "pronNow",
                                  [
                                    "str/replace",
                                    [
                                      "object/get",
                                      "@w0",
                                      "template"
                                    ],
                                    "{V}",
                                    [
                                      "object/get",
                                      "@wNow",
                                      "vowel"
                                    ]
                                  ]
                                ],
                                [
                                  "pronBefore",
                                  [
                                    "str/replace",
                                    [
                                      "object/get",
                                      "@w0",
                                      "template"
                                    ],
                                    "{V}",
                                    [
                                      "object/get",
                                      "@wBefore",
                                      "vowel"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "changed": [
                                  "!=",
                                  [
                                    "object/get",
                                    "@wNow",
                                    "vowel"
                                  ],
                                  [
                                    "object/get",
                                    "@wBefore",
                                    "vowel"
                                  ]
                                ],
                                "id": [
                                  "object/get",
                                  "@w0",
                                  "id"
                                ],
                                "orthography": [
                                  "object/get",
                                  "@w0",
                                  "orthography"
                                ],
                                "pronBefore": "@pronBefore",
                                "pronNow": "@pronNow",
                                "vowel": [
                                  "object/get",
                                  "@wNow",
                                  "vowel"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "changedRows",
                        [
                          "array/filter",
                          "@soundRows",
                          [
                            "fn",
                            "r",
                            [
                              "object/get",
                              "@r",
                              "changed"
                            ]
                          ]
                        ]
                      ],
                      [
                        "unaffectedRows",
                        [
                          "array/filter",
                          "@soundRows",
                          [
                            "fn",
                            "r",
                            [
                              "not",
                              [
                                "object/get",
                                "@r",
                                "changed"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "changedStr",
                        [
                          "if",
                          [
                            "==",
                            [
                              "array/len",
                              "@changedRows"
                            ],
                            0.0
                          ],
                          "none",
                          [
                            "str/join",
                            [
                              "array/map",
                              "@changedRows",
                              [
                                "fn",
                                "r",
                                [
                                  "str/concat",
                                  [
                                    "object/get",
                                    "@r",
                                    "orthography"
                                  ],
                                  " (",
                                  [
                                    "object/get",
                                    "@r",
                                    "pronBefore"
                                  ],
                                  "→",
                                  [
                                    "object/get",
                                    "@r",
                                    "pronNow"
                                  ],
                                  ")"
                                ]
                              ]
                            ],
                            ", "
                          ]
                        ]
                      ],
                      [
                        "unaffectedStr",
                        [
                          "if",
                          [
                            "==",
                            [
                              "array/len",
                              "@unaffectedRows"
                            ],
                            0.0
                          ],
                          "none",
                          [
                            "str/join",
                            [
                              "array/map",
                              "@unaffectedRows",
                              [
                                "fn",
                                "r",
                                [
                                  "str/concat",
                                  [
                                    "object/get",
                                    "@r",
                                    "orthography"
                                  ],
                                  " (vowel ",
                                  [
                                    "object/get",
                                    "@r",
                                    "vowel"
                                  ],
                                  " ≠ ",
                                  [
                                    "object/get",
                                    "@lastRule",
                                    "from"
                                  ],
                                  ")"
                                ]
                              ]
                            ],
                            ", "
                          ]
                        ]
                      ],
                      [
                        "readout",
                        [
                          "str/concat",
                          "Applied ",
                          [
                            "object/get",
                            "@lastRule",
                            "name"
                          ],
                          ". Changed: ",
                          "@changedStr",
                          ". Unaffected: ",
                          "@unaffectedStr",
                          "."
                        ]
                      ],
                      [
                        "isDone",
                        [
                          ">=",
                          "@nextRuleIndex",
                          "@totalRules"
                        ]
                      ],
                      [
                        "nextRuleName",
                        [
                          "if",
                          "@isDone",
                          "All rules applied.",
                          [
                            "str/concat",
                            "Next rule: ",
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@config.rules",
                                "@nextRuleIndex"
                              ],
                              "name"
                            ]
                          ]
                        ]
                      ],
                      [
                        "soundShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@wordCount"
                            ],
                            [
                              "fn",
                              "idx",
                              [
                                "let",
                                [
                                  [
                                    "row",
                                    [
                                      "array/nth",
                                      "@soundRows",
                                      "@idx"
                                    ]
                                  ],
                                  [
                                    "rowY",
                                    [
                                      "+",
                                      "@config.topMargin",
                                      [
                                        "*",
                                        "@idx",
                                        "@config.rowHeight"
                                      ]
                                    ]
                                  ],
                                  [
                                    "changed",
                                    [
                                      "object/get",
                                      "@row",
                                      "changed"
                                    ]
                                  ]
                                ],
                                [
                                  "if",
                                  "@changed",
                                  [
                                    {
                                      "align": "left",
                                      "color": "@config.orthographyColor",
                                      "fontSize": "@config.soundFontSize",
                                      "id": [
                                        "str/concat",
                                        "orth",
                                        "@idx"
                                      ],
                                      "text": [
                                        "object/get",
                                        "@row",
                                        "orthography"
                                      ],
                                      "type": "text",
                                      "x": "@config.orthColumnX",
                                      "y": "@rowY"
                                    },
                                    {
                                      "align": "left",
                                      "color": "@config.pronunciationColor",
                                      "fontSize": "@config.soundFontSize",
                                      "id": [
                                        "str/concat",
                                        "old",
                                        "@idx"
                                      ],
                                      "text": [
                                        "str/concat",
                                        "/",
                                        [
                                          "object/get",
                                          "@row",
                                          "pronBefore"
                                        ],
                                        "/"
                                      ],
                                      "type": "text",
                                      "x": "@config.pronColumnX",
                                      "y": "@rowY"
                                    },
                                    {
                                      "color": "@config.arrowColor",
                                      "id": [
                                        "str/concat",
                                        "arr",
                                        "@idx"
                                      ],
                                      "lineWidth": 2.0,
                                      "type": "arrow",
                                      "x1": "@config.arrowX1",
                                      "x2": "@config.arrowX2",
                                      "y1": "@rowY",
                                      "y2": "@rowY"
                                    },
                                    {
                                      "align": "left",
                                      "color": "@config.changedPronunciationColor",
                                      "fontSize": "@config.soundFontSize",
                                      "id": [
                                        "str/concat",
                                        "new",
                                        "@idx"
                                      ],
                                      "text": [
                                        "str/concat",
                                        "/",
                                        [
                                          "object/get",
                                          "@row",
                                          "pronNow"
                                        ],
                                        "/"
                                      ],
                                      "type": "text",
                                      "x": "@config.newPronColumnX",
                                      "y": "@rowY"
                                    }
                                  ],
                                  [
                                    {
                                      "align": "left",
                                      "color": "@config.orthographyColor",
                                      "fontSize": "@config.soundFontSize",
                                      "id": [
                                        "str/concat",
                                        "orth",
                                        "@idx"
                                      ],
                                      "text": [
                                        "object/get",
                                        "@row",
                                        "orthography"
                                      ],
                                      "type": "text",
                                      "x": "@config.orthColumnX",
                                      "y": "@rowY"
                                    },
                                    {
                                      "align": "left",
                                      "color": "@config.pronunciationColor",
                                      "fontSize": "@config.soundFontSize",
                                      "id": [
                                        "str/concat",
                                        "cur",
                                        "@idx"
                                      ],
                                      "text": [
                                        "str/concat",
                                        "/",
                                        [
                                          "object/get",
                                          "@row",
                                          "pronNow"
                                        ],
                                        "/"
                                      ],
                                      "type": "text",
                                      "x": "@config.pronColumnX",
                                      "y": "@rowY"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.ruleIndex",
                        "@nextRuleIndex"
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@soundShapes"
                      ],
                      [
                        "set",
                        "@entity.changedSummary",
                        "@changedStr"
                      ],
                      [
                        "set",
                        "@entity.done",
                        "@isDone"
                      ],
                      [
                        "set",
                        "@entity.renderChildren",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "animate": false,
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@entity.shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": "@nextRuleName",
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "children": [
                              {
                                "action": "APPLY_CHANGE",
                                "disabled": [
                                  "if",
                                  "@isDone",
                                  true,
                                  false
                                ],
                                "label": "Apply Rule",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "RESET_CHANGES",
                                "label": "Reset Changes",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "content": "@readout",
                            "type": "typography",
                            "variant": "body"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "SOUNDCHANGE_UPDATED",
                    {
                      "changed": "@entity.changedSummary",
                      "done": "@entity.done",
                      "ruleIndex": "@entity.ruleIndex",
                      "totalRules": [
                        "array/len",
                        "@config.rules"
                      ]
                    }
                  ]
                ],
                "event": "APPLY_CHANGE",
                "eventId": "evt_01KZEFXX39Q4T78C9W2BP0EAHH",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.ruleIndex",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "totalRules",
                        [
                          "array/len",
                          "@config.rules"
                        ]
                      ],
                      [
                        "wordCount",
                        [
                          "array/len",
                          "@config.soundWords"
                        ]
                      ],
                      [
                        "soundRows",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@wordCount"
                          ],
                          [
                            "fn",
                            "idx",
                            [
                              "let",
                              [
                                [
                                  "w0",
                                  [
                                    "array/nth",
                                    "@config.soundWords",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "pronNow",
                                  [
                                    "str/replace",
                                    [
                                      "object/get",
                                      "@w0",
                                      "template"
                                    ],
                                    "{V}",
                                    [
                                      "object/get",
                                      "@w0",
                                      "vowel"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "changed": false,
                                "id": [
                                  "object/get",
                                  "@w0",
                                  "id"
                                ],
                                "orthography": [
                                  "object/get",
                                  "@w0",
                                  "orthography"
                                ],
                                "pronBefore": "@pronNow",
                                "pronNow": "@pronNow",
                                "vowel": [
                                  "object/get",
                                  "@w0",
                                  "vowel"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "soundShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@wordCount"
                            ],
                            [
                              "fn",
                              "idx",
                              [
                                "let",
                                [
                                  [
                                    "row",
                                    [
                                      "array/nth",
                                      "@soundRows",
                                      "@idx"
                                    ]
                                  ],
                                  [
                                    "rowY",
                                    [
                                      "+",
                                      "@config.topMargin",
                                      [
                                        "*",
                                        "@idx",
                                        "@config.rowHeight"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "align": "left",
                                    "color": "@config.orthographyColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "orth",
                                      "@idx"
                                    ],
                                    "text": [
                                      "object/get",
                                      "@row",
                                      "orthography"
                                    ],
                                    "type": "text",
                                    "x": "@config.orthColumnX",
                                    "y": "@rowY"
                                  },
                                  {
                                    "align": "left",
                                    "color": "@config.pronunciationColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "cur",
                                      "@idx"
                                    ],
                                    "text": [
                                      "str/concat",
                                      "/",
                                      [
                                        "object/get",
                                        "@row",
                                        "pronNow"
                                      ],
                                      "/"
                                    ],
                                    "type": "text",
                                    "x": "@config.pronColumnX",
                                    "y": "@rowY"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "nextRuleName",
                        [
                          "if",
                          [
                            ">",
                            "@totalRules",
                            0.0
                          ],
                          [
                            "str/concat",
                            "Next rule: ",
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@config.rules",
                                0.0
                              ],
                              "name"
                            ]
                          ],
                          "All rules applied."
                        ]
                      ],
                      [
                        "isDone",
                        [
                          "<=",
                          "@totalRules",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.shapes",
                        "@soundShapes"
                      ],
                      [
                        "set",
                        "@entity.changedSummary",
                        "none"
                      ],
                      [
                        "set",
                        "@entity.done",
                        "@isDone"
                      ],
                      [
                        "set",
                        "@entity.renderChildren",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "animate": false,
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@entity.shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": "@nextRuleName",
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "children": [
                              {
                                "action": "APPLY_CHANGE",
                                "disabled": [
                                  "if",
                                  [
                                    "<=",
                                    "@totalRules",
                                    0.0
                                  ],
                                  true,
                                  false
                                ],
                                "label": "Apply Rule",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "RESET_CHANGES",
                                "label": "Reset Changes",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "content": "No rules applied yet — press Apply Rule to begin the Great Vowel Shift.",
                            "type": "typography",
                            "variant": "body"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "SOUNDCHANGE_UPDATED",
                    {
                      "changed": "@entity.changedSummary",
                      "done": "@entity.done",
                      "ruleIndex": "@entity.ruleIndex",
                      "totalRules": [
                        "array/len",
                        "@config.rules"
                      ]
                    }
                  ]
                ],
                "event": "RESET_CHANGES",
                "eventId": "evt_01KZEFXX39DJE3JGBGJND9NHTS",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}