            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "newPronColumnX": {
              "default": 400.0,
              "description": "Horizontal position of the post-change pronunciation column, shown only for words that just changed.",
              "label": "Shifted Pronunciation Column X (px)",
              "tier": "presentation",
              "type": "number"
            },
            "orthColumnX": {
              "default": 40.0,
              "description": "Horizontal position of the orthographic spelling column.",
              "label": "Spelling Column X (px)",
              "tier": "presentation",
              "type": "number"
            },
            "orthographyColor": {
              "default": "#0f172a",
              "label": "Spelling Text Color",
              "tier": "presentation",
              "type": "string"
            },
            "pronColumnX": {
              "default": 200.0,
              "description": "Horizontal position of the current (or pre-change) pronunciation column.",
              "label": "Pronunciation Column X (px)",
              "tier": "presentation",
              "type": "number"
            },
            "pronunciationColor": {
              "default": "#64748b",
              "label": "Pronunciation Text Color",
              "tier": "presentation",
              "type": "string"
            },
            "rowHeight": {
              "default": 56.0,
              "description": "Vertical distance between successive word rows, in pixels.",
              "label": "Row Height (px)",
              "tier": "presentation",
              "type": "number"
            },
            "rules": {
              "default": [
                {
                  "explanation": "Middle English long high front vowel /iː/ diphthongizes to /aɪ/, as in modern \"bite\" and \"time\".",
                  "from": "iː",
                  "name": "Great Vowel Shift — /iː/ diphthongizes",
                  "to": "aɪ"
                },
                {
                  "explanation": "Middle English long high back vowel /uː/ diphthongizes to /aʊ/, as in modern \"mouse\" and \"house\".",
                  "from": "uː",
                  "name": "Great Vowel Shift — /uː/ diphthongizes",
                  "to": "aʊ"
                },
                {
                  "explanation": "Middle English long mid back vowel /oː/ raises to /uː/, as in modern \"goose\".",
                  "from": "oː",
                  "name": "Great Vowel Shift — /oː/ raises",
                  "to": "uː"
                }
              ],
              "description": "Ordered roster of sound-change rules applied one at a time. Each Apply Rule press applies the NEXT rule in this order to every word whose current vowel equals its \"from\" value, replacing it with \"to\" — demonstrating that sound change is regular (it strikes every matching word, not just some).",
              "items": {
                "properties": {
                  "explanation": {
                    "name": "explanation",
                    "required": false,
                    "type": "string"
                  },
                  "from": {
                    "name": "from",
                    "required": true,
                    "type": "string"
                  },
                  "name": {
                    "name": "name",
                    "required": true,
                    "type": "string"
                  },
                  "to": {
                    "name": "to",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Sound-change Rules",
              "synonyms": "sound law, rule ordering, regular sound change, phonetic rule, vowel shift rule",
              "tier": "domain",
              "type": "[LingSoundchangeRule]"
            },
            "soundFontSize": {
              "default": 18.0,
              "label": "Sound-change Font Size",
              "tier": "presentation",
              "type": "number"
            },
            "soundWords": {
              "default": [
                {
                  "id": "w1",
                  "orthography": "bite",
                  "template": "b{V}t",
                  "vowel": "iː"
                },
                {
                  "id": "w2",
                  "orthography": "time",
                  "template": "t{V}m",
                  "vowel": "iː"
                },
                {
                  "id": "w3",
                  "orthography": "mouse",
                  "template": "m{V}s",
                  "vowel": "uː"
                },
                {
                  "id": "w4",
                  "orthography": "house",
                  "template": "h{V}s",
                  "vowel": "uː"
                },
                {
                  "id": "w5",
                  "orthography": "goose",
                  "template": "g{V}s",
                  "vowel": "oː"
                },
                {
                  "id": "w6",
                  "orthography": "feet",
                  "template": "f{V}t",
                  "vowel": "eː"
                }
              ],
              "description": "Roster of Middle English words stepped through the sound-change rules. Each word carries its modern spelling (orthography), a pronunciation template with a {V} slot, and its starting long-vowel symbol; the template is substituted with the word's current vowel via str/replace to render its live pronunciation.",
              "items": {
                "properties": {
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "orthography": {
                    "name": "orthography",
                    "required": true,
                    "type": "string"
                  },
                  "template": {
                    "name": "template",
                    "required": true,
                    "type": "string"
                  },
                  "vowel": {
                    "name": "vowel",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Sound-change Words",
              "synonyms": "vowel roster, word list, pronunciation template, Middle English word",
              "tier": "domain",
              "type": "[LingSoundchangeSoundWord]"
            },
            "title": {
              "default": "Sound Change Stepper",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "topMargin": {
              "default": 40.0,
              "description": "Vertical offset of the first word row from the top of the canvas, in pixels.",
              "label": "Top Margin (px)",
              "tier": "presentation",
              "type": "number"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The sound-change state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "SOUNDCHANGE_UPDATED",
              "eventId": "evt_01KZEFXX39YBXJ51XACXFWCTEG",
              "payloadSchema": [
                {
                  "name": "ruleIndex",
                  "type": "number"
                },
                {
                  "name": "totalRules",
                  "type": "number"
                },
                {
                  "name": "changed",
                  "type": "string"
                },
                {
                  "name": "done",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "sound change update, rule applied, vowel shift progress, Great Vowel Shift step",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "changedSummary",
              "done",
              "renderChildren",
              "ruleIndex",
              "shapes",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "LingSoundchangeScene": "ent_01KZEFXX380AV07DGE57YHB1EG"
          },
          "id": "trt_01KZEFXX38FHM0R91A9358B2B1",
          "linkedEntity": "LingSoundchangeScene",
          "linkedEntityId": "ent_01KZEFXX380AV07DGE57YHB1EG",
          "name": "LingSoundchangeSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFXX38DCZC6AGE19B1CB2B",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFXX39G19SRHPZ847BX5S2",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner applied the next ordered sound-change rule, striking every word whose current vowel matches it.",
                "id": "evt_01KZEFXX39Q4T78C9W2BP0EAHH",
                "key": "APPLY_CHANGE",
                "name": "Apply Change",
                "tier": "domain"
              },
              {
                "description": "Learner reset all words back to their original vowels, undoing every applied rule.",
                "id": "evt_01KZEFXX39DJE3JGBGJND9NHTS",
                "key": "RESET_CHANGES",
                "name": "Reset Changes",
                "tier": "domain"
              },
              {
                "description": "The sound-change state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFXX39YBXJ51XACXFWCTEG",
                "key": "SOUNDCHANGE_UPDATED",
                "name": "Soundchange Updated",
                "payloadSchema": [
                  {
                    "name": "ruleIndex",
                    "type": "number"
                  },
                  {
                    "name": "totalRules",
                    "type": "number"
                  },
                  {
                    "name": "changed",
                    "type": "string"
                  },
                  {
                    "name": "done",
                    "type": "boolean"
                  }
                ],
                "synonyms": "sound change update, rule applied, vowel shift progress, Great Vowel Shift step",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.ruleIndex",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "wordCount",
                        [
                          "array/len",
                          "@config.soundWords"
                        ]
                      ],
                      [
                        "totalRules",
                        [
                          "array/len",
                          "@config.rules"
                        ]
                      ],
                      [
                        "soundRows",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@wordCount"
                          ],
                          [
                            "fn",
                            "idx",
                            [
                              "let",
                              [
                                [
                                  "w0",
                                  [
                                    "array/nth",
                                    "@config.soundWords",
                                    "@idx"
                                  ]
                                ],
                                [
                                  "pronNow",
                                  [
                                    "str/replace",
                                    [
                                      "object/get",
                                      "@w0",
                                      "template"
                                    ],
                                    "{V}",
                                    [
                                      "object/get",
                                      "@w0",
                                      "vowel"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "changed": false,
                                "id": [
                                  "object/get",
                                  "@w0",
                                  "id"
                                ],
                                "orthography": [
                                  "object/get",
                                  "@w0",
                                  "orthography"
                                ],
                                "pronBefore": "@pronNow",
                                "pronNow": "@pronNow",
                                "vowel": [
                                  "object/get",
                                  "@w0",
                                  "vowel"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "soundShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@wordCount"
                            ],
                            [
                              "fn",
                              "idx",
                              [
                                "let",
                                [
                                  [
                                    "row",
                                    [
                                      "array/nth",
                                      "@soundRows",
                                      "@idx"
                                    ]
                                  ],
                                  [
                                    "rowY",
                                    [
                                      "+",
                                      "@config.topMargin",
                                      [
                                        "*",
                                        "@idx",
                                        "@config.rowHeight"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "align": "left",
                                    "color": "@config.orthographyColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "orth",
                                      "@idx"
                                    ],
                                    "text": [
                                      "object/get",
                                      "@row",
                                      "orthography"
                                    ],
                                    "type": "text",
                                    "x": "@config.orthColumnX",
                                    "y": "@rowY"
                                  },
                                  {
                                    "align": "left",
                                    "color": "@config.pronunciationColor",
                                    "fontSize": "@config.soundFontSize",
                                    "id": [
                                      "str/concat",
                                      "cur",
                                      "@idx"
                                    ],
                                    "text": [
                                      "str/concat",
                                      "/",
                                      [
                                        "object/get",
                                        "@row",
                                        "pronNow"
                                      ],
                                      "/"
                                    ],
                                    "type": "text",
                                    "x": "@config.pronColumnX",
                                    "y": "@rowY"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "nextRuleName",
                        [
                          "if",
                          [
                            ">",
                            "@totalRules",
                            0.0
                          ],
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@config.rules",
                              0.0
                            ],
                            "name"
                          ],
                          ""
                        ]
                      ],
                      [
                        "isDone",
                        [
                          "<=",
                          "@totalRules",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
