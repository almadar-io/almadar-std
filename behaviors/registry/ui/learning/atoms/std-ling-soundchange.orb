                          },
                          {
                            "content": "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "animate": false,
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@entity.shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": [
                              "str/concat",
