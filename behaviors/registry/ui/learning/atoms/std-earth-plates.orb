                            "@config.width",
                            "@margin"
                          ],
                          "@rightX"
                        ]
                      ],
                      [
                        "halfCount",
                        [
                          "math/floor",
                          [
                            "/",
                            "@entity.advanceSteps",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "volcanoShapes",
                        [
                          "if",
                          [
                            "and",
                            "@isConvergent",
                            [
                              "<=",
                              "@config.volcanoThresholdSteps",
                              "@entity.advanceSteps"
                            ]
                          ],
                          [
                            {
                              "color": "@config.volcanoColor",
                              "lineWidth": 3.0,
                              "type": "line",
                              "x1": [
                                "+",
                                "@rightX",
                                20.0
                              ],
                              "x2": [
                                "+",
                                "@rightX",
                                34.0
                              ],
                              "y1": "@surfaceY",
                              "y2": [
                                "-",
                                "@surfaceY",
                                40.0
                              ]
                            },
                            {
                              "color": "@config.volcanoColor",
                              "lineWidth": 3.0,
                              "type": "line",
                              "x1": [
                                "+",
                                "@rightX",
                                34.0
                              ],
                              "x2": [
                                "+",
                                "@rightX",
                                48.0
                              ],
                              "y1": [
                                "-",
                                "@surfaceY",
                                40.0
                              ],
                              "y2": "@surfaceY"
                            }
                          ],
                          []
                        ]
                      ],
                      [
                        "quakeNodes",
                        [
                          "if",
                          "@isConvergent",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@entity.advanceSteps"
                            ],
                            [
                              "fn",
                              "idx",
                              {
                                "color": "@config.quakeColor",
                                "id": [
                                  "str/concat",
                                  "q",
                                  "@idx"
                                ],
                                "label": "",
                                "radius": 5.0,
                                "x": [
                                  "+",
                                  "@midX",
                                  [
                                    "*",
                                    "@idx",
                                    14.0
                                  ]
                                ],
                                "y": [
                                  "+",
                                  "@surfaceY",
                                  [
                                    "*",
                                    "@idx",
                                    18.0
                                  ]
                                ]
                              }
                            ]
                          ],
                          [
                            "if",
                            "@isTransform",
                            [
                              "array/map",
                              [
                                "array/range",
                                "@entity.advanceSteps"
                              ],
                              [
                                "fn",
                                "idx",
                                [
                                  "let",
                                  [
                                    [
                                      "dx",
                                      [
                                        "*",
                                        [
                                          "-",
                                          "@idx",
                                          "@halfCount"
                                        ],
                                        "@config.transformQuakeSpacing"
                                      ]
                                    ]
                                  ],
                                  {
                                    "color": "@config.quakeColor",
                                    "id": [
                                      "str/concat",
                                      "q",
                                      "@idx"
                                    ],
                                    "label": "",
                                    "radius": 5.0,
                                    "x": [
                                      "+",
                                      "@midX",
                                      "@dx"
                                    ],
                                    "y": [
                                      "+",
                                      "@surfaceY",
                                      8.0
                                    ]
                                  }
                                ]
                              ]
                            ],
                            []
                          ]
                        ]
                      ],
                      [
                        "ridgeShapes",
                        [
                          "if",
                          "@isDivergent",
                          [
                            {
                              "color": "@config.crustNewColor",
                              "lineWidth": 3.0,
                              "type": "line",
                              "x1": [
                                "-",
                                "@midX",
                                14.0
                              ],
                              "x2": "@midX",
                              "y1": "@surfaceY",
                              "y2": [
                                "-",
                                "@surfaceY",
                                20.0
                              ]
                            },
                            {
                              "color": "@config.crustNewColor",
                              "lineWidth": 3.0,
                              "type": "line",
                              "x1": "@midX",
                              "x2": [
                                "+",
                                "@midX",
                                14.0
                              ],
                              "y1": [
                                "-",
                                "@surfaceY",
                                20.0
                              ],
                              "y2": "@surfaceY"
                            }
                          ],
                          []
                        ]
                      ],
                      [
                        "riftBand",
                        [
                          "if",
                          "@isDivergent",
                          [
                            {
                              "color": "@config.crustNewColor",
                              "fill": "@config.crustNewColor",
                              "height": 16.0,
                              "type": "rect",
                              "width": [
                                "*",
                                "@gapHalf",
                                2.0
                              ],
                              "x": [
                                "-",
                                "@midX",
                                "@gapHalf"
                              ],
                              "y": "@surfaceY"
                            }
                          ],
                          []
                        ]
                      ],
                      [
                        "trenchLine",
                        [
                          "if",
                          "@isConvergent",
                          [
                            {
                              "color": "#475569",
                              "lineWidth": 2.0,
                              "type": "line",
                              "x1": "@midX",
                              "x2": [
                                "+",
                                "@midX",
                                [
                                  "*",
                                  "@entity.advanceSteps",
                                  14.0
                                ]
                              ],
                              "y1": "@surfaceY",
                              "y2": [
                                "+",
                                "@surfaceY",
                                [
                                  "*",
                                  "@entity.advanceSteps",
                                  18.0
                                ]
                              ]
                            }
                          ],
                          []
                        ]
                      ],
                      [
                        "faultLine",
                        [
                          "if",
                          "@isTransform",
                          [
                            {
                              "color": "#475569",
                              "lineWidth": 2.0,
                              "type": "line",
                              "x1": "@midX",
                              "x2": "@midX",
                              "y1": [
                                "-",
                                "@surfaceY",
                                12.0
                              ],
                              "y2": [
                                "+",
                                "@surfaceY",
                                12.0
                              ]
                            }
                          ],
                          []
                        ]
                      ],
                      [
                        "plateShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            [
                              "array/concat",
                              [
                                "array/concat",
                                [
                                  "array/concat",
                                  [
                                    {
                                      "color": "@config.plateColorLeft",
                                      "fill": "@config.plateColorLeft",
                                      "height": "@plateDepth",
                                      "type": "rect",
                                      "width": "@leftWidth",
                                      "x": "@margin",
                                      "y": "@surfaceY"
                                    },
                                    {
                                      "color": "@config.plateColorRight",
                                      "fill": "@config.plateColorRight",
                                      "height": "@plateDepth",
                                      "type": "rect",
                                      "width": "@rightWidth",
                                      "x": "@rightX",
                                      "y": "@surfaceY"
                                    }
                                  ],
                                  "@trenchLine"
                                ],
                                "@faultLine"
                              ],
                              "@riftBand"
                            ],
                            "@ridgeShapes"
                          ],
                          "@volcanoShapes"
                        ]
                      ],
                      [
                        "landformLabel",
                        [
                          "if",
                          [
                            "==",
                            "@entity.advanceSteps",
                            0.0
                          ],
                          [
                            "str/concat",
                            "No motion yet — ",
                            [
                              "object/get",
                              "@selected",
                              "description"
                            ]
                          ],
                          [
                            "object/get",
                            "@selected",
                            "landform"
                          ]
                        ]
                      ],
                      [
                        "quakeProfileLabel",
                        [
                          "str/concat",
                          [
                            "object/get",
                            "@selected",
                            "quakeProfile"
                          ],
                          " — ",
                          "@entity.advanceSteps",
                          " event(s) recorded"
                        ]
                      ],
                      [
                        "boundaryDescription",
                        [
                          "object/get",
                          "@selected",
                          "description"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.nodes",
                        "@quakeNodes"
                      ],
                      [
                        "set",
                        "@entity.edges",
                        []
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@plateShapes"
                      ],
                      [
                        "set",
                        "@entity.landformLabel",
                        "@landformLabel"
                      ],
                      [
                        "set",
                        "@entity.quakeProfileLabel",
                        "@quakeProfileLabel"
                      ],
                      [
                        "set",
                        "@entity.boundaryDescription",
                        "@boundaryDescription"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.boundaries",
                                [
                                  "fn",
                                  "bnd",
                                  {
                                    "action": "SELECT_BOUNDARY",
                                    "actionPayload": {
                                      "boundaryType": [
                                        "object/get",
                                        "@bnd",
                                        "type"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@bnd",
                                      "label"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.boundaryType",
                                        [
                                          "object/get",
                                          "@bnd",
                                          "type"
                                        ]
                                      ],
                                      "primary",
                                      "ghost"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.boundaryDescription",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": "@entity.shapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                {
                                  "action": "ADVANCE",
                                  "disabled": [
                                    "if",
                                    [
                                      "<=",
                                      "@config.maxAdvanceSteps",
                                      "@entity.advanceSteps"
                                    ],
                                    true,
                                    false
                                  ],
                                  "label": [
                                    "str/concat",
                                    "Advance ",
                                    "@config.advanceStepYears",
                                    " Million Years"
                                  ],
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": "@entity.landformLabel",
                                  "type": "typography",
                                  "variant": "h4"
                                },
                                {
                                  "content": "@entity.quakeProfileLabel",
                                  "type": "typography",
                                  "variant": "caption"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "PLATES_UPDATED",
                    {
                      "advanceSteps": "@entity.advanceSteps",
                      "boundaryType": "@entity.boundaryType",
                      "landformLabel": "@entity.landformLabel",
                      "quakeProfileLabel": "@entity.quakeProfileLabel"
                    }
                  ]
                ],
                "event": "ADVANCE",
                "eventId": "evt_01KZEFVJC0QCVVHGVTDJWM4Y6N",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}