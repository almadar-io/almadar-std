      "traits": [
        {
          "category": "interaction",
          "config": {
            "advanceStepYears": {
              "default": 5.0,
              "description": "How many million years each Advance press represents, shown on the button label.",
              "label": "Advance Step (million years)",
              "tier": "presentation",
              "type": "number"
            },
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f0f9ff",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "boundaries": {
              "default": [
                {
                  "description": "Two plates move toward each other; the denser oceanic plate subducts beneath the other.",
                  "label": "Convergent",
                  "landform": "Subduction zone — volcanic arc and mountain range",
                  "quakeProfile": "Deep, inclined seismicity along the subducting slab (Wadati-Benioff zone)",
                  "type": "convergent"
                },
                {
                  "description": "Two plates move apart; magma rises to fill the gap, forming new crust.",
                  "label": "Divergent",
                  "landform": "Rift valley / mid-ocean ridge with new oceanic crust",
                  "quakeProfile": "Shallow seismicity concentrated along the rift axis",
                  "type": "divergent"
                },
                {
                  "description": "Two plates slide past each other horizontally; no crust is created or destroyed.",
                  "label": "Transform",
                  "landform": "Transform fault with lateral (strike-slip) offset",
                  "quakeProfile": "Shallow, strike-slip seismicity along the fault trace",
                  "type": "transform"
                }
              ],
              "description": "Roster of the three plate-boundary types the learner can pick, each carrying the label/description shown and the landform + quake-profile text used in the readout.",
              "items": {
                "properties": {
                  "description": {
                    "name": "description",
                    "required": false,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "landform": {
                    "name": "landform",
                    "required": false,
                    "type": "string"
                  },
                  "quakeProfile": {
                    "name": "quakeProfile",
                    "required": false,
                    "type": "string"
                  },
                  "type": {
                    "name": "type",
                    "required": true,
                    "type": "string",
                    "values": [
                      "convergent",
                      "divergent",
                      "transform"
                    ]
                  }
                },
                "type": "object"
              },
              "label": "Boundaries",
              "tier": "domain",
              "type": "[EarthPlatesBoundary]"
            },
            "convergeRatePixels": {
              "default": 3.0,
              "description": "How many pixels the gap closes per Advance press in convergent mode.",
              "label": "Convergence Rate (px/step)",
              "tier": "domain",
              "type": "number"
            },
            "crustNewColor": {
              "default": "#f97316",
              "description": "Color of freshly formed crust at a divergent rift.",
              "label": "New Crust Color",
              "tier": "presentation",
              "type": "string"
            },
            "divergeRatePixels": {
              "default": 4.0,
              "description": "How many pixels the rift widens per Advance press in divergent mode.",
              "label": "Divergence Rate (px/step)",
              "tier": "domain",
              "type": "number"
            },
            "height": {
              "default": 420.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "maxAdvanceSteps": {
              "default": 8.0,
              "description": "Caps how many times the learner can press Advance.",
              "label": "Max Advance Steps",
              "tier": "domain",
              "type": "number"
            },
            "plateColorLeft": {
              "default": "#92400e",
              "label": "Left Plate Color",
              "tier": "presentation",
              "type": "string"
            },
            "plateColorRight": {
              "default": "#78350f",
              "label": "Right Plate Color",
              "tier": "presentation",
              "type": "string"
            },
            "plateGapHalf": {
              "default": 26.0,
              "description": "Half the starting gap between the two plates, in pixels, before any advance.",
              "label": "Initial Half-Gap (px)",
              "tier": "domain",
              "type": "number"
            },
            "quakeColor": {
              "default": "#1e293b",
              "label": "Quake Marker Color",
              "tier": "presentation",
              "type": "string"
            },
            "shearRatePixels": {
              "default": 6.0,
              "description": "How many pixels the fault offsets per Advance press in transform mode.",
              "label": "Shear Rate (px/step)",
              "tier": "domain",
              "type": "number"
            },
            "title": {
              "default": "Earth Lab",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "transformQuakeSpacing": {
              "default": 10.0,
              "description": "Horizontal spacing between successive quake markers along a transform fault.",
              "label": "Transform Quake Spacing (px)",
              "tier": "domain",
              "type": "number"
            },
            "volcanoColor": {
              "default": "#dc2626",
              "label": "Volcano Color",
              "tier": "presentation",
              "type": "string"
            },
            "volcanoThresholdSteps": {
              "default": 3.0,
              "description": "Number of Advance presses in convergent mode before the volcanic arc appears.",
              "label": "Volcano Threshold (steps)",
              "tier": "domain",
              "type": "number"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The plate-boundary state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "PLATES_UPDATED",
              "eventId": "evt_01KZEFVJC03HHAHZ7TD2HHYDPY",
              "payloadSchema": [
                {
                  "name": "boundaryType",
                  "type": "string"
                },
                {
                  "name": "advanceSteps",
                  "type": "number"
                },
                {
                  "name": "landformLabel",
                  "type": "string"
                },
                {
                  "name": "quakeProfileLabel",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "plate boundary update, landform, earthquake, subduction, rift, transform fault",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "advanceSteps",
              "boundaryDescription",
              "boundaryType",
              "edges",
              "landformLabel",
              "nodes",
              "quakeProfileLabel",
              "shapes",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "EarthPlatesScene": "ent_01KZEFVJC0WGY8R9P457MVQ9AG"
          },
          "id": "trt_01KZEFVJC0J4860BQ3WMECC270",
          "linkedEntity": "EarthPlatesScene",
          "linkedEntityId": "ent_01KZEFVJC0WGY8R9P457MVQ9AG",
          "name": "EarthPlatesSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFVJC01GJRG379X49XXXJG",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFVJC0JSDVWWQTTFVPA4G6",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked a plate boundary type (convergent, divergent, or transform).",
                "id": "evt_01KZEFVJC0K54A78R900V0VZCA",
                "key": "SELECT_BOUNDARY",
                "name": "Select Boundary",
                "payloadSchema": [
                  {
                    "name": "boundaryType",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Advance to step plate motion forward, accumulating landforms and earthquakes.",
                "id": "evt_01KZEFVJC0QCVVHGVTDJWM4Y6N",
                "key": "ADVANCE",
                "name": "Advance",
                "tier": "domain"
              },
              {
                "description": "The plate-boundary state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFVJC03HHAHZ7TD2HHYDPY",
                "key": "PLATES_UPDATED",
                "name": "Plates Updated",
                "payloadSchema": [
                  {
                    "name": "boundaryType",
                    "type": "string"
                  },
                  {
                    "name": "advanceSteps",
                    "type": "number"
                  },
                  {
                    "name": "landformLabel",
                    "type": "string"
                  },
                  {
                    "name": "quakeProfileLabel",
                    "type": "string"
                  }
                ],
                "synonyms": "plate boundary update, landform, earthquake, subduction, rift, transform fault",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.boundaryType",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.boundaries",
                        0.0
                      ],
                      "type"
                    ]
                  ],
                  [
                    "set",
                    "@entity.advanceSteps",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "selected",
                        [
                          "if",
                          [
                            "==",
                            "@entity.boundaryType",
                            "convergent"
                          ],
                          [
                            "array/nth",
                            "@config.boundaries",
                            0.0
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@entity.boundaryType",
                              "divergent"
                            ],
                            [
                              "array/nth",
                              "@config.boundaries",
                              1.0
                            ],
                            [
                              "array/nth",
                              "@config.boundaries",
                              2.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "margin",
                        24.0
                      ],
                      [
                        "midX",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "surfaceY",
                        [
                          "*",
                          "@config.height",
                          0.45
                        ]
                      ],
                      [
                        "plateDepth",
                        [
                          "-",
                          [
                            "-",
                            "@config.height",
                            "@margin"
                          ],
                          "@surfaceY"
                        ]
                      ],
                      [
                        "isConvergent",
                        [
                          "==",
                          "@entity.boundaryType",
                          "convergent"
                        ]
                      ],
                      [
                        "isDivergent",
                        [
                          "==",
                          "@entity.boundaryType",
                          "divergent"
                        ]
                      ],
                      [
                        "isTransform",
                        [
                          "==",
                          "@entity.boundaryType",
                          "transform"
                        ]
                      ],
                      [
                        "gapHalf",
                        [
                          "if",
                          "@isConvergent",
                          [
                            "math/max",
                            0.0,
                            [
                              "-",
                              "@config.plateGapHalf",
                              [
                                "*",
                                "@entity.advanceSteps",
                                "@config.convergeRatePixels"
                              ]
                            ]
                          ],
                          [
                            "if",
                            "@isDivergent",
                            [
                              "+",
                              "@config.plateGapHalf",
                              [
                                "*",
                                "@entity.advanceSteps",
                                "@config.divergeRatePixels"
                              ]
                            ],
                            "@config.plateGapHalf"
                          ]
                        ]
                      ],
                      [
                        "shearOffset",
                        [
                          "if",
                          "@isTransform",
                          [
                            "*",
                            "@entity.advanceSteps",
                            "@config.shearRatePixels"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "leftWidth",
                        [
                          "-",
                          [
                            "-",
                            "@midX",
                            "@gapHalf"
                          ],
                          "@margin"
                        ]
                      ],
                      [
                        "rightX",
                        [
                          "+",
                          [
                            "+",
                            "@midX",
                            "@gapHalf"
                          ],
                          "@shearOffset"
                        ]
                      ],
                      [
                        "rightWidth",
                        [
                          "-",
                          [
                            "-",
                            "@config.width",
                            "@margin"
                          ],
                          "@rightX"
                        ]
                      ],
                      [
                        "halfCount",
                        [
                          "math/floor",
                          [
                            "/",
                            "@entity.advanceSteps",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "volcanoShapes",
                        [
                          "if",
                          [
                            "and",
                            "@isConvergent",
                            [
                              "<=",
