            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "let",
                    [
                      [
                        "winnerMap",
                        "@config.baselineMap"
                      ],
                      [
                        "scenarioName",
                        "Baseline"
                      ],
                      [
                        "totalEV",
                        [
                          "array/reduce",
                          "@config.evCounts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "e"
                            ],
                            [
                              "+",
                              "@acc",
                              [
                                "object/get",
                                "@e",
                                "ev"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "redEV",
                        [
                          "array/reduce",
                          "@config.states",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "let",
                              [
                                [
                                  "w",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@winnerMap",
                                      [
                                        "fn",
                                        "m",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@m",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "evc",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.evCounts",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@e",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@w",
                                    "winner"
                                  ],
                                  "red"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@evc",
                                    "ev"
                                  ]
                                ],
                                "@acc"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "blueEV",
                        [
                          "array/reduce",
                          "@config.states",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "let",
                              [
                                [
                                  "w",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@winnerMap",
                                      [
                                        "fn",
                                        "m",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@m",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "evc",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.evCounts",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@e",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@w",
                                    "winner"
                                  ],
                                  "blue"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@evc",
                                    "ev"
                                  ]
                                ],
                                "@acc"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "tossupEV",
                        [
                          "-",
                          "@totalEV",
                          [
                            "+",
                            "@redEV",
                            "@blueEV"
                          ]
                        ]
                      ],
                      [
                        "redPopRaw",
                        [
                          "array/reduce",
                          "@config.states",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "let",
                              [
                                [
                                  "w",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@winnerMap",
                                      [
                                        "fn",
                                        "m",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@m",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@w",
                                    "winner"
                                  ],
                                  "red"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@s",
                                    "popShare"
                                  ]
                                ],
                                "@acc"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "bluePopRaw",
                        [
                          "array/reduce",
                          "@config.states",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "let",
                              [
                                [
                                  "w",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@winnerMap",
                                      [
                                        "fn",
                                        "m",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@m",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@w",
                                    "winner"
                                  ],
                                  "blue"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@s",
                                    "popShare"
                                  ]
                                ],
                                "@acc"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "redPop",
                        [
                          "math/round",
                          "@redPopRaw",
                          1.0
                        ]
                      ],
                      [
                        "bluePop",
                        [
                          "math/round",
                          "@bluePopRaw",
                          1.0
                        ]
                      ],
                      [
                        "elecWinner",
                        [
                          "if",
                          [
                            ">=",
                            "@redEV",
                            "@config.threshold"
                          ],
                          "red",
                          [
                            "if",
                            [
                              ">=",
                              "@blueEV",
                              "@config.threshold"
                            ],
                            "blue",
                            "none"
                          ]
                        ]
                      ],
                      [
                        "popLeader",
                        [
                          "if",
                          [
                            ">",
                            "@redPop",
                            "@bluePop"
                          ],
                          "red",
                          [
                            "if",
                            [
                              ">",
                              "@bluePop",
                              "@redPop"
                            ],
                            "blue",
                            "tied"
                          ]
                        ]
                      ],
                      [
                        "splitNote",
                        [
                          "if",
                          [
                            "and",
                            [
                              "!=",
                              "@elecWinner",
                              "none"
                            ],
                            [
                              "!=",
                              "@elecWinner",
                              "@popLeader"
                            ]
                          ],
                          " — split decision: the electoral winner trails in the popular vote",
                          ""
                        ]
                      ],
                      [
                        "winnerText",
                        [
                          "if",
                          [
                            "==",
                            "@elecWinner",
                            "red"
                          ],
                          "Red reaches 270 — wins the presidency",
                          [
                            "if",
                            [
                              "==",
                              "@elecWinner",
                              "blue"
                            ],
                            "Blue reaches 270 — wins the presidency",
                            [
                              "str/concat",
                              "No majority yet — ",
                              "@tossupEV",
                              " tossup EV outstanding"
                            ]
                          ]
                        ]
                      ],
                      [
                        "winnerVariant",
                        [
                          "if",
                          [
                            "==",
                            "@elecWinner",
                            "none"
                          ],
                          "info",
                          "success"
                        ]
                      ],
                      [
                        "tileW",
                        [
                          "/",
                          [
                            "-",
                            "@config.width",
                            50.0
                          ],
                          4.0
                        ]
                      ],
                      [
                        "tileH",
                        56.0
                      ],
                      [
                        "tileRects",
                        [
                          "array/map",
                          "@config.states",
                          [
                            "fn",
                            "s",
                            [
                              "let",
                              [
                                [
                                  "w",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@winnerMap",
                                      [
                                        "fn",
                                        "m",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@m",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "fillC",
                                  [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@w",
                                        "winner"
                                      ],
                                      "red"
                                    ],
                                    "@config.redColor",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@w",
                                          "winner"
                                        ],
                                        "blue"
                                      ],
                                      "@config.blueColor",
                                      "@config.tossupColor"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "color": "@fillC",
                                "fill": "@fillC",
                                "height": "@tileH",
                                "id": [
                                  "str/concat",
                                  "tile-",
                                  [
                                    "object/get",
                                    "@s",
                                    "id"
                                  ]
                                ],
                                "lineWidth": 1.0,
                                "opacity": 0.85,
                                "type": "rect",
                                "width": "@tileW",
                                "x": [
                                  "+",
                                  10.0,
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@s",
                                      "col"
                                    ],
                                    [
                                      "+",
                                      "@tileW",
                                      10.0
                                    ]
                                  ]
                                ],
                                "y": [
                                  "+",
                                  10.0,
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@s",
                                      "row"
                                    ],
                                    [
                                      "+",
                                      "@tileH",
                                      10.0
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "tileLabels",
                        [
                          "array/map",
                          "@config.states",
                          [
                            "fn",
                            "s",
                            [
                              "let",
                              [
                                [
                                  "evc",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.evCounts",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@e",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "align": "center",
                                "color": "#ffffff",
                                "fontSize": 13.0,
                                "id": [
                                  "str/concat",
                                  "tile-label-",
                                  [
                                    "object/get",
                                    "@s",
                                    "id"
                                  ]
                                ],
                                "text": [
                                  "str/concat",
                                  [
                                    "object/get",
                                    "@s",
                                    "id"
                                  ],
                                  " · ",
                                  [
                                    "object/get",
                                    "@evc",
                                    "ev"
                                  ]
                                ],
                                "type": "text",
                                "x": [
                                  "+",
                                  [
                                    "+",
                                    10.0,
                                    [
                                      "*",
                                      [
                                        "object/get",
                                        "@s",
                                        "col"
                                      ],
                                      [
                                        "+",
                                        "@tileW",
                                        10.0
                                      ]
                                    ]
                                  ],
                                  [
                                    "/",
                                    "@tileW",
                                    2.0
                                  ]
                                ],
                                "y": [
                                  "+",
                                  [
                                    "+",
                                    10.0,
                                    [
                                      "*",
                                      [
                                        "object/get",
                                        "@s",
                                        "row"
                                      ],
                                      [
                                        "+",
                                        "@tileH",
                                        10.0
                                      ]
                                    ]
                                  ],
                                  [
                                    "/",
                                    "@tileH",
                                    2.0
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "barY",
                        [
                          "+",
                          30.0,
                          [
                            "*",
                            4.0,
                            [
                              "+",
                              "@tileH",
                              10.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "scale",
                        [
                          "/",
                          [
                            "-",
                            "@config.width",
                            80.0
                          ],
                          "@totalEV"
                        ]
                      ],
                      [
                        "thresholdX",
                        [
                          "+",
                          40.0,
                          [
                            "*",
                            "@config.threshold",
                            "@scale"
                          ]
                        ]
                      ],
                      [
                        "barShapes",
                        [
                          {
                            "color": "@config.redColor",
                            "fill": "@config.redColor",
                            "height": 28.0,
                            "id": "red-bar",
                            "lineWidth": 1.0,
                            "type": "rect",
                            "width": [
                              "*",
                              "@redEV",
                              "@scale"
                            ],
                            "x": 40.0,
                            "y": "@barY"
                          },
                          {
                            "align": "left",
                            "color": "#ffffff",
                            "fontSize": 13.0,
                            "id": "red-bar-label",
                            "text": [
                              "str/concat",
                              "Red ",
                              "@redEV",
                              " EV"
                            ],
                            "type": "text",
                            "x": 44.0,
                            "y": [
                              "+",
                              "@barY",
                              18.0
                            ]
                          },
                          {
                            "color": "@config.blueColor",
                            "fill": "@config.blueColor",
                            "height": 28.0,
                            "id": "blue-bar",
                            "lineWidth": 1.0,
                            "type": "rect",
                            "width": [
                              "*",
                              "@blueEV",
                              "@scale"
                            ],
                            "x": 40.0,
                            "y": [
                              "+",
                              "@barY",
                              40.0
                            ]
                          },
                          {
                            "align": "left",
                            "color": "#ffffff",
                            "fontSize": 13.0,
                            "id": "blue-bar-label",
                            "text": [
                              "str/concat",
                              "Blue ",
                              "@blueEV",
                              " EV"
                            ],
                            "type": "text",
                            "x": 44.0,
                            "y": [
                              "+",
                              "@barY",
                              58.0
                            ]
                          },
                          {
                            "color": "#0f172a",
                            "id": "threshold-line",
                            "lineWidth": 2.0,
                            "type": "line",
                            "x1": "@thresholdX",
                            "x2": "@thresholdX",
                            "y1": [
                              "-",
                              "@barY",
                              6.0
                            ],
                            "y2": [
                              "+",
                              "@barY",
                              74.0
                            ]
                          },
                          {
                            "align": "center",
                            "color": "#0f172a",
                            "fontSize": 12.0,
                            "id": "threshold-label",
                            "text": [
                              "str/concat",
                              "@config.threshold",
                              " to win"
                            ],
                            "type": "text",
                            "x": "@thresholdX",
                            "y": [
                              "-",
                              "@barY",
                              12.0
                            ]
                          }
                        ]
                      ],
                      [
                        "shapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            "@tileRects",
                            "@tileLabels"
                          ],
                          "@barShapes"
                        ]
                      ],
                      [
                        "swingStates",
                        [
                          "array/filter",
                          "@config.states",
                          [
                            "fn",
                            "s",
                            [
                              "==",
                              [
                                "object/get",
                                "@s",
                                "swing"
                              ],
                              true
                            ]
                          ]
                        ]
                      ],
                      [
                        "toggleButtons",
                        [
                          "array/map",
                          "@swingStates",
                          [
                            "fn",
                            "s",
                            {
                              "action": "TOGGLE_STATE",
                              "actionPayload": {
                                "stateId": [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              },
                              "label": [
                                "str/concat",
                                "Flip ",
                                [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              ],
                              "type": "button",
                              "variant": "secondary"
                            }
                          ]
                        ]
                      ],
                      [
                        "scenarioButtons",
                        [
                          "array/map",
                          "@config.scenarios",
                          [
                            "fn",
                            "sc",
                            {
                              "action": "LOAD_SCENARIO",
                              "actionPayload": {
                                "index": [
                                  "object/get",
                                  "@sc",
                                  "index"
                                ]
                              },
                              "label": [
                                "object/get",
                                "@sc",
                                "name"
                              ],
                              "type": "button",
                              "variant": [
                                "if",
                                [
                                  "==",
                                  "@scenarioName",
                                  [
                                    "object/get",
                                    "@sc",
                                    "name"
                                  ]
                                ],
                                "primary",
                                "ghost"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "splitLine",
                        [
                          "str/concat",
                          "Popular vote share — Red ",
                          "@redPop",
                          "% · Blue ",
                          "@bluePop",
                          "%",
                          "@splitNote"
                        ]
                      ],
                      [
                        "children",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Flip the swing states — the first ticket to 270 electoral votes wins the presidency.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "children": "@toggleButtons",
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "animate": "@config.animate",
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": "@splitLine",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "children": [
                              {
                                "label": [
                                  "str/concat",
                                  "EV — Red ",
                                  "@redEV",
                                  " · Blue ",
                                  "@blueEV",
                                  " · Tossup ",
                                  "@tossupEV"
                                ],
                                "type": "badge",
                                "variant": "info"
                              },
                              {
                                "label": "@winnerText",
                                "type": "badge",
                                "variant": "@winnerVariant"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [
                              "array/concat",
                              "@scenarioButtons",
                              [
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ]
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.winnerMap",
                        "@winnerMap"
                      ],
                      [
                        "set",
                        "@entity.scenarioName",
                        "@scenarioName"
                      ],
                      [
                        "set",
                        "@entity.redEV",
                        "@redEV"
                      ],
                      [
                        "set",
                        "@entity.blueEV",
                        "@blueEV"
                      ],
                      [
                        "set",
                        "@entity.tossupEV",
                        "@tossupEV"
                      ],
                      [
                        "set",
                        "@entity.redPop",
                        "@redPop"
                      ],
                      [
                        "set",
                        "@entity.bluePop",
                        "@bluePop"
                      ],
                      [
                        "set",
                        "@entity.splitNote",
                        "@splitNote"
                      ],
                      [
                        "set",
                        "@entity.renderChildren",
                        "@children"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
