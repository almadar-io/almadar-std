                            }
                          ]
                        ]
                      ],
                      [
                        "splitLine",
                        [
                          "str/concat",
                          "Popular vote share — Red ",
                          "@redPop",
                          "% · Blue ",
                          "@bluePop",
                          "%",
                          "@splitNote"
                        ]
                      ],
                      [
                        "children",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Flip the swing states — the first ticket to 270 electoral votes wins the presidency.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "children": "@toggleButtons",
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "animate": "@config.animate",
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
