                        ]
                      ],
                      [
                        "swingStates",
                        [
                          "array/filter",
                          "@config.states",
                          [
                            "fn",
                            "s",
                            [
                              "==",
                              [
                                "object/get",
                                "@s",
                                "swing"
                              ],
                              true
                            ]
                          ]
                        ]
                      ],
                      [
                        "toggleButtons",
                        [
                          "array/map",
                          "@swingStates",
                          [
                            "fn",
                            "s",
                            {
                              "action": "TOGGLE_STATE",
                              "actionPayload": {
                                "stateId": [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              },
                              "label": [
                                "str/concat",
                                "Flip ",
                                [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              ],
                              "type": "button",
                              "variant": "secondary"
                            }
                          ]
                        ]
                      ],
                      [
                        "scenarioButtons",
                        [
                          "array/map",
                          "@config.scenarios",
                          [
                            "fn",
                            "sc",
                            {
                              "action": "LOAD_SCENARIO",
                              "actionPayload": {
                                "index": [
                                  "object/get",
                                  "@sc",
                                  "index"
                                ]
                              },
                              "label": [
                                "object/get",
                                "@sc",
                                "name"
                              ],
                              "type": "button",
                              "variant": [
                                "if",
                                [
                                  "==",
                                  "@scenarioName",
                                  [
                                    "object/get",
                                    "@sc",
                                    "name"
                                  ]
                                ],
                                "primary",
                                "ghost"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "splitLine",
                        [
                          "str/concat",
                          "Popular vote share — Red ",
                          "@redPop",
                          "% · Blue ",
                          "@bluePop",
                          "%",
                          "@splitNote"
                        ]
                      ],
                      [
                        "children",
                        [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "content": "Flip the swing states — the first ticket to 270 electoral votes wins the presidency.",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "children": "@toggleButtons",
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "animate": "@config.animate",
                            "curves": [],
                            "gridStep": 1.0,
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@shapes",
                            "showAxes": false,
                            "showGrid": false,
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.width",
                            "xMin": 0.0,
                            "yMax": "@config.height",
                            "yMin": 0.0
                          },
                          {
                            "content": "@splitLine",
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "children": [
                              {
                                "label": [
                                  "str/concat",
                                  "EV — Red ",
                                  "@redEV",
                                  " · Blue ",
                                  "@blueEV",
                                  " · Tossup ",
                                  "@tossupEV"
                                ],
                                "type": "badge",
                                "variant": "info"
                              },
                              {
                                "label": "@winnerText",
                                "type": "badge",
                                "variant": "@winnerVariant"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [
                              "array/concat",
                              "@scenarioButtons",
                              [
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ]
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.winnerMap",
                        "@winnerMap"
                      ],
                      [
                        "set",
                        "@entity.scenarioName",
                        "@scenarioName"
                      ],
                      [
                        "set",
                        "@entity.redEV",
                        "@redEV"
                      ],
                      [
                        "set",
                        "@entity.blueEV",
                        "@blueEV"
                      ],
                      [
                        "set",
                        "@entity.tossupEV",
                        "@tossupEV"
                      ],
                      [
                        "set",
                        "@entity.redPop",
                        "@redPop"
                      ],
                      [
                        "set",
                        "@entity.bluePop",
                        "@bluePop"
                      ],
                      [
                        "set",
                        "@entity.splitNote",
                        "@splitNote"
                      ],
                      [
                        "set",
                        "@entity.renderChildren",
                        "@children"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": "@entity.renderChildren",
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "ELECTORAL_UPDATED",
                    {
                      "blueEV": "@entity.blueEV",
                      "bluePop": "@entity.bluePop",
                      "redEV": "@entity.redEV",
                      "redPop": "@entity.redPop",
                      "scenarioName": "@entity.scenarioName",
                      "splitNote": "@entity.splitNote",
                      "tossupEV": "@entity.tossupEV"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M04C7Z5TTAGJ8YHGC1KDY4V5",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}