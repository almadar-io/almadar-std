      "traits": [
        {
          "category": "interaction",
          "config": {
            "actions": {
              "default": [
                {
                  "action": "Congress passes a law.",
                  "actor": "legislative",
                  "checks": [
                    {
                      "by": "judicial",
                      "label": "Judicial review — Marbury v. Madison"
                    },
                    {
                      "by": "executive",
                      "label": "Presidential veto"
                    }
                  ],
                  "hint": "Two branches can check a new law: the President can refuse to sign it, and the courts can later strike it down as unconstitutional."
                },
                {
                  "action": "The President vetoes a bill.",
                  "actor": "executive",
                  "checks": [
                    {
                      "by": "legislative",
                      "label": "Congress overrides the veto with a two-thirds vote"
                    }
                  ],
                  "hint": "Only Congress can override a presidential veto, and only with a two-thirds supermajority in both chambers."
                },
                {
                  "action": "The Supreme Court strikes down a law as unconstitutional.",
                  "actor": "judicial",
                  "checks": [
                    {
                      "by": "legislative",
                      "label": "Congress proposes a constitutional amendment"
                    },
                    {
                      "by": "executive",
                      "label": "The President appoints new justices over time (with Senate confirmation)"
                    }
                  ],
                  "hint": "A constitutional ruling is checked over time by amending the Constitution or by future appointments — not by ordinary legislation."
                },
                {
                  "action": "The President appoints a federal judge.",
                  "actor": "executive",
                  "checks": [
                    {
                      "by": "legislative",
                      "label": "Senate confirmation (advice and consent)"
                    }
                  ],
                  "hint": "The Senate must confirm judicial nominees — the President cannot seat a federal judge alone."
                },
                {
                  "action": "Congress declares war and funds the military.",
                  "actor": "legislative",
                  "checks": [
                    {
                      "by": "executive",
                      "label": "The President, as Commander-in-Chief, directs how forces are used"
                    }
                  ],
                  "hint": "Congress controls the power to declare war and fund the military, but command of the forces belongs to the President."
                },
                {
                  "action": "The President negotiates a treaty.",
                  "actor": "executive",
                  "checks": [
                    {
                      "by": "legislative",
                      "label": "Senate ratification (two-thirds vote)"
                    }
                  ],
                  "hint": "A treaty only binds the nation once two-thirds of the Senate ratifies it — the President cannot commit the nation alone."
                }
              ],
              "description": "Roster of governmental actions. Each action names the acting branch (actor) and the text shown; checks lists every branch that can legitimately check that action (any one is accepted); hint is the feedback text shown on an incorrect guess.",
              "items": {
                "properties": {
                  "action": {
                    "name": "action",
                    "required": true,
                    "type": "string"
                  },
                  "actor": {
                    "name": "actor",
                    "required": true,
                    "type": "string",
                    "values": [
