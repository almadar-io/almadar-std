            }
          ],
          "emits": [
            {
              "description": "Fires when the learner selects a part, carrying the selected part's id — a composed listener (readout, quiz) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "PART_SELECTED",
              "eventId": "evt_01M055GQ28SKJFZ4J8B6CQQY8R",
              "payloadSchema": [
                {
                  "name": "partId",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "select, choose, part, highlight, diagram, label",
              "tier": "domain"
            },
            {
              "description": "Fires when the learner clears the current selection and the diagram returns to its overview state; a harmless no-op when the atom runs standalone.",
              "event": "SELECTION_CLEARED",
              "eventId": "evt_01M055GQ28488HVA0V7NY6YEAJ",
              "scope": "external",
              "synonyms": "clear, deselect, reset, overview",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "captionChildren",
              "captionText",
              "links",
              "partButtons",
              "parts",
              "readoutText",
              "selectedId",
              "selectedIndex",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "LearnDiagramScene": "ent_01M055GQ27EM9QNS4EEJ3M1BCS"
          },
          "id": "trt_01M055GQ278WFQWA2HDXD2H6S0",
          "linkedEntity": "LearnDiagramScene",
          "linkedEntityId": "ent_01M055GQ27EM9QNS4EEJ3M1BCS",
          "name": "LearnDiagramSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GQ2773AEMFWKNAW2N8P0",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ281Y3NWPNNPD786Z1S",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked a part's choice-button; the matching part is highlighted on the diagram and its description surfaces in the caption card.",
                "id": "evt_01M055GQ28T67C49QXGB1DPMMR",
                "key": "SELECT_PART",
                "name": "Select Part",
                "payloadSchema": [
                  {
                    "name": "partId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner cleared the current selection, returning the diagram to its no-selection overview state.",
                "id": "evt_01M055GQ28FCG0AY4TJ319PMCH",
                "key": "CLEAR_PART",
                "name": "Clear Part",
                "tier": "domain"
              },
              {
                "description": "Fires when the learner selects a part, carrying the selected part's id — a composed listener (readout, quiz) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ28SKJFZ4J8B6CQQY8R",
                "key": "PART_SELECTED",
                "name": "Part Selected",
                "payloadSchema": [
                  {
                    "name": "partId",
                    "type": "string"
                  }
                ],
                "synonyms": "select, choose, part, highlight, diagram, label",
                "tier": "domain"
              },
              {
                "description": "Fires when the learner clears the current selection and the diagram returns to its overview state; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ28488HVA0V7NY6YEAJ",
                "key": "SELECTION_CLEARED",
                "name": "Selection Cleared",
                "synonyms": "clear, deselect, reset, overview",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.parts",
                    "@config.parts"
                  ],
                  [
                    "set",
                    "@entity.links",
                    "@config.links"
                  ],
                  [
                    "set",
                    "@entity.selectedId",
                    ""
                  ],
                  [
                    "set",
                    "@entity.selectedIndex",
                    -1.0
                  ],
                  [
                    "set",
                    "@entity.captionText",
                    "@config.overviewText"
                  ],
                  [
                    "set",
                    "@entity.readoutText",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "buttons",
                        [
                          "array/map",
                          "@entity.parts",
                          [
                            "fn",
                            "p",
                            {
                              "action": "SELECT_PART",
                              "actionPayload": {
                                "partId": [
                                  "object/get",
                                  "@p",
                                  "id"
                                ]
                              },
                              "label": [
                                "object/get",
                                "@p",
                                "label"
                              ],
                              "size": "sm",
                              "type": "button",
                              "variant": [
                                "if",
                                [
                                  "==",
                                  "@entity.selectedId",
                                  [
                                    "object/get",
                                    "@p",
                                    "id"
                                  ]
                                ],
                                "primary",
                                "secondary"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "clearButton",
                        {
                          "action": "CLEAR_PART",
                          "label": "@config.clearLabel",
                          "size": "sm",
                          "type": "button",
                          "variant": "ghost"
                        }
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.partButtons",
                        [
                          "array/append",
                          "@buttons",
                          "@clearButton"
                        ]
                      ],
                      [
                        "set",
                        "@entity.captionChildren",
                        [
                          "if",
                          [
                            "!=",
                            "@entity.readoutText",
                            ""
                          ],
                          [
                            {
                              "color": "muted",
                              "content": "@entity.readoutText",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": "@entity.captionText",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          [
                            {
                              "content": "@entity.captionText",
                              "type": "typography",
                              "variant": "body"
                            }
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.links",
                              "height": "@config.height",
                              "nodes": [
                                "array/map",
                                "@entity.parts",
                                [
                                  "fn",
                                  "p",
                                  {
                                    "color": [
                                      "object/get",
                                      "@p",
                                      "color"
                                    ],
                                    "id": [
                                      "object/get",
                                      "@p",
                                      "id"
                                    ],
                                    "label": [
                                      "object/get",
                                      "@p",
                                      "label"
                                    ],
                                    "radius": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@p",
                                          "id"
                                        ],
                                        "@entity.selectedId"
                                      ],
                                      [
                                        "*",
                                        [
                                          "object/get",
                                          "@p",
                                          "radius"
                                        ],
                                        1.4
                                      ],
                                      [
                                        "object/get",
                                        "@p",
                                        "radius"
                                      ]
                                    ],
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  }
                                ]
                              ],
                              "shapes": [
                                "if",
                                [
                                  "==",
                                  "@entity.selectedId",
                                  ""
                                ],
                                [],
                                [
                                  {
                                    "color": "@config.highlightColor",
                                    "lineWidth": 4.0,
                                    "radius": [
                                      "+",
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@entity.parts",
                                          "@entity.selectedIndex"
                                        ],
                                        "radius"
                                      ],
                                      10.0
                                    ],
                                    "type": "circle",
                                    "x": [
                                      "object/get",
                                      [
                                        "array/nth",
                                        "@entity.parts",
                                        "@entity.selectedIndex"
                                      ],
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      [
                                        "array/nth",
                                        "@entity.parts",
                                        "@entity.selectedIndex"
                                      ],
                                      "y"
                                    ]
                                  }
                                ]
                              ],
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": "@entity.captionChildren",
                              "padding": "md",
                              "type": "card",
                              "variant": "bordered"
                            },
                            {
