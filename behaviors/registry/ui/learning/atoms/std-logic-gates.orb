          "name": "LogicGatesSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNFCPZZ2WP4T1WPD9XFVZ2C",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNFCQ00A261B203312SA5FV",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner flipped one input pin between 0 and 1; any propagated values are cleared.",
                "id": "evt_01KZNFCQ00JT2JFRGC9AY6EWPJ",
                "key": "TOGGLE_INPUT",
                "name": "Toggle Input",
                "payloadSchema": [
                  {
                    "name": "input",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner locked in a prediction for the output bulb before propagating.",
                "id": "evt_01KZNFCQ00B68DZDTGK0V2WA6Z",
                "key": "PREDICT_OUTPUT",
                "name": "Predict Output",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "boolean"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner ran the circuit: values flow gate by gate from the input pins to the output bulb.",
                "id": "evt_01KZNFCQ00DSBG7QKDH3XB70M4",
                "key": "PROPAGATE",
                "name": "Propagate",
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next circuit in the roster.",
                "id": "evt_01KZNFCQ002591J1N42F7PA6MK",
                "key": "NEXT_CIRCUIT",
                "name": "Next Circuit",
                "tier": "domain"
              },
              {
                "description": "The circuit state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNFCQ00139V69BGBEG9NPNQ",
                "key": "GATES_UPDATED",
                "name": "Gates Updated",
                "payloadSchema": [
                  {
                    "name": "circuitIndex",
                    "type": "number"
                  },
                  {
                    "name": "propagated",
                    "type": "boolean"
                  },
                  {
                    "name": "prediction",
                    "type": "string"
                  },
                  {
                    "name": "feedback",
                    "type": "string"
                  }
                ],
                "synonyms": "circuit update, gate propagation, input toggle, output prediction, boolean circuit",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.circuitIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.gateValues",
                    []
                  ],
                  [
                    "set",
                    "@entity.propagated",
                    false
                  ],
                  [
                    "set",
                    "@entity.prediction",
                    ""
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "c",
                        [
                          "array/nth",
                          "@config.circuits",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.inputs",
                        [
                          "object/get",
                          "@c",
                          "inputs"
                        ]
                      ],
                      [
                        "set",
                        "@entity.edges",
                        [
                          "array/map",
                          [
                            "object/get",
                            "@c",
                            "edges"
                          ],
                          [
                            "fn",
                            "e",
                            {
                              "color": "#94a3b8",
                              "from": [
                                "object/get",
                                "@e",
                                "from"
                              ],
                              "to": [
                                "object/get",
                                "@e",
                                "to"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.nodes",
                        [
                          "array/concat",
                          [
                            "array/map",
                            [
                              "object/get",
                              "@c",
                              "inputs"
                            ],
                            [
                              "fn",
                              "i",
                              {
                                "color": [
                                  "if",
                                  [
                                    "object/get",
                                    "@i",
                                    "value"
                                  ],
                                  "#22c55e",
                                  "#94a3b8"
                                ],
                                "id": [
                                  "object/get",
                                  "@i",
                                  "id"
                                ],
                                "kind": "molecule",
                                "label": [
                                  "object/get",
                                  "@i",
                                  "label"
                                ],
                                "radius": 14.0,
                                "x": [
                                  "object/get",
                                  "@i",
                                  "x"
                                ],
                                "y": [
                                  "object/get",
                                  "@i",
                                  "y"
                                ]
                              }
                            ]
                          ],
                          [
                            "array/map",
                            [
                              "object/get",
                              "@c",
                              "gates"
                            ],
                            [
                              "fn",
                              "g",
                              {
                                "color": "#cbd5e1",
                                "id": [
                                  "object/get",
                                  "@g",
                                  "id"
                                ],
                                "kind": "molecule",
                                "label": [
                                  "object/get",
                                  "@g",
                                  "kind"
                                ],
                                "radius": 20.0,
                                "x": [
                                  "object/get",
                                  "@g",
                                  "x"
                                ],
                                "y": [
                                  "object/get",
                                  "@g",
                                  "y"
                                ]
                              }
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.circuits",
                                  "@entity.circuitIndex"
                                ],
                                "label"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "array/take",
                                  "@entity.inputs",
                                  "@config.inputCount"
                                ],
                                [
                                  "fn",
                                  "inp",
                                  {
                                    "action": "TOGGLE_INPUT",
                                    "actionPayload": {
                                      "input": [
                                        "object/get",
                                        "@inp",
                                        "id"
                                      ]
                                    },
                                    "label": [
                                      "str/concat",
                                      [
                                        "object/get",
                                        "@inp",
                                        "label"
                                      ],
                                      " = ",
                                      [
                                        "if",
                                        [
                                          "object/get",
                                          "@inp",
                                          "value"
                                        ],
                                        "1",
                                        "0"
                                      ]
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "object/get",
                                        "@inp",
                                        "value"
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "PREDICT_OUTPUT",
