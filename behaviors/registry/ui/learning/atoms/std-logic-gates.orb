                                        "if",
                                        [
                                          "!=",
                                          "@inB",
                                          null
                                        ],
                                        [
                                          "object/get",
                                          "@inB",
                                          "value"
                                        ],
                                        [
                                          "object/get",
                                          [
                                            "array/find",
                                            "@acc",
                                            [
                                              "fn",
                                              "v",
                                              [
                                                "==",
                                                [
                                                  "object/get",
                                                  "@v",
                                                  "id"
                                                ],
                                                "@srcB"
                                              ]
                                            ]
                                          ],
                                          "value"
                                        ]
                                      ]
                                    ],
                                    false
                                  ]
                                ],
                                [
                                  "result",
                                  [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@g",
                                        "kind"
                                      ],
                                      "AND"
                                    ],
                                    [
                                      "and",
                                      "@vA",
                                      "@vB"
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@g",
                                          "kind"
                                        ],
                                        "OR"
                                      ],
                                      [
                                        "or",
                                        "@vA",
                                        "@vB"
                                      ],
                                      [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@g",
                                            "kind"
                                          ],
                                          "NOT"
                                        ],
                                        [
                                          "not",
                                          "@vA"
                                        ],
                                        [
                                          "!=",
                                          "@vA",
                                          "@vB"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "array/append",
                                "@acc",
                                {
                                  "id": [
