                      "@entity.narration",
                      [
                        "str/concat",
                        "return — pop frame, depth ",
                        [
                          "str/concat",
                          "",
                          "@entity.depth"
                        ]
                      ]
                    ]
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.depth",
                      [
                        "+",
                        "@entity.depth",
                        1.0
                      ]
                    ],
                    [
                      "set",
                      "@entity.calls",
                      [
                        "+",
                        "@entity.calls",
                        1.0
                      ]
                    ],
                    [
                      "set",
                      "@entity.frames",
                      [
                        "array/map",
                        "@entity.frames",
                        [
                          "if",
                          [
                            "==",
                            "@index",
                            [
                              "-",
                              "@entity.depth",
                              1.0
                            ]
                          ],
                          [
