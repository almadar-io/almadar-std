                                  "action": "STEP_RETURN",
                                  "label": "Return",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RUN",
                                  "label": "Run",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "bars": [
                                "if",
                                "@config.showStack",
                                "@entity.frames",
                                []
                              ],
                              "height": "@config.height",
                              "type": "algorithm-canvas",
                              "width": "@config.width"
                            },
