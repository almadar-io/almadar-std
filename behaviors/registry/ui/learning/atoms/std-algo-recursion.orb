                      "depth": "@entity.depth",
                      "frames": "@entity.frames",
                      "narration": "@entity.narration"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZNEYPFVAXNDAWJT9TGZ6X2Q",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.depth",
                    [
                      "+",
                      "@entity.depth",
                      1.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.calls",
                    [
                      "+",
                      "@entity.calls",
                      1.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.frames",
                    [
                      "array/map",
                      "@entity.frames",
                      [
                        "if",
                        [
                          "==",
                          "@index",
                          [
                            "-",
                            "@entity.depth",
                            1.0
                          ]
                        ],
                        [
                          "object/merge",
                          "@item",
                          {
                            "color": "#3b82f6",
                            "label": [
                              "str/concat",
                              "@config.functionPreset",
                              "(",
                              [
                                "str/concat",
                                "",
                                [
                                  "-",
                                  "@config.initialInput",
                                  [
                                    "-",
                                    "@entity.depth",
                                    1.0
                                  ]
                                ]
                              ],
                              ")"
                            ],
                            "value": "@entity.depth"
                          }
                        ],
                        "@item"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.unwinding",
                    [
                      ">=",
                      "@entity.depth",
                      "@config.maxDepth"
                    ]
                  ],
                  [
                    "set",
                    "@entity.narration",
                    [
                      "str/concat",
                      "call ",
                      [
                        "str/concat",
                        "",
                        "@entity.calls"
                      ],
                      " — push ",
                      "@config.functionPreset",
                      " frame, depth ",
                      [
                        "str/concat",
                        "",
                        "@entity.depth"
                      ],
                      [
                        "if",
                        "@config.showTree",
                        " · tree node spawned",
                        ""
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
