          "ticks": [
            {
              "effects": [
                [
                  "if",
                  "@entity.unwinding",
                  [
                    "do",
                    [
                      "set",
                      "@entity.frames",
                      [
                        "array/map",
                        "@entity.frames",
                        [
                          "if",
                          [
                            "==",
                            "@index",
                            [
                              "-",
                              "@entity.depth",
                              1.0
