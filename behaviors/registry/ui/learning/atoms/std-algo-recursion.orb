                      "@entity.unwinding",
                      [
                        ">=",
                        "@entity.depth",
                        "@config.maxDepth"
                      ]
                    ],
                    [
                      "set",
                      "@entity.narration",
                      [
                        "str/concat",
                        "call ",
                        [
                          "str/concat",
                          "",
                          "@entity.calls"
                        ],
                        " — push ",
                        "@config.functionPreset",
                        " frame, depth ",
                        [
