                            "@item",
                            {
                              "color": "#3b82f6",
                              "label": [
                                "str/concat",
                                "@config.functionPreset",
                                "(",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "-",
                                    "@config.initialInput",
                                    [
