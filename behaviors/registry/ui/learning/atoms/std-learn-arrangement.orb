                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "label": [
                                    "if",
                                    "@entity.checked",
                                    "@entity.verdict",
                                    "Not checked yet"
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    "@entity.checked",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@entity.correctCount",
                                        "@entity.totalItems"
                                      ],
                                      "success",
                                      "danger"
                                    ],
                                    "neutral"
                                  ]
                                },
                                {
                                  "label": "Score",
