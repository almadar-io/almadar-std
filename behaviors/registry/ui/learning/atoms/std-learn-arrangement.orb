                  [
                    "if",
                    [
                      "==",
                      "@entity.correctCount",
                      "@entity.totalItems"
                    ],
                    [
                      "emit",
                      "LEARN_ROUND_COMPLETE",
                      {
                        "score": "@entity.correctCount",
                        "total": "@entity.totalItems"
                      }
                    ],
                    null
                  ]
