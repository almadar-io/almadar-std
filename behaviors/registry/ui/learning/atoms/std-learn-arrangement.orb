                "event": "CHECK",
                "eventId": "evt_01M055GQ1F87XZSERFJRVMHVQF",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    ">=",
                    [
                      "array/len",
                      "@entity.placedIds"
                    ],
                    "@entity.totalItems"
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.placedIds",
                    []
                  ],
                  [
                    "set",
                    "@entity.checked",
                    false
                  ],
                  [
                    "set",
                    "@entity.correctCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.verdict",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "placedCount",
                        [
                          "array/len",
                          "@entity.placedIds"
                        ]
                      ],
                      [
                        "slotShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@entity.totalItems"
                            ],
                            [
                              "fn",
                              "i",
                              [
                                "let",
                                [
                                  [
                                    "placedId",
                                    [
                                      "if",
                                      [
                                        "<",
                                        "@i",
                                        "@placedCount"
                                      ],
                                      [
                                        "array/nth",
                                        "@entity.placedIds",
                                        "@i"
                                      ],
                                      ""
                                    ]
                                  ],
                                  [
                                    "filled",
                                    [
                                      "!=",
                                      "@placedId",
                                      ""
                                    ]
                                  ],
                                  [
                                    "item",
                                    [
                                      "if",
                                      "@filled",
                                      [
                                        "array/find",
                                        "@config.items",
                                        [
                                          "fn",
                                          "it",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@it",
                                              "id"
                                            ],
                                            "@placedId"
                                          ]
                                        ]
                                      ],
                                      null
                                    ]
                                  ],
                                  [
                                    "label",
                                    [
                                      "if",
                                      "@filled",
                                      [
                                        "object/get",
                                        "@item",
                                        "label"
                                      ],
                                      ""
                                    ]
                                  ],
                                  [
                                    "correctForSlot",
                                    [
                                      "if",
                                      "@filled",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@item",
                                          "correctPosition"
                                        ],
                                        "@i"
                                      ],
                                      false
                                    ]
                                  ],
                                  [
                                    "fillColor",
                                    [
                                      "if",
                                      [
                                        "not",
                                        "@filled"
                                      ],
                                      "@config.emptySlotColor",
                                      [
                                        "if",
                                        "@entity.checked",
                                        [
                                          "if",
                                          "@correctForSlot",
                                          "@config.correctColor",
                                          "@config.incorrectColor"
                                        ],
                                        "@config.pendingColor"
                                      ]
                                    ]
                                  ],
                                  [
                                    "bx",
                                    [
                                      "+",
                                      "@config.slotLeft",
                                      [
                                        "*",
                                        "@i",
                                        "@config.slotSpacing"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "color": "@config.slotBorderColor",
                                    "fill": "@fillColor",
                                    "height": "@config.slotHeight",
                                    "id": [
                                      "str/concat",
                                      "slot-",
                                      "@i"
                                    ],
                                    "type": "rect",
                                    "width": "@config.slotWidth",
                                    "x": "@bx",
                                    "y": "@config.slotY"
                                  },
                                  {
                                    "align": "center",
                                    "color": "@config.slotTextColor",
                                    "fontSize": "@config.slotFontSize",
                                    "id": [
                                      "str/concat",
                                      "slot-label-",
                                      "@i"
                                    ],
                                    "text": [
                                      "if",
                                      "@filled",
                                      "@label",
                                      [
                                        "str/concat",
                                        "",
                                        [
                                          "+",
                                          "@i",
                                          1.0
                                        ]
                                      ]
                                    ],
                                    "type": "text",
                                    "x": [
                                      "+",
                                      "@bx",
                                      [
                                        "/",
                                        "@config.slotWidth",
                                        2.0
                                      ]
                                    ],
                                    "y": [
                                      "+",
                                      "@config.slotY",
                                      [
                                        "/",
                                        "@config.slotHeight",
                                        2.0
                                      ],
                                      5.0
                                    ]
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.slotShapes",
                      "@slotShapes"
                    ]
