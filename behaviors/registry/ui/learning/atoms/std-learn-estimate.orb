                ],
                "event": "LOCK_IN",
                "eventId": "evt_01M07580S1W3ZQBFHX44XQYRCA",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "and",
                    [
                      "==",
                      "@entity.locked",
                      false
                    ],
                    [
                      "==",
                      "@entity.done",
                      false
                    ]
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "if",
                    [
                      ">=",
                      [
                        "+",
                        "@entity.promptIndex",
                        1.0
                      ],
                      [
                        "array/len",
                        "@config.prompts"
                      ]
                    ],
                    [
                      "emit",
                      "LEARN_ROUND_COMPLETE",
                      {
                        "score": "@entity.score",
                        "total": [
                          "array/len",
                          "@config.prompts"
                        ]
                      }
                    ],
                    null
                  ],
                  [
                    "let",
                    [
                      [
                        "nextIndex",
                        [
                          "+",
                          "@entity.promptIndex",
                          1.0
                        ]
                      ],
                      [
                        "finished",
                        [
                          ">=",
                          "@nextIndex",
                          [
                            "array/len",
                            "@config.prompts"
                          ]
                        ]
                      ],
                      [
                        "next",
                        [
                          "array/nth",
                          "@config.prompts",
                          [
                            "math/min",
                            "@nextIndex",
                            [
                              "-",
                              [
                                "array/len",
                                "@config.prompts"
                              ],
                              1.0
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.promptIndex",
                        [
                          "if",
                          "@finished",
                          "@entity.promptIndex",
                          "@nextIndex"
                        ]
                      ],
                      [
                        "set",
                        "@entity.done",
                        [
                          "if",
                          "@finished",
                          true,
                          false
                        ]
                      ],
                      [
                        "set",
                        "@entity.locked",
                        false
                      ],
                      [
                        "set",
                        "@entity.band",
                        ""
                      ],
                      [
                        "set",
                        "@entity.estimate",
                        "@config.sliderDefault"
                      ],
                      [
                        "set",
                        "@entity.promptText",
                        [
                          "if",
                          "@finished",
                          "@entity.promptText",
                          [
                            "object/get",
                            "@next",
                            "prompt"
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.promptHint",
                        [
                          "if",
                          "@finished",
                          "@entity.promptHint",
                          [
                            "object/get",
                            "@next",
                            "hint",
                            ""
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.answer",
                        [
                          "if",
