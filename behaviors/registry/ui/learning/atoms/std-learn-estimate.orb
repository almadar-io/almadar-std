          "name": "EstimateSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M07580RXB3P80VXGSNZ13RQ1",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M07580S12EWNDQQZKD0R318W",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner moved the estimate slider — value is the current guess, not yet graded.",
                "id": "evt_01M07580S1NJJ70QS86GC0R5GP",
                "key": "SET_ESTIMATE",
                "name": "Set Estimate",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner committed the current estimate; it is graded against the true answer by relative-error band.",
                "id": "evt_01M07580S1W3ZQBFHX44XQYRCA",
                "key": "LOCK_IN",
                "name": "Lock In",
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next prompt after a lock-in; past the last prompt this completes the round.",
                "id": "evt_01M07580S1DQG5RAQRCZGA46C5",
                "key": "NEXT",
                "name": "Next",
                "tier": "domain"
              },
              {
                "description": "Learner restarted the round from the first prompt with a cleared score.",
                "id": "evt_01M07580S1QXBDVQQ1ZPMB50MQ",
                "key": "RETRY",
                "name": "Retry",
                "tier": "domain"
              },
              {
                "description": "The verdict of a lock-in: which error band the estimate landed in (exact, close, off), the guess, the truth, and the running score — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M07580S15NQY14B94GVM0V1Y",
                "key": "ESTIMATE_JUDGED",
                "name": "Estimate Judged",
                "payloadSchema": [
                  {
                    "name": "band",
                    "type": "string"
                  },
                  {
                    "name": "estimate",
                    "type": "number"
                  },
                  {
                    "name": "answer",
                    "type": "number"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  }
                ],
                "synonyms": "estimation, order of magnitude, guess the number, error band, quantitative intuition",
                "tier": "domain"
              },
              {
                "description": "The learner moved to the next prompt (or completed the round) with the running score.",
                "id": "evt_01M07580S1E7HAAYJAWNE0A2RK",
                "key": "PROMPT_ADVANCED",
                "name": "Prompt Advanced",
                "payloadSchema": [
                  {
                    "name": "promptIndex",
                    "type": "number"
                  },
                  {
                    "name": "done",
                    "type": "boolean"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The learner restarted the round from scratch.",
                "id": "evt_01M07580S1VSATEQZ8KTE2ME73",
                "key": "ROUND_RESTARTED",
                "name": "Round Restarted",
                "payloadSchema": [
                  {
                    "name": "totalPrompts",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Fired once when the round finishes (advancing past the final prompt) — the standard learning completion broadcast a celebration/progression sibling (fx cues, badges) rides.",
                "id": "evt_01M0GTSZ8KYMMCH404XA6K8T24",
                "key": "LEARN_ROUND_COMPLETE",
                "name": "Learn Round Complete",
                "payloadSchema": [
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "total",
                    "type": "number"
                  }
                ],
                "synonyms": "round complete, finished, done, completion",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "first",
                        [
                          "array/nth",
                          "@config.prompts",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.promptIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.totalPrompts",
                        [
                          "array/len",
                          "@config.prompts"
                        ]
                      ],
                      [
                        "set",
                        "@entity.estimate",
                        "@config.sliderDefault"
                      ],
                      [
                        "set",
                        "@entity.locked",
                        false
                      ],
                      [
                        "set",
                        "@entity.band",
                        ""
                      ],
                      [
                        "set",
                        "@entity.score",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.done",
                        false
                      ],
                      [
                        "set",
                        "@entity.promptText",
                        [
                          "object/get",
                          "@first",
                          "prompt"
                        ]
                      ],
                      [
                        "set",
                        "@entity.promptHint",
                        [
                          "object/get",
                          "@first",
                          "hint",
                          ""
                        ]
                      ],
                      [
                        "set",
                        "@entity.answer",
                        [
                          "object/get",
                          "@first",
                          "answer"
                        ]
                      ],
                      [
                        "set",
                        "@entity.unit",
                        [
                          "object/get",
                          "@first",
                          "unit",
                          ""
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        ""
                      ],
                      [
                        "set",
                        "@entity.view",
                        [
                          {
                            "children": [
                              {
                                "content": "@entity.promptText",
                                "type": "typography",
                                "variant": "body"
                              },
                              {
                                "color": "muted",
                                "content": "@entity.promptHint",
                                "type": "typography",
                                "variant": "caption"
                              }
                            ],
                            "padding": "md",
                            "type": "card",
                            "variant": "bordered"
                          },
                          {
                            "children": [
                              {
                                "content": [
                                  "str/concat",
                                  "Your estimate: ",
                                  [
                                    "math/round",
                                    "@entity.estimate",
                                    2.0
                                  ],
                                  " ",
                                  "@entity.unit"
                                ],
                                "type": "typography",
                                "variant": "caption"
                              },
                              {
                                "action": "SET_ESTIMATE",
                                "max": "@config.sliderMax",
                                "min": "@config.sliderMin",
                                "showTooltip": true,
