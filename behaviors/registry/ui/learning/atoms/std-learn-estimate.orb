                "event": "SET_ESTIMATE",
                "eventId": "evt_01M07580S1NJJ70QS86GC0R5GP",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "and",
                    [
                      "==",
                      "@entity.locked",
                      false
                    ],
                    [
                      "==",
                      "@entity.done",
                      false
                    ]
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "err",
                        [
                          "math/abs",
                          [
                            "-",
                            "@entity.estimate",
                            "@entity.answer"
                          ]
                        ]
                      ],
                      [
                        "rel",
                        [
                          "/",
                          "@err",
                          [
                            "math/max",
                            [
                              "math/abs",
                              "@entity.answer"
                            ],
                            0.0001
                          ]
                        ]
                      ],
                      [
                        "band",
                        [
                          "if",
                          [
                            "<=",
                            "@rel",
                            "@config.exactPct"
                          ],
                          "exact",
                          [
                            "if",
                            [
                              "<=",
                              "@rel",
                              "@config.closePct"
                            ],
                            "close",
                            "off"
                          ]
                        ]
                      ],
                      [
                        "points",
                        [
                          "if",
                          [
                            "==",
                            "@band",
                            "exact"
                          ],
                          "@config.exactPoints",
                          [
                            "if",
                            [
                              "==",
                              "@band",
                              "close"
                            ],
                            "@config.closePoints",
                            0.0
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.locked",
                        true
                      ],
                      [
                        "set",
                        "@entity.band",
                        "@band"
                      ],
                      [
                        "set",
                        "@entity.score",
                        [
                          "+",
                          "@entity.score",
                          "@points"
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        [
                          "str/concat",
                          "Answer: ",
                          [
                            "math/round",
                            "@entity.answer",
                            2.0
                          ],
                          " ",
                          "@entity.unit",
                          " — you were off by ",
                          [
                            "math/round",
                            "@err",
                            2.0
                          ],
                          " (",
                          [
                            "math/round",
                            [
                              "*",
                              "@rel",
                              100.0
                            ],
                            1.0
                          ],
                          "%). +",
                          [
                            "str/concat",
                            "",
                            "@points"
                          ],
                          " points."
                        ]
                      ],
                      [
                        "set",
                        "@entity.view",
                        [
