                            "variant": "bordered"
                          },
                          {
                            "children": [
                              {
                                "content": [
                                  "str/concat",
                                  "Your estimate: ",
                                  [
                                    "math/round",
                                    "@entity.estimate",
                                    2.0
                                  ],
                                  " ",
                                  "@entity.unit"
                                ],
                                "type": "typography",
                                "variant": "caption"
                              },
                              {
                                "action": "SET_ESTIMATE",
                                "max": "@config.sliderMax",
                                "min": "@config.sliderMin",
                                "showTooltip": true,
                                "step": "@config.sliderStep",
                                "type": "range-slider",
                                "value": "@entity.estimate"
                              }
                            ],
                            "direction": "vertical",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "action": "LOCK_IN",
                                "disabled": [
                                  "if",
                                  "@entity.locked",
                                  true,
                                  false
                                ],
                                "label": "@config.lockLabel",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "NEXT",
                                "disabled": [
                                  "if",
                                  "@entity.locked",
                                  false,
                                  true
                                ],
                                "label": "@config.nextLabel",
                                "type": "button",
                                "variant": "secondary"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "label": [
                                  "if",
                                  [
                                    "==",
                                    "@entity.band",
                                    "exact"
                                  ],
                                  "Spot on",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@entity.band",
                                      "close"
                                    ],
                                    "Close",
                                    "Off"
                                  ]
                                ],
                                "type": "badge",
