                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ31CXPPY57H8M8MZEZ1",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Runtime content feed, honoured only when rosterSource is event — mode names the instrument it is for (the matchMode it carries, blank when standalone) and bodies is the initial body list; a matching instrument re-initialises from it exactly as INIT does from config, any other instrument hides.",
                "id": "evt_01M459VBBQNQQF6RSEWE131H3E",
                "key": "ROSTER_LOADED",
                "name": "Roster Loaded",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "bodies",
                    "properties": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "x",
                        "required": true,
