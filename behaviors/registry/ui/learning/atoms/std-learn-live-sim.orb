                                "+",
                                [
                                  "object/get",
                                  "@b",
                                  "x"
                                ],
                                "@nvx"
                              ]
                            ],
                            [
                              "ny",
                              [
                                "+",
                                [
                                  "object/get",
                                  "@b",
                                  "y"
                                ],
                                "@nvy"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "hitx",
                                [
                                  "or",
                                  [
                                    "<",
                                    "@nx",
                                    "@r"
                                  ],
                                  [
                                    ">",
                                    "@nx",
                                    [
                                      "-",
                                      "@config.width",
                                      "@r"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "hity",
                                [
                                  "or",
                                  [
                                    "<",
                                    "@ny",
                                    "@r"
                                  ],
                                  [
                                    ">",
                                    "@ny",
                                    [
                                      "-",
                                      "@config.height",
                                      "@r"
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "object/merge",
                              "@b",
                              {
                                "vx": [
                                  "if",
                                  "@hitx",
                                  [
                                    "*",
                                    "@nvx",
                                    [
                                      "*",
                                      -1.0,
                                      "@config.restitution"
                                    ]
                                  ],
                                  "@nvx"
                                ],
                                "vy": [
                                  "if",
                                  "@hity",
                                  [
                                    "*",
                                    "@nvy",
                                    [
                                      "*",
                                      -1.0,
                                      "@config.restitution"
                                    ]
                                  ],
                                  "@nvy"
                                ],
                                "x": [
                                  "math/clamp",
                                  "@nx",
                                  "@r",
                                  [
                                    "-",
                                    "@config.width",
                                    "@r"
                                  ]
                                ],
                                "y": [
                                  "math/clamp",
                                  "@ny",
                                  "@r",
                                  [
                                    "-",
                                    "@config.height",
                                    "@r"
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.tickCount",
                  [
                    "+",
                    "@entity.tickCount",
                    1.0
                  ]
                ],
                [
                  "set",
                  "@entity.sampleSpeed",
                  [
                    "let",
                    [
                      [
                        "s",
                        [
                          "array/first",
                          "@entity.bodies"
                        ]
                      ]
                    ],
                    [
                      "math/sqrt",
                      [
                        "+",
                        [
                          "*",
                          [
                            "object/get",
                            "@s",
                            "vx"
                          ],
                          [
                            "object/get",
                            "@s",
                            "vx"
                          ]
                        ],
                        [
                          "*",
                          [
                            "object/get",
                            "@s",
                            "vy"
                          ],
                          [
                            "object/get",
                            "@s",
                            "vy"
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "render-ui",
                  "main",
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "children": [
                              {
                                "action": "RUN",
                                "disabled": [
                                  "if",
                                  "@entity.running",
                                  true,
                                  false
                                ],
                                "label": "Run",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "PAUSE",
                                "disabled": [
                                  "if",
                                  "@entity.running",
                                  false,
                                  true
                                ],
                                "label": "Pause",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "RESET",
                                "label": "Reset",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "content": [
                                  "str/concat",
                                  "Gravity: ",
                                  [
                                    "math/round",
                                    "@entity.gravity",
                                    2.0
                                  ]
                                ],
                                "type": "typography",
                                "variant": "caption"
                              },
                              {
                                "action": "SET_GRAVITY",
                                "max": 1.5,
                                "min": -1.0,
                                "showTooltip": true,
                                "step": 0.05,
                                "type": "range-slider",
                                "value": "@entity.gravity"
                              }
                            ],
                            "direction": "vertical",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "content": [
                                  "str/concat",
                                  "Damping: ",
                                  [
                                    "math/round",
                                    "@entity.damping",
                                    3.0
                                  ]
                                ],
                                "type": "typography",
                                "variant": "caption"
                              },
                              {
                                "action": "SET_DAMPING",
                                "max": 1.0,
                                "min": 0.9,
                                "showTooltip": true,
                                "step": 0.005,
                                "type": "range-slider",
                                "value": "@entity.damping"
                              }
                            ],
                            "direction": "vertical",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "backgroundColor": "@config.backgroundColor",
                            "bodies": "@entity.bodies",
                            "height": "@config.height",
                            "showForces": false,
                            "showVelocity": "@config.showVelocity",
                            "type": "physics-canvas",
                            "velocityScale": "@config.velocityScale",
                            "width": "@config.width"
                          },
                          {
                            "content": [
                              "str/concat",
                              "Tick ",
                              [
                                "str/concat",
                                "",
                                "@entity.tickCount"
                              ],
                              " · sample speed ",
                              [
                                "math/round",
                                "@entity.sampleSpeed",
                                2.0
                              ]
                            ],
                            "type": "typography",
                            "variant": "body"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ]
              ],
              "guard": "@entity.running",
              "interval": 32.0,
              "name": "liveSimTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}