          "linkedEntity": "LiveSimScene",
          "linkedEntityId": "ent_01M055GQ2YCEXV9B4PV2QWR1NZ",
          "name": "LiveSimSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GQ2Y9A0FGVJ8PVC52HY1",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ31CXPPY57H8M8MZEZ1",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Run — the tick begins integrating gravity, damping, and wall bounce for every body.",
                "id": "evt_01M055GQ31V99AD3X5BSGZ50SQ",
                "key": "RUN",
                "name": "Run",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Pause — the simulation freezes at its current positions and velocities.",
                "id": "evt_01M055GQ318CJ95CR6RNWJ5J1F",
                "key": "PAUSE",
                "name": "Pause",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset — bodies, gravity, and damping revert to their configured initial values and the tick counter clears.",
                "id": "evt_01M055GQ31EWD2XQ1N7MQTJ0ZJ",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "Learner dragged the gravity slider — value is the new downward acceleration applied to every body each tick.",
                "id": "evt_01M055GQ319J25M1C7A7HV60V5",
                "key": "SET_GRAVITY",
                "name": "Set Gravity",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the damping slider — value is the new fraction of velocity retained each tick (air resistance).",
                "id": "evt_01M055GQ3187XSW1V152N3TNTT",
                "key": "SET_DAMPING",
                "name": "Set Damping",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The simulation was started or paused — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ31FTYG1Z9EGPHP10X8",
                "key": "RUN_TOGGLED",
                "name": "Run Toggled",
                "payloadSchema": [
                  {
                    "name": "running",
                    "type": "boolean"
                  }
                ],
                "synonyms": "run state, play pause, sim toggle",
                "tier": "domain"
              },
              {
                "description": "The learner reset the simulation back to its configured initial bodies and dynamics.",
                "id": "evt_01M055GQ311HG5Q1BENTXFX8E7",
                "key": "SIM_RESET",
                "name": "Sim Reset",
                "payloadSchema": [
                  {
                    "name": "bodyCount",
                    "type": "number"
                  }
                ],
                "synonyms": "sim restart, clear run, revert bodies",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
