                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "RUN",
                                  "disabled": [
                                    "if",
                                    "@entity.running",
                                    true,
                                    false
                                  ],
                                  "label": "Run",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "PAUSE",
                                  "disabled": [
