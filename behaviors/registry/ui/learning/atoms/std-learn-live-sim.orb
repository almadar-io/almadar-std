                      {
                        "name": "vx",
                        "type": "number"
                      },
                      {
                        "name": "vy",
                        "type": "number"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed the Play/Pause toggle — flips the running flag.",
                "id": "evt_01M41KVGQQZA8MVJB3B34CH9FH",
                "key": "TOGGLE_RUN",
                "name": "Toggle Run",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Run — the tick begins integrating gravity, damping, and wall bounce for every body.",
                "id": "evt_01M055GQ31V99AD3X5BSGZ50SQ",
                "key": "RUN",
                "name": "Run",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Pause — the simulation freezes at its current positions and velocities.",
                "id": "evt_01M055GQ318CJ95CR6RNWJ5J1F",
                "key": "PAUSE",
                "name": "Pause",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset — bodies, gravity, and damping revert to their configured initial values and the tick counter clears.",
                "id": "evt_01M055GQ31EWD2XQ1N7MQTJ0ZJ",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "Learner dragged the gravity slider — value is the new downward acceleration applied to every body each tick.",
                "id": "evt_01M055GQ319J25M1C7A7HV60V5",
                "key": "SET_GRAVITY",
                "name": "Set Gravity",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the damping slider — value is the new fraction of velocity retained each tick (air resistance).",
                "id": "evt_01M055GQ3187XSW1V152N3TNTT",
                "key": "SET_DAMPING",
                "name": "Set Damping",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
