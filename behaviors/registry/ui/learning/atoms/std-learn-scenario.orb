          ],
          "emits": [
            {
              "description": "A decision was taken: the node reached, both metric values after the deltas, and whether the run just ended — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "CHOICE_MADE",
              "eventId": "evt_01M07581GA8E1HK0ZGEASZGMN3",
              "payloadSchema": [
                {
                  "name": "nodeId",
                  "type": "string"
                },
                {
                  "name": "metricA",
                  "type": "number"
                },
                {
                  "name": "metricB",
                  "type": "number"
                },
                {
                  "name": "ended",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "branching scenario, choose your path, decision tree, consequences, trade-offs, what-if",
              "tier": "domain"
            },
            {
              "description": "The learner restarted the scenario from scratch.",
              "event": "SCENARIO_RESTARTED",
              "eventId": "evt_01M07581GAV3EJ9GX9Q5RE5T57",
              "payloadSchema": [
                {
                  "name": "startId",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "choices",
              "currentId",
              "done",
              "feedback",
              "metricA",
              "metricB",
              "nodes",
              "path",
              "situation",
              "startId",
              "stepCount",
              "title",
              "view"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "ScenarioScene": "ent_01M07581G7JAW49SNHQDS3PH1D"
          },
          "id": "trt_01M07581G7AY0MGAMJFPDR2Z8Z",
          "linkedEntity": "ScenarioScene",
          "linkedEntityId": "ent_01M07581G7JAW49SNHQDS3PH1D",
          "name": "ScenarioSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M07581G765VPJBCN6TX03WE3",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M07581GASKSPTBR0AKY9KB4B",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Runtime content feed, honoured only when rosterSource is event — mode names the instrument it is for (the matchMode it carries, blank when standalone) and nodes is the decision graph and startId the node it opens on; a matching instrument re-initialises from it exactly as INIT does from config, any other instrument hides.",
                "id": "evt_01M459WQST1QVEH3HQFBJCAQF7",
                "key": "ROSTER_LOADED",
                "name": "Roster Loaded",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "nodes",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "situation",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "choices",
                        "properties": [
                          {
                            "name": "label",
                            "required": true,
                            "type": "string"
                          },
                          {
                            "name": "next",
                            "required": true,
                            "type": "string"
                          },
                          {
                            "name": "deltaA",
                            "type": "number"
                          },
                          {
                            "name": "deltaB",
                            "type": "number"
                          },
                          {
                            "name": "note",
                            "type": "string"
                          }
                        ],
                        "type": "[object]"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "startId",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked one of the current node's choices — index selects it; its metric deltas apply, the decision log grows, and the story moves to the declared next node.",
                "id": "evt_01M07581GAXGCFP96CXPQ3WEKG",
                "key": "CHOOSE",
                "name": "Choose",
                "payloadSchema": [
                  {
                    "name": "index",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner restarted the scenario from the start node with fresh metrics and an empty decision log.",
                "id": "evt_01M07581GA4D364K46318DFQET",
                "key": "RESTART",
                "name": "Restart",
                "tier": "domain"
              },
              {
                "description": "A decision was taken: the node reached, both metric values after the deltas, and whether the run just ended — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M07581GA8E1HK0ZGEASZGMN3",
                "key": "CHOICE_MADE",
                "name": "Choice Made",
                "payloadSchema": [
                  {
                    "name": "nodeId",
                    "type": "string"
                  },
                  {
                    "name": "metricA",
                    "type": "number"
                  },
                  {
                    "name": "metricB",
                    "type": "number"
                  },
                  {
                    "name": "ended",
                    "type": "boolean"
                  }
                ],
                "synonyms": "branching scenario, choose your path, decision tree, consequences, trade-offs, what-if",
                "tier": "domain"
              },
              {
                "description": "The learner restarted the scenario from scratch.",
                "id": "evt_01M07581GAV3EJ9GX9Q5RE5T57",
                "key": "SCENARIO_RESTARTED",
                "name": "Scenario Restarted",
                "payloadSchema": [
                  {
                    "name": "startId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.nodes",
                    "@config.nodes"
                  ],
                  [
                    "set",
                    "@entity.startId",
                    "@config.startId"
                  ],
                  [
                    "let",
                    [
                      [
                        "start",
                        [
                          "array/find",
                          "@config.nodes",
                          [
                            "fn",
                            "n",
                            [
                              "==",
                              [
                                "object/get",
                                "@n",
                                "id"
                              ],
                              "@config.startId"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.currentId",
                        "@config.startId"
                      ],
                      [
                        "set",
                        "@entity.situation",
                        [
                          "object/get",
                          "@start",
                          "situation"
                        ]
                      ],
                      [
                        "set",
                        "@entity.choices",
                        [
                          "object/get",
                          "@start",
                          "choices",
                          []
                        ]
                      ],
                      [
                        "set",
                        "@entity.metricA",
                        "@config.metricAStart"
                      ],
                      [
                        "set",
                        "@entity.metricB",
                        "@config.metricBStart"
                      ],
                      [
                        "set",
                        "@entity.stepCount",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.path",
                        []
                      ],
