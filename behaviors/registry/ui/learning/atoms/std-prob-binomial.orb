      },
      "id": "orb_01KZNF6QWDR2ABNWR8WYPJR9TE",
      "name": "ProbBinomialOrbital",
      "pages": [
        {
          "id": "pag_01KZNF6QWEVGH1AJYY7MMVDD7N",
          "name": "ProbBinomialPage",
          "path": "/prob-binomial",
          "traits": [
            {
              "ref": "ProbBinomialSim",
              "refId": "trt_01KZNF6QWDY7114G62DGS5A049"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "biasP": {
              "default": 0.5,
              "description": "Probability of heads on each flip — shifts the histogram and the theoretical PMF.",
              "label": "Bias p",
              "synonyms": "coin bias, success probability, binomial p, weighted coin",
              "tier": "domain",
              "type": "number"
            },
            "height": {
              "default": 400.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "maxRuns": {
              "default": 500.0,
              "description": "Cap on accumulated trials; further runs are ignored until Reset.",
              "label": "Max Runs",
              "tier": "domain",
              "type": "number"
            },
            "runsPerStep": {
              "default": 25.0,
              "description": "How many trials Run Many adds to the histogram per click.",
              "label": "Runs Per Step",
              "tier": "domain",
              "type": "number"
            },
            "showTheoreticalPMF": {
              "default": true,
              "description": "Overlay the binomial probability mass function (Stirling-approximated factorials) as markers the empirical histogram converges to.",
              "label": "Show Theoretical PMF",
              "synonyms": "pmf, theoretical distribution, binomial distribution",
              "tier": "domain",
              "type": "boolean"
            },
            "title": {
              "default": "Binomial Trials",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "trialsPerRun": {
              "default": 10.0,
              "description": "Number of coin flips n per trial — the histogram x-axis runs from 0 to n heads.",
              "label": "Trials Per Run",
              "synonyms": "n, flips per trial, binomial n, number of trials",
              "tier": "domain",
              "type": "number"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The binomial accumulation state after each run — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "BINOMIAL_UPDATED",
              "eventId": "evt_01KZNF6QWE47K3PM00KK7T6RGH",
              "payloadSchema": [
                {
                  "name": "runsRun",
                  "type": "number"
                },
                {
                  "name": "lastHeads",
                  "type": "number"
                },
                {
                  "name": "counts",
                  "type": "[number]"
                }
              ],
              "scope": "external",
              "synonyms": "binomial trial, coin flip run, heads count, pmf convergence",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "biasP",
              "counts",
              "lastHeads",
              "runsRun",
              "shapes",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "ProbBinomialScene": "ent_01KZNF6QWDC46YANP91V5JGSKN"
          },
          "id": "trt_01KZNF6QWDY7114G62DGS5A049",
          "linkedEntity": "ProbBinomialScene",
          "linkedEntityId": "ent_01KZNF6QWDC46YANP91V5JGSKN",
          "name": "ProbBinomialSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNF6QWD6JEZ7RG442SPXR8B",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNF6QWETTZHGYQ41GEJ5NWD",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QWE3DBCWRKEZV1RQYJ7",
                "key": "RUN_TRIAL",
                "name": "Run Trial"
              },
              {
                "id": "evt_01KZNF6QWE3PFQNWCCW4T6TFDH",
                "key": "RUN_MANY",
                "name": "Run Many"
              },
              {
                "description": "Learner dragged the bias slider — value is the new coin bias p; changing p clears the accumulated runs.",
                "id": "evt_01KZNF6QWEW006WH7F50H4XNSX",
                "key": "SET_P",
                "name": "Set P",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QWE05AQRNJHXCPTVWRW",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The binomial accumulation state after each run — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNF6QWE47K3PM00KK7T6RGH",
                "key": "BINOMIAL_UPDATED",
                "name": "Binomial Updated",
                "payloadSchema": [
                  {
                    "name": "runsRun",
                    "type": "number"
                  },
                  {
                    "name": "lastHeads",
                    "type": "number"
                  },
                  {
                    "name": "counts",
                    "type": "[number]"
                  }
                ],
                "synonyms": "binomial trial, coin flip run, heads count, pmf convergence",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.biasP",
                    "@config.biasP"
                  ],
                  [
                    "set",
                    "@entity.counts",
                    [
                      "array/map",
                      [
                        "array/range",
                        [
                          "+",
                          "@config.trialsPerRun",
                          1.0
                        ]
                      ],
                      [
                        "fn",
                        "k",
                        0.0
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.runsRun",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.lastHeads",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "plotW",
                        [
                          "-",
                          "@config.width",
                          48.0
                        ]
                      ],
                      [
                        "plotH",
                        [
                          "-",
                          "@config.height",
                          48.0
                        ]
                      ],
                      [
                        "factN",
                        [
                          "array/reduce",
                          [
                            "array/range",
                            1.0,
                            [
                              "+",
                              "@config.trialsPerRun",
                              1.0
                            ]
                          ],
                          1.0,
                          [
                            "fn",
                            [
                              "acc",
                              "i"
                            ],
                            [
                              "*",
                              "@acc",
                              "@i"
                            ]
                          ]
                        ]
                      ],
                      [
                        "pmfVals",
                        [
                          "array/map",
                          [
                            "array/range",
                            [
                              "+",
                              "@config.trialsPerRun",
                              1.0
                            ]
                          ],
                          [
                            "fn",
                            "k",
                            [
                              "let",
                              [
                                [
                                  "factK",
                                  [
                                    "array/reduce",
                                    [
                                      "array/range",
                                      1.0,
                                      [
                                        "+",
                                        "@k",
                                        1.0
                                      ]
                                    ],
                                    1.0,
                                    [
                                      "fn",
                                      [
                                        "acc",
                                        "i"
                                      ],
                                      [
                                        "*",
                                        "@acc",
                                        "@i"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "factNmK",
                                  [
                                    "array/reduce",
                                    [
                                      "array/range",
                                      1.0,
                                      [
                                        "+",
                                        [
                                          "-",
                                          "@config.trialsPerRun",
                                          "@k"
                                        ],
                                        1.0
                                      ]
                                    ],
                                    1.0,
                                    [
                                      "fn",
                                      [
                                        "acc",
                                        "i"
                                      ],
                                      [
                                        "*",
                                        "@acc",
                                        "@i"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "comb",
                                  [
                                    "/",
                                    "@factN",
                                    [
                                      "*",
                                      "@factK",
                                      "@factNmK"
                                    ]
                                  ]
                                ],
                                [
                                  "powP",
                                  [
                                    "math/pow",
                                    "@entity.biasP",
                                    "@k"
                                  ]
                                ],
                                [
                                  "powQ",
                                  [
                                    "math/pow",
                                    [
                                      "-",
                                      1.0,
                                      "@entity.biasP"
                                    ],
                                    [
                                      "-",
                                      "@config.trialsPerRun",
                                      "@k"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "*",
                                "@comb",
                                [
                                  "*",
                                  "@powP",
                                  "@powQ"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "maxPmf",
                        [
                          "math/max",
                          0.0001,
                          [
                            "array/max",
                            "@pmfVals"
                          ]
                        ]
                      ],
                      [
                        "maxVal",
                        [
                          "*",
                          "@maxPmf",
                          1.25
                        ]
                      ],
                      [
                        "pmfShapes",
                        [
                          "if",
                          "@config.showTheoreticalPMF",
                          [
                            "array/map",
                            [
                              "array/range",
                              [
                                "+",
                                "@config.trialsPerRun",
                                1.0
                              ]
                            ],
                            [
                              "fn",
                              "k",
                              {
                                "fill": "#dc2626",
                                "lineWidth": 0.0,
                                "radius": 4.0,
                                "type": "circle",
                                "x": [
                                  "+",
                                  24.0,
                                  [
                                    "*",
                                    [
                                      "+",
                                      "@k",
                                      0.5
                                    ],
                                    [
                                      "/",
                                      "@plotW",
                                      [
                                        "+",
                                        "@config.trialsPerRun",
                                        1.0
                                      ]
                                    ]
                                  ]
                                ],
                                "y": [
                                  "-",
                                  [
                                    "+",
                                    24.0,
                                    "@plotH"
                                  ],
                                  [
                                    "*",
                                    [
                                      "/",
                                      [
                                        "array/nth",
                                        "@pmfVals",
                                        "@k"
                                      ],
                                      "@maxVal"
                                    ],
                                    "@plotH"
                                  ]
                                ]
                              }
                            ]
                          ],
                          []
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.shapes",
                      "@pmfShapes"
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "RUN_TRIAL",
                                  "label": "Run Trial",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RUN_MANY",
                                  "label": "Run Many",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Bias p: ",
                                [
                                  "math/round",
                                  "@entity.biasP",
                                  2.0
                                ],
                                " — flips per trial: ",
                                "@config.trialsPerRun"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "SET_P",
                              "max": 1.0,
                              "min": 0.0,
                              "showTooltip": true,
                              "step": 0.01,
                              "type": "range-slider",
                              "value": "@entity.biasP"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.trialsPerRun",
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.runsRun",
                                " run(s) — last trial heads: ",
                                "@entity.lastHeads",
                                " / ",
                                "@config.trialsPerRun"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
