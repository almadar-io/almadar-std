                    ]
                  ],
                  [
                    "set",
                    "@entity.trialCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.phase",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "n",
                        [
                          "array/len",
                          "@entity.history"
                        ]
                      ],
                      [
                        "marginX",
                        40.0
                      ],
                      [
                        "marginY",
                        24.0
                      ],
                      [
                        "plotWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "*",
                            "@marginX",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotHeight",
                        [
                          "-",
                          "@config.height",
                          [
                            "*",
                            "@marginY",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          "@marginY"
                        ]
                      ],
                      [
                        "points",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "v",
                                  [
                                    "array/nth",
                                    "@entity.history",
                                    "@i"
                                  ]
                                ],
                                [
                                  "x",
                                  [
                                    "+",
                                    "@marginX",
                                    [
                                      "if",
                                      [
                                        "<=",
                                        "@n",
                                        1.0
                                      ],
                                      0.0,
                                      [
                                        "*",
                                        [
                                          "/",
                                          "@i",
                                          [
                                            "-",
                                            "@n",
                                            1.0
                                          ]
                                        ],
                                        "@plotWidth"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yRatio",
                                  [
                                    "math/clamp",
                                    [
                                      "/",
                                      "@v",
                                      "@config.lambda"
                                    ],
                                    0.0,
                                    1.0
                                  ]
                                ],
                                [
                                  "y",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      "@yRatio",
                                      "@plotHeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@y"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "current",
                        [
                          "array/last",
                          "@points"
                        ]
                      ],
                      [
                        "pathD",
                        [
                          "array/reduce",
                          "@points",
                          "",
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "str/concat",
                              "@acc",
                              [
                                "if",
                                [
                                  "==",
                                  "@acc",
                                  ""
                                ],
                                "M",
                                " L"
                              ],
                              " ",
                              [
                                "object/get",
                                "@p",
                                "x"
                              ],
                              " ",
                              [
                                "object/get",
                                "@p",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
