      "id": "orb_01KZEFWYXAX07WVC3SAD8WZHKG",
      "name": "PsychConditioningOrbital",
      "pages": [
        {
          "id": "pag_01KZEFWYXBGK8XEG8B35ZDNS4F",
          "name": "PsychConditioningPage",
          "path": "/psych-conditioning",
          "traits": [
            {
              "ref": "PsychConditioningSim",
              "refId": "trt_01KZEFWYXAWCDM734R1SXRW34G"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "alpha": {
              "default": 0.3,
              "description": "Rescorla-Wagner learning-rate parameter — the fraction of the prediction error (λ − V, or 0 − V during extinction) applied to associative strength on each trial.",
              "label": "Learning Rate (α)",
              "synonyms": "alpha, learning rate, Rescorla-Wagner alpha, salience, associability",
              "tier": "domain",
              "type": "number"
            },
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f8fafc",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "curveColor": {
              "default": "#2563eb",
              "description": "Color of the acquisition/extinction curve polyline and its current-value marker.",
              "label": "Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": 420.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "historyCap": {
              "default": 30.0,
              "description": "Maximum number of sampled associative-strength points kept in the acquisition/extinction curve history; older points are dropped once this is exceeded.",
              "label": "History Cap",
              "synonyms": "history length, curve window, sample cap",
              "tier": "domain",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "lambda": {
              "default": 1.0,
              "description": "Maximum associative strength the unconditioned stimulus supports; RUN_PAIRING drives V toward this value, RUN_CS_ALONE (extinction) drives V toward 0.",
              "label": "Asymptote (λ)",
              "synonyms": "lambda, asymptote, maximum associative strength, US intensity, unconditioned stimulus intensity",
              "tier": "domain",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Classical Conditioning",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The conditioning state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "CONDITIONING_UPDATED",
              "eventId": "evt_01KZEFWYXBWF6YJDS1DRFA8Q73",
              "payloadSchema": [
                {
                  "name": "strength",
                  "type": "number"
                },
                {
                  "name": "trialCount",
                  "type": "number"
                },
                {
                  "name": "phase",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "conditioning update, associative strength, acquisition, extinction, trial result",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "curveShapes",
              "history",
              "phase",
              "strength",
              "title",
              "trialCount"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "PsychConditioningScene": "ent_01KZEFWYXAV87F81GXK8RXCP2Y"
          },
          "id": "trt_01KZEFWYXAWCDM734R1SXRW34G",
          "linkedEntity": "PsychConditioningScene",
          "linkedEntityId": "ent_01KZEFWYXAV87F81GXK8RXCP2Y",
          "name": "PsychConditioningSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFWYXA0537FWF9KX04YV5Z",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFWYXBSX5EB0WQPECBT9PT",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner ran a CS+US pairing trial, driving associative strength toward the asymptote via the Rescorla-Wagner acquisition rule.",
                "id": "evt_01KZEFWYXBBCP3TXHEHN81VKCW",
                "key": "RUN_PAIRING",
                "name": "Run Pairing",
                "tier": "domain"
              },
              {
                "description": "Learner ran a CS-alone trial, driving associative strength toward zero via the Rescorla-Wagner extinction rule.",
                "id": "evt_01KZEFWYXB4SRA8R78AC7FXEKW",
                "key": "RUN_CS_ALONE",
                "name": "Run Cs Alone",
                "tier": "domain"
              },
              {
                "description": "Learner reset the trial history — associative strength, trial count, and phase all return to their starting values.",
                "id": "evt_01KZEFWYXBGKWD8BZ9VCYD9NTC",
                "key": "RESET_TRIALS",
                "name": "Reset Trials",
                "tier": "domain"
              },
              {
                "description": "The conditioning state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFWYXBWF6YJDS1DRFA8Q73",
                "key": "CONDITIONING_UPDATED",
                "name": "Conditioning Updated",
                "payloadSchema": [
                  {
                    "name": "strength",
                    "type": "number"
                  },
                  {
                    "name": "trialCount",
                    "type": "number"
                  },
                  {
                    "name": "phase",
                    "type": "string"
                  }
                ],
                "synonyms": "conditioning update, associative strength, acquisition, extinction, trial result",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.strength",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.history",
                    [
                      0.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.trialCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.phase",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "n",
                        [
                          "array/len",
                          "@entity.history"
                        ]
                      ],
                      [
                        "marginX",
                        40.0
                      ],
                      [
                        "marginY",
                        24.0
                      ],
                      [
                        "plotWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "*",
                            "@marginX",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotHeight",
                        [
                          "-",
                          "@config.height",
                          [
                            "*",
                            "@marginY",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          "@marginY"
                        ]
                      ],
                      [
                        "points",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "v",
                                  [
                                    "array/nth",
                                    "@entity.history",
                                    "@i"
                                  ]
                                ],
                                [
                                  "x",
                                  [
                                    "+",
                                    "@marginX",
                                    [
                                      "if",
                                      [
                                        "<=",
                                        "@n",
                                        1.0
                                      ],
                                      0.0,
                                      [
                                        "*",
                                        [
                                          "/",
                                          "@i",
                                          [
                                            "-",
                                            "@n",
                                            1.0
                                          ]
                                        ],
                                        "@plotWidth"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yRatio",
                                  [
                                    "math/clamp",
                                    [
                                      "/",
                                      "@v",
                                      "@config.lambda"
                                    ],
                                    0.0,
                                    1.0
                                  ]
                                ],
                                [
                                  "y",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      "@yRatio",
                                      "@plotHeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@y"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "current",
                        [
                          "array/last",
                          "@points"
                        ]
                      ],
                      [
                        "pathD",
                        [
                          "array/reduce",
                          "@points",
                          "",
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "str/concat",
                              "@acc",
                              [
                                "if",
                                [
                                  "==",
                                  "@acc",
                                  ""
                                ],
                                "M",
                                " L"
                              ],
                              " ",
                              [
                                "object/get",
                                "@p",
                                "x"
                              ],
                              " ",
                              [
                                "object/get",
                                "@p",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "curveShapes",
                        [
                          "array/concat",
                          [
                            {
                              "color": "#94a3b8",
                              "id": "baseline",
                              "lineWidth": 1.0,
                              "type": "line",
                              "x1": "@marginX",
                              "x2": [
                                "+",
                                "@marginX",
                                "@plotWidth"
                              ],
                              "y1": "@plotBottom",
                              "y2": "@plotBottom"
                            },
                            {
                              "color": "#cbd5e1",
                              "id": "asymptote",
                              "lineWidth": 1.0,
                              "type": "line",
                              "x1": "@marginX",
                              "x2": [
                                "+",
                                "@marginX",
                                "@plotWidth"
                              ],
                              "y1": [
                                "-",
                                "@plotBottom",
                                "@plotHeight"
                              ],
                              "y2": [
                                "-",
                                "@plotBottom",
                                "@plotHeight"
                              ]
                            },
                            {
                              "color": "@config.curveColor",
                              "id": "curve",
                              "lineWidth": 2.5,
                              "path": "@pathD",
                              "type": "path"
                            }
                          ],
                          [
                            {
                              "color": "@config.curveColor",
                              "fill": "@config.curveColor",
                              "id": "current",
                              "radius": 5.0,
                              "type": "circle",
                              "x": [
                                "object/get",
                                "@current",
                                "x"
                              ],
                              "y": [
                                "object/get",
                                "@current",
                                "y"
                              ]
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.curveShapes",
                        "@curveShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": [],
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": [],
                              "shapes": "@entity.curveShapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                {
                                  "label": [
                                    "if",
                                    [
                                      "==",
                                      "@entity.phase",
                                      ""
                                    ],
                                    "No Trials Yet",
                                    "@entity.phase"
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    [
                                      "==",
                                      "@entity.phase",
                                      "ACQUISITION"
                                    ],
                                    "success",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@entity.phase",
                                        "EXTINCTION"
                                      ],
                                      "danger",
                                      "neutral"
                                    ]
                                  ]
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Trials run: ",
                                    "@entity.trialCount"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Associative strength (V): ",
                                [
                                  "math/round",
                                  "@entity.strength",
                                  3.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                {
                                  "action": "RUN_PAIRING",
                                  "label": "Run Pairing (CS+US)",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RUN_CS_ALONE",
                                  "label": "Run CS Alone (Extinction)",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET_TRIALS",
                                  "label": "Reset Trials",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
