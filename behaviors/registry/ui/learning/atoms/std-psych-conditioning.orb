                              "color": "@config.curveColor",
                              "fill": "@config.curveColor",
                              "id": "current",
                              "radius": 5.0,
                              "type": "circle",
                              "x": [
                                "object/get",
                                "@current",
                                "x"
                              ],
                              "y": [
