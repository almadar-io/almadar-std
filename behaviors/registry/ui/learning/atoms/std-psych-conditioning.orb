                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": [],
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": [],
                              "shapes": "@entity.curveShapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                {
                                  "label": [
                                    "if",
                                    [
                                      "==",
                                      "@entity.phase",
                                      ""
                                    ],
                                    "No Trials Yet",
                                    "@entity.phase"
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    [
                                      "==",
                                      "@entity.phase",
                                      "ACQUISITION"
                                    ],
                                    "success",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@entity.phase",
                                        "EXTINCTION"
                                      ],
                                      "danger",
