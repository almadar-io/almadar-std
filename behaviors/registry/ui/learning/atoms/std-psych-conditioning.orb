                "event": "INIT",
                "eventId": "evt_01KZEFWYXA0537FWF9KX04YV5Z",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
