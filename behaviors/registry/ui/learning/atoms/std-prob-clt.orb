              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "populationKind": {
              "default": "uniform",
              "description": "Shape of the population each sample is drawn from: uniform, skewed, or bimodal — the CLT normalizes the means-histogram regardless.",
              "label": "Population Kind",
              "synonyms": "population distribution, skewed distribution, bimodal, uniform distribution, sampling distribution, central limit theorem",
              "tier": "domain",
              "type": "string"
            },
            "sampleSize": {
              "default": 30.0,
              "description": "Number of draws n per sample; larger n makes the means-histogram narrower and more normal.",
              "label": "Sample Size",
              "synonyms": "n, sample size, draws per sample",
              "tier": "domain",
              "type": "number"
            },
            "showTrueMean": {
              "default": true,
              "description": "Draw a marker line at the population mean.",
              "label": "Show True Mean",
              "tier": "presentation",
              "type": "boolean"
            },
            "title": {
