                "id": "evt_01KZNF6QVTE44T4X5P537EZPEX",
                "key": "CLT_UPDATED",
                "name": "Clt Updated",
                "payloadSchema": [
                  {
                    "name": "drawsRun",
                    "type": "number"
                  },
                  {
                    "name": "lastSampleMean",
                    "type": "number"
                  },
                  {
                    "name": "means",
                    "type": "[number]"
                  }
                ],
                "synonyms": "sample drawn, means histogram, central limit theorem, sampling distribution",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
