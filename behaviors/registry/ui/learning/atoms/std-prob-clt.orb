                "key": "DRAW_MANY",
                "name": "Draw Many"
              },
              {
                "description": "Learner dragged the sample-size slider — value is the new n; changing n clears the accumulated means.",
                "id": "evt_01KZNF6QVT6AVCNY4H97KVR43W",
                "key": "SET_N",
                "name": "Set N",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
