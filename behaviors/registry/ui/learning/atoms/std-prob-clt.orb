                    []
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "DRAW_SAMPLE",
                                  "label": "Draw Sample",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "DRAW_MANY",
                                  "label": "Draw Many",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Sample size n: ",
                                "@entity.sampleSize"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "SET_N",
                              "max": 100.0,
                              "min": 2.0,
                              "showTooltip": true,
                              "step": 1.0,
                              "type": "range-slider",
                              "value": "@entity.sampleSize"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 10.0,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.valueMax",
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.drawsRun",
                                " sample(s) drawn — last sample mean ",
                                [
                                  "math/round",
                                  "@entity.lastSampleMean",
                                  1.0
                                ],
                                " (population mean ",
                                "@config.trueMean",
                                ")"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZNF6QVRM3XTJ73HPD2N0ZBA",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.sampleSize",
                    "@config.sampleSize"
                  ],
                  [
                    "set",
                    "@entity.means",
                    []
                  ],
                  [
                    "set",
                    "@entity.drawsRun",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.lastSampleMean",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.shapes",
                    []
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "DRAW_SAMPLE",
                                  "label": "Draw Sample",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "DRAW_MANY",
                                  "label": "Draw Many",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Sample size n: ",
                                "@entity.sampleSize"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "SET_N",
                              "max": 100.0,
                              "min": 2.0,
                              "showTooltip": true,
                              "step": 1.0,
                              "type": "range-slider",
                              "value": "@entity.sampleSize"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 10.0,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.valueMax",
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.drawsRun",
                                " sample(s) drawn — last sample mean ",
                                [
                                  "math/round",
                                  "@entity.lastSampleMean",
                                  1.0
                                ],
                                " (population mean ",
                                "@config.trueMean",
                                ")"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZNF6QVT65TCF601DSWDZCZX",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "sample",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@entity.sampleSize"
                          ],
                          [
                            "fn",
                            "j",
                            [
                              "if",
                              [
                                "==",
                                "@config.populationKind",
                                "skewed"
                              ],
                              [
                                "*",
                                "@config.valueMax",
                                [
                                  "*",
                                  [
                                    "math/random"
                                  ],
                                  [
                                    "math/random"
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  "@config.populationKind",
                                  "bimodal"
                                ],
                                [
                                  "if",
                                  [
                                    "<",
                                    [
                                      "math/random"
                                    ],
                                    0.5
                                  ],
                                  [
                                    "*",
                                    "@config.valueMax",
                                    [
                                      "*",
                                      0.5,
                                      [
                                        "math/random"
                                      ]
                                    ]
                                  ],
