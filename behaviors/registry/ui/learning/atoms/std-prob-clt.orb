              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "trueMean": {
              "default": 50.0,
              "description": "Population mean the sample means converge to; drawn as a marker line when Show True Mean is on.",
              "label": "True Mean",
              "synonyms": "population mean, expected value, mu",
              "tier": "domain",
              "type": "number"
            },
            "valueMax": {
              "default": 100.0,
