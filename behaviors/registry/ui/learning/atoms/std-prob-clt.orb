                              "action": "SET_N",
                              "max": 100.0,
                              "min": 2.0,
                              "showTooltip": true,
                              "step": 1.0,
                              "type": "range-slider",
                              "value": "@entity.sampleSize"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 10.0,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.valueMax",
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.drawsRun",
                                " sample(s) drawn — last sample mean ",
                                [
                                  "math/round",
                                  "@entity.lastSampleMean",
                                  1.0
                                ],
                                " (population mean ",
                                "@config.trueMean",
                                ")"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "CLT_UPDATED",
                    {
                      "drawsRun": "@entity.drawsRun",
                      "lastSampleMean": "@entity.lastSampleMean",
                      "means": "@entity.means"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KZNF6QVTRGEMKTTQRX8QNSPS",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}