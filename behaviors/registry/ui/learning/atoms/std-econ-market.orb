                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Your price: $",
                                    [
                                      "math/round",
                                      "@entity.price",
                                      2.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": "@config.maxPrice",
                                  "min": 0.0,
                                  "onChange": "SET_PRICE",
                                  "showTooltip": true,
                                  "step": "@config.priceStep",
                                  "type": "range-slider",
                                  "value": "@entity.price"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "type": "divider"
                            },
