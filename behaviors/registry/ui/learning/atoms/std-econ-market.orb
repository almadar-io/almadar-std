                                  "fontSize": 12.0,
                                  "text": "Equilibrium",
                                  "type": "text",
                                  "x": "@eqLabelX",
                                  "y": "@eqLabelY"
                                }
                              ],
                              []
                            ],
                            [
                              "if",
                              "@qdLabelVisible",
                              [
                                {
                                  "align": "right",
                                  "color": "@config.demandColor",
                                  "fontSize": 12.0,
                                  "text": "Qd",
                                  "type": "text",
                                  "x": "@qdLabelX",
                                  "y": "@qdLabelY"
                                }
                              ],
                              []
                            ]
                          ],
                          [
                            "if",
                            "@qsLabelVisible",
                            [
                              {
                                "align": "left",
                                "color": "@config.supplyColor",
                                "fontSize": 12.0,
                                "text": "Qs",
                                "type": "text",
                                "x": "@qsLabelX",
                                "y": "@qsLabelY"
                              }
                            ],
                            []
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.price",
                        "@newPrice"
                      ],
                      [
                        "set",
                        "@entity.qDemanded",
                        "@qd"
                      ],
                      [
                        "set",
                        "@entity.qSupplied",
                        "@qs"
                      ],
                      [
                        "set",
                        "@entity.marketStatusLabel",
                        "@statusLabel"
                      ],
                      [
                        "set",
                        "@entity.marketStatusMagnitude",
                        "@statusMag"
                      ],
                      [
                        "set",
                        "@entity.curves",
                        "@newCurves"
                      ],
                      [
                        "set",
                        "@entity.points",
                        "@newPoints"
                      ],
                      [
                        "set",
                        "@entity.labelShapes",
                        "@labelShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": "@entity.points",
                              "shapes": "@entity.labelShapes",
                              "showAxes": true,
                              "showGrid": true,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.maxQuantity",
                              "xMin": 0.0,
                              "yMax": "@config.maxPrice",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "action": "SHIFT_DEMAND",
                                  "actionPayload": {
                                    "delta": "@config.demandShiftStep"
                                  },
                                  "label": [
                                    "str/concat",
                                    "Demand +",
                                    "@config.demandShiftStep"
                                  ],
                                  "size": "sm",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "SHIFT_DEMAND",
                                  "actionPayload": {
                                    "delta": [
                                      "-",
                                      0.0,
                                      "@config.demandShiftStep"
                                    ]
                                  },
                                  "label": [
                                    "str/concat",
                                    "Demand −",
                                    "@config.demandShiftStep"
                                  ],
                                  "size": "sm",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "SHIFT_SUPPLY",
                                  "actionPayload": {
                                    "delta": "@config.supplyShiftStep"
                                  },
                                  "label": [
                                    "str/concat",
                                    "Supply +",
                                    "@config.supplyShiftStep"
                                  ],
                                  "size": "sm",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "SHIFT_SUPPLY",
                                  "actionPayload": {
                                    "delta": [
                                      "-",
                                      0.0,
                                      "@config.supplyShiftStep"
                                    ]
                                  },
                                  "label": [
                                    "str/concat",
                                    "Supply −",
                                    "@config.supplyShiftStep"
                                  ],
                                  "size": "sm",
                                  "type": "button",
                                  "variant": "secondary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Your price: $",
                                    [
                                      "math/round",
                                      "@entity.price",
                                      2.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": "@config.maxPrice",
                                  "min": 0.0,
                                  "onChange": "SET_PRICE",
                                  "showTooltip": true,
                                  "step": "@config.priceStep",
                                  "type": "range-slider",
                                  "value": "@entity.price"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "type": "divider"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Equilibrium — price $",
                                [
                                  "math/round",
                                  "@entity.equilibriumPrice",
                                  2.0
                                ],
                                ", quantity ",
                                [
                                  "math/round",
                                  "@entity.equilibriumQuantity",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "At your price — quantity demanded ",
                                [
                                  "math/round",
                                  "@entity.qDemanded",
                                  2.0
                                ],
                                ", quantity supplied ",
                                [
                                  "math/round",
                                  "@entity.qSupplied",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "message": [
                                "if",
                                [
                                  "==",
                                  "@entity.marketStatusLabel",
                                  "Equilibrium"
                                ],
                                "At equilibrium — quantity demanded equals quantity supplied.",
                                [
                                  "str/concat",
                                  "@entity.marketStatusLabel",
                                  " of ",
                                  [
                                    "math/round",
                                    "@entity.marketStatusMagnitude",
                                    2.0
                                  ],
                                  " units — price ",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@entity.marketStatusLabel",
                                      "Surplus"
                                    ],
                                    "above",
                                    "below"
                                  ],
                                  " equilibrium, so the market adjusts toward it."
                                ]
                              ],
                              "type": "alert",
                              "variant": [
                                "if",
                                [
                                  "==",
                                  "@entity.marketStatusLabel",
                                  "Surplus"
                                ],
                                "warning",
                                [
                                  "if",
                                  [
                                    "==",
                                    "@entity.marketStatusLabel",
                                    "Shortage"
                                  ],
                                  "error",
                                  "success"
                                ]
                              ]
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "MARKET_UPDATED",
                    {
                      "equilibriumPrice": "@entity.equilibriumPrice",
                      "equilibriumQuantity": "@entity.equilibriumQuantity",
                      "price": "@entity.price",
                      "qDemanded": "@entity.qDemanded",
                      "qSupplied": "@entity.qSupplied",
                      "status": "@entity.marketStatusLabel"
                    }
                  ]
                ],
                "event": "SET_PRICE",
                "eventId": "evt_01KZEEZFXGEZRTZMC1Q1E4KDBG",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}