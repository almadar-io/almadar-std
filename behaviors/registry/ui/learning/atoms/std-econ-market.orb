                                  "math/round",
                                  "@entity.equilibriumPrice",
                                  2.0
                                ],
                                ", quantity ",
                                [
                                  "math/round",
                                  "@entity.equilibriumQuantity",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "At your price — quantity demanded ",
                                [
