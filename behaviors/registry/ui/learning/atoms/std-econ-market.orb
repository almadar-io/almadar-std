      "name": "EconMarketOrbital",
      "pages": [
        {
          "id": "pag_01KZEEZFXG3MB68W47N9G5XEZY",
          "name": "EconMarketPage",
          "path": "/econ-market",
          "traits": [
            {
              "ref": "EconMarketSim",
              "refId": "trt_01KZEEZFXFJGWMMYQ9MR02CFQ0"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "demandColor": {
              "default": "#dc2626",
              "label": "Demand Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "demandIntercept": {
              "default": 100.0,
              "description": "Choke price — the price at which quantity demanded falls to zero (P = intercept − slope × Q); the demand curve's starting vertical intercept.",
              "label": "Demand Intercept",
              "synonyms": "demand, choke price, maximum willingness to pay, demand curve intercept, demand function",
              "tier": "domain",
              "type": "number"
            },
            "demandShiftStep": {
              "default": 10.0,
              "description": "How much the Demand +/- buttons move the demand intercept per press.",
              "label": "Demand Shift Step",
              "synonyms": "demand shift, demand shock, shift in demand",
              "tier": "domain",
              "type": "number"
            },
            "demandSlope": {
              "default": 1.0,
              "description": "How much price falls for each additional unit demanded — the magnitude of the demand curve's downward slope.",
              "label": "Demand Slope",
              "synonyms": "demand slope, price sensitivity, demand curve steepness",
              "tier": "domain",
              "type": "number"
            },
            "equilibriumColor": {
              "default": "#16a34a",
              "label": "Equilibrium Marker Color",
              "tier": "presentation",
              "type": "string"
            },
            "gridStep": {
              "default": 10.0,
              "description": "Spacing between gridlines on the canvas, in data units (quantity/price).",
              "label": "Grid Step",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 440.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "initialPrice": {
              "default": 50.0,
              "description": "Starting price on the price slider, before the learner adjusts it.",
              "label": "Initial Price",
              "tier": "domain",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "maxPrice": {
              "default": 100.0,
              "description": "Top edge of the price axis, and the price slider's maximum, in currency units.",
              "label": "Max Price (axis)",
              "tier": "presentation",
              "type": "number"
            },
            "maxQuantity": {
              "default": 90.0,
              "description": "Right edge of the quantity axis, in units.",
              "label": "Max Quantity (axis)",
              "tier": "presentation",
              "type": "number"
            },
            "priceLineColor": {
              "default": "#64748b",
              "label": "Price Line Color",
              "tier": "presentation",
              "type": "string"
            },
            "priceStep": {
              "default": 1.0,
              "description": "Slider increment for the price control.",
              "label": "Price Step",
              "tier": "presentation",
              "type": "number"
            },
            "supplyColor": {
              "default": "#2563eb",
              "label": "Supply Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "supplyIntercept": {
              "default": 10.0,
              "description": "Reservation price — the minimum price at which producers begin supplying (P = intercept + slope × Q); the supply curve's starting vertical intercept.",
              "label": "Supply Intercept",
              "synonyms": "supply, reservation price, minimum supply price, supply curve intercept, supply function",
              "tier": "domain",
              "type": "number"
            },
            "supplyShiftStep": {
              "default": 10.0,
              "description": "How much the Supply +/- buttons move the supply intercept per press.",
              "label": "Supply Shift Step",
              "synonyms": "supply shift, supply shock, shift in supply",
              "tier": "domain",
              "type": "number"
            },
            "supplySlope": {
              "default": 1.0,
              "description": "How much price rises for each additional unit supplied — the magnitude of the supply curve's upward slope.",
              "label": "Supply Slope",
              "synonyms": "supply slope, marginal cost slope, supply curve steepness",
              "tier": "domain",
              "type": "number"
            },
            "title": {
              "default": "Supply & Demand Market",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The market state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "MARKET_UPDATED",
              "eventId": "evt_01KZEEZFXGPMAP1WMNCQ457E9D",
              "payloadSchema": [
                {
                  "name": "price",
                  "type": "number"
                },
                {
                  "name": "qDemanded",
                  "type": "number"
                },
                {
                  "name": "qSupplied",
                  "type": "number"
                },
                {
                  "name": "equilibriumPrice",
                  "type": "number"
                },
                {
                  "name": "equilibriumQuantity",
                  "type": "number"
                },
                {
                  "name": "status",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "market update, equilibrium, surplus, shortage, price change",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "curves",
              "demandIntercept",
              "demandSlope",
              "equilibriumPrice",
              "equilibriumQuantity",
              "labelShapes",
              "marketStatusLabel",
              "marketStatusMagnitude",
              "points",
              "price",
              "qDemanded",
              "qSupplied",
              "supplyIntercept",
              "supplySlope",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "EconMarketScene": "ent_01KZEEZFXFYX1T0W3PJA0A4F7M"
          },
          "id": "trt_01KZEEZFXFJGWMMYQ9MR02CFQ0",
          "linkedEntity": "EconMarketScene",
          "linkedEntityId": "ent_01KZEEZFXFYX1T0W3PJA0A4F7M",
          "name": "EconMarketSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEEZFXF3WHQXVHX15N5WD12",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEEZFXGNCSKQY0VXBRK8G7G",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed a Demand +/- button to shift the demand curve's intercept.",
                "id": "evt_01KZEEZFXGR20MBZZK0N4BXD4X",
                "key": "SHIFT_DEMAND",
                "name": "Shift Demand",
                "payloadSchema": [
                  {
                    "name": "delta",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed a Supply +/- button to shift the supply curve's intercept.",
                "id": "evt_01KZEEZFXGDV837C7EN3B67Z2Y",
                "key": "SHIFT_SUPPLY",
                "name": "Shift Supply",
                "payloadSchema": [
                  {
                    "name": "delta",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the price slider to set the market price.",
                "id": "evt_01KZEEZFXGEZRTZMC1Q1E4KDBG",
                "key": "SET_PRICE",
                "name": "Set Price",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The market state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEEZFXGPMAP1WMNCQ457E9D",
                "key": "MARKET_UPDATED",
                "name": "Market Updated",
                "payloadSchema": [
                  {
                    "name": "price",
                    "type": "number"
                  },
                  {
                    "name": "qDemanded",
                    "type": "number"
                  },
                  {
                    "name": "qSupplied",
                    "type": "number"
                  },
                  {
                    "name": "equilibriumPrice",
                    "type": "number"
                  },
                  {
                    "name": "equilibriumQuantity",
                    "type": "number"
                  },
                  {
                    "name": "status",
                    "type": "string"
                  }
                ],
                "synonyms": "market update, equilibrium, surplus, shortage, price change",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.demandIntercept",
                    "@config.demandIntercept"
                  ],
                  [
                    "set",
                    "@entity.demandSlope",
                    "@config.demandSlope"
                  ],
                  [
                    "set",
                    "@entity.supplyIntercept",
                    "@config.supplyIntercept"
                  ],
                  [
                    "set",
                    "@entity.supplySlope",
                    "@config.supplySlope"
                  ],
                  [
                    "set",
                    "@entity.price",
                    "@config.initialPrice"
                  ],
                  [
                    "let",
                    [
                      [
                        "eqQ",
                        [
                          "/",
                          [
                            "-",
                            "@entity.demandIntercept",
                            "@entity.supplyIntercept"
                          ],
                          [
                            "+",
                            "@entity.demandSlope",
                            "@entity.supplySlope"
                          ]
                        ]
                      ],
                      [
                        "eqP",
                        [
                          "-",
                          "@entity.demandIntercept",
                          [
                            "*",
                            "@entity.demandSlope",
                            "@eqQ"
                          ]
                        ]
                      ],
                      [
                        "qd",
                        [
                          "math/max",
                          0.0,
                          [
                            "/",
                            [
                              "-",
                              "@entity.demandIntercept",
                              "@entity.price"
                            ],
                            "@entity.demandSlope"
                          ]
                        ]
                      ],
                      [
                        "qs",
                        [
                          "math/max",
                          0.0,
                          [
                            "/",
                            [
                              "-",
                              "@entity.price",
                              "@entity.supplyIntercept"
                            ],
                            "@entity.supplySlope"
                          ]
                        ]
                      ],
                      [
                        "gapVal",
                        [
                          "-",
                          "@qs",
                          "@qd"
                        ]
                      ],
                      [
                        "statusLabel",
                        [
                          "if",
                          [
                            ">",
                            "@gapVal",
                            0.0001
                          ],
                          "Surplus",
                          [
                            "if",
                            [
                              "<",
                              "@gapVal",
                              -0.0001
                            ],
                            "Shortage",
                            "Equilibrium"
                          ]
                        ]
                      ],
                      [
                        "statusMag",
                        [
                          "math/abs",
                          "@gapVal"
                        ]
                      ],
                      [
                        "demandZeroQ",
                        [
                          "math/min",
                          "@config.maxQuantity",
                          [
                            "/",
                            "@entity.demandIntercept",
                            "@entity.demandSlope"
                          ]
                        ]
                      ],
                      [
                        "demandZeroP",
                        [
                          "math/max",
                          0.0,
                          [
                            "-",
                            "@entity.demandIntercept",
                            [
                              "*",
                              "@entity.demandSlope",
                              "@demandZeroQ"
                            ]
                          ]
                        ]
                      ],
                      [
                        "supplyEndQ",
                        "@config.maxQuantity"
                      ],
                      [
                        "supplyEndP",
                        [
                          "+",
                          "@entity.supplyIntercept",
                          [
                            "*",
                            "@entity.supplySlope",
                            "@supplyEndQ"
                          ]
                        ]
                      ],
                      [
                        "marketCurves",
                        [
                          {
                            "color": "@config.demandColor",
                            "label": "Demand",
                            "samples": [
                              {
                                "x": 0.0,
                                "y": "@entity.demandIntercept"
                              },
                              {
                                "x": "@demandZeroQ",
                                "y": "@demandZeroP"
                              }
                            ]
                          },
                          {
                            "color": "@config.supplyColor",
                            "label": "Supply",
                            "samples": [
                              {
                                "x": 0.0,
                                "y": "@entity.supplyIntercept"
                              },
                              {
                                "x": "@supplyEndQ",
                                "y": "@supplyEndP"
                              }
                            ]
                          },
                          {
                            "color": "@config.priceLineColor",
                            "label": "Your Price",
                            "samples": [
                              {
                                "x": 0.0,
                                "y": "@entity.price"
                              },
                              {
                                "x": "@config.maxQuantity",
                                "y": "@entity.price"
                              }
                            ]
                          }
                        ]
                      ],
                      [
                        "marketPoints",
                        [
                          {
                            "color": "@config.equilibriumColor",
                            "radius": 6.0,
                            "x": "@eqQ",
                            "y": "@eqP"
                          },
                          {
                            "color": "@config.demandColor",
                            "radius": 5.0,
                            "x": "@qd",
                            "y": "@entity.price"
                          },
                          {
                            "color": "@config.supplyColor",
                            "radius": 5.0,
                            "x": "@qs",
                            "y": "@entity.price"
                          }
                        ]
                      ],
                      [
                        "labelClampLo",
                        45.0
                      ],
                      [
                        "labelClampHi",
                        [
                          "-",
                          "@config.width",
                          45.0
                        ]
                      ],
                      [
                        "eqLabelX",
                        [
                          "math/clamp",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                "@eqQ",
                                "@config.maxQuantity"
                              ],
                              [
                                "-",
                                "@config.width",
                                48.0
                              ]
                            ]
                          ],
                          "@labelClampLo",
                          "@labelClampHi"
                        ]
                      ],
