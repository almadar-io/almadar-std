              "type": "number"
            },
            "yMax": {
              "default": 0.5,
              "description": "Minimum top of the y axis; the canvas grows above it automatically when a small standard deviation pushes the peak higher.",
              "label": "Y Max",
              "tier": "presentation",
              "type": "number"
            },
