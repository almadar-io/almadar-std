            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "mean": {
              "default": 0.0,
              "description": "Initial center of the distribution; learners move it with the mean slider.",
              "label": "Mean",
              "synonyms": "mu, average, center",
              "tier": "domain",
