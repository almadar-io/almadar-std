          "id": "trt_01M04GTB3YX0NP0NABBYENAYJ5",
          "linkedEntity": "NormalDistributionScene",
          "linkedEntityId": "ent_01M04GTB3YHJ2QVAK4BE4N155D",
          "name": "NormalDistributionSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M04GTB3Y40XA1F55ENWCNSRJ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M04GTB40QZX5PX3S8Q0FHYA3",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the mean slider — value is the new center of the distribution; the curve recomputes immediately.",
                "id": "evt_01M04GTB40F1PA2JEZRAJC3VAH",
                "key": "SET_MEAN",
                "name": "Set Mean",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the standard-deviation slider — value is the new spread; the curve recomputes immediately.",
                "id": "evt_01M04GTB40WFS0GQQ47ZG18A7J",
                "key": "SET_STDDEV",
                "name": "Set Stddev",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The recomputed curve and parameters after INIT or a slider change — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04GTB401KEJ6BT8Y0JXRXXQ",
                "key": "DIST_UPDATED",
                "name": "Dist Updated",
                "payloadSchema": [
                  {
                    "name": "curves",
                    "type": "[MathCanvasCurvesItem]"
                  },
                  {
                    "name": "mean",
                    "type": "number"
                  },
                  {
                    "name": "stdDev",
                    "type": "number"
                  }
                ],
                "synonyms": "normal distribution, gaussian, bell curve, mean, standard deviation",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "mu",
                        "@config.mean"
                      ],
                      [
                        "sigma",
                        "@config.stdDev"
                      ],
                      [
                        "peakY",
                        [
                          "/",
                          1.0,
                          [
                            "*",
                            "@sigma",
                            [
                              "math/sqrt",
                              6.28318530717959
                            ]
                          ]
                        ]
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "samples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "z",
                                  [
                                    "/",
                                    [
                                      "-",
                                      "@x",
                                      "@mu"
                                    ],
                                    "@sigma"
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": [
                                  "*",
                                  "@peakY",
                                  [
                                    "math/pow",
                                    2.71828182845905,
                                    [
                                      "*",
                                      -0.5,
                                      [
                                        "*",
                                        "@z",
                                        "@z"
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "yTopV",
                        [
                          "math/max",
                          "@config.yMax",
                          [
                            "*",
                            1.25,
                            "@peakY"
                          ]
                        ]
                      ],
                      [
                        "plotW",
                        [
                          "-",
                          "@config.width",
                          48.0
                        ]
                      ],
                      [
                        "plotH",
                        [
                          "-",
                          "@config.height",
                          48.0
                        ]
                      ],
                      [
                        "muPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                "@mu",
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "sigLoPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                [
                                  "-",
                                  "@mu",
                                  "@sigma"
                                ],
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "sigHiPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                [
                                  "+",
                                  "@mu",
                                  "@sigma"
                                ],
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "baseY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  0.0,
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ],
                      [
                        "peakPxY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  "@peakY",
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ],
                      [
                        "sigPxY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  [
                                    "*",
                                    0.6065,
                                    "@peakY"
                                  ],
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.mean",
                        "@mu"
                      ],
                      [
                        "set",
                        "@entity.stdDev",
                        "@sigma"
                      ],
                      [
                        "set",
                        "@entity.peak",
                        "@peakY"
                      ],
                      [
                        "set",
                        "@entity.yTop",
                        "@yTopV"
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          {
                            "color": "@config.color",
                            "label": "f(x)",
                            "samples": "@samples"
                          }
                        ]
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        [
                          {
                            "color": "#0f172a",
                            "lineWidth": 2.0,
                            "type": "line",
                            "x1": "@muPx",
                            "x2": "@muPx",
                            "y1": "@baseY",
                            "y2": "@peakPxY"
                          },
                          {
                            "color": "#94a3b8",
                            "lineWidth": 1.5,
                            "type": "line",
                            "x1": "@sigLoPx",
                            "x2": "@sigLoPx",
                            "y1": "@baseY",
                            "y2": "@sigPxY"
                          },
                          {
                            "color": "#94a3b8",
                            "lineWidth": 1.5,
                            "type": "line",
                            "x1": "@sigHiPx",
                            "x2": "@sigHiPx",
                            "y1": "@baseY",
                            "y2": "@sigPxY"
                          },
                          {
                            "align": "center",
                            "color": "#0f172a",
                            "fontSize": 11.0,
                            "text": "mean",
                            "type": "text",
                            "x": "@muPx",
                            "y": [
                              "-",
                              "@peakPxY",
                              8.0
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
