                            "lineWidth": 1.5,
                            "type": "line",
                            "x1": "@sigHiPx",
                            "x2": "@sigHiPx",
                            "y1": "@baseY",
                            "y2": "@sigPxY"
                          },
                          {
                            "align": "center",
                            "color": "#0f172a",
                            "fontSize": 11.0,
                            "text": "mean",
                            "type": "text",
                            "x": "@muPx",
                            "y": [
                              "-",
                              "@peakPxY",
                              8.0
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
