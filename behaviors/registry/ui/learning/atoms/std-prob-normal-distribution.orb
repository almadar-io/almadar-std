                                    "Standard deviation: ",
                                    [
                                      "math/round",
                                      "@entity.stdDev",
                                      2.0
                                    ],
                                    " — smaller is taller and narrower, larger is flatter and wider"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "action": "SET_STDDEV",
                                  "max": 2.5,
                                  "min": 0.3,
                                  "showTooltip": true,
                                  "step": 0.05,
                                  "type": "range-slider",
                                  "value": "@entity.stdDev"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": "@config.showAxes",
                              "showGrid": "@config.showGrid",
                              "title": "",
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.xMax",
                              "xMin": "@config.xMin",
                              "yMax": "@entity.yTop",
                              "yMin": "@config.yMin"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Peak height f(mean) = ",
                                [
                                  "math/round",
                                  "@entity.peak",
                                  3.0
                                ],
                                " — about 68% of the probability mass lies between ",
                                [
                                  "math/round",
                                  [
                                    "-",
                                    "@entity.mean",
                                    "@entity.stdDev"
                                  ],
                                  2.0
                                ],
                                " and ",
                                [
                                  "math/round",
                                  [
                                    "+",
                                    "@entity.mean",
                                    "@entity.stdDev"
                                  ],
                                  2.0
                                ],
                                " (the gray band edges)"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "DIST_UPDATED",
                    {
                      "curves": "@entity.curves",
                      "mean": "@entity.mean",
                      "stdDev": "@entity.stdDev"
                    }
                  ]
                ],
                "event": "SET_MEAN",
                "eventId": "evt_01M04GTB40F1PA2JEZRAJC3VAH",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "mu",
                        "@entity.mean"
                      ],
                      [
                        "sigma",
                        [
                          "math/clamp",
                          "@payload.value",
                          0.3,
                          2.5
                        ]
                      ],
                      [
                        "peakY",
                        [
                          "/",
                          1.0,
                          [
                            "*",
                            "@sigma",
                            [
                              "math/sqrt",
                              6.28318530717959
                            ]
                          ]
                        ]
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "samples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "z",
                                  [
                                    "/",
                                    [
                                      "-",
                                      "@x",
                                      "@mu"
                                    ],
                                    "@sigma"
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": [
                                  "*",
                                  "@peakY",
                                  [
                                    "math/pow",
                                    2.71828182845905,
                                    [
                                      "*",
                                      -0.5,
                                      [
                                        "*",
                                        "@z",
                                        "@z"
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "yTopV",
                        [
                          "math/max",
                          "@config.yMax",
                          [
                            "*",
                            1.25,
                            "@peakY"
                          ]
                        ]
                      ],
                      [
                        "plotW",
                        [
                          "-",
                          "@config.width",
                          48.0
                        ]
                      ],
                      [
                        "plotH",
                        [
                          "-",
                          "@config.height",
                          48.0
                        ]
                      ],
                      [
                        "muPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                "@mu",
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "sigLoPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                [
                                  "-",
                                  "@mu",
                                  "@sigma"
                                ],
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "sigHiPx",
                        [
                          "+",
                          24.0,
                          [
                            "*",
                            [
                              "/",
                              [
                                "-",
                                [
                                  "+",
                                  "@mu",
                                  "@sigma"
                                ],
                                "@config.xMin"
                              ],
                              [
                                "-",
                                "@config.xMax",
                                "@config.xMin"
                              ]
                            ],
                            "@plotW"
                          ]
                        ]
                      ],
                      [
                        "baseY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  0.0,
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ],
                      [
                        "peakPxY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  "@peakY",
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ],
                      [
                        "sigPxY",
                        [
                          "-",
                          "@config.height",
                          [
                            "+",
                            24.0,
                            [
                              "*",
                              [
                                "/",
                                [
                                  "-",
                                  [
                                    "*",
                                    0.6065,
                                    "@peakY"
                                  ],
                                  "@config.yMin"
                                ],
                                [
                                  "-",
                                  "@yTopV",
                                  "@config.yMin"
                                ]
                              ],
                              "@plotH"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.stdDev",
                        "@sigma"
                      ],
                      [
                        "set",
                        "@entity.peak",
                        "@peakY"
                      ],
                      [
                        "set",
                        "@entity.yTop",
                        "@yTopV"
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          {
                            "color": "@config.color",
                            "label": "f(x)",
                            "samples": "@samples"
                          }
                        ]
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        [
                          {
                            "color": "#0f172a",
                            "lineWidth": 2.0,
                            "type": "line",
                            "x1": "@muPx",
                            "x2": "@muPx",
                            "y1": "@baseY",
                            "y2": "@peakPxY"
                          },
                          {
                            "color": "#94a3b8",
                            "lineWidth": 1.5,
                            "type": "line",
                            "x1": "@sigLoPx",
                            "x2": "@sigLoPx",
                            "y1": "@baseY",
                            "y2": "@sigPxY"
                          },
                          {
