                                    ],
                                    "type": "badge",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@s",
                                          "stage"
                                        ],
                                        "@entity.stageIndex"
                                      ],
                                      "primary",
                                      "neutral"
