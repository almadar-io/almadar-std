                                  "content": [
                                    "str/concat",
                                    "Death rate: ",
                                    "@entity.deathRate"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "actionPayload": {
                                    "target": "death"
                                  },
                                  "max": "@config.rateAxisMax",
                                  "min": 0.0,
                                  "onChange": "SET_RATES",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.deathRate"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.matchReadout",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.stageDescription",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.stagePresets",
                                [
                                  "fn",
                                  "s",
                                  {
                                    "label": [
                                      "str/concat",
                                      "S",
                                      [
                                        "object/get",
                                        "@s",
                                        "stage"
                                      ],
                                      " ",
                                      [
                                        "object/get",
                                        "@s",
                                        "name"
                                      ]
                                    ],
                                    "type": "badge",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@s",
                                          "stage"
                                        ],
                                        "@entity.stageIndex"
                                      ],
                                      "primary",
                                      "neutral"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "DTM_UPDATED",
                    {
                      "birthRate": "@entity.birthRate",
                      "deathRate": "@entity.deathRate",
                      "matched": "@entity.matched",
                      "stageIndex": "@entity.stageIndex",
                      "stageName": "@entity.stageName"
                    }
                  ]
                ],
                "event": "SET_RATES",
                "eventId": "evt_01M0492B9XTDKX407S4N94VJAZ",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}