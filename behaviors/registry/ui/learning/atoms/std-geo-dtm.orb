      "traits": [
        {
          "category": "interaction",
          "config": {
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "axisColor": {
              "default": "#94a3b8",
              "label": "Axis Color",
              "tier": "presentation",
              "type": "string"
            },
            "birthColor": {
              "default": "#2563eb",
              "label": "Birth Rate Color",
              "tier": "presentation",
              "type": "string"
            },
            "birthRate": {
              "default": 40.0,
              "description": "Starting birth-rate dial (per mille), the value the learner adjusts to reproduce each stage.",
              "label": "Starting Birth Rate",
              "synonyms": "birth rate, fertility rate, natality, crude birth rate",
              "tier": "domain",
              "type": "number"
            },
            "deathColor": {
              "default": "#dc2626",
              "label": "Death Rate Color",
              "tier": "presentation",
              "type": "string"
            },
            "deathRate": {
              "default": 40.0,
              "description": "Starting death-rate dial (per mille), the value the learner adjusts to reproduce each stage.",
              "label": "Starting Death Rate",
              "synonyms": "death rate, mortality rate, crude death rate",
              "tier": "domain",
              "type": "number"
            },
            "height": {
              "default": 460.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "matchTolerance": {
              "default": 3.0,
              "description": "Per-rate tolerance within which the learner's dials count as reproducing the current stage's target rates.",
              "label": "Match Tolerance",
              "tier": "domain",
              "type": "number"
            },
            "rateAxisMax": {
              "default": 50.0,
              "description": "Upper bound of the birth/death rate dials and the curve vertical axis, per mille.",
              "label": "Rate Axis Max",
              "tier": "presentation",
              "type": "number"
            },
            "stageCount": {
              "default": 5.0,
              "description": "Number of demographic transition stages the model steps through.",
              "label": "Stage Count",
              "synonyms": "demographic transition, DTM, stage, demographic stages",
              "tier": "domain",
              "type": "number"
            },
            "stageMarkerColor": {
              "default": "#7c3aed",
              "label": "Stage Marker Color",
              "tier": "presentation",
              "type": "string"
            },
            "stagePresets": {
              "default": [
                {
                  "birthRate": 40.0,
                  "deathRate": 38.0,
                  "description": "Pre-industrial: high birth and death rates cancel out, so population growth is near zero.",
                  "name": "High Stationary",
                  "stage": 1.0
                },
                {
                  "birthRate": 40.0,
                  "deathRate": 22.0,
                  "description": "Death rate falls with better food and sanitation while birth rate stays high — rapid natural increase.",
                  "name": "Early Expanding",
                  "stage": 2.0
                },
                {
                  "birthRate": 28.0,
                  "deathRate": 12.0,
                  "description": "Birth rate begins to fall with urbanization and contraception; growth slows.",
                  "name": "Late Expanding",
                  "stage": 3.0
                },
                {
                  "birthRate": 12.0,
                  "deathRate": 11.0,
                  "description": "Both rates low and roughly equal; population is large but stable.",
                  "name": "Low Stationary",
                  "stage": 4.0
                },
                {
                  "birthRate": 8.0,
                  "deathRate": 11.0,
                  "description": "Birth rate drops below death rate; the population ages and begins to shrink.",
                  "name": "Declining",
                  "stage": 5.0
                }
              ],
              "description": "Ordered roster of demographic transition stages; each declares the target birth/death rates the learner must reproduce and a teaching description. Curve samples are interpolated between consecutive presets.",
              "items": {
                "properties": {
                  "birthRate": {
                    "name": "birthRate",
                    "required": true,
                    "type": "number"
                  },
                  "deathRate": {
                    "name": "deathRate",
                    "required": true,
                    "type": "number"
                  },
                  "description": {
                    "name": "description",
                    "required": false,
                    "type": "string"
                  },
                  "name": {
                    "name": "name",
                    "required": true,
                    "type": "string"
                  },
                  "stage": {
                    "name": "stage",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Stage Presets",
              "synonyms": "demographic transition stage, high stationary, early expanding, late expanding, low stationary, declining stage, natural increase",
              "tier": "domain",
              "type": "[GeoDtmStagePreset]"
            },
            "textColor": {
              "default": "#1e293b",
              "label": "Text Color",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Demographic Transition Model",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The demographic transition model state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "DTM_UPDATED",
              "eventId": "evt_01M0492B9XAD236AWRSKMZYX15",
              "payloadSchema": [
                {
                  "name": "stageIndex",
                  "type": "number"
                },
                {
                  "name": "stageName",
                  "type": "string"
                },
                {
                  "name": "birthRate",
                  "type": "number"
                },
                {
                  "name": "deathRate",
                  "type": "number"
                },
                {
                  "name": "matched",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "demographic transition, DTM stage, birth rate, death rate, natural increase, stage reproduced",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "birthRate",
              "deathRate",
              "dtmCurves",
              "dtmShapes",
              "matchReadout",
              "matched",
              "stageDescription",
              "stageIndex",
              "stageName",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "GeoDtmScene": "ent_01M0492B9W8NS9SCQBVWQC7ETE"
          },
          "id": "trt_01M0492B9WY8ABY15A8XNJF2NG",
          "linkedEntity": "GeoDtmScene",
          "linkedEntityId": "ent_01M0492B9W8NS9SCQBVWQC7ETE",
          "name": "GeoDtmSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0492B9WQZ7QZ8F9HP01GPDJ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M0492B9XZRYCK44V45C3KZCF",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next demographic transition stage.",
                "id": "evt_01M0492B9XR9XT5FJYWKDQX7ZT",
                "key": "NEXT_STAGE",
                "name": "Next Stage",
                "tier": "domain"
              },
              {
                "description": "Learner returned to the previous demographic transition stage.",
                "id": "evt_01M0492B9XRJWKFQ9DKN2MM9MH",
                "key": "PREV_STAGE",
                "name": "Prev Stage",
                "tier": "domain"
              },
              {
                "description": "Learner dragged a rate dial; target names which rate ('birth' or 'death').",
                "id": "evt_01M0492B9XTDKX407S4N94VJAZ",
                "key": "SET_RATES",
                "name": "Set Rates",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  },
                  {
                    "name": "target",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The demographic transition model state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M0492B9XAD236AWRSKMZYX15",
                "key": "DTM_UPDATED",
                "name": "Dtm Updated",
                "payloadSchema": [
                  {
                    "name": "stageIndex",
                    "type": "number"
                  },
                  {
                    "name": "stageName",
                    "type": "string"
                  },
                  {
                    "name": "birthRate",
                    "type": "number"
                  },
                  {
                    "name": "deathRate",
                    "type": "number"
                  },
                  {
                    "name": "matched",
                    "type": "boolean"
                  }
                ],
                "synonyms": "demographic transition, DTM stage, birth rate, death rate, natural increase, stage reproduced",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.stageIndex",
                    1.0
                  ],
                  [
                    "set",
                    "@entity.birthRate",
                    "@config.birthRate"
                  ],
                  [
                    "set",
                    "@entity.deathRate",
                    "@config.deathRate"
                  ],
                  [
                    "let",
                    [
                      [
                        "plotLeft",
                        50.0
                      ],
                      [
                        "plotRight",
                        [
                          "-",
                          "@config.width",
                          30.0
                        ]
                      ],
                      [
                        "plotWidthPx",
                        [
                          "-",
                          "@plotRight",
                          "@plotLeft"
                        ]
                      ],
                      [
                        "plotTop",
                        30.0
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          50.0
                        ]
                      ],
                      [
                        "plotHeightPx",
                        [
                          "-",
                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "stageDenom",
                        [
                          "math/max",
                          1.0,
                          [
                            "-",
                            "@config.stageCount",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "stagePreset",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.stagePresets",
                            [
                              "fn",
                              "s",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@s",
                                  "stage"
                                ],
                                "@entity.stageIndex"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "stagePresetFinal",
                        [
                          "if",
                          [
                            "==",
                            "@stagePreset",
                            null
                          ],
                          [
                            "array/first",
                            "@config.stagePresets"
                          ],
                          "@stagePreset"
                        ]
                      ],
                      [
                        "stageName",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "name"
                        ]
                      ],
                      [
                        "targetBirth",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "birthRate"
                        ]
                      ],
                      [
                        "targetDeath",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "deathRate"
                        ]
                      ],
                      [
                        "matched",
                        [
                          "and",
                          [
                            "<=",
                            [
                              "math/abs",
                              [
                                "-",
                                "@entity.birthRate",
                                "@targetBirth"
                              ]
                            ],
                            "@config.matchTolerance"
                          ],
                          [
                            "<=",
                            [
                              "math/abs",
                              [
                                "-",
                                "@entity.deathRate",
                                "@targetDeath"
                              ]
                            ],
                            "@config.matchTolerance"
                          ]
                        ]
                      ],
                      [
                        "matchReadout",
                        [
                          "str/concat",
                          "Stage ",
                          "@entity.stageIndex",
                          " — ",
                          "@stageName",
                          ": target birth ",
                          "@targetBirth",
                          ", death ",
                          "@targetDeath",
                          " | your rates: birth ",
                          "@entity.birthRate",
                          ", death ",
                          "@entity.deathRate",
                          [
                            "if",
                            "@matched",
                            " — stage reproduced",
                            " — adjust the sliders to reproduce this stage"
                          ]
                        ]
                      ],
                      [
                        "curveRows",
                        [
                          "array/map",
                          "@config.stagePresets",
                          [
                            "fn",
                            "s",
                            [
                              "let",
                              [
                                [
                                  "xPos",
                                  [
