                  [
                    "emit",
                    "DTM_UPDATED",
                    {
                      "birthRate": "@entity.birthRate",
                      "deathRate": "@entity.deathRate",
                      "matched": "@entity.matched",
                      "stageIndex": "@entity.stageIndex",
                      "stageName": "@entity.stageName"
                    }
                  ]
                ],
                "event": "PREV_STAGE",
                "eventId": "evt_01M0492B9XRJWKFQ9DKN2MM9MH",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.birthRate",
                    [
                      "if",
                      [
                        "==",
                        "@payload.target",
                        "birth"
                      ],
                      "@payload.value",
                      "@entity.birthRate"
                    ]
                  ],
                  [
                    "set",
                    "@entity.deathRate",
                    [
                      "if",
                      [
                        "==",
                        "@payload.target",
                        "death"
                      ],
                      "@payload.value",
                      "@entity.deathRate"
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "plotLeft",
                        50.0
                      ],
                      [
                        "plotRight",
                        [
                          "-",
                          "@config.width",
                          30.0
                        ]
                      ],
                      [
                        "plotWidthPx",
                        [
                          "-",
                          "@plotRight",
                          "@plotLeft"
                        ]
                      ],
                      [
                        "plotTop",
                        30.0
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          50.0
                        ]
                      ],
                      [
                        "plotHeightPx",
                        [
                          "-",
                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "stageDenom",
                        [
                          "math/max",
                          1.0,
                          [
                            "-",
                            "@config.stageCount",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "stagePreset",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.stagePresets",
                            [
                              "fn",
                              "s",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@s",
                                  "stage"
                                ],
                                "@entity.stageIndex"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "stagePresetFinal",
                        [
                          "if",
                          [
                            "==",
                            "@stagePreset",
                            null
                          ],
                          [
                            "array/first",
                            "@config.stagePresets"
                          ],
                          "@stagePreset"
                        ]
                      ],
                      [
                        "stageName",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "name"
                        ]
                      ],
                      [
                        "targetBirth",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "birthRate"
                        ]
                      ],
                      [
                        "targetDeath",
                        [
                          "object/get",
                          "@stagePresetFinal",
                          "deathRate"
                        ]
                      ],
                      [
                        "matched",
                        [
                          "and",
                          [
                            "<=",
                            [
                              "math/abs",
                              [
                                "-",
                                "@entity.birthRate",
                                "@targetBirth"
                              ]
                            ],
                            "@config.matchTolerance"
                          ],
                          [
                            "<=",
                            [
                              "math/abs",
                              [
                                "-",
                                "@entity.deathRate",
                                "@targetDeath"
                              ]
                            ],
                            "@config.matchTolerance"
                          ]
                        ]
                      ],
                      [
                        "matchReadout",
                        [
                          "str/concat",
                          "Stage ",
                          "@entity.stageIndex",
                          " — ",
                          "@stageName",
                          ": target birth ",
                          "@targetBirth",
                          ", death ",
                          "@targetDeath",
                          " | your rates: birth ",
                          "@entity.birthRate",
                          ", death ",
                          "@entity.deathRate",
                          [
                            "if",
                            "@matched",
                            " — stage reproduced",
                            " — adjust the sliders to reproduce this stage"
                          ]
                        ]
                      ],
                      [
                        "curveRows",
                        [
                          "array/map",
                          "@config.stagePresets",
                          [
                            "fn",
                            "s",
                            [
                              "let",
                              [
                                [
                                  "xPos",
                                  [
                                    "+",
                                    "@plotLeft",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
