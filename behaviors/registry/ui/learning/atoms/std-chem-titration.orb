            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Chemistry Lab",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "titrationAcidConcentration": {
              "default": 0.1,
              "description": "Initial molar concentration of the acid analyte in the flask.",
              "label": "Acid Concentration (mol/L)",
              "tier": "domain",
              "type": "number"
            },
            "titrationAcidKa": {
              "default": 0.000018,
              "description": "Acid dissociation constant, used only when Acid Strength is weak (default 1.8e-5, acetic acid).",
              "label": "Acid Ka",
              "tier": "domain",
              "type": "number"
            },
            "titrationAcidStrength": {
              "default": "strong",
              "description": "Strong acids (e.g. HCl) fully dissociate; weak acids (e.g. acetic acid) partially dissociate per their Ka. Shapes the curve (sharp strong-strong jump vs a buffered weak-strong region).",
              "label": "Acid Strength",
              "synonyms": "strong acid, weak acid, dissociation, Ka, acid dissociation constant, HCl, acetic acid",
              "tier": "domain",
              "type": "string",
              "values": [
                "strong",
                "weak"
              ]
            },
            "titrationAcidVolume": {
              "default": 25.0,
              "description": "Initial volume of acid analyte in the flask, before any titrant is added.",
              "label": "Acid Volume (mL)",
              "tier": "domain",
              "type": "number"
            },
            "titrationBaseConcentration": {
              "default": 0.1,
              "description": "Molar concentration of the base titrant in the burette.",
              "label": "Titrant (Base) Concentration (mol/L)",
              "tier": "domain",
              "type": "number"
            },
            "titrationIncrementLarge": {
              "default": 1.0,
              "description": "Titrant volume added per press of the coarse add button.",
              "label": "Large Increment (mL)",
              "tier": "domain",
              "type": "number"
            },
            "titrationIncrementSmall": {
              "default": 0.1,
              "description": "Titrant volume added per press of the fine add button, for precise control near the equivalence point.",
              "label": "Small Increment (mL)",
              "tier": "domain",
              "type": "number"
            },
            "titrationIndicatorAcidColor": {
              "default": "#fde68a",
              "description": "Flask color below the indicator flip pH.",
              "label": "Indicator Color (Acidic)",
              "tier": "presentation",
              "type": "string"
            },
            "titrationIndicatorBaseColor": {
              "default": "#ec4899",
              "description": "Flask color at/above the indicator flip pH.",
              "label": "Indicator Color (Basic)",
              "tier": "presentation",
              "type": "string"
            },
            "titrationIndicatorMidpoint": {
              "default": 8.2,
              "description": "pH at which the indicator color flips from acidic to basic (default 8.2, phenolphthalein).",
              "label": "Indicator Flip pH",
              "tier": "domain",
              "type": "number"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The titration state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "TITRATION_UPDATED",
              "eventId": "evt_01KZEGDY6DTSJAHKV1CFQG4N7H",
              "payloadSchema": [
                {
                  "name": "titrantVolumeAdded",
                  "type": "number"
                },
                {
                  "name": "ph",
                  "type": "number"
                },
                {
                  "name": "overshoot",
                  "type": "boolean"
                },
                {
                  "name": "equivalenceVolume",
                  "type": "number"
                },
                {
                  "name": "statusText",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "titration update, pH change, equivalence point, overshoot, titrant added",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "arrows",
