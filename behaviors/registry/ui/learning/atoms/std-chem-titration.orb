              "titrationAcidConcentration",
              "titrationAcidKa",
              "titrationAcidStrength",
              "titrationAcidVolume",
              "titrationBaseConcentration",
              "titrationIndicatorAcidColor",
              "titrationIndicatorBaseColor",
              "titrationIndicatorMidpoint"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "ChemTitrationScene": "ent_01KZEGDY6C165D681MJF78G2VK"
          },
          "id": "trt_01KZEGDY6CB2XB5505ZWQ5RFF2",
          "linkedEntity": "ChemTitrationScene",
          "linkedEntityId": "ent_01KZEGDY6C165D681MJF78G2VK",
          "name": "ChemTitrationSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEGDY6CY8NXH4V6JR3PD648",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEGDY6DSAZ205EWYR5XW3QX",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZEGDY6DX6M00ZTMMGYWB3AH",
                "key": "ADD_TITRANT_LARGE",
                "name": "Add Titrant Large"
              },
              {
                "id": "evt_01KZEGDY6DKJF6X5XWA2F4RF24",
                "key": "ADD_TITRANT_SMALL",
                "name": "Add Titrant Small"
              },
              {
                "id": "evt_01KZEGDY6DBZA52J7NHVZCT6KY",
                "key": "RESET_TITRATION",
                "name": "Reset Titration"
              },
              {
                "description": "The titration state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEGDY6DTSJAHKV1CFQG4N7H",
                "key": "TITRATION_UPDATED",
                "name": "Titration Updated",
                "payloadSchema": [
                  {
                    "name": "titrantVolumeAdded",
                    "type": "number"
                  },
                  {
                    "name": "ph",
                    "type": "number"
                  },
                  {
                    "name": "overshoot",
                    "type": "boolean"
                  },
                  {
                    "name": "equivalenceVolume",
                    "type": "number"
                  },
                  {
                    "name": "statusText",
                    "type": "string"
                  }
                ],
                "synonyms": "titration update, pH change, equivalence point, overshoot, titrant added",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.titrationAcidStrength",
                    "@config.titrationAcidStrength"
                  ],
                  [
                    "set",
                    "@entity.titrationAcidKa",
                    "@config.titrationAcidKa"
                  ],
                  [
                    "set",
                    "@entity.titrationAcidConcentration",
                    "@config.titrationAcidConcentration"
                  ],
                  [
                    "set",
                    "@entity.titrationAcidVolume",
                    "@config.titrationAcidVolume"
                  ],
                  [
                    "set",
                    "@entity.titrationBaseConcentration",
                    "@config.titrationBaseConcentration"
                  ],
                  [
                    "set",
                    "@entity.titrationIndicatorMidpoint",
                    "@config.titrationIndicatorMidpoint"
                  ],
                  [
                    "set",
                    "@entity.titrationIndicatorAcidColor",
                    "@config.titrationIndicatorAcidColor"
                  ],
                  [
                    "set",
                    "@entity.titrationIndicatorBaseColor",
                    "@config.titrationIndicatorBaseColor"
                  ],
                  [
                    "set",
                    "@entity.titrantVolumeAdded",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.ph",
                    [
                      "let",
                      [
                        [
                          "totalVolumeL",
                          [
                            "/",
                            [
                              "+",
                              "@entity.titrationAcidVolume",
                              "@entity.titrantVolumeAdded"
                            ],
                            1000.0
                          ]
                        ],
                        [
                          "acidMolesInit",
                          [
                            "/",
                            [
                              "*",
                              "@entity.titrationAcidConcentration",
                              "@entity.titrationAcidVolume"
                            ],
                            1000.0
                          ]
                        ],
                        [
                          "baseMolesAdded",
                          [
                            "/",
                            [
                              "*",
                              "@entity.titrationBaseConcentration",
                              "@entity.titrantVolumeAdded"
                            ],
                            1000.0
                          ]
                        ],
                        [
                          "isWeak",
                          [
                            "==",
                            "@entity.titrationAcidStrength",
                            "weak"
                          ]
                        ],
                        [
                          "noTitrantYet",
                          [
                            "<=",
                            "@entity.titrantVolumeAdded",
                            0.0
                          ]
                        ]
                      ],
                      [
                        "let",
