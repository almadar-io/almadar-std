                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Steps: ",
                                "@entity.steps",
                                [
                                  "if",
                                  "@entity.done",
                                  " — done",
                                  [
                                    "if",
                                    "@entity.running",
                                    " — auto-stepping",
                                    " — paused"
                                  ]
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "sm",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "LEARN_RESET",
                    {}
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01M0C2M9G4JTJHKWQEKYXE4MEC",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.elapsedMs",
                  [
                    "+",
                    "@entity.elapsedMs",
                    32.0
                  ]
                ],
                [
                  "when",
                  [
                    ">=",
                    "@entity.elapsedMs",
                    "@config.stepIntervalMs"
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.elapsedMs",
                      0.0
                    ],
                    [
                      "set",
                      "@entity.steps",
                      [
                        "+",
                        "@entity.steps",
                        1.0
                      ]
                    ],
                    [
                      "emit",
                      "LEARN_STEP",
                      {
                        "steps": "@entity.steps"
                      }
                    ]
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "not",
                    [
                      "==",
                      "@entity.done",
                      true
                    ]
                  ]
                ]
              ],
              "interval": 32.0,
              "name": "transportTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}