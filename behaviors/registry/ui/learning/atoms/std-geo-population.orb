              "default": "#f8fafc",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "birthRate": {
              "default": 20.0,
              "description": "Starting birth-rate dial (0-50), driving how many births the 20-39 cohort produces on each Step Decade.",
              "label": "Birth Rate",
              "synonyms": "birth rate, fertility rate, natality",
              "tier": "domain",
              "type": "number"
            },
            "birthRateCoefficient": {
              "default": 0.4,
              "description": "Scales the birth-rate dial into actual births: births = (birthRate/100) x this coefficient x the 20-39 cohort size.",
              "label": "Birth Rate Coefficient",
              "tier": "domain",
              "type": "number"
            },
            "cohortSeeds": {
              "default": [
                {
                  "baseSurvivalRate": 0.97,
                  "deathSensitivity": 0.15,
                  "femaleShare": 125.0,
                  "id": "c0",
                  "label": "0–19",
                  "maleShare": 130.0,
                  "order": 0.0
                },
                {
                  "baseSurvivalRate": 0.96,
                  "deathSensitivity": 0.2,
                  "femaleShare": 118.0,
                  "id": "c1",
                  "label": "20–39",
                  "maleShare": 120.0,
                  "order": 1.0
                },
                {
                  "baseSurvivalRate": 0.93,
                  "deathSensitivity": 0.3,
                  "femaleShare": 97.0,
                  "id": "c2",
                  "label": "40–59",
                  "maleShare": 95.0,
                  "order": 2.0
                },
                {
                  "baseSurvivalRate": 0.85,
                  "deathSensitivity": 0.5,
                  "femaleShare": 60.0,
                  "id": "c3",
                  "label": "60–79",
                  "maleShare": 55.0,
                  "order": 3.0
                },
                {
                  "baseSurvivalRate": 0.7,
                  "deathSensitivity": 0.6,
                  "femaleShare": 20.0,
                  "id": "c4",
                  "label": "80+",
                  "maleShare": 15.0,
                  "order": 4.0
                }
              ],
              "description": "Roster of the five age cohorts (0–19 through 80+) seeding the starting population pyramid: id/label/order plus starting male/female shares, each cohort's baseline decade survival rate, and its death-rate sensitivity used by the cohort-component Step Decade.",
              "items": {
                "properties": {
                  "baseSurvivalRate": {
                    "name": "baseSurvivalRate",
                    "required": true,
                    "type": "number"
                  },
                  "deathSensitivity": {
