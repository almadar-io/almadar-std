                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "maleShare": {
                    "name": "maleShare",
                    "required": true,
                    "type": "number"
                  },
                  "order": {
                    "name": "order",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Cohort Seeds",
              "synonyms": "age cohort, population cohort, age-sex structure, cohort seed, survival rate, mortality sensitivity",
              "tier": "domain",
              "type": "[GeoPopulationCohortSeed]"
            },
            "deathRate": {
              "default": 15.0,
              "description": "Starting death-rate dial (0-50), reducing each cohort's decade survival on each Step Decade.",
              "label": "Death Rate",
              "synonyms": "death rate, mortality rate",
              "tier": "domain",
              "type": "number"
            },
            "femaleColor": {
              "default": "#db2777",
              "label": "Female Bar Color",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": 460.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "maleColor": {
              "default": "#2563eb",
              "label": "Male Bar Color",
              "tier": "presentation",
              "type": "string"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "migrationCoefficient": {
              "default": 0.3,
              "description": "Scales the migration dial into a population delta: delta = (migrationRate/100) x this coefficient x the working-age total, split across the two working-age cohorts.",
              "label": "Migration Coefficient",
              "tier": "domain",
              "type": "number"
            },
            "migrationRate": {
              "default": 0.0,
              "description": "Starting net-migration dial (-30 to 30), adding or removing working-age share on each Step Decade.",
              "label": "Net Migration Rate",
              "synonyms": "migration, net migration, immigration, emigration",
              "tier": "domain",
              "type": "number"
            },
            "pyramidClassRules": {
              "default": [
                {
                  "code": "expansive",
                  "description": "Wide base — youngest cohort's share of total population is at or above the expansive threshold, signalling a young, fast-growing population.",
                  "label": "Expansive",
                  "minBaseSharePercent": 32.0
                },
                {
                  "code": "stationary",
                  "description": "Youngest cohort's share is at or above the stationary threshold but below the expansive one, signalling a population near replacement level.",
                  "label": "Stationary",
                  "minBaseSharePercent": 18.0
                },
                {
                  "code": "constrictive",
                  "description": "Youngest cohort's share is below the stationary threshold, signalling a narrowing base and an aging population.",
                  "label": "Constrictive",
                  "minBaseSharePercent": 0.0
                }
              ],
              "description": "Ordered thresholds (highest first) on the youngest cohort's percent share of total population; the first rule the share meets or exceeds classifies the pyramid as expansive, stationary, or constrictive.",
              "items": {
                "properties": {
                  "code": {
                    "name": "code",
                    "required": true,
                    "type": "string"
                  },
                  "description": {
                    "name": "description",
                    "required": false,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "minBaseSharePercent": {
                    "name": "minBaseSharePercent",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Pyramid Shape Classification Rules",
              "synonyms": "expansive pyramid, constrictive pyramid, stationary pyramid, pyramid shape, base share",
              "tier": "domain",
              "type": "[GeoPopulationClassRule]"
            },
            "pyramidScaleMaxPercent": {
              "default": 40.0,
              "description": "The cohort percent-of-total-population that maps to a full-length pyramid bar; larger shares are clamped to full length.",
              "label": "Pyramid Bar Scale Max",
              "tier": "presentation",
              "type": "number"
            },
            "sexRatioAtBirth": {
              "default": 0.512,
              "description": "Male share of newborns on each Step Decade; the remainder is female.",
              "label": "Sex Ratio At Birth",
              "tier": "domain",
              "type": "number"
            },
            "textColor": {
              "default": "#1e293b",
              "label": "Text Color",
