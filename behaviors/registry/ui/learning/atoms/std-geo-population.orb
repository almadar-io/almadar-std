                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 50.0,
                                  "min": 0.0,
                                  "onChange": "SET_DEATH_RATE",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
