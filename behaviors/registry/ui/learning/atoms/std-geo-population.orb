                          [
                            "math/max",
                            "@workingAge",
                            0.0001
                          ]
                        ]
                      ],
                      [
                        "baseSharePercent",
                        [
                          "*",
                          [
                            "/",
                            "@young",
                            "@total"
                          ],
                          100.0
                        ]
                      ],
                      [
                        "matchedRule",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.pyramidClassRules",
                            [
                              "fn",
                              "r",
                              [
                                ">=",
                                "@baseSharePercent",
                                [
                                  "object/get",
                                  "@r",
                                  "minBaseSharePercent"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "matchedRuleFinal",
                        [
                          "if",
                          [
                            "==",
                            "@matchedRule",
                            null
                          ],
                          [
                            "array/last",
                            "@config.pyramidClassRules"
                          ],
                          "@matchedRule"
                        ]
                      ],
                      [
                        "pyramidClassCode",
                        [
                          "object/get",
                          "@matchedRuleFinal",
                          "code"
                        ]
                      ],
                      [
                        "pyramidClassLabel",
                        [
                          "object/get",
                          "@matchedRuleFinal",
                          "label"
                        ]
                      ],
                      [
                        "pyramidClassReadout",
                        [
                          "str/concat",
                          "Pyramid shape: ",
                          "@pyramidClassLabel",
                          " — youngest cohort is ",
                          [
                            "math/round",
                            "@baseSharePercent",
                            1.0
                          ],
                          "% of total population (threshold ",
                          [
                            "object/get",
                            "@matchedRuleFinal",
                            "minBaseSharePercent"
                          ],
                          "%)"
                        ]
                      ],
                      [
                        "centerX",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "bandHeight",
                        [
                          "/",
                          [
                            "-",
                            "@config.height",
                            60.0
                          ],
                          5.0
                        ]
                      ],
                      [
                        "barThickness",
                        [
                          "-",
                          "@bandHeight",
                          8.0
                        ]
                      ],
                      [
                        "halfWidth",
                        [
                          "-",
                          [
                            "/",
                            "@config.width",
                            2.0
                          ],
                          30.0
                        ]
                      ],
                      [
                        "rows",
                        [
                          {
                            "female": "@newC0Female",
                            "label": [
                              "object/get",
                              "@seed0",
                              "label"
                            ],
                            "male": "@newC0Male",
                            "order": 0.0
                          },
                          {
                            "female": "@newC1Female",
                            "label": [
                              "object/get",
                              "@seed1",
                              "label"
                            ],
                            "male": "@newC1Male",
                            "order": 1.0
                          },
                          {
                            "female": "@newC2Female",
                            "label": [
                              "object/get",
                              "@seed2",
                              "label"
                            ],
                            "male": "@newC2Male",
                            "order": 2.0
                          },
                          {
                            "female": "@newC3Female",
                            "label": [
                              "object/get",
                              "@seed3",
                              "label"
                            ],
                            "male": "@newC3Male",
                            "order": 3.0
                          },
                          {
                            "female": "@newC4Female",
                            "label": [
                              "object/get",
                              "@seed4",
                              "label"
                            ],
                            "male": "@newC4Male",
                            "order": 4.0
                          }
                        ]
                      ],
                      [
                        "computedRows",
                        [
                          "array/map",
                          "@rows",
                          [
                            "fn",
                            "r",
                            [
                              "let",
                              [
                                [
                                  "rowY",
                                  [
                                    "+",
                                    30.0,
                                    [
                                      "*",
                                      [
                                        "object/get",
                                        "@r",
                                        "order"
                                      ],
                                      "@bandHeight"
                                    ]
                                  ]
                                ],
                                [
                                  "malePercent",
                                  [
                                    "*",
                                    [
                                      "/",
                                      [
                                        "object/get",
                                        "@r",
                                        "male"
                                      ],
                                      "@total"
                                    ],
                                    100.0
                                  ]
                                ],
                                [
                                  "femalePercent",
                                  [
                                    "*",
                                    [
                                      "/",
                                      [
                                        "object/get",
                                        "@r",
                                        "female"
                                      ],
                                      "@total"
                                    ],
                                    100.0
                                  ]
                                ],
                                [
                                  "maleBarWidth",
                                  [
                                    "math/min",
                                    "@halfWidth",
                                    [
                                      "*",
                                      [
                                        "/",
                                        "@malePercent",
                                        "@config.pyramidScaleMaxPercent"
                                      ],
                                      "@halfWidth"
                                    ]
                                  ]
                                ],
                                [
                                  "femaleBarWidth",
                                  [
                                    "math/min",
                                    "@halfWidth",
                                    [
                                      "*",
                                      [
                                        "/",
                                        "@femalePercent",
                                        "@config.pyramidScaleMaxPercent"
                                      ],
                                      "@halfWidth"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "femaleBarWidth": "@femaleBarWidth",
                                "femalePercent": "@femalePercent",
                                "label": [
                                  "object/get",
                                  "@r",
                                  "label"
                                ],
                                "maleBarWidth": "@maleBarWidth",
                                "malePercent": "@malePercent",
                                "rowY": "@rowY"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "maleRects",
                        [
                          "array/map",
                          "@computedRows",
                          [
                            "fn",
                            "cr",
                            {
                              "color": "@config.maleColor",
                              "fill": "@config.maleColor",
                              "height": "@barThickness",
                              "type": "rect",
                              "width": [
                                "object/get",
                                "@cr",
                                "maleBarWidth"
                              ],
                              "x": [
                                "-",
                                "@centerX",
                                [
                                  "object/get",
                                  "@cr",
                                  "maleBarWidth"
                                ]
                              ],
                              "y": [
                                "object/get",
                                "@cr",
                                "rowY"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "femaleRects",
                        [
                          "array/map",
                          "@computedRows",
                          [
                            "fn",
                            "cr",
                            {
                              "color": "@config.femaleColor",
                              "fill": "@config.femaleColor",
                              "height": "@barThickness",
                              "type": "rect",
                              "width": [
                                "object/get",
                                "@cr",
                                "femaleBarWidth"
                              ],
                              "x": "@centerX",
                              "y": [
                                "object/get",
                                "@cr",
                                "rowY"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "labelTexts",
                        [
                          "array/map",
                          "@computedRows",
                          [
                            "fn",
                            "cr",
                            {
                              "align": "center",
                              "color": "@config.textColor",
                              "fontSize": 12.0,
                              "text": [
                                "str/concat",
                                [
                                  "object/get",
                                  "@cr",
                                  "label"
                                ],
                                " — ",
                                [
                                  "math/round",
                                  [
                                    "object/get",
                                    "@cr",
                                    "malePercent"
                                  ],
                                  1.0
                                ],
                                "% M / ",
                                [
                                  "math/round",
                                  [
                                    "object/get",
                                    "@cr",
                                    "femalePercent"
                                  ],
                                  1.0
                                ],
                                "% F"
                              ],
                              "type": "text",
                              "x": "@centerX",
                              "y": [
                                "+",
                                [
                                  "object/get",
                                  "@cr",
                                  "rowY"
                                ],
                                [
                                  "+",
                                  [
                                    "/",
                                    "@barThickness",
                                    2.0
                                  ],
                                  4.0
                                ]
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "centerLine",
                        [
                          {
                            "color": "@config.axisColor",
                            "lineWidth": 1.0,
                            "type": "line",
                            "x1": "@centerX",
                            "x2": "@centerX",
                            "y1": 20.0,
                            "y2": [
                              "-",
                              "@config.height",
                              10.0
                            ]
                          }
                        ]
                      ],
                      [
                        "pyramidShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            [
                              "array/concat",
                              "@maleRects",
                              "@femaleRects"
                            ],
                            "@labelTexts"
                          ],
                          "@centerLine"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.c0Male",
                        "@newC0Male"
                      ],
                      [
                        "set",
                        "@entity.c0Female",
                        "@newC0Female"
                      ],
                      [
                        "set",
                        "@entity.c1Male",
                        "@newC1Male"
                      ],
                      [
                        "set",
                        "@entity.c1Female",
                        "@newC1Female"
                      ],
                      [
                        "set",
                        "@entity.c2Male",
                        "@newC2Male"
                      ],
                      [
                        "set",
                        "@entity.c2Female",
                        "@newC2Female"
                      ],
                      [
                        "set",
                        "@entity.c3Male",
                        "@newC3Male"
                      ],
                      [
                        "set",
                        "@entity.c3Female",
                        "@newC3Female"
                      ],
                      [
                        "set",
                        "@entity.c4Male",
                        "@newC4Male"
                      ],
                      [
                        "set",
                        "@entity.c4Female",
                        "@newC4Female"
                      ],
                      [
                        "set",
                        "@entity.totalPopulation",
                        "@total"
                      ],
                      [
                        "set",
                        "@entity.dependencyRatio",
                        "@dependencyRatio"
                      ],
                      [
                        "set",
                        "@entity.baseSharePercent",
                        "@baseSharePercent"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassCode",
                        "@pyramidClassCode"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassLabel",
                        "@pyramidClassLabel"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassReadout",
                        "@pyramidClassReadout"
                      ],
                      [
                        "set",
                        "@entity.pyramidShapes",
                        "@pyramidShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.pyramidShapes",
