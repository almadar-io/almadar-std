                                  "object/get",
                                  "@cr",
                                  "maleBarWidth"
                                ]
                              ],
                              "y": [
                                "object/get",
                                "@cr",
                                "rowY"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "femaleRects",
                        [
                          "array/map",
                          "@computedRows",
                          [
                            "fn",
                            "cr",
                            {
                              "color": "@config.femaleColor",
                              "fill": "@config.femaleColor",
                              "height": "@barThickness",
                              "type": "rect",
                              "width": [
                                "object/get",
                                "@cr",
                                "femaleBarWidth"
                              ],
                              "x": "@centerX",
                              "y": [
                                "object/get",
                                "@cr",
                                "rowY"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "labelTexts",
                        [
                          "array/map",
                          "@computedRows",
                          [
                            "fn",
                            "cr",
                            {
                              "align": "center",
                              "color": "@config.textColor",
                              "fontSize": 12.0,
                              "text": [
                                "str/concat",
                                [
                                  "object/get",
                                  "@cr",
                                  "label"
                                ],
                                " — ",
                                [
                                  "math/round",
                                  [
                                    "object/get",
                                    "@cr",
                                    "malePercent"
                                  ],
                                  1.0
                                ],
                                "% M / ",
                                [
                                  "math/round",
                                  [
                                    "object/get",
                                    "@cr",
                                    "femalePercent"
                                  ],
                                  1.0
                                ],
                                "% F"
                              ],
                              "type": "text",
                              "x": "@centerX",
                              "y": [
                                "+",
                                [
                                  "object/get",
                                  "@cr",
                                  "rowY"
                                ],
                                [
                                  "+",
                                  [
                                    "/",
                                    "@barThickness",
                                    2.0
                                  ],
                                  4.0
                                ]
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "centerLine",
                        [
                          {
                            "color": "@config.axisColor",
                            "lineWidth": 1.0,
                            "type": "line",
                            "x1": "@centerX",
                            "x2": "@centerX",
                            "y1": 20.0,
                            "y2": [
                              "-",
                              "@config.height",
                              10.0
                            ]
                          }
                        ]
                      ],
                      [
                        "pyramidShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            [
                              "array/concat",
                              "@maleRects",
                              "@femaleRects"
                            ],
                            "@labelTexts"
                          ],
                          "@centerLine"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.c0Male",
                        "@newC0Male"
                      ],
                      [
                        "set",
                        "@entity.c0Female",
                        "@newC0Female"
                      ],
                      [
                        "set",
                        "@entity.c1Male",
                        "@newC1Male"
                      ],
                      [
                        "set",
                        "@entity.c1Female",
                        "@newC1Female"
                      ],
                      [
                        "set",
                        "@entity.c2Male",
                        "@newC2Male"
                      ],
                      [
                        "set",
                        "@entity.c2Female",
                        "@newC2Female"
                      ],
                      [
                        "set",
                        "@entity.c3Male",
                        "@newC3Male"
                      ],
                      [
                        "set",
                        "@entity.c3Female",
                        "@newC3Female"
                      ],
                      [
                        "set",
                        "@entity.c4Male",
                        "@newC4Male"
                      ],
                      [
                        "set",
                        "@entity.c4Female",
                        "@newC4Female"
                      ],
                      [
                        "set",
                        "@entity.totalPopulation",
                        "@total"
                      ],
                      [
                        "set",
                        "@entity.dependencyRatio",
                        "@dependencyRatio"
                      ],
                      [
                        "set",
                        "@entity.baseSharePercent",
                        "@baseSharePercent"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassCode",
                        "@pyramidClassCode"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassLabel",
                        "@pyramidClassLabel"
                      ],
                      [
                        "set",
                        "@entity.pyramidClassReadout",
                        "@pyramidClassReadout"
                      ],
                      [
                        "set",
                        "@entity.pyramidShapes",
                        "@pyramidShapes"
                      ],
                      [
                        "set",
                        "@entity.decadeStep",
                        [
                          "+",
                          "@entity.decadeStep",
                          1.0
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.pyramidShapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Birth rate: ",
                                    "@entity.birthRate",
                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 50.0,
                                  "min": 0.0,
                                  "onChange": "SET_BIRTH_RATE",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.birthRate"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Death rate: ",
                                    "@entity.deathRate",
                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 50.0,
                                  "min": 0.0,
                                  "onChange": "SET_DEATH_RATE",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.deathRate"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Net migration: ",
                                    "@entity.migrationRate",
                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 30.0,
                                  "min": -30.0,
                                  "onChange": "SET_MIGRATION",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.migrationRate"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "STEP_DECADE",
                                  "label": "Step Decade",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Generations advanced: ",
                                "@entity.decadeStep"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Total population index: ",
                                [
                                  "math/round",
                                  "@entity.totalPopulation",
                                  1.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Dependency ratio: ",
                                [
                                  "math/round",
                                  "@entity.dependencyRatio",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.pyramidClassReadout",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "POPULATION_UPDATED",
                    {
                      "birthRate": "@entity.birthRate",
                      "deathRate": "@entity.deathRate",
                      "decadeStep": "@entity.decadeStep",
                      "dependencyRatio": "@entity.dependencyRatio",
                      "migrationRate": "@entity.migrationRate",
                      "pyramidClassLabel": "@entity.pyramidClassLabel",
                      "totalPopulation": "@entity.totalPopulation"
                    }
                  ]
                ],
                "event": "STEP_DECADE",
                "eventId": "evt_01KZEGFJQM9ZSV4C1H7JX8HVJA",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}