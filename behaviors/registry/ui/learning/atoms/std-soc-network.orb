          "id": "trt_01M04DG95PQ296H5SBBKMBMEJQ",
          "linkedEntity": "SocNetScene",
          "linkedEntityId": "ent_01M04DG95PP79XNC0FD5YKA5P1",
          "name": "SocNetSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M04DG95PCKNEX8CZZW5CYGBM",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M04DG95QSDDX63MHGHQP5A0E",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner toggled a node on or off, removing it from the network (and its edges from view) or restoring it.",
                "id": "evt_01M04DG95QT2WBGMT32KT863XN",
                "key": "TOGGLE_NODE",
                "name": "Toggle Node",
                "payloadSchema": [
                  {
                    "name": "nodeId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner rewired an edge — toggled the edge at this index in the Edges list on or off.",
                "id": "evt_01M04DG95QQWG7NQ2DC89KY543",
                "key": "TOGGLE_EDGE",
                "name": "Toggle Edge",
                "payloadSchema": [
                  {
                    "name": "edgeIndex",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Run Diffusion to advance the complex-contagion cascade by one step.",
                "id": "evt_01M04DG95QSDXPB4MGG0XBM72V",
                "key": "RUN_DIFFUSION",
                "name": "Run Diffusion",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset to restore the initial network and clear all adoption.",
                "id": "evt_01M04DG95QTT09BA6DCDE39G1W",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The network state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04DG95QYKF769C604N9G9SZ",
                "key": "NETWORK_UPDATED",
                "name": "Network Updated",
                "payloadSchema": [
                  {
                    "name": "nodeEnabled",
                    "type": "[boolean]"
                  },
                  {
                    "name": "edgeEnabled",
                    "type": "[boolean]"
                  },
                  {
                    "name": "adopted",
                    "type": "[boolean]"
                  },
                  {
                    "name": "adoptedCount",
                    "type": "number"
                  },
                  {
                    "name": "hub",
                    "type": "string"
                  }
                ],
                "synonyms": "network update, rewiring, tie toggle, diffusion cascade, centrality change, weak ties",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "let",
                    [
                      [
                        "nodeCount",
                        [
                          "array/len",
                          "@config.nodes"
                        ]
                      ],
                      [
                        "edgeCount",
                        [
                          "array/len",
                          "@config.edges"
                        ]
                      ],
                      [
                        "enabledN",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@nodeCount"
                          ],
                          [
                            "fn",
                            "i",
                            true
                          ]
                        ]
                      ],
                      [
                        "enabledE",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@edgeCount"
                          ],
                          [
                            "fn",
                            "j",
                            true
                          ]
                        ]
                      ],
                      [
                        "adoptedInit",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@nodeCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "==",
                              "@i",
                              0.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "degrees",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@nodeCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "array/len",
                              [
                                "array/filter",
                                [
                                  "array/range",
                                  "@edgeCount"
                                ],
                                [
                                  "fn",
                                  "j",
                                  [
                                    "or",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@config.edges",
                                          "@j"
                                        ],
                                        "from"
                                      ],
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@config.nodes",
                                          "@i"
                                        ],
                                        "id"
                                      ]
                                    ],
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@config.edges",
                                          "@j"
                                        ],
                                        "to"
                                      ],
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@config.nodes",
                                          "@i"
                                        ],
                                        "id"
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "hubIdx",
                        [
                          "array/reduce",
                          [
                            "array/range",
                            "@nodeCount"
                          ],
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "i"
                            ],
                            [
                              "if",
                              [
                                ">",
                                [
                                  "array/nth",
                                  "@degrees",
                                  "@i"
                                ],
                                [
                                  "array/nth",
                                  "@degrees",
                                  "@acc"
                                ]
                              ],
                              "@i",
                              "@acc"
                            ]
                          ]
                        ]
                      ],
                      [
                        "hubTxt",
                        [
                          "if",
                          [
                            "==",
                            "@config.centralityMetric",
                            "reach"
                          ],
                          [
                            "str/concat",
                            "Diffusion reach: 1 of ",
                            "@nodeCount",
                            " nodes — press Run Diffusion to spread adoption."
                          ],
                          [
                            "str/concat",
                            "Degree-centrality hub: ",
                            [
                              "object/get",
