                            "@config.paramBMax"
                          ],
                          "@entity.rightB"
                        ]
                      ],
                      [
                        "leftSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@lA",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@lB"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
                                        "+",
                                        "@lA",
                                        [
                                          "*",
                                          "@lB",
                                          "@x"
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@lA",
                                        [
                                          "math/sin",
                                          [
                                            "*",
                                            "@lB",
                                            "@x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@yVal"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "rightSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@rA",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@rB"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
