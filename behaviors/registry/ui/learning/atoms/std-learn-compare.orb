          "id": "trt_01M07580GXTEC742YQ30195GJQ",
          "linkedEntity": "CompareScene",
          "linkedEntityId": "ent_01M07580GWS8R3KZP2PDX8FA6G",
          "name": "CompareSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M07580GXDCEKXQEPFYDSF1TS",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M07580H5Q89M2Z3CM4P6NA63",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged one of the four sliders — side names the compared instance (left or right), which names the parameter (A or B), value is the new setting; both curves and the delta recompute immediately.",
                "id": "evt_01M07580H56QMZDG0CCEWS1HD1",
                "key": "SET_PARAM",
                "name": "Set Param",
                "payloadSchema": [
                  {
                    "name": "side",
                    "type": "string"
                  },
                  {
                    "name": "which",
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Both parameter pairs and the midpoint delta after a slider change — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M07580H57BA2GVWK2DYXF0SY",
                "key": "COMPARISON_CHANGED",
                "name": "Comparison Changed",
                "payloadSchema": [
                  {
                    "name": "leftA",
                    "type": "number"
                  },
                  {
                    "name": "leftB",
                    "type": "number"
                  },
                  {
                    "name": "rightA",
                    "type": "number"
                  },
                  {
                    "name": "rightB",
                    "type": "number"
                  },
                  {
                    "name": "delta",
                    "type": "number"
                  }
                ],
                "synonyms": "dual view, side by side, comparator, contrast two settings, A/B comparison",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "kind",
                        "@config.curveKind"
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "lA",
                        "@config.leftADefault"
                      ],
                      [
                        "lB",
                        "@config.leftBDefault"
                      ],
                      [
                        "rA",
                        "@config.rightADefault"
                      ],
                      [
                        "rB",
                        "@config.rightBDefault"
                      ],
                      [
                        "leftSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@lA",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@lB"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
                                        "+",
                                        "@lA",
                                        [
                                          "*",
                                          "@lB",
                                          "@x"
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@lA",
                                        [
                                          "math/sin",
                                          [
                                            "*",
                                            "@lB",
                                            "@x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@yVal"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "rightSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@rA",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@rB"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
                                        "+",
                                        "@rA",
                                        [
                                          "*",
                                          "@rB",
                                          "@x"
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@rA",
                                        [
                                          "math/sin",
                                          [
                                            "*",
                                            "@rB",
                                            "@x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@yVal"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "allSamples",
                        [
                          "array/concat",
                          "@leftSamples",
                          "@rightSamples"
                        ]
                      ],
                      [
                        "yMinRaw",
                        [
                          "array/reduce",
                          "@allSamples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@allSamples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/min",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yMaxRaw",
                        [
                          "array/reduce",
                          "@allSamples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@allSamples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/max",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yPad",
                        [
                          "*",
                          0.1,
                          [
                            "math/max",
                            0.001,
                            [
                              "-",
                              "@yMaxRaw",
                              "@yMinRaw"
                            ]
                          ]
                        ]
                      ],
                      [
                        "xMidV",
                        [
                          "/",
                          [
                            "+",
                            "@config.xMin",
                            "@config.xMax"
                          ],
                          2.0
                        ]
                      ],
                      [
                        "lMid",
                        [
                          "if",
                          [
                            "==",
                            "@kind",
                            "power"
                          ],
                          [
                            "*",
                            "@lA",
                            [
                              "math/pow",
                              "@xMidV",
                              "@lB"
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@kind",
                              "linear"
                            ],
                            [
                              "+",
                              "@lA",
                              [
                                "*",
                                "@lB",
                                "@xMidV"
                              ]
                            ],
                            [
                              "*",
                              "@lA",
                              [
                                "math/sin",
                                [
                                  "*",
                                  "@lB",
                                  "@xMidV"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "rMid",
                        [
                          "if",
                          [
                            "==",
                            "@kind",
                            "power"
                          ],
                          [
                            "*",
                            "@rA",
                            [
                              "math/pow",
                              "@xMidV",
                              "@rB"
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@kind",
                              "linear"
                            ],
                            [
                              "+",
                              "@rA",
                              [
                                "*",
                                "@rB",
                                "@xMidV"
                              ]
                            ],
                            [
                              "*",
                              "@rA",
                              [
                                "math/sin",
                                [
                                  "*",
                                  "@rB",
                                  "@xMidV"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.curveKind",
                        "@kind"
                      ],
                      [
                        "set",
                        "@entity.leftA",
                        "@lA"
                      ],
                      [
                        "set",
                        "@entity.leftB",
                        "@lB"
                      ],
                      [
                        "set",
                        "@entity.rightA",
                        "@rA"
                      ],
                      [
                        "set",
                        "@entity.rightB",
                        "@rB"
                      ],
                      [
                        "set",
                        "@entity.xMid",
                        "@xMidV"
                      ],
                      [
                        "set",
                        "@entity.leftMid",
                        "@lMid"
                      ],
                      [
                        "set",
                        "@entity.rightMid",
                        "@rMid"
                      ],
                      [
                        "set",
                        "@entity.delta",
                        [
                          "-",
                          "@rMid",
                          "@lMid"
                        ]
                      ],
                      [
                        "set",
                        "@entity.yMin",
                        [
                          "-",
                          "@yMinRaw",
                          "@yPad"
                        ]
                      ],
                      [
