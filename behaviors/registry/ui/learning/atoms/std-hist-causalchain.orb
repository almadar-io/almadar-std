                      ],
                      [
                        "causalShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            "@edgeShapes",
                            "@causeShapes"
                          ],
                          "@outcomeShapes"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.activeIds",
                        "@finalActiveIds"
                      ],
                      [
                        "set",
                        "@entity.totalContribution",
                        "@totalContribution"
                      ],
                      [
                        "set",
                        "@entity.outcomeFires",
                        "@outcomeFires"
                      ],
                      [
                        "set",
                        "@entity.missingNecessaryLabel",
                        "@missingNecessaryLabel"
                      ],
                      [
                        "set",
                        "@entity.contributionReadout",
                        "@contributionReadout"
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@causalShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "Toggle a cause to test the counterfactual: does war still break out without it?",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.causes",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "action": "TOGGLE_CAUSE",
                                    "actionPayload": {
                                      "causeId": "@c.id"
                                    },
                                    "label": [
                                      "if",
                                      [
                                        "array/includes",
                                        "@entity.activeIds",
                                        "@c.id"
                                      ],
                                      "@c.label",
                                      [
                                        "str/concat",
                                        "@c.label",
                                        " — removed"
                                      ]
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "array/includes",
                                        "@entity.activeIds",
                                        "@c.id"
                                      ],
                                      "primary",
                                      "ghost"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "RESET_CAUSES",
                                  "label": "Reset All Causes",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "label": [
                                    "if",
                                    "@entity.outcomeFires",
                                    "WAR",
                                    "NO WAR (counterfactual)"
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    "@entity.outcomeFires",
                                    "danger",
                                    "success"
                                  ]
                                },
                                {
                                  "content": "@entity.contributionReadout",
                                  "type": "typography",
                                  "variant": "body"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "CAUSAL_CHAIN_UPDATED",
                    {
                      "activeIds": "@entity.activeIds",
                      "outcomeFires": "@entity.outcomeFires",
                      "totalContribution": "@entity.totalContribution"
                    }
                  ]
                ],
                "event": "RESET_CAUSES",
                "eventId": "evt_01KZEG9RC4H0QJRP5G45J4MH4V",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}