                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.causes",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "action": "TOGGLE_CAUSE",
                                    "actionPayload": {
                                      "causeId": "@c.id"
                                    },
                                    "label": [
                                      "if",
                                      [
                                        "array/includes",
                                        "@entity.activeIds",
                                        "@c.id"
                                      ],
                                      "@c.label",
