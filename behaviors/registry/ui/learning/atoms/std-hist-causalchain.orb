                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEG9RC4AT5X1HE7RX7FMHJ1",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.removedIds",
                    [
                      "if",
                      [
                        "array/includes",
                        "@entity.removedIds",
                        "@payload.causeId"
                      ],
                      [
                        "array/filter",
                        "@entity.removedIds",
                        [
                          "fn",
                          "rid",
                          [
                            "!=",
                            "@rid",
                            "@payload.causeId"
                          ]
                        ]
                      ],
                      [
                        "array/concat",
                        "@entity.removedIds",
                        [
                          "@payload.causeId"
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "causeIds",
                        [
                          "array/map",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            "@c.id"
                          ]
                        ]
                      ],
                      [
                        "seedActiveIds",
                        [
                          "array/filter",
                          "@causeIds",
                          [
                            "fn",
                            "cid",
                            [
                              "not",
                              [
                                "array/includes",
                                "@entity.removedIds",
                                "@cid"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "passCount",
                        [
                          "array/len",
                          "@config.causes"
                        ]
                      ],
                      [
                        "finalActiveIds",
                        [
                          "array/reduce",
                          [
                            "array/range",
                            "@passCount"
                          ],
                          "@seedActiveIds",
                          [
                            "fn",
                            [
                              "acc",
                              "i"
                            ],
                            [
                              "array/filter",
                              "@acc",
                              [
                                "fn",
                                "cid",
                                [
                                  "==",
                                  [
                                    "array/len",
                                    [
                                      "array/filter",
                                      "@config.edges",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "and",
                                          [
                                            "==",
                                            "@e.to",
                                            "@cid"
                                          ],
                                          [
                                            "not",
                                            [
                                              "array/includes",
                                              "@acc",
                                              "@e.from"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  0.0
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "activeCauses",
                        [
                          "array/filter",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            [
                              "array/includes",
                              "@finalActiveIds",
                              "@c.id"
                            ]
                          ]
                        ]
                      ],
                      [
                        "totalContribution",
                        [
                          "array/sum",
                          [
                            "array/map",
                            "@activeCauses",
                            [
                              "fn",
                              "c",
                              "@c.contribution"
                            ]
                          ]
                        ]
                      ],
                      [
                        "outcomeFires",
                        [
                          ">=",
                          "@totalContribution",
                          "@config.threshold"
                        ]
                      ],
                      [
                        "missingNecessaryList",
                        [
                          "array/filter",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            [
                              "and",
                              "@c.necessary",
                              [
                                "not",
                                [
                                  "array/includes",
                                  "@finalActiveIds",
                                  "@c.id"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "missingNecessaryCause",
                        [
                          "array/first",
                          "@missingNecessaryList"
                        ]
                      ],
                      [
                        "missingNecessaryLabel",
                        [
                          "if",
                          [
                            "!=",
                            "@missingNecessaryCause",
                            null
                          ],
                          [
                            "object/get",
                            "@missingNecessaryCause",
                            "label"
                          ],
                          "none — every necessary trigger is still active"
                        ]
                      ],
                      [
                        "contributionReadout",
                        [
                          "str/concat",
                          "Active contribution: ",
                          "@totalContribution",
                          " of ",
                          "@config.threshold",
                          " needed for war. Missing necessary trigger: ",
                          "@missingNecessaryLabel"
                        ]
                      ],
                      [
                        "causeShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.causes",
                            [
                              "fn",
                              "c",
                              [
                                "let",
                                [
                                  [
                                    "isActive",
                                    [
                                      "array/includes",
                                      "@finalActiveIds",
                                      "@c.id"
                                    ]
                                  ],
                                  [
                                    "col",
                                    [
                                      "if",
                                      "@isActive",
                                      "@config.activeCauseColor",
                                      "@config.removedCauseColor"
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "color": "@col",
                                    "fill": "@col",
                                    "id": "@c.id",
                                    "lineWidth": 2.0,
                                    "opacity": [
                                      "if",
                                      "@isActive",
                                      1.0,
                                      0.4
                                    ],
                                    "radius": "@config.causeRadius",
                                    "type": "circle",
                                    "x": "@c.x",
                                    "y": "@c.y"
                                  },
                                  {
                                    "align": "center",
                                    "color": [
                                      "if",
                                      "@isActive",
                                      "#1c1917",
                                      "#a8a29e"
                                    ],
                                    "fontSize": 12.0,
                                    "id": [
                                      "str/concat",
                                      "@c.id",
                                      "-label"
                                    ],
                                    "text": "@c.label",
                                    "type": "text",
                                    "x": "@c.x",
                                    "y": [
                                      "+",
                                      [
                                        "+",
                                        "@c.y",
                                        "@config.causeRadius"
                                      ],
                                      16.0
                                    ]
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "edgeShapes",
                        [
                          "array/map",
                          "@config.edges",
                          [
                            "fn",
                            "e",
                            [
                              "let",
                              [
                                [
                                  "fromActive",
                                  [
                                    "array/includes",
                                    "@finalActiveIds",
                                    "@e.from"
                                  ]
                                ],
                                [
                                  "isOutcome",
                                  [
                                    "==",
                                    "@e.to",
                                    "outcome"
                                  ]
                                ],
                                [
                                  "fromNode",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.causes",
                                      [
                                        "fn",
                                        "c",
                                        [
                                          "==",
                                          "@c.id",
                                          "@e.from"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "toNode",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.causes",
                                      [
                                        "fn",
                                        "c",
                                        [
                                          "==",
                                          "@c.id",
                                          "@e.to"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "x1",
                                  [
                                    "object/get",
                                    "@fromNode",
                                    "x"
                                  ]
                                ],
                                [
                                  "y1",
                                  [
                                    "object/get",
                                    "@fromNode",
                                    "y"
                                  ]
                                ],
                                [
                                  "x2",
                                  [
                                    "if",
                                    "@isOutcome",
                                    "@config.outcomeX",
                                    [
                                      "object/get",
                                      "@toNode",
                                      "x"
                                    ]
                                  ]
                                ],
                                [
                                  "y2",
                                  [
                                    "if",
                                    "@isOutcome",
                                    "@config.outcomeY",
                                    [
                                      "object/get",
                                      "@toNode",
                                      "y"
                                    ]
                                  ]
                                ],
                                [
                                  "col",
                                  [
                                    "if",
                                    "@fromActive",
                                    "@config.edgeActiveColor",
                                    "@config.edgeRemovedColor"
                                  ]
                                ]
                              ],
                              {
                                "color": "@col",
                                "id": [
                                  "str/concat",
                                  "@e.from",
                                  "-to-",
                                  "@e.to"
                                ],
                                "lineWidth": [
                                  "if",
                                  "@fromActive",
                                  2.5,
                                  1.0
                                ],
                                "opacity": [
                                  "if",
                                  "@fromActive",
                                  0.9,
                                  0.3
                                ],
                                "type": "arrow",
                                "x1": "@x1",
                                "x2": "@x2",
                                "y1": "@y1",
                                "y2": "@y2"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "outcomeShapes",
                        [
                          {
                            "color": [
                              "if",
                              "@outcomeFires",
                              "@config.warColor",
                              "@config.noWarColor"
                            ],
                            "fill": [
                              "if",
                              "@outcomeFires",
                              "@config.warColor",
                              "@config.noWarColor"
                            ],
                            "id": "outcome",
                            "lineWidth": 2.0,
                            "opacity": 1.0,
                            "radius": "@config.outcomeRadius",
                            "type": "circle",
                            "x": "@config.outcomeX",
                            "y": "@config.outcomeY"
                          },
                          {
                            "align": "center",
                            "color": "#ffffff",
                            "fontSize": 15.0,
                            "id": "outcomeText",
                            "text": [
                              "if",
                              "@outcomeFires",
                              "WAR",
                              "NO WAR"
                            ],
                            "type": "text",
                            "x": "@config.outcomeX",
                            "y": "@config.outcomeY"
                          }
                        ]
                      ],
                      [
                        "causalShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            "@edgeShapes",
                            "@causeShapes"
                          ],
                          "@outcomeShapes"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.activeIds",
                        "@finalActiveIds"
                      ],
                      [
                        "set",
                        "@entity.totalContribution",
                        "@totalContribution"
                      ],
                      [
                        "set",
                        "@entity.outcomeFires",
                        "@outcomeFires"
                      ],
                      [
                        "set",
                        "@entity.missingNecessaryLabel",
                        "@missingNecessaryLabel"
                      ],
                      [
                        "set",
                        "@entity.contributionReadout",
                        "@contributionReadout"
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@causalShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "Toggle a cause to test the counterfactual: does war still break out without it?",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.causes",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "action": "TOGGLE_CAUSE",
                                    "actionPayload": {
                                      "causeId": "@c.id"
                                    },
                                    "label": [
                                      "if",
                                      [
                                        "array/includes",
                                        "@entity.activeIds",
                                        "@c.id"
                                      ],
                                      "@c.label",
                                      [
                                        "str/concat",
                                        "@c.label",
                                        " — removed"
                                      ]
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "array/includes",
                                        "@entity.activeIds",
                                        "@c.id"
                                      ],
                                      "primary",
                                      "ghost"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "RESET_CAUSES",
                                  "label": "Reset All Causes",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "label": [
