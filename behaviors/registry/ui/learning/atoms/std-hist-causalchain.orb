              "label": "War Color",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The causal-chain state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "CAUSAL_CHAIN_UPDATED",
              "eventId": "evt_01KZEG9RC4PX67WJGDMMJTF3R1",
              "payloadSchema": [
                {
                  "name": "activeIds",
                  "type": "[string]"
                },
                {
                  "name": "totalContribution",
                  "type": "number"
                },
                {
                  "name": "outcomeFires",
                  "type": "boolean"
                }
              ],
              "scope": "external",
              "synonyms": "causal chain update, cascade result, outcome, war, no war, counterfactual result",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "activeIds",
              "contributionReadout",
              "missingNecessaryLabel",
              "outcomeFires",
              "removedIds",
              "shapes",
              "title",
              "totalContribution"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "HistCausalChainScene": "ent_01KZEG9RC4V5T7M48Y9YZN7ANC"
          },
          "id": "trt_01KZEG9RC47X4RMP3P8W1ZH71R",
          "linkedEntity": "HistCausalChainScene",
          "linkedEntityId": "ent_01KZEG9RC4V5T7M48Y9YZN7ANC",
          "name": "HistCausalChainSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEG9RC4QM1MP34KBQS9MS9Z",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEG9RC4AT5X1HE7RX7FMHJ1",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner clicked a cause button to remove or restore that cause from the causal chain.",
                "id": "evt_01KZEG9RC4AYR1CZM6AZ5C5617",
                "key": "TOGGLE_CAUSE",
                "name": "Toggle Cause",
                "payloadSchema": [
                  {
                    "name": "causeId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner reset every cause back to active, restoring the full causal chain.",
                "id": "evt_01KZEG9RC4H0QJRP5G45J4MH4V",
                "key": "RESET_CAUSES",
                "name": "Reset Causes",
                "tier": "domain"
              },
              {
                "description": "The causal-chain state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEG9RC4PX67WJGDMMJTF3R1",
                "key": "CAUSAL_CHAIN_UPDATED",
                "name": "Causal Chain Updated",
                "payloadSchema": [
                  {
                    "name": "activeIds",
                    "type": "[string]"
                  },
                  {
                    "name": "totalContribution",
                    "type": "number"
                  },
                  {
                    "name": "outcomeFires",
                    "type": "boolean"
                  }
                ],
                "synonyms": "causal chain update, cascade result, outcome, war, no war, counterfactual result",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.removedIds",
                    []
                  ],
                  [
                    "let",
                    [
                      [
                        "causeIds",
                        [
                          "array/map",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            "@c.id"
                          ]
                        ]
                      ],
                      [
                        "seedActiveIds",
                        [
                          "array/filter",
                          "@causeIds",
                          [
                            "fn",
                            "cid",
                            [
                              "not",
                              [
                                "array/includes",
                                "@entity.removedIds",
                                "@cid"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "passCount",
                        [
                          "array/len",
                          "@config.causes"
                        ]
                      ],
                      [
                        "finalActiveIds",
                        [
                          "array/reduce",
                          [
                            "array/range",
                            "@passCount"
                          ],
                          "@seedActiveIds",
                          [
                            "fn",
                            [
                              "acc",
                              "i"
                            ],
                            [
                              "array/filter",
                              "@acc",
                              [
                                "fn",
                                "cid",
                                [
                                  "==",
                                  [
                                    "array/len",
                                    [
                                      "array/filter",
                                      "@config.edges",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "and",
                                          [
                                            "==",
                                            "@e.to",
                                            "@cid"
                                          ],
                                          [
                                            "not",
                                            [
                                              "array/includes",
                                              "@acc",
                                              "@e.from"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  0.0
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "activeCauses",
                        [
                          "array/filter",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            [
                              "array/includes",
                              "@finalActiveIds",
                              "@c.id"
                            ]
                          ]
                        ]
                      ],
                      [
                        "totalContribution",
                        [
                          "array/sum",
                          [
                            "array/map",
                            "@activeCauses",
                            [
                              "fn",
                              "c",
                              "@c.contribution"
                            ]
                          ]
                        ]
                      ],
                      [
                        "outcomeFires",
                        [
                          ">=",
                          "@totalContribution",
                          "@config.threshold"
                        ]
                      ],
                      [
                        "missingNecessaryList",
                        [
                          "array/filter",
                          "@config.causes",
                          [
                            "fn",
                            "c",
                            [
                              "and",
                              "@c.necessary",
                              [
                                "not",
                                [
                                  "array/includes",
                                  "@finalActiveIds",
                                  "@c.id"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "missingNecessaryCause",
                        [
                          "array/first",
                          "@missingNecessaryList"
                        ]
                      ],
                      [
                        "missingNecessaryLabel",
                        [
                          "if",
                          [
                            "!=",
                            "@missingNecessaryCause",
                            null
                          ],
                          [
                            "object/get",
                            "@missingNecessaryCause",
                            "label"
                          ],
                          "none — every necessary trigger is still active"
                        ]
                      ],
                      [
                        "contributionReadout",
                        [
                          "str/concat",
                          "Active contribution: ",
                          "@totalContribution",
                          " of ",
                          "@config.threshold",
                          " needed for war. Missing necessary trigger: ",
                          "@missingNecessaryLabel"
                        ]
                      ],
                      [
                        "causeShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.causes",
                            [
                              "fn",
                              "c",
                              [
                                "let",
                                [
                                  [
                                    "isActive",
                                    [
                                      "array/includes",
                                      "@finalActiveIds",
                                      "@c.id"
                                    ]
                                  ],
                                  [
                                    "col",
                                    [
                                      "if",
                                      "@isActive",
                                      "@config.activeCauseColor",
                                      "@config.removedCauseColor"
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "color": "@col",
                                    "fill": "@col",
                                    "id": "@c.id",
                                    "lineWidth": 2.0,
                                    "opacity": [
                                      "if",
                                      "@isActive",
                                      1.0,
                                      0.4
                                    ],
                                    "radius": "@config.causeRadius",
                                    "type": "circle",
                                    "x": "@c.x",
                                    "y": "@c.y"
                                  },
                                  {
                                    "align": "center",
                                    "color": [
                                      "if",
                                      "@isActive",
                                      "#1c1917",
                                      "#a8a29e"
                                    ],
                                    "fontSize": 12.0,
                                    "id": [
                                      "str/concat",
                                      "@c.id",
                                      "-label"
                                    ],
                                    "text": "@c.label",
                                    "type": "text",
                                    "x": "@c.x",
                                    "y": [
                                      "+",
                                      [
                                        "+",
                                        "@c.y",
                                        "@config.causeRadius"
                                      ],
                                      16.0
                                    ]
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "edgeShapes",
                        [
                          "array/map",
                          "@config.edges",
                          [
                            "fn",
                            "e",
                            [
                              "let",
                              [
                                [
                                  "fromActive",
                                  [
                                    "array/includes",
                                    "@finalActiveIds",
                                    "@e.from"
                                  ]
                                ],
                                [
                                  "isOutcome",
                                  [
                                    "==",
                                    "@e.to",
                                    "outcome"
                                  ]
                                ],
                                [
                                  "fromNode",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.causes",
                                      [
                                        "fn",
                                        "c",
                                        [
                                          "==",
                                          "@c.id",
                                          "@e.from"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "toNode",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.causes",
                                      [
                                        "fn",
                                        "c",
                                        [
                                          "==",
                                          "@c.id",
