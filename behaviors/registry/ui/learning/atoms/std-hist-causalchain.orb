                        ]
                      ],
                      [
                        "seedActiveIds",
                        [
                          "array/filter",
                          "@causeIds",
                          [
                            "fn",
                            "cid",
                            [
                              "not",
                              [
                                "array/includes",
                                "@entity.removedIds",
                                "@cid"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "passCount",
                        [
                          "array/len",
                          "@config.causes"
                        ]
                      ],
                      [
                        "finalActiveIds",
                        [
                          "array/reduce",
                          [
                            "array/range",
                            "@passCount"
                          ],
                          "@seedActiveIds",
                          [
                            "fn",
                            [
                              "acc",
                              "i"
                            ],
                            [
                              "array/filter",
                              "@acc",
                              [
                                "fn",
                                "cid",
                                [
                                  "==",
                                  [
                                    "array/len",
                                    [
                                      "array/filter",
                                      "@config.edges",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "and",
                                          [
                                            "==",
                                            "@e.to",
                                            "@cid"
                                          ],
                                          [
                                            "not",
                                            [
                                              "array/includes",
                                              "@acc",
                                              "@e.from"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  0.0
                                ]
                              ]
                            ]
                          ]
                        ]
