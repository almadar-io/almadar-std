                  "label": "Assassination of Franz Ferdinand",
                  "necessary": true,
                  "x": 550.0,
                  "y": 260.0
                }
              ],
              "description": "Roster of the five WWI causes the learner can toggle: four long-building structural causes (militarism, the alliance system, imperial rivalry, nationalism) and one short-fuse trigger (the assassination), each with a canvas position and a contribution weight toward the war threshold.",
              "items": {
                "properties": {
                  "contribution": {
                    "name": "contribution",
                    "required": false,
                    "type": "number"
                  },
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "necessary": {
