      "traits": [
        {
          "category": "interaction",
          "config": {
            "advanceLabel": {
              "default": "Next",
              "description": "Label text for the button that advances to the next item.",
              "label": "Advance Button Label",
              "tier": "presentation",
              "type": "string"
            },
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f8fafc",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "categories": {
              "default": [
                {
                  "color": "#94a3b8",
                  "label": "Category A",
                  "value": "a"
                },
                {
                  "color": "#64748b",
                  "label": "Category B",
                  "value": "b"
                }
              ],
              "description": "Ordered bottom-to-top roster of category buckets (value/label/color) used to render the stacked backdrop and the pick buttons; order determines the backdrop's stacking, widest at the bottom to narrowest at the top.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "value": {
                    "name": "value",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Categories",
              "synonyms": "category, bucket, class, tier, level, classification, roster",
              "tier": "domain",
              "type": "[LearnClassifyOption]"
            },
            "correctColor": {
              "default": "#16a34a",
              "description": "Fill color for the correct category once the learner has picked.",
              "label": "Correct Highlight Color",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": 420.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "incorrectColor": {
              "default": "#dc2626",
              "description": "Fill color for the learner's picked category when it does not match the correct category.",
              "label": "Incorrect Highlight Color",
              "tier": "presentation",
              "type": "string"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "items": {
              "default": [
                {
                  "category": "a",
                  "text": "Example item one."
                },
                {
                  "category": "b",
                  "text": "Example item two."
                }
              ],
              "description": "Roster of items the learner classifies; each carries its prompt text and the value of its correct category.",
              "items": {
                "properties": {
                  "category": {
                    "name": "category",
                    "required": true,
                    "type": "string"
                  },
                  "text": {
                    "name": "text",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Items",
              "synonyms": "item, prompt, scenario, situation, case, example, question",
              "tier": "domain",
              "type": "[LearnClassifyItem]"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Classify",
              "description": "Title shown above the instrument.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The classification state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "CLASSIFY_UPDATED",
              "eventId": "evt_01KZEFWYXQ79QRSM4HE1YVSQBD",
              "payloadSchema": [
                {
                  "name": "itemIndex",
                  "type": "number"
                },
                {
                  "name": "correctCount",
                  "type": "number"
                },
                {
                  "name": "attemptedCount",
                  "type": "number"
                },
                {
                  "name": "selectedCategory",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "classify update, pick result, score, running score, verdict",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "attemptedCount",
              "backdropShapes",
              "correctCategory",
              "correctCount",
              "feedback",
              "itemIndex",
              "itemText",
              "selectedCategory",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "LearnClassifyScene": "ent_01KZEFWYXPWAHG8RB77Q7P6P7J"
          },
          "id": "trt_01KZEFWYXP5EK4MMGJG1PAGTNG",
          "linkedEntity": "LearnClassifyScene",
          "linkedEntityId": "ent_01KZEFWYXPWAHG8RB77Q7P6P7J",
          "name": "LearnClassifySim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFWYXP1NHSN9QKG27M098G",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFWYXQWVDTDPHMGJ8KGQN8",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked a category for the current item; verdicted against the item's declared correct category.",
                "id": "evt_01KZEFWYXQT0V3ZJ5R1TC6GDEM",
                "key": "PICK",
                "name": "Pick",
                "payloadSchema": [
                  {
                    "name": "category",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next item, clearing the pick and feedback for the new item.",
                "id": "evt_01KZEFWYXQVER741S1XP779QZ6",
                "key": "ADVANCE",
                "name": "Advance",
                "tier": "domain"
              },
              {
                "description": "The classification state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFWYXQ79QRSM4HE1YVSQBD",
                "key": "CLASSIFY_UPDATED",
                "name": "Classify Updated",
                "payloadSchema": [
                  {
                    "name": "itemIndex",
                    "type": "number"
                  },
                  {
                    "name": "correctCount",
                    "type": "number"
                  },
                  {
                    "name": "attemptedCount",
                    "type": "number"
                  },
                  {
                    "name": "selectedCategory",
                    "type": "string"
                  }
                ],
                "synonyms": "classify update, pick result, score, running score, verdict",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.itemIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.correctCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.attemptedCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.selectedCategory",
                    ""
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "item",
                        [
                          "array/nth",
                          "@config.items",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.itemText",
                        [
                          "object/get",
                          "@item",
                          "text"
                        ]
                      ],
                      [
                        "set",
                        "@entity.correctCategory",
                        [
                          "object/get",
                          "@item",
                          "category"
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "categoryCount",
                        [
                          "array/len",
                          "@config.categories"
                        ]
                      ],
                      [
                        "marginX",
                        30.0
                      ],
                      [
                        "marginY",
                        20.0
                      ],
                      [
                        "plotWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "*",
                            "@marginX",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotHeight",
                        [
                          "-",
                          "@config.height",
                          [
                            "*",
                            "@marginY",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          "@marginY"
                        ]
                      ],
                      [
                        "tierHeight",
                        [
                          "/",
                          "@plotHeight",
                          "@categoryCount"
                        ]
                      ],
                      [
                        "maxWidth",
                        [
                          "*",
                          "@plotWidth",
                          0.95
                        ]
                      ],
                      [
                        "minWidth",
                        [
                          "*",
                          "@plotWidth",
                          0.3
                        ]
                      ],
                      [
                        "widthStep",
                        [
                          "/",
                          [
                            "-",
                            "@maxWidth",
                            "@minWidth"
                          ],
                          [
                            "-",
                            "@categoryCount",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "centerX",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "revealed",
                        [
                          "!=",
                          "@entity.selectedCategory",
                          ""
                        ]
                      ],
                      [
                        "rects",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@categoryCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "category",
                                  [
                                    "array/nth",
                                    "@config.categories",
                                    "@i"
                                  ]
                                ],
                                [
                                  "categoryValue",
                                  [
                                    "object/get",
                                    "@category",
                                    "value"
                                  ]
                                ],
                                [
                                  "w",
                                  [
                                    "-",
                                    "@maxWidth",
                                    [
                                      "*",
                                      "@i",
                                      "@widthStep"
                                    ]
                                  ]
                                ],
                                [
                                  "yTop",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@i",
                                        1.0
                                      ],
                                      "@tierHeight"
                                    ]
                                  ]
                                ],
                                [
                                  "x",
                                  [
                                    "-",
                                    "@centerX",
                                    [
                                      "/",
                                      "@w",
                                      2.0
                                    ]
                                  ]
                                ],
                                [
                                  "isCorrectCategory",
                                  [
                                    "==",
                                    "@categoryValue",
                                    "@entity.correctCategory"
                                  ]
                                ],
                                [
                                  "isSelectedCategory",
                                  [
                                    "==",
                                    "@categoryValue",
                                    "@entity.selectedCategory"
                                  ]
                                ],
                                [
                                  "fillColor",
                                  [
                                    "if",
                                    [
                                      "and",
                                      "@revealed",
                                      "@isCorrectCategory"
                                    ],
                                    "@config.correctColor",
                                    [
                                      "if",
                                      [
                                        "and",
                                        "@revealed",
                                        "@isSelectedCategory"
                                      ],
                                      "@config.incorrectColor",
                                      [
                                        "object/get",
                                        "@category",
                                        "color"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "color": "@fillColor",
                                "fill": "@fillColor",
                                "height": "@tierHeight",
                                "id": [
                                  "str/concat",
                                  "category-",
                                  "@i"
                                ],
                                "type": "rect",
                                "width": "@w",
                                "x": "@x",
                                "y": "@yTop"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "labels",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@categoryCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "category",
                                  [
                                    "array/nth",
                                    "@config.categories",
                                    "@i"
                                  ]
                                ],
                                [
                                  "yTop",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@i",
                                        1.0
                                      ],
                                      "@tierHeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "align": "center",
                                "color": "#0f172a",
                                "fontSize": 13.0,
                                "id": [
                                  "str/concat",
                                  "category-label-",
                                  "@i"
                                ],
                                "text": [
                                  "object/get",
                                  "@category",
                                  "label"
                                ],
                                "type": "text",
                                "x": "@centerX",
                                "y": [
                                  "+",
                                  "@yTop",
                                  [
                                    "/",
                                    "@tierHeight",
                                    2.0
                                  ],
                                  5.0
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "backdropShapes",
                        [
                          "array/concat",
                          "@rects",
                          "@labels"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.backdropShapes",
                        "@backdropShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
