                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "total",
                        [
                          "array/len",
                          "@config.items"
                        ]
                      ],
                      [
                        "nextIndex",
                        [
                          "if",
                          [
                            "<",
                            "@entity.itemIndex",
                            [
                              "-",
                              "@total",
                              1.0
                            ]
                          ],
                          [
                            "+",
                            "@entity.itemIndex",
                            1.0
                          ],
                          0.0
                        ]
                      ],
                      [
                        "item",
                        [
                          "array/nth",
                          "@config.items",
                          "@nextIndex"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.itemIndex",
                        "@nextIndex"
                      ],
                      [
                        "set",
                        "@entity.itemText",
                        [
                          "object/get",
                          "@item",
                          "text"
                        ]
                      ],
                      [
                        "set",
                        "@entity.correctCategory",
                        [
                          "object/get",
                          "@item",
                          "category"
                        ]
                      ],
                      [
                        "set",
                        "@entity.selectedCategory",
                        ""
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        ""
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "categoryCount",
                        [
                          "array/len",
                          "@config.categories"
                        ]
                      ],
                      [
                        "marginX",
                        30.0
                      ],
                      [
                        "marginY",
                        20.0
                      ],
                      [
                        "plotWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "*",
                            "@marginX",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotHeight",
                        [
                          "-",
                          "@config.height",
                          [
                            "*",
                            "@marginY",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          "@marginY"
                        ]
                      ],
                      [
                        "tierHeight",
                        [
                          "/",
                          "@plotHeight",
                          "@categoryCount"
                        ]
                      ],
                      [
                        "maxWidth",
                        [
                          "*",
                          "@plotWidth",
                          0.95
                        ]
                      ],
                      [
                        "minWidth",
                        [
                          "*",
                          "@plotWidth",
                          0.3
                        ]
                      ],
                      [
                        "widthStep",
                        [
                          "/",
                          [
                            "-",
                            "@maxWidth",
                            "@minWidth"
                          ],
                          [
                            "-",
                            "@categoryCount",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "centerX",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "revealed",
                        [
                          "!=",
                          "@entity.selectedCategory",
                          ""
                        ]
                      ],
                      [
                        "rects",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@categoryCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "category",
                                  [
                                    "array/nth",
                                    "@config.categories",
                                    "@i"
                                  ]
                                ],
                                [
                                  "categoryValue",
                                  [
                                    "object/get",
                                    "@category",
                                    "value"
                                  ]
                                ],
                                [
                                  "w",
                                  [
                                    "-",
                                    "@maxWidth",
                                    [
                                      "*",
                                      "@i",
                                      "@widthStep"
                                    ]
                                  ]
                                ],
                                [
                                  "yTop",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@i",
                                        1.0
                                      ],
                                      "@tierHeight"
                                    ]
                                  ]
                                ],
                                [
                                  "x",
                                  [
                                    "-",
                                    "@centerX",
                                    [
                                      "/",
                                      "@w",
                                      2.0
                                    ]
                                  ]
                                ],
                                [
                                  "isCorrectCategory",
                                  [
                                    "==",
                                    "@categoryValue",
                                    "@entity.correctCategory"
                                  ]
                                ],
                                [
                                  "isSelectedCategory",
                                  [
                                    "==",
                                    "@categoryValue",
                                    "@entity.selectedCategory"
                                  ]
                                ],
                                [
                                  "fillColor",
                                  [
                                    "if",
                                    [
                                      "and",
                                      "@revealed",
                                      "@isCorrectCategory"
                                    ],
                                    "@config.correctColor",
                                    [
                                      "if",
                                      [
                                        "and",
                                        "@revealed",
                                        "@isSelectedCategory"
                                      ],
                                      "@config.incorrectColor",
                                      [
                                        "object/get",
                                        "@category",
                                        "color"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "color": "@fillColor",
                                "fill": "@fillColor",
                                "height": "@tierHeight",
                                "id": [
                                  "str/concat",
                                  "category-",
                                  "@i"
                                ],
                                "type": "rect",
                                "width": "@w",
                                "x": "@x",
                                "y": "@yTop"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "labels",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@categoryCount"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "category",
                                  [
                                    "array/nth",
                                    "@config.categories",
                                    "@i"
                                  ]
                                ],
                                [
                                  "yTop",
                                  [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@i",
                                        1.0
                                      ],
                                      "@tierHeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "align": "center",
                                "color": "#0f172a",
                                "fontSize": 13.0,
                                "id": [
                                  "str/concat",
                                  "category-label-",
                                  "@i"
                                ],
                                "text": [
                                  "object/get",
                                  "@category",
                                  "label"
                                ],
                                "type": "text",
                                "x": "@centerX",
                                "y": [
                                  "+",
                                  "@yTop",
                                  [
                                    "/",
                                    "@tierHeight",
                                    2.0
                                  ],
                                  5.0
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "backdropShapes",
                        [
                          "array/concat",
                          "@rects",
                          "@labels"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.backdropShapes",
                        "@backdropShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "@entity.itemText",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": [],
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": [],
                              "shapes": "@entity.backdropShapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "array/reverse",
                                  "@config.categories"
                                ],
                                [
                                  "fn",
                                  "c",
                                  {
                                    "action": "PICK",
                                    "actionPayload": {
                                      "category": [
                                        "object/get",
                                        "@c",
                                        "value"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@c",
                                      "label"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.selectedCategory",
                                        [
                                          "object/get",
                                          "@c",
                                          "value"
                                        ]
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                {
                                  "action": "ADVANCE",
                                  "label": "@config.advanceLabel",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Score: ",
                                "@entity.correctCount",
                                "/",
                                "@entity.attemptedCount"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "CLASSIFY_UPDATED",
                    {
                      "attemptedCount": "@entity.attemptedCount",
                      "correctCount": "@entity.correctCount",
                      "itemIndex": "@entity.itemIndex",
                      "selectedCategory": "@entity.selectedCategory"
                    }
                  ]
                ],
                "event": "ADVANCE",
                "eventId": "evt_01KZEFWYXQVER741S1XP779QZ6",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}