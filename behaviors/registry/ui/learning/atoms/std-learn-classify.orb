                                        "category": [
                                          "object/get",
                                          "@c",
                                          "value"
                                        ]
                                      },
                                      "label": [
                                        "object/get",
                                        "@c",
                                        "label"
                                      ],
                                      "size": "sm",
                                      "type": "button",
                                      "variant": [
                                        "if",
                                        [
                                          "==",
                                          "@entity.selectedCategory",
                                          [
                                            "object/get",
                                            "@c",
                                            "value"
                                          ]
                                        ],
                                        "primary",
                                        "secondary"
                                      ]
                                    }
                                  ]
                                ]
                              ]
                            ],
                            "direction": "horizontal",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "children": [
                              "array/concat",
                              [
                                "if",
                                [
                                  "!=",
                                  "@entity.verdict",
                                  ""
                                ],
                                [
                                  {
                                    "label": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.verdict",
                                        "correct"
                                      ],
                                      "Correct",
                                      "Incorrect"
                                    ],
                                    "type": "badge",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.verdict",
                                        "correct"
                                      ],
                                      "success",
                                      "danger"
                                    ]
                                  }
                                ],
                                []
                              ],
                              [
                                {
                                  "content": "@entity.feedback",
                                  "type": "typography",
                                  "variant": "caption"
                                }
                              ]
                            ],
                            "direction": "horizontal",
                            "gap": "xs",
                            "type": "stack"
                          },
                          {
                            "children": [
                              {
                                "action": "ADVANCE",
                                "disabled": [
                                  "if",
                                  [
                                    "==",
                                    "@entity.selectedCategory",
                                    ""
                                  ],
                                  true,
                                  false
                                ],
                                "label": "@config.advanceLabel",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "TOGGLE_RUN",
                                "label": [
                                  "if",
                                  "@entity.running",
                                  "Pause",
                                  "Auto"
                                ],
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "label": [
                              "if",
                              [
                                ">",
                                "@config.passScore",
                                0.0
                              ],
                              [
                                "str/concat",
                                "Score — pass at ",
                                "@config.passScore"
                              ],
                              "Score"
                            ],
                            "max": [
                              "if",
                              [
                                "or",
                                [
                                  "!=",
                                  "@config.pointsPerCorrect",
                                  1.0
                                ],
                                [
                                  ">",
                                  "@config.penaltyPerMiss",
                                  0.0
                                ]
                              ],
                              [
                                "if",
                                [
                                  ">",
                                  "@config.scoreCap",
                                  0.0
                                ],
                                "@config.scoreCap",
                                [
                                  "*",
                                  "@entity.totalItems",
                                  "@config.pointsPerCorrect"
                                ]
                              ],
                              "@entity.attemptedCount"
                            ],
                            "type": "stat-display",
                            "value": [
                              "if",
                              [
                                "or",
                                [
                                  "!=",
                                  "@config.pointsPerCorrect",
                                  1.0
                                ],
                                [
                                  ">",
                                  "@config.penaltyPerMiss",
                                  0.0
                                ]
                              ],
                              "@entity.score",
                              "@entity.correctCount"
                            ]
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.backdropShapes",
                        "@backdropShapes"
                      ],
                      [
                        "set",
                        "@entity.roundView",
                        [
                          "if",
                          "@entity.roundComplete",
                          "@summaryView",
                          "@itemView"
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Item ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.itemIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.totalItems"
                                ]
                              ],
                              "max": "@entity.totalItems",
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.itemIndex",
                                1.0
                              ]
                            },
                            {
                              "children": "@entity.roundView",
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "CLASSIFY_UPDATED",
                    {
                      "attemptedCount": "@entity.attemptedCount",
                      "correctCount": "@entity.correctCount",
                      "itemIndex": "@entity.itemIndex",
                      "roundComplete": "@entity.roundComplete",
                      "selectedCategory": "@entity.selectedCategory",
                      "verdict": "@entity.verdict"
                    }
                  ]
                ],
                "event": "RETRY",
                "eventId": "evt_01M04B8VT5916MJXHS2FXZF6GQ",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.roundComplete",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.running",
                    [
                      "not",
                      "@entity.running"
                    ]
                  ],
                  [
                    "set",
                    "@entity.elapsedMs",
                    0.0
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Item ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.itemIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.totalItems"
                                ]
                              ],
                              "max": "@entity.totalItems",
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.itemIndex",
                                1.0
                              ]
                            },
                            {
                              "children": "@entity.roundView",
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "TOGGLE_RUN",
                "eventId": "evt_01M0C5Q7CX6XJDQZ9YRAZJGB0K",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "==",
                    "@entity.roundComplete",
                    false
                  ]
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.elapsedMs",
                  [
                    "+",
                    "@entity.elapsedMs",
                    32.0
                  ]
                ],
                [
                  "when",
                  [
                    ">=",
                    "@entity.elapsedMs",
                    "@config.advanceMs"
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.elapsedMs",
                      0.0
                    ],
                    [
                      "emit",
                      "ADVANCE",
                      {}
                    ]
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "==",
                    "@entity.roundComplete",
                    false
                  ]
                ]
              ],
              "interval": 32.0,
              "name": "advanceTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}