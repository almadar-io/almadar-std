              "type": "string"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "items": {
              "default": [
                {
                  "category": "a",
                  "explanation": "This example was written to satisfy category A's defining trait.",
                  "hint": "Consider what makes this belong to category A.",
                  "text": "Example item one."
                },
                {
                  "category": "b",
                  "explanation": "This example was written to satisfy category B's defining trait.",
                  "hint": "Consider what makes this belong to category B.",
                  "text": "Example item two."
                }
              ],
              "description": "Roster of items the learner classifies; each carries its prompt text, the value of its correct category, and optional hint/explanation text shown before/after the pick.",
