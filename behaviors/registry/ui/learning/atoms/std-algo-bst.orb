                    {
                      "count": "@entity.count",
                      "edges": "@entity.edges",
                      "narration": "@entity.narration",
                      "nodes": "@entity.nodes"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZNEYPGS7RC8NX9WQVPD6MCJ",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.nodes",
                    []
                  ],
                  [
                    "set",
                    "@entity.edges",
                    []
                  ],
