                    "@entity.depth",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.maxDepth",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.count",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.narration",
                    "Press Insert to add the next value; keep pressing to watch it descend."
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "INSERT_VALUE",
                                  "label": "Insert",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "DELETE_VALUE",
                                  "label": "Delete",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RUN_TRAVERSAL",
                                  "label": "Traverse",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "nodes": "@entity.nodes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "BST_UPDATED",
                    {
                      "count": "@entity.count",
                      "edges": "@entity.edges",
                      "narration": "@entity.narration",
                      "nodes": "@entity.nodes"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZNEYPGT37K0Z0EGZJTNJTQN",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "if",
                    [
                      "not",
                      "@entity.descending"
                    ],
                    [
                      "let",
                      [
                        [
                          "v",
                          [
                            "array/nth",
                            "@config.values",
                            "@entity.cursor"
                          ]
                        ]
                      ],
                      [
                        "if",
                        [
                          "==",
                          "@entity.count",
                          0.0
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.pending",
                            "@v"
                          ],
                          [
                            "set",
                            "@entity.nodes",
                            [
                              "array/append",
                              "@entity.nodes",
                              {
                                "color": "#3b82f6",
                                "id": "n0",
                                "kind": "cell",
                                "label": [
                                  "str/concat",
                                  "",
                                  "@v"
                                ],
                                "radius": 20.0,
                                "x": "@config.rootX",
                                "y": 60.0
                              }
                            ]
                          ],
                          [
                            "set",
                            "@entity.entries",
                            [
                              "array/append",
                              "@entity.entries",
                              {
                                "id": "n0",
                                "levelKey": "@config.rootX",
                                "path": "",
                                "value": "@v",
                                "x": "@config.rootX"
                              }
                            ]
                          ],
                          [
                            "set",
                            "@entity.count",
                            1.0
                          ],
                          [
                            "set",
                            "@entity.cursor",
                            1.0
                          ],
                          [
                            "set",
                            "@entity.narration",
                            [
                              "str/concat",
                              "insert ",
                              [
                                "str/concat",
                                "",
                                "@v"
                              ],
                              " — tree empty, becomes root",
                              [
                                "if",
                                "@config.balanced",
                                " · height 1 for 1 node",
                                ""
                              ]
                            ]
                          ]
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.pending",
                            "@v"
                          ],
                          [
                            "set",
                            "@entity.descending",
                            true
                          ],
                          [
                            "set",
                            "@entity.curId",
                            [
                              "object/get",
                              [
                                "array/first",
                                "@entity.entries"
                              ],
                              "id"
                            ]
                          ],
                          [
                            "set",
                            "@entity.curVal",
                            [
                              "object/get",
                              [
                                "array/first",
                                "@entity.entries"
                              ],
                              "value"
                            ]
                          ],
                          [
                            "set",
                            "@entity.curX",
                            "@config.rootX"
                          ],
                          [
                            "set",
                            "@entity.curOffset",
                            "@config.baseOffset"
                          ],
                          [
                            "set",
                            "@entity.depth",
                            0.0
                          ],
                          [
                            "set",
                            "@entity.cursor",
                            [
                              "+",
                              "@entity.cursor",
                              1.0
                            ]
                          ],
                          [
                            "set",
                            "@entity.narration",
                            [
                              "str/concat",
                              "insert ",
                              [
                                "str/concat",
                                "",
                                "@v"
                              ],
                              [
                                "if",
                                "@config.showComparisons",
                                " — compare at the root",
                                ""
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "side",
                          [
                            "if",
                            [
                              "<",
                              "@entity.pending",
                              "@entity.curVal"
                            ],
                            "L",
                            "R"
                          ]
                        ],
                        [
                          "child",
                          [
                            "array/find",
                            "@entity.edges",
                            [
                              "fn",
                              "e",
                              [
                                "and",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@e",
                                    "from"
                                  ],
                                  "@entity.curId"
                                ],
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@e",
                                    "label"
                                  ],
                                  "@side"
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "newX",
                          [
                            "if",
                            [
                              "==",
                              "@side",
                              "L"
                            ],
                            [
                              "-",
                              "@entity.curX",
                              "@entity.curOffset"
                            ],
                            [
                              "+",
                              "@entity.curX",
                              "@entity.curOffset"
                            ]
                          ]
                        ],
                        [
                          "newId",
                          [
                            "str/concat",
                            "n",
                            [
                              "str/concat",
                              "",
                              "@entity.count"
                            ]
                          ]
                        ],
                        [
                          "newDepth",
                          [
                            "+",
                            "@entity.depth",
                            1.0
                          ]
                        ],
                        [
                          "newCount",
                          [
                            "+",
                            "@entity.count",
                            1.0
                          ]
                        ],
                        [
                          "newMax",
                          [
                            "math/max",
                            "@entity.maxDepth",
                            "@newDepth"
                          ]
                        ],
                        [
                          "cmpText",
                          [
                            "str/concat",
                            [
                              "str/concat",
                              "",
                              "@entity.pending"
                            ],
                            [
                              "if",
                              [
                                "==",
                                "@side",
                                "L"
                              ],
                              " < ",
                              " >= "
                            ],
                            [
                              "str/concat",
                              "",
                              "@entity.curVal"
                            ]
                          ]
                        ]
                      ],
                      [
                        "if",
                        [
                          "==",
                          "@child",
                          null
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.narration",
                            [
                              "str/concat",
                              [
                                "if",
                                "@config.showComparisons",
                                [
                                  "str/concat",
                                  "@cmpText",
                                  " — "
                                ],
                                ""
                              ],
                              "attach ",
                              [
                                "str/concat",
                                "",
                                "@entity.pending"
                              ],
                              " as a leaf",
                              [
                                "if",
                                "@config.balanced",
                                [
                                  "str/concat",
                                  " · height ",
                                  [
                                    "str/concat",
                                    "",
                                    [
                                      "+",
                                      "@newMax",
                                      1.0
                                    ]
                                  ],
                                  " for ",
                                  [
                                    "str/concat",
                                    "",
                                    "@newCount"
                                  ],
                                  " nodes"
                                ],
                                ""
                              ]
                            ]
                          ],
                          [
                            "set",
                            "@entity.nodes",
                            [
                              "array/append",
                              "@entity.nodes",
                              {
                                "color": "#3b82f6",
                                "id": "@newId",
                                "kind": "cell",
                                "label": [
                                  "str/concat",
                                  "",
                                  "@entity.pending"
                                ],
                                "radius": 20.0,
                                "x": "@newX",
                                "y": [
                                  "+",
                                  60.0,
                                  [
                                    "*",
                                    "@newDepth",
                                    "@config.levelGap"
                                  ]
                                ]
                              }
                            ]
                          ],
                          [
                            "set",
                            "@entity.edges",
                            [
                              "array/append",
                              "@entity.edges",
                              {
                                "color": "#9ca3af",
                                "from": "@entity.curId",
                                "label": "@side",
                                "to": "@newId"
                              }
                            ]
                          ],
                          [
                            "set",
                            "@entity.entries",
                            [
                              "array/append",
                              "@entity.entries",
                              {
                                "id": "@newId",
                                "levelKey": [
                                  "+",
                                  [
                                    "*",
                                    "@newDepth",
                                    10000.0
                                  ],
                                  "@newX"
                                ],
                                "path": [
                                  "str/concat",
                                  [
                                    "object/get",
                                    [
                                      "array/find",
                                      "@entity.entries",
                                      [
                                        "fn",
                                        "t",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@t",
                                            "id"
                                          ],
                                          "@entity.curId"
                                        ]
                                      ]
                                    ],
                                    "path"
                                  ],
                                  "@side"
                                ],
                                "value": "@entity.pending",
                                "x": "@newX"
                              }
                            ]
                          ],
                          [
                            "set",
                            "@entity.count",
                            "@newCount"
                          ],
                          [
                            "set",
                            "@entity.maxDepth",
                            "@newMax"
                          ],
                          [
                            "set",
                            "@entity.descending",
                            false
                          ]
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.narration",
                            [
                              "str/concat",
                              [
                                "if",
                                "@config.showComparisons",
                                [
                                  "str/concat",
                                  "@cmpText",
                                  " — "
                                ],
                                ""
                              ],
                              "descend ",
                              [
                                "if",
                                [
                                  "==",
                                  "@side",
                                  "L"
                                ],
                                "left",
                                "right"
                              ]
                            ]
                          ],
                          [
                            "set",
                            "@entity.curId",
                            [
                              "object/get",
                              "@child",
                              "to"
                            ]
                          ],
                          [
                            "set",
                            "@entity.curVal",
                            [
                              "object/get",
                              [
                                "array/find",
                                "@entity.entries",
                                [
                                  "fn",
                                  "t",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@t",
                                      "id"
                                    ],
                                    [
                                      "object/get",
                                      "@child",
                                      "to"
                                    ]
                                  ]
                                ]
                              ],
                              "value"
                            ]
                          ],
                          [
                            "set",
                            "@entity.curX",
                            [
                              "object/get",
                              [
                                "array/find",
                                "@entity.entries",
                                [
                                  "fn",
                                  "t",
                                  [
