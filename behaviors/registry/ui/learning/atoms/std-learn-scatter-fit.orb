                              "x": "@config.axisXMin",
                              "y": [
                                "math/clamp",
                                "@newIntercept",
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            },
                            {
                              "x": "@config.axisXMax",
                              "y": [
                                "math/clamp",
                                [
                                  "+",
                                  [
                                    "*",
                                    "@newSlope",
                                    "@config.axisXMax"
                                  ],
                                  "@newIntercept"
                                ],
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        "residualCurves",
                        [
                          "if",
                          "@config.showResiduals",
                          [
                            "array/map",
                            "@pts",
                            [
                              "fn",
                              "p",
                              {
                                "color": "@config.residualColor",
                                "dash": "@config.residualDash",
                                "label": "",
                                "samples": [
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  },
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "+",
                                      [
                                        "*",
                                        "@newSlope",
                                        [
                                          "object/get",
                                          "@p",
                                          "x"
                                        ]
                                      ],
                                      "@newIntercept"
                                    ]
                                  }
                                ]
                              }
                            ]
                          ],
                          []
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.slope",
                        "@newSlope"
                      ],
                      [
                        "set",
                        "@entity.intercept",
                        "@newIntercept"
                      ],
                      [
                        "set",
                        "@entity.r",
                        "@newR"
                      ],
                      [
                        "set",
                        "@entity.rSquared",
                        [
