            "LearnScatterFitScene": "ent_01M0CGSNDK5PFW2WPK03YB701V"
          },
          "id": "trt_01M0CGSNDKZW4BAAQ48B923K0C",
          "linkedEntity": "LearnScatterFitScene",
          "linkedEntityId": "ent_01M0CGSNDK5PFW2WPK03YB701V",
          "name": "LearnScatterFitSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0CGSNDKG9JYEDATK8M75C4N",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M0CGSNDNBDW8469VPNX0HE2C",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01M0CGSNDNFVTB79M3560MKVB4",
                "key": "ADD_POINT",
                "name": "Add Point"
              },
              {
                "description": "A scatter point was dragged — id names the point, x/y its new coordinates (clamped to the axis ranges); the fit recomputes live.",
                "id": "evt_01M0CGSNDNYV2VV7N4281G3X6X",
                "key": "DRAG_POINT",
                "name": "Drag Point",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged a guess-the-line slider — param is slope or intercept; the guess is scored against the least-squares fit.",
                "id": "evt_01M0CGSNDNWS2K4R391QPXQYFG",
                "key": "GUESS_LINE",
                "name": "Guess Line",
                "payloadSchema": [
                  {
                    "name": "param",
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01M0CGSNDN7W9T6E8N52B3FT19",
                "key": "REVEAL_FIT",
                "name": "Reveal Fit"
              },
              {
                "id": "evt_01M0CGSNDN9PCGWDRC046WE6AB",
                "key": "TOGGLE_RUN",
                "name": "Toggle Run"
              },
              {
                "id": "evt_01M0CGSNDN1VCP026JN2M802CH",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The least-squares fit and narration after each learner action, auto-add tick, or reset — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M0CGSNDNRJ5SEN6M870GKYWG",
                "key": "LEARN_SCATTER_FIT_UPDATED",
                "name": "Learn Scatter Fit Updated",
                "payloadSchema": [
                  {
                    "name": "slope",
                    "type": "number"
                  },
                  {
                    "name": "intercept",
                    "type": "number"
                  },
                  {
                    "name": "r",
                    "type": "number"
                  },
                  {
                    "name": "rSquared",
                    "type": "number"
                  },
                  {
                    "name": "pointCount",
                    "type": "number"
                  },
                  {
                    "name": "narration",
                    "type": "string"
                  }
                ],
                "synonyms": "fit update, line of best fit, slope, intercept, correlation, r squared",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.points",
                    "@config.initialPoints"
                  ],
                  [
                    "set",
                    "@entity.guessSlope",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.guessIntercept",
                    [
                      "/",
                      [
                        "+",
                        "@config.axisYMin",
                        "@config.axisYMax"
                      ],
                      2.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.revealed",
                    false
                  ],
                  [
                    "set",
                    "@entity.running",
                    "@config.autoRun"
                  ],
                  [
                    "let",
                    [
                      [
                        "pts",
                        "@config.initialPoints"
                      ],
                      [
                        "n",
                        [
                          "array/len",
                          "@pts"
                        ]
                      ],
                      [
                        "meanX",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "meanY",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "sxx",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "@meanX"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dx",
                                  "@dx"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "syy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dy",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ],
                                    "@meanY"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dy",
                                  "@dy"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "sxy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "+",
                              "@acc",
                              [
                                "*",
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ],
                                  "@meanX"
                                ],
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ],
                                  "@meanY"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "newSlope",
                        [
                          "if",
                          [
                            ">",
                            "@sxx",
                            0.0
                          ],
                          [
                            "/",
                            "@sxy",
                            "@sxx"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "newIntercept",
                        [
                          "-",
                          "@meanY",
                          [
                            "*",
                            "@newSlope",
                            "@meanX"
                          ]
                        ]
                      ],
                      [
                        "newR",
                        [
                          "if",
                          [
                            "and",
                            [
                              ">",
                              "@sxx",
                              0.0
                            ],
                            [
                              ">",
                              "@syy",
                              0.0
                            ]
                          ],
                          [
                            "/",
                            "@sxy",
                            [
                              "math/sqrt",
                              [
                                "*",
                                "@sxx",
                                "@syy"
                              ]
                            ]
                          ],
                          0.0
                        ]
                      ],
                      [
                        "fitCurve",
                        {
                          "color": "@config.fitColor",
                          "label": "@config.fitLabel",
                          "samples": [
                            {
                              "x": "@config.axisXMin",
                              "y": [
                                "math/clamp",
                                "@newIntercept",
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            },
                            {
                              "x": "@config.axisXMax",
                              "y": [
                                "math/clamp",
                                [
                                  "+",
                                  [
                                    "*",
                                    "@newSlope",
                                    "@config.axisXMax"
                                  ],
                                  "@newIntercept"
                                ],
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        "residualCurves",
                        [
                          "if",
                          "@config.showResiduals",
                          [
                            "array/map",
                            "@pts",
                            [
                              "fn",
                              "p",
                              {
                                "color": "@config.residualColor",
                                "dash": "@config.residualDash",
                                "label": "",
                                "samples": [
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  },
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "+",
                                      [
                                        "*",
                                        "@newSlope",
                                        [
                                          "object/get",
                                          "@p",
                                          "x"
                                        ]
                                      ],
                                      "@newIntercept"
                                    ]
                                  }
                                ]
                              }
                            ]
                          ],
                          []
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.slope",
                        "@newSlope"
                      ],
                      [
                        "set",
                        "@entity.intercept",
                        "@newIntercept"
                      ],
                      [
                        "set",
                        "@entity.r",
                        "@newR"
                      ],
                      [
                        "set",
                        "@entity.rSquared",
                        [
                          "*",
                          "@newR",
                          "@newR"
                        ]
                      ],
                      [
                        "set",
                        "@entity.guessScore",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          "array/concat",
                          [
                            "array/append",
                            [],
                            "@fitCurve"
                          ],
                          "@residualCurves"
                        ]
                      ],
                      [
                        "set",
                        "@entity.done",
                        [
                          ">=",
                          "@n",
                          "@config.maxPoints"
                        ]
                      ],
                      [
                        "set",
                        "@entity.narration",
                        [
                          "str/concat",
                          [
                            "str/concat",
                            "",
                            "@n"
                          ],
                          " ",
                          "@config.narrationLoadedTemplate",
                          " — r = ",
                          [
                            "str/concat",
                            "",
                            [
                              "math/round",
                              "@newR",
                              3.0
                            ]
                          ],
                          ", R² = ",
                          [
                            "str/concat",
                            "",
                            [
                              "math/round",
                              [
                                "*",
                                "@newR",
                                "@newR"
                              ],
                              3.0
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "ADD_POINT",
                                  "label": "@config.addPointLabel",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "REVEAL_FIT",
                                  "label": "@config.revealLabel",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "TOGGLE_RUN",
                                  "label": [
                                    "if",
                                    "@entity.running",
                                    "@config.pauseLabel",
                                    "@config.runLabel"
                                  ],
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "@config.resetLabel",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@config.guessSlopeCaption",
                                [
                                  "math/round",
                                  "@entity.guessSlope",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "GUESS_LINE",
                              "actionPayload": {
                                "param": "slope"
                              },
                              "max": "@config.guessSlopeMax",
                              "min": "@config.guessSlopeMin",
                              "showTooltip": true,
                              "step": "@config.guessSlopeStep",
                              "type": "range-slider",
                              "value": "@entity.guessSlope"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@config.guessInterceptCaption",
                                [
                                  "math/round",
                                  "@entity.guessIntercept",
                                  1.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "GUESS_LINE",
                              "actionPayload": {
                                "param": "intercept"
                              },
                              "max": "@config.guessInterceptMax",
                              "min": "@config.guessInterceptMin",
                              "showTooltip": true,
                              "step": "@config.guessInterceptStep",
                              "type": "range-slider",
                              "value": "@entity.guessIntercept"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": "@entity.points",
                              "showAxes": "@config.showAxes",
                              "showGrid": "@config.showGrid",
                              "showTickLabels": "@config.showTickLabels",
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.axisXMax",
                              "xMin": "@config.axisXMin",
                              "yMax": "@config.axisYMax",
                              "yMin": "@config.axisYMin"
                            },
                            {
                              "content": [
                                "if",
                                "@config.showR",
                                [
                                  "str/concat",
                                  "r = ",
                                  [
                                    "math/round",
                                    "@entity.r",
                                    3.0
                                  ],
                                  " — R² = ",
                                  [
                                    "math/round",
                                    "@entity.rSquared",
                                    3.0
                                  ],
                                  " — guess score ",
                                  "@entity.guessScore",
                                  "%"
                                ],
                                ""
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
