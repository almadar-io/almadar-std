                              {
                                "action": "RESET",
                                "label": "@config.resetLabel",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "content": [
                              "str/concat",
                              "@config.guessSlopeCaption",
                              [
                                "math/round",
                                "@entity.guessSlope",
                                2.0
                              ]
                            ],
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "action": "GUESS_LINE",
                            "actionPayload": {
                              "param": "slope"
                            },
                            "max": "@config.guessSlopeMax",
                            "min": "@config.guessSlopeMin",
                            "showTooltip": true,
                            "step": "@config.guessSlopeStep",
                            "type": "range-slider",
                            "value": "@entity.guessSlope"
                          },
                          {
                            "content": [
                              "str/concat",
                              "@config.guessInterceptCaption",
                              [
                                "math/round",
                                "@entity.guessIntercept",
                                1.0
                              ]
                            ],
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "action": "GUESS_LINE",
                            "actionPayload": {
                              "param": "intercept"
                            },
                            "max": "@config.guessInterceptMax",
                            "min": "@config.guessInterceptMin",
                            "showTooltip": true,
                            "step": "@config.guessInterceptStep",
                            "type": "range-slider",
                            "value": "@entity.guessIntercept"
                          },
                          {
                            "animate": "@config.animate",
                            "curves": "@entity.curves",
                            "gridStep": "@config.gridStep",
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": "@entity.points",
                            "showAxes": "@config.showAxes",
                            "showGrid": "@config.showGrid",
                            "showTickLabels": "@config.showTickLabels",
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": "@config.axisXMax",
                            "xMin": "@config.axisXMin",
                            "yMax": "@config.axisYMax",
                            "yMin": "@config.axisYMin"
                          },
                          {
                            "content": [
                              "if",
                              "@config.showR",
                              [
                                "str/concat",
                                "r = ",
                                [
                                  "math/round",
                                  "@entity.r",
                                  3.0
                                ],
                                " — R² = ",
                                [
                                  "math/round",
                                  "@entity.rSquared",
                                  3.0
                                ],
                                " — guess score ",
                                "@entity.guessScore",
                                "%"
                              ],
                              ""
                            ],
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "content": "@entity.narration",
                            "type": "typography",
                            "variant": "body"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ],
                [
                  "emit",
                  "LEARN_SCATTER_FIT_UPDATED",
                  {
                    "intercept": "@entity.intercept",
                    "narration": "@entity.narration",
                    "pointCount": [
                      "array/len",
                      "@entity.points"
                    ],
                    "r": "@entity.r",
                    "rSquared": "@entity.rSquared",
                    "slope": "@entity.slope"
                  }
                ]
              ],
              "guard": [
                "and",
                "@entity.active",
                [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ]
              ],
              "interval": 600.0,
              "name": "scatterFitTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}