                                ""
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "LEARN_SCATTER_FIT_UPDATED",
                    {
                      "intercept": "@entity.intercept",
                      "narration": "@entity.narration",
                      "pointCount": [
                        "array/len",
                        "@entity.points"
                      ],
                      "r": "@entity.r",
                      "rSquared": "@entity.rSquared",
                      "slope": "@entity.slope"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01M0CGSNDNBDW8469VPNX0HE2C",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "marginX",
                        [
                          "*",
                          [
                            "-",
                            "@config.axisXMax",
                            "@config.axisXMin"
                          ],
                          "@config.pointMarginPct"
                        ]
                      ],
                      [
                        "usableX",
                        [
                          "-",
                          [
                            "-",
                            "@config.axisXMax",
                            "@config.axisXMin"
                          ],
                          [
                            "*",
                            "@marginX",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "marginY",
                        [
                          "*",
                          [
                            "-",
                            "@config.axisYMax",
                            "@config.axisYMin"
                          ],
                          "@config.pointMarginPct"
                        ]
                      ],
                      [
                        "usableY",
                        [
                          "-",
                          [
                            "-",
                            "@config.axisYMax",
                            "@config.axisYMin"
                          ],
                          [
                            "*",
                            "@marginY",
                            2.0
                          ]
                        ]
                      ],
                      [
                        "newPoint",
                        {
                          "color": "@config.newPointColor",
                          "id": [
                            "str/concat",
                            "p",
                            [
                              "array/len",
                              "@entity.points"
                            ]
                          ],
                          "label": "",
                          "radius": "@config.newPointRadius",
                          "x": [
                            "math/round",
                            [
                              "+",
                              "@config.axisXMin",
                              [
                                "+",
                                "@marginX",
                                [
                                  "*",
                                  [
                                    "math/random"
                                  ],
                                  "@usableX"
                                ]
                              ]
                            ]
                          ],
                          "y": [
                            "math/round",
                            [
                              "+",
                              "@config.axisYMin",
                              [
                                "+",
                                "@marginY",
                                [
                                  "*",
                                  [
                                    "math/random"
                                  ],
                                  "@usableY"
                                ]
                              ]
                            ]
                          ]
                        }
                      ],
                      [
                        "pts",
                        [
                          "array/append",
                          "@entity.points",
                          "@newPoint"
                        ]
                      ],
                      [
                        "n",
                        [
                          "array/len",
                          "@pts"
                        ]
                      ],
                      [
                        "meanX",
                        [
                          "/",
                          [
                            "array/reduce",
                            "@pts",
                            0.0,
                            [
                              "fn",
                              [
                                "acc",
                                "p"
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "object/get",
                                  "@p",
                                  "x"
                                ]
                              ]
                            ]
                          ],
                          "@n"
                        ]
                      ],
                      [
                        "meanY",
                        [
                          "/",
                          [
                            "array/reduce",
                            "@pts",
                            0.0,
                            [
                              "fn",
                              [
                                "acc",
                                "p"
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "object/get",
                                  "@p",
                                  "y"
                                ]
                              ]
                            ]
                          ],
                          "@n"
                        ]
                      ],
                      [
                        "sxx",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "@meanX"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dx",
                                  "@dx"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "syy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dy",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ],
                                    "@meanY"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dy",
                                  "@dy"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "sxy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "+",
                              "@acc",
                              [
                                "*",
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ],
                                  "@meanX"
                                ],
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ],
                                  "@meanY"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "newSlope",
                        [
                          "if",
                          [
                            ">",
                            "@sxx",
                            0.0
                          ],
                          [
                            "/",
                            "@sxy",
                            "@sxx"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "newIntercept",
                        [
                          "-",
                          "@meanY",
                          [
                            "*",
                            "@newSlope",
                            "@meanX"
                          ]
                        ]
                      ],
                      [
                        "newR",
                        [
                          "if",
                          [
                            "and",
                            [
                              ">",
                              "@sxx",
                              0.0
                            ],
                            [
                              ">",
                              "@syy",
                              0.0
                            ]
                          ],
                          [
                            "/",
                            "@sxy",
                            [
                              "math/sqrt",
                              [
                                "*",
                                "@sxx",
                                "@syy"
                              ]
                            ]
                          ],
                          0.0
                        ]
                      ],
                      [
                        "fitCurve",
                        {
                          "color": "@config.fitColor",
                          "label": "@config.fitLabel",
                          "samples": [
                            {
                              "x": "@config.axisXMin",
