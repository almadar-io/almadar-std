                                [
                                  "+",
                                  [
                                    "*",
                                    "@newSlope",
                                    "@config.axisXMax"
                                  ],
                                  "@newIntercept"
                                ],
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        "guessCurve",
                        {
                          "color": "@config.guessColor",
                          "label": "@config.guessLabel",
                          "samples": [
                            {
                              "x": "@config.axisXMin",
                              "y": [
                                "math/clamp",
                                "@entity.guessIntercept",
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            },
                            {
                              "x": "@config.axisXMax",
                              "y": [
                                "math/clamp",
                                [
                                  "+",
                                  [
                                    "*",
                                    "@entity.guessSlope",
                                    "@config.axisXMax"
                                  ],
                                  "@entity.guessIntercept"
                                ],
                                "@config.axisYMin",
                                "@config.axisYMax"
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        "residualCurves",
                        [
                          "if",
                          "@config.showResiduals",
                          [
                            "array/map",
                            "@pts",
                            [
                              "fn",
                              "p",
                              {
                                "color": "@config.residualColor",
                                "dash": "@config.residualDash",
                                "label": "",
                                "samples": [
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  },
                                  {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "+",
                                      [
                                        "*",
                                        "@newSlope",
                                        [
                                          "object/get",
                                          "@p",
                                          "x"
                                        ]
                                      ],
                                      "@newIntercept"
                                    ]
                                  }
                                ]
                              }
                            ]
                          ],
                          []
                        ]
                      ],
                      [
                        "baseCurves",
                        [
                          "if",
                          [
                            "and",
                            "@config.guessMode",
                            [
                              "not",
                              "@entity.revealed"
                            ]
                          ],
                          [
                            "array/append",
                            [],
                            "@guessCurve"
                          ],
                          [
                            "if",
                            "@config.guessMode",
                            [
                              "array/append",
                              [
                                "array/append",
                                [],
                                "@guessCurve"
                              ],
                              "@fitCurve"
                            ],
                            [
                              "array/append",
                              [],
                              "@fitCurve"
                            ]
                          ]
                        ]
                      ],
                      [
                        "nowDone",
                        [
                          ">=",
                          "@n",
                          "@config.maxPoints"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.points",
                        "@pts"
                      ],
                      [
                        "set",
                        "@entity.slope",
                        "@newSlope"
                      ],
                      [
                        "set",
                        "@entity.intercept",
                        "@newIntercept"
                      ],
                      [
                        "set",
                        "@entity.r",
                        "@newR"
                      ],
                      [
                        "set",
                        "@entity.rSquared",
                        [
                          "*",
                          "@newR",
                          "@newR"
                        ]
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          "array/concat",
                          "@baseCurves",
                          "@residualCurves"
                        ]
                      ],
                      [
                        "set",
                        "@entity.done",
                        "@nowDone"
                      ],
                      [
                        "set",
                        "@entity.narration",
                        [
                          "str/concat",
                          "@config.narrationAddedTemplate",
                          " ",
                          [
                            "str/concat",
                            "",
                            "@n"
                          ],
                          " — r = ",
                          [
                            "str/concat",
                            "",
                            [
                              "math/round",
                              "@newR",
                              3.0
                            ]
                          ],
                          ", R² = ",
                          [
                            "str/concat",
                            "",
                            [
                              "math/round",
                              [
                                "*",
                                "@newR",
                                "@newR"
                              ],
                              3.0
                            ]
                          ],
                          [
                            "if",
                            "@nowDone",
                            "@config.narrationMaxReachedSuffix",
                            ""
                          ]
                        ]
                      ]
                    ]
