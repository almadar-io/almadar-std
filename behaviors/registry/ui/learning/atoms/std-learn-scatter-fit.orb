                            },
                            {
                              "content": [
                                "if",
                                "@config.showR",
                                [
                                  "str/concat",
                                  "r = ",
                                  [
                                    "math/round",
                                    "@entity.r",
                                    3.0
                                  ],
                                  " — R² = ",
                                  [
                                    "math/round",
                                    "@entity.rSquared",
                                    3.0
                                  ],
                                  " — guess score ",
                                  "@entity.guessScore",
                                  "%"
