                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "HASH_UPDATED",
                    {
                      "buckets": "@entity.buckets",
                      "collisions": "@entity.collisions",
                      "inserted": "@entity.inserted",
                      "narration": "@entity.narration",
                      "size": "@entity.size"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZNEYPG9FWG39SR1CH1XFBMF",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.buckets",
                    "@config.buckets"
                  ],
                  [
                    "set",
                    "@entity.cursor",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.inserted",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.collisions",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.size",
                    "@config.tableSize"
                  ],
                  [
                    "set",
                    "@entity.narration",
                    "Press Insert to hash the next key into the table."
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "INSERT_KEY",
                                  "label": "Insert",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "DELETE_KEY",
                                  "label": "Delete",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "REHASH",
                                  "label": "Rehash",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "bars": "@entity.buckets",
                              "height": "@config.height",
                              "type": "algorithm-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "HASH_UPDATED",
                    {
                      "buckets": "@entity.buckets",
                      "collisions": "@entity.collisions",
                      "inserted": "@entity.inserted",
                      "narration": "@entity.narration",
                      "size": "@entity.size"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZNEYPGAMY5D2D3ECGX1W1A3",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "key",
                        [
                          "array/nth",
                          "@config.keys",
                          "@entity.cursor"
                        ]
                      ],
                      [
                        "home",
                        [
                          "if",
                          [
                            "==",
                            "@config.hashFunction",
                            "midsquare"
                          ],
                          [
                            "math/mod",
                            [
                              "math/floor",
                              [
                                "/",
                                [
                                  "*",
                                  "@key",
                                  "@key"
                                ],
                                10.0
                              ]
                            ],
                            "@entity.size"
                          ],
                          [
                            "math/mod",
                            "@key",
                            "@entity.size"
                          ]
                        ]
                      ],
                      [
                        "occupied",
                        [
                          "!=",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@entity.buckets",
                              "@home"
                            ],
                            "label"
                          ],
                          ""
                        ]
                      ],
                      [
                        "target",
                        [
                          "if",
                          [
                            "and",
                            "@occupied",
                            [
                              "==",
                              "@config.collisionStrategy",
                              "probe"
                            ]
                          ],
                          [
                            "math/mod",
                            [
                              "+",
                              "@home",
                              1.0
                            ],
                            "@entity.size"
                          ],
                          "@home"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.cursor",
                        [
                          "+",
                          "@entity.cursor",
                          1.0
                        ]
                      ],
                      [
                        "set",
                        "@entity.inserted",
                        [
                          "+",
                          "@entity.inserted",
                          1.0
                        ]
                      ],
                      [
                        "set",
                        "@entity.collisions",
                        [
                          "+",
                          "@entity.collisions",
                          [
                            "if",
                            "@occupied",
                            1.0,
                            0.0
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.buckets",
                        [
                          "array/map",
                          "@entity.buckets",
                          [
                            "if",
                            [
                              "==",
                              "@index",
                              "@target"
                            ],
                            [
                              "object/merge",
                              "@item",
                              {
