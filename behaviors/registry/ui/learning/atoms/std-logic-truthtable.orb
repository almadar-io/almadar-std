          },
          "id": "trt_01KZEFY7Q8M3PVFE8G3C1JCP1A",
          "linkedEntity": "LogicTruthTableScene",
          "linkedEntityId": "ent_01KZEFY7Q8V9WJ1EKB0S435VM7",
          "name": "LogicTruthTableSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFY7Q8P9BWNBVD4EN9GCPC",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFY7Q9T0N9TTQFMNY5K0F6",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed the P toggle button to flip proposition P's truth value.",
                "id": "evt_01KZEFY7Q90WY0FGKA8RSTRP77",
                "key": "TOGGLE_P",
                "name": "Toggle P",
                "tier": "domain"
              },
              {
                "description": "Learner pressed the Q toggle button to flip proposition Q's truth value.",
                "id": "evt_01KZEFY7Q92DBF4EMKFXBAWPTW",
                "key": "TOGGLE_Q",
                "name": "Toggle Q",
                "tier": "domain"
              },
              {
                "description": "Learner pressed the R toggle button to flip proposition R's truth value.",
                "id": "evt_01KZEFY7Q95CNNQPFCNW0ND2D0",
                "key": "TOGGLE_R",
                "name": "Toggle R",
                "tier": "domain"
              },
              {
                "description": "The proposition assignment after each learner toggle — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFY7Q96DPQGSTD4ZCG4VAD",
                "key": "TRUTHTABLE_UPDATED",
                "name": "Truthtable Updated",
                "payloadSchema": [
                  {
                    "name": "valP",
                    "type": "boolean"
                  },
                  {
                    "name": "valQ",
                    "type": "boolean"
                  },
                  {
                    "name": "valR",
                    "type": "boolean"
                  }
                ],
                "synonyms": "truth table update, proposition toggle, truth value change",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.valP",
                    "@config.initialP"
                  ],
                  [
                    "set",
                    "@entity.valQ",
                    "@config.initialQ"
                  ],
                  [
                    "set",
                    "@entity.valR",
                    "@config.initialR"
                  ],
                  [
                    "let",
                    [
                      [
                        "combos",
                        [
                          {
                            "p": false,
                            "q": false,
                            "r": false
                          },
                          {
                            "p": false,
                            "q": false,
                            "r": true
                          },
                          {
                            "p": false,
                            "q": true,
                            "r": false
                          },
                          {
                            "p": false,
                            "q": true,
                            "r": true
                          },
                          {
                            "p": true,
                            "q": false,
                            "r": false
                          },
                          {
                            "p": true,
                            "q": false,
                            "r": true
                          },
                          {
                            "p": true,
                            "q": true,
                            "r": false
                          },
                          {
                            "p": true,
                            "q": true,
                            "r": true
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.tableRows",
                        [
                          "array/map",
                          "@combos",
                          [
                            "fn",
                            "row",
                            {
                              "cells": [
                                "array/map",
                                "@config.formulas",
                                [
                                  "fn",
                                  "f",
                                  [
                                    "let",
                                    [
                                      [
                                        "lv",
                                        [
                                          "if",
                                          [
                                            "==",
                                            "@f.left",
                                            "P"
                                          ],
                                          "@row.p",
                                          [
                                            "if",
                                            [
                                              "==",
                                              "@f.left",
                                              "Q"
                                            ],
                                            "@row.q",
                                            "@row.r"
                                          ]
                                        ]
                                      ],
                                      [
                                        "rv",
                                        [
                                          "if",
                                          [
                                            "==",
                                            "@f.kind",
                                            "NOT"
                                          ],
                                          false,
                                          [
                                            "if",
                                            [
                                              "==",
                                              "@f.right",
                                              "P"
                                            ],
                                            "@row.p",
                                            [
                                              "if",
                                              [
                                                "==",
                                                "@f.right",
                                                "Q"
                                              ],
                                              "@row.q",
                                              "@row.r"
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        "val",
                                        [
                                          "if",
                                          [
                                            "==",
                                            "@f.kind",
                                            "AND"
                                          ],
                                          [
                                            "and",
                                            "@lv",
                                            "@rv"
                                          ],
                                          [
                                            "if",
                                            [
                                              "==",
                                              "@f.kind",
                                              "OR"
                                            ],
                                            [
                                              "or",
                                              "@lv",
                                              "@rv"
                                            ],
                                            [
                                              "if",
                                              [
                                                "==",
                                                "@f.kind",
                                                "NOT"
                                              ],
                                              [
                                                "not",
                                                "@lv"
                                              ],
                                              [
                                                "or",
                                                [
                                                  "not",
                                                  "@lv"
                                                ],
                                                "@rv"
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ],
                                    {
                                      "label": "@f.label",
                                      "value": "@val"
                                    }
                                  ]
                                ]
                              ],
                              "isCurrent": [
                                "and",
                                [
                                  "==",
                                  "@row.p",
                                  "@entity.valP"
                                ],
                                [
                                  "==",
                                  "@row.q",
                                  "@entity.valQ"
                                ],
                                [
                                  "==",
                                  "@row.r",
                                  "@entity.valR"
                                ]
                              ],
                              "p": "@row.p",
                              "q": "@row.q",
                              "r": "@row.r"
                            }
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.renderChildren",
                    [
                      {
                        "content": "@entity.title",
                        "type": "typography",
                        "variant": "h4"
                      },
                      {
                        "content": "Toggle the propositions and watch the compound formulas evaluate live.",
                        "type": "typography",
                        "variant": "body"
                      },
                      {
                        "children": [
                          {
                            "action": "TOGGLE_P",
                            "label": [
                              "str/concat",
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  0.0
                                ],
                                "label"
                              ],
                              " = ",
                              [
                                "if",
                                "@entity.valP",
                                "T",
                                "F"
                              ]
                            ],
                            "type": "button",
                            "variant": [
                              "if",
                              "@entity.valP",
                              "success",
                              "secondary"
                            ]
                          },
                          {
                            "action": "TOGGLE_Q",
                            "label": [
                              "str/concat",
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  1.0
                                ],
                                "label"
                              ],
                              " = ",
                              [
                                "if",
                                "@entity.valQ",
                                "T",
                                "F"
                              ]
                            ],
                            "type": "button",
                            "variant": [
                              "if",
                              "@entity.valQ",
                              "success",
                              "secondary"
                            ]
                          },
                          {
                            "action": "TOGGLE_R",
                            "label": [
                              "str/concat",
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  2.0
                                ],
                                "label"
                              ],
                              " = ",
                              [
                                "if",
                                "@entity.valR",
                                "T",
                                "F"
                              ]
                            ],
                            "type": "button",
                            "variant": [
                              "if",
                              "@entity.valR",
                              "success",
                              "secondary"
                            ]
                          }
                        ],
                        "direction": "horizontal",
                        "gap": "sm",
                        "type": "stack"
                      },
                      {
                        "children": [
                          "array/concat",
                          [
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  0.0
                                ],
                                "label"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  1.0
                                ],
                                "label"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.propositions",
                                  2.0
                                ],
                                "label"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          [
                            "array/map",
                            "@config.formulas",
                            [
                              "fn",
                              "f",
                              {
                                "content": "@f.label",
                                "type": "typography",
                                "variant": "caption"
                              }
                            ]
                          ]
                        ],
                        "direction": "horizontal",
                        "gap": "xs",
                        "type": "stack"
                      },
                      {
                        "children": [
                          "array/map",
                          "@entity.tableRows",
                          [
                            "fn",
                            "row",
                            {
                              "bg": [
                                "if",
                                "@row.isCurrent",
                                "accent",
                                "transparent"
                              ],
                              "border": "@row.isCurrent",
                              "children": [
                                {
                                  "children": [
                                    "array/concat",
                                    [
                                      {
                                        "label": [
                                          "if",
                                          "@row.p",
                                          "T",
                                          "F"
                                        ],
                                        "type": "badge",
                                        "variant": [
                                          "if",
                                          "@row.p",
                                          "success",
                                          "danger"
                                        ]
                                      },
                                      {
                                        "label": [
                                          "if",
                                          "@row.q",
                                          "T",
                                          "F"
                                        ],
                                        "type": "badge",
                                        "variant": [
                                          "if",
                                          "@row.q",
                                          "success",
                                          "danger"
                                        ]
                                      },
                                      {
                                        "label": [
                                          "if",
                                          "@row.r",
                                          "T",
                                          "F"
                                        ],
                                        "type": "badge",
                                        "variant": [
                                          "if",
                                          "@row.r",
                                          "success",
                                          "danger"
                                        ]
                                      }
                                    ],
                                    [
                                      "array/map",
                                      "@row.cells",
                                      [
                                        "fn",
                                        "c",
                                        {
                                          "label": [
                                            "if",
                                            "@c.value",
                                            "T",
                                            "F"
                                          ],
                                          "type": "badge",
                                          "variant": [
                                            "if",
                                            "@c.value",
                                            "success",
                                            "danger"
                                          ]
                                        }
                                      ]
                                    ]
                                  ],
                                  "direction": "horizontal",
                                  "gap": "xs",
                                  "type": "stack"
                                }
                              ],
                              "padding": "sm",
                              "type": "box"
                            }
                          ]
                        ],
