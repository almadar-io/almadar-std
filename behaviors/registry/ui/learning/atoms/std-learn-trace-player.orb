                    "@entity.frameIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.running",
                    false
                  ],
                  [
                    "set",
                    "@entity.statusNote",
                    "Paused"
                  ],
                  [
                    "set",
                    "@entity.frameLabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.frames",
                        "@entity.frameIndex"
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.frameCaption",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.frames",
                        "@entity.frameIndex"
                      ],
                      "caption"
