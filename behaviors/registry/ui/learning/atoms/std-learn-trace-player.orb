                "id": "evt_01M055GQ610QS6TW851N356EQ0",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ62P0G7TCNBQ7WTTSZD",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Play — the frame cursor begins advancing on the tick until the last frame is reached or Pause is pressed.",
                "id": "evt_01M055GQ62B00NKC2P41ZHMYTR",
                "key": "PLAY",
                "name": "Play",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Pause — the frame cursor freezes at its current position.",
                "id": "evt_01M055GQ62T1PP5X8K4TSKV435",
                "key": "PAUSE",
                "name": "Pause",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Restart — the frame cursor rewinds to the first frame and playback stops.",
                "id": "evt_01M055GQ62396FYW3JJY0GYDWK",
                "key": "RESTART",
                "name": "Restart",
                "tier": "domain"
              },
              {
                "description": "The current frame cursor after Play/Pause/Restart or a tick step — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ621B6F36GVGT5Y62B9",
                "key": "FRAME_ADVANCED",
                "name": "Frame Advanced",
                "payloadSchema": [
                  {
                    "name": "frameIndex",
                    "type": "number"
                  },
                  {
                    "name": "frameLabel",
                    "type": "string"
                  }
                ],
                "synonyms": "frame update, tick, step, trace advance",
                "tier": "domain"
              },
              {
                "description": "The trace reached its last frame and loop is off, so autoplay stopped on its own — fires once per completed pass.",
                "id": "evt_01M055GQ62V8X5RFJ3395R90S1",
                "key": "TRACE_DONE",
                "name": "Trace Done",
                "payloadSchema": [
                  {
                    "name": "totalFrames",
                    "type": "number"
                  }
                ],
                "synonyms": "playback complete, sequence finished, trace end",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.frameIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.running",
                    false
                  ],
                  [
                    "set",
                    "@entity.statusNote",
                    "Paused"
                  ],
                  [
                    "set",
                    "@entity.frameLabel",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.frames",
                        "@entity.frameIndex"
                      ],
                      "label"
                    ]
                  ],
                  [
                    "set",
                    "@entity.frameCaption",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@config.frames",
                        "@entity.frameIndex"
                      ],
                      "caption"
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@config.frames",
                          "@entity.frameIndex"
                        ],
                        "values"
                      ],
                      {
                        "color": [
                          "if",
                          [
                            "array/includes",
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@config.frames",
                                "@entity.frameIndex"
                              ],
                              "highlights"
                            ],
                            "@index"
                          ],
                          "@config.highlightColor",
                          "@config.baseColor"
                        ],
                        "label": [
                          "str/concat",
                          "",
                          "@item"
                        ],
                        "value": "@item"
                      }
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Frame ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.frameIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "array/len",
                                    "@config.frames"
                                  ]
                                ]
                              ],
                              "max": [
                                "array/len",
                                "@config.frames"
                              ],
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.frameIndex",
                                1.0
                              ]
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "bars": "@entity.bars",
                              "height": "@config.height",
                              "type": "algorithm-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                {
                                  "action": "PLAY",
                                  "disabled": [
                                    "if",
                                    "@entity.running",
                                    true,
                                    false
                                  ],
                                  "label": "Play",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "PAUSE",
                                  "disabled": [
                                    "if",
                                    "@entity.running",
                                    false,
                                    true
                                  ],
                                  "label": "Pause",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESTART",
                                  "label": "Restart",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": "@entity.frameCaption",
                                  "type": "typography",
                                  "variant": "body"
                                }
                              ],
                              "padding": "md",
                              "title": "@entity.frameLabel",
                              "type": "card",
                              "variant": "bordered"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.statusNote",
                                " · ",
                                [
                                  "str/concat",
                                  "",
                                  "@config.tickMs"
                                ],
                                " ms/frame",
                                [
                                  "if",
                                  "@config.loop",
                                  " · loops",
                                  ""
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GQ610QS6TW851N356EQ0",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
