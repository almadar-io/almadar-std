            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "evidenceLabel": {
              "default": "a positive test",
              "description": "Human label for the evidence E, used in trial readouts.",
              "label": "Evidence Label",
              "tier": "presentation",
              "type": "string"
            },
            "gridColumns": {
              "default": 10.0,
              "description": "Number of columns in the population grid.",
              "label": "Grid Columns",
              "tier": "presentation",
              "type": "number"
            },
            "gridStep": {
              "default": 1.0,
              "label": "Grid Step",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 400.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "hypothesisLabel": {
              "default": "the condition",
              "description": "Human label for the hypothesis H, used in trial readouts.",
              "label": "Hypothesis Label",
              "tier": "presentation",
              "type": "string"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "likelihoodEGivenH": {
              "default": 0.9,
              "description": "Likelihood of observing the evidence given the hypothesis is true, e.g. a test's sensitivity.",
              "label": "P(E|H)",
              "synonyms": "sensitivity, true positive rate",
              "tier": "domain",
              "type": "number"
            },
            "likelihoodEGivenNotH": {
              "default": 0.08,
              "description": "Likelihood of observing the evidence given the hypothesis is false, e.g. a test's false-positive rate.",
              "label": "P(E|¬H)",
              "synonyms": "false positive rate, false alarm rate",
              "tier": "domain",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "populationSize": {
              "default": 100.0,
              "description": "Number of individuals in the population grid.",
              "label": "Population Size",
              "tier": "presentation",
              "type": "number"
            },
            "priorH": {
              "default": 0.01,
              "description": "Prior probability that the hypothesis is true before seeing evidence — the base rate.",
              "label": "Prior P(H)",
              "synonyms": "base rate, prior probability",
              "tier": "domain",
              "type": "number"
            },
            "showAxes": {
              "default": true,
              "label": "Show Axes",
              "tier": "presentation",
              "type": "boolean"
            },
            "showGrid": {
              "default": true,
              "label": "Show Grid",
              "tier": "presentation",
              "type": "boolean"
            },
            "title": {
              "default": "Probability Lab",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            },
            "xMax": {
              "default": 10.0,
              "label": "X Max",
              "tier": "presentation",
              "type": "number"
            },
            "xMin": {
              "default": 0.0,
              "label": "X Min",
              "tier": "presentation",
              "type": "number"
            },
            "yMax": {
              "default": 1.0,
              "label": "Y Max",
              "tier": "presentation",
              "type": "number"
            },
            "yMin": {
              "default": 0.0,
              "label": "Y Min",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The Bayes state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "BAYES_UPDATED",
              "eventId": "evt_01KZEJ8QFYMD2248FXK3R0PKE9",
              "payloadSchema": [
                {
                  "name": "priorH",
                  "type": "number"
                },
                {
                  "name": "likelihoodEGivenH",
                  "type": "number"
                },
                {
                  "name": "likelihoodEGivenNotH",
                  "type": "number"
                },
                {
                  "name": "posteriorH",
                  "type": "number"
                },
                {
                  "name": "trialsRun",
                  "type": "number"
                },
                {
                  "name": "empiricalPosterior",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "bayes update, posterior update, trial run, evidence trial",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "countFN",
              "countFP",
              "countTN",
              "countTP",
              "empiricalPosterior",
              "lastTrialLabel",
              "likelihoodEGivenH",
              "likelihoodEGivenNotH",
              "posteriorH",
              "priorH",
              "shapes",
              "title",
              "trialsPositive",
              "trialsRun",
              "trialsTruePositive"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "ProbBayesScene": "ent_01KZEJ8QFWA2V8FDS2K1ZEGJWA"
          },
          "id": "trt_01KZEJ8QFWDNVVCVBPRF7G6K43",
          "linkedEntity": "ProbBayesScene",
          "linkedEntityId": "ent_01KZEJ8QFWA2V8FDS2K1ZEGJWA",
          "name": "ProbBayesSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEJ8QFWE3P5NT4MKZK8WMAA",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEJ8QFYEWESQAJC777DM7FG",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged a prior/likelihood slider — param is one of prior, likelihoodH, likelihoodNotH.",
                "id": "evt_01KZEJ8QFYKM4MPCV5M68QGCN9",
                "key": "SET_PARAM",
                "name": "Set Param",
                "payloadSchema": [
                  {
                    "name": "param",
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZEJ8QFYM4G7KGX08J2VP7D2",
                "key": "RUN_TRIAL",
                "name": "Run Trial"
              },
              {
                "id": "evt_01KZEJ8QFY1DYBM891Z9TWQWC1",
                "key": "RESET_TRIALS",
                "name": "Reset Trials"
              },
              {
                "description": "The Bayes state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEJ8QFYMD2248FXK3R0PKE9",
                "key": "BAYES_UPDATED",
                "name": "Bayes Updated",
                "payloadSchema": [
                  {
                    "name": "priorH",
                    "type": "number"
                  },
                  {
                    "name": "likelihoodEGivenH",
                    "type": "number"
                  },
                  {
                    "name": "likelihoodEGivenNotH",
                    "type": "number"
                  },
                  {
                    "name": "posteriorH",
                    "type": "number"
                  },
                  {
                    "name": "trialsRun",
                    "type": "number"
                  },
                  {
                    "name": "empiricalPosterior",
                    "type": "number"
                  }
                ],
                "synonyms": "bayes update, posterior update, trial run, evidence trial",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.priorH",
                    "@config.priorH"
                  ],
                  [
                    "set",
                    "@entity.likelihoodEGivenH",
                    "@config.likelihoodEGivenH"
                  ],
                  [
                    "set",
                    "@entity.likelihoodEGivenNotH",
                    "@config.likelihoodEGivenNotH"
                  ],
                  [
                    "set",
                    "@entity.trialsRun",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.trialsPositive",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.trialsTruePositive",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.empiricalPosterior",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.lastTrialLabel",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "population",
                        "@config.populationSize"
                      ],
                      [
                        "cols",
                        "@config.gridColumns"
                      ],
                      [
                        "gridRows",
                        [
                          "+",
                          [
                            "math/floor",
                            [
                              "/",
                              [
                                "-",
                                "@population",
                                1.0
                              ],
                              "@cols"
                            ]
                          ],
                          1.0
                        ]
                      ],
                      [
                        "cellW",
                        [
                          "/",
                          [
                            "-",
                            "@config.width",
                            48.0
                          ],
                          "@cols"
                        ]
                      ],
                      [
                        "cellH",
                        [
                          "/",
                          [
                            "-",
                            "@config.height",
                            48.0
                          ],
                          "@gridRows"
                        ]
                      ],
                      [
                        "countH",
                        [
                          "math/round",
                          [
                            "*",
                            "@entity.priorH",
                            "@population"
                          ]
                        ]
                      ],
                      [
                        "countNotH",
                        [
                          "-",
                          "@population",
                          "@countH"
                        ]
                      ],
                      [
                        "truePos",
                        [
                          "math/round",
                          [
                            "*",
                            "@countH",
                            "@entity.likelihoodEGivenH"
                          ]
                        ]
                      ],
                      [
                        "falseNeg",
                        [
                          "-",
                          "@countH",
                          "@truePos"
                        ]
                      ],
                      [
                        "falsePos",
                        [
                          "math/round",
                          [
                            "*",
                            "@countNotH",
                            "@entity.likelihoodEGivenNotH"
                          ]
                        ]
                      ],
                      [
                        "trueNeg",
                        [
                          "-",
                          "@countNotH",
                          "@falsePos"
                        ]
                      ],
                      [
                        "posterior",
                        [
                          "if",
                          [
                            ">",
                            [
                              "+",
                              "@truePos",
                              "@falsePos"
                            ],
                            0.0
                          ],
                          [
                            "/",
                            "@truePos",
                            [
                              "+",
                              "@truePos",
                              "@falsePos"
                            ]
                          ],
                          0.0
                        ]
                      ],
                      [
                        "bayesShapes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@population"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "col",
                                  [
                                    "math/mod",
                                    "@i",
                                    "@cols"
                                  ]
                                ],
                                [
                                  "row",
                                  [
                                    "math/floor",
                                    [
                                      "/",
                                      "@i",
                                      "@cols"
                                    ]
                                  ]
                                ],
                                [
                                  "category",
                                  [
                                    "if",
                                    [
                                      "<",
                                      "@i",
                                      "@truePos"
                                    ],
                                    "tp",
                                    [
                                      "if",
                                      [
                                        "<",
                                        "@i",
                                        [
                                          "+",
                                          "@truePos",
                                          "@falseNeg"
                                        ]
                                      ],
                                      "fn",
                                      [
                                        "if",
                                        [
                                          "<",
                                          "@i",
                                          [
                                            "+",
                                            "@truePos",
                                            "@falseNeg",
                                            "@falsePos"
                                          ]
                                        ],
                                        "fp",
                                        "tn"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "fill": [
                                  "if",
                                  [
                                    "==",
                                    "@category",
                                    "tp"
                                  ],
                                  "#dc2626",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@category",
                                      "fn"
                                    ],
                                    "#fca5a5",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@category",
                                        "fp"
                                      ],
                                      "#f59e0b",
                                      "#e5e7eb"
                                    ]
                                  ]
                                ],
                                "height": [
                                  "*",
                                  "@cellH",
                                  0.86
                                ],
                                "lineWidth": 0.0,
                                "type": "rect",
                                "width": [
                                  "*",
                                  "@cellW",
