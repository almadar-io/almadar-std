                                "str/concat",
                                "Empirical P(H|E) from ",
                                "@entity.trialsRun",
                                " trial(s)"
                              ],
                              "max": 100.0,
                              "min": 0.0,
                              "showValue": true,
                              "type": "meter",
                              "unit": "%",
                              "value": [
                                "math/round",
                                [
                                  "*",
                                  "@entity.empiricalPosterior",
                                  100.0
                                ],
                                1.0
                              ]
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "BAYES_UPDATED",
                    {
                      "empiricalPosterior": "@entity.empiricalPosterior",
                      "likelihoodEGivenH": "@entity.likelihoodEGivenH",
                      "likelihoodEGivenNotH": "@entity.likelihoodEGivenNotH",
                      "posteriorH": "@entity.posteriorH",
                      "priorH": "@entity.priorH",
                      "trialsRun": "@entity.trialsRun"
                    }
                  ]
                ],
                "event": "RESET_TRIALS",
                "eventId": "evt_01KZEJ8QFY1DYBM891Z9TWQWC1",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}