                  [
                    "emit",
                    "BAYES_UPDATED",
                    {
                      "empiricalPosterior": "@entity.empiricalPosterior",
                      "likelihoodEGivenH": "@entity.likelihoodEGivenH",
                      "likelihoodEGivenNotH": "@entity.likelihoodEGivenNotH",
                      "posteriorH": "@entity.posteriorH",
                      "priorH": "@entity.priorH",
                      "trialsRun": "@entity.trialsRun"
                    }
                  ]
                ],
                "event": "SET_PARAM",
                "eventId": "evt_01KZEJ8QFYKM4MPCV5M68QGCN9",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "drawH",
                        [
                          "<",
                          [
                            "math/random"
                          ],
                          "@entity.priorH"
                        ]
                      ],
                      [
                        "roll",
                        [
                          "math/random"
                        ]
                      ],
                      [
                        "drawE",
                        [
                          "if",
                          "@drawH",
                          [
                            "<",
                            "@roll",
                            "@entity.likelihoodEGivenH"
                          ],
                          [
                            "<",
                            "@roll",
                            "@entity.likelihoodEGivenNotH"
                          ]
                        ]
                      ],
                      [
                        "newTrialsRun",
                        [
                          "+",
                          "@entity.trialsRun",
                          1.0
                        ]
                      ],
                      [
                        "newTrialsPositive",
                        [
                          "if",
                          "@drawE",
                          [
                            "+",
                            "@entity.trialsPositive",
                            1.0
                          ],
                          "@entity.trialsPositive"
                        ]
                      ],
                      [
                        "newTrialsTruePositive",
                        [
                          "if",
                          [
                            "and",
                            "@drawH",
                            "@drawE"
                          ],
                          [
                            "+",
                            "@entity.trialsTruePositive",
                            1.0
                          ],
                          "@entity.trialsTruePositive"
                        ]
                      ],
                      [
                        "newEmpirical",
                        [
                          "if",
                          [
                            ">",
                            "@newTrialsPositive",
                            0.0
                          ],
                          [
                            "/",
                            "@newTrialsTruePositive",
                            "@newTrialsPositive"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "drawLabel",
                        [
                          "if",
                          "@drawH",
                          [
                            "if",
                            "@drawE",
                            [
                              "str/concat",
                              "Drew: has ",
                              "@config.hypothesisLabel",
                              ", observed ",
                              "@config.evidenceLabel"
                            ],
                            [
                              "str/concat",
                              "Drew: has ",
                              "@config.hypothesisLabel",
                              ", no ",
                              "@config.evidenceLabel"
                            ]
                          ],
                          [
                            "if",
                            "@drawE",
                            [
                              "str/concat",
                              "Drew: no ",
                              "@config.hypothesisLabel",
                              ", but observed ",
                              "@config.evidenceLabel",
                              " (false alarm)"
                            ],
                            [
                              "str/concat",
                              "Drew: no ",
                              "@config.hypothesisLabel",
                              ", no ",
                              "@config.evidenceLabel"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.trialsRun",
                        "@newTrialsRun"
                      ],
                      [
                        "set",
                        "@entity.trialsPositive",
                        "@newTrialsPositive"
                      ],
                      [
                        "set",
                        "@entity.trialsTruePositive",
                        "@newTrialsTruePositive"
                      ],
                      [
                        "set",
                        "@entity.empiricalPosterior",
                        "@newEmpirical"
                      ],
                      [
                        "set",
                        "@entity.lastTrialLabel",
                        "@drawLabel"
                      ]
                    ]
