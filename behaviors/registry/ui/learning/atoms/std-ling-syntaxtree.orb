                                "let",
                                [
                                  [
                                    "step",
                                    [
                                      "array/nth",
                                      "@derivation",
                                      "@k"
                                    ]
                                  ],
                                  [
                                    "leftX",
                                    [
                                      "+",
                                      "@config.leftMargin",
                                      [
                                        "*",
                                        [
                                          "object/get",
                                          "@step",
