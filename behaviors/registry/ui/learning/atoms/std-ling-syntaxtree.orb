                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEFXX2Y9FYKS43PC7WJ1N6A",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "currentSentence",
                        [
                          "array/nth",
                          "@config.sentences",
