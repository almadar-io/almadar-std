                      "level": 1.0,
                      "startIndex": 3.0
                    },
                    {
                      "constituent": "VP",
                      "endIndex": 5.0,
                      "evidence": "A verb (V) and its Prepositional Phrase combine into a Verb Phrase — \"sat on the mat\".",
                      "level": 2.0,
                      "startIndex": 2.0
                    },
                    {
                      "constituent": "S",
                      "endIndex": 5.0,
