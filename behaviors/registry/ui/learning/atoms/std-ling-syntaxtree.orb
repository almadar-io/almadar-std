                        [
                          "-",
                          "@config.height",
                          "@config.bottomMargin"
                        ]
                      ],
                      [
                        "isDone",
                        [
                          ">=",
                          "@entity.stepIndex",
                          "@totalSteps"
                        ]
                      ],
                      [
                        "expectedStep",
                        [
                          "if",
                          "@isDone",
                          null,
                          [
                            "array/nth",
                            "@derivation",
                            "@entity.stepIndex"
                          ]
                        ]
                      ],
                      [
                        "isCorrect",
                        [
                          "if",
                          "@isDone",
                          false,
                          [
                            "==",
                            [
                              "object/get",
                              "@expectedStep",
                              "constituent"
                            ],
                            "@payload.constituent"
                          ]
                        ]
                      ],
                      [
                        "nextStepIndex",
                        [
                          "if",
                          "@isCorrect",
                          [
                            "+",
                            "@entity.stepIndex",
                            1.0
                          ],
                          "@entity.stepIndex"
                        ]
                      ],
                      [
                        "wordShapes",
                        [
                          "array/flatten",
                          [
