                                          "endIndex"
                                        ],
                                        "@config.wordSpacing"
                                      ]
                                    ]
                                  ],
                                  [
                                    "midX",
                                    [
                                      "/",
                                      [
                                        "+",
                                        "@leftX",
                                        "@rightX"
                                      ],
                                      2.0
                                    ]
                                  ],
