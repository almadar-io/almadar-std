                                  "value": "@entity.precip"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.climateClassCode",
                                " — ",
