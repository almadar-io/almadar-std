                                  "fn",
                                  "c",
                                  {
                                    "label": [
                                      "str/concat",
                                      [
                                        "object/get",
                                        "@c",
                                        "code"
                                      ],
                                      " ",
                                      [
                                        "object/get",
                                        "@c",
                                        "name"
                                      ]
                                    ],
                                    "type": "badge",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "code"
                                        ],
                                        "@entity.climateClassCode"
                                      ],
                                      "primary",
                                      "neutral"
                                    ]
                                  }
                                ]
                              ],
