                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEGFJRAA86BT30N4TDD557K",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.tempSummer",
                    "@payload.value"
                  ],
                  [
                    "let",
                    [
                      [
                        "plotLeft",
                        40.0
                      ],
                      [
                        "plotRight",
                        [
                          "-",
                          "@config.width",
                          40.0
                        ]
                      ],
                      [
                        "plotWidthPx",
                        [
                          "-",
                          "@plotRight",
                          "@plotLeft"
                        ]
                      ],
