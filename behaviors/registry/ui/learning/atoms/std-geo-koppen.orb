                        "climoRows",
                        [
                          "array/map",
                          "@monthlyRows",
                          [
                            "fn",
                            "r",
                            [
                              "let",
                              [
                                [
                                  "xPos",
                                  [
                                    "+",
                                    "@plotLeft",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
                                          "object/get",
                                          "@r",
                                          "order"
                                        ],
                                        11.0
                                      ],
                                      "@plotWidthPx"
                                    ]
                                  ]
                                ],
                                [
                                  "tempY",
                                  [
                                    "math/clamp",
                                    [
                                      "-",
                                      "@plotBottom",
                                      [
                                        "*",
                                        [
                                          "/",
                                          [
                                            "-",
                                            [
                                              "object/get",
                                              "@r",
                                              "temp"
                                            ],
                                            "@config.tempAxisMin"
                                          ],
                                          [
                                            "-",
                                            "@config.tempAxisMax",
                                            "@config.tempAxisMin"
                                          ]
                                        ],
                                        "@plotHeightPx"
                                      ]
                                    ],
                                    "@plotTop",
                                    "@plotBottom"
                                  ]
                                ],
                                [
                                  "precipHeightPx",
                                  [
                                    "math/clamp",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
                                          "object/get",
                                          "@r",
                                          "precip"
                                        ],
                                        "@config.precipAxisMax"
                                      ],
                                      "@plotHeightPx"
                                    ],
                                    0.0,
                                    "@plotHeightPx"
                                  ]
                                ],
                                [
                                  "barHalfWidth",
                                  [
                                    "*",
                                    [
                                      "/",
                                      "@plotWidthPx",
                                      12.0
                                    ],
                                    0.35
                                  ]
                                ]
                              ],
                              {
                                "barHalfWidth": "@barHalfWidth",
                                "label": [
                                  "object/get",
                                  "@r",
                                  "label"
                                ],
                                "precipHeightPx": "@precipHeightPx",
                                "tempY": "@tempY",
                                "xPos": "@xPos"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "tempCurveSamples",
                        [
                          "array/map",
                          "@climoRows",
                          [
                            "fn",
                            "cr",
                            {
                              "x": [
                                "object/get",
                                "@cr",
                                "xPos"
                              ],
                              "y": [
                                "-",
                                "@config.height",
                                [
                                  "object/get",
                                  "@cr",
                                  "tempY"
                                ]
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "precipBars",
                        [
                          "array/map",
                          "@climoRows",
                          [
                            "fn",
                            "cr",
                            {
                              "color": "@config.precipColor",
                              "fill": "@config.precipColor",
                              "height": [
                                "object/get",
                                "@cr",
                                "precipHeightPx"
                              ],
                              "type": "rect",
                              "width": [
                                "*",
                                [
                                  "object/get",
                                  "@cr",
                                  "barHalfWidth"
                                ],
                                2.0
                              ],
                              "x": [
                                "-",
                                [
                                  "object/get",
                                  "@cr",
                                  "xPos"
                                ],
                                [
                                  "object/get",
                                  "@cr",
                                  "barHalfWidth"
                                ]
                              ],
                              "y": [
                                "-",
                                "@plotBottom",
                                [
                                  "object/get",
                                  "@cr",
                                  "precipHeightPx"
                                ]
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "monthLabels",
                        [
                          "array/map",
                          "@climoRows",
                          [
                            "fn",
                            "cr",
                            {
                              "align": "center",
                              "color": "@config.textColor",
                              "fontSize": 10.0,
                              "text": [
                                "object/get",
                                "@cr",
                                "label"
                              ],
                              "type": "text",
                              "x": [
                                "object/get",
                                "@cr",
                                "xPos"
                              ],
                              "y": [
                                "+",
                                "@plotBottom",
                                16.0
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "baseline",
                        [
                          {
                            "color": "@config.axisColor",
                            "lineWidth": 1.0,
                            "type": "line",
                            "x1": "@plotLeft",
                            "x2": "@plotRight",
                            "y1": "@plotBottom",
                            "y2": "@plotBottom"
                          }
                        ]
                      ],
                      [
                        "climateShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            "@precipBars",
                            "@monthLabels"
                          ],
                          "@baseline"
                        ]
                      ],
                      [
                        "climateCurves",
                        [
                          {
                            "color": "@config.tempCurveColor",
                            "label": "Temperature (°C)",
                            "samples": "@tempCurveSamples"
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.coldestMonthTemp",
                        "@coldestMonthTemp"
                      ],
                      [
                        "set",
                        "@entity.warmestMonthTemp",
                        "@warmestMonthTemp"
                      ],
                      [
                        "set",
                        "@entity.annualPrecipTotal",
                        "@annualPrecipTotal"
                      ],
                      [
                        "set",
                        "@entity.climateClassCode",
                        "@climateClassCode"
                      ],
                      [
                        "set",
                        "@entity.climateClassName",
                        "@climateClassName"
                      ],
                      [
                        "set",
                        "@entity.climateClassReadout",
                        "@climateClassReadout"
                      ],
                      [
                        "set",
                        "@entity.climateShapes",
                        "@climateShapes"
                      ],
                      [
                        "set",
                        "@entity.climateCurves",
                        "@climateCurves"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.climateCurves",
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.climateShapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Summer high: ",
                                    "@entity.tempSummer",
                                    "°C"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": "@config.tempAxisMax",
                                  "min": "@config.tempAxisMin",
                                  "onChange": "SET_TEMP_SUMMER",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.tempSummer"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Winter low: ",
                                    "@entity.tempWinter",
                                    "°C"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": "@config.tempAxisMax",
                                  "min": "@config.tempAxisMin",
                                  "onChange": "SET_TEMP_WINTER",
                                  "showTooltip": true,
                                  "step": 1.0,
                                  "type": "range-slider",
                                  "value": "@entity.tempWinter"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Avg monthly precipitation: ",
                                    "@entity.precip",
                                    " mm"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": "@config.precipAxisMax",
                                  "min": 0.0,
                                  "onChange": "SET_PRECIP",
                                  "showTooltip": true,
                                  "step": 5.0,
                                  "type": "range-slider",
                                  "value": "@entity.precip"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.climateClassCode",
                                " — ",
                                "@entity.climateClassName"
                              ],
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "@entity.climateClassReadout",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.climateClasses",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "label": [
                                      "str/concat",
                                      [
                                        "object/get",
                                        "@c",
                                        "code"
                                      ],
                                      " ",
                                      [
                                        "object/get",
                                        "@c",
                                        "name"
                                      ]
                                    ],
                                    "type": "badge",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "code"
                                        ],
                                        "@entity.climateClassCode"
                                      ],
                                      "primary",
                                      "neutral"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "KOPPEN_UPDATED",
                    {
                      "annualPrecipTotal": "@entity.annualPrecipTotal",
                      "climateClassCode": "@entity.climateClassCode",
                      "climateClassName": "@entity.climateClassName",
                      "coldestMonthTemp": "@entity.coldestMonthTemp",
                      "warmestMonthTemp": "@entity.warmestMonthTemp"
                    }
                  ]
                ],
                "event": "SET_PRECIP",
                "eventId": "evt_01KZEGFJRA7SVVYTY2KC1S11M2",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}