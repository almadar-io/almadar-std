                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          40.0
                        ]
                      ],
                      [
                        "plotHeightPx",
                        [
                          "-",
                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "monthlyRows",
                        [
                          "array/map",
                          "@config.months",
                          [
                            "fn",
                            "m",
                            [
                              "let",
                              [
                                [
                                  "temp",
                                  [
                                    "+",
                                    "@entity.tempWinter",
                                    [
                                      "*",
                                      [
                                        "-",
                                        "@entity.tempSummer",
                                        "@entity.tempWinter"
                                      ],
                                      [
                                        "object/get",
                                        "@m",
                                        "tempWeight"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "precipVal",
                                  [
                                    "*",
                                    "@entity.precip",
                                    [
                                      "object/get",
                                      "@m",
                                      "precipWeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "label": [
                                  "object/get",
                                  "@m",
                                  "label"
                                ],
                                "order": [
                                  "object/get",
                                  "@m",
                                  "order"
                                ],
                                "precip": "@precipVal",
                                "temp": "@temp"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "coldestMonthTemp",
                        [
                          "array/min",
                          "@monthlyRows",
                          "temp"
                        ]
                      ],
                      [
                        "warmestMonthTemp",
                        [
                          "array/max",
                          "@monthlyRows",
                          "temp"
                        ]
                      ],
                      [
                        "annualPrecipTotal",
                        [
                          "array/sum",
                          "@monthlyRows",
                          "precip"
                        ]
                      ],
                      [
                        "matchedClass",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.climateClasses",
                            [
                              "fn",
                              "c",
                              [
                                "let",
                                [
                                  [
                                    "metricVal",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "metric"
                                        ],
                                        "coldestMonthTemp"
                                      ],
                                      "@coldestMonthTemp",
                                      [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@c",
                                            "metric"
                                          ],
                                          "warmestMonthTemp"
                                        ],
                                        "@warmestMonthTemp",
                                        "@annualPrecipTotal"
                                      ]
                                    ]
                                  ],
                                  [
                                    "thresh",
                                    [
                                      "object/get",
                                      "@c",
                                      "threshold"
                                    ]
                                  ]
                                ],
                                [
                                  "if",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@c",
                                      "comparator"
                                    ],
                                    "lt"
                                  ],
                                  [
                                    "<",
                                    "@metricVal",
                                    "@thresh"
                                  ],
                                  [
                                    ">=",
                                    "@metricVal",
                                    "@thresh"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "matchedClassFinal",
                        [
                          "if",
                          [
                            "==",
                            "@matchedClass",
                            null
                          ],
                          [
                            "array/last",
                            "@config.climateClasses"
                          ],
                          "@matchedClass"
                        ]
                      ],
                      [
