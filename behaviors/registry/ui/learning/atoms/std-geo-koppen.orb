            "climateClasses": {
              "default": [
                {
                  "code": "B",
                  "comparator": "lt",
                  "metric": "annualPrecip",
                  "name": "Arid",
                  "ruleText": "annual precipitation < 500 mm",
                  "threshold": 500.0
                },
                {
                  "code": "A",
                  "comparator": "gte",
                  "metric": "coldestMonthTemp",
                  "name": "Tropical",
                  "ruleText": "coldest month >= 18°C",
