                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "monthlyRows",
                        [
                          "array/map",
                          "@config.months",
                          [
                            "fn",
                            "m",
                            [
                              "let",
                              [
                                [
                                  "temp",
                                  [
                                    "+",
                                    "@entity.tempWinter",
                                    [
                                      "*",
                                      [
                                        "-",
                                        "@entity.tempSummer",
