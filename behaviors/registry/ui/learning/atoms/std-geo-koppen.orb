                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "@entity.climateClassReadout",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.climateClasses",
