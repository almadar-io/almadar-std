                            "fn",
                            "r",
                            [
                              "let",
                              [
                                [
                                  "xPos",
                                  [
                                    "+",
                                    "@plotLeft",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
                                          "object/get",
                                          "@r",
                                          "order"
                                        ],
                                        11.0
                                      ],
                                      "@plotWidthPx"
                                    ]
                                  ]
                                ],
                                [
                                  "tempY",
                                  [
                                    "math/clamp",
                                    [
                                      "-",
                                      "@plotBottom",
                                      [
                                        "*",
                                        [
                                          "/",
                                          [
                                            "-",
                                            [
                                              "object/get",
                                              "@r",
                                              "temp"
                                            ],
                                            "@config.tempAxisMin"
