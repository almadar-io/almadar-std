                          "array/first",
                          [
                            "array/filter",
                            "@config.climateClasses",
                            [
                              "fn",
                              "c",
                              [
                                "let",
                                [
                                  [
                                    "metricVal",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "metric"
                                        ],
                                        "coldestMonthTemp"
                                      ],
                                      "@coldestMonthTemp",
                                      [
                                        "if",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@c",
                                            "metric"
                                          ],
                                          "warmestMonthTemp"
