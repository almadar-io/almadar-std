                        ]
                      ],
                      [
                        "plotHeightPx",
                        [
                          "-",
                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "monthlyRows",
                        [
                          "array/map",
                          "@config.months",
                          [
                            "fn",
                            "m",
                            [
                              "let",
                              [
                                [
                                  "temp",
                                  [
                                    "+",
                                    "@entity.tempWinter",
                                    [
                                      "*",
                                      [
                                        "-",
                                        "@entity.tempSummer",
                                        "@entity.tempWinter"
                                      ],
                                      [
                                        "object/get",
                                        "@m",
                                        "tempWeight"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "precipVal",
                                  [
                                    "*",
                                    "@entity.precip",
                                    [
                                      "object/get",
                                      "@m",
                                      "precipWeight"
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "label": [
                                  "object/get",
                                  "@m",
                                  "label"
                                ],
                                "order": [
                                  "object/get",
                                  "@m",
                                  "order"
                                ],
                                "precip": "@precipVal",
                                "temp": "@temp"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "coldestMonthTemp",
                        [
                          "array/min",
                          "@monthlyRows",
                          "temp"
                        ]
                      ],
                      [
                        "warmestMonthTemp",
                        [
                          "array/max",
                          "@monthlyRows",
                          "temp"
                        ]
                      ],
                      [
                        "annualPrecipTotal",
                        [
                          "array/sum",
                          "@monthlyRows",
                          "precip"
                        ]
                      ],
                      [
                        "matchedClass",
