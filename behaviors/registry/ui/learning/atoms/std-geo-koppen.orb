                                    "==",
                                    [
                                      "object/get",
                                      "@c",
                                      "comparator"
                                    ],
                                    "lt"
                                  ],
                                  [
                                    "<",
                                    "@metricVal",
                                    "@thresh"
                                  ],
                                  [
                                    ">=",
                                    "@metricVal",
                                    "@thresh"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
