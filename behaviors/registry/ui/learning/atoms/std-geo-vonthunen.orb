          "id": "trt_01M0492BBKF7BF1QAD0YY9XAD5",
          "linkedEntity": "GeoVonThunenScene",
          "linkedEntityId": "ent_01M0492BBKG9RQ8KRD1J4ZV5Z8",
          "name": "GeoVonThunenSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0492BBKMMX151HA4M6RSFVS",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M0492BBMK3EX59QHXBAJDPSK",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the transport-cost multiplier dial.",
                "id": "evt_01M0492BBM54H0FS96TAFKQ93W",
                "key": "SET_COST",
                "name": "Set Cost",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the market-price multiplier dial.",
                "id": "evt_01M0492BBMVGY30TPA3YC2WNRC",
                "key": "SET_PRICE",
                "name": "Set Price",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner reset both dials to the configured starting values.",
                "id": "evt_01M0492BBM5GJJD92X0AR62H9T",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The von Thünen state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M0492BBMSBYFD7ED5DRDWS9T",
                "key": "VONTHUNEN_UPDATED",
                "name": "Vonthunen Updated",
                "payloadSchema": [
                  {
                    "name": "transportCost",
                    "type": "number"
                  },
                  {
                    "name": "marketPrice",
                    "type": "number"
                  },
                  {
                    "name": "ringBoundaries",
                    "type": "[number]"
                  }
                ],
                "synonyms": "von Thunen, bid-rent, bid rent curve, land rent, transport cost, market price, agricultural rings, concentric rings, ring boundary",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.transportCost",
                    "@config.transportCosts"
                  ],
                  [
                    "set",
                    "@entity.marketPrice",
                    "@config.marketPrices"
                  ],
                  [
                    "let",
                    [
                      [
                        "plotLeft",
                        50.0
                      ],
                      [
                        "plotRight",
                        [
                          "-",
                          "@config.width",
                          30.0
                        ]
                      ],
                      [
                        "plotWidthPx",
                        [
                          "-",
                          "@plotRight",
                          "@plotLeft"
                        ]
                      ],
                      [
                        "plotTop",
                        30.0
                      ],
                      [
                        "plotBottom",
                        [
                          "-",
                          "@config.height",
                          50.0
                        ]
                      ],
                      [
                        "plotHeightPx",
                        [
                          "-",
                          "@plotBottom",
                          "@plotTop"
                        ]
                      ],
                      [
                        "cropLines",
                        [
                          "array/map",
                          "@config.crops",
                          [
                            "fn",
                            "c",
                            [
                              "let",
                              [
                                [
                                  "intercept",
                                  [
                                    "-",
                                    [
                                      "*",
                                      [
                                        "*",
                                        [
                                          "object/get",
                                          "@c",
                                          "basePrice"
                                        ],
                                        "@entity.marketPrice"
                                      ],
                                      [
                                        "object/get",
                                        "@c",
                                        "yieldPerHa"
                                      ]
                                    ],
                                    [
                                      "object/get",
                                      "@c",
                                      "fixedCost"
                                    ]
                                  ]
                                ],
                                [
                                  "slope",
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@c",
                                      "transportRate"
                                    ],
                                    "@entity.transportCost"
                                  ]
                                ]
                              ],
                              {
                                "color": [
                                  "object/get",
                                  "@c",
                                  "color"
                                ],
                                "intercept": "@intercept",
                                "label": [
                                  "object/get",
                                  "@c",
                                  "label"
                                ],
                                "slope": "@slope"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "rentCurves",
                        [
                          "array/map",
                          "@cropLines",
                          [
                            "fn",
                            "cl",
                            {
                              "color": [
                                "object/get",
                                "@cl",
                                "color"
                              ],
                              "label": [
                                "object/get",
                                "@cl",
                                "label"
                              ],
                              "samples": [
                                {
                                  "x": "@plotLeft",
                                  "y": [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
                                          "math/max",
                                          0.0,
                                          [
                                            "object/get",
                                            "@cl",
                                            "intercept"
                                          ]
                                        ],
                                        "@config.rentAxisMax"
                                      ],
                                      "@plotHeightPx"
                                    ]
                                  ]
                                },
                                {
                                  "x": "@plotRight",
                                  "y": [
                                    "-",
                                    "@plotBottom",
                                    [
                                      "*",
                                      [
                                        "/",
                                        [
                                          "math/max",
                                          0.0,
                                          [
                                            "-",
                                            [
                                              "object/get",
                                              "@cl",
                                              "intercept"
                                            ],
                                            [
                                              "*",
                                              [
                                                "object/get",
                                                "@cl",
                                                "slope"
                                              ],
                                              "@config.distanceAxisMax"
                                            ]
                                          ]
                                        ],
                                        "@config.rentAxisMax"
                                      ],
                                      "@plotHeightPx"
                                    ]
                                  ]
                                }
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "boundaryRows",
                        [
                          "array/map",
                          [
                            "array/range",
                            [
                              "math/max",
                              0.0,
                              [
                                "-",
                                [
                                  "array/len",
                                  "@cropLines"
                                ],
                                1.0
                              ]
                            ]
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "inner",
