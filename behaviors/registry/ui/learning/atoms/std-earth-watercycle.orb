      "traits": [
        {
          "category": "interaction",
          "config": {
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f0f9ff",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "baseEvaporationFlux": {
              "default": 40.0,
              "description": "Evaporation flux at 100% solar input; scales linearly down with solar input.",
              "label": "Base Evaporation Flux",
              "tier": "domain",
              "type": "number"
            },
            "condensationRatio": {
              "default": 0.9,
              "description": "Fraction of evaporation flux that condenses in the atmosphere.",
              "label": "Condensation Ratio",
              "tier": "domain",
              "type": "number"
            },
            "fluxWidthScale": {
              "default": 0.15,
              "description": "Pixels of arrow line-width added per unit of flux, for the flux-arrow re-scaling.",
              "label": "Flux Width Scale",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 420.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "precipitationRatio": {
              "default": 0.95,
              "description": "Fraction of condensation flux that falls as precipitation.",
              "label": "Precipitation Ratio",
              "tier": "domain",
              "type": "number"
            },
            "reservoirs": {
              "default": [
                {
                  "color": "#0ea5e9",
                  "id": "ocean",
                  "label": "Ocean",
                  "radius": 70.0
                },
                {
                  "color": "#e0f2fe",
                  "id": "atmosphere",
                  "label": "Atmosphere",
                  "radius": 55.0
                },
                {
                  "color": "#65a30d",
                  "id": "land",
                  "label": "Land",
                  "radius": 50.0
                }
              ],
              "description": "Roster of the three water-cycle reservoirs (ocean, atmosphere, land); label/color/radius are re-themeable, positions are computed from width/height.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "radius": {
                    "name": "radius",
                    "required": false,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Reservoirs",
              "tier": "domain",
              "type": "[EarthWatercycleReservoir]"
            },
            "runoffRatio": {
              "default": 0.3,
              "description": "Fraction of precipitation flux that runs off land back to the ocean.",
              "label": "Runoff Ratio",
              "tier": "domain",
              "type": "number"
            },
            "solarInput": {
              "default": 50.0,
              "description": "Starting solar input (0-100) driving evaporation.",
              "label": "Solar Input",
              "tier": "domain",
              "type": "number"
            },
            "solarStepDelta": {
              "default": 15.0,
              "description": "How much solar input changes per Step the Cycle press.",
              "label": "Solar Step Delta",
              "tier": "domain",
              "type": "number"
            },
            "title": {
              "default": "Earth Lab",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The water-cycle flux state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "WATERCYCLE_UPDATED",
              "eventId": "evt_01KZEFVJCCDD95V4S5ZYE8HC9H",
              "payloadSchema": [
                {
                  "name": "solarInput",
                  "type": "number"
                },
                {
                  "name": "cycleStep",
                  "type": "number"
                },
                {
                  "name": "evaporationFlux",
                  "type": "number"
                },
                {
                  "name": "condensationFlux",
                  "type": "number"
                },
                {
                  "name": "precipitationFlux",
                  "type": "number"
                },
                {
                  "name": "runoffFlux",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "water cycle update, hydrologic cycle, evaporation, condensation, precipitation, runoff",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "atmosphereReadout",
              "condensationFlux",
              "cycleStep",
              "edges",
              "evaporationFlux",
              "landReadout",
              "nodes",
              "oceanReadout",
              "precipitationFlux",
              "runoffFlux",
              "shapes",
              "solarInput",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "EarthWatercycleScene": "ent_01KZEFVJCCZYXRFT5GBRWMCHVA"
          },
          "id": "trt_01KZEFVJCCM4ZSJQXW9S2ESEWW",
          "linkedEntity": "EarthWatercycleScene",
          "linkedEntityId": "ent_01KZEFVJCCZYXRFT5GBRWMCHVA",
          "name": "EarthWatercycleSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFVJCC2XS1J7P69WSEK9CX",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFVJCCY4BZT0S30QM94CNR",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner adjusted the solar input slider.",
                "id": "evt_01KZEFVJCCDN3CG87BJ0N8XXAS",
                "key": "SET_SOLAR",
                "name": "Set Solar",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Step the Cycle to advance the water cycle one step, drifting solar input and recomputing fluxes.",
                "id": "evt_01KZEFVJCCHDP48Q8TXB712Z9T",
                "key": "STEP_CYCLE",
                "name": "Step Cycle",
                "tier": "domain"
              },
              {
                "description": "The water-cycle flux state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFVJCCDD95V4S5ZYE8HC9H",
                "key": "WATERCYCLE_UPDATED",
                "name": "Watercycle Updated",
                "payloadSchema": [
                  {
                    "name": "solarInput",
                    "type": "number"
                  },
                  {
                    "name": "cycleStep",
                    "type": "number"
                  },
                  {
                    "name": "evaporationFlux",
                    "type": "number"
                  },
                  {
                    "name": "condensationFlux",
                    "type": "number"
                  },
                  {
                    "name": "precipitationFlux",
                    "type": "number"
                  },
                  {
                    "name": "runoffFlux",
                    "type": "number"
                  }
                ],
                "synonyms": "water cycle update, hydrologic cycle, evaporation, condensation, precipitation, runoff",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.solarInput",
                    "@config.solarInput"
                  ],
                  [
                    "set",
                    "@entity.cycleStep",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "evap",
                        [
                          "*",
                          "@config.baseEvaporationFlux",
                          [
                            "/",
                            "@entity.solarInput",
                            100.0
                          ]
                        ]
                      ],
                      [
                        "condensation",
                        [
                          "*",
                          "@evap",
                          "@config.condensationRatio"
                        ]
                      ],
                      [
                        "precip",
                        [
                          "*",
                          "@condensation",
                          "@config.precipitationRatio"
                        ]
                      ],
                      [
                        "runoff",
                        [
                          "*",
                          "@precip",
                          "@config.runoffRatio"
                        ]
                      ],
                      [
                        "oceanNet",
                        [
                          "-",
                          "@runoff",
                          "@evap"
                        ]
                      ],
                      [
                        "atmosNet",
                        [
                          "-",
                          "@evap",
                          "@precip"
                        ]
                      ],
                      [
                        "landNet",
                        [
                          "-",
                          "@precip",
                          "@runoff"
                        ]
                      ],
                      [
                        "evapW",
                        [
                          "math/clamp",
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              "@evap",
                              "@config.fluxWidthScale"
                            ]
                          ],
                          1.0,
                          10.0
                        ]
                      ],
                      [
                        "condW",
                        [
                          "math/clamp",
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              "@condensation",
                              "@config.fluxWidthScale"
                            ]
                          ],
                          1.0,
                          10.0
                        ]
                      ],
                      [
                        "precipW",
                        [
                          "math/clamp",
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              "@precip",
                              "@config.fluxWidthScale"
                            ]
                          ],
                          1.0,
                          10.0
                        ]
                      ],
                      [
                        "runoffW",
                        [
                          "math/clamp",
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              "@runoff",
                              "@config.fluxWidthScale"
                            ]
                          ],
                          1.0,
                          10.0
                        ]
                      ],
                      [
                        "oceanCfg",
                        [
                          "array/nth",
                          "@config.reservoirs",
                          0.0
                        ]
                      ],
                      [
                        "atmosphereCfg",
                        [
                          "array/nth",
                          "@config.reservoirs",
                          1.0
                        ]
                      ],
                      [
                        "landCfg",
                        [
                          "array/nth",
                          "@config.reservoirs",
                          2.0
                        ]
                      ],
                      [
                        "oceanX",
                        [
                          "*",
                          "@config.width",
                          0.25
                        ]
                      ],
                      [
                        "oceanY",
                        [
                          "-",
                          "@config.height",
                          90.0
                        ]
                      ],
                      [
                        "atmosphereX",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "atmosphereY",
                        90.0
                      ],
                      [
                        "landX",
                        [
                          "*",
                          "@config.width",
                          0.78
                        ]
                      ],
                      [
                        "landY",
                        [
                          "-",
                          "@config.height",
                          100.0
                        ]
                      ],
                      [
                        "reservoirNodes",
                        [
                          {
                            "color": [
                              "object/get",
                              "@oceanCfg",
                              "color"
                            ],
                            "id": [
                              "object/get",
                              "@oceanCfg",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@oceanCfg",
                              "label"
                            ],
                            "radius": [
                              "object/get",
                              "@oceanCfg",
                              "radius"
                            ],
                            "x": "@oceanX",
                            "y": "@oceanY"
                          },
                          {
                            "color": [
                              "object/get",
                              "@atmosphereCfg",
                              "color"
                            ],
                            "id": [
                              "object/get",
                              "@atmosphereCfg",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@atmosphereCfg",
                              "label"
