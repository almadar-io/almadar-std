          "stateMachine": {
            "events": [
              {
                "id": "evt_01M07580Z07WFR9K4P23VT04GJ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M07580Z4ZBCV8MXBRY5824Z6",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Runtime content feed, honoured only when rosterSource is event — mode names the instrument it is for (the matchMode it carries, blank when standalone) and taskText, rule, rows, cols and seeds define the world; a matching instrument re-initialises from it exactly as INIT does from config, any other instrument hides.",
                "id": "evt_01M459XDPHZCTQJT5GDWQG49D0",
                "key": "ROSTER_LOADED",
                "name": "Roster Loaded",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "taskText",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "rule",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "rows",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "cols",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "seeds",
                    "required": true,
                    "type": "[number]"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed the Play/Pause toggle — starts or freezes the evolution.",
                "id": "evt_01M41KXQV2AA7B73GRTXQA57D2",
                "key": "TOGGLE_RUN",
                "name": "Toggle Run",
                "tier": "domain"
              },
              {
                "description": "The learner picked a playback speed; generations advance that many times faster.",
                "id": "evt_01M41KXQV2T9G9JXBYSWA8RR3G",
                "key": "SPEED_SET",
                "name": "Speed Set",
                "payloadSchema": [
                  {
                    "name": "speed",
                    "type": "number"
                  }
                ],
                "tier": "presentation"
              },
              {
                "description": "Learner started the evolution; the grid advances one generation per tick until Pause.",
                "id": "evt_01M07580Z4AKJB3934MXE7S8SQ",
                "key": "RUN",
                "name": "Run",
                "tier": "domain"
              },
              {
                "description": "Learner froze the evolution; tapping and single-stepping still work.",
                "id": "evt_01M07580Z4SY527GW89VRZRM77",
                "key": "PAUSE",
                "name": "Pause",
                "tier": "domain"
              },
              {
                "description": "Learner advanced exactly one generation while paused — the microscope view of the rule.",
                "id": "evt_01M07580Z46A409AK5X875SRW8",
                "key": "STEP",
                "name": "Step",
                "tier": "domain"
              },
              {
                "description": "Learner tapped a cell on the canvas — the canvas callback wraps its click info as payload { id, type, index }, where index is the flat cell index; the cell toggles between empty and active, seeding or editing the world.",
                "id": "evt_01M07580Z41VWS89NNN7YDX34F",
                "key": "TAP_CELL",
                "name": "Tap Cell",
                "payloadSchema": [
                  {
                    "name": "payload",
                    "properties": [
                      {
                        "name": "id",
                        "type": "string"
