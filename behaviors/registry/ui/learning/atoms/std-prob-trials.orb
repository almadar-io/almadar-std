          "id": "trt_01KZEJ8QE0KYBSE065SR8C4M6Q",
          "linkedEntity": "ProbTrialsScene",
          "linkedEntityId": "ent_01KZEJ8QE0CXDV5ZJH0DA17W5P",
          "name": "ProbTrialsSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEJ8QE05FAW6P5VRDPZBQFN",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEJ8QE2J9NADTEKM8VT109E",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01M04ANCX9QR0GCN5DNDBH3KKY",
                "key": "TRIAL",
                "name": "Trial"
              },
              {
                "id": "evt_01M04ANCX998T5GH1SAKPBHNFP",
                "key": "RUN",
                "name": "Run"
              },
              {
                "id": "evt_01M04ANCX9WQSZ8PX0END3Z3DS",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The accumulated per-outcome counts, total draws, and narration after each Roll, Run tick, or Reset — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04ANCX9SS2YDXDB5GZB58R1",
                "key": "TRIALS_UPDATED",
                "name": "Trials Updated",
                "payloadSchema": [
                  {
                    "name": "counts",
                    "type": "[number]"
                  },
                  {
                    "name": "total",
                    "type": "number"
                  },
                  {
                    "name": "narration",
                    "type": "string"
                  }
                ],
                "synonyms": "dice roll, coin flip, sampling, observed frequency, law of large numbers, trial run",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "n",
                        [
                          "array/len",
                          "@config.outcomes"
                        ]
                      ],
                      [
                        "sumP",
                        [
                          "array/sum",
                          "@config.outcomes",
                          "probability"
                        ]
                      ],
                      [
                        "expectedProbs",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "/",
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.outcomes",
                                  "@i"
                                ],
                                "probability"
                              ],
                              "@sumP"
                            ]
                          ]
                        ]
                      ],
                      [
                        "zeroCounts",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            0.0
                          ]
                        ]
                      ],
                      [
                        "plotW",
                        [
                          "-",
                          "@config.width",
                          48.0
                        ]
                      ],
                      [
                        "plotH",
                        [
                          "-",
                          "@config.height",
                          48.0
                        ]
                      ],
                      [
                        "observedProps",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            0.0
                          ]
                        ]
                      ],
                      [
                        "maxExpected",
                        [
                          "math/max",
                          [
                            "array/max",
                            "@expectedProbs"
                          ],
                          0.0001
                        ]
                      ],
                      [
                        "maxObserved",
                        [
                          "math/max",
                          [
                            "array/max",
                            "@observedProps"
                          ],
                          0.0001
                        ]
                      ],
                      [
                        "maxVal",
                        [
                          "*",
                          [
                            "math/max",
                            "@maxExpected",
                            "@maxObserved"
                          ],
                          1.25
                        ]
                      ],
                      [
                        "barW",
                        [
                          "/",
                          "@plotW",
                          "@n"
                        ]
                      ],
                      [
                        "barShapes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "barH",
                                  [
                                    "*",
                                    [
                                      "/",
                                      [
                                        "array/nth",
                                        "@observedProps",
                                        "@i"
                                      ],
                                      "@maxVal"
                                    ],
                                    "@plotH"
                                  ]
                                ],
                                [
                                  "outcome",
                                  [
                                    "array/nth",
                                    "@config.outcomes",
                                    "@i"
                                  ]
                                ]
                              ],
                              {
                                "fill": [
                                  "object/get",
                                  "@outcome",
                                  "color"
                                ],
                                "height": "@barH",
                                "lineWidth": 0.0,
                                "opacity": 0.85,
                                "type": "rect",
                                "width": [
                                  "*",
                                  "@barW",
                                  0.6
                                ],
                                "x": [
                                  "+",
                                  24.0,
                                  [
                                    "*",
                                    "@i",
                                    "@barW"
                                  ]
                                ],
                                "y": [
                                  "-",
                                  [
                                    "+",
                                    24.0,
                                    "@plotH"
                                  ],
                                  "@barH"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "expectedShapes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            {
                              "fill": "#111827",
                              "lineWidth": 0.0,
                              "radius": 5.0,
                              "type": "circle",
                              "x": [
                                "+",
                                24.0,
                                [
                                  "*",
                                  [
                                    "+",
                                    "@i",
                                    0.5
                                  ],
                                  "@barW"
                                ]
                              ],
                              "y": [
                                "-",
                                [
                                  "+",
                                  24.0,
                                  "@plotH"
                                ],
                                [
                                  "*",
                                  [
                                    "/",
                                    [
                                      "array/nth",
                                      "@expectedProbs",
                                      "@i"
                                    ],
                                    "@maxVal"
                                  ],
                                  "@plotH"
                                ]
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "labelShapes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "outcome",
                                  [
                                    "array/nth",
                                    "@config.outcomes",
                                    "@i"
                                  ]
                                ]
                              ],
                              {
                                "align": "center",
                                "color": "#111827",
                                "fontSize": 11.0,
                                "text": [
                                  "str/concat",
                                  [
                                    "object/get",
                                    "@outcome",
                                    "label"
                                  ],
                                  ": ",
                                  [
                                    "str/concat",
                                    "",
                                    [
                                      "array/nth",
                                      "@zeroCounts",
                                      "@i"
                                    ]
                                  ]
                                ],
                                "type": "text",
                                "x": [
                                  "+",
                                  24.0,
                                  [
                                    "*",
                                    [
                                      "+",
                                      "@i",
                                      0.5
                                    ],
                                    "@barW"
                                  ]
                                ],
                                "y": [
                                  "+",
                                  [
                                    "+",
                                    24.0,
                                    "@plotH"
                                  ],
                                  16.0
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "shapes",
                        [
                          "array/concat",
                          [
                            {
                              "color": "#cbd5e1",
                              "lineWidth": 1.0,
                              "type": "line",
                              "x1": 24.0,
                              "x2": [
                                "+",
                                24.0,
                                "@plotW"
                              ],
                              "y1": [
                                "+",
                                24.0,
                                "@plotH"
                              ],
                              "y2": [
                                "+",
                                24.0,
                                "@plotH"
                              ]
                            }
                          ],
                          [
                            "array/concat",
                            "@barShapes",
                            [
                              "array/concat",
                              "@expectedShapes",
                              "@labelShapes"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.counts",
                        "@zeroCounts"
                      ],
                      [
                        "set",
                        "@entity.total",
                        0.0
                      ],
                      [
