                            ],
                            {
                              "align": "center",
                              "color": "#111827",
                              "fontSize": 11.0,
                              "text": [
                                "str/concat",
                                [
                                  "object/get",
                                  "@outcome",
                                  "label"
                                ],
                                ": ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "array/nth",
                                    "@newCounts",
                                    "@i"
                                  ]
                                ]
                              ],
                              "type": "text",
                              "x": [
                                "+",
                                24.0,
                                [
                                  "*",
                                  [
                                    "+",
                                    "@i",
                                    0.5
                                  ],
                                  "@barW"
                                ]
                              ],
                              "y": [
                                "+",
                                [
                                  "+",
                                  24.0,
                                  "@plotH"
                                ],
                                16.0
                              ]
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "shapes",
                      [
                        "array/concat",
                        [
                          {
                            "color": "#cbd5e1",
                            "lineWidth": 1.0,
                            "type": "line",
                            "x1": 24.0,
                            "x2": [
                              "+",
                              24.0,
                              "@plotW"
                            ],
                            "y1": [
                              "+",
                              24.0,
                              "@plotH"
                            ],
                            "y2": [
                              "+",
                              24.0,
                              "@plotH"
                            ]
                          }
                        ],
                        [
                          "array/concat",
                          "@barShapes",
                          [
                            "array/concat",
                            "@expectedShapes",
                            "@labelShapes"
                          ]
                        ]
                      ]
                    ],
                    [
                      "observedPct",
                      [
                        "math/round",
                        [
                          "*",
                          [
                            "array/nth",
                            "@observedProps",
                            "@rolledIdx"
                          ],
                          100.0
                        ],
                        1.0
                      ]
                    ],
                    [
                      "expectedPct",
                      [
                        "math/round",
                        [
                          "*",
                          [
                            "array/nth",
                            "@expectedProbs",
                            "@rolledIdx"
                          ],
                          100.0
                        ],
                        1.0
                      ]
                    ],
                    [
                      "narration",
                      [
                        "str/concat",
                        "trial ",
                        [
                          "str/concat",
                          "",
                          "@newTotal"
                        ],
                        " — rolled ",
                        [
                          "object/get",
                          "@rolledOutcome",
                          "label"
                        ],
                        "; observed ",
                        [
                          "str/concat",
                          "",
                          "@observedPct"
                        ],
                        "% vs expected ",
                        [
                          "str/concat",
                          "",
                          "@expectedPct"
                        ],
                        "%"
                      ]
                    ]
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.counts",
                      "@newCounts"
                    ],
                    [
                      "set",
                      "@entity.total",
                      "@newTotal"
                    ],
                    [
                      "set",
                      "@entity.narration",
                      "@narration"
                    ],
                    [
                      "set",
                      "@entity.shapes",
                      "@shapes"
                    ]
                  ]
                ],
                [
                  "render-ui",
                  "main",
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "children": [
                              {
                                "action": "TRIAL",
                                "label": "Roll",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "RUN",
                                "label": "Run",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "RESET",
                                "label": "Reset",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "content": [
                              "str/concat",
                              "Total trials: ",
                              [
                                "str/concat",
                                "",
                                "@entity.total"
                              ]
                            ],
                            "type": "typography",
                            "variant": "caption"
                          },
                          {
                            "animate": "@config.animate",
                            "curves": [],
                            "gridStep": "@config.gridStep",
                            "height": "@config.height",
                            "interactive": "@config.interactive",
                            "points": [],
                            "shapes": "@entity.shapes",
                            "showAxes": "@config.showAxes",
                            "showGrid": "@config.showGrid",
                            "type": "math-canvas",
                            "vectors": [],
                            "width": "@config.width",
                            "xMax": [
                              "array/len",
                              "@config.outcomes"
                            ],
                            "xMin": 0.0,
                            "yMax": 1.0,
                            "yMin": 0.0
                          },
                          {
                            "content": "@entity.narration",
                            "type": "typography",
                            "variant": "body"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ],
                [
                  "emit",
                  "TRIALS_UPDATED",
                  {
                    "counts": "@entity.counts",
                    "narration": "@entity.narration",
                    "total": "@entity.total"
                  }
                ]
              ],
              "guard": [
                "and",
                "@entity.active",
                "@entity.running"
              ],
              "interval": 500.0,
              "name": "trialsTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}