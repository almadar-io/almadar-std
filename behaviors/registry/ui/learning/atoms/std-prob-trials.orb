                {
                  "color": "#16a34a",
                  "label": "6",
                  "probability": 0.1667
                }
              ],
              "description": "The sample space each trial draws from — label, relative probability (weights are normalized, needn't sum to 1), and bar color. Default is a fair six-sided die; a coin flip, a weighted spinner, or any categorical distribution is just a different outcomes list.",
              "items": {
                "properties": {
                  "color": {
