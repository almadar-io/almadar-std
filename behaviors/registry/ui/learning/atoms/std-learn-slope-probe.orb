      },
      "id": "orb_01M0PCKHE1NHAQJX69K4B0BDYN",
      "name": "LearnSlopeProbeOrbital",
      "pages": [
        {
          "id": "pag_01M0PCKHE1E5THPAXQSJ3SX27B",
          "name": "LearnSlopeProbePage",
          "path": "/learn-slope-probe",
          "traits": [
            {
              "ref": "LearnSlopeProbe",
              "refId": "trt_01M0PCKHE1M92GK1XB3S6AJ740"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "curve": {
              "default": [],
              "description": "Surface samples (x strictly increasing) of the graph being ridden — the same table the body skates and the canvas draws, so the readout matches what is underfoot.",
              "items": {
                "properties": {
                  "x": {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  "y": {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Curve",
              "tier": "domain",
              "type": "[ProbeSample]"
            },
            "running": {
              "default": true,
              "description": "When true the probe derives the readout off BODY_MOVED; toggle to freeze it (the board hides the tangent overlays when probing goes stale).",
              "label": "Running",
              "tier": "domain",
              "type": "boolean"
            },
            "triRun": {
              "default": 1.0,
              "description": "Horizontal leg of the rise-over-run triangle; the vertical leg is slope × triRun, so triRun = 1 reads the slope directly.",
              "label": "Triangle Run",
              "tier": "presentation",
              "type": "number"
            },
            "window": {
              "default": 1.5,
              "description": "Half-length (world units along the tangent) of the tangent segment and of the glow sample window around the contact point.",
              "label": "Tangent Window",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The local dy/dx crossed a 0.5 bucket boundary while the probe was active; slope is exact, bucket is the rounded step — fx/HUD scale with steepness without paying per-tick events.",
              "event": "SLOPE_CHANGED",
              "eventId": "evt_01M0PCKHE12DGVT5B7T3TPJ62C",
              "payloadSchema": [
                {
                  "name": "slope",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "bucket",
                  "required": true,
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "bucket",
              "probing",
              "segment",
              "slope",
              "tax",
              "tay",
              "tbx",
              "tby",
              "triAx",
              "triAy",
              "triBx",
              "triBy",
              "triCx",
              "triCy",
              "x",
              "y"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SlopeProbeState": "ent_01M0PCKHE11KYZX94KWC57GXV6"
          },
          "id": "trt_01M0PCKHE1M92GK1XB3S6AJ740",
          "linkedEntity": "SlopeProbeState",
          "linkedEntityId": "ent_01M0PCKHE11KYZX94KWC57GXV6",
          "name": "LearnSlopeProbe",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0PCKHE128V5KDZKW5641SC0",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M0PCKHE13WYBS0FD96E41N8P",
                "key": "BODY_MOVED",
                "name": "Body Moved",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vx",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vy",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "grounded",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "skating",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "speed",
                    "required": true,
                    "type": "number"
                  }
                ]
              },
              {
                "id": "evt_01M0PCKHE1NS3DMPSXV27AB9PC",
                "key": "RESTART",
                "name": "Restart",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              },
              {
                "description": "The local dy/dx crossed a 0.5 bucket boundary while the probe was active; slope is exact, bucket is the rounded step — fx/HUD scale with steepness without paying per-tick events.",
                "id": "evt_01M0PCKHE12DGVT5B7T3TPJ62C",
                "key": "SLOPE_CHANGED",
                "name": "Slope Changed",
                "payloadSchema": [
                  {
                    "name": "slope",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "bucket",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.probing",
                    false
                  ],
                  [
                    "set",
                    "@entity.segment",
                    []
                  ],
                  [
                    "set",
                    "@entity.bucket",
                    9999.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0PCKHE128V5KDZKW5641SC0",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "on",
                        [
                          "and",
                          "@payload.skating",
                          [
                            ">",
                            [
                              "array/len",
                              "@config.curve"
                            ],
                            1.0
                          ]
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "inRange",
                          [
                            "and",
                            "@on",
                            [
                              "and",
                              [
                                ">=",
                                "@payload.x",
                                [
                                  "object/get",
                                  [
                                    "array/first",
                                    "@config.curve"
                                  ],
                                  "x"
                                ]
                              ],
                              [
                                "<=",
                                "@payload.x",
                                [
                                  "object/get",
                                  [
                                    "array/last",
                                    "@config.curve"
                                  ],
                                  "x"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "if",
                        "@inRange",
                        [
                          "let",
                          [
                            [
                              "leftSamp",
                              [
                                "array/last",
                                [
                                  "array/filter",
                                  "@config.curve",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      "<=",
                                      [
                                        "object/get",
                                        "@s",
                                        "x"
                                      ],
                                      "@payload.x"
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "rightSamp",
                              [
                                "array/first",
                                [
                                  "array/filter",
                                  "@config.curve",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      ">",
                                      [
                                        "object/get",
                                        "@s",
                                        "x"
                                      ],
                                      "@payload.x"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "slope",
                                [
                                  "if",
                                  [
                                    "==",
                                    "@rightSamp",
                                    null
                                  ],
                                  0.0,
                                  [
                                    "/",
                                    [
                                      "-",
                                      [
                                        "object/get",
                                        "@rightSamp",
                                        "y"
                                      ],
                                      [
                                        "object/get",
                                        "@leftSamp",
                                        "y"
                                      ]
                                    ],
                                    [
                                      "-",
                                      [
                                        "object/get",
                                        "@rightSamp",
                                        "x"
                                      ],
                                      [
                                        "object/get",
                                        "@leftSamp",
                                        "x"
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "curveY",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@rightSamp",
                                      null
                                    ],
                                    [
                                      "object/get",
                                      "@leftSamp",
                                      "y"
                                    ],
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@leftSamp",
                                        "y"
                                      ],
                                      [
                                        "*",
                                        "@slope",
                                        [
                                          "-",
                                          "@payload.x",
                                          [
                                            "object/get",
                                            "@leftSamp",
                                            "x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "norm",
                                    [
                                      "math/sqrt",
                                      [
                                        "+",
                                        1.0,
                                        [
                                          "*",
                                          "@slope",
                                          "@slope"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "dx",
                                      [
                                        "/",
                                        "@config.window",
                                        "@norm"
                                      ]
                                    ],
                                    [
                                      "dy",
                                      [
                                        "/",
                                        [
                                          "*",
                                          "@slope",
                                          "@config.window"
                                        ],
                                        "@norm"
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "newBucket",
                                        [
                                          "*",
                                          [
                                            "math/round",
                                            [
                                              "*",
                                              "@slope",
                                              2.0
                                            ],
                                            0.0
                                          ],
                                          0.5
                                        ]
                                      ]
                                    ],
                                    [
                                      "do",
                                      [
                                        "set",
                                        "@entity.probing",
                                        true
                                      ],
                                      [
                                        "set",
                                        "@entity.x",
                                        "@payload.x"
                                      ],
                                      [
                                        "set",
                                        "@entity.y",
                                        "@curveY"
                                      ],
                                      [
                                        "set",
                                        "@entity.slope",
                                        "@slope"
                                      ],
                                      [
                                        "set",
                                        "@entity.tax",
                                        [
                                          "-",
                                          "@payload.x",
                                          "@dx"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.tay",
                                        [
                                          "-",
                                          "@curveY",
                                          "@dy"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.tbx",
                                        [
                                          "+",
                                          "@payload.x",
                                          "@dx"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.tby",
                                        [
                                          "+",
                                          "@curveY",
                                          "@dy"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.triAx",
                                        "@payload.x"
                                      ],
                                      [
                                        "set",
                                        "@entity.triAy",
                                        "@curveY"
                                      ],
                                      [
                                        "set",
                                        "@entity.triBx",
                                        [
                                          "+",
                                          "@payload.x",
                                          "@config.triRun"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.triBy",
                                        "@curveY"
                                      ],
                                      [
                                        "set",
                                        "@entity.triCx",
                                        [
                                          "+",
                                          "@payload.x",
                                          "@config.triRun"
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.triCy",
                                        [
                                          "+",
                                          "@curveY",
                                          [
                                            "*",
                                            "@slope",
                                            "@config.triRun"
                                          ]
                                        ]
                                      ],
                                      [
                                        "set",
                                        "@entity.segment",
                                        [
                                          "array/filter",
                                          "@config.curve",
                                          [
                                            "fn",
                                            "s",
                                            [
                                              "and",
                                              [
                                                ">=",
                                                [
                                                  "object/get",
                                                  "@s",
                                                  "x"
                                                ],
                                                [
                                                  "-",
                                                  "@payload.x",
                                                  "@config.window"
                                                ]
                                              ],
                                              [
                                                "<=",
                                                [
                                                  "object/get",
                                                  "@s",
                                                  "x"
                                                ],
                                                [
                                                  "+",
                                                  "@payload.x",
                                                  "@config.window"
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        "if",
                                        [
                                          "!=",
                                          "@newBucket",
                                          "@entity.bucket"
                                        ],
                                        [
                                          "do",
                                          [
                                            "set",
                                            "@entity.bucket",
                                            "@newBucket"
                                          ],
                                          [
                                            "emit",
                                            "SLOPE_CHANGED",
                                            {
                                              "bucket": "@newBucket",
                                              "slope": "@slope"
                                            }
                                          ]
                                        ],
                                        null
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "if",
                          "@entity.probing",
                          [
                            "do",
                            [
                              "set",
                              "@entity.probing",
                              false
                            ],
                            [
                              "set",
                              "@entity.segment",
                              []
                            ]
                          ],
                          null
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "BODY_MOVED",
                "eventId": "evt_01M0PCKHE13WYBS0FD96E41N8P",
                "from": "idle",
                "guard": "@config.running",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.probing",
                    false
                  ],
                  [
                    "set",
                    "@entity.segment",
                    []
                  ],
                  [
                    "set",
                    "@entity.bucket",
                    9999.0
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M0PCKHE1NS3DMPSXV27AB9PC",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}
