          },
          "id": "trt_01KZNG49YGYAD8JPED4CJBY47M",
          "linkedEntity": "MathQuadraticState",
          "linkedEntityId": "ent_01KZNG49YG4BEJWJFDQW1D4KNZ",
          "name": "MathQuadraticSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNG49YG69ZJG1FB2W5QFPH2",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNG49YJQ5C66YQM42C0KSM7",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the leading-coefficient slider to set a in y = ax² + bx + c.",
                "id": "evt_01KZNG49YJBZ95702ZA3HA1NQW",
                "key": "SET_A",
                "name": "Set A",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the linear-coefficient slider to set b in y = ax² + bx + c.",
                "id": "evt_01KZNG49YJQ1PNRHQYGY67ERJS",
                "key": "SET_B",
                "name": "Set B",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the constant-term slider to set c in y = ax² + bx + c.",
                "id": "evt_01KZNG49YJQRT5TH842Q7PM365",
                "key": "SET_C",
                "name": "Set C",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNG49YJSAT1KTNDMVQAJDEY",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The parabola's coefficients and derived readouts after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNG49YJR682FJCP21S053XN",
                "key": "QUADRATIC_UPDATED",
                "name": "Quadratic Updated",
                "payloadSchema": [
                  {
                    "name": "a",
                    "type": "number"
                  },
                  {
                    "name": "b",
                    "type": "number"
                  },
                  {
                    "name": "c",
                    "type": "number"
                  },
                  {
                    "name": "vertexX",
                    "type": "number"
                  },
                  {
                    "name": "vertexY",
                    "type": "number"
                  },
                  {
                    "name": "discriminant",
                    "type": "number"
                  },
                  {
                    "name": "rootsLabel",
                    "type": "string"
                  }
                ],
                "synonyms": "parabola update, quadratic, coefficients, vertex, roots, discriminant",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.a",
                    "@config.initialA"
                  ],
                  [
                    "set",
                    "@entity.b",
                    "@config.initialB"
                  ],
                  [
                    "set",
                    "@entity.c",
                    "@config.initialC"
                  ],
                  [
                    "let",
                    [
                      [
                        "aSafe",
                        [
                          "if",
                          [
                            "<",
                            [
                              "math/abs",
                              "@entity.a"
                            ],
                            0.05
                          ],
                          [
                            "if",
                            [
                              "<",
                              "@entity.a",
                              0.0
                            ],
                            -0.05,
                            0.05
                          ],
                          "@entity.a"
                        ]
                      ],
                      [
                        "vx",
                        [
                          "/",
                          [
                            "-",
                            0.0,
                            "@entity.b"
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "vy",
                        [
                          "+",
                          [
                            "*",
                            "@entity.a",
                            [
                              "*",
                              "@vx",
                              "@vx"
                            ]
                          ],
                          [
                            "+",
                            [
                              "*",
                              "@entity.b",
                              "@vx"
                            ],
                            "@entity.c"
                          ]
                        ]
                      ],
                      [
                        "disc",
                        [
                          "-",
                          [
                            "*",
                            "@entity.b",
                            "@entity.b"
                          ],
                          [
                            "*",
                            4.0,
                            [
                              "*",
                              "@entity.a",
                              "@entity.c"
                            ]
                          ]
                        ]
                      ],
                      [
                        "discPos",
                        [
                          "math/max",
                          0.0,
                          "@disc"
                        ]
                      ],
                      [
                        "r1",
                        [
                          "/",
                          [
                            "+",
                            [
                              "-",
                              0.0,
                              "@entity.b"
                            ],
                            [
                              "math/sqrt",
                              "@discPos"
                            ]
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "r2",
                        [
                          "/",
                          [
                            "-",
                            [
                              "-",
                              0.0,
                              "@entity.b"
                            ],
                            [
                              "math/sqrt",
                              "@discPos"
                            ]
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "rootLabel",
                        [
                          "if",
                          [
                            ">",
                            "@disc",
                            0.0001
                          ],
                          [
                            "str/concat",
                            "Two real roots: x = ",
                            [
                              "math/round",
                              "@r1",
                              2.0
                            ],
                            " and x = ",
                            [
                              "math/round",
                              "@r2",
                              2.0
                            ]
                          ],
                          [
                            "if",
                            [
                              ">",
                              "@disc",
                              -0.0001
                            ],
                            [
                              "str/concat",
                              "One repeated root: x = ",
                              [
                                "math/round",
                                "@r1",
                                2.0
                              ]
                            ],
                            "No real roots — the discriminant is negative"
                          ]
                        ]
                      ],
                      [
                        "eqText",
                        [
                          "if",
                          [
                            "==",
                            "@config.form",
                            "vertex"
                          ],
                          [
                            "str/concat",
                            "y = ",
                            [
                              "math/round",
                              "@entity.a",
                              2.0
                            ],
                            "(x − ",
                            [
                              "math/round",
                              "@vx",
                              2.0
                            ],
                            ")² + ",
                            [
                              "math/round",
                              "@vy",
                              2.0
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@config.form",
                              "factored"
                            ],
                            [
                              "if",
                              [
                                ">",
                                "@disc",
                                0.0001
                              ],
                              [
                                "str/concat",
                                "y = ",
                                [
                                  "math/round",
                                  "@entity.a",
                                  2.0
                                ],
                                "(x − ",
                                [
                                  "math/round",
                                  "@r1",
                                  2.0
                                ],
                                ")(x − ",
                                [
                                  "math/round",
                                  "@r2",
                                  2.0
                                ],
                                ")"
                              ],
                              [
                                "if",
                                [
                                  ">",
                                  "@disc",
                                  -0.0001
                                ],
                                [
                                  "str/concat",
                                  "y = ",
                                  [
