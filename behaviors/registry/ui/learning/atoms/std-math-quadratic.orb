                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "na",
                        "@config.initialA"
                      ],
                      [
                        "nb",
                        "@config.initialB"
                      ],
                      [
                        "nc",
                        "@config.initialC"
                      ],
                      [
                        "aSafe",
                        [
                          "if",
                          [
                            "<",
                            [
                              "math/abs",
                              "@na"
                            ],
                            0.05
                          ],
                          [
                            "if",
                            [
                              "<",
                              "@na",
                              0.0
                            ],
                            -0.05,
                            0.05
                          ],
                          "@na"
                        ]
                      ],
                      [
                        "vx",
                        [
                          "/",
                          [
                            "-",
                            0.0,
                            "@nb"
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "vy",
                        [
                          "+",
                          [
                            "*",
                            "@na",
                            [
                              "*",
                              "@vx",
                              "@vx"
                            ]
                          ],
                          [
                            "+",
                            [
                              "*",
                              "@nb",
                              "@vx"
                            ],
                            "@nc"
                          ]
                        ]
                      ],
                      [
                        "disc",
                        [
                          "-",
                          [
                            "*",
                            "@nb",
                            "@nb"
                          ],
                          [
                            "*",
                            4.0,
                            [
                              "*",
                              "@na",
                              "@nc"
                            ]
                          ]
                        ]
                      ],
                      [
                        "discPos",
                        [
                          "math/max",
                          0.0,
                          "@disc"
                        ]
                      ],
                      [
                        "r1",
                        [
                          "/",
                          [
                            "+",
                            [
                              "-",
                              0.0,
                              "@nb"
                            ],
                            [
                              "math/sqrt",
                              "@discPos"
                            ]
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "r2",
                        [
                          "/",
                          [
                            "-",
                            [
                              "-",
                              0.0,
                              "@nb"
                            ],
                            [
                              "math/sqrt",
                              "@discPos"
                            ]
                          ],
                          [
                            "*",
                            2.0,
                            "@aSafe"
                          ]
                        ]
                      ],
                      [
                        "rootLabel",
                        [
                          "if",
                          [
                            ">",
                            "@disc",
                            0.0001
                          ],
                          [
                            "str/concat",
                            "Two real roots: x = ",
                            [
                              "math/round",
                              "@r1",
                              2.0
                            ],
                            " and x = ",
                            [
                              "math/round",
                              "@r2",
                              2.0
                            ]
                          ],
                          [
                            "if",
                            [
                              ">",
                              "@disc",
                              -0.0001
                            ],
                            [
                              "str/concat",
                              "One repeated root: x = ",
                              [
                                "math/round",
                                "@r1",
                                2.0
                              ]
                            ],
                            "No real roots — the discriminant is negative"
                          ]
                        ]
                      ],
                      [
                        "eqText",
                        [
                          "if",
                          [
                            "==",
                            "@config.form",
                            "vertex"
                          ],
                          [
                            "str/concat",
                            "y = ",
                            [
                              "math/round",
                              "@na",
                              2.0
                            ],
                            "(x − ",
                            [
                              "math/round",
                              "@vx",
                              2.0
                            ],
                            ")² + ",
                            [
                              "math/round",
                              "@vy",
                              2.0
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@config.form",
                              "factored"
                            ],
                            [
                              "if",
                              [
                                ">",
                                "@disc",
                                0.0001
                              ],
                              [
                                "str/concat",
                                "y = ",
                                [
                                  "math/round",
                                  "@na",
                                  2.0
                                ],
                                "(x − ",
                                [
                                  "math/round",
                                  "@r1",
                                  2.0
                                ],
                                ")(x − ",
                                [
                                  "math/round",
                                  "@r2",
                                  2.0
                                ],
                                ")"
                              ],
                              [
                                "if",
                                [
                                  ">",
                                  "@disc",
                                  -0.0001
                                ],
                                [
                                  "str/concat",
                                  "y = ",
                                  [
                                    "math/round",
                                    "@na",
                                    2.0
                                  ],
                                  "(x − ",
                                  [
                                    "math/round",
                                    "@r1",
                                    2.0
                                  ],
                                  ")²"
                                ],
                                "Not factorable over the real numbers — the discriminant is negative"
                              ]
                            ],
                            [
                              "str/concat",
                              "y = ",
                              [
                                "math/round",
                                "@na",
                                2.0
                              ],
                              "x² + ",
                              [
                                "math/round",
                                "@nb",
                                2.0
                              ],
                              "x + ",
                              [
                                "math/round",
                                "@nc",
                                2.0
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "parabola",
                        {
                          "color": "@config.curveColor",
                          "label": "parabola",
                          "samples": [
                            "array/map",
                            "@config.sampleXs",
                            [
                              "fn",
                              "x",
                              {
                                "x": "@x",
                                "y": [
                                  "+",
                                  [
                                    "*",
                                    "@na",
                                    [
                                      "*",
                                      "@x",
                                      "@x"
                                    ]
                                  ],
                                  [
                                    "+",
                                    [
                                      "*",
                                      "@nb",
                                      "@x"
                                    ],
                                    "@nc"
                                  ]
                                ]
                              }
                            ]
                          ]
                        }
                      ],
                      [
                        "axisLine",
                        {
                          "color": "@config.axisColor",
                          "label": "axis of symmetry",
                          "samples": [
                            {
                              "x": "@vx",
                              "y": "@config.yMin"
                            },
                            {
                              "x": "@vx",
                              "y": "@config.yMax"
                            }
                          ]
                        }
                      ],
                      [
                        "rootPts",
                        [
                          "if",
                          [
                            ">",
                            "@disc",
                            0.0001
                          ],
                          [
                            {
                              "color": "@config.rootColor",
                              "label": "root",
                              "radius": 5.0,
                              "x": "@r1",
                              "y": 0.0
                            },
                            {
                              "color": "@config.rootColor",
                              "label": "root",
                              "radius": 5.0,
                              "x": "@r2",
                              "y": 0.0
                            }
                          ],
                          [
                            "if",
                            [
                              ">",
                              "@disc",
                              -0.0001
                            ],
                            [
                              {
                                "color": "@config.rootColor",
                                "label": "root",
                                "radius": 5.0,
                                "x": "@r1",
                                "y": 0.0
                              }
                            ],
                            []
                          ]
                        ]
                      ],
                      [
                        "focusPts",
                        [
                          "if",
                          "@config.showFocus",
                          [
                            {
                              "color": "@config.focusColor",
                              "label": "focus",
                              "radius": 5.0,
                              "x": "@vx",
                              "y": [
                                "+",
                                "@vy",
                                [
                                  "/",
                                  1.0,
                                  [
                                    "*",
                                    4.0,
                                    "@aSafe"
                                  ]
                                ]
                              ]
                            }
                          ],
                          []
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.a",
                        "@na"
                      ],
                      [
                        "set",
                        "@entity.b",
                        "@nb"
                      ],
                      [
                        "set",
                        "@entity.c",
                        "@nc"
                      ],
                      [
                        "set",
                        "@entity.vertexX",
                        "@vx"
                      ],
                      [
                        "set",
                        "@entity.vertexY",
                        "@vy"
                      ],
                      [
                        "set",
                        "@entity.discriminant",
                        "@disc"
                      ],
                      [
                        "set",
                        "@entity.equationLabel",
                        "@eqText"
                      ],
                      [
                        "set",
                        "@entity.rootsLabel",
                        "@rootLabel"
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          "@parabola",
                          "@axisLine"
                        ]
                      ],
                      [
                        "set",
                        "@entity.points",
                        [
                          "array/concat",
                          [
                            {
                              "color": "@config.vertexColor",
                              "label": "vertex",
                              "radius": 6.0,
                              "x": "@vx",
                              "y": "@vy"
                            }
                          ],
                          [
                            "array/concat",
                            "@rootPts",
                            "@focusPts"
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "animate": false,
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": false,
                              "points": "@entity.points",
                              "shapes": [],
                              "showAxes": "@config.showAxes",
                              "showGrid": "@config.showGrid",
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.xMax",
                              "xMin": "@config.xMin",
                              "yMax": "@config.yMax",
                              "yMin": "@config.yMin"
                            },
                            {
                              "children": [
                                {
                                  "children": [
                                    {
                                      "content": [
                                        "str/concat",
                                        "a = ",
                                        [
                                          "math/round",
                                          "@entity.a",
                                          2.0
                                        ]
                                      ],
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 3.0,
                                      "min": -3.0,
                                      "onChange": "SET_A",
                                      "showTooltip": true,
                                      "step": 0.25,
                                      "type": "range-slider",
                                      "value": "@entity.a"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "content": [
                                        "str/concat",
                                        "b = ",
                                        [
                                          "math/round",
                                          "@entity.b",
                                          2.0
                                        ]
                                      ],
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 10.0,
                                      "min": -10.0,
                                      "onChange": "SET_B",
                                      "showTooltip": true,
                                      "step": 0.5,
                                      "type": "range-slider",
                                      "value": "@entity.b"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "content": [
                                        "str/concat",
                                        "c = ",
                                        [
                                          "math/round",
                                          "@entity.c",
                                          2.0
                                        ]
                                      ],
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 10.0,
                                      "min": -10.0,
                                      "onChange": "SET_C",
                                      "showTooltip": true,
                                      "step": 0.5,
                                      "type": "range-slider",
                                      "value": "@entity.c"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "md",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.equationLabel",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Vertex (",
                                [
                                  "math/round",
                                  "@entity.vertexX",
                                  2.0
                                ],
                                ", ",
                                [
                                  "math/round",
                                  "@entity.vertexY",
                                  2.0
                                ],
                                ") · axis of symmetry x = ",
                                [
                                  "math/round",
                                  "@entity.vertexX",
                                  2.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": "@entity.rootsLabel",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "if",
                                "@config.showDiscriminant",
                                [
                                  "str/concat",
                                  "Discriminant Δ = b² − 4ac = ",
                                  [
                                    "math/round",
                                    "@entity.discriminant",
                                    2.0
                                  ]
                                ],
                                ""
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "QUADRATIC_UPDATED",
                    {
                      "a": "@entity.a",
                      "b": "@entity.b",
                      "c": "@entity.c",
                      "discriminant": "@entity.discriminant",
                      "rootsLabel": "@entity.rootsLabel",
                      "vertexX": "@entity.vertexX",
                      "vertexY": "@entity.vertexY"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KZNG49YJSAT1KTNDMVQAJDEY",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}