                        ]
                      ],
                      [
                        "aSafe",
                        [
                          "if",
                          [
                            "<",
                            [
                              "math/abs",
                              "@entity.a"
                            ],
                            0.05
                          ],
                          [
                            "if",
                            [
                              "<",
                              "@entity.a",
                              0.0
                            ],
