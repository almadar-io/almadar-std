          "id": "trt_01KZNFCQ0G70FACQ26QNA0AAJ7",
          "linkedEntity": "LogicFallacyState",
          "linkedEntityId": "ent_01KZNFCQ0GKKF8M4K5G69DAP4G",
          "name": "LogicFallacySim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNFCQ0GFWM9R4C5H5DVQHFN",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNFCQ0HRPYS2FMGD2RASXGM",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner classified the current argument as valid or as a named fallacy; the first pick per item is verdicted and scored.",
                "id": "evt_01KZNFCQ0HBWST2YMD86WQ4D17",
                "key": "PICK_LABEL",
                "name": "Pick Label",
                "payloadSchema": [
                  {
                    "name": "label",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner asked for the answer and its explanation.",
                "id": "evt_01KZNFCQ0HXFEB5W1Y5TT6GWAM",
                "key": "REVEAL_ANSWER",
                "name": "Reveal Answer",
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next argument card in the corpus.",
                "id": "evt_01KZNFCQ0HGJFVA009RW4Z9Z13",
                "key": "NEXT_ITEM",
                "name": "Next Item",
                "tier": "domain"
              },
              {
                "description": "The classification state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNFCQ0H9DDM0H7W6MSFF1W0",
                "key": "FALLACY_UPDATED",
                "name": "Fallacy Updated",
                "payloadSchema": [
                  {
                    "name": "itemIndex",
                    "type": "number"
                  },
                  {
                    "name": "selectedLabel",
                    "type": "string"
                  },
                  {
                    "name": "revealed",
                    "type": "boolean"
                  },
                  {
                    "name": "correctCount",
                    "type": "number"
                  },
                  {
                    "name": "attemptedCount",
                    "type": "number"
                  }
                ],
                "synonyms": "fallacy classification, verdict, running score, argument card, informal fallacy",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.itemIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.selectedLabel",
                    ""
                  ],
                  [
                    "set",
                    "@entity.revealed",
                    false
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    ""
                  ],
                  [
                    "set",
                    "@entity.correctCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.attemptedCount",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "n",
                        [
                          "array/len",
                          "@config.fallacySet"
                        ]
                      ],
                      [
                        "gap",
                        12.0
                      ],
                      [
                        "boxW",
                        [
                          "/",
                          [
                            "-",
                            "@config.width",
                            [
                              "+",
                              [
                                "*",
                                20.0,
                                2.0
                              ],
                              [
                                "*",
                                "@gap",
                                [
                                  "-",
                                  "@n",
                                  1.0
                                ]
                              ]
                            ]
                          ],
                          "@n"
                        ]
                      ],
                      [
                        "boxH",
                        70.0
                      ],
                      [
                        "y",
                        [
                          "-",
                          [
                            "/",
                            "@config.height",
                            2.0
                          ],
                          [
                            "/",
                            "@boxH",
                            2.0
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.cardShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@n"
                            ],
                            [
                              "fn",
                              "i",
                              [
                                "let",
                                [
                                  [
                                    "entry",
                                    [
                                      "array/nth",
                                      "@config.fallacySet",
                                      "@i"
                                    ]
                                  ],
                                  [
                                    "x",
                                    [
                                      "+",
                                      20.0,
                                      [
                                        "*",
                                        "@i",
                                        [
                                          "+",
                                          "@boxW",
                                          "@gap"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "color": [
                                      "object/get",
                                      "@entry",
                                      "color"
                                    ],
                                    "fill": [
                                      "object/get",
                                      "@entry",
                                      "color"
                                    ],
                                    "height": "@boxH",
                                    "id": [
                                      "str/concat",
                                      "box-",
                                      "@i"
                                    ],
                                    "opacity": 0.9,
                                    "type": "rect",
                                    "width": "@boxW",
                                    "x": "@x",
                                    "y": "@y"
                                  },
                                  {
                                    "align": "center",
                                    "color": "#0f172a",
                                    "fontSize": 13.0,
                                    "id": [
                                      "str/concat",
                                      "box-label-",
                                      "@i"
                                    ],
                                    "text": [
                                      "object/get",
                                      "@entry",
                                      "label"
                                    ],
                                    "type": "text",
                                    "x": [
                                      "+",
                                      "@x",
                                      [
                                        "/",
                                        "@boxW",
                                        2.0
                                      ]
                                    ],
                                    "y": [
                                      "+",
                                      "@y",
                                      [
                                        "/",
                                        "@boxH",
                                        2.0
                                      ],
                                      5.0
                                    ]
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.corpus",
                                  "@entity.itemIndex"
                                ],
                                "text"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "if",
                                "@config.showHint",
                                [
                                  "object/get",
                                  [
                                    "array/nth",
                                    "@config.corpus",
                                    "@entity.itemIndex"
                                  ],
                                  "hint"
                                ],
                                ""
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.fallacySet",
                                [
                                  "fn",
                                  "f",
                                  {
                                    "action": "PICK_LABEL",
                                    "actionPayload": {
                                      "label": [
                                        "object/get",
                                        "@f",
                                        "value"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@f",
                                      "label"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.selectedLabel",
                                        [
                                          "object/get",
                                          "@f",
                                          "value"
                                        ]
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "REVEAL_ANSWER",
                                  "label": "Reveal Answer",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "NEXT_ITEM",
                                  "label": "Next Argument",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "animate": false,
                              "backgroundColor": "@config.backgroundColor",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "shapes": "@entity.cardShapes",
                              "type": "learning-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Score: ",
                                "@entity.correctCount",
                                "/",
                                "@entity.attemptedCount",
                                " — pass at ",
                                "@config.passScore"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZNFCQ0GFWM9R4C5H5DVQHFN",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.itemIndex",
                    0.0
                  ],
