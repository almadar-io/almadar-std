                    "type": "string"
                  },
                  "hint": {
                    "name": "hint",
                    "required": false,
                    "type": "string"
                  },
                  "text": {
                    "name": "text",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Corpus",
              "synonyms": "argument card, corpus, exercise set, fallacy example, argument",
              "tier": "domain",
              "type": "[LogicFallacyItem]"
            },
            "correctColor": {
              "default": "#86efac",
              "description": "Box color of the correct label once revealed.",
              "label": "Correct Color",
