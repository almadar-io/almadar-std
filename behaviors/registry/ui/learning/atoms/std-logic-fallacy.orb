      "traits": [
        {
          "category": "interaction",
          "config": {
            "backgroundColor": {
              "default": "#f8fafc",
              "description": "Canvas background color.",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "corpus": {
              "default": [
                {
                  "answer": "ad-hominem",
                  "explanation": "It attacks the person rather than the argument — ad hominem.",
                  "hint": "Does this engage the plan, or the person?",
                  "text": "You're only against the plan because you never liked me."
                },
                {
                  "answer": "false-dilemma",
                  "explanation": "It presents two extremes as the only possibilities — false dilemma.",
                  "hint": "Are those really the only two options?",
                  "text": "We either ban all cars or accept choking smog forever."
                },
                {
                  "answer": "affirming-the-consequent",
                  "explanation": "From P→Q and Q it concludes P — affirming the consequent.",
                  "hint": "Can the match be cancelled for another reason?",
                  "text": "If it rains, the match is cancelled. The match is cancelled, so it rained."
                },
                {
                  "answer": "straw-man",
                  "explanation": "It exaggerates the position into something easier to attack — straw man.",
                  "hint": "Is that really what he argued?",
                  "text": "He wants the library closed? Next he'll want books banned."
                },
                {
                  "answer": "valid",
                  "explanation": "The conclusion follows necessarily from the premises — a valid argument.",
                  "hint": "Does the conclusion follow from the premises?",
                  "text": "All mammals breathe air. Whales are mammals, so whales breathe air."
                }
              ],
              "description": "Argument cards (text, correct classification, hint, explanation) presented one at a time; the answer must be one of the fallacySet values.",
              "items": {
                "properties": {
                  "answer": {
                    "name": "answer",
                    "required": true,
                    "type": "string"
                  },
                  "explanation": {
                    "name": "explanation",
