                          "array/flatten",
                          [
                            "array/map",
                            [
                              "array/range",
                              "@n"
                            ],
                            [
                              "fn",
                              "i",
                              [
                                "let",
                                [
                                  [
                                    "entry",
                                    [
                                      "array/nth",
                                      "@config.fallacySet",
                                      "@i"
                                    ]
                                  ],
                                  [
                                    "x",
                                    [
                                      "+",
                                      20.0,
                                      [
                                        "*",
                                        "@i",
                                        [
                                          "+",
                                          "@boxW",
                                          "@gap"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  {
                                    "color": [
                                      "object/get",
                                      "@entry",
                                      "color"
                                    ],
                                    "fill": [
                                      "object/get",
                                      "@entry",
                                      "color"
                                    ],
                                    "height": "@boxH",
                                    "id": [
                                      "str/concat",
                                      "box-",
                                      "@i"
                                    ],
                                    "opacity": 0.9,
                                    "type": "rect",
                                    "width": "@boxW",
                                    "x": "@x",
                                    "y": "@y"
                                  },
                                  {
                                    "align": "center",
                                    "color": "#0f172a",
                                    "fontSize": 13.0,
                                    "id": [
                                      "str/concat",
                                      "box-label-",
                                      "@i"
                                    ],
                                    "text": [
                                      "object/get",
                                      "@entry",
                                      "label"
                                    ],
                                    "type": "text",
                                    "x": [
                                      "+",
                                      "@x",
                                      [
                                        "/",
                                        "@boxW",
                                        2.0
                                      ]
                                    ],
                                    "y": [
                                      "+",
                                      "@y",
                                      [
                                        "/",
                                        "@boxH",
                                        2.0
                                      ],
                                      5.0
                                    ]
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.corpus",
                                  "@entity.itemIndex"
                                ],
                                "text"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "if",
                                "@config.showHint",
                                [
                                  "object/get",
                                  [
                                    "array/nth",
                                    "@config.corpus",
                                    "@entity.itemIndex"
                                  ],
                                  "hint"
                                ],
                                ""
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.fallacySet",
                                [
                                  "fn",
                                  "f",
                                  {
                                    "action": "PICK_LABEL",
                                    "actionPayload": {
                                      "label": [
                                        "object/get",
                                        "@f",
                                        "value"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@f",
                                      "label"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.selectedLabel",
                                        [
                                          "object/get",
                                          "@f",
                                          "value"
                                        ]
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "REVEAL_ANSWER",
                                  "label": "Reveal Answer",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "NEXT_ITEM",
                                  "label": "Next Argument",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "animate": false,
                              "backgroundColor": "@config.backgroundColor",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "shapes": "@entity.cardShapes",
                              "type": "learning-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Score: ",
                                "@entity.correctCount",
                                "/",
                                "@entity.attemptedCount",
                                " — pass at ",
                                "@config.passScore"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "FALLACY_UPDATED",
                    {
                      "attemptedCount": "@entity.attemptedCount",
                      "correctCount": "@entity.correctCount",
                      "itemIndex": "@entity.itemIndex",
                      "revealed": "@entity.revealed",
                      "selectedLabel": "@entity.selectedLabel"
                    }
                  ]
                ],
                "event": "NEXT_ITEM",
                "eventId": "evt_01KZNFCQ0HGJFVA009RW4Z9Z13",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}