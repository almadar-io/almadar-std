              },
              {
                "id": "evt_01KZNG4A05BNXMG4ZDB973SJDK",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The Riemann-sum state after each step or learner action — a composed listener (readout, convergence chart, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNG4A05HAAYBXR58GS2ZN40",
                "key": "INTEGRAL_UPDATED",
                "name": "Integral Updated",
                "payloadSchema": [
                  {
                    "name": "method",
                    "type": "string"
                  },
                  {
                    "name": "rectangles",
                    "type": "number"
                  },
                  {
                    "name": "lowerBound",
                    "type": "number"
                  },
                  {
                    "name": "upperBound",
                    "type": "number"
                  },
                  {
                    "name": "approxArea",
                    "type": "number"
                  },
                  {
                    "name": "exactArea",
                    "type": "number"
                  }
                ],
                "synonyms": "riemann sum, integral, area under curve, rectangles, convergence",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.functionPreset",
                    "@config.functionPreset"
                  ],
                  [
                    "set",
                    "@entity.method",
                    "@config.method"
                  ],
                  [
                    "set",
                    "@entity.rectangles",
                    "@config.startRectangles"
                  ],
                  [
                    "set",
                    "@entity.lowerBound",
                    "@config.lowerBound"
                  ],
                  [
                    "set",
                    "@entity.upperBound",
                    "@config.upperBound"
                  ],
                  [
                    "let",
                    [
                      [
                        "dx",
                        [
                          "/",
                          [
                            "-",
                            "@entity.upperBound",
                            "@entity.lowerBound"
                          ],
                          "@entity.rectangles"
                        ]
                      ],
                      [
                        "ks",
                        [
                          "array/take",
                          "@config.binIndex",
                          "@entity.rectangles"
                        ]
                      ],
                      [
                        "lefts",
                        [
                          "array/map",
                          "@ks",
                          [
                            "fn",
                            "k",
                            [
                              "+",
                              "@entity.lowerBound",
                              [
                                "*",
                                "@k",
                                "@dx"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "fL",
                        [
                          "array/map",
                          "@lefts",
                          [
                            "fn",
                            "x",
                            [
                              "if",
                              [
                                "==",
                                "@entity.functionPreset",
                                "sine"
                              ],
                              [
                                "*",
                                3.0,
                                [
                                  "math/sin",
                                  "@x"
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  "@entity.functionPreset",
                                  "cubic"
                                ],
                                [
                                  "*",
                                  0.1,
                                  [
                                    "*",
                                    "@x",
                                    [
                                      "*",
                                      "@x",
                                      "@x"
                                    ]
                                  ]
                                ],
                                [
                                  "*",
                                  0.5,
                                  [
                                    "*",
                                    "@x",
                                    "@x"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "fR",
                        [
                          "array/map",
                          "@lefts",
                          [
                            "fn",
                            "x",
                            [
                              "if",
                              [
                                "==",
                                "@entity.functionPreset",
                                "sine"
                              ],
                              [
                                "*",
                                3.0,
                                [
                                  "math/sin",
                                  [
                                    "+",
                                    "@x",
                                    "@dx"
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  "@entity.functionPreset",
                                  "cubic"
                                ],
                                [
                                  "*",
                                  0.1,
                                  [
                                    "*",
                                    [
                                      "+",
                                      "@x",
                                      "@dx"
                                    ],
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@x",
                                        "@dx"
                                      ],
                                      [
                                        "+",
                                        "@x",
                                        "@dx"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "*",
                                  0.5,
                                  [
                                    "*",
                                    [
                                      "+",
                                      "@x",
                                      "@dx"
                                    ],
                                    [
                                      "+",
                                      "@x",
                                      "@dx"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "fM",
                        [
                          "array/map",
                          "@lefts",
                          [
                            "fn",
                            "x",
                            [
                              "if",
                              [
                                "==",
                                "@entity.functionPreset",
                                "sine"
                              ],
                              [
                                "*",
                                3.0,
                                [
                                  "math/sin",
                                  [
                                    "+",
                                    "@x",
                                    [
                                      "*",
                                      0.5,
                                      "@dx"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  "@entity.functionPreset",
                                  "cubic"
                                ],
                                [
                                  "*",
                                  0.1,
                                  [
                                    "*",
                                    [
                                      "+",
                                      "@x",
                                      [
                                        "*",
                                        0.5,
                                        "@dx"
                                      ]
                                    ],
                                    [
                                      "*",
                                      [
                                        "+",
                                        "@x",
                                        [
                                          "*",
                                          0.5,
                                          "@dx"
                                        ]
                                      ],
                                      [
                                        "+",
                                        "@x",
                                        [
                                          "*",
                                          0.5,
                                          "@dx"
                                        ]
                                      ]
