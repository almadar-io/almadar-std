                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNG4A05FERXEAXRKZY93A38",
                "key": "STEP_SUBDIVIDE",
                "name": "Step Subdivide"
              },
              {
                "description": "Learner picked a Riemann-sum rule: left, right, midpoint, or trapezoid.",
                "id": "evt_01KZNG4A05VM57DSNDW2QPMXPQ",
                "key": "SET_METHOD",
                "name": "Set Method",
                "payloadSchema": [
                  {
                    "name": "method",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged a bound slider to move the lower or upper integration bound.",
