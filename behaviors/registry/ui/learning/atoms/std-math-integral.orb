            "events": [
              {
                "id": "evt_01KZNG4A043SDG0DXE7F4EGWZJ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNG4A05W84DK10Y302D076D",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
