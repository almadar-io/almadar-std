          "stateMachine": {
            "events": [
              {
                "id": "evt_01M04DF7ZWR61PJMB3WHRD9ZV1",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M04DF7ZXE2GRKE7H809YQNDS",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner cycled one precinct's district assignment (1..districtCount, wrapping).",
                "id": "evt_01M04DF7ZXDRXPB04C3MP8KKEQ",
                "key": "ASSIGN_PRECINCT",
                "name": "Assign Precinct",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner asked to score the current map: seats per party, wasted votes, and the efficiency gap.",
                "id": "evt_01M04DF7ZXHMEHBXE66BXK8XQ6",
                "key": "EVALUATE",
                "name": "Evaluate",
                "tier": "domain"
              },
              {
                "description": "Learner reset precincts to the baseline row-band districts.",
                "id": "evt_01M04DF7ZX0EEMY2J0B0WT6GQF",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The districting state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04DF7ZX154ZWPE09XY25FZB",
                "key": "GERRYMANDER_UPDATED",
                "name": "Gerrymander Updated",
                "payloadSchema": [
                  {
                    "name": "seatsA",
                    "type": "number"
                  },
                  {
                    "name": "seatsB",
                    "type": "number"
                  },
                  {
                    "name": "wastedA",
                    "type": "number"
                  },
                  {
                    "name": "wastedB",
                    "type": "number"
                  },
                  {
                    "name": "efficiencyGap",
                    "type": "number"
                  },
                  {
                    "name": "evaluated",
                    "type": "boolean"
                  }
                ],
                "synonyms": "redistricting, gerrymander, packing, cracking, wasted votes, efficiency gap, seats won, district map",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.evaluated",
                    false
                  ],
                  [
                    "set",
                    "@entity.seatsA",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.seatsB",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.wastedA",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.wastedB",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.efficiencyGap",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "assignments",
                        [
                          "array/map",
                          "@config.grid",
                          [
                            "fn",
                            "p",
                            {
                              "district": [
                                "+",
                                [
                                  "object/get",
                                  "@p",
                                  "row"
                                ],
                                1.0
                              ],
                              "id": [
                                "object/get",
                                "@p",
                                "id"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "gapNote",
                        "Assign precincts to districts, then evaluate the map."
                      ],
                      [
                        "cellRects",
                        [
                          "array/map",
                          "@config.grid",
                          [
                            "fn",
                            "p",
                            [
                              "let",
                              [
                                [
                                  "asg",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@assignments",
                                      [
                                        "fn",
                                        "a",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@a",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@p",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "dIndex",
                                  [
                                    "object/get",
                                    "@asg",
                                    "district"
                                  ]
                                ],
                                [
                                  "dist",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@config.districts",
                                      [
                                        "fn",
                                        "d",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@d",
                                            "index"
                                          ],
                                          "@dIndex"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "dColor",
                                  [
                                    "object/get",
                                    "@dist",
                                    "color"
                                  ]
                                ],
                                [
                                  "partyColor",
                                  [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@p",
                                        "party"
                                      ],
                                      "A"
                                    ],
                                    "@config.partyAColor",
                                    "@config.partyBColor"
                                  ]
                                ]
                              ],
                              {
                                "color": "@dColor",
                                "fill": "@partyColor",
                                "height": 60.0,
                                "id": [
                                  "str/concat",
                                  "cell-",
                                  [
                                    "object/get",
                                    "@p",
                                    "id"
                                  ]
                                ],
                                "lineWidth": 4.0,
                                "opacity": 0.9,
                                "type": "rect",
                                "width": 60.0,
                                "x": [
                                  "+",
                                  20.0,
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@p",
                                      "col"
                                    ],
                                    66.0
                                  ]
                                ],
                                "y": [
                                  "+",
                                  20.0,
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@p",
                                      "row"
                                    ],
                                    66.0
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "cellLabels",
                        [
                          "array/map",
                          "@config.grid",
                          [
                            "fn",
                            "p",
                            [
                              "let",
                              [
                                [
                                  "asg",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@assignments",
                                      [
                                        "fn",
                                        "a",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@a",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@p",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "dIndex",
                                  [
                                    "object/get",
                                    "@asg",
                                    "district"
                                  ]
                                ]
                              ],
                              {
                                "align": "center",
                                "color": "#ffffff",
                                "fontSize": 11.0,
                                "id": [
                                  "str/concat",
                                  "cell-label-",
                                  [
                                    "object/get",
                                    "@p",
                                    "id"
                                  ]
