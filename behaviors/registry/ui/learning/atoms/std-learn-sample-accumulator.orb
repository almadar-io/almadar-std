                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "kind",
                        "@entity.sourceKind"
                      ],
                      [
                        "bias",
                        "@config.bias"
                      ],
                      [
                        "n",
                        "@entity.batchSize"
                      ],
                      [
                        "newSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@n"
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "if",
                              [
                                "==",
                                "@kind",
                                "coin"
                              ],
                              [
                                "if",
                                [
                                  "<",
                                  [
                                    "math/random"
                                  ],
                                  "@bias"
                                ],
                                1.0,
                                0.0
                              ],
                              [
                                "math/random"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "allSamples",
                        [
                          "array/concat",
                          "@entity.samples",
                          "@newSamples"
                        ]
                      ],
                      [
                        "countV",
                        [
                          "array/len",
                          "@allSamples"
                        ]
                      ],
                      [
                        "meanV",
                        [
                          "/",
                          [
                            "array/reduce",
                            "@allSamples",
                            0.0,
                            [
                              "fn",
                              [
                                "acc",
                                "x"
                              ],
                              [
                                "+",
                                "@acc",
                                "@x"
                              ]
                            ]
                          ],
                          "@countV"
                        ]
                      ],
                      [
                        "proportionV",
                        [
                          "if",
                          [
                            "==",
                            "@kind",
                            "coin"
                          ],
                          "@meanV",
                          0.0
                        ]
                      ],
                      [
                        "binCountV",
                        "@config.binCount"
                      ],
                      [
                        "binW",
                        [
                          "/",
                          1.0,
                          "@binCountV"
                        ]
                      ],
                      [
                        "counts",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@binCountV"
                          ],
                          [
                            "fn",
                            "b",
                            [
                              "array/len",
                              [
                                "array/filter",
                                "@allSamples",
                                [
                                  "fn",
                                  "v",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@b",
                                      [
                                        "-",
                                        "@binCountV",
                                        1.0
                                      ]
                                    ],
                                    [
                                      "and",
                                      [
                                        ">=",
                                        "@v",
                                        [
                                          "*",
                                          "@b",
                                          "@binW"
                                        ]
                                      ],
                                      [
                                        "<=",
                                        "@v",
                                        [
                                          "*",
                                          [
                                            "+",
                                            "@b",
                                            1.0
                                          ],
                                          "@binW"
                                        ]
                                      ]
                                    ],
                                    [
                                      "and",
                                      [
                                        ">=",
                                        "@v",
                                        [
                                          "*",
                                          "@b",
                                          "@binW"
                                        ]
                                      ],
                                      [
                                        "<",
                                        "@v",
                                        [
                                          "*",
                                          [
                                            "+",
                                            "@b",
                                            1.0
                                          ],
                                          "@binW"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "maxCount",
                        [
                          "math/max",
                          1.0,
                          [
                            "array/reduce",
                            "@counts",
                            0.0,
                            [
                              "fn",
                              [
                                "acc",
                                "c"
                              ],
                              [
                                "math/max",
                                "@acc",
                                "@c"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "plotW",
                        [
                          "-",
                          "@config.width",
                          48.0
                        ]
                      ],
                      [
                        "plotH",
                        [
                          "-",
                          "@config.height",
                          48.0
                        ]
                      ],
                      [
                        "histShapes",
                        [
                          "array/map",
                          [
                            "array/range",
                            "@binCountV"
                          ],
                          [
                            "fn",
                            "b",
                            [
                              "let",
                              [
                                [
                                  "barH",
                                  [
                                    "*",
                                    [
                                      "/",
                                      [
                                        "array/nth",
                                        "@counts",
                                        "@b"
                                      ],
                                      "@maxCount"
                                    ],
                                    "@plotH"
                                  ]
                                ]
                              ],
                              {
                                "fill": "@config.color",
                                "height": "@barH",
                                "lineWidth": 0.0,
                                "type": "rect",
                                "width": [
                                  "*",
                                  [
                                    "/",
                                    "@plotW",
                                    "@binCountV"
                                  ],
                                  0.9
                                ],
                                "x": [
                                  "+",
                                  24.0,
                                  [
                                    "*",
                                    "@b",
                                    [
                                      "/",
                                      "@plotW",
                                      "@binCountV"
                                    ]
                                  ]
                                ],
                                "y": [
                                  "-",
                                  [
                                    "+",
                                    24.0,
                                    "@plotH"
                                  ],
                                  "@barH"
                                ]
                              }
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.samples",
                        "@allSamples"
                      ],
                      [
                        "set",
                        "@entity.sampleCount",
                        "@countV"
                      ],
                      [
                        "set",
                        "@entity.mean",
                        "@meanV"
                      ],
                      [
                        "set",
                        "@entity.proportion",
                        "@proportionV"
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@histShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "DRAW",
                                  "label": "Draw",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Batch size: ",
                                "@entity.batchSize"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "SET_BATCH_SIZE",
                              "max": 200.0,
                              "min": 1.0,
                              "showTooltip": true,
                              "step": 1.0,
                              "type": "range-slider",
                              "value": "@entity.batchSize"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 0.1,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": 1.0,
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "if",
                                [
                                  "==",
                                  "@entity.sourceKind",
                                  "coin"
                                ],
                                [
                                  "str/concat",
                                  "@entity.sampleCount",
                                  " sample(s) drawn — running mean ",
                                  [
                                    "math/round",
                                    "@entity.mean",
                                    3.0
                                  ],
                                  ", observed proportion ",
                                  [
                                    "math/round",
                                    "@entity.proportion",
                                    3.0
                                  ],
                                  " (bias ",
                                  "@config.bias",
                                  ")"
                                ],
                                [
                                  "str/concat",
                                  "@entity.sampleCount",
                                  " sample(s) drawn — running mean ",
                                  [
                                    "math/round",
                                    "@entity.mean",
                                    3.0
                                  ]
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
