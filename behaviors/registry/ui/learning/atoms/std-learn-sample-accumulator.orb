      "traits": [
        {
          "category": "interaction",
          "config": {
            "batchSize": {
              "default": 25.0,
              "description": "Number of samples the Draw button adds per click.",
              "label": "Batch Size",
              "synonyms": "batch size, draws per click, sample batch",
              "tier": "domain",
              "type": "number"
            },
            "bias": {
              "default": 0.5,
              "description": "Probability the coin source draws 1, used only when sourceKind is coin.",
              "label": "Bias",
              "synonyms": "probability, bernoulli parameter, coin bias, p",
              "tier": "domain",
              "type": "number"
            },
            "binCount": {
              "default": 10.0,
              "description": "Number of histogram buckets across the 0..1 value range.",
              "label": "Bin Count",
              "tier": "presentation",
              "type": "number"
            },
            "color": {
              "default": "#2563eb",
              "label": "Bar Color",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": 400.0,
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "sourceKind": {
              "default": "uniform",
              "description": "Distribution each draw samples from: uniform (0..1) or coin (Bernoulli 0/1 weighted by bias).",
              "label": "Source Kind",
              "synonyms": "uniform distribution, coin flip, bernoulli trial, random sampling, source distribution",
              "tier": "domain",
              "type": "string"
            },
            "title": {
              "default": "Sample Accumulator",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The accumulated sample count and running mean after each draw — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "SAMPLES_DRAWN",
              "eventId": "evt_01M055GQ4DNX2S50YKWG1KFB6A",
              "payloadSchema": [
                {
                  "name": "count",
                  "type": "number"
                },
                {
                  "name": "mean",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "sample drawn, running mean, law of large numbers, convergence, histogram",
              "tier": "domain"
            },
            {
              "description": "The accumulator was cleared back to zero samples — a composed listener can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "ACCUMULATOR_RESET",
              "eventId": "evt_01M055GQ4D8VVSC220YJQVJ09R",
              "payloadSchema": [
