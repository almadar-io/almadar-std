            {
              "effects": [
                [
                  "set",
                  "@entity.t",
                  [
                    "math/min",
                    "@config.duration",
                    [
                      "+",
                      "@entity.t",
                      [
                        "*",
                        0.1,
                        "@entity.speed"
                      ]
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.value",
                  [
                    "if",
                    [
                      "==",
                      "@config.signalKind",
                      "sine"
                    ],
                    [
                      "*",
                      "@config.amplitude",
                      [
                        "math/sin",
                        [
                          "*",
                          "@config.rate",
                          "@entity.t"
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        "==",
                        "@config.signalKind",
                        "growth"
                      ],
                      [
                        "*",
                        "@config.amplitude",
                        [
                          "math/pow",
                          [
                            "+",
                            1.0,
                            "@config.rate"
                          ],
                          "@entity.t"
                        ]
                      ],
                      [
                        "*",
                        "@config.amplitude",
                        [
                          "math/pow",
                          0.5,
                          [
                            "/",
                            "@entity.t",
                            "@config.rate"
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
