                    "array/append",
                    "@entity.traceSamples",
                    {
                      "x": "@entity.t",
                      "y": "@entity.value"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.traceCurves",
                  [
                    {
                      "color": "@config.signalColor",
                      "label": "@config.valueLabel",
                      "samples": "@entity.traceSamples"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.running",
                  [
                    "if",
                    [
                      ">=",
                      "@entity.t",
                      "@config.duration"
                    ],
                    false,
                    true
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "==",
                  "@entity.running",
                  true
                ]
