          },
          "id": "trt_01M075815GAMP7HHTXCBE7VS66",
          "linkedEntity": "MeasureScene",
          "linkedEntityId": "ent_01M075815GTHB104DEZ60FSNDR",
          "name": "MeasureSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M075815GPDQMBY7NKES8CJVV",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M075815MA03A5SSAB91E1VSJ",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed the Play/Pause toggle — starts or freezes the signal clock.",
                "id": "evt_01M41M1H3N21H25P8DJY3D9KWW",
                "key": "TOGGLE_RUN",
                "name": "Toggle Run",
                "tier": "domain"
              },
              {
                "description": "The learner picked a playback speed; the signal clock advances that many times faster.",
                "id": "evt_01M41M1H3NV148ESM3DRXKKF8X",
                "key": "SPEED_SET",
                "name": "Speed Set",
                "payloadSchema": [
                  {
                    "name": "speed",
                    "type": "number"
                  }
                ],
                "tier": "presentation"
              },
              {
                "description": "Learner started (or resumed) the signal's evolution; the trace draws live until Pause or the configured duration.",
                "id": "evt_01M075815MDMMK99BHXWM8HBNS",
                "key": "RUN",
                "name": "Run",
                "tier": "domain"
              },
              {
                "description": "Learner froze the signal mid-run; Probe still works on the frozen value.",
                "id": "evt_01M075815M02QD7Q1M0X5MD5X7",
                "key": "PAUSE",
                "name": "Pause",
                "tier": "domain"
              },
              {
                "description": "Learner recorded the signal's instantaneous value as a data point; the sample count and running mean update.",
                "id": "evt_01M075815MY65KFH437FC3B53T",
                "key": "PROBE",
                "name": "Probe",
                "tier": "domain"
              },
              {
                "description": "Learner cleared the experiment — time, trace, and all recorded samples return to zero.",
                "id": "evt_01M075815MY0JZAPF2QN14H06N",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The experiment was started or paused — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M075815MVARRBHRBJ5M66THK",
                "key": "RUN_TOGGLED",
                "name": "Run Toggled",
                "payloadSchema": [
                  {
                    "name": "running",
                    "type": "boolean"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "A measurement was taken: the probed time and value plus the running sample count and mean.",
                "id": "evt_01M075815MT2YVVDPRXZV26HBN",
                "key": "PROBE_RECORDED",
                "name": "Probe Recorded",
                "payloadSchema": [
                  {
                    "name": "t",
                    "type": "number"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  },
                  {
                    "name": "count",
                    "type": "number"
                  },
                  {
                    "name": "mean",
                    "type": "number"
                  }
                ],
                "synonyms": "measurement lab, probe, sample the signal, record data points, running mean",
                "tier": "domain"
              },
              {
                "description": "The learner reset the experiment to a clean slate.",
                "id": "evt_01M075815M3T4JZ7R5XQGTQHR8",
                "key": "MEASURE_RESET",
                "name": "Measure Reset",
                "payloadSchema": [
                  {
                    "name": "duration",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.t",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.value",
                    [
                      "if",
                      [
                        "==",
                        "@config.signalKind",
                        "sine"
                      ],
                      0.0,
                      "@config.amplitude"
                    ]
                  ],
                  [
                    "set",
                    "@entity.running",
                    false
                  ],
                  [
                    "set",
                    "@entity.traceSamples",
                    []
                  ],
                  [
                    "set",
                    "@entity.traceCurves",
                    []
                  ],
                  [
                    "set",
                    "@entity.points",
                    []
                  ],
                  [
                    "set",
                    "@entity.sampleCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.meanValue",
                    0.0
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "align": "start",
                              "children": [
                                {
                                  "children": [
                                    {
                                      "content": "@entity.title",
                                      "type": "typography",
                                      "variant": "h4"
                                    },
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@config.summary",
                                        ""
                                      ],
                                      null,
                                      {
                                        "color": "muted",
                                        "content": "@config.summary",
                                        "type": "typography",
                                        "variant": "body2"
                                      }
                                    ]
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "label": [
                                    "if",
                                    [
                                      ">=",
                                      "@entity.t",
                                      "@config.duration"
                                    ],
                                    "Done",
                                    [
                                      "if",
                                      "@entity.running",
                                      "Measuring…",
                                      "Paused"
                                    ]
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    [
                                      ">=",
                                      "@entity.t",
                                      "@config.duration"
                                    ],
                                    "success",
                                    [
                                      "if",
                                      "@entity.running",
                                      "primary",
                                      "neutral"
                                    ]
                                  ]
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "md",
                              "justify": "between",
                              "type": "stack"
                            },
                            {
                              "align": "center",
