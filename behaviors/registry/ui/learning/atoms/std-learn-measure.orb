          "emits": [
            {
              "description": "The experiment was started or paused — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "RUN_TOGGLED",
              "eventId": "evt_01M075815MVARRBHRBJ5M66THK",
              "payloadSchema": [
                {
                  "name": "running",
