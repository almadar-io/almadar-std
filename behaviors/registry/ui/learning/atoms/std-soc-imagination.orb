            },
            "issueNodeRadius": {
              "default": 34.0,
              "label": "Issue Node Radius",
              "tier": "presentation",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Sociological Imagination",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "troubleNodeColor": {
              "default": "#1e293b",
              "label": "Trouble Node Color",
              "tier": "presentation",
              "type": "string"
            },
            "troubleNodeRadius": {
              "default": 48.0,
              "label": "Trouble Node Radius",
              "tier": "presentation",
              "type": "number"
            },
            "troubles": {
              "default": [
                {
                  "explanation": "C. Wright Mills: one person out of work is a personal trouble to be solved by that person's character and skills. When millions are out of work at once because factories close and whole job categories are automated away, the job market itself has broken down — that's a public issue rooted in economic structure, not individual failing.",
                  "id": "unemployment",
                  "options": [
                    {
                      "correct": false,
                      "id": "unemployment-d1",
                      "label": "He just isn't trying hard enough to get hired."
                    },
                    {
                      "correct": true,
                      "id": "unemployment-issue",
                      "label": "Structural unemployment — factories closing and jobs being automated away are eliminating entire categories of work across the economy."
                    },
                    {
                      "correct": false,
                      "id": "unemployment-d2",
                      "label": "Employers today are only looking for young talent."
                    }
                  ],
                  "troubleText": "I can't find a job no matter how hard I try — it must be something wrong with me."
                },
                {
                  "explanation": "When only a few marriages fail, look to the couple. When divorce rates climb across an entire society within the same few years, the institution of marriage itself is under structural strain — a public issue, not a private failing.",
                  "id": "marriage",
                  "options": [
                    {
                      "correct": true,
                      "id": "marriage-issue",
                      "label": "A generation-wide collapse of the economic and social supports that used to hold marriages together."
                    },
                    {
                      "correct": false,
                      "id": "marriage-d1",
                      "label": "She should have picked a better partner."
                    },
                    {
                      "correct": false,
                      "id": "marriage-d2",
                      "label": "Marriage counseling just doesn't work anymore."
                    }
                  ],
                  "troubleText": "My marriage is falling apart, and it feels like it's entirely my fault."
                },
                {
                  "explanation": "One student in debt is a private trouble. A whole generation carrying record debt loads, at the same time public funding for education has been withdrawn, is a public issue built into how college gets paid for.",
                  "id": "debt",
                  "options": [
                    {
                      "correct": false,
                      "id": "debt-d1",
                      "label": "He shouldn't have gone to such an expensive school."
                    },
                    {
                      "correct": false,
                      "id": "debt-d2",
                      "label": "People today just don't budget carefully enough."
                    },
                    {
                      "correct": true,
                      "id": "debt-issue",
                      "label": "A structural shift that moved the cost of higher education from public funding onto individual borrowers, across an entire generation."
                    }
                  ],
                  "troubleText": "I'm drowning in student debt and can't seem to get ahead, no matter what I do."
                },
                {
                  "explanation": "A single burned-out worker is a personal trouble. When burnout tracks a structural shift toward insecure, boundary-less work across millions of workers at once, it's a public issue in how work itself has been reorganized.",
                  "id": "burnout",
                  "options": [
                    {
                      "correct": false,
                      "id": "burnout-d1",
                      "label": "She needs to manage her stress better."
                    },
                    {
                      "correct": true,
                      "id": "burnout-issue",
                      "label": "An economy-wide shift toward precarious, always-on gig and contract work that has eroded job security for millions."
                    },
                    {
                      "correct": false,
                      "id": "burnout-d2",
                      "label": "Some people just aren't cut out for a demanding career."
                    }
                  ],
                  "troubleText": "I feel completely burned out and anxious all the time at work, and I don't know why I can't handle it like everyone else."
                }
              ],
              "description": "Roster of personal troubles. Each item carries the trouble text shown to the learner, three labelled options (one correct public issue plus two distractors) rendered as buttons in this exact order, and the explanation text shown once the correct issue is linked.",
              "items": {
                "properties": {
                  "explanation": {
                    "name": "explanation",
                    "required": true,
                    "type": "string"
                  },
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "options": {
                    "items": {
                      "properties": {
                        "correct": {
                          "name": "correct",
                          "required": true,
                          "type": "boolean"
                        },
                        "id": {
                          "name": "id",
                          "required": true,
                          "type": "string"
                        },
                        "label": {
                          "name": "label",
                          "required": true,
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "name": "options",
                    "required": true,
                    "type": "array"
                  },
                  "troubleText": {
                    "name": "troubleText",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Troubles",
              "synonyms": "sociological imagination, C. Wright Mills, Mills, personal trouble, public issue, biography and history, private trouble, structural issue",
              "tier": "domain",
              "type": "[SocImaginationTrouble]"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The imagination-exercise state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "IMAGINATION_UPDATED",
              "eventId": "evt_01KZEGCTKMXFHG4N8XQYZ0ZT9Q",
              "payloadSchema": [
                {
                  "name": "troubleIndex",
                  "type": "number"
                },
                {
                  "name": "score",
                  "type": "number"
                },
                {
                  "name": "answeredCorrectly",
                  "type": "boolean"
                },
                {
                  "name": "feedback",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "imagination update, trouble linked, public issue, score change",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "answeredCorrectly",
              "currentTroubleIndex",
              "edges",
              "explanationText",
              "feedbackText",
              "nodes",
              "score",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SocImaginationScene": "ent_01KZEGCTKKR0QZVMSHJ18D70YZ"
          },
          "id": "trt_01KZEGCTKKZYNW1Y7VNZJ1TD8B",
          "linkedEntity": "SocImaginationScene",
          "linkedEntityId": "ent_01KZEGCTKKR0QZVMSHJ18D70YZ",
          "name": "SocImaginationSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEGCTKKP1G28ZTW8J0ZT8TA",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEGCTKM88N25F78ZZ7P732G",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner clicked one of the three labelled issue buttons to link the current personal trouble to a public issue.",
                "id": "evt_01KZEGCTKM64061WHR5HZKA8F9",
                "key": "LINK_ISSUE",
                "name": "Link Issue",
                "payloadSchema": [
                  {
                    "name": "issueId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Next Trouble to advance to the next personal-trouble prompt.",
                "id": "evt_01KZEGCTKM4FDCC661YG85R3ZN",
                "key": "NEXT_TROUBLE",
                "name": "Next Trouble",
                "tier": "domain"
              },
              {
                "description": "The imagination-exercise state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEGCTKMXFHG4N8XQYZ0ZT9Q",
                "key": "IMAGINATION_UPDATED",
                "name": "Imagination Updated",
                "payloadSchema": [
                  {
                    "name": "troubleIndex",
                    "type": "number"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "answeredCorrectly",
                    "type": "boolean"
                  },
                  {
                    "name": "feedback",
                    "type": "string"
                  }
                ],
                "synonyms": "imagination update, trouble linked, public issue, score change",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.currentTroubleIndex",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.score",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.answeredCorrectly",
                    false
                  ],
                  [
                    "set",
                    "@entity.feedbackText",
                    ""
                  ],
                  [
                    "set",
                    "@entity.explanationText",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "currentTrouble",
                        [
                          "array/nth",
                          "@config.troubles",
                          0.0
                        ]
                      ],
                      [
                        "options",
                        [
                          "object/get",
                          "@currentTrouble",
                          "options"
                        ]
                      ],
                      [
                        "opt0",
                        [
                          "array/nth",
                          "@options",
                          0.0
                        ]
                      ],
                      [
                        "opt1",
                        [
                          "array/nth",
                          "@options",
                          1.0
                        ]
                      ],
                      [
                        "opt2",
                        [
                          "array/nth",
                          "@options",
                          2.0
                        ]
                      ],
                      [
                        "imagNodesCalc",
                        [
                          {
                            "color": "@config.troubleNodeColor",
                            "id": "trouble",
                            "label": [
                              "object/get",
                              "@currentTrouble",
                              "troubleText"
                            ],
                            "radius": "@config.troubleNodeRadius",
                            "x": [
                              "*",
                              "@config.width",
                              0.18
                            ],
                            "y": [
                              "/",
                              "@config.height",
                              2.0
                            ]
                          },
                          {
                            "color": "@config.issueNodeColor",
                            "id": [
                              "object/get",
                              "@opt0",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@opt0",
                              "label"
                            ],
                            "radius": "@config.issueNodeRadius",
                            "x": [
                              "*",
                              "@config.width",
                              0.75
                            ],
                            "y": [
                              "*",
                              "@config.height",
                              0.25
                            ]
                          },
                          {
                            "color": "@config.issueNodeColor",
                            "id": [
                              "object/get",
                              "@opt1",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@opt1",
                              "label"
                            ],
                            "radius": "@config.issueNodeRadius",
                            "x": [
                              "*",
                              "@config.width",
                              0.75
                            ],
                            "y": [
                              "*",
                              "@config.height",
                              0.5
                            ]
                          },
                          {
                            "color": "@config.issueNodeColor",
                            "id": [
                              "object/get",
                              "@opt2",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@opt2",
                              "label"
                            ],
                            "radius": "@config.issueNodeRadius",
                            "x": [
                              "*",
                              "@config.width",
                              0.75
                            ],
                            "y": [
                              "*",
                              "@config.height",
                              0.75
                            ]
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.nodes",
                        "@imagNodesCalc"
                      ],
                      [
                        "set",
                        "@entity.edges",
                        []
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Trouble ",
                                [
                                  "+",
                                  "@entity.currentTroubleIndex",
                                  1.0
                                ],
                                " of ",
                                [
                                  "array/len",
                                  "@config.troubles"
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.troubles",
                                  "@entity.currentTroubleIndex"
                                ],
                                "troubleText"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": [],
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "object/get",
                                  [
                                    "array/nth",
                                    "@config.troubles",
                                    "@entity.currentTroubleIndex"
                                  ],
                                  "options"
                                ],
                                [
                                  "fn",
                                  "o",
                                  {
                                    "action": "LINK_ISSUE",
                                    "actionPayload": {
                                      "issueId": [
                                        "object/get",
                                        "@o",
                                        "id"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@o",
                                      "label"
                                    ],
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "and",
                                        "@entity.answeredCorrectly",
                                        [
                                          "object/get",
                                          "@o",
                                          "correct"
                                        ]
                                      ],
                                      "success",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.feedbackText",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": "@entity.explanationText",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                {
                                  "action": "NEXT_TROUBLE",
                                  "label": "Next Trouble",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
