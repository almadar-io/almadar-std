                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEGCTKM88N25F78ZZ7P732G",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "currentTrouble",
                        [
                          "array/nth",
                          "@config.troubles",
                          "@entity.currentTroubleIndex"
                        ]
                      ],
                      [
                        "options",
                        [
                          "object/get",
                          "@currentTrouble",
                          "options"
                        ]
                      ],
                      [
                        "selectedOption",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@options",
                            [
                              "fn",
                              "o",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@o",
                                  "id"
                                ],
                                "@payload.issueId"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "isCorrect",
                        [
                          "if",
                          [
                            "!=",
                            "@selectedOption",
                            null
                          ],
                          [
                            "object/get",
                            "@selectedOption",
                            "correct"
                          ],
                          false
                        ]
                      ],
                      [
                        "opt0",
                        [
                          "array/nth",
                          "@options",
                          0.0
                        ]
                      ],
                      [
                        "opt1",
                        [
                          "array/nth",
                          "@options",
                          1.0
                        ]
                      ],
                      [
                        "opt2",
                        [
                          "array/nth",
                          "@options",
                          2.0
                        ]
                      ],
                      [
                        "correctOpt",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@options",
                            [
                              "fn",
                              "o",
                              [
                                "object/get",
                                "@o",
                                "correct"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "correctId",
                        [
                          "object/get",
                          "@correctOpt",
                          "id"
                        ]
                      ],
                      [
                        "newAnswered",
                        [
                          "or",
                          "@entity.answeredCorrectly",
                          "@isCorrect"
                        ]
                      ],
                      [
                        "newScore",
                        [
                          "if",
                          [
                            "and",
                            "@isCorrect",
                            [
                              "not",
                              "@entity.answeredCorrectly"
                            ]
                          ],
                          [
                            "+",
                            "@entity.score",
                            1.0
                          ],
                          "@entity.score"
                        ]
                      ],
                      [
                        "newFeedback",
                        [
                          "if",
                          "@isCorrect",
                          "Correct — that's the structural public issue behind this trouble.",
                          "Not quite — that's a distractor, not the structural issue. Try again."
                        ]
                      ],
                      [
                        "newExplanation",
                        [
                          "if",
                          "@newAnswered",
                          [
                            "object/get",
                            "@currentTrouble",
                            "explanation"
                          ],
                          ""
                        ]
                      ],
                      [
                        "newEdges",
