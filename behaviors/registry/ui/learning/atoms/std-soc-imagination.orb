                                ],
                                " of ",
                                [
                                  "array/len",
                                  "@config.troubles"
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": [
                                "object/get",
                                [
                                  "array/nth",
                                  "@config.troubles",
                                  "@entity.currentTroubleIndex"
                                ],
                                "troubleText"
                              ],
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": [],
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "object/get",
                                  [
                                    "array/nth",
                                    "@config.troubles",
                                    "@entity.currentTroubleIndex"
                                  ],
                                  "options"
                                ],
                                [
                                  "fn",
                                  "o",
                                  {
                                    "action": "LINK_ISSUE",
                                    "actionPayload": {
                                      "issueId": [
                                        "object/get",
                                        "@o",
                                        "id"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@o",
                                      "label"
                                    ],
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "and",
                                        "@entity.answeredCorrectly",
                                        [
                                          "object/get",
                                          "@o",
                                          "correct"
                                        ]
                                      ],
                                      "success",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.feedbackText",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "content": "@entity.explanationText",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "children": [
                                {
                                  "action": "NEXT_TROUBLE",
                                  "label": "Next Trouble",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Score: ",
                                "@entity.score",
                                " / ",
                                [
                                  "array/len",
                                  "@config.troubles"
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "IMAGINATION_UPDATED",
                    {
                      "answeredCorrectly": "@entity.answeredCorrectly",
                      "feedback": "@entity.feedbackText",
                      "score": "@entity.score",
                      "troubleIndex": "@entity.currentTroubleIndex"
                    }
                  ]
                ],
                "event": "NEXT_TROUBLE",
                "eventId": "evt_01KZEGCTKM4FDCC661YG85R3ZN",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
