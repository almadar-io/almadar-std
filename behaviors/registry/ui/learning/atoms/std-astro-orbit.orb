                },
                {
                  "name": "stepIndex",
                  "type": "number"
                },
                {
                  "name": "currentR",
                  "type": "number"
                },
                {
                  "name": "sweptAreaPerStep",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "orbit update, Kepler sweep, equal areas, step complete",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "currentR",
              "eccentricity",
              "orbitShapes",
              "semiMajorAxis",
              "stepIndex",
              "stepsPerOrbit",
              "sweptAreaPerStep",
              "theta",
