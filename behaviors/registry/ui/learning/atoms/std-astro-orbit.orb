            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "AstroOrbitScene": "ent_01KZEFTKJV1322X9FM0MH2SBKP"
          },
          "id": "trt_01KZEFTKJV6TXBMKFJT5XVDKZP",
          "linkedEntity": "AstroOrbitScene",
          "linkedEntityId": "ent_01KZEFTKJV1322X9FM0MH2SBKP",
          "name": "AstroOrbitSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFTKJVP4SSAM70MYR1FXN6",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFTKJVDG2PDX3V6E8K7RJJ",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Step Orbit to advance the planet by one equal-time, equal-area interval.",
                "id": "evt_01KZEFTKJVES6N8N2EFXJAKN2X",
                "key": "STEP",
                "name": "Step",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset Orbit to return the planet to perihelion (theta = 0).",
                "id": "evt_01KZEFTKJVNAWAMVYRZMW1T46S",
                "key": "RESET_ORBIT",
                "name": "Reset Orbit",
                "tier": "domain"
              },
              {
                "description": "Learner dragged the eccentricity slider.",
                "id": "evt_01KZEFTKJV17FFQ5C0MNGG13WE",
                "key": "SET_ECCENTRICITY",
                "name": "Set Eccentricity",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the semi-major-axis slider.",
                "id": "evt_01KZEFTKJVT0MN1DPSW5GY99YN",
                "key": "SET_SEMI_MAJOR_AXIS",
                "name": "Set Semi Major Axis",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The orbit state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFTKJVB829V10RRHF1D40Z",
                "key": "ORBIT_UPDATED",
                "name": "Orbit Updated",
                "payloadSchema": [
                  {
                    "name": "eccentricity",
                    "type": "number"
                  },
                  {
                    "name": "semiMajorAxis",
                    "type": "number"
                  },
                  {
                    "name": "theta",
                    "type": "number"
                  },
                  {
                    "name": "stepIndex",
                    "type": "number"
                  },
                  {
                    "name": "currentR",
                    "type": "number"
                  },
                  {
                    "name": "sweptAreaPerStep",
                    "type": "number"
                  }
                ],
                "synonyms": "orbit update, Kepler sweep, equal areas, step complete",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "let",
                    [
                      [
                        "a",
                        "@config.semiMajorAxis"
                      ],
                      [
                        "e",
                        "@config.initialEccentricity"
                      ],
                      [
                        "b",
                        [
                          "*",
                          "@a",
                          [
                            "math/sqrt",
                            [
                              "-",
                              1.0,
                              [
                                "*",
                                "@e",
                                "@e"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "totalArea",
                        [
                          "*",
                          3.14159265,
                          [
                            "*",
                            "@a",
                            "@b"
                          ]
                        ]
                      ],
                      [
                        "sweptArea",
                        [
                          "/",
                          "@totalArea",
                          "@config.stepsPerOrbit"
                        ]
                      ],
                      [
                        "r0",
                        [
                          "/",
                          [
                            "*",
                            "@a",
                            [
                              "-",
                              1.0,
                              [
                                "*",
                                "@e",
                                "@e"
                              ]
                            ]
                          ],
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              "@e",
                              [
                                "math/cos",
                                0.0
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "cx",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "cy",
                        [
                          "/",
                          "@config.height",
                          2.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.eccentricity",
                        "@e"
                      ],
                      [
                        "set",
                        "@entity.semiMajorAxis",
                        "@a"
                      ],
                      [
                        "set",
                        "@entity.stepsPerOrbit",
                        "@config.stepsPerOrbit"
                      ],
                      [
                        "set",
                        "@entity.theta",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.stepIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.sweptAreaPerStep",
                        "@sweptArea"
                      ],
                      [
                        "set",
                        "@entity.currentR",
                        "@r0"
                      ],
                      [
                        "set",
                        "@entity.orbitShapes",
                        [
                          {
                            "color": "@config.orbitColor",
                            "id": "ellipse",
                            "lineWidth": 1.5,
                            "opacity": 0.8,
                            "points": [
                              "array/map",
                              [
                                "array/range",
                                49.0
                              ],
                              [
                                "fn",
                                "i",
                                [
                                  "let",
                                  [
                                    [
                                      "t",
                                      [
                                        "*",
                                        [
                                          "/",
                                          "@i",
                                          48.0
                                        ],
                                        6.2831853
                                      ]
                                    ],
                                    [
                                      "rr",
                                      [
                                        "/",
                                        [
                                          "*",
                                          "@a",
                                          [
                                            "-",
                                            1.0,
                                            [
                                              "*",
                                              "@e",
                                              "@e"
                                            ]
                                          ]
                                        ],
                                        [
                                          "+",
                                          1.0,
                                          [
                                            "*",
                                            "@e",
                                            [
                                              "math/cos",
                                              "@t"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  {
                                    "x": [
                                      "+",
                                      "@cx",
                                      [
                                        "*",
                                        "@rr",
                                        [
                                          "math/cos",
                                          "@t"
                                        ]
                                      ]
                                    ],
                                    "y": [
                                      "+",
                                      "@cy",
                                      [
                                        "*",
                                        "@rr",
                                        [
                                          "math/sin",
                                          "@t"
                                        ]
                                      ]
                                    ]
                                  }
                                ]
                              ]
                            ],
                            "type": "polygon"
                          },
                          {
                            "color": "@config.sunColor",
                            "fill": "@config.sunColor",
                            "id": "sun",
                            "radius": "@config.sunRadius",
                            "type": "circle",
                            "x": "@cx",
                            "y": "@cy"
                          },
                          {
                            "color": "@config.planetColor",
                            "fill": "@config.planetColor",
                            "id": "planet",
                            "radius": "@config.planetRadius",
                            "type": "circle",
                            "x": [
                              "+",
                              "@cx",
                              "@r0"
                            ],
                            "y": "@cy"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.orbitShapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Eccentricity: ",
                                    "@entity.eccentricity"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "max": 0.85,
                                  "min": 0.0,
                                  "onChange": "SET_ECCENTRICITY",
                                  "showTooltip": true,
