                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
                              "shapes": "@entity.shapes",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZEJ4KEJ60JEFAZFMCZPPB0Z",
                "from": "idle",
                "guard": [
                  "==",
                  "@config.matchMode",
                  ""
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
