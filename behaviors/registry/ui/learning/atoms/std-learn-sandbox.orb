          "id": "trt_01M055GQ55PTH647PY8K2J09RQ",
          "linkedEntity": "LearnSandboxScene",
          "linkedEntityId": "ent_01M055GQ55Y3W7MF2S762J7GFW",
          "name": "LearnSandboxSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GQ557G8QV8JREMRHKTHX",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ5616ZKF3AC9G2WQX88",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Runtime content feed, honoured only when rosterSource is event — mode names the instrument it is for (the matchMode it carries, blank when standalone) and elements and links are the element roster and its relationships; a matching instrument re-initialises from it exactly as INIT does from config, any other instrument hides.",
                "id": "evt_01M459WQMZ61TJXMND9JGX66K2",
                "key": "ROSTER_LOADED",
                "name": "Roster Loaded",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "elements",
                    "properties": [
                      {
                        "name": "id",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "label",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "weight",
                        "required": true,
                        "type": "number"
                      },
                      {
                        "name": "enabled",
                        "type": "boolean"
                      },
                      {
                        "name": "x",
                        "type": "number"
                      },
                      {
                        "name": "y",
                        "type": "number"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  },
                  {
                    "name": "links",
                    "properties": [
                      {
                        "name": "from",
                        "required": true,
                        "type": "string"
                      },
                      {
                        "name": "to",
                        "required": true,
                        "type": "string"
                      }
                    ],
                    "required": true,
                    "type": "[object]"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner toggled one element on or off, recomputing the derived total against the threshold.",
                "id": "evt_01M055GQ56YA2WHZ4GQ3RHQ384",
                "key": "TOGGLE",
                "name": "Toggle",
                "payloadSchema": [
                  {
                    "name": "elementId",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner restored every element to its config-declared default enabled state.",
                "id": "evt_01M055GQ56131AAKB4SY6B5G2D",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The system's derived total and hold status after each toggle — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ567PE7Y74JAJH85V6E",
                "key": "SYSTEM_CHANGED",
                "name": "System Changed",
                "payloadSchema": [
                  {
                    "name": "total",
                    "type": "number"
                  },
                  {
                    "name": "holds",
                    "type": "boolean"
                  }
                ],
                "synonyms": "system update, total changed, threshold check, holds, tipping point",
                "tier": "domain"
              },
              {
                "description": "Signals every element was restored to its config-declared default by Reset — a composed listener can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ560K3WGTPPK1BT337J",
                "key": "SANDBOX_RESET",
                "name": "Sandbox Reset",
                "synonyms": "sandbox reset, restore defaults, restart",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.elements",
                    "@config.elements"
                  ],
                  [
                    "set",
                    "@entity.links",
                    "@config.links"
                  ],
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.enabledIds",
                    [
                      "array/map",
                      [
                        "array/filter",
                        "@config.elements",
                        [
                          "fn",
                          "e",
                          [
                            "==",
                            [
                              "object/get",
                              "@e",
                              "enabled",
                              true
                            ],
                            true
                          ]
                        ]
                      ],
                      [
                        "fn",
                        "e",
                        [
                          "object/get",
                          "@e",
                          "id"
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "activeElements",
                        [
                          "array/filter",
                          "@config.elements",
                          [
                            "fn",
                            "e",
                            [
                              "array/includes",
                              "@entity.enabledIds",
                              [
                                "object/get",
                                "@e",
                                "id"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "total",
                        [
                          "array/sum",
                          [
                            "array/map",
                            "@activeElements",
                            [
                              "fn",
                              "e",
                              [
                                "object/get",
                                "@e",
                                "weight"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "holds",
                        [
                          ">=",
                          "@total",
                          "@config.threshold"
                        ]
                      ],
                      [
                        "readout",
                        [
                          "str/concat",
                          "@config.outcomeLabel",
                          ": total ",
                          "@total",
                          " of ",
                          "@config.threshold",
                          " needed. ",
                          [
                            "if",
                            "@holds",
                            "Holds.",
                            "Does not hold."
                          ]
                        ]
                      ],
                      [
