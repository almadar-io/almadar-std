                            "x": "@config.criterion",
                            "y": 0.45
                          }
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.criterion",
                        "@config.criterion"
                      ],
                      [
                        "set",
                        "@entity.hitRate",
                        "@hitRate"
                      ],
                      [
                        "set",
                        "@entity.falseAlarmRate",
                        "@faRate"
                      ],
                      [
