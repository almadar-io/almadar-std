      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "animate": {
              "default": false,
              "description": "Enable continuous redraw loop.",
              "label": "Animate",
              "tier": "presentation",
              "type": "boolean"
            },
            "baseRate": {
              "default": 0.5,
              "description": "Probability that a simulated trial actually contains a signal — governs the empirical hit/false-alarm mix in RUN_TRIALS.",
              "label": "Base Rate",
              "synonyms": "base rate, signal prevalence, prior probability, signal probability",
              "tier": "domain",
              "type": "number"
            },
            "criterion": {
              "default": 0.5,
              "description": "Initial decision threshold on the evidence axis; evidence above it triggers a 'signal present' response. Hit rate is Φ(d′ − c), false-alarm rate Φ(−c).",
              "label": "Criterion",
              "synonyms": "decision criterion, response bias, threshold, beta, cutoff",
              "tier": "domain",
              "type": "number"
            },
            "criterionColor": {
              "default": "#dc2626",
              "description": "Color of the criterion line and marker.",
              "label": "Criterion Color",
              "tier": "presentation",
              "type": "string"
            },
            "dPrime": {
              "default": 1.5,
              "description": "Separation between the noise and signal+noise distributions, in standard deviations — the learner's sensitivity to the signal.",
              "label": "d′ (Sensitivity)",
              "synonyms": "d prime, sensitivity, discriminability, signal strength, detectability",
              "tier": "domain",
              "type": "number"
            },
            "height": {
              "default": 400.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "noiseColor": {
              "default": "#94a3b8",
              "description": "Color of the noise distribution curve.",
              "label": "Noise Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "signalColor": {
              "default": "#2563eb",
              "description": "Color of the signal+noise distribution curve.",
              "label": "Signal Curve Color",
              "tier": "presentation",
              "type": "string"
            },
            "title": {
              "default": "Signal Detection Theory",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "trialsPerRun": {
              "default": 50.0,
              "description": "Simulated detection trials per RUN_TRIALS click.",
              "label": "Trials Per Run",
              "tier": "domain",
              "type": "number"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The signal-detection state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "SIGNAL_UPDATED",
              "eventId": "evt_01M04DWWY967025CYDJC24Q6Y3",
              "payloadSchema": [
                {
                  "name": "criterion",
                  "type": "number"
                },
                {
                  "name": "hitRate",
                  "type": "number"
                },
                {
                  "name": "falseAlarmRate",
                  "type": "number"
                },
                {
                  "name": "trialsRun",
                  "type": "number"
                },
                {
                  "name": "hits",
                  "type": "number"
                },
                {
                  "name": "falseAlarms",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "signal detection, SDT, d prime, criterion, hit rate, false alarm, ROC point, sensitivity, response bias",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "criterion",
              "curves",
              "falseAlarmRate",
              "falseAlarms",
              "hitRate",
              "hits",
              "points",
              "title",
              "trialsRun"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "PsychSignalScene": "ent_01M04DWWY61AR58AFE5KHY55YA"
          },
          "id": "trt_01M04DWWY6XJ2AC4T8KEX9BBGS",
          "linkedEntity": "PsychSignalScene",
          "linkedEntityId": "ent_01M04DWWY61AR58AFE5KHY55YA",
          "name": "PsychSignalSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M04DWWY6K5AGD7J6J9HYHG5Y",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M04DWWY9Z5NBQ1BQ5VSQ762K",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the decision criterion; the theoretical hit and false-alarm rates recompute and the empirical counters re-anchor to zero.",
                "id": "evt_01M04DWWY9R3VTKYQBMH8WFKG9",
                "key": "SET_CRITERION",
                "name": "Set Criterion",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Ran a batch of simulated detection trials at the configured base rate — each trial draws evidence from the noise or signal+noise distribution and scores a hit or false alarm against the criterion.",
                "id": "evt_01M04DWWY9Q5R7P2QY853PP3BC",
                "key": "RUN_TRIALS",
                "name": "Run Trials",
                "tier": "domain"
              },
              {
                "description": "Learner reset the instrument — criterion, theoretical rates, and empirical counters return to their starting values.",
                "id": "evt_01M04DWWY9VEJ88GVTTKYB5NVW",
                "key": "RESET",
                "name": "Reset",
                "tier": "domain"
              },
              {
                "description": "The signal-detection state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M04DWWY967025CYDJC24Q6Y3",
                "key": "SIGNAL_UPDATED",
                "name": "Signal Updated",
                "payloadSchema": [
                  {
                    "name": "criterion",
                    "type": "number"
                  },
                  {
                    "name": "hitRate",
                    "type": "number"
                  },
                  {
                    "name": "falseAlarmRate",
                    "type": "number"
                  },
                  {
                    "name": "trialsRun",
                    "type": "number"
                  },
                  {
                    "name": "hits",
                    "type": "number"
                  },
                  {
                    "name": "falseAlarms",
                    "type": "number"
                  }
                ],
                "synonyms": "signal detection, SDT, d prime, criterion, hit rate, false alarm, ROC point, sensitivity, response bias",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "let",
                    [
                      [
                        "zHit",
                        [
                          "-",
                          "@config.dPrime",
                          "@config.criterion"
                        ]
                      ],
                      [
                        "azHit",
                        [
                          "math/abs",
                          "@zHit"
                        ]
                      ],
                      [
                        "tHit",
                        [
                          "/",
                          1.0,
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              0.2316419,
                              "@azHit"
                            ]
                          ]
                        ]
                      ],
                      [
                        "polyHit",
                        [
                          "*",
                          "@tHit",
                          [
                            "+",
                            0.31938153,
                            [
                              "*",
                              "@tHit",
                              [
                                "+",
                                -0.356563782,
                                [
                                  "*",
                                  "@tHit",
                                  [
                                    "+",
                                    1.781477937,
                                    [
                                      "*",
                                      "@tHit",
                                      [
                                        "+",
                                        -1.821255978,
                                        [
                                          "*",
                                          "@tHit",
                                          1.330274429
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "pdfHit",
                        [
                          "*",
                          0.39894228,
                          [
                            "exp",
                            [
                              "*",
                              -0.5,
                              [
                                "*",
                                "@zHit",
                                "@zHit"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "cdfHitPos",
                        [
                          "-",
                          1.0,
                          [
                            "*",
                            "@pdfHit",
                            "@polyHit"
                          ]
                        ]
                      ],
                      [
                        "hitRate",
                        [
                          "if",
                          [
                            ">=",
                            "@zHit",
                            0.0
                          ],
                          "@cdfHitPos",
                          [
                            "-",
                            1.0,
                            "@cdfHitPos"
                          ]
                        ]
                      ],
                      [
                        "zFa",
                        [
                          "-",
                          0.0,
                          "@config.criterion"
                        ]
                      ],
                      [
                        "azFa",
                        [
                          "math/abs",
                          "@zFa"
                        ]
                      ],
                      [
                        "tFa",
                        [
                          "/",
                          1.0,
                          [
                            "+",
                            1.0,
                            [
                              "*",
                              0.2316419,
                              "@azFa"
                            ]
                          ]
                        ]
                      ],
                      [
                        "polyFa",
                        [
                          "*",
                          "@tFa",
                          [
                            "+",
                            0.31938153,
                            [
                              "*",
                              "@tFa",
                              [
                                "+",
                                -0.356563782,
                                [
                                  "*",
                                  "@tFa",
                                  [
                                    "+",
                                    1.781477937,
                                    [
                                      "*",
                                      "@tFa",
                                      [
                                        "+",
                                        -1.821255978,
                                        [
                                          "*",
                                          "@tFa",
                                          1.330274429
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "pdfFa",
                        [
                          "*",
                          0.39894228,
                          [
                            "exp",
                            [
                              "*",
                              -0.5,
                              [
                                "*",
                                "@zFa",
                                "@zFa"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "cdfFaPos",
                        [
                          "-",
                          1.0,
                          [
                            "*",
                            "@pdfFa",
                            "@polyFa"
                          ]
                        ]
                      ],
                      [
                        "faRate",
                        [
                          "if",
                          [
                            ">=",
                            "@zFa",
                            0.0
                          ],
                          "@cdfFaPos",
                          [
                            "-",
                            1.0,
                            "@cdfFaPos"
                          ]
                        ]
                      ],
                      [
                        "xHi",
                        [
                          "+",
                          "@config.dPrime",
                          3.0
                        ]
                      ],
                      [
                        "noiseSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            41.0
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "xv",
                                  [
                                    "+",
                                    -3.0,
                                    [
                                      "*",
                                      [
                                        "/",
                                        "@i",
                                        40.0
                                      ],
                                      [
                                        "+",
                                        "@xHi",
                                        3.0
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@xv",
                                "y": [
                                  "*",
                                  0.39894228,
                                  [
                                    "exp",
                                    [
                                      "*",
                                      -0.5,
                                      [
                                        "*",
                                        "@xv",
                                        "@xv"
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "signalSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            41.0
                          ],
                          [
                            "fn",
                            "i",
                            [
                              "let",
                              [
                                [
                                  "xv",
                                  [
                                    "+",
                                    -3.0,
                                    [
                                      "*",
                                      [
                                        "/",
                                        "@i",
                                        40.0
                                      ],
                                      [
                                        "+",
                                        "@xHi",
                                        3.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "dv",
                                  [
                                    "-",
                                    "@xv",
                                    "@config.dPrime"
                                  ]
                                ]
                              ],
                              {
