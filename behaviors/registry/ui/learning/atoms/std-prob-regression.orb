                  ],
                  [
                    "emit",
                    "REGRESSION_UPDATED",
                    {
                      "intercept": "@entity.intercept",
                      "pointCount": [
                        "array/len",
                        "@entity.points"
                      ],
                      "r": "@entity.r",
                      "rSquared": "@entity.rSquared",
                      "slope": "@entity.slope"
                    }
                  ]
                ],
                "event": "DRAG_POINT",
                "eventId": "evt_01KZNF6QX4409YFPBFCCSH10H8",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "gSlope",
                        [
                          "if",
                          [
                            "==",
                            "@payload.param",
                            "slope"
                          ],
                          "@payload.value",
                          "@entity.guessSlope"
                        ]
                      ],
                      [
                        "gIntercept",
                        [
                          "if",
                          [
                            "==",
                            "@payload.param",
                            "intercept"
                          ],
                          "@payload.value",
                          "@entity.guessIntercept"
                        ]
                      ],
                      [
                        "pts",
                        "@entity.points"
                      ],
                      [
                        "n",
                        [
                          "array/len",
                          "@pts"
                        ]
                      ],
                      [
                        "meanX",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "meanY",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "sxx",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "@meanX"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dx",
                                  "@dx"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "sxy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "+",
                              "@acc",
                              [
                                "*",
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ],
                                  "@meanX"
                                ],
                                [
                                  "-",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ],
                                  "@meanY"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "newSlope",
                        [
                          "if",
                          [
                            ">",
                            "@sxx",
                            0.0
                          ],
                          [
                            "/",
                            "@sxy",
                            "@sxx"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "newIntercept",
                        [
                          "-",
                          "@meanY",
                          [
                            "*",
                            "@newSlope",
                            "@meanX"
                          ]
                        ]
                      ],
