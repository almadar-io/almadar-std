                                          "object/get",
                                          "@p",
                                          "x"
                                        ]
                                      ],
                                      "@newIntercept"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@e",
                                  "@e"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
