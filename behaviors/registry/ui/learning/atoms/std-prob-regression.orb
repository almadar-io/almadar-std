                        "ssFit",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "e",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ],
                                    [
                                      "+",
                                      [
                                        "*",
                                        "@newSlope",
