          "id": "trt_01KZNF6QX3FGR9DX8M0S1CJTV4",
          "linkedEntity": "ProbRegressionScene",
          "linkedEntityId": "ent_01KZNF6QX3BQDBH8800C23KJK9",
          "name": "ProbRegressionSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNF6QX3BMH6WJBQTTK60E9X",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNF6QX4BQ2B7Z9PG473N71W",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QX4F0KB1PKBYXXXC8X6",
                "key": "ADD_POINT",
                "name": "Add Point"
              },
              {
                "description": "A scatter point was dragged — id names the point, x/y its new coordinates; the fit recomputes live.",
                "id": "evt_01KZNF6QX4409YFPBFCCSH10H8",
                "key": "DRAG_POINT",
                "name": "Drag Point",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged a guess-the-line slider — param is slope or intercept; the guess is scored against the least-squares fit.",
                "id": "evt_01KZNF6QX48KAC7ASBTRJB1DW4",
                "key": "GUESS_LINE",
                "name": "Guess Line",
                "payloadSchema": [
                  {
                    "name": "param",
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QX4AESAT1S9KFE24TS4",
                "key": "REVEAL_FIT",
                "name": "Reveal Fit"
              },
              {
                "description": "The least-squares fit after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNF6QX4T6PWHRRFKRVJ3JYN",
                "key": "REGRESSION_UPDATED",
                "name": "Regression Updated",
                "payloadSchema": [
                  {
                    "name": "slope",
                    "type": "number"
                  },
                  {
                    "name": "intercept",
                    "type": "number"
                  },
                  {
                    "name": "r",
                    "type": "number"
                  },
                  {
                    "name": "rSquared",
                    "type": "number"
                  },
                  {
                    "name": "pointCount",
                    "type": "number"
                  }
                ],
                "synonyms": "regression update, least squares, line of best fit, correlation",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.points",
                    "@config.initialPoints"
                  ],
                  [
                    "set",
                    "@entity.guessSlope",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.guessIntercept",
                    50.0
                  ],
                  [
                    "set",
                    "@entity.revealed",
                    false
                  ],
                  [
                    "let",
                    [
                      [
                        "pts",
                        "@config.initialPoints"
                      ],
                      [
                        "n",
                        [
                          "array/len",
                          "@pts"
                        ]
                      ],
                      [
                        "meanX",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "meanY",
                        [
                          "if",
                          [
                            ">",
                            "@n",
                            0.0
                          ],
                          [
                            "/",
                            [
                              "array/reduce",
                              "@pts",
                              0.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "p"
                                ],
                                [
                                  "+",
                                  "@acc",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ]
                                ]
                              ]
                            ],
                            "@n"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "sxx",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "@meanX"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dx",
                                  "@dx"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "syy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dy",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ],
                                    "@meanY"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dy",
                                  "@dy"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "sxy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
                          [
                            "fn",
                            [
                              "acc",
                              "p"
                            ],
                            [
                              "+",
                              "@acc",
                              [
                                "*",
                                [
                                  "-",
                                  [
