                              "p"
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "@meanX"
                                  ]
                                ]
                              ],
                              [
                                "+",
                                "@acc",
                                [
                                  "*",
                                  "@dx",
                                  "@dx"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "syy",
                        [
                          "array/reduce",
                          "@pts",
                          0.0,
