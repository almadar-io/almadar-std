              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            },
            "xMax": {
              "default": 10.0,
              "description": "Right edge of the sampled x range.",
              "label": "X Max",
              "tier": "presentation",
              "type": "number"
            },
            "xMin": {
              "default": 0.0,
              "description": "Left edge of the sampled x range.",
              "label": "X Min",
              "tier": "presentation",
              "type": "number"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "PARAMS_CHANGED"
            },
            {
              "kind": "render-ui",
              "resource": "main"
            },
            {
              "kind": "set",
              "resource": "@entity.active"
            },
            {
              "kind": "set",
              "resource": "@entity.curveKind"
            },
            {
              "kind": "set",
              "resource": "@entity.curves"
            },
            {
              "kind": "set",
              "resource": "@entity.paramA"
            },
            {
              "kind": "set",
              "resource": "@entity.paramALabel"
            },
            {
              "kind": "set",
              "resource": "@entity.paramB"
            },
            {
              "kind": "set",
              "resource": "@entity.paramBLabel"
            },
            {
              "kind": "set",
              "resource": "@entity.title"
            },
            {
              "kind": "set",
              "resource": "@entity.xMid"
            },
            {
              "kind": "set",
              "resource": "@entity.yMax"
            },
            {
              "kind": "set",
              "resource": "@entity.yMid"
            },
            {
              "kind": "set",
              "resource": "@entity.yMin"
            }
          ],
          "emits": [
            {
              "description": "The two parameter values after a slider change — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "PARAMS_CHANGED",
              "eventId": "evt_01M055GQ3SFM2XKKEWPHEHDJS9",
              "payloadSchema": [
                {
                  "name": "paramA",
                  "type": "number"
                },
                {
                  "name": "paramB",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "parameter explorer, curve family, power law, linear function, sine wave",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "curveKind",
              "curves",
              "paramA",
              "paramALabel",
              "paramB",
              "paramBLabel",
              "title",
              "xMid",
              "yMax",
              "yMid",
              "yMin"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "ParamExplorerScene": "ent_01M055GQ3RZHSYRJ9Y73F326ES"
          },
          "id": "trt_01M055GQ3R8ZEBMEKS5VVB3DRS",
          "linkedEntity": "ParamExplorerScene",
          "linkedEntityId": "ent_01M055GQ3RZHSYRJ9Y73F326ES",
          "name": "ParamExplorerSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GQ3RNWM925Q03N3H02Y1",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M055GQ3SMBT9W67Y0R8XCZMS",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the first parameter's slider — value is the new A; the curve recomputes immediately.",
                "id": "evt_01M055GQ3S5N5XM0K69CMX027H",
                "key": "SET_PARAM_A",
                "name": "Set Param A",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged the second parameter's slider — value is the new B; the curve recomputes immediately.",
                "id": "evt_01M055GQ3SFJSGF21NDA00MAK2",
                "key": "SET_PARAM_B",
                "name": "Set Param B",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The two parameter values after a slider change — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M055GQ3SFM2XKKEWPHEHDJS9",
                "key": "PARAMS_CHANGED",
                "name": "Params Changed",
                "payloadSchema": [
                  {
                    "name": "paramA",
                    "type": "number"
                  },
                  {
                    "name": "paramB",
                    "type": "number"
                  }
                ],
                "synonyms": "parameter explorer, curve family, power law, linear function, sine wave",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "A",
                        "@config.paramADefault"
                      ],
                      [
                        "B",
                        "@config.paramBDefault"
                      ],
                      [
                        "kind",
                        "@config.curveKind"
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "samples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@A",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@B"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
                                        "+",
                                        "@A",
                                        [
                                          "*",
                                          "@B",
                                          "@x"
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@A",
                                        [
                                          "math/sin",
                                          [
                                            "*",
                                            "@B",
                                            "@x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@yVal"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "yMinRaw",
                        [
                          "array/reduce",
                          "@samples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@samples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/min",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yMaxRaw",
                        [
                          "array/reduce",
                          "@samples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@samples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/max",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yPad",
                        [
                          "*",
                          0.1,
                          [
                            "math/max",
                            0.001,
                            [
                              "-",
                              "@yMaxRaw",
                              "@yMinRaw"
                            ]
                          ]
                        ]
                      ],
                      [
                        "xMidV",
                        [
                          "/",
                          [
                            "+",
                            "@config.xMin",
                            "@config.xMax"
                          ],
                          2.0
                        ]
                      ],
                      [
                        "yMidV",
                        [
                          "if",
                          [
                            "==",
                            "@kind",
                            "power"
                          ],
                          [
                            "*",
                            "@A",
                            [
                              "math/pow",
                              "@xMidV",
                              "@B"
                            ]
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@kind",
                              "linear"
                            ],
                            [
                              "+",
                              "@A",
                              [
                                "*",
                                "@B",
                                "@xMidV"
                              ]
                            ],
                            [
                              "*",
                              "@A",
                              [
                                "math/sin",
                                [
                                  "*",
                                  "@B",
                                  "@xMidV"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.curveKind",
                        "@kind"
                      ],
                      [
                        "set",
                        "@entity.paramA",
                        "@A"
                      ],
                      [
                        "set",
                        "@entity.paramB",
                        "@B"
                      ],
                      [
                        "set",
                        "@entity.paramALabel",
                        "@config.paramALabel"
                      ],
                      [
                        "set",
                        "@entity.paramBLabel",
                        "@config.paramBLabel"
                      ],
                      [
                        "set",
                        "@entity.xMid",
                        "@xMidV"
                      ],
                      [
                        "set",
                        "@entity.yMid",
                        "@yMidV"
                      ],
                      [
                        "set",
                        "@entity.yMin",
                        [
                          "-",
                          "@yMinRaw",
                          "@yPad"
                        ]
                      ],
                      [
                        "set",
                        "@entity.yMax",
                        [
                          "+",
                          "@yMaxRaw",
                          "@yPad"
                        ]
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          {
                            "color": "@config.color",
                            "label": "y(x)",
                            "samples": "@samples"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "@entity.paramALabel",
                                    ": ",
                                    [
                                      "math/round",
                                      "@entity.paramA",
                                      2.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "action": "SET_PARAM_A",
                                  "max": "@config.paramAMax",
                                  "min": "@config.paramAMin",
                                  "showTooltip": true,
                                  "step": "@config.paramAStep",
                                  "type": "range-slider",
                                  "value": "@entity.paramA"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "@entity.paramBLabel",
                                    ": ",
                                    [
                                      "math/round",
                                      "@entity.paramB",
                                      2.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "action": "SET_PARAM_B",
                                  "max": "@config.paramBMax",
                                  "min": "@config.paramBMin",
                                  "showTooltip": true,
                                  "step": "@config.paramBStep",
                                  "type": "range-slider",
                                  "value": "@entity.paramB"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": [],
                              "showAxes": "@config.showAxes",
                              "showGrid": "@config.showGrid",
