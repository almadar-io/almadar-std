          "name": "ProbConfidenceSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNF6QXVVET09ZZSF73QCSW7",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNF6QXVA2E0SS3RC5SVSMP2",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QXV201CW7NB052VCVPX",
                "key": "DRAW_INTERVAL",
                "name": "Draw Interval"
              },
              {
                "id": "evt_01KZNF6QXVNJX4EQSF1QXR08WF",
                "key": "DRAW_MANY",
                "name": "Draw Many"
              },
              {
                "description": "Learner dragged the confidence-level slider — value is the new nominal level; changing it clears the accumulated intervals.",
                "id": "evt_01KZNF6QXVFTV8JAQK6WCNKQJH",
                "key": "SET_LEVEL",
                "name": "Set Level",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNF6QXVJZZ1MR2E4S75WSF6",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "The capture state after each draw — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNF6QXVEJREE32F0A9AC49C",
                "key": "CONFIDENCE_UPDATED",
                "name": "Confidence Updated",
                "payloadSchema": [
                  {
                    "name": "intervalsDrawn",
                    "type": "number"
                  },
                  {
                    "name": "captures",
                    "type": "number"
                  },
                  {
                    "name": "captureRate",
                    "type": "number"
                  }
                ],
                "synonyms": "confidence interval, capture rate, interval estimate, coverage",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.level",
                    "@config.confidenceLevel"
                  ],
                  [
                    "set",
                    "@entity.intervals",
                    []
                  ],
                  [
                    "set",
                    "@entity.intervalsDrawn",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.captures",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.lastCaptured",
                    false
                  ],
                  [
                    "set",
                    "@entity.shapes",
                    []
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "DRAW_INTERVAL",
                                  "label": "Draw Interval",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "DRAW_MANY",
                                  "label": "Draw Many",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Confidence level: ",
                                [
                                  "math/round",
                                  [
                                    "*",
                                    "@entity.level",
                                    100.0
                                  ]
                                ],
                                "% — sample size n: ",
                                "@config.sampleSize"
                              ],
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "action": "SET_LEVEL",
                              "max": 0.99,
                              "min": 0.5,
                              "showTooltip": true,
                              "step": 0.01,
                              "type": "range-slider",
                              "value": "@entity.level"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 10.0,
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": 100.0,
                              "xMin": 0.0,
                              "yMax": 1.0,
                              "yMin": 0.0
                            },
                            {
                              "label": "Capture rate",
                              "max": 100.0,
                              "min": 0.0,
                              "showValue": true,
                              "type": "meter",
                              "unit": "%",
                              "value": [
                                "if",
                                [
                                  ">",
                                  "@entity.intervalsDrawn",
                                  0.0
                                ],
                                [
                                  "math/round",
                                  [
                                    "*",
                                    100.0,
                                    [
                                      "/",
                                      "@entity.captures",
                                      "@entity.intervalsDrawn"
                                    ]
                                  ],
                                  1.0
                                ],
                                0.0
                              ]
                            },
                            {
                              "content": [
                                "str/concat",
                                "@entity.intervalsDrawn",
                                " interval(s) — ",
                                "@entity.captures",
                                " captured the true mean ",
                                "@config.trueMean"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
