      "traits": [
        {
          "category": "interaction",
          "config": {
            "basePoints": {
              "default": 10.0,
              "description": "Points for a correct answer regardless of speed.",
              "label": "Base Points",
              "tier": "domain",
              "type": "number"
            },
            "items": {
              "default": [
                {
                  "correctIndex": 1.0,
                  "options": [
                    "54",
                    "56",
                    "63",
                    "48"
                  ],
                  "prompt": "7 × 8"
                },
                {
                  "correctIndex": 0.0,
                  "options": [
                    "54",
                    "56",
                    "45",
                    "63"
                  ],
                  "prompt": "9 × 6"
                },
                {
                  "correctIndex": 2.0,
                  "options": [
                    "124",
                    "132",
                    "144",
                    "148"
                  ],
                  "prompt": "12 × 12"
                }
              ],
              "description": "The drill roster; each item carries a prompt, its options, and the index of the correct option. Realizations declare their own subject's items here.",
              "items": {
                "properties": {
                  "correctIndex": {
                    "name": "correctIndex",
                    "required": true,
                    "type": "number"
                  },
                  "options": {
                    "items": {
                      "type": "string"
                    },
                    "name": "options",
                    "required": true,
                    "type": "array"
                  },
                  "prompt": {
                    "name": "prompt",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Items",
              "tier": "domain",
              "type": "[SpeedDrillItem]"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "nextLabel": {
              "default": "Next",
              "label": "Next Label",
              "tier": "presentation",
              "type": "string"
            },
            "retryLabel": {
              "default": "Try Again",
              "label": "Retry Label",
              "tier": "presentation",
              "type": "string"
            },
            "speedBonus": {
              "default": 10.0,
              "description": "Maximum extra points awarded in proportion to the time left on the clock.",
              "label": "Speed Bonus",
              "tier": "domain",
              "type": "number"
            },
            "timeLimit": {
              "default": 6.0,
              "description": "Seconds the learner has to answer each item before it counts as a miss.",
              "label": "Time Limit",
              "tier": "domain",
              "type": "number"
            },
            "title": {
              "default": "Speed Drill",
              "description": "Title shown above the drill.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            }
          },
          "emits": [
            {
              "description": "The verdict of a speeded answer: correctness, tenths of a second left on the clock, and the running score and streak — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "ANSWER_JUDGED",
              "eventId": "evt_01M07581K7Y94VWHN8SC6JD86W",
              "payloadSchema": [
                {
                  "name": "correct",
                  "type": "boolean"
                },
                {
                  "name": "timeLeftTenths",
                  "type": "number"
                },
                {
                  "name": "score",
                  "type": "number"
                },
                {
                  "name": "streak",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "speed drill, reaction time, fluency, timed quiz, countdown, rapid recall",
              "tier": "domain"
            },
            {
              "description": "The learner moved to the next item (or completed the round) with the running score.",
              "event": "PROMPT_ADVANCED",
              "eventId": "evt_01M07581K7FSJ5FS5ZGA7NSXQA",
              "payloadSchema": [
                {
                  "name": "itemIndex",
                  "type": "number"
                },
                {
                  "name": "done",
                  "type": "boolean"
                },
                {
                  "name": "score",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "domain"
            },
            {
              "description": "The learner restarted the round from scratch.",
              "event": "ROUND_RESTARTED",
              "eventId": "evt_01M07581K78GXNST8AG0BTCVS8",
              "payloadSchema": [
                {
                  "name": "totalItems",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "domain"
            },
            {
              "description": "Fired once when the round finishes (advancing past the final prompt) — the standard learning completion broadcast a celebration/progression sibling (fx cues, badges) rides.",
              "event": "LEARN_ROUND_COMPLETE",
              "eventId": "evt_01M0GTSZHFPPWVV9N240SJMS4J",
              "payloadSchema": [
                {
                  "name": "score",
                  "type": "number"
                },
                {
                  "name": "total",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "round complete, finished, done, completion",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "bestStreak",
              "correctIndex",
              "done",
              "feedback",
              "itemIndex",
              "options",
              "promptText",
              "remaining",
              "running",
              "score",
              "streak",
              "title",
              "totalItems",
              "verdict",
              "view"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "SpeedDrillScene": "ent_01M07581K2W17XA11BNK1FMZGS"
          },
          "id": "trt_01M07581K2JSWMZDZSAVQSR6A2",
          "linkedEntity": "SpeedDrillScene",
          "linkedEntityId": "ent_01M07581K2W17XA11BNK1FMZGS",
          "name": "SpeedDrillSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M07581K2J8J66ZVYN4B43N01",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01M07581K79NFK2TV53DRCRDW8",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked an option while the clock was running — index is the chosen option; it is judged immediately and scored with a speed bonus.",
                "id": "evt_01M07581K7KS1XANK51S5C3WTP",
                "key": "ANSWER",
                "name": "Answer",
                "payloadSchema": [
                  {
                    "name": "index",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner advanced to the next item after a verdict (answered or timed out); past the last item this completes the round.",
                "id": "evt_01M07581K7H28V8MJMBSBFEGCN",
                "key": "NEXT",
                "name": "Next",
                "tier": "domain"
              },
              {
                "description": "Learner restarted the round from the first item with a cleared score and streak.",
                "id": "evt_01M07581K7405N4D7KZFGQSVC5",
                "key": "RETRY",
                "name": "Retry",
                "tier": "domain"
              },
              {
                "description": "The verdict of a speeded answer: correctness, tenths of a second left on the clock, and the running score and streak — a composed listener (coach, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01M07581K7Y94VWHN8SC6JD86W",
                "key": "ANSWER_JUDGED",
                "name": "Answer Judged",
                "payloadSchema": [
                  {
                    "name": "correct",
                    "type": "boolean"
                  },
                  {
                    "name": "timeLeftTenths",
                    "type": "number"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "streak",
                    "type": "number"
                  }
                ],
                "synonyms": "speed drill, reaction time, fluency, timed quiz, countdown, rapid recall",
                "tier": "domain"
              },
              {
                "description": "The learner moved to the next item (or completed the round) with the running score.",
                "id": "evt_01M07581K7FSJ5FS5ZGA7NSXQA",
                "key": "PROMPT_ADVANCED",
                "name": "Prompt Advanced",
                "payloadSchema": [
                  {
                    "name": "itemIndex",
                    "type": "number"
                  },
                  {
                    "name": "done",
                    "type": "boolean"
                  },
                  {
                    "name": "score",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The learner restarted the round from scratch.",
                "id": "evt_01M07581K78GXNST8AG0BTCVS8",
                "key": "ROUND_RESTARTED",
                "name": "Round Restarted",
                "payloadSchema": [
                  {
                    "name": "totalItems",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Fired once when the round finishes (advancing past the final prompt) — the standard learning completion broadcast a celebration/progression sibling (fx cues, badges) rides.",
                "id": "evt_01M0GTSZHFPPWVV9N240SJMS4J",
                "key": "LEARN_ROUND_COMPLETE",
                "name": "Learn Round Complete",
                "payloadSchema": [
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "total",
                    "type": "number"
                  }
                ],
                "synonyms": "round complete, finished, done, completion",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "first",
                        [
                          "array/nth",
                          "@config.items",
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.active",
                        true
                      ],
                      [
                        "set",
                        "@entity.title",
                        "@config.title"
                      ],
                      [
                        "set",
                        "@entity.itemIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.totalItems",
                        [
                          "array/len",
                          "@config.items"
                        ]
                      ],
                      [
                        "set",
                        "@entity.remaining",
                        [
                          "*",
                          "@config.timeLimit",
                          10.0
                        ]
                      ],
                      [
                        "set",
                        "@entity.running",
                        true
                      ],
                      [
                        "set",
                        "@entity.verdict",
                        ""
                      ],
                      [
                        "set",
                        "@entity.score",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.streak",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.bestStreak",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.done",
                        false
                      ],
                      [
                        "set",
                        "@entity.promptText",
                        [
                          "object/get",
                          "@first",
                          "prompt"
                        ]
                      ],
                      [
                        "set",
                        "@entity.options",
                        [
                          "object/get",
                          "@first",
                          "options"
                        ]
                      ],
                      [
                        "set",
                        "@entity.correctIndex",
                        [
                          "object/get",
                          "@first",
                          "correctIndex"
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        ""
                      ],
                      [
                        "set",
                        "@entity.view",
                        [
                          {
                            "children": [
                              {
                                "content": "@entity.promptText",
                                "type": "typography",
                                "variant": "h4"
                              }
                            ],
                            "padding": "md",
                            "type": "card",
                            "variant": "bordered"
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "label": [
                                "str/concat",
                                "Item ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "+",
                                    "@entity.itemIndex",
                                    1.0
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.totalItems"
                                ]
                              ],
                              "max": "@entity.totalItems",
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.itemIndex",
                                1.0
                              ]
                            },
                            {
                              "label": [
                                "str/concat",
                                "Time left: ",
                                [
                                  "math/round",
                                  [
                                    "/",
                                    "@entity.remaining",
                                    10.0
                                  ],
                                  1.0
                                ],
                                "s"
                              ],
                              "max": [
                                "*",
                                "@config.timeLimit",
                                10.0
                              ],
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": "@entity.remaining"
                            },
                            {
                              "children": "@entity.view",
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "array/range",
                                  0.0,
                                  [
                                    "array/len",
                                    "@entity.options"
                                  ]
                                ],
                                [
                                  "fn",
                                  [
                                    "i"
                                  ],
                                  {
                                    "action": "ANSWER",
                                    "actionPayload": {
                                      "index": "@i"
                                    },
                                    "disabled": [
                                      "if",
                                      "@entity.running",
                                      false,
                                      true
                                    ],
                                    "label": [
                                      "array/nth",
                                      "@entity.options",
                                      "@i"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": "secondary"
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                {
                                  "action": "NEXT",
                                  "disabled": [
                                    "if",
                                    [
                                      "and",
                                      [
                                        "==",
                                        "@entity.running",
                                        false
                                      ],
                                      [
                                        "and",
                                        [
                                          "!=",
                                          "@entity.verdict",
                                          ""
                                        ],
                                        [
                                          "==",
                                          "@entity.done",
                                          false
                                        ]
                                      ]
                                    ],
                                    false,
                                    true
                                  ],
                                  "label": "@config.nextLabel",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RETRY",
                                  "disabled": [
                                    "if",
                                    "@entity.done",
                                    false,
                                    true
                                  ],
                                  "label": "@config.retryLabel",
                                  "type": "button",
                                  "variant": "ghost"
                                }
