                              "max": "@entity.totalItems",
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.itemIndex",
                                1.0
                              ]
                            },
                            {
                              "label": [
                                "str/concat",
                                "Time left: ",
                                [
                                  "math/round",
                                  [
                                    "/",
                                    "@entity.remaining",
                                    10.0
                                  ],
                                  1.0
                                ],
                                "s"
                              ],
                              "max": [
                                "*",
                                "@config.timeLimit",
                                10.0
                              ],
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": "@entity.remaining"
                            },
                            {
                              "children": "@entity.view",
                              "direction": "vertical",
                              "gap": "md",
                              "type": "stack"
                            },
                            {
                              "children": [
                                "array/map",
                                [
                                  "array/range",
                                  0.0,
                                  [
                                    "array/len",
                                    "@entity.options"
                                  ]
                                ],
                                [
                                  "fn",
                                  [
                                    "i"
                                  ],
                                  {
                                    "action": "ANSWER",
                                    "actionPayload": {
                                      "index": "@i"
                                    },
                                    "disabled": [
                                      "if",
                                      "@entity.running",
                                      false,
                                      true
                                    ],
                                    "label": [
                                      "array/nth",
                                      "@entity.options",
                                      "@i"
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": "secondary"
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.feedback",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                {
                                  "action": "NEXT",
                                  "disabled": [
                                    "if",
                                    [
                                      "and",
                                      [
                                        "==",
                                        "@entity.running",
                                        false
                                      ],
                                      [
                                        "and",
                                        [
                                          "!=",
                                          "@entity.verdict",
                                          ""
                                        ],
                                        [
                                          "==",
                                          "@entity.done",
                                          false
                                        ]
                                      ]
                                    ],
                                    false,
                                    true
                                  ],
                                  "label": "@config.nextLabel",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "RETRY",
                                  "disabled": [
                                    "if",
                                    "@entity.done",
                                    false,
                                    true
                                  ],
                                  "label": "@config.retryLabel",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "label": "Score",
                              "max": 0.0,
                              "type": "stat-display",
                              "value": "@entity.score"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Streak: ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.streak"
                                ],
                                " · best: ",
                                [
                                  "str/concat",
                                  "",
                                  "@entity.bestStreak"
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "ROUND_RESTARTED",
                    {
                      "totalItems": "@entity.totalItems"
                    }
                  ]
                ],
                "event": "RETRY",
                "eventId": "evt_01M07581K7405N4D7KZFGQSVC5",
                "from": "idle",
                "guard": [
                  "and",
                  [
                    "==",
                    "@entity.active",
                    true
                  ],
                  [
                    "==",
                    "@entity.done",
                    true
                  ]
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.remaining",
                  [
                    "math/max",
                    0.0,
                    [
                      "-",
                      "@entity.remaining",
                      1.0
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.verdict",
                  [
                    "if",
                    [
                      "==",
                      "@entity.remaining",
                      0.0
                    ],
                    "timeout",
                    "@entity.verdict"
                  ]
                ],
                [
                  "set",
                  "@entity.feedback",
                  [
                    "if",
                    [
                      "==",
                      "@entity.remaining",
                      0.0
                    ],
                    [
                      "str/concat",
                      "Time's up — the answer was: ",
                      [
                        "array/nth",
                        "@entity.options",
                        "@entity.correctIndex"
                      ]
                    ],
                    "@entity.feedback"
                  ]
                ],
                [
                  "set",
                  "@entity.streak",
                  [
                    "if",
                    [
                      "==",
                      "@entity.remaining",
                      0.0
                    ],
                    0.0,
                    "@entity.streak"
                  ]
                ],
                [
                  "set",
                  "@entity.running",
                  [
                    "if",
                    [
                      "==",
                      "@entity.remaining",
                      0.0
                    ],
                    false,
                    true
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "==",
                  "@entity.running",
                  true
                ]
              ],
              "interval": 100.0,
              "name": "speedTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}