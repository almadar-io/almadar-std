                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01M07581K79NFK2TV53DRCRDW8",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "correct",
                        [
                          "==",
                          "@payload.index",
                          "@entity.correctIndex"
                        ]
                      ],
                      [
                        "bonus",
                        [
                          "math/round",
                          [
                            "/",
                            "@entity.remaining",
                            10.0
                          ],
                          1.0
                        ]
                      ],
                      [
                        "points",
                        [
                          "if",
                          "@correct",
                          [
                            "+",
                            "@config.basePoints",
                            [
                              "math/round",
                              [
                                "*",
                                "@config.speedBonus",
                                [
                                  "/",
                                  "@entity.remaining",
                                  [
                                    "*",
                                    "@config.timeLimit",
                                    10.0
                                  ]
                                ]
                              ],
                              0.0
                            ]
                          ],
                          0.0
                        ]
                      ],
                      [
                        "newStreak",
                        [
                          "if",
                          "@correct",
                          [
                            "+",
                            "@entity.streak",
                            1.0
                          ],
                          0.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.running",
                        false
                      ],
                      [
                        "set",
                        "@entity.verdict",
                        [
                          "if",
                          "@correct",
                          "correct",
                          "wrong"
                        ]
                      ],
                      [
                        "set",
                        "@entity.score",
                        [
                          "+",
                          "@entity.score",
                          "@points"
                        ]
                      ],
                      [
                        "set",
                        "@entity.streak",
                        "@newStreak"
                      ],
                      [
                        "set",
                        "@entity.bestStreak",
                        [
                          "math/max",
                          "@entity.bestStreak",
                          "@newStreak"
                        ]
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        [
                          "if",
                          "@correct",
                          [
                            "str/concat",
                            "Correct with ",
                            "@bonus",
                            "s to spare — +",
                            [
                              "str/concat",
                              "",
                              "@points"
                            ],
                            " points."
                          ],
                          [
                            "str/concat",
                            "Not quite — the answer was: ",
                            [
                              "array/nth",
                              "@entity.options",
                              "@entity.correctIndex"
                            ]
                          ]
                        ]
                      ]
                    ]
