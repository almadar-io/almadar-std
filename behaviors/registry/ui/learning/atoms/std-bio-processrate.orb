                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner adjusted the temperature slider.",
                "id": "evt_01KZEJ4KE828YF03D07F6MV231",
                "key": "SET_TEMP",
                "name": "Set Temp",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The process rate state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEJ4KE8YT3KXZXTJ98ENTQX",
                "key": "PROCESS_RATE_UPDATED",
                "name": "Process Rate Updated",
                "payloadSchema": [
                  {
                    "name": "rate",
                    "type": "number"
                  },
                  {
                    "name": "limitingFactor",
                    "type": "string"
                  },
                  {
                    "name": "light",
                    "type": "number"
                  },
                  {
                    "name": "co2",
                    "type": "number"
                  },
                  {
                    "name": "temperature",
                    "type": "number"
                  }
                ],
                "synonyms": "process rate update, limiting factor, photosynthesis rate, reaction rate",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.edges",
                    "@config.edges"
                  ],
                  [
                    "set",
                    "@entity.shapes",
                    "@config.shapes"
                  ],
                  [
                    "set",
                    "@entity.light",
                    "@config.light"
                  ],
                  [
                    "set",
                    "@entity.co2",
                    "@config.co2"
                  ],
                  [
                    "set",
                    "@entity.temperature",
                    "@config.temperature"
                  ],
                  [
                    "let",
                    [
                      [
                        "lightFactor",
                        [
                          "math/clamp",
                          [
                            "/",
                            "@entity.light",
                            "@config.lightSaturation"
                          ],
                          0.0,
                          1.0
                        ]
                      ],
                      [
                        "co2Factor",
                        [
                          "math/clamp",
                          [
                            "/",
                            "@entity.co2",
                            "@config.co2Saturation"
                          ],
                          0.0,
                          1.0
                        ]
                      ],
                      [
                        "tempFactor",
                        [
                          "math/clamp",
                          [
                            "-",
                            1.0,
                            [
                              "/",
                              [
                                "math/abs",
                                [
                                  "-",
                                  "@entity.temperature",
                                  "@config.tempOptimum"
                                ]
                              ],
                              "@config.tempTolerance"
                            ]
                          ],
                          0.0,
                          1.0
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "minFactor",
                          [
                            "math/min",
                            "@lightFactor",
                            "@co2Factor",
                            "@tempFactor"
                          ]
                        ],
                        [
                          "limiting",
                          [
                            "if",
                            [
                              "<=",
                              "@lightFactor",
                              "@co2Factor"
                            ],
                            [
                              "if",
                              [
                                "<=",
                                "@lightFactor",
                                "@tempFactor"
                              ],
                              "light",
                              "temperature"
                            ],
                            [
                              "if",
                              [
                                "<=",
                                "@co2Factor",
                                "@tempFactor"
                              ],
                              "co2",
                              "temperature"
                            ]
                          ]
                        ]
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.rate",
                          [
                            "*",
                            "@config.maxRate",
                            "@minFactor"
                          ]
                        ],
                        [
                          "set",
                          "@entity.limitingFactor",
                          "@limiting"
                        ],
                        [
                          "set",
                          "@entity.nodes",
                          [
                            "array/map",
                            "@config.processNodes",
                            [
                              "fn",
                              "n",
                              [
                                "let",
                                [
                                  [
                                    "nid",
                                    [
                                      "object/get",
                                      "@n",
                                      "id"
                                    ]
                                  ]
                                ],
                                [
                                  "if",
                                  [
                                    "==",
                                    "@nid",
                                    "light-in"
                                  ],
                                  [
                                    "object/merge",
                                    "@n",
                                    {
                                      "color": [
                                        "if",
                                        [
                                          "==",
                                          "@limiting",
                                          "light"
                                        ],
                                        "#f59e0b",
                                        [
                                          "object/get",
                                          "@n",
                                          "color"
                                        ]
                                      ],
                                      "radius": [
                                        "+",
                                        8.0,
                                        [
                                          "*",
                                          "@lightFactor",
                                          16.0
                                        ]
                                      ]
                                    }
                                  ],
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@nid",
                                      "co2-in"
                                    ],
                                    [
                                      "object/merge",
                                      "@n",
                                      {
                                        "color": [
                                          "if",
                                          [
                                            "==",
                                            "@limiting",
                                            "co2"
                                          ],
                                          "#f59e0b",
                                          [
                                            "object/get",
                                            "@n",
                                            "color"
                                          ]
                                        ],
                                        "radius": [
                                          "+",
                                          8.0,
                                          [
                                            "*",
                                            "@co2Factor",
                                            16.0
                                          ]
                                        ]
                                      }
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@nid",
                                        "temp-in"
                                      ],
                                      [
                                        "object/merge",
                                        "@n",
                                        {
                                          "color": [
                                            "if",
                                            [
                                              "==",
                                              "@limiting",
                                              "temperature"
                                            ],
                                            "#f59e0b",
                                            [
                                              "object/get",
                                              "@n",
                                              "color"
                                            ]
                                          ],
                                          "radius": [
                                            "+",
                                            8.0,
                                            [
                                              "*",
                                              "@tempFactor",
                                              16.0
                                            ]
                                          ]
                                        }
                                      ],
                                      [
                                        "if",
                                        [
                                          "==",
                                          "@nid",
                                          "output"
                                        ],
                                        [
                                          "object/merge",
                                          "@n",
                                          {
                                            "radius": [
                                              "+",
                                              6.0,
                                              [
                                                "*",
                                                "@minFactor",
                                                30.0
                                              ]
                                            ]
                                          }
                                        ],
                                        "@n"
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "nodes": "@entity.nodes",
