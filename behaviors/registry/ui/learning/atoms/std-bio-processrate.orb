                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "@config.processLabel",
                                    ": ",
                                    [
                                      "math/floor",
                                      "@entity.rate"
                                    ],
                                    "%"
                                  ],
                                  "type": "typography",
                                  "variant": "h4"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Limiting factor: ",
                                    "@entity.limitingFactor"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "children": [
                                    {
                                      "content": "Light intensity",
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 100.0,
                                      "min": 0.0,
                                      "onChange": "SET_LIGHT",
                                      "showTooltip": true,
                                      "step": 1.0,
                                      "type": "range-slider",
                                      "value": "@entity.light"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "content": "CO₂ concentration",
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 100.0,
                                      "min": 0.0,
                                      "onChange": "SET_CO2",
                                      "showTooltip": true,
                                      "step": 1.0,
                                      "type": "range-slider",
                                      "value": "@entity.co2"
                                    }
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "children": [
                                    {
                                      "content": "Temperature (°C)",
                                      "type": "typography",
                                      "variant": "caption"
                                    },
                                    {
                                      "max": 45.0,
                                      "min": 0.0,
