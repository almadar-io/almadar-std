                      "currentStageIndex": "@entity.currentStageIndex",
                      "initialMass": "@entity.initialMass",
                      "pathEndLabel": "@entity.pathEndLabel",
                      "stageLabel": "@entity.stageLabel"
                    }
                  ]
                ],
                "event": "STEP_STAGE",
                "eventId": "evt_01KZEFTKK754VRF5Y245MFNB0Z",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "stage0",
                        [
                          "array/nth",
                          "@entity.stages",
                          0.0
                        ]
                      ],
                      [
                        "cx",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "cy",
                        [
                          "/",
                          "@config.height",
                          2.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.currentStageIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.stageLabel",
                        [
                          "object/get",
                          "@stage0",
                          "label"
                        ]
                      ],
                      [
                        "set",
                        "@entity.stageDescription",
                        [
                          "object/get",
                          "@stage0",
                          "description"
                        ]
                      ],
                      [
                        "set",
                        "@entity.starShapes",
                        [
                          {
                            "color": [
                              "object/get",
                              "@stage0",
                              "color"
                            ],
                            "fill": [
                              "object/get",
                              "@stage0",
                              "color"
                            ],
                            "id": "star",
                            "radius": [
                              "object/get",
                              "@stage0",
                              "radius"
                            ],
                            "type": "circle",
                            "x": "@cx",
                            "y": "@cy"
                          },
                          {
                            "align": "center",
                            "color": "#f8fafc",
                            "fontSize": 18.0,
                            "id": "stageText",
                            "text": "@entity.stageLabel",
                            "type": "text",
                            "x": "@cx",
                            "y": [
                              "+",
                              "@cy",
                              [
                                "object/get",
                                "@stage0",
                                "radius"
                              ],
                              30.0
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.starShapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "Initial mass: ",
                                    "@entity.initialMass",
                                    " solar masses"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "children": [
                                    "array/map",
                                    "@config.massPresets",
                                    [
                                      "fn",
                                      "m",
                                      {
                                        "action": "SET_MASS",
                                        "actionPayload": {
                                          "value": "@m"
                                        },
                                        "label": [
                                          "str/concat",
                                          "@m",
                                          " M☉"
                                        ],
                                        "size": "sm",
                                        "type": "button",
                                        "variant": [
                                          "if",
                                          [
                                            "==",
                                            "@entity.initialMass",
                                            "@m"
                                          ],
                                          "primary",
                                          "ghost"
                                        ]
                                      }
                                    ]
                                  ],
                                  "direction": "horizontal",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "max": 25.0,
                                  "min": 0.1,
                                  "onChange": "SET_MASS",
                                  "showTooltip": true,
                                  "step": 0.1,
                                  "type": "range-slider",
                                  "value": "@entity.initialMass"
                                },
                                {
                                  "content": "@entity.stageLabel",
                                  "type": "typography",
                                  "variant": "h4"
                                },
                                {
                                  "content": "@entity.stageDescription",
                                  "type": "typography",
                                  "variant": "body"
                                },
                                {
                                  "content": [
                                    "str/concat",
                                    "Predicted end state: ",
                                    "@entity.pathEndLabel"
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "children": [
                                    {
                                      "action": "STEP_STAGE",
                                      "label": "Next Stage",
                                      "type": "button",
                                      "variant": "primary"
                                    },
                                    {
                                      "action": "RESET_STAGE",
                                      "label": "Reset Lifecycle",
                                      "type": "button",
                                      "variant": "ghost"
                                    }
                                  ],
                                  "direction": "horizontal",
                                  "gap": "sm",
                                  "type": "stack"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "STELLAR_UPDATED",
                    {
                      "currentStageIndex": "@entity.currentStageIndex",
                      "initialMass": "@entity.initialMass",
                      "pathEndLabel": "@entity.pathEndLabel",
                      "stageLabel": "@entity.stageLabel"
                    }
                  ]
                ],
                "event": "RESET_STAGE",
                "eventId": "evt_01KZEFTKK7Z6QH5Z1V4ZFRG02Z",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}