      "traits": [
        {
          "category": "interaction",
          "config": {
            "backgroundColor": {
              "default": "#0f172a",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "height": {
              "default": 460.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "initialMass": {
              "default": 1.0,
              "description": "Starting stellar mass in solar masses; determines which life-cycle path the star follows.",
              "label": "Initial Stellar Mass",
              "synonyms": "solar mass, star mass, initial mass",
              "tier": "domain",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "massPresets": {
              "default": [
                0.5,
                1.0,
                8.0,
                20.0
              ],
              "description": "Quick-pick starting masses, in solar masses, shown as preset buttons.",
              "items": {
                "type": "number"
              },
              "label": "Mass Presets",
              "tier": "domain",
              "type": "[number]"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "stellarPaths": {
              "default": [
                {
                  "endLabel": "White Dwarf",
                  "maxMass": 7.9,
                  "stages": [
                    {
                      "color": "#94a3b8",
                      "description": "A vast cloud of gas and dust collapses under its own gravity, and a protostar begins to glow at its center.",
                      "label": "Nebula",
                      "radius": 95.0
                    },
                    {
                      "color": "#facc15",
                      "description": "Hydrogen fuses into helium in the core, and the star shines steadily for billions of years — this is where our Sun is now.",
                      "label": "Main Sequence",
                      "radius": 42.0
                    },
                    {
                      "color": "#f97316",
                      "description": "The core runs out of hydrogen and contracts while the outer layers swell and cool into a huge red envelope.",
                      "label": "Red Giant",
                      "radius": 100.0
                    },
                    {
                      "color": "#e0f2fe",
                      "description": "The outer layers drift away as a planetary nebula, leaving behind a hot, dense stellar remnant that slowly cools and fades.",
                      "label": "White Dwarf",
                      "radius": 16.0
                    }
                  ]
                },
                {
                  "endLabel": "Neutron Star",
                  "maxMass": 19.9,
                  "stages": [
                    {
                      "color": "#94a3b8",
                      "description": "A vast cloud of gas and dust collapses under its own gravity, forming a protostar far more massive than the Sun.",
                      "label": "Nebula",
                      "radius": 110.0
                    },
                    {
                      "color": "#93c5fd",
                      "description": "The star burns through hydrogen far faster than a Sun-like star, shining bright blue-white.",
                      "label": "Main Sequence",
                      "radius": 55.0
                    },
                    {
                      "color": "#dc2626",
                      "description": "Heavier elements fuse in shells around an iron core, until fusion can no longer release energy.",
                      "label": "Red Supergiant",
                      "radius": 130.0
                    },
                    {
                      "color": "#fef08a",
                      "description": "The core collapses in an instant and rebounds, blasting the star's outer layers into space in a brilliant explosion.",
                      "label": "Supernova",
                      "radius": 150.0
                    },
                    {
                      "color": "#a78bfa",
                      "description": "The crushed core survives as an ultra-dense sphere of neutrons, often spinning rapidly as a pulsar.",
                      "label": "Neutron Star",
                      "radius": 10.0
                    }
                  ]
                },
                {
                  "endLabel": "Black Hole",
                  "maxMass": 999.0,
                  "stages": [
                    {
                      "color": "#94a3b8",
                      "description": "A vast cloud of gas and dust collapses under its own gravity, forming an extremely massive protostar.",
                      "label": "Nebula",
                      "radius": 130.0
                    },
                    {
                      "color": "#60a5fa",
                      "description": "The star burns its fuel at a furious rate, glowing intensely blue and living only a few million years.",
                      "label": "Main Sequence",
                      "radius": 65.0
                    },
                    {
                      "color": "#3b82f6",
                      "description": "The star swells into an enormous, luminous supergiant while fusing progressively heavier elements in its core.",
                      "label": "Blue Supergiant",
                      "radius": 150.0
                    },
                    {
                      "color": "#fef08a",
                      "description": "The iron core collapses catastrophically and the star detonates, briefly outshining an entire galaxy.",
                      "label": "Supernova",
                      "radius": 170.0
                    },
                    {
                      "color": "#020617",
                      "description": "Gravity overwhelms every other force, and the collapsed core forms a black hole from which not even light can escape.",
                      "label": "Black Hole",
                      "radius": 14.0
                    }
                  ]
                }
              ],
              "description": "Mass-threshold roster of life-cycle paths; the path whose maxMass first covers the initial mass is used. Each path supplies its own ordered stage list (label/description/color/radius) so fill_params can re-theme or extend the life-cycle.",
              "items": {
                "properties": {
                  "endLabel": {
                    "name": "endLabel",
                    "required": false,
                    "type": "string"
                  },
                  "maxMass": {
                    "name": "maxMass",
                    "required": true,
                    "type": "number"
                  },
                  "stages": {
                    "items": {
                      "properties": {
                        "color": {
                          "name": "color",
                          "required": false,
                          "type": "string"
                        },
                        "description": {
                          "name": "description",
                          "required": false,
                          "type": "string"
                        },
                        "label": {
                          "name": "label",
                          "required": true,
                          "type": "string"
                        },
                        "radius": {
                          "name": "radius",
                          "required": false,
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "name": "stages",
                    "required": true,
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "label": "Stellar Life-cycle Paths",
              "tier": "domain",
              "type": "[AstroStellarPath]"
            },
            "title": {
              "default": "Star Life-Cycle Simulator",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 640.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The star's life-cycle state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "STELLAR_UPDATED",
              "eventId": "evt_01KZEFTKK74SH3K0C4E36AG7M9",
              "payloadSchema": [
                {
                  "name": "initialMass",
                  "type": "number"
                },
                {
                  "name": "currentStageIndex",
                  "type": "number"
                },
                {
                  "name": "stageLabel",
                  "type": "string"
                },
                {
                  "name": "pathEndLabel",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "stellar update, life-cycle stage, star mass change, stage advance",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "currentStageIndex",
              "initialMass",
              "pathEndLabel",
              "stageDescription",
              "stageLabel",
              "stages",
              "starShapes",
              "title"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "AstroStellarScene": "ent_01KZEFTKK6RDEQ4F4G1SNC7RG7"
          },
          "id": "trt_01KZEFTKK61G52AYPZ15RBQCB1",
          "linkedEntity": "AstroStellarScene",
          "linkedEntityId": "ent_01KZEFTKK6RDEQ4F4G1SNC7RG7",
          "name": "AstroStellarSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZEFTKK6QCPX13PDNYSTHJT6",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZEFTKK7NS3A522B7WER4Z81",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner set the initial stellar mass, via slider or a preset button.",
                "id": "evt_01KZEFTKK775AD2FG5W9C7JFHP",
                "key": "SET_MASS",
                "name": "Set Mass",
                "payloadSchema": [
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner pressed Next Stage to advance the star to its next life-cycle stage.",
                "id": "evt_01KZEFTKK754VRF5Y245MFNB0Z",
                "key": "STEP_STAGE",
                "name": "Step Stage",
                "tier": "domain"
              },
              {
                "description": "Learner pressed Reset Lifecycle to return the star to its first stage.",
                "id": "evt_01KZEFTKK7Z6QH5Z1V4ZFRG02Z",
                "key": "RESET_STAGE",
                "name": "Reset Stage",
                "tier": "domain"
              },
              {
                "description": "The star's life-cycle state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZEFTKK74SH3K0C4E36AG7M9",
                "key": "STELLAR_UPDATED",
                "name": "Stellar Updated",
                "payloadSchema": [
                  {
                    "name": "initialMass",
                    "type": "number"
                  },
                  {
                    "name": "currentStageIndex",
                    "type": "number"
                  },
                  {
                    "name": "stageLabel",
                    "type": "string"
                  },
                  {
                    "name": "pathEndLabel",
                    "type": "string"
                  }
                ],
                "synonyms": "stellar update, life-cycle stage, star mass change, stage advance",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "let",
                    [
                      [
                        "mass",
                        "@config.initialMass"
                      ],
                      [
                        "matched",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.stellarPaths",
                            [
                              "fn",
                              "p",
                              [
                                "<=",
                                "@mass",
                                [
                                  "object/get",
                                  "@p",
                                  "maxMass"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "selectedPath",
                        [
                          "if",
                          [
                            "==",
                            "@matched",
                            null
                          ],
                          [
                            "array/last",
                            "@config.stellarPaths"
                          ],
                          "@matched"
                        ]
                      ],
                      [
                        "stage0",
                        [
                          "array/nth",
                          [
                            "object/get",
                            "@selectedPath",
                            "stages"
                          ],
                          0.0
                        ]
                      ],
                      [
                        "cx",
                        [
                          "/",
                          "@config.width",
                          2.0
                        ]
                      ],
                      [
                        "cy",
                        [
                          "/",
                          "@config.height",
                          2.0
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.initialMass",
                        "@mass"
                      ],
                      [
                        "set",
                        "@entity.pathEndLabel",
                        [
                          "object/get",
                          "@selectedPath",
                          "endLabel"
                        ]
                      ],
                      [
                        "set",
                        "@entity.stages",
                        [
                          "object/get",
                          "@selectedPath",
                          "stages"
                        ]
                      ],
                      [
                        "set",
                        "@entity.currentStageIndex",
                        0.0
                      ],
                      [
                        "set",
                        "@entity.stageLabel",
                        [
                          "object/get",
                          "@stage0",
                          "label"
                        ]
                      ],
                      [
                        "set",
                        "@entity.stageDescription",
                        [
                          "object/get",
                          "@stage0",
                          "description"
                        ]
                      ],
                      [
                        "set",
                        "@entity.starShapes",
                        [
                          {
                            "color": [
                              "object/get",
                              "@stage0",
                              "color"
                            ],
                            "fill": [
                              "object/get",
                              "@stage0",
                              "color"
                            ],
                            "id": "star",
                            "radius": [
                              "object/get",
                              "@stage0",
                              "radius"
                            ],
                            "type": "circle",
                            "x": "@cx",
                            "y": "@cy"
                          },
                          {
                            "align": "center",
                            "color": "#f8fafc",
                            "fontSize": 18.0,
                            "id": "stageText",
                            "text": "@entity.stageLabel",
                            "type": "text",
                            "x": "@cx",
                            "y": [
                              "+",
                              "@cy",
                              [
                                "object/get",
                                "@stage0",
                                "radius"
                              ],
                              30.0
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": false,
