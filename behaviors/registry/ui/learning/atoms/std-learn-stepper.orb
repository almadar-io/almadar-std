                                "tone": "label",
                                "type": "text",
                                "x": [
                                  "+",
                                  [
                                    "+",
                                    "@config.axisMarginLeft",
                                    [
                                      "*",
                                      "@index",
                                      [
                                        "/",
                                        "@axisWidth",
                                        [
                                          "array/len",
                                          "@config.categories"
                                        ]
                                      ]
                                    ]
                                  ],
                                  12.0
                                ],
                                "y": 26.0
                              }
                            ]
                          ]
                        ]
