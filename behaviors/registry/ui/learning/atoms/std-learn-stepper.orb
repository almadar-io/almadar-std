                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZEGGJW89GS6HN8CC3SMVV3J",
                "from": "idle",
                "guard": [
                  "==",
                  "@payload.mode",
                  "@config.matchMode"
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.cursorIndex",
                    [
                      "math/min",
                      [
                        "+",
                        "@entity.cursorIndex",
                        1.0
                      ],
                      [
                        "-",
                        [
                          "array/len",
                          "@config.stages"
                        ],
                        1.0
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "currentPosition",
                        [
                          "if",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@config.stages",
                              "@entity.cursorIndex"
                            ],
                            "position"
                          ],
                          [
                            "-",
                            "@config.minPosition",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "currentStage",
                        [
                          "if",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            "array/nth",
                            "@config.stages",
                            "@entity.cursorIndex"
                          ],
                          null
                        ]
                      ],
                      [
                        "totalStages",
                        [
                          "array/len",
                          "@config.stages"
                        ]
                      ],
                      [
                        "atEnd",
                        [
                          "and",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            ">=",
                            "@entity.cursorIndex",
                            [
                              "-",
                              "@totalStages",
                              1.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "stageLabel",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "object/get",
                            "@currentStage",
                            "label"
                          ],
                          ""
                        ]
                      ],
                      [
                        "stageDescription",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "object/get",
                            "@currentStage",
                            "description"
                          ],
                          "@config.startPrompt"
                        ]
                      ],
                      [
                        "boundedDescription",
                        [
                          "if",
                          "@atEnd",
                          [
                            "str/concat",
                            "@stageDescription",
                            "@config.atEndNote"
                          ],
                          "@stageDescription"
                        ]
                      ],
                      [
                        "narration",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "str/concat",
                            [
                              "str/concat",
                              "",
                              [
                                "object/get",
                                "@currentStage",
                                "position"
                              ]
                            ],
                            " — ",
                            "@stageLabel",
                            ". ",
                            "@boundedDescription"
                          ],
                          "@config.startPrompt"
                        ]
                      ],
                      [
                        "tallyParts",
                        [
                          "array/map",
                          "@config.categories",
                          [
                            "fn",
                            "cc",
                            [
                              "str/concat",
                              [
                                "object/get",
                                "@cc",
                                "label"
                              ],
                              ": ",
                              [
                                "array/len",
                                [
                                  "array/filter",
                                  "@config.stages",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      "and",
                                      [
                                        "<=",
                                        "@s.position",
                                        "@currentPosition"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        [
                                          "object/get",
                                          "@cc",
                                          "category"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "categoryTally",
                        [
                          "str/join",
                          "@tallyParts",
                          " · "
                        ]
                      ],
                      [
                        "tallyItems",
                        [
                          "array/map",
                          "@config.categories",
                          [
                            "fn",
                            "cc",
                            {
                              "count": [
                                "array/len",
                                [
                                  "array/filter",
                                  "@config.stages",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      "and",
                                      [
                                        "<=",
                                        "@s.position",
                                        "@currentPosition"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        [
                                          "object/get",
                                          "@cc",
                                          "category"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              "label": [
                                "object/get",
                                "@cc",
                                "label"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "visibleThreadNote",
                        [
                          "if",
                          [
                            "==",
                            "@entity.activeFilter",
                            "all"
                          ],
                          "@config.allSummary",
                          [
                            "object/get",
                            [
                              "array/first",
                              [
                                "array/filter",
                                "@config.categorySummaries",
                                [
                                  "fn",
                                  "cs",
                                  [
                                    "==",
                                    "@cs.category",
                                    "@entity.activeFilter"
                                  ]
                                ]
                              ]
                            ],
                            "summary"
                          ]
                        ]
                      ],
                      [
                        "axisWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "+",
                            "@config.axisMarginLeft",
                            "@config.axisMarginRight"
                          ]
                        ]
                      ],
                      [
                        "baseShapes",
                        [
                          {
                            "id": "axis",
                            "opacity": 1.0,
                            "stroke": "normal",
                            "tone": "axis",
                            "type": "line",
                            "x1": "@config.axisMarginLeft",
                            "x2": [
                              "-",
                              "@config.width",
                              "@config.axisMarginRight"
                            ],
                            "y1": "@config.axisY",
                            "y2": "@config.axisY"
                          },
                          {
                            "align": "left",
                            "id": "minPositionLabel",
                            "text": [
                              "str/concat",
                              "",
                              "@config.minPosition"
                            ],
                            "textSize": "xs",
                            "tone": "label",
                            "type": "text",
                            "x": "@config.axisMarginLeft",
                            "y": [
                              "+",
                              "@config.axisY",
                              26.0
                            ]
                          },
                          {
                            "align": "right",
                            "id": "maxPositionLabel",
                            "text": [
                              "str/concat",
                              "",
                              "@config.maxPosition"
