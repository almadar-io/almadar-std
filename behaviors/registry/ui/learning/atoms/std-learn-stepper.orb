                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "align": "start",
                              "children": [
                                {
                                  "children": [
                                    {
                                      "content": "@entity.title",
                                      "type": "typography",
                                      "variant": "h4"
                                    },
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@config.summary",
