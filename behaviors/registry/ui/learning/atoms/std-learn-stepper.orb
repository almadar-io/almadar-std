                              "@config.axisMarginRight"
                            ],
                            "y": [
                              "+",
                              "@config.axisY",
                              26.0
                            ]
                          }
                        ]
                      ],
                      [
                        "markerShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.stages",
                            [
                              "fn",
                              "s",
                              [
                                "let",
                                [
                                  [
                                    "isRevealed",
                                    [
                                      "<=",
                                      "@s.position",
                                      "@currentPosition"
                                    ]
                                  ],
                                  [
                                    "isCurrent",
                                    [
                                      "==",
                                      "@s.position",
                                      "@currentPosition"
                                    ]
                                  ],
                                  [
                                    "matchesFilter",
                                    [
                                      "or",
                                      [
                                        "==",
                                        "@entity.activeFilter",
                                        "all"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        "@entity.activeFilter"
                                      ]
                                    ]
                                  ],
                                  [
                                    "catColorObj",
                                    [
                                      "array/first",
                                      [
                                        "array/filter",
                                        "@config.categories",
                                        [
                                          "fn",
                                          "cc",
                                          [
                                            "==",
                                            "@cc.category",
                                            "@s.category"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "catColor",
                                    [
                                      "object/get",
                                      "@catColorObj",
                                      "color"
                                    ]
                                  ],
                                  [
                                    "col",
                                    [
                                      "if",
                                      "@isRevealed",
                                      "@catColor",
                                      "@config.unreachedColor"
                                    ]
                                  ],
                                  [
                                    "baseOpacity",
                                    [
                                      "if",
                                      "@isRevealed",
                                      0.9,
                                      0.35
                                    ]
                                  ],
                                  [
                                    "finalOpacity",
                                    [
                                      "if",
                                      "@matchesFilter",
                                      "@baseOpacity",
                                      [
                                        "*",
                                        "@baseOpacity",
                                        0.25
                                      ]
                                    ]
                                  ],
                                  [
                                    "xPos",
                                    [
                                      "+",
                                      "@config.axisMarginLeft",
                                      [
                                        "*",
                                        [
                                          "/",
                                          [
                                            "-",
                                            "@s.position",
                                            "@config.minPosition"
                                          ],
                                          [
                                            "-",
                                            "@config.maxPosition",
                                            "@config.minPosition"
                                          ]
                                        ],
                                        "@axisWidth"
                                      ]
                                    ]
                                  ],
                                  [
                                    "rad",
                                    [
                                      "if",
                                      "@isCurrent",
                                      "@config.markerHighlightRadius",
                                      "@config.markerRadius"
                                    ]
                                  ]
                                ],
                                [
                                  "if",
                                  "@isCurrent",
                                  [
                                    {
                                      "fillStyle": "outline",
                                      "id": [
                                        "str/concat",
                                        "ring-",
                                        "@s.position"
                                      ],
                                      "opacity": 1.0,
                                      "radius": [
                                        "+",
                                        "@rad",
                                        5.0
                                      ],
                                      "stroke": "bold",
                                      "tone": "@catColor",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    },
                                    {
                                      "fillStyle": "solid",
                                      "fillTone": "@col",
                                      "id": [
                                        "str/concat",
                                        "marker-",
                                        "@s.position"
                                      ],
                                      "opacity": "@finalOpacity",
                                      "radius": "@rad",
                                      "tone": "@col",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    }
                                  ],
                                  [
                                    {
                                      "fillStyle": "solid",
                                      "fillTone": "@col",
                                      "id": [
                                        "str/concat",
                                        "marker-",
                                        "@s.position"
                                      ],
                                      "opacity": "@finalOpacity",
                                      "radius": "@rad",
                                      "tone": "@col",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
