                                  ],
                                  [
                                    "baseOpacity",
                                    [
                                      "if",
                                      "@isRevealed",
                                      0.9,
                                      0.35
                                    ]
                                  ],
                                  [
                                    "finalOpacity",
                                    [
                                      "if",
                                      "@matchesFilter",
                                      "@baseOpacity",
                                      [
                                        "*",
                                        "@baseOpacity",
                                        0.25
                                      ]
                                    ]
                                  ],
