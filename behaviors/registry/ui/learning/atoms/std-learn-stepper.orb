                    "set",
                    "@entity.cursorIndex",
                    -1.0
                  ],
                  [
                    "set",
                    "@entity.activeFilter",
                    "all"
                  ],
                  [
                    "let",
                    [
                      [
                        "currentPosition",
                        [
                          "if",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@config.stages",
                              "@entity.cursorIndex"
                            ],
                            "position"
                          ],
                          [
                            "-",
                            "@config.minPosition",
                            1.0
                          ]
                        ]
                      ],
                      [
                        "currentStage",
                        [
                          "if",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            "array/nth",
                            "@config.stages",
                            "@entity.cursorIndex"
                          ],
                          null
                        ]
                      ],
                      [
                        "totalStages",
                        [
                          "array/len",
                          "@config.stages"
                        ]
                      ],
                      [
                        "atEnd",
                        [
                          "and",
                          [
                            ">=",
                            "@entity.cursorIndex",
                            0.0
                          ],
                          [
                            ">=",
                            "@entity.cursorIndex",
                            [
                              "-",
                              "@totalStages",
                              1.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "stageLabel",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "object/get",
                            "@currentStage",
                            "label"
                          ],
                          ""
                        ]
                      ],
                      [
                        "stageDescription",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "object/get",
                            "@currentStage",
                            "description"
                          ],
                          "@config.startPrompt"
                        ]
                      ],
                      [
                        "boundedDescription",
                        [
                          "if",
                          "@atEnd",
                          [
                            "str/concat",
                            "@stageDescription",
                            "@config.atEndNote"
                          ],
                          "@stageDescription"
                        ]
                      ],
                      [
                        "narration",
                        [
                          "if",
                          [
                            "!=",
                            "@currentStage",
                            null
                          ],
                          [
                            "str/concat",
                            [
                              "str/concat",
                              "",
                              [
                                "object/get",
                                "@currentStage",
                                "position"
                              ]
                            ],
                            " — ",
                            "@stageLabel",
                            ". ",
                            "@boundedDescription"
                          ],
                          "@config.startPrompt"
                        ]
                      ],
                      [
                        "tallyParts",
                        [
                          "array/map",
                          "@config.categories",
                          [
                            "fn",
                            "cc",
                            [
                              "str/concat",
                              [
                                "object/get",
                                "@cc",
                                "label"
                              ],
                              ": ",
                              [
                                "array/len",
                                [
                                  "array/filter",
                                  "@config.stages",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      "and",
                                      [
                                        "<=",
                                        "@s.position",
                                        "@currentPosition"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        [
                                          "object/get",
                                          "@cc",
                                          "category"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "categoryTally",
                        [
                          "str/join",
                          "@tallyParts",
                          " · "
                        ]
                      ],
                      [
                        "tallyItems",
                        [
                          "array/map",
                          "@config.categories",
                          [
                            "fn",
                            "cc",
                            {
                              "count": [
                                "array/len",
                                [
                                  "array/filter",
                                  "@config.stages",
                                  [
                                    "fn",
                                    "s",
                                    [
                                      "and",
                                      [
                                        "<=",
                                        "@s.position",
                                        "@currentPosition"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        [
                                          "object/get",
                                          "@cc",
                                          "category"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              "label": [
                                "object/get",
                                "@cc",
                                "label"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "visibleThreadNote",
                        [
                          "if",
                          [
                            "==",
                            "@entity.activeFilter",
                            "all"
                          ],
                          "@config.allSummary",
                          [
                            "object/get",
                            [
                              "array/first",
                              [
                                "array/filter",
                                "@config.categorySummaries",
                                [
                                  "fn",
                                  "cs",
                                  [
                                    "==",
                                    "@cs.category",
                                    "@entity.activeFilter"
                                  ]
                                ]
                              ]
                            ],
                            "summary"
                          ]
                        ]
                      ],
                      [
                        "axisWidth",
                        [
                          "-",
                          "@config.width",
                          [
                            "+",
                            "@config.axisMarginLeft",
                            "@config.axisMarginRight"
                          ]
                        ]
                      ],
                      [
                        "baseShapes",
                        [
                          {
                            "id": "axis",
                            "opacity": 1.0,
                            "stroke": "normal",
                            "tone": "axis",
                            "type": "line",
                            "x1": "@config.axisMarginLeft",
                            "x2": [
                              "-",
                              "@config.width",
                              "@config.axisMarginRight"
                            ],
                            "y1": "@config.axisY",
                            "y2": "@config.axisY"
                          },
                          {
                            "align": "left",
                            "id": "minPositionLabel",
                            "text": [
                              "str/concat",
                              "",
                              "@config.minPosition"
                            ],
                            "textSize": "xs",
                            "tone": "label",
                            "type": "text",
                            "x": "@config.axisMarginLeft",
                            "y": [
                              "+",
                              "@config.axisY",
                              26.0
                            ]
                          },
                          {
                            "align": "right",
                            "id": "maxPositionLabel",
                            "text": [
                              "str/concat",
                              "",
                              "@config.maxPosition"
                            ],
                            "textSize": "xs",
                            "tone": "label",
                            "type": "text",
                            "x": [
                              "-",
                              "@config.width",
                              "@config.axisMarginRight"
                            ],
                            "y": [
                              "+",
                              "@config.axisY",
                              26.0
                            ]
                          }
                        ]
                      ],
                      [
                        "markerShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.stages",
                            [
                              "fn",
                              "s",
                              [
                                "let",
                                [
                                  [
                                    "isRevealed",
                                    [
                                      "<=",
                                      "@s.position",
                                      "@currentPosition"
                                    ]
                                  ],
                                  [
                                    "isCurrent",
                                    [
                                      "==",
                                      "@s.position",
                                      "@currentPosition"
                                    ]
                                  ],
                                  [
                                    "matchesFilter",
                                    [
                                      "or",
                                      [
                                        "==",
                                        "@entity.activeFilter",
                                        "all"
                                      ],
                                      [
                                        "==",
                                        "@s.category",
                                        "@entity.activeFilter"
                                      ]
                                    ]
                                  ],
                                  [
                                    "catColorObj",
                                    [
                                      "array/first",
                                      [
                                        "array/filter",
                                        "@config.categories",
                                        [
                                          "fn",
                                          "cc",
                                          [
                                            "==",
                                            "@cc.category",
                                            "@s.category"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "catColor",
                                    [
                                      "object/get",
                                      "@catColorObj",
                                      "color"
                                    ]
                                  ],
                                  [
                                    "col",
                                    [
                                      "if",
                                      "@isRevealed",
                                      "@catColor",
                                      "@config.unreachedColor"
                                    ]
                                  ],
                                  [
                                    "baseOpacity",
                                    [
                                      "if",
                                      "@isRevealed",
                                      0.9,
                                      0.35
                                    ]
                                  ],
                                  [
                                    "finalOpacity",
                                    [
                                      "if",
                                      "@matchesFilter",
                                      "@baseOpacity",
                                      [
                                        "*",
                                        "@baseOpacity",
                                        0.25
                                      ]
                                    ]
                                  ],
                                  [
                                    "xPos",
                                    [
                                      "+",
                                      "@config.axisMarginLeft",
                                      [
                                        "*",
                                        [
                                          "/",
                                          [
                                            "-",
                                            "@s.position",
                                            "@config.minPosition"
                                          ],
                                          [
                                            "-",
                                            "@config.maxPosition",
                                            "@config.minPosition"
                                          ]
                                        ],
                                        "@axisWidth"
                                      ]
                                    ]
                                  ],
                                  [
                                    "rad",
                                    [
                                      "if",
                                      "@isCurrent",
                                      "@config.markerHighlightRadius",
                                      "@config.markerRadius"
                                    ]
                                  ]
                                ],
                                [
                                  "if",
                                  "@isCurrent",
                                  [
                                    {
                                      "fillStyle": "outline",
                                      "id": [
                                        "str/concat",
                                        "ring-",
                                        "@s.position"
                                      ],
                                      "opacity": 1.0,
                                      "radius": [
                                        "+",
                                        "@rad",
                                        5.0
                                      ],
                                      "stroke": "bold",
                                      "tone": "@catColor",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    },
                                    {
                                      "fillStyle": "solid",
                                      "fillTone": "@col",
                                      "id": [
                                        "str/concat",
                                        "marker-",
                                        "@s.position"
                                      ],
                                      "opacity": "@finalOpacity",
                                      "radius": "@rad",
                                      "tone": "@col",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    }
                                  ],
                                  [
                                    {
                                      "fillStyle": "solid",
                                      "fillTone": "@col",
                                      "id": [
                                        "str/concat",
                                        "marker-",
                                        "@s.position"
                                      ],
                                      "opacity": "@finalOpacity",
                                      "radius": "@rad",
                                      "tone": "@col",
                                      "type": "circle",
                                      "x": "@xPos",
                                      "y": "@config.axisY"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "legendShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@config.categories",
                            [
                              {
                                "fillStyle": "solid",
                                "fillTone": [
                                  "object/get",
                                  "@item",
                                  "color"
                                ],
                                "id": [
                                  "str/concat",
                                  "legend-dot-",
                                  "@index"
                                ],
                                "opacity": 1.0,
                                "radius": 5.0,
                                "tone": [
                                  "object/get",
                                  "@item",
                                  "color"
                                ],
                                "type": "circle",
                                "x": [
                                  "+",
                                  "@config.axisMarginLeft",
                                  [
                                    "*",
                                    "@index",
                                    [
                                      "/",
                                      "@axisWidth",
                                      [
                                        "array/len",
                                        "@config.categories"
                                      ]
                                    ]
                                  ]
                                ],
                                "y": 22.0
                              },
                              {
                                "align": "left",
                                "id": [
                                  "str/concat",
                                  "legend-label-",
                                  "@index"
                                ],
                                "text": [
                                  "object/get",
                                  "@item",
                                  "label"
                                ],
                                "textSize": "xs",
                                "tone": "label",
                                "type": "text",
                                "x": [
                                  "+",
                                  [
                                    "+",
                                    "@config.axisMarginLeft",
                                    [
                                      "*",
                                      "@index",
                                      [
                                        "/",
                                        "@axisWidth",
                                        [
                                          "array/len",
                                          "@config.categories"
                                        ]
                                      ]
                                    ]
                                  ],
                                  12.0
                                ],
                                "y": 26.0
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "allShapes",
                        [
                          "array/concat",
                          "@baseShapes",
                          "@markerShapes",
                          "@legendShapes"
                        ]
                      ],
                      [
                        "filterButtons",
                        [
                          "array/concat",
                          [
                            {
                              "action": "FILTER_CATEGORY",
                              "actionPayload": {
                                "category": "all"
                              },
                              "aria-pressed": [
                                "if",
                                [
                                  "==",
                                  "@entity.activeFilter",
                                  "all"
                                ],
                                "true",
                                "false"
                              ],
                              "label": "@config.allLabel",
                              "size": "sm",
                              "type": "button",
                              "variant": [
                                "if",
                                [
                                  "==",
                                  "@entity.activeFilter",
                                  "all"
                                ],
                                "secondary",
                                "ghost"
                              ]
                            }
                          ],
                          [
                            "array/map",
                            "@config.categories",
                            [
                              "fn",
                              "cc",
                              {
                                "action": "FILTER_CATEGORY",
                                "actionPayload": {
                                  "category": [
                                    "object/get",
                                    "@cc",
                                    "category"
                                  ]
                                },
                                "aria-pressed": [
                                  "if",
                                  [
                                    "==",
                                    "@entity.activeFilter",
                                    [
                                      "object/get",
                                      "@cc",
                                      "category"
                                    ]
                                  ],
                                  "true",
                                  "false"
                                ],
                                "label": [
                                  "object/get",
                                  "@cc",
                                  "label"
                                ],
                                "size": "sm",
                                "type": "button",
                                "variant": [
                                  "if",
                                  [
                                    "==",
                                    "@entity.activeFilter",
                                    [
                                      "object/get",
                                      "@cc",
                                      "category"
                                    ]
                                  ],
                                  "secondary",
                                  "ghost"
                                ]
                              }
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.narration",
                        "@narration"
                      ],
                      [
                        "set",
                        "@entity.currentStageLabel",
                        "@stageLabel"
                      ],
                      [
                        "set",
                        "@entity.currentStageDescription",
                        "@boundedDescription"
                      ],
                      [
                        "set",
                        "@entity.categoryTally",
                        "@categoryTally"
                      ],
                      [
                        "set",
                        "@entity.tallyItems",
                        "@tallyItems"
                      ],
                      [
                        "set",
                        "@entity.visibleThreadNote",
                        "@visibleThreadNote"
                      ],
                      [
                        "set",
                        "@entity.shapes",
                        "@allShapes"
                      ],
                      [
                        "set",
                        "@entity.filterButtons",
                        "@filterButtons"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "align": "start",
                              "children": [
                                {
                                  "children": [
                                    {
                                      "content": "@entity.title",
                                      "type": "typography",
                                      "variant": "h4"
                                    },
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@config.summary",
                                        ""
                                      ],
                                      null,
                                      {
                                        "color": "muted",
                                        "content": "@config.summary",
                                        "type": "typography",
                                        "variant": "body2"
                                      }
                                    ]
                                  ],
                                  "direction": "vertical",
                                  "gap": "xs",
                                  "type": "stack"
                                },
                                {
                                  "label": [
                                    "if",
                                    [
                                      "<=",
                                      "@entity.cursorIndex",
                                      -1.0
                                    ],
                                    "Not started",
                                    [
                                      "if",
                                      [
                                        ">=",
                                        "@entity.cursorIndex",
                                        [
                                          "-",
                                          [
                                            "array/len",
                                            "@config.stages"
                                          ],
                                          1.0
                                        ]
                                      ],
                                      "Complete",
                                      [
                                        "str/concat",
                                        "Stage ",
                                        [
                                          "+",
                                          "@entity.cursorIndex",
                                          1.0
                                        ],
                                        " of ",
                                        [
                                          "array/len",
                                          "@config.stages"
                                        ]
                                      ]
                                    ]
                                  ],
                                  "type": "badge",
                                  "variant": [
                                    "if",
                                    [
                                      "<=",
                                      "@entity.cursorIndex",
                                      -1.0
                                    ],
                                    "neutral",
                                    [
                                      "if",
                                      [
                                        ">=",
                                        "@entity.cursorIndex",
                                        [
                                          "-",
                                          [
                                            "array/len",
                                            "@config.stages"
                                          ],
                                          1.0
                                        ]
                                      ],
                                      "success",
                                      "primary"
                                    ]
                                  ]
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "md",
                              "justify": "between",
                              "type": "stack"
                            },
                            {
                              "align": "center",
                              "children": [
                                {
                                  "action": "NEXT",
                                  "disabled": [
                                    ">=",
                                    "@entity.cursorIndex",
                                    [
                                      "-",
                                      [
                                        "array/len",
                                        "@config.stages"
                                      ],
                                      1.0
                                    ]
                                  ],
                                  "icon": "chevron-right",
                                  "label": "Next",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "PREV",
                                  "disabled": [
                                    "<=",
                                    "@entity.cursorIndex",
                                    -1.0
                                  ],
                                  "icon": "chevron-left",
                                  "label": "Prev",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET_STEPPER",
                                  "icon": "rotate-ccw",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                },
                                {
                                  "color": "muted",
                                  "content": [
                                    "str/concat",
                                    "Stage ",
                                    [
                                      "+",
                                      "@entity.cursorIndex",
                                      1.0
                                    ],
                                    " of ",
                                    [
                                      "array/len",
                                      "@config.stages"
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack",
                              "wrap": true
                            },
                            {
                              "max": [
                                "array/len",
                                "@config.stages"
                              ],
                              "showPercentage": false,
                              "type": "progress-bar",
                              "value": [
                                "+",
                                "@entity.cursorIndex",
                                1.0
                              ]
                            },
                            {
                              "align": "center",
                              "aria-label": "Category lens",
                              "children": "@entity.filterButtons",
                              "direction": "horizontal",
                              "gap": "xs",
                              "role": "group",
                              "type": "stack",
                              "wrap": true
                            },
                            {
                              "animate": "@config.animate",
                              "backgroundColor": "@config.backgroundColor",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "keyMap": {
                                "ArrowLeft": "PREV",
                                "ArrowRight": "NEXT",
                                "KeyR": "RESET_STEPPER"
                              },
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                {
                                  "content": "@entity.currentStageDescription",
                                  "type": "typography",
                                  "variant": "body"
                                }
                              ],
                              "padding": "md",
                              "title": [
                                "if",
                                [
                                  "!=",
                                  "@entity.currentStageLabel",
                                  ""
                                ],
                                "@entity.currentStageLabel",
                                "Not Started"
                              ],
                              "type": "card",
                              "variant": "bordered"
                            },
                            {
                              "children": [
                                "array/map",
                                "@entity.tallyItems",
                                [
                                  "fn",
                                  "t",
                                  {
                                    "label": [
                                      "str/concat",
                                      [
                                        "object/get",
                                        "@t",
                                        "label"
                                      ],
                                      ": ",
                                      [
                                        "str/concat",
                                        "",
                                        [
                                          "object/get",
                                          "@t",
                                          "count"
                                        ]
                                      ]
                                    ],
                                    "type": "badge",
                                    "variant": "neutral"
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack",
                              "wrap": true
                            },
                            {
                              "color": "muted",
                              "content": "@entity.visibleThreadNote",
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "STEPPER_ADVANCED",
                    {
                      "activeFilter": "@entity.activeFilter",
                      "currentLabel": "@entity.narration",
                      "cursorIndex": "@entity.cursorIndex"
                    }
                  ]
                ],
                "event": "RESET_STEPPER",
                "eventId": "evt_01KZEGGJW8HSHWA1S2KAPRSY5G",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "LearnStepperCategory": [
          {
            "name": "category",
            "required": true,
            "type": "string"
          },
          {
            "name": "color",
            "required": true,
            "type": "string"
          },
