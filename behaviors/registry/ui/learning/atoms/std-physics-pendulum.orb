                  ],
                  [
                    "set",
                    "@entity.running",
                    false
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "START",
                                  "label": "Start",
                                  "type": "button",
                                  "variant": "primary"
                                },
                                {
                                  "action": "PAUSE",
                                  "label": "Pause",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "RESET",
                                  "label": "Reset",
                                  "type": "button",
                                  "variant": "ghost"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "bodies": "@entity.bodies",
                              "constraints": "@entity.constraints",
                              "height": "@config.height",
                              "showForces": false,
                              "showVelocity": "@config.showVelocity",
                              "type": "physics-canvas",
                              "velocityScale": "@config.velocityScale",
                              "width": "@config.width"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KZEKWF9CGB5CPACD0QYV4HTN",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.bodies",
                  [
                    "array/map",
                    "@entity.bodies",
                    [
                      "fn",
                      "b",
                      [
                        "if",
                        [
                          "=",
                          [
                            "object/get",
                            "@b",
                            "id"
                          ],
                          "pivot"
                        ],
                        "@b",
                        [
                          "let",
                          [
                            [
                              "nvy",
                              [
                                "*",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@b",
                                    "vy"
                                  ],
                                  "@config.gravity"
                                ],
                                "@config.damping"
                              ]
                            ],
                            [
                              "nvx",
                              [
                                "*",
                                [
                                  "object/get",
                                  "@b",
                                  "vx"
                                ],
                                "@config.damping"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "px",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@b",
                                    "x"
                                  ],
                                  "@nvx"
                                ]
                              ],
                              [
                                "py",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@b",
                                    "y"
                                  ],
                                  "@nvy"
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "dx",
                                  [
                                    "-",
                                    "@px",
                                    "@config.pivotX"
                                  ]
                                ],
                                [
                                  "dy",
                                  [
                                    "-",
                                    "@py",
                                    "@config.pivotY"
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "dist",
                                    [
                                      "math/sqrt",
                                      [
                                        "+",
                                        [
                                          "*",
                                          "@dx",
                                          "@dx"
                                        ],
                                        [
                                          "*",
                                          "@dy",
                                          "@dy"
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "s",
                                      [
                                        "/",
                                        "@config.length",
                                        "@dist"
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "cxp",
                                        [
                                          "+",
                                          "@config.pivotX",
                                          [
                                            "*",
                                            "@dx",
                                            "@s"
                                          ]
                                        ]
                                      ],
                                      [
                                        "cyp",
                                        [
                                          "+",
                                          "@config.pivotY",
                                          [
                                            "*",
                                            "@dy",
                                            "@s"
                                          ]
                                        ]
                                      ]
                                    ],
                                    [
                                      "object/merge",
                                      "@b",
                                      {
                                        "vx": [
                                          "-",
                                          "@cxp",
                                          [
                                            "object/get",
                                            "@b",
                                            "x"
                                          ]
                                        ],
                                        "vy": [
                                          "-",
                                          "@cyp",
                                          [
                                            "object/get",
                                            "@b",
                                            "y"
                                          ]
                                        ],
                                        "x": "@cxp",
                                        "y": "@cyp"
                                      }
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "render-ui",
                  "main",
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "children": [
                              {
                                "action": "START",
                                "label": "Start",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "PAUSE",
                                "label": "Pause",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "RESET",
                                "label": "Reset",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "backgroundColor": "@config.backgroundColor",
                            "bodies": "@entity.bodies",
                            "constraints": "@entity.constraints",
                            "height": "@config.height",
                            "showForces": false,
                            "showVelocity": "@config.showVelocity",
                            "type": "physics-canvas",
                            "velocityScale": "@config.velocityScale",
                            "width": "@config.width"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ],
                [
                  "emit",
                  "BODIES_UPDATED",
                  {
                    "bodies": "@entity.bodies"
                  }
                ]
              ],
              "guard": "@entity.running",
              "interval": 32.0,
              "name": "pendulumTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}