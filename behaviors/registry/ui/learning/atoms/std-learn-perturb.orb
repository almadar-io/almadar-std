                    "SHOCK_APPLIED",
                    {
                      "delta": "@payload.delta",
                      "deviation": [
                        "-",
                        "@entity.value",
                        "@entity.setpoint"
                      ],
                      "value": "@entity.value"
                    }
                  ]
                ],
                "event": "SHOCK",
                "eventId": "evt_01M075819FPPMTA2CKM8DTZA14",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.t",
                  [
                    "math/min",
                    "@config.duration",
                    [
                      "+",
                      "@entity.t",
                      0.1
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.value",
                  [
                    "+",
                    "@entity.value",
                    [
                      "*",
                      "@entity.rate",
                      [
                        "-",
                        "@entity.setpoint",
                        "@entity.value"
                      ],
                      0.1
                    ]
                  ]
                ],
                [
                  "set",
                  "@entity.traceSamples",
                  [
                    "array/append",
                    "@entity.traceSamples",
                    {
                      "x": "@entity.t",
                      "y": "@entity.value"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.curves",
                  [
                    {
                      "color": "@config.setpointColor",
                      "label": "@config.setpointLabel",
                      "samples": [
                        {
                          "x": 0.0,
                          "y": "@entity.setpoint"
                        },
                        {
                          "x": "@config.duration",
                          "y": "@entity.setpoint"
                        }
                      ]
                    },
                    {
                      "color": "@config.valueColor",
                      "label": "@config.valueLabel",
                      "samples": "@entity.traceSamples"
                    }
                  ]
                ],
                [
                  "set",
                  "@entity.running",
                  [
                    "if",
                    [
                      ">=",
                      "@entity.t",
                      "@config.duration"
                    ],
                    false,
                    true
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "<",
                    "@entity.t",
                    "@config.duration"
                  ]
                ]
              ],
              "interval": 100.0,
              "name": "perturbTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}