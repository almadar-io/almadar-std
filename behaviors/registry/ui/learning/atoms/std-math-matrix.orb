              "label": "Grid Step",
              "tier": "presentation",
              "type": "number"
            },
            "height": {
              "default": 400.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "matrix": {
              "default": [
                1.0,
                0.0,
                0.0,
                1.0
              ],
              "description": "Starting 2×2 matrix entries in row-major order: [m11, m12, m21, m22].",
              "items": {
                "type": "number"
              },
              "label": "Initial Matrix",
              "synonyms": "matrix entries, linear transformation, identity matrix",
              "tier": "domain",
              "type": "[number]"
            },
            "shape": {
              "default": "square",
              "description": "Which plane figure the transform morphs: a unit square, a triangle, or an arrow.",
              "label": "Shape",
              "synonyms": "shape, figure, unit square, test shape",
              "tier": "domain",
              "type": "string",
              "values": [
                "square",
                "triangle",
                "arrow"
              ]
            },
            "shapeColor": {
              "default": "#2563eb",
              "label": "Shape Color",
              "tier": "presentation",
              "type": "string"
            },
            "showAxes": {
              "default": true,
              "label": "Show Axes",
              "tier": "presentation",
              "type": "boolean"
            },
            "showBasisVectors": {
              "default": true,
              "description": "Draw the transformed basis vectors e₁′ and e₂′ (the matrix's columns) from the origin.",
              "label": "Show Basis Vectors",
              "synonyms": "basis vectors, e1, e2, column vectors",
              "tier": "presentation",
              "type": "boolean"
            },
            "showGrid": {
              "default": true,
              "label": "Show Grid",
              "tier": "presentation",
              "type": "boolean"
            },
            "title": {
              "default": "Matrix Transform",
              "description": "Title shown above the canvas.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            },
            "xMax": {
              "default": 4.0,
              "description": "Maximum x value on the canvas.",
              "label": "X Max",
              "tier": "presentation",
              "type": "number"
            },
            "xMin": {
              "default": -4.0,
              "description": "Minimum x value on the canvas.",
              "label": "X Min",
              "tier": "presentation",
              "type": "number"
            },
            "yMax": {
              "default": 4.0,
              "description": "Maximum y value on the canvas.",
              "label": "Y Max",
              "tier": "presentation",
              "type": "number"
            },
            "yMin": {
              "default": -4.0,
              "description": "Minimum y value on the canvas.",
              "label": "Y Min",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The matrix entries and determinant after each learner action or animation tick — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "MATRIX_UPDATED",
              "eventId": "evt_01KZNG4A11YR91DF46J01EY881",
              "payloadSchema": [
                {
                  "name": "m11",
                  "type": "number"
                },
                {
                  "name": "m12",
                  "type": "number"
                },
                {
                  "name": "m21",
                  "type": "number"
                },
                {
                  "name": "m22",
                  "type": "number"
                },
                {
                  "name": "determinant",
                  "type": "number"
                }
              ],
              "scope": "external",
              "synonyms": "matrix, linear transformation, basis vectors, determinant, rotation, shear",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "animT",
              "animating",
              "curves",
              "determinant",
              "m11",
              "m12",
              "m21",
              "m22",
              "showBasis",
              "t11",
              "t12",
              "t21",
              "t22",
              "title",
              "vectors"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "MathMatrixState": "ent_01KZNG4A1097EPAERVGVEZC1Z1"
          },
          "id": "trt_01KZNG4A10SX00EHBEC5Q9ECV4",
          "linkedEntity": "MathMatrixState",
          "linkedEntityId": "ent_01KZNG4A1097EPAERVGVEZC1Z1",
          "name": "MathMatrixSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNG4A10VA1END8RBVSPE9VB",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNG4A11C9GHZYWCKE1R8H13",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner dragged an entry slider to set one of the four 2×2 matrix entries.",
                "id": "evt_01KZNG4A11ZWM9CTC5GGG09VVJ",
                "key": "SET_ENTRY",
                "name": "Set Entry",
                "payloadSchema": [
                  {
                    "name": "entry",
                    "type": "string"
                  },
                  {
                    "name": "value",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner picked a named transform: identity, rotation, scale, shear, or reflection.",
                "id": "evt_01KZNG4A1192TDQVKXC8G89GAX",
                "key": "APPLY_PRESET",
                "name": "Apply Preset",
                "payloadSchema": [
                  {
                    "name": "preset",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KZNG4A11C519NEPSRYJ2ZN7S",
                "key": "TOGGLE_BASIS",
                "name": "Toggle Basis"
              },
              {
                "id": "evt_01KZNG4A11KVZ9AD4Z6BQMY8KD",
                "key": "ANIMATE_TRANSFORM",
                "name": "Animate Transform"
              },
              {
                "description": "The matrix entries and determinant after each learner action or animation tick — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNG4A11YR91DF46J01EY881",
                "key": "MATRIX_UPDATED",
                "name": "Matrix Updated",
                "payloadSchema": [
                  {
                    "name": "m11",
                    "type": "number"
                  },
                  {
                    "name": "m12",
                    "type": "number"
                  },
                  {
                    "name": "m21",
                    "type": "number"
                  },
                  {
                    "name": "m22",
                    "type": "number"
                  },
                  {
                    "name": "determinant",
                    "type": "number"
                  }
                ],
                "synonyms": "matrix, linear transformation, basis vectors, determinant, rotation, shear",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.t11",
                    [
                      "array/nth",
                      "@config.matrix",
                      0.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.t12",
                    [
                      "array/nth",
                      "@config.matrix",
                      1.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.t21",
                    [
                      "array/nth",
                      "@config.matrix",
                      2.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.t22",
                    [
                      "array/nth",
                      "@config.matrix",
                      3.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.m11",
                    "@entity.t11"
                  ],
                  [
                    "set",
                    "@entity.m12",
                    "@entity.t12"
                  ],
                  [
                    "set",
                    "@entity.m21",
                    "@entity.t21"
                  ],
                  [
                    "set",
                    "@entity.m22",
                    "@entity.t22"
                  ],
                  [
                    "set",
                    "@entity.showBasis",
                    "@config.showBasisVectors"
                  ],
                  [
                    "set",
                    "@entity.animating",
                    false
                  ],
                  [
                    "set",
                    "@entity.animT",
                    0.0
                  ],
                  [
                    "let",
                    [
                      [
                        "corners",
                        [
                          "if",
                          [
                            "==",
                            "@config.shape",
                            "triangle"
                          ],
                          [
                            {
                              "x": 0.0,
                              "y": 1.5
                            },
                            {
                              "x": -1.5,
                              "y": -1.0
                            },
                            {
                              "x": 1.5,
                              "y": -1.0
                            },
                            {
                              "x": 0.0,
                              "y": 1.5
                            }
                          ],
                          [
                            "if",
                            [
                              "==",
                              "@config.shape",
                              "arrow"
                            ],
                            [
                              {
                                "x": 0.0,
                                "y": 2.0
                              },
                              {
                                "x": -1.0,
                                "y": 0.0
                              },
                              {
                                "x": -0.3,
                                "y": 0.0
                              },
                              {
                                "x": -0.3,
                                "y": -2.0
                              },
                              {
                                "x": 0.3,
                                "y": -2.0
                              },
                              {
                                "x": 0.3,
                                "y": 0.0
                              },
                              {
                                "x": 1.0,
                                "y": 0.0
                              },
                              {
                                "x": 0.0,
                                "y": 2.0
                              }
                            ],
                            [
                              {
                                "x": -1.0,
                                "y": -1.0
                              },
                              {
                                "x": 1.0,
                                "y": -1.0
                              },
                              {
                                "x": 1.0,
                                "y": 1.0
                              },
                              {
                                "x": -1.0,
                                "y": 1.0
                              },
                              {
                                "x": -1.0,
                                "y": -1.0
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "ghostCurve",
                        {
                          "color": "@config.ghostColor",
                          "label": "original",
                          "samples": "@corners"
                        }
                      ],
                      [
                        "shapeCurve",
                        {
                          "color": "@config.shapeColor",
                          "label": "transformed",
                          "samples": [
                            "array/map",
                            "@corners",
                            [
                              "fn",
                              "p",
                              {
                                "x": [
                                  "+",
                                  [
                                    "*",
                                    "@entity.m11",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ]
                                  ],
                                  [
                                    "*",
                                    "@entity.m12",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  ]
                                ],
                                "y": [
                                  "+",
                                  [
                                    "*",
                                    "@entity.m21",
                                    [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ]
                                  ],
                                  [
                                    "*",
                                    "@entity.m22",
                                    [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        }
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.determinant",
                        [
                          "-",
                          [
                            "*",
                            "@entity.t11",
                            "@entity.t22"
                          ],
                          [
                            "*",
                            "@entity.t12",
                            "@entity.t21"
                          ]
                        ]
                      ],
                      [
                        "set",
                        "@entity.curves",
                        [
                          "@ghostCurve",
                          "@shapeCurve"
                        ]
                      ],
                      [
                        "set",
                        "@entity.vectors",
                        [
                          "if",
                          "@entity.showBasis",
                          [
                            {
                              "color": "@config.basisColor1",
                              "label": "e₁′",
                              "vx": "@entity.m11",
                              "vy": "@entity.m21",
                              "x": 0.0,
                              "y": 0.0
                            },
                            {
                              "color": "@config.basisColor2",
                              "label": "e₂′",
                              "vx": "@entity.m12",
                              "vy": "@entity.m22",
                              "x": 0.0,
                              "y": 0.0
                            }
                          ],
                          []
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                {
                                  "action": "APPLY_PRESET",
                                  "actionPayload": {
                                    "preset": "identity"
                                  },
                                  "label": "Identity",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "APPLY_PRESET",
                                  "actionPayload": {
                                    "preset": "rotation"
                                  },
                                  "label": "Rotate 30°",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "APPLY_PRESET",
                                  "actionPayload": {
                                    "preset": "scale"
                                  },
                                  "label": "Scale ×1.5",
                                  "type": "button",
                                  "variant": "secondary"
                                },
                                {
                                  "action": "APPLY_PRESET",
                                  "actionPayload": {
