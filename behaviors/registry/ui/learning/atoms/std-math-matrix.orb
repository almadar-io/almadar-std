                          "@config.shape",
                          "triangle"
                        ],
                        [
                          {
                            "x": 0.0,
                            "y": 1.5
                          },
                          {
                            "x": -1.5,
                            "y": -1.0
                          },
                          {
                            "x": 1.5,
                            "y": -1.0
                          },
                          {
                            "x": 0.0,
                            "y": 1.5
                          }
                        ],
                        [
                          "if",
                          [
                            "==",
                            "@config.shape",
                            "arrow"
                          ],
                          [
                            {
                              "x": 0.0,
                              "y": 2.0
                            },
                            {
                              "x": -1.0,
                              "y": 0.0
                            },
                            {
                              "x": -0.3,
                              "y": 0.0
                            },
                            {
                              "x": -0.3,
                              "y": -2.0
                            },
                            {
                              "x": 0.3,
                              "y": -2.0
                            },
                            {
                              "x": 0.3,
                              "y": 0.0
                            },
                            {
                              "x": 1.0,
                              "y": 0.0
                            },
                            {
                              "x": 0.0,
                              "y": 2.0
                            }
                          ],
                          [
                            {
                              "x": -1.0,
                              "y": -1.0
                            },
                            {
                              "x": 1.0,
                              "y": -1.0
                            },
                            {
                              "x": 1.0,
                              "y": 1.0
                            },
                            {
                              "x": -1.0,
                              "y": 1.0
                            },
                            {
                              "x": -1.0,
                              "y": -1.0
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "ghostCurve",
                      {
                        "color": "@config.ghostColor",
                        "label": "original",
                        "samples": "@corners"
                      }
                    ],
                    [
                      "shapeCurve",
                      {
                        "color": "@config.shapeColor",
                        "label": "transformed",
                        "samples": [
                          "array/map",
                          "@corners",
                          [
                            "fn",
                            "p",
                            {
                              "x": [
                                "+",
                                [
                                  "*",
                                  "@dm11",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ]
                                ],
                                [
                                  "*",
                                  "@dm12",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ]
                                ]
                              ],
                              "y": [
                                "+",
                                [
                                  "*",
                                  "@dm21",
                                  [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ]
                                ],
                                [
                                  "*",
                                  "@dm22",
                                  [
                                    "object/get",
                                    "@p",
                                    "y"
                                  ]
                                ]
                              ]
                            }
                          ]
                        ]
                      }
                    ]
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.animT",
                      "@nt"
                    ],
                    [
                      "set",
                      "@entity.animating",
                      [
                        "<",
                        "@nt",
                        1.0
                      ]
                    ],
                    [
                      "set",
                      "@entity.m11",
                      "@dm11"
                    ],
                    [
                      "set",
                      "@entity.m12",
                      "@dm12"
                    ],
                    [
                      "set",
                      "@entity.m21",
                      "@dm21"
                    ],
                    [
                      "set",
                      "@entity.m22",
                      "@dm22"
                    ],
                    [
                      "set",
                      "@entity.curves",
                      [
                        "@ghostCurve",
                        "@shapeCurve"
                      ]
                    ],
                    [
                      "set",
                      "@entity.vectors",
                      [
                        "if",
                        "@entity.showBasis",
                        [
                          {
                            "color": "@config.basisColor1",
                            "label": "e₁′",
                            "vx": "@dm11",
                            "vy": "@dm21",
                            "x": 0.0,
                            "y": 0.0
                          },
                          {
                            "color": "@config.basisColor2",
                            "label": "e₂′",
                            "vx": "@dm12",
                            "vy": "@dm22",
                            "x": 0.0,
                            "y": 0.0
                          }
                        ],
                        []
                      ]
                    ]
                  ]
                ],
                [
                  "render-ui",
                  "main",
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "content": "@entity.title",
                            "type": "typography",
                            "variant": "h4"
                          },
                          {
                            "children": [
                              {
                                "action": "APPLY_PRESET",
                                "actionPayload": {
                                  "preset": "identity"
                                },
                                "label": "Identity",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "APPLY_PRESET",
                                "actionPayload": {
                                  "preset": "rotation"
                                },
                                "label": "Rotate 30°",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "APPLY_PRESET",
                                "actionPayload": {
                                  "preset": "scale"
                                },
                                "label": "Scale ×1.5",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "APPLY_PRESET",
                                "actionPayload": {
                                  "preset": "shear"
                                },
                                "label": "Shear",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "APPLY_PRESET",
                                "actionPayload": {
                                  "preset": "reflect"
                                },
                                "label": "Reflect",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "ANIMATE_TRANSFORM",
                                "label": "Animate",
                                "type": "button",
                                "variant": "primary"
                              },
                              {
                                "action": "TOGGLE_BASIS",
                                "label": [
                                  "if",
                                  "@entity.showBasis",
                                  "Hide basis",
                                  "Show basis"
                                ],
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "animate": false,
                            "curves": "@entity.curves",
                            "gridStep": "@config.gridStep",
                            "height": "@config.height",
                            "interactive": false,
                            "points": [],
                            "shapes": [],
                            "showAxes": "@config.showAxes",
                            "showGrid": "@config.showGrid",
                            "type": "math-canvas",
                            "vectors": "@entity.vectors",
                            "width": "@config.width",
                            "xMax": "@config.xMax",
                            "xMin": "@config.xMin",
                            "yMax": "@config.yMax",
                            "yMin": "@config.yMin"
                          },
                          {
                            "children": [
                              {
                                "children": [
                                  {
                                    "content": [
                                      "str/concat",
                                      "m₁₁ = ",
                                      [
                                        "math/round",
                                        "@entity.m11",
                                        2.0
                                      ]
                                    ],
                                    "type": "typography",
                                    "variant": "caption"
                                  },
                                  {
                                    "actionPayload": {
                                      "entry": "m11"
                                    },
                                    "max": 2.5,
                                    "min": -2.5,
                                    "onChange": "SET_ENTRY",
                                    "showTooltip": true,
                                    "step": 0.1,
                                    "type": "range-slider",
                                    "value": "@entity.m11"
                                  }
                                ],
                                "direction": "vertical",
                                "gap": "xs",
                                "type": "stack"
                              },
                              {
                                "children": [
                                  {
                                    "content": [
                                      "str/concat",
                                      "m₁₂ = ",
                                      [
                                        "math/round",
                                        "@entity.m12",
                                        2.0
                                      ]
                                    ],
                                    "type": "typography",
                                    "variant": "caption"
                                  },
                                  {
                                    "actionPayload": {
                                      "entry": "m12"
                                    },
                                    "max": 2.5,
                                    "min": -2.5,
                                    "onChange": "SET_ENTRY",
                                    "showTooltip": true,
                                    "step": 0.1,
                                    "type": "range-slider",
                                    "value": "@entity.m12"
                                  }
                                ],
                                "direction": "vertical",
                                "gap": "xs",
                                "type": "stack"
                              },
                              {
                                "children": [
                                  {
                                    "content": [
                                      "str/concat",
                                      "m₂₁ = ",
                                      [
                                        "math/round",
                                        "@entity.m21",
                                        2.0
                                      ]
                                    ],
                                    "type": "typography",
                                    "variant": "caption"
                                  },
                                  {
                                    "actionPayload": {
                                      "entry": "m21"
                                    },
                                    "max": 2.5,
                                    "min": -2.5,
                                    "onChange": "SET_ENTRY",
                                    "showTooltip": true,
                                    "step": 0.1,
                                    "type": "range-slider",
                                    "value": "@entity.m21"
                                  }
                                ],
                                "direction": "vertical",
                                "gap": "xs",
                                "type": "stack"
                              },
                              {
                                "children": [
                                  {
                                    "content": [
                                      "str/concat",
                                      "m₂₂ = ",
                                      [
                                        "math/round",
                                        "@entity.m22",
                                        2.0
                                      ]
                                    ],
                                    "type": "typography",
                                    "variant": "caption"
                                  },
                                  {
                                    "actionPayload": {
                                      "entry": "m22"
                                    },
                                    "max": 2.5,
                                    "min": -2.5,
                                    "onChange": "SET_ENTRY",
                                    "showTooltip": true,
                                    "step": 0.1,
                                    "type": "range-slider",
                                    "value": "@entity.m22"
                                  }
                                ],
                                "direction": "vertical",
                                "gap": "xs",
                                "type": "stack"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "md",
                            "type": "stack"
                          },
                          {
                            "content": [
                              "str/concat",
                              "[ ",
                              [
                                "math/round",
                                "@entity.m11",
                                2.0
                              ],
                              "  ",
                              [
                                "math/round",
                                "@entity.m12",
                                2.0
                              ],
                              " ]"
                            ],
                            "type": "typography",
                            "variant": "body"
                          },
                          {
                            "content": [
                              "str/concat",
                              "[ ",
                              [
                                "math/round",
                                "@entity.m21",
                                2.0
                              ],
                              "  ",
                              [
                                "math/round",
                                "@entity.m22",
                                2.0
                              ],
                              " ]   det = ",
                              [
                                "math/round",
                                "@entity.determinant",
                                3.0
                              ],
                              " — area scale factor"
                            ],
                            "type": "typography",
                            "variant": "body"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ],
                [
                  "emit",
                  "MATRIX_UPDATED",
                  {
                    "determinant": "@entity.determinant",
                    "m11": "@entity.m11",
                    "m12": "@entity.m12",
                    "m21": "@entity.m21",
                    "m22": "@entity.m22"
                  }
                ]
              ],
              "guard": "@entity.animating",
              "interval": 48.0,
              "name": "matrixTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}