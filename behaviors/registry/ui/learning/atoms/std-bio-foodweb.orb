                                      [
                                        "object/get",
                                        "@s",
                                        "label"
                                      ],
                                      " (",
                                      [
                                        "str/concat",
                                        "",
                                        [
                                          "object/get",
                                          "@s",
                                          "population"
                                        ]
                                      ],
                                      ")"
                                    ],
                                    "radius": [
                                      "math/clamp",
                                      [
                                        "*",
                                        [
                                          "object/get",
                                          "@s",
                                          "population"
                                        ],
                                        0.4
                                      ],
                                      6.0,
                                      55.0
                                    ],
                                    "x": [
                                      "object/get",
                                      "@s",
                                      "x"
                                    ],
