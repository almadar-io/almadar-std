          "ticks": [
            {
              "effects": [
                [
                  "let",
                  [
                    [
                      "updated",
                      [
                        "array/map",
                        "@entity.species",
                        [
                          "fn",
                          "s",
                          [
                            "let",
                            [
                              [
                                "sid",
                                [
                                  "object/get",
                                  "@s",
                                  "id"
                                ]
                              ],
                              [
                                "pop",
                                [
                                  "object/get",
                                  "@s",
                                  "population"
                                ]
                              ],
                              [
                                "level",
                                [
                                  "object/get",
                                  "@s",
                                  "trophicLevel"
                                ]
                              ],
                              [
                                "cap",
                                [
                                  "object/get",
                                  "@s",
                                  "capacity"
                                ]
                              ],
                              [
                                "grow",
                                [
                                  "object/get",
                                  "@s",
                                  "growthRate"
                                ]
                              ],
                              [
                                "decl",
                                [
                                  "object/get",
                                  "@s",
                                  "declineRate"
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "consumed",
                                  [
                                    "array/sum",
                                    [
                                      "array/map",
                                      [
                                        "array/filter",
                                        "@config.edges",
                                        [
                                          "fn",
                                          "e",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@e",
                                              "prey"
                                            ],
                                            "@sid"
                                          ]
                                        ]
                                      ],
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "math/round",
                                          [
                                            "*",
                                            [
                                              "object/get",
                                              [
                                                "array/find",
                                                "@entity.species",
                                                [
                                                  "fn",
                                                  "p",
                                                  [
                                                    "==",
                                                    [
                                                      "object/get",
                                                      "@p",
                                                      "id"
                                                    ],
                                                    [
                                                      "object/get",
                                                      "@e",
                                                      "predator"
                                                    ]
                                                  ]
                                                ]
                                              ],
                                              "population"
                                            ],
                                            [
                                              "object/get",
                                              "@e",
                                              "rate"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "gained",
                                  [
                                    "array/sum",
                                    [
                                      "array/map",
                                      [
                                        "array/filter",
                                        "@config.edges",
                                        [
                                          "fn",
                                          "e",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@e",
                                              "predator"
                                            ],
                                            "@sid"
                                          ]
                                        ]
                                      ],
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "math/round",
                                          [
                                            "*",
                                            "@pop",
                                            [
                                              "object/get",
                                              "@e",
                                              "rate"
                                            ],
                                            [
                                              "object/get",
                                              "@e",
                                              "efficiency"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "newPop",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@level",
                                        "producer"
                                      ],
                                      [
                                        "math/clamp",
                                        [
                                          "-",
                                          [
                                            "+",
                                            "@pop",
                                            [
                                              "math/round",
                                              [
                                                "*",
                                                [
                                                  "-",
                                                  "@cap",
                                                  "@pop"
                                                ],
                                                "@grow"
                                              ]
                                            ]
                                          ],
                                          "@consumed"
                                        ],
                                        0.0,
                                        "@cap"
                                      ],
                                      [
                                        "math/clamp",
                                        [
                                          "-",
                                          [
                                            "+",
                                            "@pop",
                                            "@gained"
                                          ],
                                          [
                                            "+",
                                            [
                                              "math/round",
                                              [
                                                "*",
                                                "@pop",
                                                "@decl"
                                              ]
                                            ],
                                            "@consumed"
                                          ]
                                        ],
                                        0.0,
                                        "@cap"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "object/merge",
                                  "@s",
                                  {
                                    "delta": [
                                      "-",
                                      "@newPop",
                                      "@pop"
                                    ],
                                    "population": "@newPop"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "dropped",
                        [
                          "array/find",
                          "@updated",
                          [
                            "fn",
                            "s",
                            [
                              "<=",
                              [
                                "object/get",
                                "@s",
                                "delta"
                              ],
                              -2.0
                            ]
                          ]
                        ]
                      ],
                      [
                        "risen",
                        [
                          "array/find",
                          "@updated",
                          [
                            "fn",
                            "s",
                            [
                              ">=",
                              [
                                "object/get",
                                "@s",
                                "delta"
                              ],
                              2.0
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "story",
                          [
                            "if",
                            [
                              "and",
                              "@dropped",
                              "@risen"
                            ],
                            [
                              "str/concat",
                              [
                                "object/get",
                                "@dropped",
                                "label"
                              ],
                              " fell — ",
                              [
                                "object/get",
                                "@risen",
                                "label"
                              ],
                              " felt the effect."
                            ],
                            [
                              "if",
                              "@dropped",
                              [
                                "str/concat",
                                [
                                  "object/get",
                                  "@dropped",
                                  "label"
                                ],
                                " declined this generation."
                              ],
                              [
                                "if",
                                "@risen",
                                [
                                  "str/concat",
                                  [
                                    "object/get",
                                    "@risen",
                                    "label"
                                  ],
                                  " grew this generation."
                                ],
                                "Populations held steady this generation."
                              ]
                            ]
                          ]
                        ]
                      ],
