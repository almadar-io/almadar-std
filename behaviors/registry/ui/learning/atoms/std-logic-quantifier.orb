      "traits": [
        {
          "category": "interaction",
          "config": {
            "allowEdit": {
              "default": true,
              "description": "When true the learner can toggle object predicates to change the model; when false the toggle buttons render but edits are ignored.",
              "label": "Allow Model Edit",
              "synonyms": "editable model, change the model, flip truth value",
              "tier": "domain",
              "type": "boolean"
            },
            "backgroundColor": {
              "default": "#f8fafc",
              "description": "Canvas background color.",
              "label": "Background Color",
              "tier": "presentation",
              "type": "string"
            },
            "domain": {
              "default": [
                {
                  "id": "a",
                  "label": "a",
                  "predicates": [
                    "G",
                    "S"
                  ],
                  "x": 140.0,
                  "y": 150.0
                },
                {
                  "id": "b",
                  "label": "b",
                  "predicates": [
                    "G"
                  ],
                  "x": 300.0,
                  "y": 150.0
                },
                {
                  "id": "c",
                  "label": "c",
                  "predicates": [],
                  "x": 460.0,
                  "y": 150.0
                }
              ],
              "description": "The finite domain of objects (position, label, and the predicate keys each object has); toggling a predicate on an object changes the model.",
              "items": {
                "properties": {
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "predicates": {
                    "items": {
                      "type": "string"
                    },
                    "name": "predicates",
                    "required": false,
                    "type": "array"
                  },
                  "x": {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  "y": {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Domain",
              "synonyms": "domain of discourse, model, object, individual, universe of discourse",
              "tier": "domain",
              "type": "[LogicQuantObject]"
            },
            "height": {
              "default": 260.0,
              "description": "Canvas height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "interactive": {
              "default": false,
              "description": "Enable pointer interaction on the canvas.",
              "label": "Interactive",
              "tier": "presentation",
              "type": "boolean"
            },
            "matchMode": {
              "default": "",
              "description": "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT.",
              "label": "Match Mode",
              "tier": "presentation",
              "type": "string"
            },
            "predicates": {
              "default": [
                {
                  "color": "#15803d",
                  "key": "G",
                  "label": "G"
                },
                {
                  "color": "#7c3aed",
                  "key": "S",
                  "label": "S"
                }
              ],
              "description": "The property vocabulary (key, label, ring color); each predicate an object has is drawn as a colored ring around it.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": true,
                    "type": "string"
                  },
                  "key": {
                    "name": "key",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Predicates",
              "synonyms": "predicate, property, unary relation, monadic predicate",
              "tier": "domain",
              "type": "[LogicQuantPredicate]"
            },
            "showTruthValues": {
              "default": true,
              "description": "After a statement is evaluated, show its computed T/F beside it.",
              "label": "Show Truth Values",
              "tier": "domain",
              "type": "boolean"
            },
            "statements": {
              "default": [
                {
                  "id": "s1",
                  "kind": "FORALL",
                  "label": "∀x G(x)",
                  "px": "G"
                },
                {
                  "id": "s2",
                  "kind": "EXISTS",
                  "label": "∃x S(x)",
                  "px": "S"
                },
                {
                  "id": "s3",
                  "kind": "FORALL_EXISTS",
                  "label": "∀x(G(x) → ∃y S(y))",
                  "px": "G",
                  "py": "S"
                }
              ],
              "description": "Quantified statements evaluated against the model: FORALL px (every object has px), EXISTS px (some object has px), FORALL_EXISTS px py (if any object has px then some object has py).",
              "items": {
                "properties": {
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "kind": {
                    "name": "kind",
                    "required": true,
                    "type": "string",
                    "values": [
                      "FORALL",
                      "EXISTS",
                      "FORALL_EXISTS"
                    ]
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "px": {
                    "name": "px",
                    "required": true,
                    "type": "string"
                  },
                  "py": {
                    "name": "py",
                    "required": false,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Statements",
              "synonyms": "universal quantifier, existential quantifier, for all, there exists, quantified statement, predicate logic",
              "tier": "domain",
              "type": "[LogicQuantStatement]"
            },
            "title": {
              "default": "Quantifier Model",
              "description": "Title shown above the instrument.",
              "label": "Title",
              "tier": "presentation",
              "type": "string"
            },
            "width": {
              "default": 600.0,
              "description": "Canvas width in pixels.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "The model/pick state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
              "event": "QUANTIFIER_UPDATED",
              "eventId": "evt_01KZNFCQ12DERZWRPHD7C500M1",
              "payloadSchema": [
                {
                  "name": "picks",
                  "type": "[string]"
                },
                {
                  "name": "feedback",
                  "type": "string"
                }
              ],
              "scope": "external",
              "synonyms": "quantifier evaluation, model check, for all, there exists, predicate logic, truth in a model",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "active",
              "feedback",
              "objects",
              "picks",
              "shapes",
              "title",
              "truthMap"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "LogicQuantifierState": "ent_01KZNFCQ11GTHC2DV7EKM22GR4"
          },
          "id": "trt_01KZNFCQ11X5KQF64VW2ZDBYCY",
          "linkedEntity": "LogicQuantifierState",
          "linkedEntityId": "ent_01KZNFCQ11GTHC2DV7EKM22GR4",
          "name": "LogicQuantifierSim",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZNFCQ115RKMP76PW36TPCNK",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null.",
                "id": "evt_01KZNFCQ12E0AVGP7AJ57S5KCQ",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner flipped one property of one domain object, changing the model and invalidating prior truth values.",
                "id": "evt_01KZNFCQ12KVPNW3TGQSTN80AS",
                "key": "TOGGLE_OBJECT",
                "name": "Toggle Object",
                "payloadSchema": [
                  {
                    "name": "object",
                    "type": "string"
                  },
                  {
                    "name": "predicate",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner marked or unmarked a quantified statement as one they believe is true in the model.",
                "id": "evt_01KZNFCQ12WD9FJVS08PVH3ZZT",
                "key": "PICK_TRUE_STATEMENTS",
                "name": "Pick True Statements",
                "payloadSchema": [
                  {
                    "name": "statement",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Learner evaluated one quantified statement against the visible model and got a verdict against their pick.",
                "id": "evt_01KZNFCQ12VTHZ6Q1X240JMBD3",
                "key": "EVALUATE_STATEMENT",
                "name": "Evaluate Statement",
                "payloadSchema": [
                  {
                    "name": "statement",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The model/pick state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone.",
                "id": "evt_01KZNFCQ12DERZWRPHD7C500M1",
                "key": "QUANTIFIER_UPDATED",
                "name": "Quantifier Updated",
                "payloadSchema": [
                  {
                    "name": "picks",
                    "type": "[string]"
                  },
                  {
                    "name": "feedback",
                    "type": "string"
                  }
                ],
                "synonyms": "quantifier evaluation, model check, for all, there exists, predicate logic, truth in a model",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.objects",
                    "@config.domain"
                  ],
                  [
                    "set",
                    "@entity.picks",
                    []
                  ],
                  [
                    "set",
                    "@entity.truthMap",
                    []
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    ""
                  ],
                  [
                    "let",
                    [
                      [
                        "objShapes",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@entity.objects",
                            [
                              "fn",
                              "o",
                              [
                                "let",
                                [
                                  [
                                    "preds",
                                    [
                                      "object/get",
                                      "@o",
                                      "predicates"
                                    ]
                                  ],
                                  [
                                    "baseShapes",
                                    [
                                      {
                                        "color": "#64748b",
                                        "fill": "transparent",
                                        "id": [
                                          "object/get",
                                          "@o",
                                          "id"
                                        ],
                                        "lineWidth": 2.0,
                                        "opacity": 1.0,
                                        "radius": 28.0,
                                        "type": "circle",
                                        "x": [
                                          "object/get",
                                          "@o",
                                          "x"
                                        ],
                                        "y": [
                                          "object/get",
                                          "@o",
                                          "y"
                                        ]
                                      },
                                      {
                                        "align": "center",
                                        "color": "#334155",
                                        "fontSize": 12.0,
                                        "id": [
                                          "str/concat",
                                          "olabel-",
                                          [
                                            "object/get",
                                            "@o",
                                            "id"
                                          ]
                                        ],
                                        "text": [
                                          "object/get",
                                          "@o",
                                          "label"
                                        ],
                                        "type": "text",
                                        "x": [
                                          "object/get",
                                          "@o",
                                          "x"
                                        ],
                                        "y": [
                                          "+",
                                          [
                                            "object/get",
                                            "@o",
                                            "y"
                                          ],
                                          52.0
                                        ]
                                      }
                                    ]
                                  ],
                                  [
                                    "ringShapes",
                                    [
                                      "array/map",
                                      [
                                        "array/range",
                                        [
                                          "array/len",
                                          "@preds"
                                        ]
                                      ],
                                      [
                                        "fn",
                                        "i",
                                        [
                                          "let",
                                          [
                                            [
                                              "pkey",
                                              [
                                                "array/nth",
                                                "@preds",
                                                "@i"
                                              ]
                                            ],
                                            [
                                              "pdef",
                                              [
                                                "array/find",
                                                "@config.predicates",
                                                [
                                                  "fn",
                                                  "p",
                                                  [
                                                    "==",
                                                    [
                                                      "object/get",
                                                      "@p",
                                                      "key"
                                                    ],
                                                    "@pkey"
                                                  ]
                                                ]
                                              ]
                                            ]
                                          ],
                                          {
                                            "color": [
                                              "object/get",
                                              "@pdef",
                                              "color"
                                            ],
                                            "fill": "transparent",
                                            "id": [
                                              "str/concat",
                                              "ring-",
                                              [
                                                "object/get",
                                                "@o",
                                                "id"
                                              ],
                                              "-",
                                              "@pkey"
                                            ],
                                            "lineWidth": 3.0,
                                            "opacity": 0.9,
                                            "radius": [
                                              "+",
                                              36.0,
                                              [
                                                "*",
                                                "@i",
                                                9.0
                                              ]
                                            ],
                                            "type": "circle",
                                            "x": [
                                              "object/get",
                                              "@o",
                                              "x"
                                            ],
                                            "y": [
                                              "object/get",
                                              "@o",
                                              "y"
                                            ]
                                          }
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "array/concat",
                                  "@baseShapes",
                                  "@ringShapes"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.shapes",
                        "@objShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model.",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "animate": false,
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.shapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.predicates",
                                [
                                  "fn",
                                  "p",
                                  {
                                    "children": [
                                      "array/map",
                                      "@entity.objects",
                                      [
                                        "fn",
                                        "o",
                                        {
                                          "action": "TOGGLE_OBJECT",
                                          "actionPayload": {
                                            "object": [
                                              "object/get",
                                              "@o",
                                              "id"
                                            ],
                                            "predicate": [
                                              "object/get",
                                              "@p",
                                              "key"
                                            ]
                                          },
                                          "label": [
                                            "str/concat",
                                            [
                                              "object/get",
                                              "@p",
                                              "label"
                                            ],
                                            "·",
                                            [
                                              "object/get",
                                              "@o",
                                              "label"
                                            ]
                                          ],
                                          "size": "sm",
                                          "type": "button",
                                          "variant": [
                                            "if",
                                            [
                                              "array/includes",
                                              [
                                                "object/get",
                                                "@o",
                                                "predicates"
                                              ],
                                              [
                                                "object/get",
                                                "@p",
                                                "key"
                                              ]
                                            ],
                                            "primary",
                                            "ghost"
                                          ]
                                        }
                                      ]
                                    ],
                                    "direction": "horizontal",
                                    "gap": "xs",
                                    "type": "stack"
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.statements",
                                [
                                  "fn",
                                  "s",
                                  {
                                    "children": [
                                      {
                                        "content": [
                                          "object/get",
                                          "@s",
                                          "label"
                                        ],
                                        "type": "typography",
                                        "variant": "body"
                                      },
                                      {
                                        "action": "PICK_TRUE_STATEMENTS",
                                        "actionPayload": {
                                          "statement": [
                                            "object/get",
                                            "@s",
                                            "id"
                                          ]
                                        },
                                        "label": [
                                          "if",
                                          [
                                            "array/includes",
                                            "@entity.picks",
                                            [
                                              "object/get",
                                              "@s",
                                              "id"
                                            ]
                                          ],
                                          "True ✓",
                                          "Mark True"
                                        ],
                                        "size": "sm",
