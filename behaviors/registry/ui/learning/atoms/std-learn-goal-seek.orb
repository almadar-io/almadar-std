              },
              {
                "description": "The learner reset the instrument back to the default parameters.",
                "id": "evt_01M07580W5FS31BTS7N6M1RTVX",
                "key": "GOAL_RESET",
                "name": "Goal Reset",
                "payloadSchema": [
                  {
                    "name": "attempts",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Fired once when a Check lands within tolerance (the goal is matched) — the standard learning completion broadcast a celebration/progression sibling (fx cues, badges) rides.",
                "id": "evt_01M0GTSZBCSEV6BAPBGF6979KG",
                "key": "LEARN_ROUND_COMPLETE",
                "name": "Learn Round Complete",
                "payloadSchema": [
                  {
                    "name": "score",
                    "type": "number"
                  },
                  {
                    "name": "total",
                    "type": "number"
                  }
                ],
                "synonyms": "round complete, finished, done, completion, solved",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "kind",
                        "@config.curveKind"
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "tA",
                        "@config.targetA"
                      ],
                      [
                        "tB",
                        "@config.targetB"
                      ],
                      [
                        "A",
                        "@config.paramADefault"
                      ],
                      [
                        "B",
                        "@config.paramBDefault"
                      ],
                      [
                        "targetSamples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@tA",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@tB"
