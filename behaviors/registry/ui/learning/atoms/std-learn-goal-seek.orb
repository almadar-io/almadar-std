                          "@config.tolerance",
                          3.0
                        ],
                        "."
                      ],
                      [
                        "str/concat",
                        "Not yet — distance ",
                        [
                          "math/round",
                          "@entity.distance",
                          3.0
                        ],
                        " is above tolerance ",
                        [
                          "math/round",
                          "@config.tolerance",
                          3.0
                        ],
                        ". Keep tuning."
                      ]
                    ]
                  ],
                  [
