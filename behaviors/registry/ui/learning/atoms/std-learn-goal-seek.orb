                    false
                  ]
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.attempts",
                    [
                      "+",
                      "@entity.attempts",
                      1.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.solved",
                    [
                      "if",
                      [
                        "<=",
                        "@entity.distance",
                        "@config.tolerance"
                      ],
                      true,
                      false
                    ]
                  ],
                  [
                    "set",
                    "@entity.feedback",
                    [
