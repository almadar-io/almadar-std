                        "@entity.solved",
                        false
                      ],
                      [
                        "set",
                        "@entity.feedback",
                        ""
                      ],
                      [
                        "set",
                        "@entity.yMin",
                        [
                          "-",
                          "@yMinRaw",
                          "@yPad"
                        ]
                      ],
                      [
                        "set",
                        "@entity.yMax",
                        [
                          "+",
                          "@yMaxRaw",
                          "@yPad"
                        ]
                      ],
                      [
