                "effects": [
                  [
                    "let",
                    [
                      [
                        "A",
                        "@config.paramADefault"
                      ],
                      [
                        "B",
                        "@config.paramBDefault"
                      ],
                      [
                        "kind",
                        "@entity.curveKind"
                      ],
                      [
                        "span",
                        [
                          "-",
                          "@config.xMax",
                          "@config.xMin"
                        ]
                      ],
                      [
                        "samples",
                        [
                          "array/map",
                          [
                            "array/range",
                            0.0,
                            81.0
                          ],
                          [
                            "fn",
                            [
                              "i"
                            ],
                            [
                              "let",
                              [
                                [
                                  "x",
                                  [
                                    "+",
                                    "@config.xMin",
                                    [
                                      "*",
                                      "@i",
                                      [
                                        "/",
                                        "@span",
                                        80.0
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "yVal",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@kind",
                                      "power"
                                    ],
                                    [
                                      "*",
                                      "@A",
                                      [
                                        "math/pow",
                                        "@x",
                                        "@B"
                                      ]
                                    ],
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@kind",
                                        "linear"
                                      ],
                                      [
                                        "+",
                                        "@A",
                                        [
                                          "*",
                                          "@B",
                                          "@x"
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@A",
                                        [
                                          "math/sin",
                                          [
                                            "*",
                                            "@B",
                                            "@x"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              {
                                "x": "@x",
                                "y": "@yVal"
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "dist",
                        [
                          "math/sqrt",
                          [
                            "/",
                            [
                              "array/sum",
                              [
                                "array/map",
                                [
                                  "array/range",
                                  0.0,
                                  81.0
                                ],
                                [
                                  "fn",
                                  [
                                    "i"
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "dY",
                                        [
                                          "-",
                                          [
                                            "object/get",
                                            [
                                              "array/nth",
                                              "@samples",
                                              "@i"
                                            ],
                                            "y"
                                          ],
                                          [
                                            "object/get",
                                            [
                                              "array/nth",
                                              "@entity.targetSamples",
                                              "@i"
                                            ],
                                            "y"
                                          ]
                                        ]
                                      ]
                                    ],
                                    [
                                      "*",
                                      "@dY",
                                      "@dY"
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            81.0
                          ]
                        ]
                      ],
                      [
                        "allSamples",
                        [
                          "array/concat",
                          "@samples",
                          "@entity.targetSamples"
                        ]
                      ],
                      [
                        "yMinRaw",
                        [
                          "array/reduce",
                          "@allSamples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@allSamples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/min",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yMaxRaw",
                        [
                          "array/reduce",
                          "@allSamples",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@allSamples",
                              0.0
                            ],
                            "y"
                          ],
                          [
                            "fn",
                            [
                              "acc",
                              "s"
                            ],
                            [
                              "math/max",
                              "@acc",
                              [
                                "object/get",
                                "@s",
                                "y"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "yPad",
                        [
                          "*",
                          0.1,
                          [
                            "math/max",
                            0.001,
                            [
                              "-",
                              "@yMaxRaw",
                              "@yMinRaw"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.paramA",
                        "@A"
                      ],
                      [
                        "set",
                        "@entity.paramB",
                        "@B"
                      ],
                      [
                        "set",
                        "@entity.distance",
                        "@dist"
                      ],
