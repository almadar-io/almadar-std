                        ],
                        "name"
                      ],
                      "total": [
                        "array/len",
                        "@entity.stations"
                      ],
                      "tourComplete": false,
                      "visited": [
                        "array/len",
                        "@entity.visitedIds"
                      ]
                    }
                  ]
                ],
                "event": "SYNC_STATIONS",
                "eventId": "evt_01M09E8V0NEH4QP51HH0HZ80ST",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
