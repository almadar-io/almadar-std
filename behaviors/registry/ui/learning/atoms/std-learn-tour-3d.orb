                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "backgroundColor": "@config.backgroundColor",
                              "camera": {
                                "azimuth": "@config.azimuth",
                                "fov": "@config.fov",
                                "mode": "perspective",
                                "target": {
                                  "x": [
                                    "object/get",
                                    [
                                      "array/nth",
                                      "@entity.stations",
