                                      "@entity.stations",
                                      "@entity.selectedIndex"
                                    ],
                                    "z"
                                  ]
                                },
                                "zoom": "@config.zoom"
                              },
                              "edges": "@entity.edges",
                              "height": "@config.height",
                              "interactive": true,
                              "lighting": "@config.lighting",
                              "mode": "3d",
                              "nodes": [
                                "array/map",
                                [
                                  "array/concat",
                                  "@entity.backdrop",
                                  "@entity.stations"
                                ],
                                [
                                  "fn",
                                  "n",
                                  {
                                    "color": [
                                      "object/get",
                                      "@n",
                                      "color"
                                    ],
                                    "id": [
                                      "object/get",
                                      "@n",
                                      "id"
                                    ],
                                    "label": [
                                      "object/get",
                                      "@n",
                                      "name"
                                    ],
                                    "opacity": [
                                      "object/get",
                                      "@n",
                                      "opacity"
                                    ],
                                    "radius": [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@n",
                                          "id"
                                        ],
                                        "@entity.selectedId"
                                      ],
                                      [
                                        "*",
                                        [
                                          "object/get",
                                          "@n",
                                          "radius"
                                        ],
                                        1.4
                                      ],
                                      [
                                        "object/get",
                                        "@n",
                                        "radius"
                                      ]
                                    ],
                                    "shape": [
                                      "object/get",
                                      "@n",
                                      "shape"
                                    ],
                                    "x": [
                                      "object/get",
                                      "@n",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@n",
                                      "y"
                                    ],
                                    "z": [
                                      "object/get",
                                      "@n",
                                      "z"
                                    ]
                                  }
                                ]
                              ],
                              "onShapeClick": "SELECT_STATION",
                              "post": "@config.post",
                              "type": "biology-canvas",
                              "width": "@config.width"
                            },
                            {
                              "content": "@entity.narration",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Explored ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "array/len",
                                    "@entity.visitedIds"
                                  ]
                                ],
                                " of ",
                                [
                                  "str/concat",
                                  "",
                                  [
                                    "array/len",
                                    "@entity.stations"
                                  ]
                                ],
                                [
                                  "if",
                                  "@entity.tourComplete",
                                  " — tour complete!",
                                  ""
                                ]
                              ],
                              "type": "typography",
                              "variant": "caption"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
