                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.stations",
                          0.0
                        ],
                        "name"
                      ],
                      " — ",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.stations",
                          0.0
                        ],
                        "caption"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
