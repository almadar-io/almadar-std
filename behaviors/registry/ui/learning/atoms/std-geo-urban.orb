                                      "object/get",
                                      "@zt",
                                      "tagIndex"
                                    ]
                                  ]
                                ],
                                [
                                  "tag",
                                  [
                                    "array/nth",
                                    "@config.tags",
                                    "@tagIndex"
                                  ]
                                ]
                              ],
