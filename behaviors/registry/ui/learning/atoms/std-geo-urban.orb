                "eventId": "evt_01M0492BASMHQXV65KRSTAVW8D",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "modelSel",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.models",
                            [
                              "fn",
                              "m",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@m",
                                  "code"
                                ],
                                "@entity.selectedModel"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "hasModel",
                        [
                          "!=",
                          "@modelSel",
                          null
                        ]
                      ],
                      [
                        "expectations",
                        [
                          "if",
                          "@hasModel",
                          [
                            "object/get",
                            "@modelSel",
                            "expectations"
                          ],
                          []
                        ]
                      ],
                      [
                        "hits",
                        [
                          "array/filter",
                          "@entity.zoneTags",
                          [
                            "fn",
                            "t",
                            [
                              "let",
                              [
                                [
                                  "exp",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@expectations",
                                      [
                                        "fn",
                                        "e",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@e",
                                            "zoneId"
                                          ],
                                          [
                                            "object/get",
                                            "@t",
                                            "zoneId"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "expectedTag",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@exp",
                                      null
                                    ],
                                    "",
                                    [
                                      "object/get",
                                      "@exp",
                                      "tag"
                                    ]
                                  ]
                                ],
                                [
                                  "actualTag",
                                  [
                                    "object/get",
                                    [
                                      "array/nth",
                                      "@config.tags",
                                      [
                                        "object/get",
                                        "@t",
                                        "tagIndex"
                                      ]
                                    ],
                                    "value"
                                  ]
                                ]
                              ],
                              [
                                "==",
                                "@actualTag",
                                "@expectedTag"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "hitCount",
                        [
                          "array/len",
                          "@hits"
                        ]
                      ],
                      [
                        "zoneCount",
                        [
                          "array/len",
                          "@config.zones"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.score",
                        [
                          "if",
                          "@hasModel",
                          "@hitCount",
                          0.0
                        ]
                      ],
                      [
                        "set",
                        "@entity.attempts",
                        [
                          "if",
                          "@hasModel",
                          [
                            "+",
                            "@entity.attempts",
                            1.0
                          ],
                          "@entity.attempts"
                        ]
                      ],
                      [
                        "set",
                        "@entity.checkReadout",
                        [
                          "if",
                          "@hasModel",
                          [
                            "str/concat",
                            [
                              "object/get",
                              "@modelSel",
                              "label"
                            ],
                            " fit: ",
                            "@hitCount",
                            " / ",
                            "@zoneCount",
                            " zones tagged as the model predicts"
                          ],
                          "Select a model overlay first, then tag the zones."
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "modelSel",
                        [
                          "array/first",
                          [
                            "array/filter",
                            "@config.models",
                            [
                              "fn",
                              "m",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@m",
                                  "code"
                                ],
                                "@entity.selectedModel"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "overlayShapes",
                        [
                          "if",
                          [
                            "==",
                            "@modelSel",
                            null
                          ],
                          [],
                          [
                            "array/map",
                            [
                              "object/get",
                              "@modelSel",
                              "overlays"
                            ],
                            [
                              "fn",
                              "o",
                              [
                                "object/merge",
                                "@o",
                                {
                                  "color": [
                                    "object/get",
                                    "@modelSel",
                                    "color"
                                  ],
                                  "fill": [
                                    "object/get",
                                    "@modelSel",
                                    "color"
                                  ],
                                  "opacity": 0.15
                                }
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "zoneShapes",
                        [
                          "array/map",
                          "@config.zones",
                          [
                            "fn",
                            "z",
                            [
                              "let",
                              [
                                [
                                  "zt",
                                  [
                                    "array/first",
                                    [
                                      "array/filter",
                                      "@entity.zoneTags",
                                      [
                                        "fn",
                                        "t",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@t",
                                            "zoneId"
                                          ],
                                          [
                                            "object/get",
                                            "@z",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "tagIndex",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@zt",
                                      null
                                    ],
                                    0.0,
                                    [
                                      "object/get",
                                      "@zt",
                                      "tagIndex"
                                    ]
                                  ]
                                ],
                                [
                                  "tag",
                                  [
                                    "array/nth",
                                    "@config.tags",
                                    "@tagIndex"
                                  ]
                                ]
                              ],
                              {
                                "color": [
                                  "object/get",
                                  "@tag",
                                  "color"
                                ],
                                "fill": [
                                  "object/get",
                                  "@tag",
                                  "color"
                                ],
                                "lineWidth": 2.0,
                                "opacity": 0.55,
                                "radius": [
                                  "object/get",
                                  "@z",
                                  "radius"
                                ],
                                "type": "circle",
                                "x": [
                                  "object/get",
                                  "@z",
                                  "x"
                                ],
                                "y": [
                                  "object/get",
                                  "@z",
                                  "y"
                                ]
                              }
                            ]
                          ]
                        ]
                      ],
                      [
                        "zoneLabels",
                        [
                          "array/map",
                          "@config.zones",
                          [
                            "fn",
                            "z",
                            {
                              "align": "center",
                              "color": "@config.textColor",
                              "fontSize": 11.0,
                              "text": [
                                "object/get",
                                "@z",
                                "label"
                              ],
                              "type": "text",
                              "x": [
                                "object/get",
                                "@z",
                                "x"
                              ],
                              "y": [
                                "object/get",
                                "@z",
                                "y"
                              ]
                            }
                          ]
                        ]
                      ],
                      [
                        "mapShapes",
                        [
                          "array/concat",
                          [
                            "array/concat",
                            [
                              "array/concat",
                              "@config.cityLayout",
                              "@overlayShapes"
                            ],
                            "@zoneShapes"
                          ],
                          "@zoneLabels"
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.mapShapes",
                        "@mapShapes"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.models",
                                [
                                  "fn",
                                  "m",
                                  {
                                    "action": "TOGGLE_MODEL",
                                    "actionPayload": {
                                      "model": [
                                        "object/get",
                                        "@m",
                                        "code"
                                      ]
                                    },
                                    "label": [
                                      "object/get",
                                      "@m",
                                      "label"
                                    ],
                                    "type": "button",
                                    "variant": [
                                      "if",
                                      [
                                        "==",
                                        "@entity.selectedModel",
                                        [
                                          "object/get",
                                          "@m",
                                          "code"
                                        ]
                                      ],
                                      "primary",
                                      "secondary"
                                    ]
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": [],
                              "gridStep": 1.0,
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": [],
                              "shapes": "@entity.mapShapes",
                              "showAxes": false,
                              "showGrid": false,
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.width",
                              "xMin": 0.0,
                              "yMax": "@config.height",
                              "yMin": 0.0
                            },
                            {
                              "content": "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model.",
                              "type": "typography",
                              "variant": "caption"
                            },
                            {
                              "children": [
                                "array/map",
                                "@config.zones",
                                [
                                  "fn",
                                  "z",
                                  {
                                    "action": "TAG_ZONE",
                                    "actionPayload": {
                                      "zone": [
                                        "object/get",
                                        "@z",
                                        "id"
                                      ]
                                    },
                                    "label": [
                                      "str/concat",
                                      [
                                        "object/get",
                                        "@z",
                                        "label"
                                      ],
                                      ": ",
                                      [
                                        "object/get",
                                        [
                                          "array/nth",
                                          "@config.tags",
                                          [
                                            "object/get",
                                            [
                                              "array/first",
                                              [
                                                "array/filter",
                                                "@entity.zoneTags",
                                                [
                                                  "fn",
                                                  "t",
                                                  [
                                                    "==",
                                                    [
                                                      "object/get",
                                                      "@t",
                                                      "zoneId"
                                                    ],
                                                    [
                                                      "object/get",
                                                      "@z",
                                                      "id"
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            "tagIndex"
                                          ]
                                        ],
                                        "label"
                                      ]
                                    ],
                                    "size": "sm",
                                    "type": "button",
                                    "variant": "secondary"
                                  }
                                ]
                              ],
                              "direction": "horizontal",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "action": "CHECK",
                                  "label": "Check Model Fit",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "content": "@entity.checkReadout",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "content": [
                                "str/concat",
                                "Score: ",
                                "@entity.score",
                                " / ",
                                [
                                  "array/len",
                                  "@config.zones"
                                ],
                                " — attempts: ",
                                "@entity.attempts"
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "URBAN_UPDATED",
                    {
                      "attempts": "@entity.attempts",
                      "score": "@entity.score",
                      "selectedModel": "@entity.selectedModel"
                    }
                  ]
                ],
                "event": "CHECK",
                "eventId": "evt_01M0492BAS8EY6WBG79X70TSCB",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}