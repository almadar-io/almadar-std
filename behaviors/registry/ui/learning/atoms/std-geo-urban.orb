                                    "@modelSel",
                                    "color"
                                  ],
                                  "fill": [
                                    "object/get",
                                    "@modelSel",
                                    "color"
                                  ],
                                  "opacity": 0.15
                                }
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "zoneShapes",
                        [
                          "array/map",
                          "@config.zones",
                          [
