                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.selectedModel",
                    ""
                  ],
                  [
                    "set",
                    "@entity.zoneTags",
                    [
                      "array/map",
                      "@config.zones",
                      [
                        "fn",
                        "z",
                        {
                          "tagIndex": 0.0,
                          "zoneId": [
                            "object/get",
                            "@z",
                            "id"
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.score",
