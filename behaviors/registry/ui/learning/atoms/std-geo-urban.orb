                              "fn",
                              "m",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@m",
                                  "code"
                                ],
                                "@entity.selectedModel"
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "overlayShapes",
