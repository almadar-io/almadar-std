          "ticks": [
            {
              "effects": [
                [
                  "let",
                  [
                    [
                      "dtEff",
                      [
                        "*",
                        "@config.dt",
                        "@entity.speedMultiplier"
                      ]
                    ]
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.steps",
                      [
                        "+",
                        "@entity.steps",
                        1.0
                      ]
                    ],
                    [
                      "set",
                      "@entity.simTime",
                      [
                        "+",
                        "@entity.simTime",
                        "@dtEff"
                      ]
                    ],
                    [
                      "emit",
                      "SIM_3D_TICK",
                      {
                        "dt": "@dtEff",
                        "simTime": "@entity.simTime"
                      }
                    ]
                  ]
                ]
              ],
              "guard": [
                "==",
                "@entity.running",
                true
              ],
              "interval": 32.0,
              "name": "simTick"
            }
          ]
