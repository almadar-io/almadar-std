                                      "@config.shockSize"
                                    ]
                                  },
                                  "label": "@config.shockDownLabel",
                                  "size": "sm",
                                  "type": "button",
                                  "variant": "secondary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "@config.coefALabel",
                                    ": ",
                                    [
                                      "math/round",
                                      "@entity.coefA",
                                      3.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "action": "SET_A",
                                  "max": "@config.coefAMax",
                                  "min": "@config.coefAMin",
                                  "showTooltip": true,
                                  "step": "@config.coefAStep",
                                  "type": "range-slider",
                                  "value": "@entity.coefA"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "children": [
                                {
                                  "content": [
                                    "str/concat",
                                    "@config.coefBLabel",
                                    ": ",
                                    [
                                      "math/round",
                                      "@entity.coefB",
                                      3.0
                                    ]
                                  ],
                                  "type": "typography",
                                  "variant": "caption"
                                },
                                {
                                  "action": "SET_B",
                                  "max": "@config.coefBMax",
                                  "min": "@config.coefBMin",
                                  "showTooltip": true,
                                  "step": "@config.coefBStep",
                                  "type": "range-slider",
                                  "value": "@entity.coefB"
                                }
                              ],
                              "direction": "vertical",
                              "gap": "xs",
                              "type": "stack"
                            },
                            {
                              "animate": false,
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": false,
                              "points": [],
                              "shapes": [],
                              "showAxes": true,
                              "showGrid": true,
                              "title": "",
                              "type": "math-canvas",
                              "vectors": [],
                              "width": "@config.width",
                              "xMax": "@config.duration",
                              "xMin": 0.0,
                              "yMax": "@config.valueMax",
                              "yMin": 0.0
                            },
                            {
                              "content": [
                                "str/concat",
                                "t = ",
                                [
                                  "math/round",
                                  "@entity.t",
                                  1.0
                                ],
                                " · ",
                                "@config.pLabel",
                                " = ",
                                [
                                  "math/round",
                                  "@entity.p",
                                  1.0
                                ],
                                " · ",
                                "@config.qLabel",
                                " = ",
                                [
                                  "math/round",
                                  "@entity.q",
                                  1.0
                                ]
                              ],
                              "type": "typography",
                              "variant": "body"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ],
                  [
                    "emit",
                    "SHOCK_APPLIED",
                    {
                      "delta": "@payload.delta",
                      "p": "@entity.p",
                      "q": "@entity.q"
                    }
                  ]
                ],
                "event": "SHOCK",
                "eventId": "evt_01M07580P0TJ5NZE7BGSPD00W6",
                "from": "idle",
                "guard": [
                  "==",
                  "@entity.active",
                  true
                ],
                "to": "idle"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "let",
                  [
                    [
                      "dt",
                      [
                        "*",
                        0.1,
                        "@config.timeScale"
                      ]
                    ],
                    [
                      "a",
                      "@entity.coefA"
                    ],
                    [
                      "b",
                      "@entity.coefB"
                    ],
                    [
                      "P",
                      "@entity.p"
                    ],
                    [
                      "Q",
                      "@entity.q"
                    ],
                    [
                      "dP",
                      [
                        "if",
                        [
                          "==",
                          "@config.kind",
                          "predator-prey"
                        ],
                        [
                          "-",
                          [
                            "*",
                            "@a",
                            "@P"
                          ],
                          [
                            "*",
                            "@b",
                            "@P",
                            "@Q",
                            0.01
                          ]
                        ],
                        [
                          "if",
                          [
                            "==",
                            "@config.kind",
                            "epidemic"
                          ],
                          [
                            "-",
                            0.0,
                            [
                              "*",
                              "@a",
                              "@P",
                              "@Q",
                              0.01
                            ]
                          ],
                          [
                            "-",
                            0.0,
                            [
                              "*",
                              "@a",
                              "@P"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "dQ",
                      [
                        "if",
                        [
                          "==",
                          "@config.kind",
                          "predator-prey"
                        ],
                        [
                          "-",
                          [
                            "*",
                            "@config.coefC",
                            "@b",
                            "@P",
                            "@Q",
                            0.01
                          ],
                          [
                            "*",
                            "@config.coefD",
                            "@Q"
                          ]
                        ],
                        [
                          "if",
                          [
                            "==",
                            "@config.kind",
                            "epidemic"
                          ],
                          [
                            "-",
                            [
                              "*",
                              "@a",
                              "@P",
                              "@Q",
                              0.01
                            ],
                            [
                              "*",
                              "@b",
                              "@Q"
                            ]
                          ],
                          [
                            "-",
                            [
                              "*",
                              "@a",
                              "@P"
                            ],
                            [
                              "*",
                              "@b",
                              "@Q"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "newP",
                      [
                        "math/max",
                        0.0,
                        [
                          "+",
                          "@P",
                          [
                            "*",
                            "@dP",
                            "@dt"
                          ]
                        ]
                      ]
                    ],
                    [
                      "newQ",
                      [
                        "math/max",
                        0.0,
                        [
                          "+",
                          "@Q",
                          [
                            "*",
                            "@dQ",
                            "@dt"
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "do",
                    [
                      "set",
                      "@entity.t",
                      [
                        "math/min",
                        "@config.duration",
                        [
                          "+",
                          "@entity.t",
                          0.1
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.p",
                      "@newP"
                    ],
                    [
                      "set",
                      "@entity.q",
                      "@newQ"
                    ],
                    [
                      "set",
                      "@entity.pSamples",
                      [
                        "array/append",
                        "@entity.pSamples",
                        {
                          "x": "@entity.t",
                          "y": "@newP"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.qSamples",
                      [
                        "array/append",
                        "@entity.qSamples",
                        {
                          "x": "@entity.t",
                          "y": "@newQ"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.curves",
                      [
                        {
                          "color": "@config.pColor",
                          "label": "@config.pLabel",
                          "samples": "@entity.pSamples"
                        },
                        {
                          "color": "@config.qColor",
                          "label": "@config.qLabel",
                          "samples": "@entity.qSamples"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      [
                        "if",
                        [
                          ">=",
                          "@entity.t",
                          "@config.duration"
                        ],
                        false,
                        true
                      ]
                    ]
                  ]
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "<",
                    "@entity.t",
                    "@config.duration"
                  ]
                ]
              ],
              "interval": 100.0,
              "name": "coupledTick"
            }
          ]
        }
      ],
      "types": {
        "CoupledCurve": [
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "color",
            "type": "string"
          },
          {
            "name": "samples",
            "properties": [
              {
                "name": "x",
                "required": true,
                "type": "number"
              },
              {
                "name": "y",
                "required": true,
                "type": "number"
              }
            ],
            "required": true,
            "type": "[object]"
          }
        ],
        "CoupledSample": [
          {
            "name": "x",
            "required": true,
            "type": "number"
          },
          {
            "name": "y",
            "required": true,
            "type": "number"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}