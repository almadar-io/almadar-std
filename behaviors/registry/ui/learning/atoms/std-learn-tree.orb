                                "variant": "secondary"
                              },
                              {
                                "action": "RUN_TRAVERSAL",
                                "label": "Traverse",
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "TOGGLE_RUN",
                                "label": [
                                  "if",
                                  "@entity.running",
                                  "Pause",
                                  "Run"
                                ],
                                "type": "button",
                                "variant": "secondary"
                              },
                              {
                                "action": "RESET",
                                "label": "Reset",
                                "type": "button",
                                "variant": "ghost"
                              }
                            ],
                            "direction": "horizontal",
                            "gap": "sm",
                            "type": "stack"
                          },
                          {
                            "backgroundColor": "@config.backgroundColor",
                            "edges": "@entity.edges",
                            "height": "@config.height",
                            "layout": "tree",
                            "nodes": "@entity.nodes",
                            "root": "n0",
                            "type": "algo-graph-canvas",
                            "width": "@config.width"
                          },
                          {
                            "content": "@entity.narration",
                            "type": "typography",
                            "variant": "body"
                          }
                        ],
                        "direction": "vertical",
                        "gap": "md",
                        "type": "stack"
                      }
                    ],
                    "padding": "md",
                    "type": "box"
                  }
                ],
                [
                  "emit",
                  "TREE_UPDATED",
                  {
                    "count": "@entity.count",
                    "edges": "@entity.edges",
                    "narration": "@entity.narration",
                    "nodes": "@entity.nodes"
                  }
                ]
              ],
              "guard": [
                "and",
                [
                  "==",
                  "@entity.active",
                  true
                ],
                [
                  "and",
                  [
                    "==",
                    "@entity.running",
                    true
                  ],
                  [
                    "not",
                    [
                      "==",
                      "@entity.done",
                      true
                    ]
                  ]
                ]
              ],
              "interval": 500.0,
              "name": "treeTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}