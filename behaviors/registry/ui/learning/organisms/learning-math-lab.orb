          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG0538ET62ZS14ZGBRBSJTT",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Lab router broadcast naming the active mode; the declarative plotter renders when the mode is one of the seven config-driven canvas modes, otherwise renders null.",
                "id": "evt_01KZNG5QZ407QVM0THTDJXMTGX",
                "key": "MODE_SELECTED",
                "name": "Mode Selected",
                "payloadSchema": [
                  {
                    "name": "mode",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    false
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KXG0538ET62ZS14ZGBRBSJTT",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.active",
                    true
                  ],
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.curves",
                    "@config.curves"
                  ],
                  [
                    "set",
                    "@entity.points",
                    "@config.points"
                  ],
                  [
                    "set",
                    "@entity.vectors",
                    "@config.vectors"
                  ],
                  [
                    "set",
                    "@entity.shapes",
                    "@config.shapes"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "animate": "@config.animate",
                              "curves": "@entity.curves",
                              "gridStep": "@config.gridStep",
                              "height": "@config.height",
                              "interactive": "@config.interactive",
                              "points": "@entity.points",
                              "shapes": "@entity.shapes",
                              "showAxes": "@config.showAxes",
                              "showGrid": "@config.showGrid",
                              "type": "math-canvas",
                              "vectors": "@entity.vectors",
                              "width": "@config.width",
                              "xMax": "@config.xMax",
                              "xMin": "@config.xMin",
                              "yMax": "@config.yMax",
                              "yMin": "@config.yMin"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "MODE_SELECTED",
                "eventId": "evt_01KZNG5QZ407QVM0THTDJXMTGX",
                "from": "idle",
                "guard": [
                  "or",
                  [
                    "==",
                    "@payload.mode",
                    "coordinate-plane"
                  ],
                  [
                    "or",
                    [
                      "==",
                      "@payload.mode",
                      "function-plot"
                    ],
                    [
                      "or",
                      [
                        "==",
                        "@payload.mode",
                        "vector"
                      ],
                      [
                        "or",
                        [
                          "==",
                          "@payload.mode",
                          "geometry"
                        ],
                        [
                          "or",
                          [
                            "==",
                            "@payload.mode",
                            "number-line"
                          ],
                          [
                            "or",
                            [
                              "==",
                              "@payload.mode",
                              "slope-field"
                            ],
                            [
                              "==",
                              "@payload.mode",
                              "area-integral"
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                "to": "idle"
              }
            ]
          }
