        {
          "config": {
            "allLabel": {
              "default": "All",
              "type": "unknown"
            },
            "allSummary": {
              "default": "Taken together, the threads reinforce each other — political fragmentation weakens defense, military defeat costs territory and revenue, and fiscal collapse starves the state of the resources reform would need. No single lens tells the whole story.",
              "type": "unknown"
            },
            "axisMarginLeft": {
              "default": 60.0,
              "type": "unknown"
            },
            "axisMarginRight": {
              "default": 60.0,
              "type": "unknown"
            },
            "axisY": {
              "default": 220.0,
              "type": "unknown"
            },
            "categories": {
              "default": [
                {
                  "category": "political",
                  "color": "#7c3aed",
                  "label": "Political"
                },
                {
                  "category": "military",
                  "color": "#b91c1c",
                  "label": "Military"
                },
                {
                  "category": "economic",
                  "color": "#15803d",
                  "label": "Economic"
                }
              ],
              "type": "unknown"
            },
            "categorySummaries": {
              "default": [
                {
                  "category": "political",
                  "summary": "Viewed through politics alone, Rome's fall is administrative: civil war, reform, and a permanent East-West split hollow out central authority long before any emperor is deposed."
                },
                {
                  "category": "military",
                  "summary": "Viewed through the military alone, Rome's fall is a string of defeats and incursions — Adrianople, two sacks of the capital, endless frontier pressure — that leave the West unable to defend itself."
                },
                {
                  "category": "economic",
                  "summary": "Viewed through economics alone, Rome's fall is fiscal: the loss of North Africa's tax base and decades of currency debasement starve the state of resources that war and administration both require."
                }
              ],
              "type": "unknown"
            },
            "markerHighlightRadius": {
              "default": 14.0,
              "type": "unknown"
            },
            "markerRadius": {
              "default": 8.0,
              "type": "unknown"
            },
            "matchMode": {
              "default": "timeline",
              "type": "unknown"
            },
            "maxPosition": {
              "default": 480.0,
              "type": "unknown"
            },
            "minPosition": {
              "default": 230.0,
              "type": "unknown"
            },
            "stages": {
              "default": [
                {
                  "category": "political",
                  "description": "Decades of civil war and rapid emperor turnover near-collapse central authority across the Empire.",
                  "id": "crisis-third-century",
                  "label": "Crisis of the Third Century Begins",
                  "position": 235.0
                },
                {
                  "category": "political",
                  "description": "The Empire is split into a Tetrarchy and its administration overhauled to stabilize imperial control.",
                  "id": "diocletians-reforms",
                  "label": "Diocletian's Reforms",
                  "position": 284.0
                },
                {
                  "category": "economic",
                  "description": "Diocletian tries to halt runaway inflation from decades of currency debasement, with limited success.",
                  "id": "edict-max-prices",
                  "label": "Edict on Maximum Prices",
                  "position": 301.0
                },
                {
                  "category": "military",
                  "description": "Fleeing the Huns, the Goths are admitted into Roman territory, straining military and food supply.",
                  "id": "goths-cross-danube",
                  "label": "Goths Cross the Danube",
                  "position": 376.0
                },
                {
                  "category": "military",
                  "description": "A Roman field army is destroyed by Gothic forces, a catastrophic blow exposing imperial vulnerability.",
                  "id": "battle-adrianople",
                  "label": "Battle of Adrianople",
                  "position": 378.0
                },
                {
                  "category": "political",
                  "description": "Theodosius's sons divide administration; East and West never again reunite under one emperor.",
                  "id": "empire-splits",
                  "label": "Empire Permanently Splits East and West",
                  "position": 395.0
                },
                {
                  "category": "military",
                  "description": "The city of Rome is sacked for the first time in 800 years, a profound symbolic and military shock.",
                  "id": "sack-rome-alaric",
                  "label": "Sack of Rome by Alaric",
                  "position": 410.0
                },
                {
                  "category": "economic",
                  "description": "Rome loses its wealthiest grain-producing province in North Africa, crippling tax revenue and food supply.",
                  "id": "vandals-seize-carthage",
                  "label": "Vandals Seize Carthage",
                  "position": 439.0
                },
                {
                  "category": "military",
                  "description": "A Roman-led coalition halts Attila's Huns, but the effort further drains dwindling military resources.",
                  "id": "battle-catalaunian-plains",
                  "label": "Battle of the Catalaunian Plains",
                  "position": 451.0
                },
                {
                  "category": "military",
                  "description": "A second sack of Rome underscores the collapse of Western military capacity to defend the capital.",
                  "id": "vandals-sack-rome",
                  "label": "Vandals Sack Rome",
                  "position": 455.0
                },
                {
                  "category": "political",
                  "description": "Odoacer deposes the last Western emperor; conventionally marked as the fall of the Western Roman Empire.",
                  "id": "romulus-augustulus-deposed",
                  "label": "Romulus Augustulus Deposed",
                  "position": 476.0
                }
