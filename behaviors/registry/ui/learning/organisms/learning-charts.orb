                  "label": "Spring",
                  "value": 24.0
                },
                {
                  "label": "Summer",
                  "value": 38.0
                },
                {
                  "label": "Fall",
                  "value": 30.0
                },
                {
                  "label": "Winter",
                  "value": 18.0
                }
              ],
              "description": "Labeled values for a single-series chart.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  },
                  "value": {
                    "name": "value",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Data",
              "tier": "domain",
              "type": "[ChartsDataItem]"
            },
            "height": {
              "default": 300.0,
              "description": "Chart height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "scatterData": {
              "default": [],
              "description": "x/y points for scatter charts.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": false,
                    "type": "string"
                  },
                  "size": {
                    "name": "size",
                    "required": false,
                    "type": "number"
                  },
                  "x": {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  "y": {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Scatter Data",
              "tier": "domain",
              "type": "[ChartsScatterItem]"
            },
            "series": {
              "default": [],
              "description": "Multi-series line/area/bar data.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "data": {
                    "items": {
                      "properties": {
                        "color": {
                          "name": "color",
                          "required": false,
                          "type": "string"
                        },
                        "label": {
                          "name": "label",
                          "required": true,
                          "type": "string"
                        },
                        "value": {
                          "name": "value",
                          "required": true,
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "name": "data",
                    "required": true,
                    "type": "array"
                  },
                  "name": {
                    "name": "name",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Series",
              "tier": "domain",
              "type": "[ChartsSeriesItem]"
            },
