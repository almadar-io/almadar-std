            "ChartsItem": "ent_01KZCZWMXH6NCG322QS9MV4ZQC"
          },
          "id": "trt_01KZCZWMXHXZYNMQ7AF9KMP0Z4",
          "linkedEntity": "ChartsItem",
          "linkedEntityId": "ent_01KZCZWMXH6NCG322QS9MV4ZQC",
          "name": "ChartsRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZCZWMXHQFWKZP9NF2E9EK5M",
                "key": "INIT",
                "name": "Initialize"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "chartType": "@config.chartType",
                              "data": "@config.data",
                              "height": "@config.height",
                              "scatterData": "@config.scatterData",
                              "series": "@config.series",
                              "showLegend": "@config.showLegend",
                              "showValues": "@config.showValues",
                              "type": "chart"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZCZWMXHQFWKZP9NF2E9EK5M",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}