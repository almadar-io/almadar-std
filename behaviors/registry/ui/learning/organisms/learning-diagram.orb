                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "NEXT",
                "eventId": "evt_01KZCZWMYS3Z36YPCS2VZ6N0RX",
                "from": "idle",
                "to": "idle"
              },
              {
