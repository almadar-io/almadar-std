          "id": "trt_01KZCZWMYQ2BC09TVHQHA9NH3M",
          "linkedEntity": "DiagramItem",
          "linkedEntityId": "ent_01KZCZWMYQ75Q74V9FJFV9DW36",
          "name": "DiagramRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KZCZWMYQMQBM9RNRT7Q3HHQA",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KZCZWMYS3Z36YPCS2VZ6N0RX",
                "key": "NEXT",
                "name": "Next"
              },
              {
                "id": "evt_01KZCZWMYSSGCVC665DH7H73S4",
                "key": "PREV",
                "name": "Prev"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.title",
                    "@config.title"
                  ],
                  [
                    "set",
                    "@entity.layout",
                    [
                      "if",
                      [
                        "==",
                        "@config.mode",
                        "concept-map"
                      ],
                      "force",
                      [
                        "if",
                        [
                          "==",
                          "@config.mode",
                          "flow"
                        ],
                        "flow",
                        [
                          "if",
                          [
                            "==",
                            "@config.mode",
                            "sequence"
                          ],
                          "flow",
                          [
                            "if",
                            [
                              "==",
                              "@config.mode",
                              "tree"
                            ],
                            "tree",
                            [
                              "if",
                              [
                                "==",
                                "@config.mode",
                                "cycle"
                              ],
                              "radial",
                              "force"
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.currentStep",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.stepLabel",
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@config.steps"
                        ],
                        0.0
                      ],
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@config.steps",
                          0.0
                        ],
                        "label"
                      ],
                      ""
                    ]
                  ],
                  [
                    "set",
                    "@entity.viewEdges",
                    [
                      "array/map",
                      "@config.edges",
                      [
                        "fn",
                        "e",
                        {
                          "color": [
                            "object/get",
                            "@e",
                            "color"
                          ],
                          "label": [
                            "object/get",
                            "@e",
                            "label"
                          ],
                          "source": [
                            "object/get",
                            "@e",
                            "from"
                          ],
                          "target": [
                            "object/get",
                            "@e",
                            "to"
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.viewNodes",
                    [
                      "array/map",
                      "@config.nodes",
                      [
                        "fn",
                        "n",
                        [
                          "let",
                          [
                            [
                              "isActive",
                              [
                                "and",
                                [
                                  ">",
                                  [
                                    "array/len",
                                    "@config.steps"
                                  ],
                                  0.0
                                ],
                                [
                                  "array/includes",
                                  [
                                    "object/get",
                                    [
                                      "array/nth",
                                      "@config.steps",
                                      "@entity.currentStep"
                                    ],
                                    "activeNodes"
                                  ],
                                  [
                                    "object/get",
                                    "@n",
                                    "id"
                                  ]
                                ]
                              ]
                            ]
                          ],
                          {
                            "color": [
                              "if",
                              "@isActive",
                              "#f59e0b",
                              [
                                "object/get",
                                "@n",
                                "color"
                              ]
                            ],
                            "group": [
                              "object/get",
                              "@n",
                              "group"
                            ],
                            "id": [
                              "object/get",
                              "@n",
                              "id"
                            ],
                            "label": [
                              "object/get",
                              "@n",
                              "label"
                            ],
                            "size": [
                              "if",
                              "@isActive",
                              12.0,
                              8.0
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "content": "@entity.title",
                              "type": "typography",
                              "variant": "h4"
                            },
                            {
                              "content": "@entity.stepLabel",
                              "type": "typography",
                              "variant": "body"
                            },
                            {
                              "edges": "@entity.viewEdges",
                              "height": "@config.height",
                              "layout": "@entity.layout",
                              "nodes": "@entity.viewNodes",
                              "showLabels": "@config.showLabels",
                              "type": "graph-view"
                            },
                            {
                              "children": [
                                {
                                  "action": "PREV",
                                  "label": "◀ Prev",
                                  "type": "button",
                                  "variant": "ghost"
                                },
                                {
                                  "action": "NEXT",
                                  "label": "Next ▶",
                                  "type": "button",
                                  "variant": "primary"
                                }
                              ],
                              "direction": "horizontal",
                              "gap": "sm",
                              "type": "stack"
                            }
                          ],
                          "direction": "vertical",
                          "gap": "md",
                          "type": "stack"
                        }
                      ],
                      "padding": "md",
                      "type": "box"
                    }
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KZCZWMYQMQBM9RNRT7Q3HHQA",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.currentStep",
                    [
