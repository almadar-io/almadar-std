                  },
                  "to": {
                    "name": "to",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Edges",
              "tier": "domain",
              "type": "[DiagramEdge]"
            },
            "height": {
              "default": 420.0,
              "description": "Diagram height in pixels.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "mode": {
              "default": "concept-map",
              "description": "What kind of diagram to render; the renderer maps this to a deterministic layout algorithm.",
              "label": "Mode",
              "synonyms": "diagram, flowchart, concept map, mind map, tree diagram, hierarchy, cycle diagram, feedback loop, process flow, workflow, state diagram, causal chain, relationship map, network diagram, sequence of steps, stages",
              "tier": "domain",
              "type": "string",
              "values": [
                "concept-map",
                "flow",
                "tree",
                "cycle",
                "sequence"
              ]
            },
            "nodes": {
              "default": [
                {
                  "color": "#2563eb",
                  "group": "stage",
                  "id": "input",
                  "label": "Input"
                },
                {
                  "color": "#7c3aed",
                  "group": "stage",
                  "id": "process",
                  "label": "Process"
                },
                {
                  "color": "#16a34a",
                  "group": "stage",
                  "id": "output",
                  "label": "Output"
                }
              ],
              "description": "Semantic nodes only — the renderer computes every position. Never provide coordinates or shapes.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "group": {
                    "name": "group",
                    "required": false,
                    "type": "string"
                  },
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Nodes",
              "tier": "domain",
              "type": "[DiagramNode]"
            },
            "showLabels": {
              "default": true,
              "description": "Show node labels.",
              "label": "Show Labels",
              "tier": "presentation",
              "type": "boolean"
            },
            "steps": {
              "default": [],
              "description": "Optional step-through stages; each stage names the node ids to highlight. Leave empty for a static diagram.",
              "items": {
                "properties": {
                  "activeNodes": {
                    "items": {
                      "type": "string"
                    },
                    "name": "activeNodes",
                    "required": false,
                    "type": "array"
                  },
                  "label": {
                    "name": "label",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
