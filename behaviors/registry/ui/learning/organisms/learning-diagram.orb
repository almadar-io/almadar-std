                      "@config.nodes",
                      [
                        "fn",
                        "n",
                        [
                          "let",
                          [
                            [
                              "isActive",
                              [
                                "and",
                                [
                                  ">",
                                  [
                                    "array/len",
                                    "@config.steps"
