                  "from": "input",
                  "label": "flows to",
                  "to": "process"
                },
                {
                  "from": "process",
                  "label": "produces",
                  "to": "output"
                }
              ],
              "description": "Edges reference node ids via from/to.",
              "items": {
                "properties": {
                  "color": {
                    "name": "color",
                    "required": false,
                    "type": "string"
                  },
                  "from": {
                    "name": "from",
                    "required": true,
