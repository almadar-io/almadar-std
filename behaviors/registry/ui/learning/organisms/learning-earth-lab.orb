              "synonyms": "earth science, geology, plate tectonics, tectonic plates, plate boundary, convergent boundary, divergent boundary, transform boundary, subduction, subduction zone, trench, volcanic arc, mid-ocean ridge, rift valley, seafloor spreading, continental drift, strike-slip fault, transform fault, earthquake, seismicity, Wadati-Benioff zone, water cycle, hydrologic cycle, evaporation, condensation, precipitation, runoff, reservoir, ocean, atmosphere, solar input, cloud formation, rainfall, infiltration",
              "tier": "domain",
              "type": "string",
              "values": [
                "plates",
                "water-cycle"
              ]
            }
          },
