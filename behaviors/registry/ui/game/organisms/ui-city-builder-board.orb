                                  "type": "draw-sprite"
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          },
                          {
                            "items": [
                              "array/map",
                              "@entity.features",
                              [
                                "fn",
                                "f",
                                {
                                  "asset": [
                                    "object/get",
                                    "@f",
                                    "sprite"
                                  ],
                                  "position": {
                                    "x": [
                                      "object/get",
                                      "@f",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@f",
                                      "y"
                                    ]
                                  },
                                  "type": "draw-sprite"
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          },
                          {
                            "items": [
                              "array/map",
                              "@entity.validMoves",
                              [
                                "fn",
                                "m",
                                {
                                  "fill": "rgba(74,222,128,0.4)",
                                  "position": {
                                    "x": [
                                      "object/get",
                                      "@m",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@m",
                                      "y"
                                    ]
                                  },
                                  "shape": "cell",
                                  "type": "draw-shape"
                                }
                              ]
                            ],
                            "type": "draw-shape-layer"
                          },
                          {
                            "items": [
                              "array/map",
                              "@entity.effects",
                              [
                                "fn",
                                "e",
                                {
                                  "asset": [
                                    "object/get",
                                    [
                                      "object/get",
                                      "@config.assetManifest",
                                      "effects"
                                    ],
                                    [
                                      "object/get",
                                      "@e",
                                      "key"
                                    ]
                                  ],
                                  "position": {
                                    "x": [
                                      "object/get",
                                      "@e",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@e",
                                      "y"
                                    ]
                                  },
                                  "type": "draw-sprite"
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          },
                          {
                            "items": [
                              "array/map",
                              "@entity.citizens",
                              [
                                "fn",
                                "u",
                                {
                                  "asset": [
                                    "object/merge",
                                    [
                                      "object/get",
                                      "@u",
                                      "sprite"
                                    ],
                                    {
                                      "url": [
                                        "str/concat",
                                        [
                                          "str/concat",
                                          "https://almadar-kflow-assets.web.app/shared/ui-city-builder-board/svg/isometric/units/citizen.walk-",
                                          [
                                            "%",
                                            [
                                              "object/get",
                                              "@u",
                                              "frame"
                                            ],
                                            2.0
                                          ]
                                        ],
                                        ".svg"
                                      ]
                                    }
                                  ],
                                  "id": [
                                    "object/get",
                                    "@u",
                                    "id"
                                  ],
                                  "position": [
                                    "object/get",
                                    "@u",
                                    "position"
                                  ],
                                  "type": "draw-sprite"
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          }
                        ],
                        "fit": true,
                        "projection": "isometric",
                        "showMinimap": true,
                        "tileClickEvent": "PLACE_BUILDING",
                        "type": "canvas"
                      }
                    ],
                    "hud": {
                      "children": [
                        {
                          "stats": [
                            {
                              "iconUrl": {
                                "animations": [],
                                "aspect": "1:1",
                                "category": "ui",
                                "dimension": "2d",
                                "name": "icon-population",
                                "role": "ui",
                                "style": "",
