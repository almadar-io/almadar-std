                            {
                              "format": "text",
                              "label": "Build",
                              "value": "@entity.pendingBuildType"
                            }
                          ],
                          "type": "game-hud"
                        },
                        {
                          "actionEvent": "SELECT_BUILD_TYPE",
                          "buttons": [
                            "array/map",
