          "linkedEntity": "CityBuilderBoardItem",
          "linkedEntityId": "ent_01KXG04X47YA341X28YQGKR6D4",
          "name": "CityBuilderBoardRender",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KXG04X47P2DS8BT6D31496E9",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Emitted by the HUD build palette (control-grid actionEvent) with {id, pressed} when the mayor arms a build type",
                "id": "evt_01KXG04X4A7KFDXCBBRCDW5TV9",
                "key": "SELECT_BUILD_TYPE",
                "name": "Select Build Type",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "pressed",
                    "type": "boolean"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Emitted by the canvas (tileClickEvent) with {x,y} when the mayor zones a cell",
                "id": "evt_01KXG04X4A2S9R0DKP8KXSAHJC",
                "key": "PLACE_BUILDING",
                "name": "Place Building",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Emitted when the city reaches its population target (won)",
                "id": "evt_01KXG04X4AHT8ZHYGNCKH7P13Q",
                "key": "GAME_END",
                "name": "Game End",
                "payloadSchema": [
                  {
                    "name": "result",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "id": "evt_01KXG04X4AZG7KDTHPBT4TGG48",
                "key": "PLAY_AGAIN",
                "name": "Play Again"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "building"
              },
              {
                "name": "gameover"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.gold",
                    "@config.gold"
                  ],
                  [
                    "set",
                    "@entity.wood",
                    "@config.wood"
                  ],
                  [
                    "set",
                    "@entity.population",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.features",
                    "@config.features"
                  ],
                  [
                    "set",
                    "@entity.citizens",
                    "@config.citizens"
                  ],
                  [
                    "set",
                    "@entity.pendingBuildType",
                    "@config.pendingBuildType"
                  ],
                  [
                    "set",
                    "@entity.result",
                    "none"
                  ],
                  [
                    "set",
                    "@entity.tick",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.effects",
                    []
                  ],
                  [
                    "set",
                    "@entity.validMoves",
                    [
                      "array/map",
                      [
                        "array/filter",
                        "@config.tiles",
                        [
                          "fn",
                          "tl",
                          [
                            "and",
                            [
                              "object/get",
                              "@tl",
                              "passable"
                            ],
                            [
                              "and",
                              [
                                "==",
                                [
                                  "array/len",
                                  [
                                    "array/filter",
                                    "@entity.features",
                                    [
                                      "fn",
                                      "f",
                                      [
                                        "and",
                                        [
                                          "==",
                                          "@f.x",
                                          [
                                            "object/get",
                                            "@tl",
                                            "x"
                                          ]
                                        ],
                                        [
                                          "==",
                                          "@f.y",
                                          [
                                            "object/get",
                                            "@tl",
                                            "y"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                0.0
                              ],
                              [
                                "and",
                                [
                                  ">=",
                                  "@entity.gold",
                                  [
                                    "object/get",
                                    [
                                      "array/first",
                                      [
                                        "array/filter",
                                        "@config.buildTypes",
                                        [
                                          "fn",
                                          "b",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@b",
                                              "type"
                                            ],
                                            "@entity.pendingBuildType"
                                          ]
                                        ]
                                      ]
                                    ],
                                    "cost"
                                  ]
                                ],
                                [
                                  "and",
                                  [
                                    ">=",
                                    "@entity.wood",
                                    [
                                      "object/get",
                                      [
                                        "array/first",
                                        [
                                          "array/filter",
                                          "@config.buildTypes",
                                          [
                                            "fn",
                                            "b",
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@b",
                                                "type"
                                              ],
                                              "@entity.pendingBuildType"
                                            ]
                                          ]
                                        ]
                                      ],
                                      "woodCost"
                                    ]
                                  ],
                                  [
                                    "or",
                                    [
                                      "!=",
                                      "@entity.pendingBuildType",
                                      "mine"
                                    ],
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@tl",
                                        "terrain"
                                      ],
                                      "stone"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "fn",
                        "tl",
                        {
                          "x": [
                            "object/get",
                            "@tl",
                            "x"
                          ],
                          "y": [
                            "object/get",
                            "@tl",
                            "y"
                          ]
                        }
                      ]
                    ]
                  ],
