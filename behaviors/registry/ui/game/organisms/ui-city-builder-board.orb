                          "kind": "actions",
                          "type": "control-grid"
                        }
                      ],
                      "direction": "horizontal",
                      "gap": "md",
                      "justify": "between",
                      "type": "stack"
                    },
                    "hudBackgroundAsset": {
                      "animations": [],
