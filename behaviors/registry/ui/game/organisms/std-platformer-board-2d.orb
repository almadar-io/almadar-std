                                "p",
                                {
                                  "asset": [
                                    "object/get",
                                    "@config.tileSprites",
                                    [
                                      "object/get",
                                      "@p",
                                      "type"
                                    ]
                                  ],
                                  "height": [
                                    "object/get",
                                    "@p",
                                    "height"
                                  ],
                                  "position": {
                                    "x": [
                                      "object/get",
                                      "@p",
                                      "x"
                                    ],
                                    "y": [
                                      "object/get",
                                      "@p",
                                      "y"
                                    ]
                                  },
                                  "type": "draw-sprite",
                                  "width": [
                                    "object/get",
                                    "@p",
                                    "width"
                                  ]
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          },
                          {
                            "items": [
                              [
                                "object/merge",
                                {
                                  "flipX": [
                                    "not",
                                    "@entity.body.facingRight"
                                  ],
                                  "frame": "@entity.frame",
                                  "height": "@entity.body.height",
                                  "position": {
                                    "x": "@entity.body.x",
                                    "y": "@entity.body.y"
                                  },
                                  "type": "draw-sprite",
                                  "width": "@entity.body.width"
                                },
                                {
                                  "asset": [
                                    "object/merge",
                                    "@config.playerSprite",
                                    {
                                      "sprite": [
                                        "if",
                                        "@entity.body.grounded",
                                        [
                                          "if",
                                          [
                                            "!=",
                                            "@entity.body.vx",
                                            0.0
                                          ],
                                          [
                                            "if",
                                            [
                                              "==",
                                              [
                                                "%",
                                                "@entity.frame",
                                                2.0
                                              ],
                                              0.0
                                            ],
                                            "adventurer_walk1.png",
                                            "adventurer_walk2.png"
                                          ],
                                          "adventurer_idle.png"
                                        ],
                                        "adventurer_jump.png"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            ],
                            "type": "draw-sprite-layer"
                          },
                          {
                            "items": "@entity.fx",
                            "presets": "@config.fxPresets",
                            "tickMs": 500.0,
                            "type": "draw-fx-layer"
                          }
                        ],
                        "keyMap": {
                          "ArrowLeft": "LEFT",
                          "ArrowRight": "RIGHT",
                          "ArrowUp": "JUMP",
                          "KeyA": "LEFT",
                          "KeyD": "RIGHT",
                          "KeyW": "JUMP",
                          "Space": "JUMP"
                        },
                        "keyUpMap": {
                          "ArrowLeft": "STOP",
                          "ArrowRight": "STOP",
                          "KeyA": "STOP",
                          "KeyD": "STOP"
                        },
                        "projection": "side",
                        "type": "canvas",
                        "worldHeight": "@config.worldHeight",
                        "worldWidth": "@config.worldWidth"
                      }
                    ],
                    "hud": {
                      "children": [
                        {
                          "stats": [
                            {
                              "label": "Score",
                              "value": "@entity.score"
                            },
                            {
                              "label": "Lives",
                              "value": "@entity.lives"
                            }
                          ],
                          "type": "game-hud"
                        },
                        {
                          "directionAssets": "@config.directionAssets",
                          "directionEvents": {
                            "left": "LEFT",
                            "right": "RIGHT",
                            "up": "JUMP"
                          },
                          "directionReleaseEvents": {
                            "left": "STOP",
                            "right": "STOP"
                          },
                          "kind": "dpad",
                          "type": "control-grid"
                        }
                      ],
                      "direction": "horizontal",
                      "gap": "md",
                      "justify": "between",
                      "type": "stack"
                    },
                    "hudBackgroundAsset": "@config.hudBackgroundAsset",
                    "overlay": [
                      "if",
                      [
                        "==",
                        "@entity.result",
                        "won"
                      ],
                      {
                        "options": [
                          {
                            "event": "PLAY_AGAIN",
                            "id": "again",
                            "label": "Play Again",
                            "variant": "primary"
                          }
                        ],
                        "subtitle": [
                          "str/concat",
                          "Score: ",
                          "@entity.score"
                        ],
                        "title": "@config.clearTitle",
                        "type": "game-menu"
                      },
                      [
                        "if",
                        [
                          "==",
                          "@entity.result",
                          "lost"
                        ],
                        {
                          "options": [
                            {
                              "event": "PLAY_AGAIN",
                              "id": "again",
                              "label": "Play Again",
                              "variant": "primary"
                            }
                          ],
                          "subtitle": [
                            "str/concat",
                            "Score: ",
                            "@entity.score"
                          ],
                          "title": "@config.lostTitle",
                          "type": "game-menu"
                        },
                        null
                      ]
                    ],
                    "type": "game-shell"
                  }
                ]
              ],
              "interval": 100.0,
              "name": "renderTick"
            }
          ]
        }
      ],
      "uses": [
        {
          "as": "Body",
          "from": "std/behaviors/std-platformer-body"
        },
        {
          "as": "Particles",
          "from": "std/behaviors/std-fx-particles"
        },
        {
          "as": "Gate",
          "from": "std/behaviors/std-objective-flow"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}