          },
          "emits": [
            {
              "description": "Mustered-tank intent applied by the grid-tactics authority (the sole units writer)",
              "event": "SPAWN",
              "eventId": "evt_01KYSQS3WNN8A5TZ9WNYCSEXV9",
              "payloadSchema": [
                {
                  "name": "id",
                  "required": true,
                  "type": "string"
                },
                {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "team",
                  "required": true,
                  "type": "string"
                },
                {
                  "name": "health",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "maxHealth",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "unitType",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "ecoSpawnCount",
              "gold"
            ],
            "requires": [
              "result",
              "units"
            ]
          },
          "entityRebindable": true,
          "entityRefIds": {
            "GameState": "ent_01KXG04ZZ5SX0MBP8BY8JYMC2W"
          },
          "id": "trt_01KYSQS3WN9N534NZJ0SBV9YJN",
          "linkedEntity": "GameState",
          "linkedEntityId": "ent_01KXG04ZZ5SX0MBP8BY8JYMC2W",
          "name": "RtsEconomy",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYSQS3WNKB4JJA8FWERX8YZZ",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYSQS3WNZGH5JKN60J2CSEGD",
                "key": "BUILD_TANK",
                "name": "Build Tank",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              },
              {
                "description": "Mustered-tank intent applied by the grid-tactics authority (the sole units writer)",
                "id": "evt_01KYSQS3WNN8A5TZ9WNYCSEXV9",
                "key": "SPAWN",
                "name": "Spawn",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "team",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "health",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "maxHealth",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "unitType",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.gold",
                    "@config.startGold"
                  ],
                  [
                    "set",
                    "@entity.ecoSpawnCount",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYSQS3WNKB4JJA8FWERX8YZZ",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.gold",
                    [
                      "-",
                      "@entity.gold",
                      "@config.tankCost"
                    ]
                  ],
                  [
                    "emit",
                    "SPAWN",
                    {
                      "health": "@config.tankHealth",
                      "id": [
                        "str/concat",
                        "rts-t-",
                        "@entity.ecoSpawnCount"
                      ],
                      "maxHealth": "@config.tankHealth",
                      "team": "player",
                      "unitType": "tank",
                      "x": "@config.tankSpawnX",
                      "y": "@config.tankSpawnY"
                    }
                  ],
                  [
                    "set",
                    "@entity.ecoSpawnCount",
                    [
                      "+",
                      "@entity.ecoSpawnCount",
                      1.0
                    ]
                  ]
                ],
                "event": "BUILD_TANK",
                "eventId": "evt_01KYSQS3WNZGH5JKN60J2CSEGD",
                "from": "active",
                "guard": [
                  "and",
                  "@config.running",
                  [
                    "and",
                    [
                      "==",
                      "@entity.result",
                      "none"
                    ],
                    [
                      "and",
                      [
                        ">=",
                        "@entity.gold",
                        "@config.tankCost"
                      ],
                      [
                        "==",
                        [
                          "array/len",
                          [
                            "array/filter",
                            "@entity.units",
                            [
                              "fn",
                              "u",
                              [
                                "and",
                                [
                                  ">",
                                  "@u.health",
                                  0.0
                                ],
                                [
                                  "and",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@u",
                                        "position"
                                      ],
                                      "x"
                                    ],
                                    "@config.tankSpawnX"
                                  ],
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@u",
                                        "position"
                                      ],
                                      "y"
                                    ],
                                    "@config.tankSpawnY"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        0.0
                      ]
                    ]
                  ]
                ],
                "to": "active"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.gold",
                  [
                    "+",
                    "@entity.gold",
                    [
                      "*",
                      [
                        "array/len",
                        [
                          "array/filter",
                          "@entity.units",
                          [
                            "fn",
                            "u",
                            [
                              "and",
                              [
                                "==",
                                "@u.team",
                                "player"
                              ],
                              [
                                "and",
                                [
                                  ">",
                                  "@u.health",
                                  0.0
                                ],
                                [
                                  "and",
                                  [
                                    "==",
                                    "@u.unitType",
                                    "worker"
                                  ],
                                  [
                                    "<=",
                                    [
                                      "grid/manhattan-distance",
                                      [
                                        "object/get",
                                        "@u",
                                        "position"
                                      ],
                                      {
                                        "x": "@config.mineX",
                                        "y": "@config.mineY"
                                      }
                                    ],
                                    1.0
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      "@config.goldPerWorkerTick"
                    ]
                  ]
                ]
              ],
              "guard": [
                "and",
                "@config.running",
                [
                  "==",
                  "@entity.result",
                  "none"
                ]
              ],
              "interval": 2000.0,
              "name": "harvestTick"
            }
          ]
        },
