        {
          "category": "lifecycle",
          "emits": [
            {
              "description": "Real-time skirmish pulse: the grid-tactics authority runs the raider chase/melee pipeline and the command trait refreshes spent marines",
              "event": "AI_TURN",
              "eventId": "evt_01KYT9TJGC4PCG962Z66088MAT",
              "payloadSchema": [
                {
                  "name": "turn",
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "clockTicks"
            ],
            "requires": [
              "result"
            ]
          },
          "entityRebindable": true,
          "entityRefIds": {
            "GameState": "ent_01KXG04WJHHVKHWKFWX7TFEEAH"
          },
          "id": "trt_01KYT9TJGC432Y3GJSEJ254MA3",
          "linkedEntity": "GameState",
          "linkedEntityId": "ent_01KXG04WJHHVKHWKFWX7TFEEAH",
          "name": "ArenaClock",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYT9TJGC6TXWRBFYDW73YQ2W",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Real-time skirmish pulse: the grid-tactics authority runs the raider chase/melee pipeline and the command trait refreshes spent marines",
                "id": "evt_01KYT9TJGC4PCG962Z66088MAT",
                "key": "AI_TURN",
                "name": "Ai Turn",
                "payloadSchema": [
                  {
                    "name": "turn",
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "running"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.clockTicks",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYT9TJGC6TXWRBFYDW73YQ2W",
                "from": "running",
                "to": "running"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.clockTicks",
                  [
                    "+",
                    "@entity.clockTicks",
                    1.0
                  ]
                ],
                [
                  "emit",
                  "AI_TURN",
                  {
                    "turn": "@entity.clockTicks"
                  }
                ]
              ],
              "guard": [
                "==",
                "@entity.result",
                "none"
              ],
              "interval": 2000.0,
              "name": "arenaTick"
            }
          ]
        },
