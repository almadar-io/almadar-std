          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYTA71JGHPZT29S9MJSA57RE",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYTA71JG6B381MJVBWHH1SY0",
                "key": "BUILD_TOWER",
                "name": "Build Tower",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              },
              {
                "description": "Raised-watchtower intent applied by the grid-tactics authority (the sole units writer)",
                "id": "evt_01KYTA71JGFYEZT080CHVYMXC9",
                "key": "SPAWN",
                "name": "Spawn",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "team",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "health",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "maxHealth",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "unitType",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.gold",
                    "@config.startGold"
                  ],
                  [
                    "set",
                    "@entity.ecoSpawnCount",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYTA71JGHPZT29S9MJSA57RE",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.gold",
                    [
                      "-",
                      "@entity.gold",
                      "@config.towerCost"
                    ]
                  ],
                  [
                    "emit",
                    "SPAWN",
                    {
                      "health": "@config.towerHealth",
                      "id": [
