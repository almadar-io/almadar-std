        {
          "category": "lifecycle",
          "emits": [
            {
              "description": "Real-time round advance; the frame's PlayerIntent treats it exactly like the End Turn button (turn bump, activation reset, AI_TURN)",
              "event": "END_TURN",
              "eventId": "evt_01KYTA71JGZSAK73XD8RZ6BKB3",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "clockTicks"
            ],
            "requires": [
              "result"
            ]
          },
          "entityRebindable": true,
          "entityRefIds": {
            "GameState": "ent_01KYTA71JG4XM6748AW5DA0C9B"
          },
          "id": "trt_01KYTA71JG54KAEF1K6TVSJKZD",
          "linkedEntity": "GameState",
          "linkedEntityId": "ent_01KYTA71JG4XM6748AW5DA0C9B",
          "name": "CastleClock",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYTA71JG77PB8BR99FS5C17X",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Real-time round advance; the frame's PlayerIntent treats it exactly like the End Turn button (turn bump, activation reset, AI_TURN)",
                "id": "evt_01KYTA71JGZSAK73XD8RZ6BKB3",
                "key": "END_TURN",
                "name": "End Turn",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "running"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.clockTicks",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYTA71JG77PB8BR99FS5C17X",
                "from": "running",
                "to": "running"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.clockTicks",
                  [
                    "+",
                    "@entity.clockTicks",
                    1.0
                  ]
                ],
                [
                  "emit",
                  "END_TURN",
                  {
                    "id": "clock"
                  }
                ]
              ],
              "guard": [
                "==",
                "@entity.result",
                "none"
              ],
              "interval": 2000.0,
              "name": "turnTick"
            }
          ]
        },
