                                    ]
                                  ]
                                ],
                                [
                                  "array/len",
                                  [
                                    "array/filter",
                                    "@entity.pads",
                                    [
                                      "fn",
                                      "p",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@p",
                                          "grp"
                                        ],
                                        "@g"
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "currentGrp",
                            [
                              "array/reduce",
                              "@openGrps",
                              9999.0,
                              [
                                "fn",
                                [
                                  "acc",
                                  "g"
                                ],
                                [
                                  "math/min",
                                  "@acc",
                                  "@g"
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "newPads",
                              [
                                "array/map",
                                "@entity.pads",
                                [
                                  "fn",
                                  "p",
                                  [
                                    "object/merge",
                                    "@p",
                                    {
                                      "lit": [
                                        "or",
                                        [
                                          "object/get",
                                          "@p",
                                          "lit"
                                        ],
                                        [
                                          "and",
                                          [
                                            "or",
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@p",
                                                "grp"
                                              ],
                                              0.0
                                            ],
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@p",
                                                "grp"
                                              ],
                                              "@currentGrp"
                                            ]
                                          ],
                                          [
                                            "and",
                                            [
                                              "<=",
                                              [
                                                "math/abs",
                                                [
                                                  "-",
                                                  "@payload.x",
                                                  [
                                                    "object/get",
                                                    "@p",
                                                    "x"
                                                  ]
                                                ]
                                              ],
                                              "@config.reachX"
                                            ],
                                            [
                                              "<=",
                                              [
                                                "math/abs",
                                                [
                                                  "-",
                                                  "@payload.y",
                                                  [
                                                    "object/get",
                                                    "@p",
                                                    "y"
                                                  ]
                                                ]
                                              ],
                                              "@config.reachY"
                                            ]
                                          ]
                                        ]
                                      ]
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "doneNow",
                                [
                                  "array/filter",
                                  "@grpIds",
                                  [
                                    "fn",
                                    "g",
                                    [
                                      "==",
                                      [
                                        "array/len",
                                        [
                                          "array/filter",
                                          "@newPads",
                                          [
                                            "fn",
                                            "p",
                                            [
                                              "and",
                                              [
                                                "==",
                                                [
                                                  "object/get",
                                                  "@p",
                                                  "grp"
                                                ],
                                                "@g"
                                              ],
                                              [
                                                "==",
                                                [
                                                  "object/get",
                                                  "@p",
                                                  "lit"
                                                ],
                                                true
                                              ]
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        "array/len",
                                        [
                                          "array/filter",
                                          "@newPads",
                                          [
                                            "fn",
                                            "p",
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@p",
                                                "grp"
                                              ],
                                              "@g"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "newlyGrp",
                                  [
                                    "array/filter",
                                    "@doneNow",
                                    [
                                      "fn",
                                      "g",
                                      [
                                        "==",
                                        [
                                          "array/len",
                                          [
                                            "array/filter",
                                            "@entity.groupsDone",
                                            [
                                              "fn",
                                              "d",
                                              [
                                                "==",
                                                "@d",
                                                "@g"
                                              ]
                                            ]
                                          ]
                                        ],
                                        0.0
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "do",
                                [
                                  "set",
                                  "@entity.pads",
                                  "@newPads"
                                ],
                                [
                                  "if",
                                  [
                                    ">",
                                    [
                                      "array/len",
                                      "@newlyGrp"
                                    ],
                                    0.0
                                  ],
                                  [
                                    "do",
                                    [
                                      "set",
                                      "@entity.groupsDone",
                                      "@doneNow"
                                    ],
                                    [
                                      "emit",
                                      "PAD_GROUP_COMPLETED",
                                      {
                                        "grp": [
                                          "array/first",
                                          "@newlyGrp"
                                        ]
                                      }
                                    ]
                                  ],
                                  null
                                ],
                                [
                                  "if",
                                  [
                                    "and",
                                    [
                                      "==",
                                      "@entity.completed",
                                      false
                                    ],
                                    [
                                      "==",
                                      [
                                        "array/len",
                                        [
                                          "array/filter",
                                          "@newPads",
                                          [
                                            "fn",
                                            "p",
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@p",
                                                "lit"
                                              ],
                                              false
                                            ]
                                          ]
                                        ]
                                      ],
                                      0.0
                                    ]
                                  ],
                                  [
                                    "do",
                                    [
                                      "set",
                                      "@entity.completed",
                                      true
                                    ],
                                    [
                                      "emit",
                                      "PAD_SET_COMPLETED",
                                      {}
                                    ]
                                  ],
                                  null
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
