                                "grp"
                              ]
                            ]
                          ],
                          [],
                          [
                            "fn",
                            [
                              "acc",
                              "g"
                            ],
                            [
                              "if",
                              [
                                ">",
                                [
                                  "array/len",
                                  [
                                    "array/filter",
                                    "@acc",
                                    [
                                      "fn",
                                      "x",
                                      [
                                        "==",
                                        "@x",
                                        "@g"
                                      ]
                                    ]
                                  ]
                                ],
                                0.0
                              ],
                              "@acc",
                              [
                                "array/append",
                                "@acc",
                                "@g"
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "openGrps",
                          [
                            "array/filter",
                            "@grpIds",
                            [
                              "fn",
                              "g",
                              [
                                "<",
                                [
                                  "array/len",
                                  [
                                    "array/filter",
                                    "@entity.pads",
                                    [
                                      "fn",
                                      "p",
                                      [
                                        "and",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@p",
                                            "grp"
                                          ],
                                          "@g"
                                        ],
                                        [
                                          "==",
                                          [
