            "reachX": {
              "default": 0.7,
              "description": "Horizontal tolerance (world units) around a pad's center when testing player contact (approximates the body's half-width plus a step).",
              "label": "Reach X",
              "tier": "domain",
              "type": "number"
            },
            "reachY": {
              "default": 1.2,
              "description": "Vertical tolerance (world units) around a pad's center when testing player contact (covers skating over the surface the pad sits on).",
              "label": "Reach Y",
              "tier": "domain",
              "type": "number"
            },
            "running": {
              "default": true,
              "description": "When true, BODY_MOVED lights touched live pads and reports group/set completion; toggle to freeze every pad as-is.",
              "label": "Running",
              "tier": "domain",
              "type": "boolean"
            }
