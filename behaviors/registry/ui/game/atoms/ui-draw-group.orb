      "traits": [
        {
          "category": "interaction",
          "config": {
            "animation": {
              "description": "Keyframe animation over the group TRANSFORM tracks (`offsetX/Y/Z` in cells, `rotateX/Y/Z` in radians, `scale`; the 2D painter also honors `opacity`) — children inherit it, so nested animated groups form a joint chain. Material tracks belong on leaf meshes.",
              "label": "Animation",
              "properties": {
                "durationMs": {
                  "name": "durationMs",
                  "required": true,
                  "type": "number"
                },
                "keyframes": {
                  "items": {
                    "properties": {
                      "at": {
                        "name": "at",
                        "required": true,
                        "type": "number"
                      },
                      "color": {
                        "name": "color",
                        "required": false,
                        "type": "string"
                      },
                      "emissive": {
                        "name": "emissive",
                        "required": false,
                        "type": "string"
                      },
                      "emissiveIntensity": {
                        "name": "emissiveIntensity",
                        "required": false,
                        "type": "number"
                      },
                      "offsetX": {
                        "name": "offsetX",
                        "required": false,
                        "type": "number"
                      },
                      "offsetY": {
                        "name": "offsetY",
                        "required": false,
                        "type": "number"
                      },
                      "offsetZ": {
                        "name": "offsetZ",
                        "required": false,
                        "type": "number"
                      },
                      "opacity": {
                        "name": "opacity",
                        "required": false,
                        "type": "number"
                      },
                      "rotateX": {
                        "name": "rotateX",
                        "required": false,
                        "type": "number"
                      },
                      "rotateY": {
                        "name": "rotateY",
                        "required": false,
                        "type": "number"
                      },
                      "rotateZ": {
                        "name": "rotateZ",
                        "required": false,
                        "type": "number"
                      },
                      "scale": {
                        "name": "scale",
                        "required": false,
                        "type": "number"
                      }
                    },
                    "type": "object"
                  },
                  "name": "keyframes",
                  "required": true,
                  "type": "array"
                },
                "loop": {
                  "name": "loop",
                  "required": false,
                  "type": "boolean"
                }
              },
              "tier": "presentation",
              "type": "DrawGroupAnimation"
            },
            "bone": {
              "description": "Skeleton bone name. A named group is addressable by a `draw-mesh` `skin` block (smooth skinning): the skinned mesh deforms with this group's animated transform. Names resolve within the nearest enclosing `skeleton: true` group (falling back to the canvas), so multiple instances of one rig never collide. Distinct from `id` (the hit-test handle).",
              "label": "Bone",
              "tier": "presentation",
              "type": "string"
            },
            "clip": {
              "description": "Clip the group's items to an SVG path (`d` syntax) in world units relative to the group origin — masked reveals, meters, portraits.",
              "label": "Clip",
              "tier": "presentation",
              "type": "string"
            },
            "items": {
              "default": [],
              "description": "The grouped drawables, painted through the normal dispatch.",
              "items": {
                "type": "object"
              },
              "label": "Items",
              "tier": "presentation",
              "type": "[object]"
            },
            "opacity": {
              "description": "0..1 opacity.",
              "label": "Opacity",
              "tier": "presentation",
              "type": "number"
            },
            "position": {
              "default": {
                "x": 1.0,
                "y": 1.0,
                "z": 1.0
              },
              "description": "Logical scene position; the projector maps it to pixels / world.",
              "label": "Position",
              "properties": {
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                "z": {
                  "name": "z",
                  "required": false,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "DrawGroupPosition"
            },
            "rotate": {
              "description": "Rotation in radians (painter units).",
              "label": "Rotate",
              "tier": "presentation",
              "type": "number"
            },
            "rotation": {
              "default": [],
              "description": "Euler rotation `[x, y, z]` in radians (world axes) — per-axis joint rotation for the 3D backend; a group placed at a joint with children authored joint-local IS a bone. The 2D painter applies only the in-plane `z` component, after `rotate`.",
              "items": {
                "type": "number"
              },
              "label": "Rotation",
              "tier": "presentation",
              "type": "[number]"
            },
            "scale": {
              "description": "Uniform scale applied to the whole group.",
              "label": "Scale",
              "tier": "presentation",
              "type": "number"
            },
            "skeleton": {
              "description": "Marks this group as a skeleton SCOPE: `bone` names and `skin` bindings in its subtree resolve against each other only — one scope per rig instance.",
              "label": "Skeleton",
              "tier": "presentation",
              "type": "boolean"
            }
