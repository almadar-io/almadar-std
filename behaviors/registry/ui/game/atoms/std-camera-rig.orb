      },
      "id": "orb_01M1KT7VDHWWAW8CY87TSH63JJ",
      "name": "CameraRigOrbital",
      "pages": [
        {
          "id": "pag_01M1KT7VDHJG8QACSY95BPKVJH",
          "name": "CameraRigPage",
          "path": "/camera-rig",
          "traits": [
            {
              "ref": "CameraRig",
              "refId": "trt_01M1KT7VDH3WK1YCKY0NQHHDYP"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "bounds": {
              "default": {
                "xMax": 1000000.0,
                "xMin": -1000000.0,
                "yMax": 1000000.0,
                "yMin": -1000000.0
              },
              "description": "World-space clamp applied to the eased camera position every tick",
              "label": "Bounds",
              "properties": {
                "xMax": {
                  "name": "xMax",
                  "required": true,
                  "type": "number"
                },
                "xMin": {
                  "name": "xMin",
                  "required": true,
                  "type": "number"
                },
                "yMax": {
                  "name": "yMax",
                  "required": true,
                  "type": "number"
                },
                "yMin": {
                  "name": "yMin",
                  "required": true,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "CameraBounds"
            },
            "deadzoneX": {
              "default": 0.0,
              "description": "Horizontal distance from target the camera tolerates without easing",
              "label": "Dead Zone X",
              "tier": "presentation",
              "type": "number"
            },
            "deadzoneY": {
              "default": 0.0,
              "description": "Vertical distance from target the camera tolerates without easing",
              "label": "Dead Zone Y",
              "tier": "presentation",
              "type": "number"
            },
            "lead": {
              "default": 0.0,
              "description": "Horizontal look-ahead multiplier applied to FOLLOW's vx",
              "label": "Lead",
              "tier": "presentation",
              "type": "number"
            },
            "maxZoom": {
              "default": 3.0,
              "description": "Upper clamp for SET_ZOOM and the eased zoom",
              "label": "Max Zoom",
              "tier": "presentation",
              "type": "number"
            },
            "minZoom": {
              "default": 0.5,
              "description": "Lower clamp for SET_ZOOM and the eased zoom",
              "label": "Min Zoom",
              "tier": "presentation",
              "type": "number"
            },
            "running": {
              "default": true,
              "description": "When true the 33ms camera tick eases toward target; toggle to freeze the camera",
              "label": "Running",
              "tier": "domain",
              "type": "boolean"
            },
            "shakeDecay": {
              "default": 0.1,
              "description": "Amount camShake reduces toward 0 every tick",
              "label": "Shake Decay",
              "tier": "presentation",
              "type": "number"
            },
            "start": {
              "default": {
                "x": 0.0,
                "y": 0.0
              },
              "description": "Initial and RESTART camera position/target",
              "label": "Start Position",
              "properties": {
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                }
              },
              "tier": "domain",
              "type": "CameraPos"
            },
            "stiffness": {
              "default": 0.1,
              "description": "Per-tick lerp factor easing position/zoom toward target (0-1, higher = snappier)",
              "label": "Stiffness",
              "tier": "presentation",
              "type": "number"
            },
            "zoom": {
              "default": 1.0,
              "description": "Initial and RESTART zoom level",
              "label": "Zoom",
              "tier": "domain",
              "type": "number"
            }
          },
          "emits": [
            {
              "description": "Eased camera position/zoom after this tick.",
              "event": "CAMERA_MOVED",
              "eventId": "evt_01M1KT7VDHACZBVYWSJ1XT0XT4",
              "payloadSchema": [
                {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "zoom",
                  "required": true,
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "camLead",
              "camShake",
              "camTargetX",
              "camTargetY",
              "camTargetZoom",
              "camX",
              "camY",
              "camZoom"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "CameraState": "ent_01M1KT7VDHARACH6QT9FHENHM8"
          },
          "id": "trt_01M1KT7VDH3WK1YCKY0NQHHDYP",
          "linkedEntity": "CameraState",
          "linkedEntityId": "ent_01M1KT7VDHARACH6QT9FHENHM8",
          "name": "CameraRig",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M1KT7VDHP97MNNBCK21F9XF0",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Retarget from a moving body's position and horizontal velocity (vx drives camLead).",
                "id": "evt_01M1KT7VDH27J939V4G8J199KT",
                "key": "FOLLOW",
                "name": "Follow",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vx",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Snap position and target instantly, no ease — teleports and cutscenes.",
                "id": "evt_01M1KT7VDHP8EPRYARWY431Q8A",
                "key": "CUT",
                "name": "Cut",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Retarget zoom, clamped to minZoom/maxZoom.",
                "id": "evt_01M1KT7VDH7GM6FBFHVF1VJRNH",
                "key": "SET_ZOOM",
                "name": "Set Zoom",
                "payloadSchema": [
                  {
                    "name": "zoom",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Set camShake; a consumer jitters camX/camY with it at bind time — this atom never writes shake into position.",
                "id": "evt_01M1KT7VDH7EM7H3VR4949R1EX",
                "key": "SHAKE",
                "name": "Shake",
                "payloadSchema": [
                  {
                    "name": "magnitude",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Reseed position/zoom/lead/shake from config.",
                "id": "evt_01M1KT7VDHD96YA0S3RPC9MRCC",
                "key": "RESTART",
                "name": "Restart",
                "tier": "domain"
              },
              {
                "description": "Eased camera position/zoom after this tick.",
                "id": "evt_01M1KT7VDHACZBVYWSJ1XT0XT4",
                "key": "CAMERA_MOVED",
                "name": "Camera Moved",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "zoom",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.camX",
                    "@config.start.x"
                  ],
                  [
                    "set",
                    "@entity.camY",
                    "@config.start.y"
                  ],
                  [
                    "set",
                    "@entity.camZoom",
                    "@config.zoom"
                  ],
                  [
                    "set",
                    "@entity.camTargetX",
                    "@config.start.x"
                  ],
                  [
                    "set",
                    "@entity.camTargetY",
                    "@config.start.y"
                  ],
                  [
                    "set",
                    "@entity.camTargetZoom",
                    "@config.zoom"
                  ],
                  [
                    "set",
                    "@entity.camLead",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.camShake",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M1KT7VDHP97MNNBCK21F9XF0",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.camTargetX",
                    "@payload.x"
                  ],
                  [
                    "set",
                    "@entity.camTargetY",
                    "@payload.y"
                  ],
                  [
                    "set",
                    "@entity.camLead",
                    [
                      "*",
                      "@payload.vx",
                      "@config.lead"
                    ]
                  ]
                ],
                "event": "FOLLOW",
                "eventId": "evt_01M1KT7VDH27J939V4G8J199KT",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.camX",
                    "@payload.x"
                  ],
                  [
                    "set",
                    "@entity.camY",
                    "@payload.y"
                  ],
                  [
                    "set",
                    "@entity.camTargetX",
                    "@payload.x"
                  ],
                  [
                    "set",
                    "@entity.camTargetY",
                    "@payload.y"
                  ],
                  [
                    "set",
                    "@entity.camLead",
                    0.0
                  ]
                ],
                "event": "CUT",
                "eventId": "evt_01M1KT7VDHP8EPRYARWY431Q8A",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.camTargetZoom",
                    [
                      "math/clamp",
                      "@payload.zoom",
                      "@config.minZoom",
                      "@config.maxZoom"
                    ]
                  ]
                ],
                "event": "SET_ZOOM",
                "eventId": "evt_01M1KT7VDH7GM6FBFHVF1VJRNH",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.camShake",
                    "@payload.magnitude"
                  ]
                ],
                "event": "SHAKE",
                "eventId": "evt_01M1KT7VDH7EM7H3VR4949R1EX",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.camX",
                    "@config.start.x"
                  ],
                  [
                    "set",
                    "@entity.camY",
                    "@config.start.y"
                  ],
                  [
                    "set",
                    "@entity.camZoom",
                    "@config.zoom"
                  ],
                  [
                    "set",
                    "@entity.camTargetX",
                    "@config.start.x"
                  ],
                  [
                    "set",
                    "@entity.camTargetY",
                    "@config.start.y"
                  ],
                  [
                    "set",
                    "@entity.camTargetZoom",
                    "@config.zoom"
                  ],
                  [
                    "set",
                    "@entity.camLead",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.camShake",
                    0.0
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M1KT7VDHD96YA0S3RPC9MRCC",
                "from": "active",
                "to": "active"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "do",
                  [
                    "set",
                    "@entity.camX",
                    [
                      "math/clamp",
                      [
                        "if",
                        [
                          ">",
                          [
                            "math/abs",
                            [
                              "-",
                              [
                                "+",
                                "@entity.camTargetX",
                                "@entity.camLead"
                              ],
                              "@entity.camX"
                            ]
                          ],
                          "@config.deadzoneX"
                        ],
                        [
                          "math/lerp",
                          "@entity.camX",
                          [
                            "+",
                            "@entity.camTargetX",
                            "@entity.camLead"
                          ],
                          "@config.stiffness"
                        ],
                        "@entity.camX"
                      ],
                      "@config.bounds.xMin",
                      "@config.bounds.xMax"
                    ]
                  ],
                  [
                    "set",
                    "@entity.camY",
                    [
                      "math/clamp",
                      [
                        "if",
                        [
                          ">",
                          [
                            "math/abs",
                            [
                              "-",
                              "@entity.camTargetY",
                              "@entity.camY"
                            ]
                          ],
                          "@config.deadzoneY"
                        ],
                        [
                          "math/lerp",
                          "@entity.camY",
                          "@entity.camTargetY",
                          "@config.stiffness"
                        ],
                        "@entity.camY"
                      ],
                      "@config.bounds.yMin",
                      "@config.bounds.yMax"
                    ]
                  ],
                  [
                    "set",
                    "@entity.camZoom",
                    [
                      "math/clamp",
                      [
                        "math/lerp",
                        "@entity.camZoom",
                        "@entity.camTargetZoom",
                        "@config.stiffness"
                      ],
                      "@config.minZoom",
                      "@config.maxZoom"
                    ]
                  ],
                  [
                    "set",
                    "@entity.camShake",
                    [
                      "math/max",
                      0.0,
                      [
                        "-",
                        "@entity.camShake",
                        "@config.shakeDecay"
                      ]
                    ]
                  ]
                ],
                [
                  "emit",
                  "CAMERA_MOVED",
                  {
                    "x": "@entity.camX",
                    "y": "@entity.camY",
                    "zoom": "@entity.camZoom"
                  }
                ]
              ],
              "guard": "@config.running",
              "interval": 33.0,
              "name": "camTick"
            }
          ]
        }
      ],
      "types": {
        "CameraBounds": [
          {
            "name": "xMin",
            "required": true,
            "type": "number"
          },
          {
            "name": "xMax",
            "required": true,
            "type": "number"
          },
          {
            "name": "yMin",
            "required": true,
            "type": "number"
          },
          {
            "name": "yMax",
            "required": true,
            "type": "number"
          }
        ],
        "CameraPos": [
          {
            "name": "x",
            "required": true,
            "type": "number"
          },
          {
            "name": "y",
            "required": true,
            "type": "number"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}