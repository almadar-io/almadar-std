          },
          "id": "trt_01M0PCAKPP3AGKNKD907BM5QKD",
          "linkedEntity": "GateLockData",
          "linkedEntityId": "ent_01M0PCAKPNCX4VB9ENH9KE7A6K",
          "name": "GateLock",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M0PCAKPPV7X94GZE9JRTD275",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M0PCAKPP7JVBGEQSC7EM17EB",
                "key": "COLLECT",
                "name": "Collect",
                "payloadSchema": [
                  {
                    "name": "total",
                    "required": true,
                    "type": "number"
                  }
                ]
              },
              {
                "id": "evt_01M0PCAKPP7PNVBR3Y0FDGC3V1",
                "key": "BODY_MOVED",
                "name": "Body Moved",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vx",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vy",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "grounded",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "skating",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "speed",
                    "required": true,
                    "type": "number"
                  }
                ]
              },
              {
                "id": "evt_01M0PCAKPP16E2RHR0S9VEFV68",
                "key": "RESTART",
                "name": "Restart",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              },
              {
                "description": "A door's cost was reached by the collected total and it flipped open; boards layer unlock fx. When several doors open on one total, the first reports and the shared entity carries the rest.",
                "id": "evt_01M0PCAKPPW543QCFNMEFRA1TT",
                "key": "GATE_OPENED",
                "name": "Gate Opened",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "cost",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The player is inside a closed door's rect; fires once per approach and re-arms after they step out. Boards answer with a PLACE back plus a locked fx.",
                "id": "evt_01M0PCAKPPCJ7VSDH5Y8HJKXT3",
                "key": "GATE_BLOCKED",
                "name": "Gate Blocked",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.doors",
                    [
                      "array/map",
                      "@config.doors",
                      [
                        "fn",
                        "d",
                        [
                          "object/merge",
                          "@d",
                          {
                            "blocked": false,
                            "open": false,
                            "touching": false
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.total",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0PCAKPPV7X94GZE9JRTD275",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.total",
                    "@payload.total"
                  ],
                  [
                    "let",
                    [
                      [
                        "newly",
                        [
                          "array/filter",
                          "@entity.doors",
                          [
                            "fn",
                            "d",
                            [
                              "and",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@d",
                                  "open"
                                ],
                                false
                              ],
                              [
                                "<=",
                                [
                                  "object/get",
                                  "@d",
                                  "cost"
                                ],
                                "@payload.total"
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@newly"
                        ],
                        0.0
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.doors",
                          [
                            "array/map",
                            "@entity.doors",
                            [
                              "fn",
                              "d",
                              [
                                "if",
                                [
                                  "and",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@d",
                                      "open"
                                    ],
                                    false
                                  ],
                                  [
                                    "<=",
                                    [
                                      "object/get",
                                      "@d",
                                      "cost"
                                    ],
                                    "@payload.total"
                                  ]
                                ],
                                [
                                  "object/merge",
                                  "@d",
                                  {
                                    "open": true
                                  }
                                ],
                                "@d"
                              ]
                            ]
                          ]
                        ],
                        [
                          "emit",
                          "GATE_OPENED",
                          {
                            "cost": [
                              "object/get",
                              [
                                "array/first",
                                "@newly"
                              ],
                              "cost"
                            ],
                            "id": [
                              "object/get",
                              [
                                "array/first",
                                "@newly"
                              ],
                              "id"
                            ]
                          }
                        ]
                      ],
                      null
                    ]
                  ]
                ],
                "event": "COLLECT",
                "eventId": "evt_01M0PCAKPP7JVBGEQSC7EM17EB",
                "from": "active",
                "guard": "@config.running",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.doors",
                    [
                      "array/map",
                      "@entity.doors",
                      [
                        "fn",
                        "d",
                        [
                          "let",
                          [
                            [
                              "inside",
                              [
                                "and",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@d",
                                    "open"
                                  ],
                                  false
                                ],
                                [
                                  "and",
                                  [
                                    ">=",
                                    "@payload.x",
                                    [
                                      "-",
                                      [
                                        "object/get",
                                        "@d",
                                        "x"
                                      ],
                                      "@config.reachMargin"
                                    ]
                                  ],
                                  [
                                    "and",
                                    [
                                      "<=",
                                      "@payload.x",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@d",
                                          "x"
                                        ],
                                        [
                                          "object/get",
                                          "@d",
                                          "width"
                                        ],
                                        "@config.reachMargin"
                                      ]
                                    ],
                                    [
                                      "and",
                                      [
                                        ">=",
                                        "@payload.y",
                                        [
                                          "-",
                                          [
                                            "object/get",
                                            "@d",
                                            "y"
                                          ],
                                          "@config.reachMargin"
                                        ]
                                      ],
                                      [
                                        "<=",
                                        "@payload.y",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@d",
                                            "y"
                                          ],
                                          [
                                            "object/get",
                                            "@d",
                                            "height"
                                          ],
                                          "@config.reachMargin"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "object/merge",
                            "@d",
                            {
                              "blocked": [
                                "and",
                                "@inside",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@d",
                                    "touching"
                                  ],
                                  false
                                ]
                              ],
                              "touching": "@inside"
                            }
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "blocked",
                        [
                          "array/filter",
                          "@entity.doors",
                          [
                            "fn",
                            "d",
                            [
                              "==",
                              [
                                "object/get",
                                "@d",
                                "blocked"
                              ],
                              true
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@blocked"
                        ],
                        0.0
                      ],
                      [
                        "emit",
                        "GATE_BLOCKED",
                        {
                          "id": [
                            "object/get",
                            [
                              "array/first",
                              "@blocked"
                            ],
                            "id"
                          ],
                          "x": [
                            "object/get",
                            [
                              "array/first",
                              "@blocked"
                            ],
                            "x"
                          ],
                          "y": [
                            "object/get",
                            [
                              "array/first",
                              "@blocked"
                            ],
                            "y"
                          ]
                        }
                      ],
                      null
                    ]
                  ]
                ],
                "event": "BODY_MOVED",
                "eventId": "evt_01M0PCAKPP7PNVBR3Y0FDGC3V1",
                "from": "active",
                "guard": "@config.running",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.doors",
                    [
                      "array/map",
                      "@config.doors",
                      [
                        "fn",
                        "d",
                        [
                          "object/merge",
                          "@d",
                          {
                            "blocked": false,
                            "open": false,
                            "touching": false
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.total",
                    0.0
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M0PCAKPP16E2RHR0S9VEFV68",
                "from": "active",
                "to": "active"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}
