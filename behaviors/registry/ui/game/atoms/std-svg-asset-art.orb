      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "seedArt": {
              "default": {},
              "description": "Initial kind → (state → draw-group items) catalog merged under bus-published entries (published entries win). Lets a board ship vector art with zero asset imports.",
              "items": {
                "type": "opaque"
              },
              "label": "Seed Art",
              "tier": "presentation",
              "type": "Map<string,opaque>"
            }
          },
          "emits": [
            {
              "description": "Asks mounted svg asset catalogs to (re)publish their states; also the collector's own seed re-apply hop",
              "event": "SVG_ASSET_SYNC",
              "eventId": "evt_01KYV3PJKC4YMJMG7MGTHZX8WT",
              "scope": "external",
              "tier": "domain"
            }
          ],
          "entityContract": {
            "provides": [
              "svgAssetArt"
            ],
            "requires": []
          },
          "entityRebindable": true,
          "entityRefIds": {
            "StdSvgAssetArt": "ent_01KYV3PJKCJSAVS17HX3HBTZQG"
          },
          "id": "trt_01KYV3PJKCPXQE46SNJFFV0KSA",
          "linkedEntity": "StdSvgAssetArt",
          "linkedEntityId": "ent_01KYV3PJKCJSAVS17HX3HBTZQG",
          "name": "SvgAssetArtCollector",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYV3PJKCPDZE16HE9VWPJKGN",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Asks mounted svg asset catalogs to (re)publish their states; also the collector's own seed re-apply hop",
                "id": "evt_01KYV3PJKC4YMJMG7MGTHZX8WT",
                "key": "SVG_ASSET_SYNC",
                "name": "Svg Asset Sync",
                "tier": "domain"
              },
              {
                "id": "evt_01KYV3PJKCQMPB8PD310AH7WD7",
                "key": "SVG_ASSET_PUBLISH",
                "name": "Svg Asset Publish",
                "payloadSchema": [
                  {
                    "name": "kind",
                    "type": "string"
                  },
                  {
                    "name": "states",
                    "type": "Map<string,opaque>"
                  }
                ]
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "collecting"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.svgAssetArt",
                    "@config.seedArt"
                  ],
                  [
                    "emit",
                    "SVG_ASSET_SYNC",
                    {}
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYV3PJKCPDZE16HE9VWPJKGN",
                "from": "collecting",
                "to": "collecting"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.svgAssetArt",
                    [
                      "object/merge",
                      "@config.seedArt",
                      "@entity.svgAssetArt"
                    ]
                  ]
                ],
                "event": "SVG_ASSET_SYNC",
                "eventId": "evt_01KYV3PJKC4YMJMG7MGTHZX8WT",
                "from": "collecting",
                "to": "collecting"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.svgAssetArt",
                    [
                      "object/merge",
                      "@entity.svgAssetArt",
                      [
                        "object/fromEntries",
                        [
                          [
                            "@payload.kind",
                            "@payload.states"
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "SVG_ASSET_PUBLISH",
                "eventId": "evt_01KYV3PJKCQMPB8PD310AH7WD7",
                "from": "collecting",
                "to": "collecting"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
