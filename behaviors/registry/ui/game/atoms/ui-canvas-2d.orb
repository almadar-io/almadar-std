  "name": "ui-canvas-2d",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "id": "ent_01M055GNYNZ4GTH9BPBX1A8RH9",
        "name": "Canvas2dItem",
        "persistence": "runtime"
      },
      "id": "orb_01M055GNYNB72EY2C3M49826C0",
      "name": "Canvas2dOrbital",
      "pages": [
        {
          "id": "pag_01M055GNYP5EV1PJX8RJYY6YM6",
          "name": "Canvas2dPage",
          "path": "/canvas-2d",
          "traits": [
            {
              "ref": "Canvas2dRender",
              "refId": "trt_01M055GNYNDBSMRP68BDSWWFFG"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "backgroundImage": {
              "description": "Background image (tiled behind iso/hex/flat/free; cover-scaled for atlas slices). A bare URL string is accepted as shorthand for a standalone backdrop.",
              "label": "Background Image",
              "tier": "presentation",
              "type": "asset"
            },
            "bgColor": {
              "description": "Solid backdrop colour (drawn when no `backgroundImage`).",
              "label": "Bg Color",
              "tier": "presentation",
              "type": "string"
            },
            "camera": {
              "default": "pan-zoom",
              "description": "--- View config (pure render) ---",
              "label": "Camera",
              "tier": "presentation",
              "type": "string",
              "values": [
                "pan-zoom",
                "follow",
                "fixed"
              ]
            },
            "cameraPos": {
              "description": "Initial camera position in scene space (the neutral core `Camera.pos`). The host projects this to screen space and centers the viewport on it for the first render; ignored once the user pans or a follow target takes over.",
              "label": "Camera Pos",
              "properties": {
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                "z": {
                  "name": "z",
                  "required": false,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "Canvas2dCameraPos"
            },
            "children": {
              "description": "Declarative JSX drawable children (`<DrawShape .../>` composed in paint order). When `drawables` is empty, each child registers its descriptor via the drawable registry context and the host paints them.",
              "label": "Children",
              "tier": "presentation",
              "type": "node"
            },
            "className": {
              "description": "--- Closed-circuit ---",
              "label": "Class Name",
              "tier": "presentation",
              "type": "string"
            },
            "drawables": {
              "default": [],
              "description": "--- Scene ---",
              "items": {
                "type": "object"
              },
              "label": "Drawables",
              "tier": "presentation",
              "type": "[object]"
            },
            "error": {
              "description": "Error state",
              "label": "Error",
              "properties": {
                "code": {
                  "name": "code",
                  "required": false,
                  "type": "string"
                },
                "message": {
                  "name": "message",
                  "required": true,
                  "type": "string"
                },
                "name": {
                  "name": "name",
                  "required": false,
                  "type": "string"
                },
                "stack": {
                  "name": "stack",
                  "required": false,
                  "type": "string"
                }
              },
              "tier": "presentation",
              "type": "Canvas2dError"
            },
            "fit": {
              "default": false,
              "description": "Auto-fit the board's grid extent to the viewport (default false — boards render at their authored `scale` and overflow → pan). Opt in for whole-board-overview boards. User wheel/pinch zoom always wins after the initial fit.",
              "label": "Fit",
              "tier": "presentation",
              "type": "boolean"
            },
            "followTarget": {
              "description": "Follow-camera target in scene space (the neutral core `Camera.target`). When `camera:'follow'` the host lerps to keep this point centered.",
              "label": "Follow Target",
              "properties": {
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                "z": {
                  "name": "z",
                  "required": false,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "Canvas2dFollowTarget"
            },
            "isLoading": {
              "default": false,
              "description": "Loading state indicator",
              "label": "Is Loading",
              "tier": "presentation",
              "type": "boolean"
            },
            "keyMap": {
              "default": {
                "item": "Item"
              },
              "description": "Maps a keydown `e.code` → the board's SEMANTIC event (device-agnostic input).",
              "items": {
                "type": "string"
              },
              "label": "Key Map",
              "tier": "presentation",
              "type": "Map<string,string>"
            },
            "keyUpMap": {
              "default": {
                "item": "Item"
              },
              "description": "Maps a keyup `e.code` → the board's SEMANTIC event.",
              "items": {
                "type": "string"
              },
              "label": "Key Up Map",
              "tier": "presentation",
              "type": "Map<string,string>"
            },
            "projection": {
              "default": "isometric",
              "description": "--- Projection ---",
              "label": "Projection",
              "tier": "presentation",
              "type": "string",
              "values": [
                "isometric",
                "hex",
                "flat",
                "free",
                "side"
              ]
            },
            "scale": {
              "default": 0.4,
              "description": "Render scale, legacy-squared semantics: on-screen cell ≈ `256 × scale²` px (the authored contract every board tuned its value for). Converted internally to the single camera zoom against the board's native tile width, so the cell pitch follows the asset while the on-screen size stays as authored. Ignored when `fit` is on; passed through raw for `free`/`side` (world-pixel-direct).",
              "label": "Scale",
              "tier": "presentation",
              "type": "number"
            },
            "showMinimap": {
              "default": true,
              "description": "Toggle minimap overlay.",
              "label": "Show Minimap",
              "tier": "presentation",
              "type": "boolean"
            },
            "tileClickEvent": {
              "default": "TILE_CLICK",
              "description": "--- Declarative events back to LOLO ---",
              "label": "Tile Click Event",
              "tier": "presentation",
              "type": "string"
            },
            "tileHoverEvent": {
              "default": "TILE_HOVER",
              "description": "Emits UI:{tileHoverEvent} with the unprojected scene { x, y } on hover.",
              "label": "Tile Hover Event",
              "tier": "presentation",
              "type": "string"
            },
            "tileLeaveEvent": {
              "default": "TILE_LEAVE",
              "description": "Emits UI:{tileLeaveEvent} with {} on pointer leave.",
              "label": "Tile Leave Event",
              "tier": "presentation",
              "type": "string"
            },
            "tileWidth": {
              "description": "Native tile/cell width in source px for this board's asset (e.g. 16 for Kenney tiny-dungeon, ~128 for iso blocks). The grid cell pitch follows the asset, so tile textures map 1:1 (crisp, no stretch). Defaults to the detected atlas tile width, else 256.",
              "label": "Tile Width",
              "tier": "presentation",
              "type": "number"
            },
            "unitClickEvent": {
              "default": "UNIT_CLICK",
              "description": "Unit-click event. The neutral drawable host cannot resolve a click to a per-entity id (descriptors carry only a `ScenePos`, no id), so this prop is accepted but not yet emitted — the id-hit-test is a tracked fork (docs/Almadar_Std_Game_V2_PLAN.md).",
              "label": "Unit Click Event",
              "tier": "presentation",
              "type": "string"
            }
          },
          "emits": [
            {
              "description": "--- Declarative events back to LOLO ---",
              "event": "@config.tileClickEvent",
              "eventId": "evt_01M055GNYPZJ1B85V8PJJKAH3G",
              "payloadSchema": [
                {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                {
                  "name": "y",
                  "required": true,
                  "type": "number"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Unit-click event. The neutral drawable host cannot resolve a click to a per-entity id (descriptors carry only a `ScenePos`, no id), so this prop is accepted but not yet emitted — the id-hit-test is a tracked fork (docs/Almadar_Std_Game_V2_PLAN.md).",
              "event": "@config.unitClickEvent",
              "eventId": "evt_01M055GNYPK44W2BW0QREKG351",
              "payloadSchema": [
                {
                  "name": "unitId",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Emits UI:{tileHoverEvent} with the unprojected scene { x, y } on hover.",
              "event": "@config.tileHoverEvent",
              "eventId": "evt_01M055GNYP001PZTRX5N4CHPKZ",
              "payloadSchema": [
