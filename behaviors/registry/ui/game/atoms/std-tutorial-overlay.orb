                "tier": "domain"
              },
              {
                "description": "Emitted when the tutorial leaves a demo step (next/back) or is dismissed/finished; the autodemo atom stops and releases control.",
                "id": "evt_01M0S0M8T1MCJ051JCTX2K24E1",
                "key": "TUTORIAL_DEMO_STOP",
                "name": "Tutorial Demo Stop",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "hidden"
              },
              {
                "name": "showing"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "if",
                    "@config.autoShow",
                    [
                      "emit",
                      "TUT_AUTO",
                      {
                        "id": "auto"
                      }
                    ],
                    [
                      "render-ui",
                      "overlay",
                      null
                    ]
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0PEDYHY99JGP0Q297BBCN02",
                "from": "hidden",
                "to": "hidden"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.step",
                    0.0
                  ],
                  [
                    "render-ui",
                    "overlay",
                    {
                      "children": [
                        {
                          "content": [
                            "object/get",
                            [
                              "array/nth",
                              "@config.steps",
                              0.0
                            ],
                            "title"
                          ],
                          "type": "typography",
                          "variant": "h4",
                          "weight": "bold"
                        },
                        "@config.previewTrait",
                        {
