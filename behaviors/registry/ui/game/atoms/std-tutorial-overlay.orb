        {
          "category": "interaction",
          "config": {
            "autoShow": {
              "default": true,
              "description": "When true the tutorial opens on INIT for this run; when false it stays hidden until SHOW.",
              "label": "Auto Show",
              "tier": "domain",
              "type": "boolean"
            },
            "previewTrait": {
              "default": "@trait.TutorialEmptyPreview",
              "description": "Trait rendered in the media position of the modal — the live, demo-driven preview of the mechanic (a bare game canvas, no shell chrome). '@trait.TutorialEmptyPreview' leaves the slot blank. Override with '@trait.<TraitName>' to show a board's live frame.",
              "label": "Preview trait",
              "refId": "trt_01M0S4ZSRVQBN2JT81Y534547C",
              "tier": "presentation",
              "type": "trait"
            },
            "steps": {
              "default": [],
              "description": "One row per tutorial page: title, one line of body copy, and an optional demoId that plays a scripted live demo (std-tutorial-autodemo) for the mechanic being taught.",
              "items": {
                "properties": {
                  "body": {
                    "name": "body",
                    "required": false,
                    "type": "string"
                  },
                  "demoId": {
                    "name": "demoId",
                    "required": false,
                    "type": "string"
                  },
                  "id": {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  "title": {
                    "name": "title",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "label": "Steps",
              "tier": "presentation",
              "type": "[TutorialStep]"
            }
          },
          "emits": [
            {
              "description": "Self-emitted on INIT when autoShow is on — opens step one. (A config-valued INIT guard would be constant-folded at compose time and misfire; the self-event keeps the decision in an effect.)",
              "event": "TUT_AUTO",
              "eventId": "evt_01M0PEDYJ1PTYC6E8HS6C114XZ",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Advance one step; on the last step it finishes the tutorial (marks done, clears the overlay, emits TUTORIAL_DONE).",
              "event": "TUT_NEXT",
              "eventId": "evt_01M0PEDYJ1H3T1HA0PQXNTRDA3",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Return one step (inert on the first).",
              "event": "TUT_BACK",
              "eventId": "evt_01M0PEDYJ1GA0KV2EHBHT5NGB8",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Skip/close the tutorial; marks done and clears the overlay.",
              "event": "TUT_DISMISS",
              "eventId": "evt_01M0PEDYJ1B3KT6WAQ36ESVPBC",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "Re-open the tutorial from step one — wire a board's help button here.",
              "event": "SHOW",
              "eventId": "evt_01M0PEDYJ1ZSPPQSFWHNDRMQM7",
              "payloadSchema": [
                {
                  "name": "id",
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "essential"
            },
            {
              "description": "The tutorial was finished or skipped; boards unpause or log completion.",
              "event": "TUTORIAL_DONE",
              "eventId": "evt_01M0PEDYJ12JJNHT06186T7N11",
              "payloadSchema": [
                {
                  "name": "id",
                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            },
            {
              "description": "Emitted when a tutorial step carrying a demoId is shown; the composed std-tutorial-autodemo atom plays that scripted demo.",
              "event": "TUTORIAL_DEMO_START",
              "eventId": "evt_01M0S0M8T1W8J768EA9RE2QKYV",
              "payloadSchema": [
