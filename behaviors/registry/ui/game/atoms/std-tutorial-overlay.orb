                  "required": true,
                  "type": "string"
                }
              ],
              "scope": "external",
              "tier": "domain"
            },
            {
              "description": "Emitted when the tutorial leaves a demo step (next/back) or is dismissed/finished; the autodemo atom stops and releases control.",
              "event": "TUTORIAL_DEMO_STOP",
              "eventId": "evt_01M0S0M8T1MCJ051JCTX2K24E1",
