                              0.0
                            ],
                            "body"
                          ],
                          "type": "typography",
                          "variant": "body"
                        },
                        {
                          "align": "center",
                          "content": [
                            "str/concat",
                            "1 / ",
                            [
                              "array/len",
                              "@config.steps"
                            ]
                          ],
                          "type": "typography",
                          "variant": "caption"
                        },
                        {
                          "children": [
                            {
                              "action": "TUT_NEXT",
                              "label": [
                                "if",
                                [
