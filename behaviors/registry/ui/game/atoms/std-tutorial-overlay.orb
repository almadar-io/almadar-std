                "description": "The tutorial was finished or skipped; boards unpause or log completion.",
                "id": "evt_01M0PEDYJ12JJNHT06186T7N11",
                "key": "TUTORIAL_DONE",
                "name": "Tutorial Done",
                "payloadSchema": [
                  {
                    "name": "id",
