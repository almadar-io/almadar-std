              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "touch",
                        [
                          "array/filter",
                          "@entity.coefPads",
                          [
                            "fn",
                            "p",
                            [
                              "and",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@p",
                                  "applied"
                                ],
                                false
                              ],
                              [
                                "and",
                                [
                                  "==",
                                  "@payload.grounded",
                                  true
                                ],
                                [
                                  "and",
                                  [
                                    "<=",
                                    [
                                      "math/abs",
                                      [
                                        "-",
                                        "@payload.x",
                                        [
                                          "object/get",
                                          "@p",
                                          "x"
                                        ]
                                      ]
                                    ],
                                    "@config.reachX"
                                  ],
                                  [
                                    "<=",
                                    [
                                      "math/abs",
                                      [
                                        "-",
                                        "@payload.y",
                                        [
                                          "object/get",
                                          "@p",
                                          "y"
                                        ]
                                      ]
                                    ],
                                    "@config.reachY"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@touch"
                        ],
                        0.0
                      ],
                      [
                        "let",
                        [
                          [
                            "p",
                            [
                              "array/first",
                              "@touch"
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "m",
                              [
                                "object/get",
                                "@p",
                                "mod"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "remaining",
                                [
                                  "array/len",
                                  [
                                    "array/filter",
                                    "@entity.coefPads",
                                    [
                                      "fn",
                                      "c",
                                      [
                                        "and",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@c",
                                            "applied"
                                          ],
                                          false
                                        ],
                                        [
                                          "!=",
                                          [
                                            "object/get",
                                            "@c",
                                            "id"
                                          ],
                                          [
                                            "object/get",
                                            "@p",
                                            "id"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "do",
                              [
                                "set",
                                "@entity.coefPads",
                                [
                                  "array/map",
                                  "@entity.coefPads",
                                  [
                                    "fn",
                                    "c",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "id"
                                        ],
                                        [
                                          "object/get",
                                          "@p",
                                          "id"
                                        ]
                                      ],
                                      [
                                        "object/merge",
                                        "@c",
                                        {
                                          "applied": true
                                        }
                                      ],
                                      "@c"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "emit",
                                "COEF_PAD_APPLIED",
                                {
                                  "a": [
                                    "object/get",
                                    "@m",
                                    "a"
                                  ],
                                  "b": [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@m",
                                        "b"
                                      ],
                                      null
                                    ],
                                    1.0,
                                    [
                                      "object/get",
                                      "@m",
                                      "b"
                                    ]
                                  ],
                                  "h": [
                                    "object/get",
                                    "@m",
                                    "h"
                                  ],
                                  "hint": [
                                    "object/get",
                                    "@p",
                                    "hint"
                                  ],
                                  "hop": [
                                    "object/get",
                                    "@p",
                                    "hop"
                                  ],
                                  "id": [
                                    "object/get",
                                    "@p",
                                    "id"
                                  ],
                                  "k": [
                                    "object/get",
                                    "@m",
                                    "k"
                                  ],
                                  "samples": [
                                    "object/get",
                                    "@p",
                                    "samples"
                                  ],
                                  "x": [
                                    "object/get",
                                    "@p",
                                    "x"
                                  ],
