                                    "@p",
                                    "y"
                                  ]
                                }
                              ],
                              [
                                "if",
                                [
                                  "and",
                                  [
                                    "==",
                                    "@entity.coefCompleted",
                                    false
                                  ],
                                  [
                                    "==",
                                    "@remaining",
                                    0.0
                                  ]
                                ],
                                [
                                  "do",
                                  [
                                    "set",
                                    "@entity.coefCompleted",
                                    true
                                  ],
                                  [
                                    "emit",
                                    "COEF_PAD_SET_COMPLETED",
                                    {}
                                  ]
                                ],
                                null
                              ]
                            ]
                          ]
                        ]
                      ],
                      null
                    ]
                  ]
