                  }
                ]
              },
              {
                "description": "A gate's speed band was satisfied (instantly, or held for its dwell) and it flipped open; boards layer treasure fx and rewards. When several gates open on one move, the first reports and the shared entity carries the rest.",
                "id": "evt_01M11M409RWEC4MAX79RVXR02R",
                "key": "VELOCITY_GATE_OPENED",
                "name": "Velocity Gate Opened",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The player entered a closed gate outside its speed band or against its direction; fires once per approach and re-arms after they step out. Boards answer with a PLACE back plus a hint fx.",
                "id": "evt_01M11M409R76VNT0D3KFN8VR2X",
                "key": "VELOCITY_GATE_DENIED",
                "name": "Velocity Gate Denied",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "speed",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.gates",
                    [
                      "array/map",
                      "@config.gates",
                      [
                        "fn",
                        "g",
                        [
                          "object/merge",
                          "@g",
                          {
                            "denied": false,
                            "held": 0.0,
                            "open": false,
                            "reported": false,
                            "touching": false
                          }
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M11M409RW8GXWQS2H7KWNG9V",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.gates",
                    [
                      "array/map",
                      "@entity.gates",
                      [
                        "fn",
                        "g",
                        [
                          "let",
                          [
                            [
                              "inside",
                              [
                                "and",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@g",
                                    "open"
                                  ],
                                  false
                                ],
                                [
                                  "and",
                                  [
                                    ">=",
                                    "@payload.x",
                                    [
                                      "-",
                                      [
                                        "object/get",
                                        "@g",
                                        "x"
                                      ],
                                      "@config.reachMargin"
                                    ]
                                  ],
                                  [
                                    "and",
                                    [
                                      "<=",
                                      "@payload.x",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@g",
                                          "x"
                                        ],
                                        [
                                          "object/get",
                                          "@g",
                                          "width"
                                        ],
                                        "@config.reachMargin"
                                      ]
                                    ],
                                    [
                                      "and",
                                      [
                                        ">=",
                                        "@payload.y",
                                        [
                                          "-",
                                          [
                                            "object/get",
                                            "@g",
                                            "y"
                                          ],
                                          "@config.reachMargin"
                                        ]
                                      ],
                                      [
                                        "<=",
                                        "@payload.y",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@g",
                                            "y"
                                          ],
                                          [
                                            "object/get",
                                            "@g",
                                            "height"
                                          ],
                                          "@config.reachMargin"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "dirOk",
                                [
                                  "or",
                                  [
                                    "==",
                                    [
                                      "object/get",
                                      "@g",
                                      "dir"
                                    ],
                                    0.0
                                  ],
                                  [
                                    "==",
                                    [
                                      "math/sign",
                                      "@payload.vx"
                                    ],
                                    [
                                      "object/get",
                                      "@g",
                                      "dir"
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "pass",
                                  [
                                    "and",
                                    "@inside",
                                    [
                                      "and",
                                      [
                                        ">=",
                                        "@payload.speed",
                                        [
                                          "object/get",
                                          "@g",
                                          "minSpeed"
                                        ]
                                      ],
                                      [
                                        "and",
                                        [
                                          "<=",
                                          "@payload.speed",
                                          [
                                            "object/get",
                                            "@g",
                                            "maxSpeed"
                                          ]
                                        ],
                                        "@dirOk"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "held",
                                    [
                                      "if",
                                      "@pass",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@g",
                                          "held"
                                        ],
                                        33.0
                                      ],
                                      0.0
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "openNow",
                                      [
                                        "or",
                                        [
                                          "object/get",
                                          "@g",
                                          "open"
                                        ],
                                        [
                                          "if",
                                          [
                                            ">",
                                            [
                                              "object/get",
                                              "@g",
                                              "dwellMs"
                                            ],
                                            0.0
                                          ],
                                          [
                                            ">=",
                                            "@held",
                                            [
                                              "object/get",
                                              "@g",
                                              "dwellMs"
                                            ]
                                          ],
                                          "@pass"
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "object/merge",
                                    "@g",
                                    {
                                      "denied": [
                                        "and",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@g",
                                            "dwellMs"
                                          ],
                                          0.0
                                        ],
                                        [
                                          "and",
                                          "@inside",
                                          [
                                            "and",
                                            [
                                              "==",
                                              "@pass",
                                              false
                                            ],
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@g",
                                                "touching"
                                              ],
                                              false
                                            ]
                                          ]
                                        ]
                                      ],
                                      "held": "@held",
                                      "open": "@openNow",
                                      "touching": "@inside"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "newly",
                        [
                          "array/filter",
                          "@entity.gates",
                          [
                            "fn",
                            "g",
                            [
                              "and",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@g",
                                  "open"
                                ],
                                true
                              ],
                              [
                                "==",
                                [
                                  "object/get",
                                  "@g",
                                  "reported"
                                ],
                                false
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@newly"
                        ],
                        0.0
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.gates",
                          [
                            "array/map",
                            "@entity.gates",
                            [
                              "fn",
                              "g",
                              [
                                "if",
                                [
                                  "==",
                                  [
                                    "object/get",
                                    "@g",
                                    "id"
                                  ],
                                  [
                                    "object/get",
                                    [
                                      "array/first",
                                      "@newly"
                                    ],
                                    "id"
                                  ]
                                ],
                                [
                                  "object/merge",
                                  "@g",
                                  {
                                    "reported": true
                                  }
                                ],
                                "@g"
                              ]
                            ]
                          ]
                        ],
                        [
                          "emit",
                          "VELOCITY_GATE_OPENED",
                          {
                            "id": [
                              "object/get",
                              [
                                "array/first",
                                "@newly"
                              ],
                              "id"
                            ],
                            "x": [
                              "object/get",
                              [
                                "array/first",
                                "@newly"
                              ],
                              "x"
                            ],
                            "y": [
                              "object/get",
                              [
                                "array/first",
                                "@newly"
                              ],
                              "y"
                            ]
                          }
                        ]
                      ],
                      null
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "denied",
                        [
                          "array/filter",
                          "@entity.gates",
                          [
                            "fn",
                            "g",
                            [
                              "==",
                              [
                                "object/get",
                                "@g",
                                "denied"
                              ],
                              true
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@denied"
                        ],
                        0.0
                      ],
                      [
                        "emit",
                        "VELOCITY_GATE_DENIED",
                        {
                          "id": [
                            "object/get",
                            [
                              "array/first",
                              "@denied"
                            ],
                            "id"
                          ],
                          "speed": "@payload.speed",
                          "x": [
                            "object/get",
