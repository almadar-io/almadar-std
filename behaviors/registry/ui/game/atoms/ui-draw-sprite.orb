            {
              "ref": "DrawSpriteRender",
              "refId": "trt_01KXG04TY6EY8J405F6YTGE9C2"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "interaction",
          "config": {
            "anchor": {
              "default": "top-left",
              "description": "How the sprite aligns to its projected position. Default `'top-left'`.",
              "label": "Anchor",
              "tier": "presentation",
              "type": "string",
              "values": [
                "top-left",
                "ground",
                "center"
              ]
            },
            "animation": {
              "description": "Animation to play. 3D backend: a named GLB clip (matched case-insensitively). 2D painter: when `asset.atlas` resolves to a `SpriteSheetAtlas` manifest, the canonical row of that name (idle/walk/attack/hit/death) plays off the host paint clock; an explicit `frame` rect overrides.",
              "label": "Animation",
              "tier": "presentation",
              "type": "string"
            },
            "asset": {
              "description": "The image / atlas reference to blit.",
              "label": "Asset",
              "properties": {
                "animations": {
                  "items": {
                    "type": "string"
                  },
                  "name": "animations",
                  "required": false,
                  "type": "array"
                },
                "aspect": {
                  "name": "aspect",
                  "required": false,
                  "type": "string",
                  "values": [
                    "1:1",
                    "16:9",
                    "5:7",
                    "8:1"
                  ]
                },
                "atlas": {
                  "name": "atlas",
                  "required": false,
                  "type": "string"
                },
                "category": {
                  "name": "category",
                  "required": true,
                  "type": "string"
                },
                "dimension": {
                  "name": "dimension",
                  "required": false,
                  "type": "string",
                  "values": [
                    "2d",
                    "3d"
                  ]
                },
                "name": {
                  "name": "name",
                  "required": false,
                  "type": "string"
                },
                "role": {
                  "name": "role",
                  "required": true,
                  "type": "string"
                },
                "sprite": {
                  "name": "sprite",
                  "required": false,
                  "type": "string"
                },
                "style": {
                  "name": "style",
                  "required": false,
                  "type": "string",
                  "values": [
                    "pixel",
                    "vector",
                    "hd",
                    "1-bit",
                    "isometric"
                  ]
                },
                "thumbnailUrl": {
                  "name": "thumbnailUrl",
                  "required": false,
                  "type": "string"
                },
                "url": {
                  "name": "url",
                  "required": true,
                  "type": "string"
                },
                "variant": {
                  "name": "variant",
                  "required": false,
                  "type": "string"
                }
              },
              "tier": "presentation",
              "type": "DrawSpriteAsset"
            },
            "clockMs": {
              "description": "Animation clock override in ms (e.g. an fx entry's age since spawn). Omitted → the host paint clock; one-shot rows anchored to wall-time would otherwise sit on their final frame.",
              "label": "Clock Ms",
              "tier": "presentation",
              "type": "number"
            },
            "flipX": {
              "description": "Mirror horizontally (facing).",
              "label": "Flip X",
              "tier": "presentation",
              "type": "boolean"
            },
            "frame": {
              "description": "Explicit atlas sub-rect override (px); omitted → resolved from `asset.atlas`/`asset.sprite`.",
              "label": "Frame",
              "properties": {
                "h": {
                  "name": "h",
                  "required": true,
                  "type": "number"
                },
                "w": {
                  "name": "w",
                  "required": true,
                  "type": "number"
                },
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "DrawSpriteFrame"
            },
            "height": {
              "description": "Draw height in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`.",
              "label": "Height",
              "tier": "presentation",
              "type": "number"
            },
            "loop": {
              "description": "Override the sheet row's loop flag. The paint clock is wall-time, so one-shot rows hold their final frame — preview pages set `true` to cycle attack/hit/death continuously.",
              "label": "Loop",
              "tier": "presentation",
              "type": "boolean"
            },
            "opacity": {
              "description": "0..1 opacity.",
              "label": "Opacity",
              "tier": "presentation",
              "type": "number"
            },
            "position": {
              "default": {
                "x": 1.0,
                "y": 1.0,
                "z": 1.0
              },
              "description": "Logical scene position; the projector maps it to pixels / world.",
              "label": "Position",
              "properties": {
                "x": {
                  "name": "x",
                  "required": true,
                  "type": "number"
                },
                "y": {
                  "name": "y",
                  "required": true,
                  "type": "number"
                },
                "z": {
                  "name": "z",
                  "required": false,
                  "type": "number"
                }
              },
              "tier": "presentation",
              "type": "DrawSpritePosition"
            },
            "rotation": {
              "description": "Rotation in radians about the sprite's center.",
              "label": "Rotation",
              "tier": "presentation",
              "type": "number"
            },
            "shadow": {
              "description": "Drop shadow (e.g. a team-colored glow).",
              "label": "Shadow",
              "properties": {
                "blur": {
                  "name": "blur",
                  "required": true,
                  "type": "number"
                },
                "color": {
                  "name": "color",
                  "required": true,
                  "type": "string"
                }
              },
              "tier": "presentation",
              "type": "DrawSpriteShadow"
            },
            "width": {
              "description": "Draw width in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`.",
              "label": "Width",
              "tier": "presentation",
              "type": "number"
            }
          },
