                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.patrols",
                    [
                      "array/map",
                      "@config.patrols",
                      [
                        "fn",
                        "p",
                        [
                          "object/merge",
                          "@p",
                          {
                            "cy": [
                              "object/get",
                              "@p",
                              "y"
                            ],
                            "dir": 1.0,
                            "hit": false,
                            "t": 0.0,
                            "touching": false,
                            "x": [
                              "object/get",
                              "@p",
                              "x0"
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.px",
                    "@config.playerSpawnX"
                  ],
                  [
                    "set",
                    "@entity.py",
                    "@config.playerSpawnY"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0PCAKKXFZTMW79Z96WV5A60",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.px",
                    "@payload.x"
                  ],
                  [
                    "set",
                    "@entity.py",
                    "@payload.y"
                  ]
                ],
                "event": "BODY_MOVED",
                "eventId": "evt_01M0PCAKKXZGA2QS6J3G9MZTPJ",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.patrols",
                    [
                      "array/map",
                      "@config.patrols",
                      [
                        "fn",
                        "p",
                        [
                          "object/merge",
                          "@p",
                          {
                            "cy": [
                              "object/get",
                              "@p",
                              "y"
                            ],
                            "dir": 1.0,
                            "hit": false,
                            "t": 0.0,
                            "touching": false,
                            "x": [
                              "object/get",
                              "@p",
                              "x0"
                            ]
                          }
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M0PCAKKX4Q8XWSYERBAF5HQ2",
                "from": "active",
                "to": "active"
              }
            ]
          },
          "ticks": [
            {
              "effects": [
                [
                  "set",
                  "@entity.patrols",
                  [
                    "array/map",
                    "@entity.patrols",
                    [
                      "fn",
                      "p",
                      [
                        "let",
                        [
                          [
                            "nx",
                            [
                              "+",
                              [
                                "object/get",
                                "@p",
                                "x"
                              ],
                              [
                                "*",
                                [
                                  "*",
                                  [
                                    "object/get",
                                    "@p",
                                    "dir"
                                  ],
                                  [
                                    "object/get",
                                    "@p",
                                    "speed"
                                  ]
                                ],
                                0.033
                              ]
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "overshoot",
                              [
                                ">",
                                "@nx",
                                [
                                  "object/get",
                                  "@p",
                                  "x1"
                                ]
                              ]
                            ],
                            [
                              "undershoot",
                              [
                                "<",
                                "@nx",
                                [
                                  "object/get",
                                  "@p",
                                  "x0"
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "cx",
                                [
                                  "if",
                                  "@overshoot",
                                  [
                                    "object/get",
                                    "@p",
                                    "x1"
                                  ],
                                  [
                                    "if",
                                    "@undershoot",
                                    [
                                      "object/get",
                                      "@p",
                                      "x0"
                                    ],
                                    "@nx"
                                  ]
                                ]
                              ],
                              [
                                "cdir",
                                [
                                  "if",
                                  "@overshoot",
                                  -1.0,
                                  [
                                    "if",
                                    "@undershoot",
                                    1.0,
                                    [
                                      "object/get",
                                      "@p",
                                      "dir"
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nt",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@p",
                                      "t"
                                    ],
                                    0.033
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "amp",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@p",
                                          "waveAmp"
                                        ],
                                        null
                                      ],
                                      0.0,
                                      [
                                        "object/get",
                                        "@p",
                                        "waveAmp"
                                      ]
                                    ]
                                  ],
                                  [
                                    "period",
                                    [
                                      "if",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@p",
                                          "wavePeriod"
                                        ],
                                        null
                                      ],
                                      3.0,
                                      [
                                        "object/get",
                                        "@p",
                                        "wavePeriod"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "cy",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@p",
                                          "y"
                                        ],
                                        [
                                          "*",
                                          "@amp",
                                          [
                                            "math/sin",
                                            [
                                              "/",
                                              [
                                                "*",
                                                6.283185307179586,
                                                "@nt"
                                              ],
                                              "@period"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "near",
                                        [
                                          "and",
                                          [
                                            "<=",
                                            [
                                              "math/abs",
                                              [
                                                "-",
                                                "@entity.px",
                                                "@cx"
                                              ]
                                            ],
                                            "@config.hitRadius"
                                          ],
                                          [
                                            "<=",
                                            [
                                              "math/abs",
                                              [
                                                "-",
                                                "@entity.py",
                                                "@cy"
                                              ]
                                            ],
                                            "@config.hitRadius"
                                          ]
                                        ]
                                      ]
                                    ],
                                    [
                                      "object/merge",
                                      "@p",
                                      {
                                        "cy": "@cy",
                                        "dir": "@cdir",
                                        "hit": [
                                          "and",
                                          "@near",
                                          [
                                            "==",
                                            [
                                              "object/get",
                                              "@p",
                                              "touching"
                                            ],
                                            false
                                          ]
                                        ],
                                        "t": "@nt",
                                        "touching": "@near",
                                        "x": "@cx"
                                      }
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "let",
                  [
                    [
                      "hits",
                      [
                        "array/filter",
                        "@entity.patrols",
                        [
                          "fn",
                          "p",
                          [
                            "==",
                            [
                              "object/get",
                              "@p",
                              "hit"
                            ],
                            true
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "if",
                    [
                      ">",
                      [
                        "array/len",
                        "@hits"
                      ],
                      0.0
                    ],
                    [
                      "emit",
                      "PATROL_HIT",
                      {
                        "id": [
                          "object/get",
                          [
                            "array/first",
                            "@hits"
                          ],
                          "id"
                        ],
                        "x": [
                          "object/get",
                          [
                            "array/first",
                            "@hits"
                          ],
                          "x"
                        ],
                        "y": [
                          "object/get",
                          [
                            "array/first",
                            "@hits"
                          ],
                          "cy"
                        ]
                      }
                    ],
                    null
                  ]
                ]
              ],
              "guard": [
                "and",
                "@config.running",
                [
                  ">",
                  [
                    "array/len",
                    "@entity.patrols"
                  ],
                  0.0
                ]
              ],
              "interval": 33.0,
              "name": "patrolTick"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}