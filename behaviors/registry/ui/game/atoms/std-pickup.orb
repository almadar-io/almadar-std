          "entityRefIds": {
            "PickupData": "ent_01M1GJ1RVVTJT76K1YZHQJGRG1"
          },
          "id": "trt_01M1GJ1RVVYNAYXGWNA3EB2RFF",
          "linkedEntity": "PickupData",
          "linkedEntityId": "ent_01M1GJ1RVVTJT76K1YZHQJGRG1",
          "name": "Pickup",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M1GJ1RVVV01RP71K50TKTX9B",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01M1GJ1RVVM5H5ZY0QRFXV9CKE",
                "key": "BODY_MOVED",
                "name": "Body Moved",
                "payloadSchema": [
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vx",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "vy",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "grounded",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "skating",
                    "required": true,
                    "type": "boolean"
                  },
                  {
                    "name": "speed",
                    "required": true,
                    "type": "number"
                  }
                ]
              },
              {
                "id": "evt_01M1GJ1RVV15S8HWFJEVX2B3EE",
                "key": "RESTART",
                "name": "Restart",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              },
              {
                "description": "The player touched an uncollected feature; carries the feature identity, board-defined kind (star, boost, …), position and display glyph/message. Fires once per feature per run.",
                "id": "evt_01M1GJ1RVVSK6CJ213JM62VAQD",
                "key": "PICKED",
                "name": "Picked",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "kind",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "x",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "y",
                    "required": true,
                    "type": "number"
                  },
                  {
                    "name": "glyph",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Running count of collected features after this pickup — the event std-gate-lock consumes to count openings.",
                "id": "evt_01M1GJ1RVV6P5K79BVV55VS8N1",
                "key": "COLLECT",
                "name": "Collect",
                "payloadSchema": [
                  {
                    "name": "total",
                    "required": true,
                    "type": "number"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "Every feature in the set is collected; fires once per run.",
                "id": "evt_01M1GJ1RVVN8VVR734HESK50D3",
                "key": "PICKUP_SET_COMPLETED",
                "name": "Pickup Set Completed",
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.pickups",
                    [
                      "array/map",
                      "@config.features",
                      [
                        "fn",
                        "f",
                        [
                          "object/merge",
                          "@f",
                          {
                            "collected": false
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pickupCompleted",
                    false
                  ],
                  [
                    "set",
                    "@entity.total",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M1GJ1RVVV01RP71K50TKTX9B",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "touch",
                        [
                          "array/filter",
                          "@entity.pickups",
                          [
                            "fn",
                            "f",
                            [
                              "and",
                              [
                                "==",
                                [
                                  "object/get",
                                  "@f",
                                  "collected"
                                ],
                                false
                              ],
                              [
                                "and",
                                [
                                  "<=",
                                  [
                                    "math/abs",
                                    [
                                      "-",
                                      "@payload.x",
                                      [
                                        "object/get",
                                        "@f",
                                        "x"
                                      ]
                                    ]
                                  ],
                                  "@config.reachX"
                                ],
                                [
                                  "<=",
                                  [
                                    "math/abs",
                                    [
                                      "-",
                                      "@payload.y",
                                      [
                                        "object/get",
                                        "@f",
                                        "y"
                                      ]
                                    ]
                                  ],
                                  "@config.reachY"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@touch"
                        ],
                        0.0
                      ],
                      [
                        "let",
                        [
                          [
                            "f",
                            [
                              "array/first",
                              "@touch"
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "remaining",
                              [
                                "array/len",
                                [
                                  "array/filter",
                                  "@entity.pickups",
                                  [
                                    "fn",
                                    "c",
                                    [
                                      "and",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@c",
                                          "collected"
                                        ],
                                        false
                                      ],
                                      [
                                        "!=",
                                        [
                                          "object/get",
                                          "@c",
                                          "id"
                                        ],
                                        [
                                          "object/get",
                                          "@f",
                                          "id"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "do",
                            [
                              "set",
                              "@entity.pickups",
                              [
                                "array/map",
                                "@entity.pickups",
                                [
                                  "fn",
                                  "c",
                                  [
                                    "if",
                                    [
                                      "==",
                                      [
                                        "object/get",
                                        "@c",
                                        "id"
                                      ],
                                      [
                                        "object/get",
                                        "@f",
                                        "id"
                                      ]
                                    ],
                                    [
                                      "object/merge",
                                      "@c",
                                      {
                                        "collected": true
                                      }
                                    ],
                                    "@c"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "set",
                              "@entity.total",
                              [
                                "+",
                                "@entity.total",
                                1.0
                              ]
                            ],
                            [
                              "emit",
                              "PICKED",
                              {
                                "glyph": [
                                  "object/get",
                                  "@f",
                                  "glyph"
                                ],
                                "id": [
                                  "object/get",
                                  "@f",
                                  "id"
                                ],
                                "kind": [
                                  "object/get",
                                  "@f",
                                  "kind"
                                ],
                                "message": [
                                  "object/get",
                                  "@f",
                                  "message"
                                ],
                                "x": [
                                  "object/get",
                                  "@f",
                                  "x"
                                ],
                                "y": [
                                  "object/get",
                                  "@f",
                                  "y"
                                ]
                              }
                            ],
                            [
                              "emit",
                              "COLLECT",
                              {
                                "total": "@entity.total"
                              }
                            ],
                            [
                              "if",
                              [
                                "and",
                                [
                                  "==",
                                  "@entity.pickupCompleted",
                                  false
                                ],
                                [
                                  "==",
                                  "@remaining",
                                  0.0
                                ]
                              ],
                              [
                                "do",
                                [
                                  "set",
                                  "@entity.pickupCompleted",
                                  true
                                ],
                                [
                                  "emit",
                                  "PICKUP_SET_COMPLETED",
                                  {}
                                ]
                              ],
                              null
                            ]
                          ]
                        ]
                      ],
                      null
                    ]
                  ]
                ],
                "event": "BODY_MOVED",
                "eventId": "evt_01M1GJ1RVVM5H5ZY0QRFXV9CKE",
                "from": "active",
                "guard": "@config.running",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.pickups",
                    [
                      "array/map",
                      "@config.features",
                      [
                        "fn",
                        "f",
                        [
                          "object/merge",
                          "@f",
                          {
                            "collected": false
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pickupCompleted",
                    false
                  ],
                  [
                    "set",
                    "@entity.total",
                    0.0
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M1GJ1RVV15S8HWFJEVX2B3EE",
                "from": "active",
                "to": "active"
              }
            ]
          }
        }
      ],
      "types": {
        "PickupFeature": [
          {
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "name": "x",
            "required": true,
            "type": "number"
          },
          {
            "name": "y",
            "required": true,
