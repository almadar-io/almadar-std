                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The player crossed a checkpoint's atX for the first time this run; the respawn point moved to it. Boards layer flag/save fx.",
                "id": "evt_01M0PCAKN6QFXHSDW8XJ4ET8NS",
                "key": "CHECKPOINT_REACHED",
                "name": "Checkpoint Reached",
                "payloadSchema": [
                  {
                    "name": "id",
                    "required": true,
                    "type": "string"
                  }
                ],
                "tier": "domain"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "active"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.lives",
                    "@config.maxLives"
                  ],
                  [
                    "set",
                    "@entity.respawnX",
                    "@config.spawnX"
                  ],
                  [
                    "set",
                    "@entity.respawnY",
                    "@config.spawnY"
                  ],
                  [
                    "set",
                    "@entity.cpX",
                    [
                      "-",
                      0.0,
                      1000000.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.lastHitAt",
                    0.0
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M0PCAKN6RFTB5YXC3TCYZZ01",
                "from": "active",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "if",
                    [
                      ">=",
                      [
                        "-",
                        [
                          "time/now"
                        ],
                        "@entity.lastHitAt"
                      ],
                      "@config.invulnMs"
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.lastHitAt",
                        [
                          "time/now"
                        ]
                      ],
                      [
                        "set",
                        "@entity.lives",
                        [
                          "-",
                          "@entity.lives",
                          1.0
                        ]
                      ],
                      [
                        "if",
                        [
                          ">",
                          "@entity.lives",
                          0.0
                        ],
                        [
                          "do",
                          [
                            "emit",
                            "LIFE_LOST",
                            {
                              "lives": "@entity.lives"
                            }
                          ],
                          [
                            "emit",
                            "RESPAWN",
                            {
                              "x": "@entity.respawnX",
                              "y": "@entity.respawnY"
                            }
                          ]
                        ],
                        [
                          "emit",
                          "GAME_OVER",
                          {
                            "id": "lives"
                          }
                        ]
                      ]
                    ],
                    null
                  ]
                ],
                "event": "DAMAGE",
                "eventId": "evt_01M0PCAKN6YZDSBX3W71KH98JK",
                "from": "active",
                "guard": [
                  "and",
                  "@config.running",
                  [
                    ">",
                    "@entity.lives",
                    0.0
                  ]
                ],
                "to": "active"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "reached",
                        [
                          "array/filter",
                          "@config.checkpoints",
                          [
                            "fn",
                            "c",
                            [
                              "and",
                              [
                                "<=",
                                [
                                  "object/get",
                                  "@c",
                                  "atX"
                                ],
                                "@payload.x"
                              ],
                              [
                                ">",
                                [
                                  "object/get",
                                  "@c",
                                  "atX"
                                ],
                                "@entity.cpX"
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      [
                        ">",
                        [
                          "array/len",
                          "@reached"
                        ],
                        0.0
                      ],
                      [
                        "let",
                        [
                          [
                            "cp",
                            [
                              "array/last",
                              "@reached"
                            ]
                          ]
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.respawnX",
                            [
                              "object/get",
                              "@cp",
                              "x"
                            ]
                          ],
                          [
                            "set",
                            "@entity.respawnY",
                            [
                              "object/get",
                              "@cp",
                              "y"
                            ]
                          ],
                          [
                            "set",
                            "@entity.cpX",
                            [
                              "object/get",
                              "@cp",
                              "atX"
                            ]
                          ],
                          [
                            "emit",
                            "CHECKPOINT_REACHED",
                            {
                              "id": [
                                "object/get",
                                "@cp",
                                "id"
                              ]
                            }
                          ]
                        ]
                      ],
                      null
                    ]
                  ]
                ],
                "event": "BODY_MOVED",
                "eventId": "evt_01M0PCAKN640DKPRK56HB2D016",
                "from": "active",
                "guard": "@config.running",
                "to": "active"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.lives",
                    "@config.maxLives"
                  ],
                  [
                    "set",
                    "@entity.respawnX",
                    "@config.spawnX"
                  ],
                  [
                    "set",
                    "@entity.respawnY",
                    "@config.spawnY"
                  ],
                  [
                    "set",
                    "@entity.cpX",
                    [
                      "-",
                      0.0,
                      1000000.0
                    ]
                  ],
                  [
                    "set",
                    "@entity.lastHitAt",
                    0.0
                  ]
                ],
                "event": "RESTART",
                "eventId": "evt_01M0PCAKN6NHVZTD3B1YJBP9MN",
                "from": "active",
                "to": "active"
              }
            ]
          }
        }
      ],
