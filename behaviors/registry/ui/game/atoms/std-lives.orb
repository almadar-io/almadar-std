                  }
                ],
                "tier": "domain"
              },
              {
                "description": "The checkpoint the body should restart from after this life loss; boards forward it to the body authority's PLACE.",
                "id": "evt_01M0PCAKN6GA9CBJDE8T7FS2F0",
