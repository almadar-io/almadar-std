          "refId": "trt_01KYBM8SPDR0V9Y61Y00APN1PT"
        },
        {
          "config": {
            "sampleRate": {
              "default": 1.0,
              "type": "unknown"
            },
            "sink": {
              "default": "knowledge-tracing",
              "type": "unknown"
            }
          },
          "id": "trt_01M055GH5S3EQBR96Q27R8Q4MH",
          "linkedEntity": "KnowledgeState",
          "linkedEntityId": "ent_01M055GH5S23ZDSM86RRZ5D2BQ",
          "listens": [
            {
              "event": "CAPTURE_LABEL",
              "source": {
                "kind": "trait",
                "trait": "ObservationRelay"
              },
              "triggers": "CAPTURE"
            }
          ],
          "name": "Labels",
          "ref": "LabelCap.traits.LabelCaptureListener",
          "refId": "trt_01KYBM8SK85P7TQJB7PYMA4M7F"
        }
      ],
      "uses": [
        {
          "as": "Posterior",
          "from": "std/behaviors/std-ml-posterior"
        },
        {
          "as": "LabelCap",
          "from": "std/behaviors/std-ml-label-capture"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
