              },
              "triggers": "VERDICT_REACHED",
              "triggersId": "evt_01M055GH5S6N5RDG1Q63GAB0M8"
            }
          ],
          "name": "ObservationRelay",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01M055GH5SPSSPVR4KFDT936G3",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "description": "Public entry point — one true/false observation of a learner against one skill.",
                "id": "evt_01M055GH5S8WRWJBGCGT5YQJ9W",
                "key": "OBSERVE_SKILL",
                "name": "Observe Skill",
                "payloadSchema": [
                  {
                    "name": "skillId",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "outcome",
                    "required": true,
                    "type": "boolean"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "Any posterior verdict, tagged with which one it was.",
                "id": "evt_01M055GH5S6N5RDG1Q63GAB0M8",
                "key": "VERDICT_REACHED",
                "name": "Verdict Reached",
                "payloadSchema": [
                  {
                    "name": "status",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "mean",
                    "required": true,
                    "type": "float"
                  },
                  {
                    "name": "intervalLow",
                    "required": true,
                    "type": "float"
                  },
                  {
                    "name": "intervalHigh",
                    "required": true,
                    "type": "float"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "Forwards the raw outcome to PosteriorTracker once skillId is recorded on the shared entity.",
                "id": "evt_01M055GH5SC5MER6VGX1V0QMXP",
                "key": "OBSERVATION_MADE",
                "name": "Observation Made",
                "payloadSchema": [
                  {
                    "name": "outcome",
                    "required": true,
                    "type": "boolean"
                  }
                ],
                "tier": "secondary"
              },
              {
                "description": "The posterior's verdict reshaped into a labeled example for LabelCaptureListener.",
                "id": "evt_01M055GH5SJRF4GEBT3G9WA18Q",
                "key": "CAPTURE_LABEL",
                "name": "Capture Label",
                "payloadSchema": [
                  {
                    "name": "input",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "verdict",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "source",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "outcome",
                    "type": "any"
                  }
                ],
                "tier": "secondary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.skillId",
                    ""
                  ],
                  [
                    "set",
                    "@entity.lastOutcome",
                    false
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01M055GH5SPSSPVR4KFDT936G3",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.skillId",
                    "@payload.skillId"
                  ],
                  [
                    "set",
                    "@entity.lastOutcome",
                    "@payload.outcome"
                  ],
                  [
                    "emit",
                    "OBSERVATION_MADE",
                    {
                      "outcome": "@payload.outcome"
                    }
                  ]
                ],
                "event": "OBSERVE_SKILL",
                "eventId": "evt_01M055GH5S8WRWJBGCGT5YQJ9W",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "emit",
                    "CAPTURE_LABEL",
                    {
                      "input": {
                        "skillId": "@entity.skillId"
                      },
                      "outcome": "@entity.lastOutcome",
                      "source": "posterior",
                      "verdict": {
                        "intervalHigh": "@payload.intervalHigh",
                        "intervalLow": "@payload.intervalLow",
                        "mean": "@payload.mean",
                        "status": "@payload.status"
                      }
                    }
                  ]
                ],
                "event": "VERDICT_REACHED",
                "eventId": "evt_01M055GH5S6N5RDG1Q63GAB0M8",
                "from": "idle",
                "to": "idle"
              }
            ]
          }
        },
        {
          "config": {
            "intervalWidthMax": {
              "default": 0.25,
              "type": "unknown"
            },
            "masteryFloor": {
              "default": 0.85,
              "type": "unknown"
            },
            "priorAlpha": {
              "default": 1.0,
              "type": "unknown"
            },
            "priorBeta": {
              "default": 1.0,
              "type": "unknown"
            },
            "remediationCeiling": {
              "default": 0.35,
              "type": "unknown"
            },
            "sampleCount": {
              "default": 200.0,
              "type": "unknown"
            }
          },
