                "intervalLow": "@payload.intervalLow",
                "mean": "@payload.mean",
                "status": "remediate"
              },
              "source": {
                "kind": "trait",
                "trait": "PosteriorTracker",
                "traitId": "trt_01M055GH5SE12B5GWSSEVJRR69"
              },
              "triggers": "VERDICT_REACHED",
              "triggersId": "evt_01M055GH5S6N5RDG1Q63GAB0M8"
            },
            {
              "event": "EVIDENCE_INSUFFICIENT",
              "payloadMapping": {
