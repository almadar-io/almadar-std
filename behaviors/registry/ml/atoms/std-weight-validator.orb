      }
    },
    "schemaVersion": 1
  },
  "name": "std-weight-validator",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "default": [],
            "items": {
              "type": "number"
            },
            "name": "weights",
            "type": "array"
          },
          {
            "default": [],
            "items": {
              "type": "number"
            },
            "name": "baseline",
            "type": "array"
          },
          {
            "default": [],
            "items": {
              "properties": {
                "check": {
                  "name": "check",
                  "required": true,
                  "type": "string"
                },
                "index": {
                  "name": "index",
                  "required": false,
                  "type": "number"
                },
                "value": {
                  "name": "value",
                  "required": false,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "name": "violations",
            "type": "array"
          },
          {
            "default": false,
            "name": "valid",
            "type": "boolean"
          },
          {
            "default": "idle",
            "name": "status",
            "type": "string",
            "values": [
              "idle",
              "checked"
            ]
          }
        ],
        "id": "ent_01KYE96EQJVQSXXAST8EAFQGKY",
        "name": "WeightValidation",
        "persistence": "runtime"
      },
      "id": "orb_01KYE96EQJCJ1Z46P1JD2X1304",
      "name": "MlWeightValidatorOrbital",
      "pages": [
        {
          "id": "pag_01KYE96EQJC2SM5TND1FJWXSXV",
          "name": "MlWeightValidatorPage",
          "path": "/ml-weight-validator",
          "traits": [
            {
              "ref": "WeightValidatorRun",
              "refId": "trt_01KYE96EQJ329VGV8APPE3R2B1"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "forbiddenRegions": {
              "default": [],
              "description": "Value ranges no weight may fall inside, even within the magnitude bound",
              "items": {
                "properties": {
                  "max": {
                    "name": "max",
                    "required": true,
                    "type": "number"
                  },
                  "min": {
                    "name": "min",
                    "required": true,
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "label": "Forbidden regions",
              "tier": "domain",
              "type": "[Range]"
            },
            "maxMagnitude": {
              "default": 10.0,
              "description": "Every weight's absolute value must not exceed this bound",
              "label": "Max weight magnitude",
              "tier": "policy",
              "type": "float"
            },
            "regressionThreshold": {
              "default": 0.0,
              "description": "Max allowed per-element absolute drift between candidate and baseline weights; 0 disables the regression check",
              "label": "Regression threshold",
              "tier": "policy",
              "type": "float"
            }
          },
          "effectRow": [
            {
              "kind": "emit",
              "resource": "WEIGHTS_ACCEPTED"
            },
            {
              "kind": "emit",
              "resource": "WEIGHTS_REJECTED"
            },
            {
              "kind": "set",
              "resource": "@entity.baseline"
            },
            {
              "kind": "set",
              "resource": "@entity.status"
            },
            {
              "kind": "set",
              "resource": "@entity.valid"
            },
            {
              "kind": "set",
              "resource": "@entity.violations"
            },
            {
              "kind": "set",
              "resource": "@entity.weights"
            }
          ],
          "emits": [
            {
              "description": "All constraint checks passed — magnitude bounds, forbidden regions, and regression are all clear",
              "event": "WEIGHTS_ACCEPTED",
              "eventId": "evt_01KYE96EQJA3HEMSHMVK0H37E4",
              "payloadSchema": [
                {
                  "name": "weights",
                  "required": true,
                  "type": "[float]"
                }
              ],
              "scope": "external",
              "tier": "primary"
            },
            {
              "description": "At least one constraint check failed; violations lists every failing check with its detail (magnitude, forbidden-region, or regression). request echoes the originating request untouched so the next rung can project its own inputs out of it",
              "event": "WEIGHTS_REJECTED",
              "eventId": "evt_01KYE96EQJH84979QCX1HZBEXA",
              "payloadSchema": [
                {
                  "name": "violations",
                  "required": true,
                  "type": "[WeightViolation]"
                },
                {
                  "name": "request",
                  "type": "opaque"
                }
              ],
              "scope": "external",
              "tier": "primary"
            }
          ],
          "entityRefIds": {
            "WeightValidation": "ent_01KYE96EQJVQSXXAST8EAFQGKY"
          },
          "id": "trt_01KYE96EQJ329VGV8APPE3R2B1",
          "linkedEntity": "WeightValidation",
          "linkedEntityId": "ent_01KYE96EQJVQSXXAST8EAFQGKY",
          "name": "WeightValidatorRun",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYE96EQJZMW4XV88YSBCZTG7",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYE96EQJ77T61A54324JTA7Y",
                "key": "VALIDATE_WEIGHTS",
                "name": "Validate Weights",
                "payloadSchema": [
                  {
                    "name": "weights",
                    "required": true,
                    "type": "[float]"
                  },
                  {
                    "name": "baseline",
                    "type": "[float]"
                  },
                  {
                    "name": "request",
                    "type": "opaque"
                  }
                ]
              },
              {
                "id": "evt_01KYE96EQJMZ5G1V4MJ0MXPYAN",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "All constraint checks passed — magnitude bounds, forbidden regions, and regression are all clear",
                "id": "evt_01KYE96EQJA3HEMSHMVK0H37E4",
                "key": "WEIGHTS_ACCEPTED",
                "name": "Weights Accepted",
                "payloadSchema": [
                  {
                    "name": "weights",
                    "required": true,
                    "type": "[float]"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "At least one constraint check failed; violations lists every failing check with its detail (magnitude, forbidden-region, or regression). request echoes the originating request untouched so the next rung can project its own inputs out of it",
                "id": "evt_01KYE96EQJH84979QCX1HZBEXA",
                "key": "WEIGHTS_REJECTED",
                "name": "Weights Rejected",
                "payloadSchema": [
                  {
                    "name": "violations",
                    "required": true,
                    "type": "[WeightViolation]"
                  },
                  {
                    "name": "request",
                    "type": "opaque"
                  }
                ],
                "tier": "primary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "checked"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.weights",
                    []
                  ],
                  [
                    "set",
                    "@entity.baseline",
                    []
                  ],
                  [
                    "set",
                    "@entity.violations",
                    []
                  ],
                  [
                    "set",
                    "@entity.valid",
                    false
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYE96EQJZMW4XV88YSBCZTG7",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "cand",
                        "@payload.weights"
                      ],
                      [
                        "base",
                        "@payload.baseline"
                      ],
                      [
                        "magnitudeHits",
                        [
                          "array/filter",
                          "@cand",
                          [
                            "fn",
                            "w",
                            [
                              ">",
                              [
                                "math/abs",
                                "@w"
                              ],
                              "@config.maxMagnitude"
                            ]
                          ]
                        ]
                      ],
                      [
                        "regionHits",
                        [
                          "array/filter",
                          "@cand",
                          [
                            "fn",
                            "w",
                            [
                              "array/some",
                              "@config.forbiddenRegions",
                              [
                                "fn",
                                "r",
                                [
                                  "and",
                                  [
                                    ">=",
                                    "@w",
                                    "@r.min"
                                  ],
                                  [
                                    "<=",
                                    "@w",
                                    "@r.max"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "regressionHits",
                        [
                          "if",
                          [
                            ">",
                            "@config.regressionThreshold",
                            0.0
                          ],
                          [
                            "array/filter",
                            [
                              "array/range",
                              0.0,
                              [
                                "array/len",
                                "@cand"
                              ]
                            ],
                            [
                              "fn",
                              "i",
                              [
                                ">",
                                [
                                  "math/abs",
                                  [
                                    "-",
                                    [
                                      "array/nth",
                                      "@cand",
                                      "@i"
                                    ],
                                    [
                                      "array/nth",
                                      "@base",
                                      "@i"
                                    ]
                                  ]
                                ],
                                "@config.regressionThreshold"
                              ]
                            ]
                          ],
                          []
                        ]
                      ],
                      [
                        "violations",
                        [
                          "array/concat",
                          [
                            "array/map",
                            "@magnitudeHits",
                            [
                              "fn",
                              "w",
                              {
                                "check": "magnitude",
                                "value": "@w"
                              }
                            ]
                          ],
                          [
                            "array/map",
                            "@regionHits",
                            [
                              "fn",
                              "w",
                              {
                                "check": "forbidden-region",
                                "value": "@w"
                              }
                            ]
                          ],
                          [
                            "array/map",
                            "@regressionHits",
                            [
                              "fn",
                              "i",
                              {
                                "check": "regression",
                                "index": "@i"
                              }
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.weights",
                        "@cand"
                      ],
                      [
                        "set",
                        "@entity.baseline",
                        "@base"
                      ],
                      [
                        "set",
                        "@entity.violations",
                        "@violations"
                      ],
                      [
                        "if",
                        [
                          "==",
                          [
                            "array/len",
                            "@violations"
                          ],
                          0.0
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.valid",
                            true
                          ],
                          [
                            "set",
                            "@entity.status",
                            "checked"
                          ],
                          [
                            "emit",
                            "WEIGHTS_ACCEPTED",
                            {
                              "weights": "@cand"
                            }
                          ]
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.valid",
                            false
                          ],
                          [
                            "set",
                            "@entity.status",
                            "checked"
                          ],
                          [
                            "emit",
                            "WEIGHTS_REJECTED",
                            {
                              "request": "@payload.request",
                              "violations": "@violations"
                            }
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "VALIDATE_WEIGHTS",
                "eventId": "evt_01KYE96EQJ77T61A54324JTA7Y",
                "from": "idle",
                "to": "checked"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "checked"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYE96EQJZMW4XV88YSBCZTG7",
                "from": "checked",
                "to": "checked"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.weights",
                    []
                  ],
                  [
                    "set",
                    "@entity.baseline",
                    []
                  ],
                  [
                    "set",
                    "@entity.violations",
                    []
                  ],
                  [
                    "set",
                    "@entity.valid",
                    false
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYE96EQJMZ5G1V4MJ0MXPYAN",
                "from": "checked",
                "to": "idle"
              }
            ]
          }
        }
      ],
      "types": {
        "Range": [
          {
            "name": "min",
            "required": true,
            "type": "float"
          },
          {
            "name": "max",
            "required": true,
            "type": "float"
          }
        ],
        "WeightViolation": [
          {
            "name": "check",
            "required": true,
            "type": "string"
          },
          {
            "name": "value",
            "type": "float"
          },
          {
            "name": "index",
            "type": "int"
          }
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}