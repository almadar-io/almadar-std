    "schemaVersion": 1
  },
  "name": "std-graph-builder",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "default": [],
            "items": {
              "items": {
                "type": "scalar"
              },
              "type": "object"
            },
            "name": "nodes",
            "type": "array"
          },
          {
            "default": [],
            "items": {
              "properties": {
                "source": {
                  "name": "source",
                  "required": true,
                  "type": "string"
                },
                "target": {
                  "name": "target",
                  "required": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "name": "edges",
            "type": "array"
          },
          {
            "default": 0.0,
            "name": "nodeCount",
            "type": "number"
          },
          {
            "default": 0.0,
            "name": "edgeCount",
            "type": "number"
          },
          {
            "default": "idle",
            "name": "status",
            "type": "string",
            "values": [
              "idle",
              "built"
            ]
          }
        ],
        "id": "ent_01KYE96EQ8DPFC0S5GH6TSPD1P",
        "name": "GraphStructure",
        "persistence": "runtime"
      },
      "id": "orb_01KYE96EQ88SQNJ3NCGV8F9JNH",
      "name": "GraphBuilderOrbital",
      "pages": [
        {
          "id": "pag_01KYE96EQ8SD1205HXPDANVCX0",
          "name": "GraphBuilderPage",
          "path": "/graph-builder",
          "traits": [
            {
              "ref": "GraphBuilderRun",
              "refId": "trt_01KYE96EQ8GNDQNEDM2RGESEWF"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "directed": {
              "default": false,
              "description": "Carried through for downstream consumers; edges are emitted once per adjacency entry, so an undirected reader should treat each edge as bidirectional",
              "label": "Directed",
              "tier": "policy",
              "type": "boolean"
            },
            "edgeField": {
              "default": "",
              "description": "Field on each source entity holding its adjacency — an array of target ids",
              "label": "Edge field",
              "tier": "domain",
              "type": "string"
            },
            "nodeFeatures": {
              "default": [],
              "description": "Entity fields carried onto each node alongside id",
              "items": {
                "type": "string"
              },
              "label": "Node features",
              "tier": "domain",
              "type": "[string]"
            }
          },
          "emits": [
            {
              "description": "Fired when node/edge structures have been built from the source entity collection",
              "event": "GRAPH_READY",
              "eventId": "evt_01KYE96EQ88KJAGCECSHRRGTD1",
              "payloadSchema": [
                {
                  "name": "nodes",
                  "required": true,
                  "type": "[Map<string,scalar>]"
                },
                {
                  "name": "edges",
                  "required": true,
                  "type": "[GraphBuilderEdge]"
                },
                {
                  "name": "nodeCount",
                  "required": true,
                  "type": "int"
                },
                {
                  "name": "edgeCount",
                  "required": true,
                  "type": "int"
                }
              ],
              "scope": "external",
              "tier": "primary"
            }
          ],
          "entityRefIds": {
            "GraphStructure": "ent_01KYE96EQ8DPFC0S5GH6TSPD1P"
          },
          "id": "trt_01KYE96EQ8GNDQNEDM2RGESEWF",
          "linkedEntity": "GraphStructure",
          "linkedEntityId": "ent_01KYE96EQ8DPFC0S5GH6TSPD1P",
          "name": "GraphBuilderRun",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYE96EQ830XWQ2G6P5V7NTR5",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYE96EQ8F2Q2W859FEBKGPEP",
                "key": "BUILD_GRAPH",
                "name": "Build Graph",
                "payloadSchema": [
                  {
                    "name": "entities",
                    "required": true,
                    "type": "[opaque]"
                  }
                ]
              },
              {
                "id": "evt_01KYE96EQ880KKBQFDFMB4E32J",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "Fired when node/edge structures have been built from the source entity collection",
                "id": "evt_01KYE96EQ88KJAGCECSHRRGTD1",
                "key": "GRAPH_READY",
                "name": "Graph Ready",
                "payloadSchema": [
                  {
                    "name": "nodes",
                    "required": true,
                    "type": "[Map<string,scalar>]"
                  },
                  {
                    "name": "edges",
                    "required": true,
                    "type": "[GraphBuilderEdge]"
                  },
                  {
                    "name": "nodeCount",
                    "required": true,
                    "type": "int"
                  },
                  {
                    "name": "edgeCount",
                    "required": true,
                    "type": "int"
                  }
                ],
                "tier": "primary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "built"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.nodes",
                    []
                  ],
                  [
                    "set",
                    "@entity.edges",
                    []
                  ],
                  [
                    "set",
                    "@entity.nodeCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.edgeCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYE96EQ830XWQ2G6P5V7NTR5",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "nodeFields",
                        [
                          "array/unique",
                          [
                            "array/append",
                            "@config.nodeFeatures",
                            "id"
                          ]
                        ]
                      ],
                      [
                        "nodes",
                        [
                          "array/map",
                          "@payload.entities",
                          [
                            "fn",
                            "e",
                            [
                              "object/pick",
                              "@e",
                              "@nodeFields"
                            ]
                          ]
                        ]
                      ],
                      [
                        "edges",
                        [
                          "array/flatten",
                          [
                            "array/map",
                            "@payload.entities",
                            [
                              "fn",
                              "e",
                              [
                                "array/map",
                                [
                                  "object/get",
                                  "@e",
                                  "@config.edgeField",
                                  []
                                ],
                                [
                                  "fn",
                                  "target",
                                  {
                                    "source": [
                                      "object/get",
                                      "@e",
                                      "id"
                                    ],
                                    "target": "@target"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "do",
                      [
                        "set",
                        "@entity.nodes",
                        "@nodes"
                      ],
                      [
                        "set",
                        "@entity.edges",
                        "@edges"
                      ],
                      [
                        "set",
                        "@entity.nodeCount",
                        [
                          "array/len",
                          "@nodes"
                        ]
                      ],
                      [
                        "set",
                        "@entity.edgeCount",
                        [
                          "array/len",
                          "@edges"
                        ]
                      ],
                      [
                        "set",
                        "@entity.status",
                        "built"
                      ],
                      [
                        "emit",
                        "GRAPH_READY",
                        {
                          "edgeCount": [
                            "array/len",
                            "@edges"
                          ],
                          "edges": "@edges",
                          "nodeCount": [
                            "array/len",
                            "@nodes"
                          ],
                          "nodes": "@nodes"
                        }
                      ]
                    ]
                  ]
                ],
                "event": "BUILD_GRAPH",
                "eventId": "evt_01KYE96EQ8F2Q2W859FEBKGPEP",
                "from": "idle",
                "to": "built"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "built"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYE96EQ830XWQ2G6P5V7NTR5",
                "from": "built",
                "to": "built"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.nodes",
                    []
                  ],
                  [
                    "set",
                    "@entity.edges",
                    []
                  ],
                  [
                    "set",
                    "@entity.nodeCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.edgeCount",
                    0.0
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYE96EQ880KKBQFDFMB4E32J",
                "from": "built",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}