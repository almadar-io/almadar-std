      },
      "trt_01KYBMJJSH06PN6D6P8SDH0KGV": {
        "bakedName": "ExactCheckRun",
        "curName": "ExactCheckRun",
        "id": "trt_01KYBMJJSH06PN6D6P8SDH0KGV",
        "kind": "trait",
        "owner": "workspace",
        "renames": []
      }
    },
    "schemaVersion": 1
  },
  "name": "std-ml-exact-check",
  "orbitals": [
    {
      "entity": {
        "fields": [
          {
            "default": false,
            "name": "matched",
            "type": "boolean"
          },
          {
            "default": "idle",
            "name": "status",
            "type": "string",
            "values": [
              "idle",
              "checked"
            ]
          }
        ],
        "id": "ent_01KYBMJJSHFQ07RC3QD9PPE4FA",
        "name": "ExactCheck",
        "persistence": "runtime"
      },
      "id": "orb_01KYBMJJSHMGQM7KAPFDVTD0XD",
      "name": "MlExactCheckOrbital",
      "pages": [
        {
          "id": "pag_01KYBMJJSHHG85R1R2DXSPBK1B",
          "name": "MlExactCheckPage",
          "path": "/ml-exact-check",
          "traits": [
            {
              "ref": "ExactCheckRun",
              "refId": "trt_01KYBMJJSH06PN6D6P8SDH0KGV"
            }
          ]
        }
      ],
      "traits": [
        {
          "category": "lifecycle",
          "config": {
            "caseSensitive": {
              "default": false,
              "description": "Compare candidate and key with case sensitivity; off lowercases both sides before comparing",
              "label": "Case sensitive",
              "tier": "policy",
              "type": "boolean"
            },
            "numericTolerance": {
              "default": 0.0,
              "description": "Absolute tolerance applied when both candidate and key are numbers; 0 requires an exact numeric match",
              "label": "Numeric tolerance",
              "tier": "policy",
              "type": "float"
            },
            "trimWhitespace": {
              "default": true,
              "description": "Strip leading and trailing whitespace from both sides before comparing",
              "label": "Trim whitespace",
              "tier": "policy",
              "type": "boolean"
            }
          },
          "emits": [
            {
              "description": "Fired when the candidate exactly equals the key under the configured normalization",
              "event": "EXACT_MATCHED",
              "eventId": "evt_01KYBMJJSHH58ZTAD1840K8MF3",
              "payloadSchema": [
                {
                  "name": "candidate",
                  "required": true,
                  "type": "any"
                },
                {
                  "name": "key",
                  "required": true,
                  "type": "any"
                }
              ],
              "scope": "external",
              "tier": "primary"
            },
            {
              "description": "Abstain — candidate does not equal the key; the next rung should take over. request echoes the originating request untouched so the next rung can project its own inputs out of it",
              "event": "EXACT_UNMATCHED",
              "eventId": "evt_01KYBMJJSHV4Y0D297RBXF38B0",
              "payloadSchema": [
                {
                  "name": "candidate",
                  "required": true,
                  "type": "any"
                },
                {
                  "name": "key",
                  "required": true,
                  "type": "any"
                },
                {
                  "name": "request",
                  "type": "object"
                }
              ],
              "scope": "external",
              "tier": "primary"
            }
          ],
          "entityRefIds": {
            "ExactCheck": "ent_01KYBMJJSHFQ07RC3QD9PPE4FA"
          },
          "id": "trt_01KYBMJJSH06PN6D6P8SDH0KGV",
          "linkedEntity": "ExactCheck",
          "linkedEntityId": "ent_01KYBMJJSHFQ07RC3QD9PPE4FA",
          "name": "ExactCheckRun",
          "scope": "instance",
          "stateMachine": {
            "events": [
              {
                "id": "evt_01KYBMJJSHKW715FJCC936QY73",
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "id": "evt_01KYBMJJSHSQAHVFCTNVPA6SSM",
                "key": "CHECK",
                "name": "Check",
                "payloadSchema": [
                  {
                    "name": "candidate",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "key",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "request",
                    "type": "object"
                  }
                ]
              },
              {
                "id": "evt_01KYC09GZH6X5DG0P939RP885A",
                "key": "RESET",
                "name": "Reset"
              },
              {
                "description": "Fired when the candidate exactly equals the key under the configured normalization",
                "id": "evt_01KYBMJJSHH58ZTAD1840K8MF3",
                "key": "EXACT_MATCHED",
                "name": "Exact Matched",
                "payloadSchema": [
                  {
                    "name": "candidate",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "key",
                    "required": true,
                    "type": "any"
                  }
                ],
                "tier": "primary"
              },
              {
                "description": "Abstain — candidate does not equal the key; the next rung should take over. request echoes the originating request untouched so the next rung can project its own inputs out of it",
                "id": "evt_01KYBMJJSHV4Y0D297RBXF38B0",
                "key": "EXACT_UNMATCHED",
                "name": "Exact Unmatched",
                "payloadSchema": [
                  {
                    "name": "candidate",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "key",
                    "required": true,
                    "type": "any"
                  },
                  {
                    "name": "request",
                    "type": "object"
                  }
                ],
                "tier": "primary"
              }
            ],
            "states": [
              {
                "isInitial": true,
                "name": "idle"
              },
              {
                "name": "checked"
              }
            ],
            "transitions": [
              {
                "effects": [
                  [
                    "set",
                    "@entity.matched",
                    false
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYBMJJSHKW715FJCC936QY73",
                "from": "idle",
                "to": "idle"
              },
              {
                "effects": [
                  [
                    "let",
                    [
                      [
                        "bothNumeric",
                        [
                          "and",
                          [
                            "validate/number",
                            "@payload.candidate"
                          ],
                          [
                            "validate/number",
                            "@payload.key"
                          ]
                        ]
                      ],
                      [
                        "candStr",
                        [
                          "str/concat",
                          "@payload.candidate"
                        ]
                      ],
                      [
                        "keyStr",
                        [
                          "str/concat",
                          "@payload.key"
                        ]
                      ],
                      [
                        "candTrim",
                        [
                          "if",
                          "@config.trimWhitespace",
                          [
                            "str/trim",
                            "@candStr"
                          ],
                          "@candStr"
                        ]
                      ],
                      [
                        "keyTrim",
                        [
                          "if",
                          "@config.trimWhitespace",
                          [
                            "str/trim",
                            "@keyStr"
                          ],
                          "@keyStr"
                        ]
                      ],
                      [
                        "candNorm",
                        [
                          "if",
                          "@config.caseSensitive",
                          "@candTrim",
                          [
                            "str/lower",
                            "@candTrim"
                          ]
                        ]
                      ],
                      [
                        "keyNorm",
                        [
                          "if",
                          "@config.caseSensitive",
                          "@keyTrim",
                          [
                            "str/lower",
                            "@keyTrim"
                          ]
                        ]
                      ],
                      [
                        "isMatch",
                        [
                          "if",
                          "@bothNumeric",
                          [
                            "<=",
                            [
                              "math/abs",
                              [
                                "-",
                                "@payload.candidate",
                                "@payload.key"
                              ]
                            ],
                            "@config.numericTolerance"
                          ],
                          [
                            "==",
                            "@candNorm",
                            "@keyNorm"
                          ]
                        ]
                      ]
                    ],
                    [
                      "if",
                      "@isMatch",
                      [
                        "do",
                        [
                          "set",
                          "@entity.matched",
                          true
                        ],
                        [
                          "set",
                          "@entity.status",
                          "checked"
                        ],
                        [
                          "emit",
                          "EXACT_MATCHED",
                          {
                            "candidate": "@payload.candidate",
                            "key": "@payload.key"
                          }
                        ]
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.matched",
                          false
                        ],
                        [
                          "set",
                          "@entity.status",
                          "checked"
                        ],
                        [
                          "emit",
                          "EXACT_UNMATCHED",
                          {
                            "candidate": "@payload.candidate",
                            "key": "@payload.key",
                            "request": "@payload.request"
                          }
                        ]
                      ]
                    ]
                  ]
                ],
                "event": "CHECK",
                "eventId": "evt_01KYBMJJSHSQAHVFCTNVPA6SSM",
                "from": "idle",
                "to": "checked"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.status",
                    "checked"
                  ]
                ],
                "event": "INIT",
                "eventId": "evt_01KYBMJJSHKW715FJCC936QY73",
                "from": "checked",
                "to": "checked"
              },
              {
                "effects": [
                  [
                    "set",
                    "@entity.matched",
                    false
                  ],
                  [
                    "set",
                    "@entity.status",
                    "idle"
                  ]
                ],
                "event": "RESET",
                "eventId": "evt_01KYC09GZH6X5DG0P939RP885A",
                "from": "checked",
                "to": "idle"
              }
            ]
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "version": "1.0.0"
}