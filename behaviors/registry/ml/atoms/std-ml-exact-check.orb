{
  "description": "Rung R0 of the intelligence ladder — normalizes and compares a candidate value against a key value; abstains on no match.",
  "ledger": {
    "entries": {
      "ent_01KYBMJJSHFQ07RC3QD9PPE4FA": {
        "bakedName": "ExactCheck",
