          },
          {
            "default": [],
            "items": {
              "type": "number"
            },
            "name": "tokenIds",
            "type": "array"
          },
          {
            "default": 0.0,
            "name": "tokenCount",
            "type": "number"
          },
          {
            "default": {},
            "name": "request",
            "type": "opaque"
          },
          {
            "default": "idle",
