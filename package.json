{
  "name": "@almadar/std",
  "version": "16.256.0",
  "description": "Standard library operators for Almadar (math, string, array, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.js"
    },
    "./canonical-operators.json": "./canonical-operators.json"
  },
  "files": [
    "dist",
    "canonical-operators.json",
    "behaviors/registry/agent",
    "behaviors/registry/infra",
    "behaviors/registry/ml",
    "behaviors/registry/ui/core",
    "behaviors/registry/ui/game",
    "behaviors/registry/ui/avl",
    "behaviors/registry/ui/learning",
    "behaviors/lolo/agent",
    "behaviors/lolo/infra",
    "behaviors/lolo/ml",
    "behaviors/lolo/spec",
    "behaviors/lolo/ui/core",
    "behaviors/lolo/ui/game",
    "behaviors/lolo/ui/avl",
    "behaviors/lolo/ui/learning",
    "sidecars.lock.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "orb": {
    "prefix": "almadar-std",
    "source": "behaviors/lolo",
    "compiler": ">=4.10.0"
  },
  "orbLanguage": {
    "compiler": ">=17.11.2",
    "operators": "canonical-operators.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "generate:operators": "tsx scripts/generate-rust.ts",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks",
    "materialize": "node scripts/materialize-registry.mjs"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0"
  },
  "devDependencies": {
    "@almadar/orb": "^18.0.4",
    "@almadar/eslint-plugin": "^2.22.0",
    "@almadar/lolo-ar": "^1.3.0",
    "@almadar/lolo-sl": "^1.3.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@almadar/db": "^0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-std.git",
    "directory": "docs/packages/std"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "std",
    "standard-library",
    "operators"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
