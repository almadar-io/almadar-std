{
  "name": "@almadar/std",
  "version": "17.0.3",
  "orbRelease": { "severity": "normal" },
  "description": "Standard library operators for Almadar (math, string, array, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.js"
    },
    "./canonical-operators.json": "./canonical-operators.json",
    "./ui-theme-toggle-locales/*": "./behaviors/lolo/ui/core/atoms/locales/*/ui-theme-toggle.json"
  },
  "files": [
    "dist",
    "canonical-operators.json",
    "behaviors/registry",
    "behaviors/lolo",
    "sidecars.lock.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "orb": {
    "prefix": "almadar-std",
    "source": "behaviors/lolo",
    "language": "^1"
  },
  "orbLanguage": {
    "language": "^1",
    "operators": "canonical-operators.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "generate:operators": "tsx scripts/generate-rust.ts",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "test:native": "ORB_BIN=\"$(pnpm bin)/orb\" python3 -I __tests__/mcp-stdio.native.py && ORB_BIN=\"$(pnpm bin)/orb\" python3 -I __tests__/stdio-lines.native.py",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks",
    "materialize": "node scripts/materialize-registry.mjs"
  },
  "dependencies": {
    "@almadar/core": "^11.1.0"
  },
  "devDependencies": {
    "@almadar/kernel": "^19.0.1",
    "@almadar/orb": "^19.0.3",
    "@almadar/eslint-plugin": "^3.0.0",
    "@almadar/lolo-ar": "^2.0.1",
    "@almadar/lolo-sl": "^2.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "vitest": "^4.1.12",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-std.git",
    "directory": "docs/packages/std"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "std",
    "standard-library",
    "operators"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
